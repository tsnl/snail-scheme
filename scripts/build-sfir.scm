;; Chibi hosts the compiler; the input file contains only SFIR.
(import (scheme base) (scheme cxr) (scheme process-context)
        (snail-sfir compiler) (snail-scheme chromium-trace)
        (snail-scheme wasm-optimize))
(check-binaryen-tools)
(define arguments (cdr (command-line)))
(define output (caddr arguments))
(define wat (string-append output ".wat"))
(define raw (string-append output ".raw.wasm"))
(define mode (cadddr arguments))
(define-values (directories exports)
  (let split ((count (string->number (car (cddddr arguments)))) (remaining (cdr (cddddr arguments))) (directories '()))
    (if (zero? count) (values (reverse directories) (map string->symbol remaining))
        (split (- count 1) (cdr remaining) (cons (car remaining) directories)))))
(with-chromium-trace-to (string-append output ".trace.json")
                        (lambda ()
                          (parameterize ((library-directories directories) (command-program? (string=? mode "command")))
                            (apply source-file->wat-file (car arguments) (cadr arguments) wat exports))
                          (assemble-wasm wat raw)
                          (optimize-scheme-wasm raw output)))
