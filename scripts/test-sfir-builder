#!/usr/bin/env python3
"""Compile an SFIR producer, transfer structured library data, and execute its output."""

import json
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / 'tests/sfir-builder'
OUTPUT = ROOT / 'build/sfir-builder'
RECORDS = []
FEATURES = ['--mvp-features', '--enable-gc', '--enable-reference-types', '--enable-tail-call',
            '--enable-mutable-globals', '--enable-sign-ext', '--enable-bulk-memory',
            '--enable-nontrapping-float-to-int']


def run(command, **environment):
    result = subprocess.run(list(map(str, command)), cwd=ROOT, capture_output=True, text=True, timeout=240,
                            env={**os.environ, 'BINARYEN_CORES': '1', **environment})
    RECORDS.append(dict(command=list(map(str, command)), status=result.returncode,
                        stdout=result.stdout, stderr=result.stderr))
    (OUTPUT / 'commands.json').write_text(json.dumps(RECORDS, indent=2) + '\n')
    assert result.returncode == 0, RECORDS[-1]
    if result.stdout:
        print(result.stdout, end='', flush=True)


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    chibi = [os.environ.get('CHIBI', 'chibi-scheme'), '-I', ROOT / 'src', '-I', ROOT / 'tests']
    node = [os.environ.get('NODE', 'node'), '--expose-gc']
    run([*chibi, FIXTURES / 'build.scm', OUTPUT])
    run([*node, FIXTURES / 'produce.mjs', OUTPUT])
    run([*chibi, FIXTURES / 'receive.scm', OUTPUT])
    run([*node, FIXTURES / 'run.mjs', OUTPUT])
    complete_library_data(chibi, node)


def complete_library_data(chibi, node):
    run([*chibi, FIXTURES / 'complete-build.scm', OUTPUT])
    run([*node, FIXTURES / 'complete-produce.mjs', OUTPUT])
    run([*chibi, FIXTURES / 'complete-receive.scm', OUTPUT])
    provider = OUTPUT / 'complete-provider.wasm'
    run([os.environ.get('WASM_AS', 'wasm-as'), FIXTURES / 'complete-provider.wat', '-o', provider])
    for name in ('generated', 'source'):
        stem = 'complete-' + name
        run([os.environ.get('WASM_MERGE', 'wasm-merge'), *FEATURES, OUTPUT / (stem + '.wasm'), 'program',
             provider, 'tests.builder', '-o', OUTPUT / (stem + '.linked.wasm')])
        native = OUTPUT / (stem + '-native')
        run([os.environ.get('CLANG', 'clang'), '-O3', '-ffunction-sections', '-fdata-sections',
             '-Wl,--gc-sections', '-fuse-ld=lld', '-I', ROOT / 'src', OUTPUT / (stem + '.o'),
             ROOT / 'src/native.c', ROOT / 'src/precise-gc.c', FIXTURES / 'complete-native.c', '-lm', '-o', native])
        run([native], SNAIL_NATIVE_GC_INTERVAL='1')
    run([*node, FIXTURES / 'complete-run.mjs', OUTPUT])
    print('PASS complete generated/source native execution with collection at every allocation', flush=True)


if __name__ == '__main__':
    main()
