#!/bin/sh
# Executable checkpoints for the five small application tutorials.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
output="$root/build/application-tutorials"
mkdir -p "$output"
for example in counter inventory testing; do
  chibi-scheme -I "$root/bootstrap" \
    "$root/tests/applications/build.scm" "$root" \
    "$root/examples/applications/$example.sld" "$output/$example.wasm"
done
chibi-scheme -I "$root/bootstrap" \
  "$root/examples/applications/marker-board/build.scm" "$root" "$output/marker-board"
node "$root/tests/applications/tutorials.mjs" "$output"
