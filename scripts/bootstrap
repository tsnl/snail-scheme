#!/bin/sh
# Stage 0: Chez builds the stage 1 command line, bootstrap/cli.sld, from
# the compiler's source, once its source has changed, and checks it to a
# fixpoint (host/chez/snail/stage0/build.sld, "Bootstrap"). It prints the
# command line, its two runtimes and the native Git helper, a path per
# line for the ./snail-scheme launcher to cache.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "${CHEZ:-scheme}" --script "$root/host/chez/load.scm" "$root" bootstrap
