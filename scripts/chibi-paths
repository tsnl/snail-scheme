#!/bin/sh
# Regenerates the `::label` field paths that Chibi's (snail core base) exports:
# one dispatcher per label the compiler's sources mention, since stage 0 has
# no class per label. A label a comment alone mentions costs one unused
# definition. `--check` reports a stale base.sld instead of writing it.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
base="$root/host/chibi/snail/core/base.sld"
labels=$(grep -rhoE '::[A-Za-z0-9!?*<>=/+_:-]+' \
           "$root/src/snail/shell/compiler" "$root/src/snail/shell/compiler.sld" \
         | tr ':' '\n' | grep -v '^$' | LC_ALL=C sort -u)
printf '%s\n' "$labels" | awk -v base="$base" '
  BEGIN { while ((getline line < base) > 0) source[++count] = line }
  { exports = exports "   ::" $0 "\n"
    definitions = definitions "    (define (::" $0 " value) (field-of value (quote " $0 ")))\n" }
  END {
    for (i = 1; i <= count; i++) {
      line = source[i]
      if (line ~ /---- Field path exports \(generated\) ----/) { print line; printf "%s", exports; skipping = 1; continue }
      if (line ~ /---- Field paths \(generated\) ----/) { print line; printf "%s", definitions; skipping = 1; continue }
      if (line ~ /---- End field path/) skipping = 0
      if (!skipping) print line
    }
  }' > "$base.tmp"
if [ "${1:-}" = "--check" ]; then
  if cmp -s "$base.tmp" "$base"; then rm -f "$base.tmp"; exit 0; fi
  rm -f "$base.tmp"
  echo "host/chibi/snail/core/base.sld is stale; run scripts/chibi-paths" >&2
  exit 1
fi
mv "$base.tmp" "$base"
