;; CLI policy stays outside the reusable runtime Wasm library.
(import
 (scheme base)
 (chibi string)
 (lofi host process)
 (only (lofi host wasm-optimize) wasm-release-optimization?)
 (lofi host runtime-wasm))

(define (request arguments)
  (let loop ((arguments arguments) (options '()) (paths '()))
    (cond ((null? arguments)
           (unless (= 2 (length paths)) (error "usage: link-lofi-runtime [OPTIONS] SOURCE OUTPUT"))
           (append options (list (cons 'source (absolute-path (cadr paths))) (cons 'output (absolute-path (car paths))))))
          ((member (car arguments) '("--debug" "--release"))
           (loop (cdr arguments) (cons (cons 'release (string=? (car arguments) "--release")) options) paths))
          ((string=? (car arguments) "--runtime")
           (unless (pair? (cdr arguments)) (error "--runtime needs a path"))
           (loop (cddr arguments) (cons (cons 'runtime (absolute-path (cadr arguments))) options) paths))
          ((string=? (car arguments) "--diagnostic-prune-only")
           (loop (cdr arguments) (cons '(diagnostic . #t) options) paths))
          ((string-prefix? "-" (car arguments)) (error "unknown link option" (car arguments)))
          (else (loop (cdr arguments) options (cons (car arguments) paths))))))

(command-line-main
 (lambda (arguments)
   (let* ((root (car arguments)) (options (request (cdr arguments)))
          (runtime (or (option-ref options 'runtime #f)
                       (build-wasm-runtime (path-join root "src/runtime")))))
     (parameterize ((wasm-release-optimization? (option-ref options 'release #t)))
       (link-wasm-runtime (option-ref options 'source #f) (option-ref options 'output #f)
                          runtime (option-ref options 'diagnostic #f)))))
 "lofi")
