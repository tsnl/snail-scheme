;; Chibi hosts the compiler; Lofi is its sole product input language.
(import
 (scheme base)
 (scheme cxr)
 (scheme file)
 (scheme process-context)
 (chibi filesystem)
 (chibi string)
 (srfi 1)
 (native process)
 (lofi compiler source-driver)
 (native chromium-trace)
 (native wasm-optimize))

;; ---- Command request ----

(define (request arguments)
  (let loop ((arguments arguments) (options '()) (paths '()))
    (if (null? arguments)
        (begin (unless (= 2 (length paths)) (error "usage: build-lofi [OPTIONS] SOURCE OUTPUT"))
               (append options (list (cons 'source (absolute-path (cadr paths)))
                                     (cons 'output (absolute-path (car paths))))))
        (let ((flag (car arguments)))
          (cond ((string=? flag "--command") (loop (cdr arguments) (cons '(command . #t) options) paths))
                ((member flag '("--export" "-I" "--library" "--generation-provider"))
                 (unless (pair? (cdr arguments)) (error "missing build option value" flag))
                 (loop (cddr arguments)
                       (cons (cons (cond ((string=? flag "--export") 'export)
                                         ((string=? flag "--generation-provider") 'provider) (else 'library))
                                   (if (string=? flag "--export") (cadr arguments) (absolute-path (cadr arguments)))) options) paths))
                ((string-prefix? "-" flag) (error "unknown build option" flag))
                (else (loop (cdr arguments) options (cons flag paths))))))))
(define (options-named options name)
  (reverse (map cdr (filter (lambda (item) (eq? (car item) name)) options))))

;; ---- Located source to shared optimized Wasm ----

(define (build root options)
  (let* ((source (option-ref options 'source #f)) (output (option-ref options 'output #f))
         (provider (option-ref options 'provider #f)) (exports (options-named options 'export))
         (outputs (map (lambda (suffix) (string-append output suffix)) '("" ".wat" ".trace.json" ".raw.wasm"))))
    (unless (= (length exports) (length (delete-duplicates exports))) (error "export names must be distinct"))
    (when (any (lambda (output) (or (paths-alias? output source) (paths-alias? output provider))) outputs)
      (error "build outputs must not replace the source"))
    (create-directory* (path-directory output))
    (check-binaryen-tools)
    (with-chromium-trace-to (string-append output ".trace.json")
                            (lambda ()
                              (parameterize ((library-directories (options-named options 'library))
                                             (command-program? (option-ref options 'command #f))
                                             (generation-provider-module provider))
                                (apply source-file->wat-file root source (string-append output ".wat") (map string->symbol exports)))
                              (assemble-wasm (string-append output ".wat") (string-append output ".raw.wasm"))
                              (optimize-wasm (string-append output ".raw.wasm") output)))
    0))
(command-line-main (lambda (arguments) (build (car arguments) (request (cdr arguments)))) "lofi")
