#!/usr/bin/env python3
"""Compare complete SFIR-reader datum streams with Chez on linked Wasm/native."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import shutil
import subprocess
import time

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / 'build' / f'sfir-reader-{time.time_ns()}'
ARTIFACTS = OUTPUT
FIXTURES = ROOT / 'tests/sfir-reader'
ENV = {**os.environ, 'BINARYEN_CORES': '1'}


# ---- Every attempt owns a bounded process group and persistent captures ----


def executing_group(group):
    found = []
    for path in Path('/proc').glob('[0-9]*/stat'):
        try:
            fields = path.read_text().rsplit(')', 1)[1].split()
            if int(fields[2]) == group and fields[0] not in ('Z', 'X'):
                found.append(int(path.parent.name))
        except (FileNotFoundError, ProcessLookupError):
            pass
    return found


def finish(process):
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait(timeout=5)
    deadline = time.monotonic() + 5
    while members := executing_group(process.pid):
        if time.monotonic() >= deadline:
            return members
        time.sleep(0.02)
    return []


def run(command, label, cwd=ROOT, failure=False, timeout=300):
    command = list(map(str, command))
    record = dict(command=command, cwd=str(cwd), timeout_seconds=timeout)
    folder = OUTPUT / 'commands' / label
    folder.mkdir(parents=True)
    process = None
    try:
        with (folder / 'stdout').open('w') as stdout, (folder / 'stderr').open('w') as stderr:
            process = subprocess.Popen(command, cwd=cwd, env=ENV, stdout=stdout,
                                       stderr=stderr, start_new_session=True)
            record.update(pid=process.pid, pgid=process.pid)
            (folder / 'record.json').write_text(json.dumps(record, indent=2) + '\n')
            record['returncode'] = process.wait(timeout=timeout)
    except BaseException as error:
        record['exception'] = repr(error)
    finally:
        if process is not None:
            try:
                record['executing_descendants_after_cleanup'] = finish(process)
                record['returncode'] = process.returncode
            except BaseException as error:
                record['cleanup_exception'] = repr(error)
        (folder / 'record.json').write_text(json.dumps(record, indent=2) + '\n')
    if record.get('exception') or record.get('cleanup_exception') or record.get('executing_descendants_after_cleanup'):
        raise RuntimeError(f'{label}: incomplete process supervision: {record}')
    if (record['returncode'] != 0) != failure:
        raise RuntimeError(f'{label}: unexpected exit {record["returncode"]}; see {folder}')
    return (folder / 'stdout').read_text()


def tool(variable, default):
    return os.environ.get(variable, default)


# ---- Shared compiler input, both retained Wasm forms and real native code ----


def build():
    source = OUTPUT / 'reader.wasm'
    run([ROOT / 'scripts/build-sfir', '--export', 'check', '--export', 'scan', '--export', 'storage',
         FIXTURES / 'reader.sfir', source], 'compile', timeout=900)
    run([tool('CARGO', 'cargo'), 'rustc', '--crate-type=cdylib', '--quiet', '--offline',
         '--release', '--target', 'wasm32-wasip1', '--target-dir', ROOT / 'build/wasm-runtime'], 'runtime')
    runtime = ROOT / 'build/wasm-runtime/wasm32-wasip1/release/snail_runtime.wasm'
    for kind, suffix, flags in [('raw', '.raw.wasm', ['--diagnostic-prune-only']), ('optimized', '', [])]:
        run([ROOT / 'scripts/link-sfir-runtime', '--runtime', runtime, *flags,
             Path(str(source) + suffix), OUTPUT / (kind + '.wasm')], kind + '-link')
    run([ROOT / 'scripts/build-native', '--wasm', '--entry-c', FIXTURES / 'entry.c',
         '--c-provider', 'reader.test', FIXTURES / 'observer.h', FIXTURES / 'observer.c',
         source, OUTPUT / 'native'], 'native-build')


def commands(directory):
    node = [tool('NODE', 'node'), '--disable-warning=ExperimentalWarning', FIXTURES / 'run.mjs']
    return [('raw', [*node, ARTIFACTS / 'raw.wasm', directory]),
            ('optimized', [*node, ARTIFACTS / 'optimized.wasm', directory]),
            ('native', [ARTIFACTS / 'native'])]


# ---- Independent complete-field oracle and explicitly adapted syntax fixtures ----


def valid_cases():
    cases = {
        'empty': '', 'line-comment-eof': '; no newline',
        'atoms': '() #t #f 0 1 -1 + - ... λ lambda',
        'dotted': '(a . b) (a b . ()) ((a . b) . (c . d))',
        'abbreviations': "'a `(x ,y ,@z) ''()",
        'vectors': '#() #(a (1 . 2) #t #("λ" #f))',
        'comments': '#| outer #| nested |# end |# #; #; a b c ;line\r\n(d #; ignored e)',
        'escaped-symbols': '|| |123abc| |a b| |λ😀| |é| |é| |a\\x0;b|',
        'strings': '"" "λ😀" "a\\n\\t\\r\\a\\b\\\\\\\"b" "a\\x1f600;b" "a\rb\r\nc"',
        'continuations': '"a\\ \t\r\n  b" "c\\\n\td"',
        'characters': '#\\) #\\; #\\" #\\λ #\\x0 #\\x1f600 #\\x10ffff #\\space #\\newline',
        'delimiter-adjacency': 'a() (a) a"b" a;b\nc a|b| a\'b a`b a,b a\u00a0b\u2003c a0A .a aéa',
        'delimiter-characters': r'''#\( #\) #\" #\; #\| #\' #\` #\, #\[ #\] #\{ #\}''',
        'integers': '-9223372036854775808 9223372036854775807 #x-8000000000000000 #b101 #o17 #d42 #i#x10',
        'arbitrary-exact': '9223372036854775808 -9223372036854775809 #x20000000000000000 #b1' + '0'*100,
        'exact-rationals': '1/2 -2/4 4/2 0/123 #xA/B #e1.5 #e9007199254740993.1 #e1e999 #e1e-999',
        'inexact-rationals': '#i1/2 #i-0/17 #i-1/3 #i#x20000000000001 #i#x20000000000003',
        'exact-complex': '1/2+3/4i 9223372036854775808-1/7i #e0.1+0.2i 1/2+0i 1/2+0.0i 0/7@1 1/2@0 #e1/2@0.0',
        'exact-decimals': '#e2.0 #e9007199254740993.0 #e-9223372036854775808.0 #e12000e-3 #e0e999',
        'reals': '0.0 -0.0 .5 1. 1e3 -1e-3 5e-324 2.2250738585072014e-308 1e999 -1e-999 +inf.0 -inf.0 +nan.0',
        'complex': '+i -i 1+2i 1+0i 1.0+0i 1+0.0i 1-0.0i 1+2.0i 1.0+2i #i1+0i #e1@0 1@0',
        'polar-axes': '1.0@0 #i1@0 1@0.0 1@-0.0 #xA@0 #i#xA@0 #x#iA@0 #e1@0.0 0@1 0@1.0 0.0@1 -0.0@1 #e0@1 0@+inf.0 0@+nan.0',
    }
    # Chez's R6RS reader spells these extensions differently. Only these known
    # fixtures receive an explicit oracle spelling; workload inputs are untouched.
    cases['escaped-symbols'] = (cases['escaped-symbols'], cases['escaped-symbols'].replace(r'\x0;', '\0'))
    # Chez permits bar-escaped fragments inside a bare identifier; the strict
    # reader's existing contract treats each bar as a delimiter instead.
    cases['delimiter-adjacency'] = (cases['delimiter-adjacency'],
                                    cases['delimiter-adjacency'].replace('a|b|', 'a |b|'))
    cases['bytevectors'] = ('#u8() #u8(0 1 127 128 255)', '#vu8() #vu8(0 1 127 128 255)')
    cases['long-booleans'] = ('#true #false #TRUE #FALSE', '#t #f #t #f')
    cases['named-characters'] = ('#\\alarm #\\backspace #\\delete #\\escape #\\null #\\return #\\tab',
                               '#\\x7 #\\x8 #\\x7f #\\x1b #\\x0 #\\xD #\\x9')
    for size in [31, 32, 33, 63, 64, 65, 8191, 8192, 8193]:
        cases[f'growth-{size}'] = '"' + '😀' * size + '" |' + 'λ' * size + '|'
    cases['canonical-read1'] = (ROOT / 'benchmarks/r7rs-benchmarks/inputs/parsing.data').read_text()
    cases['canonical-sum1'] = (ROOT / 'benchmarks/r7rs-benchmarks/inputs/sum1.data').read_text()
    return cases


def prepare_case(name, source):
    directory = OUTPUT / 'cases' / name
    directory.mkdir(parents=True)
    (directory / 'input.scm').write_bytes(source if isinstance(source, bytes) else source.encode())
    (directory / 'ownership.scm').write_text('(same . #f) same \"text\" \"text\"\n')
    return directory


def check_valid(name, sources):
    source, oracle = sources if isinstance(sources, tuple) else (sources, sources)
    directory = prepare_case(name, source)
    oracle_dir = prepare_case(name + '-oracle', oracle)
    expected = run([tool('CHEZ', 'scheme'), '--script', FIXTURES / 'oracle.scm'], name + '-chez', oracle_dir)
    for system, command in commands(directory):
        actual = run(command, name + '-' + system, directory)
        if actual != expected:
            raise RuntimeError(f'{name}: complete datum stream differs for {system}; see {OUTPUT}')
    print('PASS complete stream ' + name, flush=True)
    return dict(name=name, oracle_compatibility=source != oracle,
                fields=len(expected.splitlines()) - 1, result=expected.splitlines()[-1])


# ---- Malformed input remains distinct from EOF and successful prior tokens ----


def invalid_cases():
    return [')', '.', '(. a)', '(a .)', '(a . b c)', '(a . b . c)', '(a', '#(a . b)',
            '"unfinished', '|unfinished', '"bad\\q"', '"\\x;"', '"\\xd800;"', '"\\x110000;"',
            '"\\x12345678901234567890;"', '"a\\  b"', '#\\', '#\\unknown', '#\\xdfff', '#\\x110000',
            '#| unfinished', '#;', "'", '#; )', '#u8(256)', '#u8(-1)', '#u8(1.0)', '#u8(a)',
            '#u9()', '#', '#tfoo', '#e#e1', '#x#b10', '123abc', '+2oops', '1e', '1/0', '0/0', '1/-2', '1/+2', '1/2/3', '#e+inf.0', '#e-nan.0',
            '#e1e9223372036854775808', '#e1@1', '#0=(a)', '#0#', '#!fold-case abc', '#!no-fold-case abc', '[a]',
            '42 1/0', '#; #| unfinished', 'a[', 'a]', 'a{', 'a}',
            '#\\.a', '#\\0a', '#\\Aa', '#\\éa', '#\\😀a']


def check_error(index, source):
    name = f'error-{index}'
    directory = prepare_case(name, source)
    for system, command in commands(directory):
        output = run(command, name + '-' + system, directory)
        if 'i:99\n' not in output or not output.endswith('result:-1\n'):
            raise RuntimeError(f'{name}: {system} confused malformed input with a value/EOF')
        if source == '42 1/0' and not output.startswith('i:5\ni:0\ni:42\ni:99\n'):
            raise RuntimeError(f'{name}: {system} lost the preceding value or reused a stale result')
        if source in ('a[', 'a]', 'a{', 'a}') and not output.startswith('i:4\ni:1\nc:97\ni:99\n'):
            raise RuntimeError(f'{name}: {system} failed before the atom preceding its delimiter')
    return dict(name=name, input=source)


def check_invalid_utf8():
    for index, source in enumerate([b'\xff', b'\xf0\x9f', b'"abc\xed\xa0\x80"']):
        name = f'utf8-error-{index}'
        directory = prepare_case(name, source)
        for system, command in commands(directory):
            run(command, name + '-' + system, directory, failure=True)
            error = (OUTPUT / 'commands' / (name + '-' + system) / 'stderr').read_text()
            if not any(text in error.lower() for text in ['utf-8', 'utf8', 'failed to fill whole buffer']):
                raise RuntimeError(f'{name}: {system} failed without the expected decoder diagnostic')


# ---- Retain exact sources, tools, artifacts and all failed attempts ----


def freeze_sources():
    paths = [ROOT / name for name in ['lib/sfir/datum.sfir', 'lib/sfir/read.sfir', 'lib/sfir/io.sfir',
             'lib/sfir/integer.sfir', 'lib/sfir/rational.sfir', 'lib/sfir/number.sfir',
             'src/snail-sfir/compiler.sld',
             'src/strict_number.rs', 'src/strict_datum.rs', 'src/symbols.rs', 'src/strict_io.rs', 'src/lib.rs',
             'scripts/test-sfir-reader']]
    paths += sorted((ROOT / 'lib/sfir').glob('*.sfir'))
    paths += sorted((ROOT / 'src').rglob('*.sld'))
    paths += sorted(FIXTURES.glob('*'))
    identities = {}
    for path in paths:
        relative = path.relative_to(ROOT)
        target = OUTPUT / 'sources' / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(path.read_bytes())
        identities[str(relative)] = hashlib.sha256(path.read_bytes()).hexdigest()
    (OUTPUT / 'source-identities.json').write_text(json.dumps(identities, indent=2) + '\n')


def record_tools():
    names = dict(CHIBI='chibi-scheme', NODE='node', CHEZ='scheme', WASM_AS='wasm-as',
                 WASM_OPT='wasm-opt', WASM_DIS='wasm-dis', WASM_MERGE='wasm-merge',
                 RUSTC='rustc', CARGO='cargo', CLANG='clang', LLD='ld.lld')
    report = {}
    for variable, fallback in names.items():
        path = Path(shutil.which(tool(variable, fallback))).absolute()
        label = 'tool-' + variable.lower()
        version = run([path, '-V' if variable == 'CHIBI' else '--version'], label)
        version += (OUTPUT / 'commands' / label / 'stderr').read_text()
        report[variable] = dict(path=str(path), sha256=hashlib.sha256(path.read_bytes()).hexdigest(), version=version)
    report['git_head'] = run(['git', 'rev-parse', 'HEAD'], 'git-head').strip()
    report['git_status'] = run(['git', 'status', '--porcelain=v1', '--ignore-submodules=all'], 'git-status')
    (OUTPUT / 'tools.json').write_text(json.dumps(report, indent=2) + '\n')


def record_artifacts():
    paths = [path for path in ARTIFACTS.rglob('*')
             if path.is_file() and (path.suffix in ('.wasm', '.wat', '.ll', '.o') or path.name == 'native')]
    identities = {str(path.relative_to(ARTIFACTS)): dict(bytes=path.stat().st_size,
                  sha256=hashlib.sha256(path.read_bytes()).hexdigest()) for path in sorted(paths)}
    (OUTPUT / 'artifact-identities.json').write_text(json.dumps(identities, indent=2) + '\n')


def verify_reuse():
    previous = json.loads((ARTIFACTS / 'source-identities.json').read_text())
    for name, expected in previous.items():
        if name.startswith(('src/', 'lib/')) or name.endswith(('reader.sfir', 'observer.h', 'observer.c', 'entry.c')):
            if hashlib.sha256((ROOT / name).read_bytes()).hexdigest() != expected:
                raise ValueError('cannot reuse artifacts after compiled source change: ' + name)
    identities = {name: hashlib.sha256((ARTIFACTS / name).read_bytes()).hexdigest()
                  for name in ['raw.wasm', 'optimized.wasm', 'native', 'reader.wasm']}
    (OUTPUT / 'reused-artifacts.json').write_text(json.dumps(dict(directory=str(ARTIFACTS),
        sha256=identities, compiled_sources_verified=True), indent=2) + '\n')


def main():
    global ARTIFACTS
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--reuse-artifacts', type=Path, help='reuse unchanged compiled sources for oracle/driver corrections')
    options = parser.parse_args()
    ARTIFACTS = options.reuse_artifacts.resolve() if options.reuse_artifacts else OUTPUT
    OUTPUT.mkdir(parents=True)
    print(OUTPUT, flush=True)
    freeze_sources()
    record_tools()
    if options.reuse_artifacts:
        verify_reuse()
    else:
        build()
    record_artifacts()
    valid = [check_valid(name, source) for name, source in valid_cases().items()]
    invalid = [check_error(index, source) for index, source in enumerate(invalid_cases())]
    check_invalid_utf8()
    result = dict(valid=valid, invalid=invalid, utf8_errors=3,
                  systems=['raw linked Wasm', 'Binaryen-optimized linked Wasm', 'native64'],
                  trace_scope='every field of one complete canonical read1 and sum1 invocation')
    (OUTPUT / 'validation.json').write_text(json.dumps(result, indent=2) + '\n')
    print(f'PASS {len(valid)} complete streams, {len(invalid)} syntax errors and 3 UTF-8 errors: {OUTPUT}')


def interrupted(signum, frame):
    raise KeyboardInterrupt(f'reader test interrupted by signal {signum}')


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, interrupted)
    main()
