#!/usr/bin/env python3
"""Execute shared Wasm datums and native Rust/Scheme programs."""

import json
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build/native-tests"
CHIBI = os.environ.get("CHIBI", "chibi-scheme")
EXPECTED = '42\n("a Scheme pair retained by Rust" . 42)\n(14 . 42)\n42\n'


# ---- Compilation and execution ----


def invoke(arguments, **environment):
    return subprocess.run([str(value) for value in arguments], cwd=ROOT,
                          text=True, capture_output=True, timeout=300,
                          env={**os.environ, "BINARYEN_CORES": "1", **environment})


def require(result, stdout="", failure=False):
    if bool(result.returncode) != failure or result.stdout != stdout:
        raise RuntimeError(f"exit={result.returncode}\nstdout={result.stdout!r}\nstderr={result.stderr!r}")
    if not failure and result.stderr:
        raise RuntimeError(result.stderr)
    return result


def scheme(script, *arguments, **environment):
    return invoke([CHIBI, "-I", ROOT / "src", ROOT / script, *arguments], **environment)


def translate(source, name):
    llvm = BUILD / f"{name}.ll"
    require(scheme("tests/translate-native.scm", ROOT, source, llvm))
    return llvm


def collector_flags():
    flags = ["-lgc", "-lm"]
    if "BDWGC_INCLUDE" in os.environ:
        flags += ["-I", os.environ["BDWGC_INCLUDE"]]
    if "BDWGC_LIB" in os.environ:
        library = os.environ["BDWGC_LIB"]
        flags += ["-L", library, f"-Wl,-rpath,{library}"]
    return flags


def custom_host(llvm, name, program=False):
    output = BUILD / name
    defines = ["-DSNAIL_NATIVE_LIBRARY"]
    runtime = []
    if program:
        defines += ["-DSNAIL_NATIVE_PROGRAM"]
        runtime = [ROOT / "build/native-runtime/release/libsnail_runtime.a", "-ldl", "-lpthread"]
    command = [os.environ.get("CLANG", "clang"), "-O3", "-flto", "-fuse-ld=lld", *defines,
               llvm, ROOT / "src/native.c", ROOT / "tests/native-runner.c",
               *runtime, *collector_flags(), "-o", output]
    require(invoke(command))
    return output


# ---- ABI, traps, roots and finalizer scheduling ----


def check_semantics():
    require(scheme("tests/build-native-datums.scm", BUILD))
    llvm = BUILD / "semantics.ll"
    if llvm.read_bytes() != (BUILD / "semantics-again.ll").read_bytes():
        raise RuntimeError("printing or lowering mutated the shared module datum")
    wasm = BUILD / "semantics.wasm"
    features = ["--enable-gc", "--enable-reference-types", "--enable-tail-call",
                "--enable-bulk-memory", "--enable-sign-ext", "--enable-mutable-globals",
                "--enable-nontrapping-float-to-int"]
    require(invoke([os.environ.get("WASM_AS", "wasm-as"), BUILD / "semantics.wat",
                    *features, "-g", "-o", wasm]))
    reference = BUILD / "saturation.json"
    require(invoke([os.environ.get("NODE", "node"), ROOT / "tests/check-native-semantics.mjs", wasm, reference]))
    assert len(re.findall(r"^define .*\) cold \{", llvm.read_text(), re.MULTILINE)) == 1
    executable = custom_host(llvm, "semantics")
    require(invoke([executable], SNAIL_NATIVE_GC_INTERVAL="1"))
    for sample in json.loads(reference.read_text()):
        require(invoke([executable, "saturate", sample["input"]]), " ".join(sample["results"]) + "\n")
    for kind in range(13):
        result = require(invoke([executable, kind]), failure=True)
        if result.returncode != 1 or result.stderr != "WebAssembly trap\n":
            raise RuntimeError(f"native trap {kind}: {result.stderr}")
    print("passed shared-datum types, control, tail ABI, 13 traps, and forced GC", flush=True)


def check_rust_callbacks():
    require(scheme("examples/rust-interop/build.scm"), EXPECTED)
    llvm = translate(ROOT / "examples/rust-interop/main.scm", "extension")
    executable = custom_host(llvm, "extension", program=True)
    require(invoke([executable], SNAIL_NATIVE_GC_INTERVAL="1"), EXPECTED)
    print("passed native Rust roots and reentrant Scheme callbacks", flush=True)


def check_resources():
    wasm = BUILD / "resources.wasm"
    require(scheme("tests/build-program.scm", ROOT,
                   ROOT / "tests/programs/backend-native-resources.scm", wasm))
    require(invoke([os.environ.get("NODE", "node"), "--no-warnings",
                    ROOT / "scripts/run-wasi.mjs", wasm]), "native resource checks passed\n")
    executable = custom_host(translate(ROOT / "tests/programs/backend-native-resources.scm", "resources"),
                             "resources", program=True)
    require(invoke([executable, "finalizers"], SNAIL_NATIVE_GC_INTERVAL="1"),
            "native resource checks passed\n")
    print("passed native Rust resource cleanup outside active Wasm calls", flush=True)


def main():
    BUILD.mkdir(parents=True, exist_ok=True)
    require(invoke([os.environ.get("CARGO", "cargo"), "rustc", "--quiet", "--offline",
                    "--release", "--crate-type=staticlib", "--features=native-runtime",
                    "--target-dir", ROOT / "build/native-runtime"]))
    check_semantics()
    check_rust_callbacks()
    check_resources()


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f"native test failed: {error}", file=sys.stderr)
        sys.exit(1)
