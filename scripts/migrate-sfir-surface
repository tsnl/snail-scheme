#!/usr/bin/env python3
"""One-time authoring tool for the October 2026 SFIR surface migration.

Builds consume the resulting static files and never invoke this tool. Keep literal
spellings and comments; rewrite only recognized old SFIR syntax. Numeric policy
is deliberately unchanged. Invalid fixtures still need a human expectation audit.
"""

import argparse
from collections import Counter
from dataclasses import dataclass
import hashlib
import json
from pathlib import Path
import re
import sys
import unittest


# ---- Lossless source structure ----


@dataclass(frozen=True)
class Syntax:
    start: int
    end: int
    kind: str
    spelling: str = ''
    items: tuple = ()

    @property
    def head(self):
        return self.items[0].spelling if self.kind == 'list' and self.items else ''


class Reader:
    def __init__(self, text):
        self.text, self.position, self.comments = text, 0, []

    def file(self):
        result = []
        self.trivia()
        while self.position < len(self.text):
            result.append(self.read())
            self.trivia()
        return tuple(result)

    def trivia(self):
        while self.position < len(self.text):
            if self.text[self.position].isspace():
                self.position += 1
            elif self.text[self.position] == ';':
                self.line_comment()
            elif self.text.startswith('#|', self.position):
                self.block_comment()
            elif self.text.startswith('#;', self.position):
                self.datum_comment()
            else:
                return

    def line_comment(self):
        start = self.position
        end = self.text.find('\n', start)
        self.position = len(self.text) if end < 0 else end
        self.comments.append(self.text[start:self.position])

    def block_comment(self):
        start, depth = self.position, 1
        self.position += 2
        while depth and self.position < len(self.text):
            if self.text.startswith('#|', self.position):
                depth, self.position = depth + 1, self.position + 2
            elif self.text.startswith('|#', self.position):
                depth, self.position = depth - 1, self.position + 2
            else:
                self.position += 1
        if depth:
            raise ValueError('unterminated block comment')
        self.comments.append(self.text[start:self.position])

    def datum_comment(self):
        start = self.position
        self.position += 2
        self.read()
        self.comments.append(self.text[start:self.position])

    def read(self):
        self.trivia()
        if self.position == len(self.text):
            raise ValueError('expected a source form')
        start, first = self.position, self.text[self.position]
        if first == '(':
            return self.sequence(start, 'list', 1)
        if self.text[self.position:self.position + 4].lower() == '#u8(':
            return self.sequence(start, 'bytevector', 4)
        if first in '\"|':
            return self.delimited(start, first)
        if first in "'`,":
            return self.reader_prefix(start)
        if first == ')':
            raise ValueError(f'unexpected closing parenthesis at {start}')
        return self.atom(start)

    def sequence(self, start, kind, width):
        self.position += width
        items = []
        self.trivia()
        while self.position < len(self.text) and self.text[self.position] != ')':
            items.append(self.read())
            self.trivia()
        if self.position == len(self.text):
            raise ValueError(f'unterminated list at {start}')
        self.position += 1
        return Syntax(start, self.position, kind, items=tuple(items))

    def delimited(self, start, delimiter):
        self.position += 1
        while self.position < len(self.text):
            character = self.text[self.position]
            self.position += 1
            if character == '\\':
                self.position += 1
            elif character == delimiter:
                kind = 'string' if delimiter == '\"' else 'escaped-name'
                return Syntax(start, self.position, kind, self.text[start:self.position])
        raise ValueError(f'unterminated delimited token at {start}')

    def reader_prefix(self, start):
        self.position += 2 if self.text.startswith(',@', start) else 1
        spelling = self.text[start:self.position]
        item = self.read()
        return Syntax(start, item.end, 'reader-prefix', spelling, (item,))

    def atom(self, start):
        character = self.text.startswith('#\\', start)
        self.position += 3 if character else 1
        if not character or not self.text[start + 2].isspace() and self.text[start + 2] not in '();\"':
            while self.position < len(self.text):
                if self.text[self.position].isspace() or self.text[self.position] in '();\"':
                    break
                self.position += 1
        kind = 'character' if character else 'atom'
        return Syntax(start, self.position, kind, self.text[start:self.position])


def atoms(nodes):
    for node in nodes:
        if node.kind == 'atom':
            yield node.spelling
        yield from atoms(node.items)


NUMERIC = re.compile(r'^(?:[+-]?(?:[0-9]|\.[0-9]|inf\.0|nan\.0)|#[eibodx])', re.I)


def literals(nodes, text):
    for node in nodes:
        if node.kind in ('string', 'character', 'bytevector') or NUMERIC.match(node.spelling):
            yield text[node.start:node.end]
        else:
            yield from literals(node.items, text)


# ---- Binding-aware token edits ----


class Migration:
    def __init__(self, text):
        self.text, self.reader = text, Reader(text)
        self.forms = self.reader.file()
        self.names = set(atoms(self.forms))
        self.edits, self.counts, self.serial = [], Counter(), 0

    def edit(self, start, end, replacement):
        self.edits.append((start, end, replacement))

    def replace(self, node, replacement):
        if self.text[node.start:node.end] != replacement:
            self.edit(node.start, node.end, replacement)

    def fresh(self, subject):
        self.serial += 1
        name = f'sfir-migration-{subject}-{self.serial}'
        while name in self.names:
            self.serial += 1
            name = f'sfir-migration-{subject}-{self.serial}'
        self.names.add(name)
        return name

    def reserve(self, name, environment, emit=True):
        if name.kind != 'atom' or name.spelling == '.':
            return
        emitted = self.fresh('def') if name.spelling == 'def' else name.spelling
        environment[name.spelling] = emitted
        if emitted != name.spelling:
            if emit:
                self.replace(name, emitted)
            self.counts['reserved-binding-renames'] += 1

    def reference(self, name, environment):
        if name.kind == 'atom' and name.spelling in environment:
            self.replace(name, environment[name.spelling])

    def body(self, forms, outer):
        environment = dict(outer)
        for form in forms:
            if form.head in ('define', 'define-overload', 'define-extern') and len(form.items) > 1:
                self.reserve(form.items[1], environment)
        for form in forms:
            self.expression(form, environment)

    def expression(self, form, environment):
        if form.kind == 'atom':
            self.reference(form, environment)
        elif form.kind != 'list' or not form.items:
            return
        elif form.head == 'lambda':
            self.function(form, environment)
        elif form.head == 'let':
            self.local(form, environment)
        elif form.head == 'begin':
            self.body(form.items[1:], environment)
        elif form.head == 'define':
            self.definition(form, environment)
        elif form.head in ('define-data', 'define-class', 'define-instance'):
            self.static(form, environment)
        elif form.head in ('define-extern', 'define-overload'):
            self.extension(form, environment)
        elif form.head in ('ann', 'inst'):
            self.annotation(form, environment)
        elif form.head == 'match':
            self.match(form, environment)
        elif form.head == 'quote':
            self.empty_list(form)
        elif form.head == 'library':
            self.library(form, environment)
        elif form.head == 'import':
            self.imports(form)
        elif form.head == 'export':
            return
        else:
            for item in form.items:
                self.expression(item, environment)

    def definition(self, form, environment):
        self.replace(form.items[0], 'def')
        self.counts['value-definitions'] += 1
        if len(form.items) == 4:
            self.type(form.items[2])
        for item in form.items[2 if len(form.items) != 4 else 3:]:
            self.expression(item, environment)

    def function(self, form, environment):
        if len(form.items) < 2:
            return
        scope, parameters = dict(environment), form.items[1]
        names = parameters.items if parameters.kind == 'list' else (parameters,)
        for name in names:
            self.reserve(name, scope)
        for body in form.items[2:]:
            self.expression(body, scope)

    def local(self, form, environment):
        if not parallel_let(form):
            return  # Malformed old lets remain rejection fixtures.
        bindings, body = form.items[1:]
        scope = dict(environment)
        for row in bindings.items:
            self.reserve(row.items[0], scope, emit=len(bindings.items) == 1)
        self.replace(form.items[0], 'begin')
        if not bindings.items and self.text[form.items[0].end:bindings.start].isspace():
            self.edit(form.items[0].end, bindings.start, '')
        self.edit(bindings.start, bindings.start + 1, '')
        self.edit(bindings.end - 1, bindings.end, '')
        self.local_initializers(bindings.items, body, environment, scope)
        self.expression(body, scope)
        self.counts['parallel-lets'] += 1

    def local_initializers(self, rows, body, environment, scope):
        aliases = []
        for row in rows:
            name, initializer = row.items
            self.edit(row.start + 1, row.start + 1, 'let ')
            self.expression(initializer, environment)
            if len(rows) > 1:
                temporary = self.fresh('let')
                self.replace(name, temporary)
                aliases.append(f'(let {scope[name.spelling]} {temporary})')
        if aliases:
            self.edit(body.start, body.start, '\n'.join(aliases) + '\n')
            self.counts['simultaneous-initializers'] += len(rows)

    def type(self, form):
        if form.kind == 'atom' and form.spelling == 'Top':
            self.replace(form, 'Any')
            self.counts['any-types'] += 1
        else:
            for item in form.items:
                self.type(item)

    def annotation(self, form, environment):
        if len(form.items) > 1:
            self.expression(form.items[1], environment)
        for item in form.items[2:]:
            self.type(item)

    def static(self, form, environment):
        if len(form.items) < 2:
            return
        if form.head == 'define-instance':
            self.instance(form, environment)
        else:
            self.type_definition(form)
        self.counts['static-definitions'] += 1

    def type_definition(self, form):
        former = 'datatype' if form.head == 'define-data' else 'typeclass'
        header = form.items[1]
        self.replace(form.items[0], 'def')
        if header.kind == 'list' and header.items:
            name = header.items[0]
            parameters = self.text[name.end:header.end - 1]
            self.replace(header, f'{name.spelling} ({former} ({parameters})')
        else:
            self.edit(header.end, header.end, f' ({former} ()')
        self.edit(form.end - 1, form.end - 1, ')')
        for row in form.items[2:]:
            self.static_row_types(row, former)

    def static_row_types(self, row, former):
        if former == 'typeclass':
            for signature in row.items[2:]:
                self.type(signature)
        else:
            for field in row.items[1:]:
                if len(field.items) > 1:
                    self.type(field.items[1])

    def instance(self, form, environment):
        name = self.fresh('instance')
        self.replace(form.items[0], f'def {name} (instance')
        self.edit(form.end - 1, form.end - 1, ')')
        self.type(form.items[1])
        for row in form.items[2:]:
            for implementation in row.items[1:]:
                self.expression(implementation, environment)

    def extension(self, form, environment):
        if form.head == 'define-extern':
            if len(form.items) == 5:
                self.type(form.items[4])
        elif len(form.items) in (3, 4):
            if len(form.items) == 4:
                self.type(form.items[2])
            self.expression(form.items[-1], environment)

    def match(self, form, environment):
        if len(form.items) > 1:
            self.expression(form.items[1], environment)
        for arm in form.items[2:]:
            if not arm.items or not arm.items[0].items:
                continue
            scope = dict(environment)
            self.reference(arm.items[0].items[0], environment)
            for name in arm.items[0].items[1:]:
                self.reserve(name, scope)
            for body in arm.items[1:]:
                self.expression(body, scope)

    def empty_list(self, form):
        if len(form.items) != 2 or form.items[1].kind != 'list' or form.items[1].items:
            return
        if 'empty-list' in self.names:
            raise ValueError('empty-list already occurs: review its binding before migration')
        self.replace(form.items[0], 'empty-list')
        empty = form.items[1]
        self.edit(empty.start, empty.start + 1, '')
        self.edit(empty.end - 1, empty.end, '')
        self.counts['empty-list-values'] += 1

    def imports(self, form):
        for selection in form.items[1:]:
            self.import_set(selection)

    def import_set(self, form):
        if tuple(item.spelling for item in form.items) == ('sfir', 'core'):
            self.replace(form.items[1], 'base')
            self.counts['base-imports'] += 1
        elif form.head in ('only', 'except', 'prefix', 'rename') and len(form.items) > 1:
            self.import_set(form.items[1])

    def library(self, form, environment):
        self.replace(form.items[0], 'define-library')
        if len(form.items) < 2:
            return
        self.import_set(form.items[1])
        opened = False
        for item in form.items[2:]:
            clause = item.head in ('import', 'export')
            if clause and opened:
                self.edit(item.start, item.start, ')\n')
            if not clause and not opened:
                self.edit(item.start, item.start, '(begin\n')
            opened = not clause
        if opened:
            self.edit(form.end - 1, form.end - 1, ')')
        self.body(form.items[2:], environment)
        self.counts['library-descriptions'] += 1

    def result(self):
        self.body(self.forms, {})
        output, position = [], 0
        for start, end, text in sorted(self.edits, key=lambda edit: (edit[0], edit[1])):
            if start < position:
                raise ValueError(f'overlapping migration edits at {start}')
            output.extend((self.text[position:start], text))
            position = end
        output.append(self.text[position:])
        result = ''.join(output)
        self.check_preserved(result)
        return result

    def check_preserved(self, output):
        reader = Reader(output)
        forms = reader.file()
        if self.reader.comments != reader.comments:
            raise ValueError('migration changed comments')
        if tuple(literals(self.forms, self.text)) != tuple(literals(forms, output)):
            raise ValueError('migration changed literal spellings')


def parallel_let(form):
    if len(form.items) != 3 or form.items[1].kind != 'list':
        return False
    rows = form.items[1].items
    if any(row.kind != 'list' or len(row.items) != 2 or row.items[0].kind != 'atom' for row in rows):
        return False
    names = [row.items[0].spelling for row in rows]
    return len(names) == len(set(names))


def migrate(text):
    conversion = Migration(text)
    return conversion.result(), dict(conversion.counts)


def digest(text):
    return hashlib.sha256(text.encode('utf-8')).hexdigest()


def prepare_file(path):
    source = path.read_bytes().decode('utf-8')
    result, counts = migrate(source)
    record = dict(path=str(path), before=digest(source), after=digest(result), changes=counts)
    return result, record


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--write', action='store_true', help='replace explicitly listed source files')
    parser.add_argument('--manifest', type=Path)
    parser.add_argument('sources', nargs='+', type=Path)
    options = parser.parse_args()
    prepared = [prepare_file(path) for path in options.sources]
    if options.write:
        for path, (result, record) in zip(options.sources, prepared):
            if record['before'] != record['after']:
                path.write_bytes(result.encode('utf-8'))
    records = [record for result, record in prepared]
    result = json.dumps(dict(numeric_policy='unchanged', files=records), indent=2) + '\n'
    if options.manifest:
        options.manifest.write_text(result)
    else:
        print(result, end='')


# ---- Tests ----


class MigrationTests(unittest.TestCase):
    def test_single_binding_keeps_outer_initializer_and_body_scope(self):
        source = '(let ((x x)) (begin (define y x) y))'
        self.assertEqual(migrate(source)[0], '(begin (let x x) (begin (def y x) y))')

    def test_simultaneous_initializers_precede_aliases(self):
        source = '(let ((x (record 1)) (y x)) (cons x y))'
        result = migrate(source)[0]
        self.assertIn('(let sfir-migration-let-1 (record 1))', result)
        self.assertIn('(let sfir-migration-let-2 x)', result)
        self.assertLess(result.index('(let sfir-migration-let-2'), result.index('(let x '))

    def test_keyword_parameter_references_and_shadowing(self):
        result = migrate('(lambda (def) (begin (define f (lambda () def)) ((lambda (def) def) def)))')[0]
        self.assertIn('(lambda (sfir-migration-def-1)', result)
        self.assertIn('(lambda () sfir-migration-def-1)', result)
        self.assertIn('(lambda (sfir-migration-def-2) sfir-migration-def-2)', result)

    def test_literal_spellings_and_comments(self):
        source = '(define x (quote ; first\n (#| nested #| body |# |#)))\n(define y "define core Top")\n#; (define ignored 2)\n#\\; #\\) #u8(1 2) -0.0 9223372036854775807'
        result = migrate(source)[0]
        self.assertIn('(empty-list ; first\n #| nested #| body |# |#)', result)
        self.assertIn('#; (define ignored 2)', result)

    def test_static_shapes_and_library_clauses(self):
        source = '(library (sfir core) (export Box) (import (sfir primitive)) (define-data (Box T) (box (x T get))))'
        result = migrate(source)[0]
        self.assertIn('(define-library (sfir base)', result)
        self.assertIn('(def Box (datatype ( T) (box (x T get))))', result)

    def test_type_rename_does_not_touch_text(self):
        self.assertEqual(migrate('(ann "Top" Top)')[0], '(ann "Top" Any)')

    def test_invalid_let_is_not_made_valid(self):
        for source in ['(let loop ((x 1)) x)', '(let ((x 1) (x 2)) x)', '(let ((x 1)) x x)']:
            self.assertEqual(migrate(source)[0], source)

    def test_empty_let_keeps_a_block_without_trailing_space(self):
        self.assertEqual(migrate('(let ()\n  42)')[0], '(begin\n  42)')


if __name__ == '__main__':
    if sys.argv[1:] == ['--self-test']:
        unittest.main(argv=[sys.argv[0]])
    else:
        main()
