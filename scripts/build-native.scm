;; CLI bridge. The existing source compilers produce Wasm before native lowering.
(import (scheme base) (scheme cxr) (scheme file) (scheme read) (scheme write) (scheme process-context)
        (snail-scheme native) (snail-scheme llvm) (snail-scheme compile-build)
        (snail-scheme artifacts) (snail-scheme strict-compiler) (snail-scheme chromium-trace))
(define options (call-with-input-file (cadr (command-line)) read))
(define (option name) (cadr (assq name options)))
(define (record-artifact-inputs artifacts)
  ;; POSIX filenames cannot contain NUL, so this preserves every valid spelling.
  (call-with-output-file (string-append (option 'directory) "/artifact-inputs")
    (lambda (port)
      (for-each (lambda (path) (display path port) (write-char (integer->char 0) port))
                (apply append (map artifact-inputs (artifact-closure artifacts)))))))
(define (source-module)
  (if (eq? (option 'mode) 'strict)
      (apply strict-source-file->wasm (option 'root) (option 'source) (map string->symbol (option 'exports)))
      (let ((compiled (source-file->compilation
                       (option 'root) (option 'source) (option 'directory)
                       (map (lambda (entry) (cons (string->symbol (car entry)) (cadr entry))) (option 'foreign))
                       (option 'libraries) #f)))
        (unless (null? (compilation-artifacts compiled))
          (record-artifact-inputs (compilation-artifacts compiled))
          (stage-artifacts (compilation-artifacts compiled) (option 'directory) "program"))
        (compilation-wasm compiled))))
(with-chromium-trace-to (string-append (option 'directory) "/compile.trace.json")
                        (lambda ()
                          (parameterize ((current-native-imports (native-platform-bindings (option 'bindings))))
                            (if (eq? (option 'mode) 'wasm)
                                (native-binary->llvm (option 'source) (option 'directory) (option 'llvm))
                                (native-wasm->llvm
                                 (source-module)
                                 (option 'directory) (option 'llvm))))))
