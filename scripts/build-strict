#!/usr/bin/env python3
"""Compile the strict Scheme core to a standalone native Wasm main export."""

import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def main():
    if len(sys.argv) != 3:
        raise SystemExit("usage: build-strict SOURCE OUTPUT.wasm")
    source, output = (Path(path).resolve() for path in sys.argv[1:])
    wat = Path(str(output) + ".wat")
    if source in (output, wat, Path(str(output) + ".trace.json"), Path(str(output) + ".raw.wasm")):
        raise SystemExit("build outputs must not replace the source")
    output.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run([os.environ.get("CHIBI", "chibi-scheme"), "-I", str(ROOT / "src"),
                    str(ROOT / "tests/build-strict-program.scm"), str(ROOT), str(source), str(output)], check=True)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
