#!/usr/bin/env python3
"""Compile the strict Scheme core to a standalone native Wasm main export."""

import argparse
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--export", dest="exports", action="append", default=[], metavar="NAME")
    parser.add_argument("source", type=Path)
    parser.add_argument("output", type=Path)
    options = parser.parse_args()
    if len(set(options.exports)) != len(options.exports):
        parser.error("export names must be distinct")
    source, output = options.source.resolve(), options.output.resolve()
    wat = Path(str(output) + ".wat")
    if source in (output, wat, Path(str(output) + ".trace.json"), Path(str(output) + ".raw.wasm")):
        raise SystemExit("build outputs must not replace the source")
    output.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run([os.environ.get("CHIBI", "chibi-scheme"), "-I", str(ROOT / "src"),
                    str(ROOT / "tests/build-strict-program.scm"), str(ROOT), str(source), str(output),
                    *options.exports], check=True)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
