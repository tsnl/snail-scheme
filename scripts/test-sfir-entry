#!/usr/bin/env python3
"""Compile public library entries into artifacts, link providers, and execute both targets."""

import json
import os
from pathlib import Path
import shutil
import subprocess

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / 'tests/sfir-entry'
OUTPUT = ROOT / 'build/sfir-entry'
RECORDS = []
FEATURES = ['--mvp-features', '--enable-gc', '--enable-reference-types', '--enable-tail-call',
            '--enable-mutable-globals', '--enable-sign-ext', '--enable-bulk-memory',
            '--enable-nontrapping-float-to-int']


def run(command, status=0, error=None, **environment):
    result = subprocess.run(list(map(str, command)), cwd=ROOT, capture_output=True, text=True, timeout=240,
                            env={**os.environ, 'BINARYEN_CORES': '1', **environment})
    RECORDS.append(dict(command=list(map(str, command)), status=result.returncode,
                        stdout=result.stdout, stderr=result.stderr, environment=environment))
    (OUTPUT / 'commands.json').write_text(json.dumps(RECORDS, indent=2) + '\n')
    assert result.returncode == status, RECORDS[-1]
    assert error is None or error in result.stderr, RECORDS[-1]


def checked_optimizer():
    optimizer = shutil.which(os.environ.get('WASM_OPT', 'wasm-opt'))
    assert optimizer, 'Binaryen wasm-opt must be available'
    log = OUTPUT / 'optimizer.jsonl'
    log.write_text('')
    wrapper = OUTPUT / 'record-optimizer'
    wrapper.write_text('#!/usr/bin/env python3\nimport json, os, sys\n'
                       f'with open({str(log)!r}, "a") as port: port.write(json.dumps(sys.argv[1:]) + "\\n")\n'
                       f'os.execv({optimizer!r}, [{optimizer!r}, *sys.argv[1:]])\n')
    wrapper.chmod(0o755)
    return wrapper, log


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    optimizer, log = checked_optimizer()
    run([os.environ.get('CHIBI', 'chibi-scheme'), '-I', ROOT / 'src', '-I', ROOT / 'tests',
         FIXTURES / 'build.scm', OUTPUT], WASM_OPT=str(optimizer))
    optimizations = [json.loads(line) for line in log.read_text().splitlines() if '--version' not in line]
    assert len(optimizations) == 6 and all('-O3' in command for command in optimizations)
    provider = OUTPUT / 'provider.wasm'
    run([os.environ.get('WASM_AS', 'wasm-as'), FIXTURES / 'provider.wat', '-o', provider])
    for name in ('main', 'another'):
        wasm, native = OUTPUT / (name + '.linked.wasm'), OUTPUT / name
        run([os.environ.get('WASM_MERGE', 'wasm-merge'), *FEATURES, OUTPUT / (name + '.wasm'), 'program',
             provider, 'entry.test', '-o', wasm])
        run([os.environ.get('NODE', 'node'), FIXTURES / 'run.mjs', wasm])
        run([os.environ.get('CLANG', 'clang'), '-O3', '-ffunction-sections', '-fdata-sections',
             '-Wl,--gc-sections', '-fuse-ld=lld', '-I', ROOT / 'src', OUTPUT / (name + '.o'),
             ROOT / 'src/native.c', ROOT / 'src/precise-gc.c', FIXTURES / 'run.c', '-lm', '-o', native])
        run([native], SNAIL_NATIVE_GC_INTERVAL='1')
        run([native, 'early'], 1, 'WebAssembly trap')
        run([native, 'repeat'], 1, 'WebAssembly trap')
        print(f'PASS public Entry alias {name}: linked Wasm and native64 object', flush=True)


if __name__ == '__main__':
    main()
