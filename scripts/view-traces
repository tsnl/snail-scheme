#!/usr/bin/env python3
"""Serve one trace in the shell's Perfetto UI over a loopback HTTP connection."""

import argparse
import json
import mimetypes
import os
import shutil
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from string import Template
from urllib.parse import quote, unquote, urlsplit


# ---- Perfetto assets and startup ----


def perfetto_ui():
    value = os.environ.get("PERFETTO_UI")
    if not value:
        raise RuntimeError("Perfetto UI is unavailable; enter nix-shell first")
    directory = Path(value).resolve()
    contained_file(directory, "index.html")
    return directory


# Configure the pinned UI before its loader runs. Use the browser's origin so
# the forwarded local port can differ from the server's listening port.
BOOTSTRAP = Template("""<script>
let settings = {};
try { settings = JSON.parse(localStorage.getItem('perfettoSettings')) || {}; } catch {}
localStorage.setItem('perfettoSettings', JSON.stringify({...settings, theme: 'dark'}));
location.replace('/#!/?url=' + encodeURIComponent(location.origin + $trace));
</script>
""")


def perfetto_page(directory, trace):
    bootstrap = BOOTSTRAP.substitute(trace=json.dumps("/trace/" + quote(trace.name)))
    return (directory / "index.html").read_text().replace("</head>", bootstrap + "</head>", 1)


# ---- HTTP serving ----


def contained_file(directory, relative):
    path = (directory / relative).resolve()
    if not path.is_relative_to(directory) or not path.is_file():
        raise FileNotFoundError(relative)
    return path


class TraceHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        try:
            path = unquote(urlsplit(self.path).path)
            if path in ("/", "/index.html"):
                return self.send_html(perfetto_page(self.server.ui, self.server.trace))
            if path == "/trace/" + self.server.trace.name:
                file = self.server.trace
            elif path.startswith("/trace/"):
                raise FileNotFoundError(path)
            else:
                file = contained_file(self.server.ui, path.lstrip("/"))
            self.send_file(file)
        except (OSError, ValueError):
            self.send_error(404, "File not found")

    def send_html(self, page):
        content = page.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(content)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(content)

    def send_file(self, path):
        with path.open("rb") as source:
            self.send_response(200)
            self.send_header("Content-Type", mimetypes.guess_type(path)[0] or "application/octet-stream")
            self.send_header("Content-Length", str(os.fstat(source.fileno()).st_size))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            shutil.copyfileobj(source, self.wfile)


class TraceServer(ThreadingHTTPServer):
    def __init__(self, port, trace, ui):
        self.trace = trace
        self.ui = ui
        super().__init__(("127.0.0.1", port), TraceHandler)


# ---- Command line ----


def trace_path(value):
    path = Path(value).resolve()
    if not path.is_file():
        raise argparse.ArgumentTypeError(f"not a trace file: {path}")
    with path.open("rb"):
        pass
    return path


def arguments():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("trace", type=trace_path, help="JSON or binary trace file to load")
    parser.add_argument("--port", type=int, default=9000, help="loopback HTTP port (default: 9000)")
    args = parser.parse_args()
    if not 0 <= args.port <= 65535:
        parser.error("port must be between 0 and 65535")
    return args


def main():
    args = arguments()
    with TraceServer(args.port, args.trace, perfetto_ui()) as server:
        port = server.server_address[1]
        print(f"Open http://127.0.0.1:{port}/", flush=True)
        print(f"For SSH: ssh -N -L {port}:127.0.0.1:{port} user@server", flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        sys.exit(f"view-traces: {error}")
