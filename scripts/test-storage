#!/usr/bin/env python3
"""Execute fixed-storage vectors and prove their actual Wasm array operations."""
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build/storage-tests"
EXPECTED = "fixed vector storage checks passed\n"


def check(mode):
    output = BUILD / mode
    subprocess.run([os.environ.get("CHIBI", "chibi-scheme"), "-I", str(ROOT / "src"),
                    str(ROOT / "tests/build-storage-program.scm"), str(ROOT),
                    str(ROOT / "tests/programs/backend-storage-vectors.scm"), str(output), mode],
                   cwd=ROOT, check=True)
    result = subprocess.run([os.environ.get("NODE", "node"), "--no-warnings",
                             str(ROOT / "scripts/run-wasi.mjs"), f"{output}.wasm"],
                            cwd=ROOT, capture_output=True, text=True, check=True)
    assert result.stdout == EXPECTED and not result.stderr, result
    code = "\n".join(line for line in Path(f"{output}.wat").read_text().splitlines()
                     if line.startswith("(func $library") or line.startswith("(func $specialized"))
    if mode == "on":
        for operation in ("array.new_fixed $elements:integer", "call $vector_new:real",
                          "array.new_fixed $elements:boolean", "array.new_fixed $elements:character",
                          "array.new_fixed $elements:pair", "call $vector_ref:integer",
                          "call $vector_ref:real", "call $vector_set:real"):
            assert operation in code, f"missing actual concrete operation: {operation}"
    else:
        assert "array.new_fixed $elements:" not in code
        assert "call $vector_new:real" not in code
    print(f"passed fixed storage {mode}", flush=True)


BUILD.mkdir(parents=True, exist_ok=True)
for mode in ("on", "off"):
    check(mode)
