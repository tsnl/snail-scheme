#!/usr/bin/env python3
"""Compile SFIR through Binaryen Wasm optimization to a 64-bit native executable."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SCALARS = {'i32': 'i32', 'u32': 'i32', 'i64': 'i64', 'u64': 'i64',
           'f32': 'f32', 'f64': 'f64', '': 'void'}
C_SCALARS = {'int': 'i32', 'unsigned int': 'i32', 'long': 'i64',
             'unsigned long': 'i64', 'long long': 'i64', 'unsigned long long': 'i64',
             'int32_t': 'i32', 'uint32_t': 'i32', 'int64_t': 'i64', 'uint64_t': 'i64',
             'float': 'f32', 'double': 'f64', 'void': 'void'}


# ---- Explicit tools and retained build evidence ----


def tool(variable, default):
    name = os.environ.get(variable, default)
    found = shutil.which(name)
    if not found:
        raise ValueError(f'{default} is missing or unusable: {name}; install it or set {variable}')
    return found


def run(command, records):
    result = subprocess.run(list(map(str, command)), cwd=ROOT, capture_output=True, text=True,
                            env={**os.environ, 'BINARYEN_CORES': os.environ.get('BINARYEN_CORES', '1')})
    records.append(dict(command=list(map(str, command)), status=result.returncode,
                        stdout=result.stdout, stderr=result.stderr))
    if result.returncode:
        raise RuntimeError(result.stderr or result.stdout)
    return result.stdout


def preflight(records):
    if platform.machine() != 'x86_64' or sys.platform != 'linux':
        raise ValueError('the tested native target is 64-bit x86-64 Linux; other targets need ABI validation')
    tools = dict(chibi=tool('CHIBI', 'chibi-scheme'), clang=tool('CLANG', 'clang'),
                 cargo=tool('CARGO', 'cargo'), lld=tool('LLD', 'ld.lld'))
    for variable, default in [('WASM_AS', 'wasm-as'), ('WASM_OPT', 'wasm-opt'),
                              ('WASM_DIS', 'wasm-dis'), ('WASM_MERGE', 'wasm-merge')]:
        run([tool(variable, default), '--version'], records)
    run([tools['clang'], '--version'], records)
    run([tools['cargo'], '--version'], records)
    run([tools['lld'], '--version'], records)
    return tools


# ---- Direct provider declarations ----


def binding(module, name, symbol, arguments, result):
    return [[module, name], symbol, arguments, [] if result == 'void' else [result]]


def rust_bindings():
    # This closed reader accepts only literal export names and scalar Rust types.
    # It reads the exact sources Cargo builds. Aliases, pointers and new signature
    # syntax fail here rather than being guessed from a Wasm caller or a linker.
    declaration = re.compile(r'#\[unsafe\(export_name = "([^"]+)"\)\]\s*'
                             r'pub (?:unsafe )?extern "C" fn \w+\(([^)]*)\)\s*'
                             r'(?:->\s*([^\s{]+))?\s*\{')
    bindings = []
    for source in sorted((ROOT / 'src').glob('*.rs')):
        text = source.read_text()
        matches = list(declaration.finditer(text))
        if text.count('#[unsafe(export_name') != len(matches):
            raise ValueError(f'unsupported Rust export declaration syntax in {source}')
        for match in matches:
            name, parameters, result = match.groups()
            if name == 'snail:report-error':
                continue  # Native pointers have their separate diagnostic boundary.
            types = [part.split(':', 1)[1].strip() for part in parameters.split(',') if part.strip()]
            try:
                arguments, result = [SCALARS[value] for value in types], SCALARS[result or '']
            except KeyError as error:
                raise ValueError(f'unsupported native Rust scalar type in {source}: {error}') from error
            bindings.append(binding('snail.library', name, name, arguments, result))
    return bindings


def c_type(node):
    spelling = node['type'].get('desugaredQualType', node['type']['qualType'])
    if spelling not in C_SCALARS:
        raise ValueError(f'unsupported native C scalar type: {spelling}; use an explicit scalar adapter')
    return C_SCALARS[spelling]


def c_bindings(module, header, clang, records):
    ast = json.loads(run([clang, '-x', 'c', '-Xclang', '-ast-dump=json', '-fsyntax-only', header], records))
    result = []
    for node in ast.get('inner', []):
        if node['kind'] != 'FunctionDecl' or node.get('isImplicit'):
            continue
        if node.get('variadic') or node.get('storageClass') == 'static':
            raise ValueError(f'provider function requires an external, nonvariadic C prototype: {node["name"]}')
        if node['type']['qualType'].endswith('()'):
            raise ValueError(f'provider function needs an explicit C prototype: {node["name"]}; use (void) for no arguments')
        spelling = node['type']['qualType']
        if not re.fullmatch(r'[^()]+ \([^()]+\)', spelling):
            raise ValueError(f'unsupported native C calling convention or function type: {spelling}')
        returns = spelling.split(' (', 1)[0]
        arguments = [c_type(param) for param in node.get('inner', []) if param['kind'] == 'ParmVarDecl']
        result.append(binding(module, node['name'], node.get('mangledName', node['name']),
                              arguments, c_type({'type': {'qualType': returns}})))
    if not result:
        raise ValueError(f'C provider header has no function declarations: {header}')
    return result


def scheme(value):
    if isinstance(value, list):
        return '(' + ' '.join(scheme(item) for item in value) + ')'
    return json.dumps(value, ensure_ascii=False)


def binding_text(bindings):
    return '(' + '\n'.join(f'({scheme(key)} {scheme(symbol)} '
                            f'({" ".join(params)}) ({" ".join(results)}))'
                            for key, symbol, params, results in bindings) + ')'


# ---- Source to shared Wasm, then mechanical LLVM lowering ----


def configuration(options, directory, bindings):
    mode = 'wasm' if options.wasm else 'sfir'
    fields = {'root': scheme(str(ROOT)), 'source': scheme(str(options.source.resolve())),
              'directory': scheme(str(directory)), 'llvm': scheme(str(directory / 'module.ll')),
              'mode': mode, 'bindings': binding_text(bindings),
              'exports': scheme(options.exports),
              'libraries': scheme([str(path.resolve()) for path in options.library]),
              'generation-provider': scheme(str(options.generation_provider.resolve())) if options.generation_provider else '#f',
              'command': '#f' if options.entry_c else '#t'}
    path = directory / 'build.scm'
    path.write_text('(' + '\n'.join(f'({key} {value})' for key, value in fields.items()) + ')\n')
    return path


def entry_source(options, directory):
    if options.entry_c:
        return options.entry_c.resolve()
    name = 'main'
    llvm = (directory / 'module.ll').read_text()
    signature = re.search(r'^define (\w+) @"wasm\.' + name + r'"\(\)', llvm, re.MULTILINE)
    if not signature or signature[1] not in ('void', 'i32', 'i64'):
        raise ValueError(f'native command requires a zero-argument {name} returning Unit, I32 or I64')
    ctype = {'void': 'void', 'i32': 'int32_t', 'i64': 'int64_t'}[signature[1]]
    invoke = 'guest_main(); int status = 0;'
    if name == 'main' and ctype != 'void':
        invoke = 'int64_t value = guest_main(); int status = (value >= 0 && value <= 255) ? (int)value : 1;'
    path = directory / 'entry.c'
    path.write_text('#include <stdint.h>\nextern void native_host_init(int, char **);\n'
                    'extern void native_module_init(void);\nextern int native_finish(int);\n'
                    f'extern {ctype} guest_main(void) __asm__("wasm.{name}");\n'
                    'int main(int argc, char **argv) {\n  native_host_init(argc, argv);\n'
                    f'  native_module_init();\n  {invoke}\n  return native_finish(status);\n}}\n')
    return path


def provider_objects(options, directory, tools, records):
    bindings, providers = rust_bindings(), []
    for module, header, provider in options.c_provider:
        header, provider = Path(header).resolve(), Path(provider).resolve()
        bindings += c_bindings(module, header, tools['clang'], records)
        if provider.suffix == '.c':
            object_file = directory / f'provider-{len(providers)}.o'
            run([tools['clang'], '-O3', '-c', '-include', header, provider, '-o', object_file], records)
            provider = object_file
        providers.append(provider)
    keys = [tuple(entry[0]) for entry in bindings]
    if len(keys) != len(set(keys)):
        raise ValueError('duplicate native provider declaration')
    return bindings, providers


def compile_program(options, directory, tools, records):
    bindings, providers = provider_objects(options, directory, tools, records)
    config = configuration(options, directory, bindings)
    run([tools['chibi'], '-I', ROOT / 'src', ROOT / 'scripts/build-native.scm', config], records)
    runtime = ROOT / 'build/native-runtime'
    run([tools['cargo'], 'rustc', '--quiet', '--offline', '--release', '--crate-type=staticlib',
         '--features=native-runtime', '--manifest-path', ROOT / 'Cargo.toml', '--target-dir', runtime], records)
    run([tools['clang'], '-O3', '-flto', '-ffunction-sections', '-fdata-sections',
         '-Wl,--gc-sections', f'-fuse-ld={tools["lld"]}', '-I', ROOT / 'src',
         directory / 'module.ll', ROOT / 'src/native.c', ROOT / 'src/precise-gc.c',
         entry_source(options, directory), *providers, runtime / 'release/libsnail_runtime.a',
         '-ldl', '-lpthread', '-lm', '-o', directory / 'program'], records)


def protected_inputs(options):
    inputs = [options.source, *([options.entry_c] if options.entry_c else [])]
    if options.generation_provider:
        inputs.append(options.generation_provider)
    inputs += [Path(item) for provider in options.c_provider for item in provider[1:]]
    inputs += [path for path in (ROOT / 'src').rglob('*') if path.is_file()]
    inputs += [path for library in [ROOT / 'lib', *options.library] for path in library.rglob('*.sfir')]
    inputs += [ROOT / 'Cargo.toml', ROOT / 'Cargo.lock', Path(__file__), ROOT / 'scripts/build-native.scm']
    inputs += [ROOT / 'build/native-runtime/release/libsnail_runtime.a']
    return {path.resolve() for path in inputs}


def publish_program(output, directory, inputs):
    if output.resolve() in inputs:
        raise ValueError('native output must not replace an input')
    os.replace(directory / 'program', output)


def record_evidence(directory, tools, records, inputs, output):
    artifacts = [*directory.glob('*.wasm'), directory / 'module.ll', directory / 'program', output,
                 ROOT / 'build/native-runtime/release/libsnail_runtime.a']
    hashes = {str(path): hashlib.sha256(path.read_bytes()).hexdigest()
              for path in sorted({*inputs, *artifacts}) if path.is_file()}
    evidence = dict(tools=tools, sha256=hashes, commands=records)
    (directory / 'build.json').write_text(json.dumps(evidence, indent=2) + '\n')


def build(options):
    records = []
    tools = preflight(records)
    output, inputs = options.output.absolute(), protected_inputs(options)
    if output.resolve() in inputs:
        raise ValueError('native output must not replace an input')
    output.parent.mkdir(parents=True, exist_ok=True)
    directory = Path(tempfile.mkdtemp(prefix=output.name + '.native-', dir=output.parent))
    try:
        compile_program(options, directory, tools, records)
        publish_program(output, directory, inputs)
    except (OSError, ValueError, RuntimeError) as error:
        raise RuntimeError(f'{error}\nnative build failed; intermediates retained: {directory}') from error
    finally:
        record_evidence(directory, tools, records, inputs, output)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--wasm', action='store_true', help='consume an unlinked Wasm binary')
    parser.add_argument('--export', dest='exports', action='append', default=[])
    parser.add_argument('-I', dest='library', type=Path, action='append', default=[])
    parser.add_argument('--generation-provider', type=Path, metavar='MODULE',
                        help='ES module providing createProviders(sourceContext) for library generators')
    parser.add_argument('--c-provider', nargs=3, action='append', default=[], metavar=('MODULE', 'HEADER', 'SOURCE_OR_ARCHIVE'))
    parser.add_argument('--entry-c', type=Path, help='C invocation host with an explicit entry contract')
    parser.add_argument('source', type=Path)
    parser.add_argument('output', type=Path)
    build(parser.parse_args())


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        sys.exit(str(error))
