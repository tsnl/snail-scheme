#!/usr/bin/env python3
"""Bake a finite Ink conversation into Snail data with the reference inklecate."""
import argparse
from collections import deque
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile


def check_commands(container):
    # In Ink format 21, instructions are bare strings, prose starts with ^,
    # and the final object contains named child containers and metadata.
    for token in container:
        if isinstance(token, list):
            check_commands(token)
        elif isinstance(token, dict):
            if "x()" in token:
                raise ValueError(f"EXTERNAL {token['x()']} needs a live Ink runtime")
            for child in token.values():
                if isinstance(child, list):
                    check_commands(child)
        elif token in ("rnd", "srnd", "lrnd", "seq"):
            raise ValueError("random output and shuffle sequences need a live Ink runtime")


def play(compiler, story, path):
    result = subprocess.run([compiler, "-p", "-j", str(story)], input="".join(f"{i + 1}\n" for i in path),
                            capture_output=True, text=True, check=True, timeout=30)
    # inklecate sends adjacent JSON objects, sometimes on the same line.
    decoder = json.JSONDecoder()
    stream = result.stdout.lstrip()
    turns = []
    lines, labels, tags = [], [], []
    while stream:
        message, end = decoder.raw_decode(stream)
        stream = stream[end:].lstrip()
        if "text" in message:
            lines.extend(message["text"].splitlines())
        elif "tags" in message:
            tags.extend(message["tags"])
        elif "choices" in message:
            labels = [choice["text"] for choice in message["choices"]]
        elif message.get("needInput"):
            turns.append((lines, labels, tags))
            lines, labels, tags = [], [], []
        elif message.get("issues") or message.get("error") or message.get("cmdOutput") or message.get("compile-success") is False:
            raise ValueError(f"Ink reported {message}")
    if len(turns) == len(path):
        turns.append((lines, [], tags))
    if len(turns) != len(path) + 1:
        raise ValueError(f"Ink could not replay choice path {path}")
    return turns


def explore(compiler, story, limit):
    todo = deque([()])
    observed, ids = {}, {}
    while todo:
        path = todo.popleft()
        if len(observed) >= limit:
            raise ValueError(f"conversation exceeds {limit} turns; check for unbounded choices")
        turns = play(compiler, story, path)
        for i, turn in enumerate(turns[:-1]):
            if turn != observed[path[:i]]:
                raise ValueError(f"nondeterministic replay at choice path {path[:i]}")
        turn = observed[path] = turns[-1]
        names = [tag[3:].strip() for tag in turn[2] if tag.startswith("id:")]
        if len(names) > 1 or (names and not names[0]):
            raise ValueError(f"expected one nonempty save id at {path}")
        key = ids[path] = names[0] if names else "start" + "".join(f".{n + 1}" for n in path)
        if any(ids[path[:i]] == key for i in range(len(path))):
            raise ValueError(f"cyclic passage {key!r}; baking requires a finite conversation")
        todo.extend(path + (i,) for i in range(len(turn[1])))
    pages = {}
    for path, (lines, labels, _) in observed.items():
        page = (lines, [(label, ids[path + (i,)]) for i, label in enumerate(labels)])
        if pages.setdefault(ids[path], page) != page:
            raise ValueError(f"save id {ids[path]!r} names different dialogue states")
    return ids[()], pages


def quoted(s):
    return '"' + s.replace('\\', '\\\\').replace('"', '\\"').replace('\t', '\\t').replace('\r', '\\r').replace('\n', '\\n') + '"'


def scheme_list(xs):
    return "(list " + " ".join(xs) + ")" if xs else "(Nil)"


def library(name, start, pages):
    forms = []
    for key, (lines, choices) in pages.items():
        replies = [f"(new Reply (text {quoted(label)}) (next {quoted(target)}))" for label, target in choices]
        forms.append(f"(new Passage (id {quoted(key)}) (lines {scheme_list(list(map(quoted, lines)))}) (choices {scheme_list(replies)}))")
    return f""";; Generated by scripts/bake-ink. Edit the .ink source.
(define-library ({name})
  (export conversation)
  (import
   (snail core base)
   (snail shell game dialogue))
  (begin
    (define conversation (→ Dialogue)
      (new Dialogue (start {quoted(start)}) (pages {scheme_list(forms)})))))
"""


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path)
    parser.add_argument("output", type=Path, help="library .sld under src/")
    parser.add_argument("--inklecate", default=os.environ.get("INKLECATE", "inklecate"))
    parser.add_argument("--check", action="store_true", help="verify the committed library matches the Ink source")
    parser.add_argument("--max-turns", type=int, default=256)
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    names = args.output.resolve().relative_to(root / "src").with_suffix("").parts
    if args.output.suffix != ".sld" or not all(re.fullmatch(r"[a-z][a-z0-9-]*", n) for n in names):
        parser.error("output must name a Snail library under src/")
    try:
        with tempfile.TemporaryDirectory() as tmp:
            compiled = Path(tmp) / "story.json"
            subprocess.run([args.inklecate, "-o", str(compiled), str(args.source)], check=True, timeout=30)
            story = json.loads(compiled.read_text(encoding="utf-8-sig"))
            if story["inkVersion"] != 21:
                raise ValueError("expected Ink format 21 (inklecate 1.2.1)")
            check_commands(story["root"])
            start, pages = explore(args.inklecate, compiled, args.max_turns)
            source = library(" ".join(names), start, pages)
            formatted = subprocess.run([str(root / "snail-scheme"), "format"], input=source,
                                       text=True, capture_output=True, check=True).stdout
            if args.check:
                if args.output.read_text() != formatted:
                    raise ValueError(f"{args.output} is stale; bake it again")
            else:
                args.output.write_text(formatted)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        parser.exit(1, f"bake-ink: {error}\n")


if __name__ == "__main__":
    main()
