#!/usr/bin/env python3
"""Compile once to WasmGC and execute fixtures in a Wasm engine or native adapter."""

import argparse
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build/backend-tests"
SUCCESSES = {
    "backend-wasmgc": "",
    "backend-bootstrap": "bootstrap checks passed\n",
    "backend-numeric": "numeric instruction checks passed\n",
    "backend-numeric-rebinding": "numeric rebinding checks passed\n",
    "backend-semantics": "backend checks passed\n",
    "backend-control": "control-flow checks passed\n",
}
ERRORS = {
    "arity": "wrong number of arguments",
    "uninitialized": "read of an uninitialized binding",
    "values": "expected a single value",
    "overflow": "integer overflow",
    "numeric-type": "expected a number",
    "numeric-values": "expected a single value",
    "numeric-arity": "wrong number of arguments",
}


# ---- Compilation and execution ----


def options():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target", choices=("native", "wasm", "both"), default="wasm")
    return parser.parse_args()


def checked(command):
    subprocess.run([str(arg) for arg in command], cwd=ROOT, check=True)


def compile_fixture(name):
    output = BUILD / f"{name}.wasm"
    checked([os.environ.get("CHIBI", "chibi-scheme"), "-I", ROOT / "src",
             ROOT / "tests/build-program.scm", ROOT, ROOT / "tests/programs" / f"{name}.scm", output])
    return output


def execution_command(wasm, native):
    if native:
        output = wasm.with_suffix("")
        checked([os.environ.get("CHIBI", "chibi-scheme"), "-I", ROOT / "src",
                 ROOT / "tests/build-native.scm", ROOT, wasm, output])
        return [str(output)]
    return [os.environ.get("NODE", "node"), "--no-warnings",
            str(ROOT / "scripts/run-wasi.mjs"), str(wasm)]


def require_result(command, stdout, diagnostic="", arguments=()):
    result = subprocess.run([*command, *arguments], cwd=ROOT, text=True,
                            capture_output=True, check=False, timeout=120)
    status_matches = result.returncode != 0 if diagnostic else result.returncode == 0
    message_matches = diagnostic in result.stderr if diagnostic else not result.stderr
    if not status_matches or result.stdout != stdout or not message_matches:
        raise RuntimeError(f"exit={result.returncode}\nstdout={result.stdout!r}\n"
                           f"stderr={result.stderr!r}")


def check_fixture(name, targets):
    wasm = compile_fixture(name)
    for native in targets:
        command = execution_command(wasm, native)
        if name == "backend-errors":
            for argument, diagnostic in ERRORS.items():
                require_result(command, "", diagnostic, [argument])
        else:
            require_result(command, SUCCESSES[name])
        print(f"passed {'native' if native else 'Wasm'}: {name}", flush=True)


def check_finalizers():
    output = BUILD / "finalizers.wasm"
    checked([os.environ.get("WASM_AS", "wasm-as"), ROOT / "tests/finalizers.wat",
             "--enable-gc", "--enable-reference-types", "-o", output])
    checked([os.environ.get("NODE", "node"), "--expose-gc",
             ROOT / "tests/check-finalizers.mjs", output])


def main():
    target = options().target
    targets = (False, True) if target == "both" else (target == "native",)
    BUILD.mkdir(parents=True, exist_ok=True)
    for name in [*SUCCESSES, "backend-errors"]:
        check_fixture(name, targets)
    if False in targets:
        check_finalizers()
    print("WasmGC backend checks passed; call/cc remains unsupported future work")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f"backend test failed: {error}", file=sys.stderr)
        sys.exit(1)
