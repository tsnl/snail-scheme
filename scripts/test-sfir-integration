#!/usr/bin/env python3
"""Check bare SFIR source contracts by compiling and executing native Wasm exports."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / "tests/sfir-integration"


# ---- Captured commands ----


def executing_group(group):
    members = []
    for path in Path('/proc').glob('[0-9]*/stat'):
        try:
            fields = path.read_text().rsplit(')', 1)[1].split()
            if int(fields[2]) == group and fields[0] not in ('Z', 'X'):
                members.append(int(path.parent.name))
        except (OSError, ValueError, IndexError):
            pass
    return members


def finish_group(group):
    deadline = time.monotonic() + 5
    while True:
        try:
            os.killpg(group, signal.SIGKILL)
        except ProcessLookupError:
            pass
        members = executing_group(group)
        if not members or time.monotonic() >= deadline:
            return members
        time.sleep(0.02)


def invoke(command, root, log):
    started = time.monotonic()
    process = subprocess.Popen(list(map(str, command)), cwd=root, text=True,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               start_new_session=True)
    expired = False
    try:
        stdout, stderr = process.communicate(timeout=120)
    except subprocess.TimeoutExpired:
        expired = True
        os.killpg(process.pid, signal.SIGKILL)
        stdout, stderr = process.communicate(timeout=10)
    finally:
        remaining = finish_group(process.pid)
    result = dict(command=list(map(str, command)), status=process.returncode,
                  stdout=stdout, stderr=stderr, timeout=expired,
                  executing_descendants=remaining, process_group=process.pid,
                  seconds=time.monotonic() - started)
    log.write_text(json.dumps(result, indent=2) + "\n")
    return result


def check_case(case, compiler, output):
    source = FIXTURES / (case["name"] + ".sfir")
    artifact = output / (case["name"] + ".wasm")
    raw_artifact = Path(str(artifact) + ".raw.wasm")
    artifact.unlink(missing_ok=True)
    raw_artifact.unlink(missing_ok=True)
    command = [compiler / "scripts/build-sfir", source, artifact]
    for name in case.get("exports", {}):
        command.extend(["--export", name])
    built = invoke(command, compiler, output / (case["name"] + "-compile.json"))
    result = dict(name=case["name"], source_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),
                  compile=built, passed=False)
    if "error" in case:
        diagnostic = built["stdout"] + built["stderr"]
        located = [line for line in diagnostic.splitlines()
                   if re.search(re.escape(source.name) + r":\d+:\d+:", line)]
        result["passed"] = (built["status"] > 0 and not built["timeout"]
                            and not built["executing_descendants"]
                            and any(re.search(case["error"], line, re.I) for line in located))
        return result
    if (built["status"] != 0 or built["timeout"] or built["executing_descendants"]
            or not artifact.is_file() or not raw_artifact.is_file()):
        return result
    observers = json.dumps(case.get("exports", {}))
    run = invoke([os.environ.get("NODE", "node"), FIXTURES / "run.mjs", artifact,
                  case["result"], observers], compiler, output / (case["name"] + "-run.json"))
    result.update(run=run, module_sha256=hashlib.sha256(artifact.read_bytes()).hexdigest())
    raw_run = invoke([os.environ.get("NODE", "node"), FIXTURES / "run.mjs", raw_artifact,
                      case["result"], observers], compiler, output / (case["name"] + "-raw-run.json"))
    result.update(raw_run=raw_run, raw_module_sha256=hashlib.sha256(raw_artifact.read_bytes()).hexdigest())
    result["passed"] = all(record["status"] == 0 and not record["timeout"]
                           and not record["executing_descendants"]
                           for record in [run, raw_run])
    return result


# ---- Independent contract fixtures ----


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--compiler", type=Path, default=ROOT)
    parser.add_argument("--output", type=Path, default=ROOT / "build/sfir-integration")
    parser.add_argument("cases", nargs="*")
    options = parser.parse_args()
    options.output.mkdir(parents=True, exist_ok=True)
    cases = json.loads((FIXTURES / "cases.json").read_text())
    names = [case["name"] for case in cases]
    assert len(names) == len(set(names)) == 307
    assert set(names) == {source.stem for source in FIXTURES.glob('*.sfir')}
    if options.cases:
        known = {case["name"] for case in cases}
        if unknown := set(options.cases) - known:
            parser.error(f"unknown cases: {', '.join(sorted(unknown))}")
        cases = [case for case in cases if case["name"] in options.cases]
    results = []
    for case in cases:
        result = check_case(case, options.compiler.resolve(), options.output.resolve())
        results.append(result)
        (options.output / "results.json").write_text(json.dumps(results, indent=2) + "\n")
        print(("PASS" if result["passed"] else "FAIL") + " " + case["name"], flush=True)
    passed = sum(result["passed"] for result in results)
    print(f"Passed {passed}/{len(results)} SFIR compiler contracts")
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
