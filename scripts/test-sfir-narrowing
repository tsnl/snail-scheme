#!/usr/bin/env python3
"""Check numeric narrowing, IEEE rounding and operand effects on both targets."""

import json
import math
import os
from pathlib import Path
import runpy
import struct
import tempfile

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / 'tests/sfir-narrowing'
SUPPORT = runpy.run_path(str(ROOT / 'tests/sfir-instances/check.py'))
run, succeeded, digest = SUPPORT['run'], SUPPORT['succeeded'], SUPPORT['digest']


# ---- Independent integer range and IEEE conversion oracles ----


def spelling(value):
    if math.isnan(value):
        return 'NaN'
    if math.isinf(value):
        return '-Infinity' if value < 0 else 'Infinity'
    return repr(value)


def float_case(value):
    try:
        expected = spelling(struct.unpack('!f', struct.pack('!f', value))[0])
    except OverflowError:
        expected = 'trap'
    return dict(kind='float', input=spelling(value), expected=expected)


def cases():
    integers = [0, 1, -1, 2**31-2, 2**31-1, -2**31, -2**31+1,
                2**31, -2**31-1, 2**32-1, 2**32, -2**32, 2**63-1, -2**63]
    maximum, halfway = float(2**128-2**104), float(2**128-2**103)
    floats = [0.0, 1.0, 1.5, 1+2**-24, math.nextafter(1+2**-24, math.inf), 1+3*2**-24,
              2**-126, 2**-126-2**-149, 2**-149, 2**-150, math.nextafter(2**-150, math.inf),
              5e-324, maximum, math.nextafter(halfway, 0), halfway, math.nextafter(halfway, math.inf),
              1e300, math.inf]
    result = [dict(kind='integer', input=str(value), expected=str(value) if -2**31 <= value < 2**31 else 'trap')
              for value in integers]
    controls = [dict(kind='control', input=str(mode), expected='trap' if mode % 2 else '42') for mode in range(4)]
    return result + [float_case(sign * value) for value in floats for sign in (1, -1)] + [float_case(math.nan)] + controls


def check_oracle_anchors():
    halfway = float(2**128-2**103)
    assert float_case(halfway)['expected'] == 'trap'
    assert float_case(math.nextafter(halfway, 0))['expected'] == '3.4028234663852886e+38'
    assert float_case(2**-150)['expected'] == '0.0'
    assert float_case(-2**-150)['expected'] == '-0.0'
    assert float_case(math.nextafter(2**-150, math.inf))['expected'] == '1.401298464324817e-45'
    assert float_case(1+2**-24)['expected'] == '1.0'
    assert float_case(1+3*2**-24)['expected'] == '1.000000238418579'


# ---- One retained guest, raw and optimized execution, and native parity ----


def build(output):
    source, wasm = FIXTURES / 'main.sfir', output / 'program.wasm'
    exports = [argument for name in ('narrow-integer', 'narrow-float', 'narrow-control', 'effect-count') for argument in ('--export', name)]
    succeeded(run([ROOT / 'scripts/build-sfir', *exports, source, wasm], output / 'compile.json'))
    raw, native = Path(str(wasm) + '.raw.wasm'), output / 'program.native'
    probe = ROOT / 'tests/sfir-instances'
    succeeded(run([ROOT / 'scripts/build-native', '--wasm', '--entry-c', FIXTURES / 'entry.c',
                   '--c-provider', 'instance.probe', probe / 'probe.h', probe / 'probe.c', raw, native],
                  output / 'native-build.json'))
    optimized, = output.glob('program.native.native-*/optimized.wasm')
    assert optimized.read_bytes() == wasm.read_bytes(), 'native must lower the same optimized guest'
    return wasm, raw, native


def check_native(native, inputs, output):
    for index, case in enumerate(inputs):
        for indirect in (0, 1):
            record = run([native, case['kind'], indirect, case['input'], case['expected']],
                         output / f'native-{index}-{indirect}.json', SNAIL_NATIVE_GC_INTERVAL='1')
            trap = case['expected'] == 'trap'
            assert record['status'] == int(trap), record
            assert record['stderr'] == ('WebAssembly trap\n' if trap else ''), record
            effect = case['kind'] != 'control' or trap
            assert record['stdout'] == ('effect:1\n' if effect else ''), record


# ---- Tests ----


def main():
    check_oracle_anchors()
    parent = ROOT / 'build/sfir-narrowing'
    parent.mkdir(parents=True, exist_ok=True)
    output = Path(tempfile.mkdtemp(prefix='attempt-', dir=parent))
    inputs = cases()
    (output / 'cases.json').write_text(json.dumps(inputs, indent=2) + '\n')
    wasm, raw, native = build(output)
    for name, artifact in [('raw', raw), ('optimized', wasm)]:
        succeeded(run([os.environ.get('NODE', 'node'), FIXTURES / 'run.mjs', artifact, output / 'cases.json'],
                      output / (name + '.json')))
    check_native(native, inputs, output)
    summary = dict(cases=len(inputs), calls_per_target=2*len(inputs), status='passed',
                   source_sha256=digest(FIXTURES / 'main.sfir'), raw_sha256=digest(raw),
                   optimized_sha256=digest(wasm), native_sha256=digest(native))
    (output / 'results.json').write_text(json.dumps(summary, indent=2) + '\n')
    print(f'PASS {len(inputs)} narrowing cases, direct and first-class calls, on raw/optimized Wasm and native: {output}')


if __name__ == '__main__':
    main()
