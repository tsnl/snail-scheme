#!/bin/sh
# A small model-only build; no renderer or full game artifact is needed.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${1-}" in --help|-h) node "$root/tests/applications/max-dps-test.mjs" --help; exit ;; esac
output="$root/build/max-dps-test"
mkdir -p "$output"
chibi-scheme -I "$root/bootstrap" "$root/tests/applications/build.scm" \
  "$root" "$root/tests/applications/max-dps-probe.sld" "$output/probe.wasm" \
  "$root/apps/siegework/src" "$root/tests/applications"
node "$root/tests/applications/max-dps-test.mjs" "$output/probe.wasm" "$@"
