#!/bin/sh
# Mip-NeRF 360's scenes (Barron et al., 2022) for the train app
# (src/apps/train): downloads the 12.5 GB archive into the dataset cache,
# resuming a partial download, extracts one scene, and links it beside the
# builds, where the page fetches it from build/datasets/SCENE.
#
#   scripts/fetch-mipnerf360 [SCENE]
#
# SCENE is bicycle by default; the archive also holds bonsai, counter,
# garden, kitchen, room and stump. The cache is
# $SNAIL_DATASETS, by default ~/.cache/snail-scheme/datasets.
set -eu
scene=${1:-bicycle}
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cache=${SNAIL_DATASETS:-$HOME/.cache/snail-scheme/datasets}
archive=$cache/360_v2.zip
url=http://storage.googleapis.com/gresearch/refraw360/360_v2.zip

mkdir -p "$cache"
if [ ! -f "$archive.done" ]; then
  curl --fail --location --continue-at - --output "$archive" "$url"
  touch "$archive.done"
fi
if [ ! -d "$cache/360_v2/$scene/sparse" ]; then
  unzip -q -o "$archive" "$scene/*" -d "$cache/360_v2"
fi
mkdir -p "$root/build/datasets"
ln -sfn "$cache/360_v2/$scene" "$root/build/datasets/$scene"
echo "$root/build/datasets/$scene"
