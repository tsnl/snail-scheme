    "poly-union-origin": ('(: f (All (A) (-> (U A String) A))) '
                          '(define (f x) (if (string? x) x x))', "type mismatch"),
    "poly-summary-position": ('(: test (All (A) (-> A A Boolean))) '
                              '(define (test x y) (string? x)) '
                              '(: f (-> (U String Boolean) (U String Boolean) ExactInteger)) '
                              '(define (f x y) (if (test x y) (string-length y) 0))', "type mismatch"),
    "poly-unresolved": ('(: id (All (A) (-> A A))) (define (id x) x) (id (car (list 1)))',
                        "cannot infer type argument; use inst"),
    "poly-unused-variable": ('(: f (All (A) (-> ExactInteger))) (define (f) 1) (f)',
                             "cannot infer type argument; use inst"),
    "poly-contradiction": ('(: choose (All (A) (-> Boolean A A A))) '
                           '(define (choose p x y) (if p x y)) '
                           '(: f (-> String)) (define (f) (choose #t "text" #f))', "type mismatch"),
    "poly-inst-arity": ('(: id (All (A) (-> A A))) (define (id x) x) (inst id String Boolean)',
                        "wrong number of type arguments"),
    "poly-inst-monomorphic": ('(: id (-> String String)) (define (id x) x) (inst id String)',
