# ---- Static instance selection ----

COMBINE = '(define-class (Combine T) (: combine (-> T T T))) '
INT_COMBINE = COMBINE + '(define-instance (Combine i32) (combine (lambda (x y) (+ x y)))) '
TWICE = '(: twice (All (T) (=> ((Combine T)) (-> T T)))) (define (twice x) (combine x x)) '

CASES.update({
    "class-exact-explicit": (COMBINE + '(define-instance (Combine ExactInteger) '
                             '(combine (lambda (x y) (+ x y)))) '
                             '(write ((inst combine ExactInteger) 20 22))', "42", ""),
    "class-any-explicit": ('(define-class (Show T) (: show (-> T String))) '
                           '(define-instance (Show Any) (show (lambda (x) "any"))) '
                           '(write ((inst show Any) (car (list 42))))', '"any"', ""),
    "class-order": (INT_COMBINE + '((begin (display "o") (inst combine i32)) '
                    '(begin (display "a") 20) (begin (display "b") 22))', "abo", ""),
    "class-view-effects": (INT_COMBINE + '(ann (begin (display "e") (inst combine i32)) '
                           '(-> i32 i32 i32)) (write (combine 20 22))', "e42", ""),
    "class-dynamic-check": (INT_COMBINE + '(: f (-> ? i32)) '
                            '(define (f x) ((inst combine i32) x 1)) '
                            '(f (begin (display "a") "bad"))', "a", "incorrect value type"),
    "class-member-uninitialized": (COMBINE + '(define-instance (Combine i32) (combine plus)) '
                                  '(combine (begin (display "a") 20) 22) '
                                  '(define (plus x y) (+ x y))', "a", "read of an uninitialized binding"),
    "class-generic-uninitialized": (COMBINE + '(define-instance (Combine i32) (combine plus)) '
                                   + TWICE + '(twice (begin (display "a") 21)) '
                                   '(define (plus x y) (+ x y))', "a", "read of an uninitialized binding"),
    "class-view-uninitialized": (INT_COMBINE + '(: view (-> i32 i32 i32)) '
                                '(view 20 22) (define view (inst combine i32))', "", "read of an uninitialized binding"),
    "class-auxiliary-arrow": ('(write (cond (42 => (lambda (x) (+ x 1))) (else 0)))', "43", ""),
})

REJECTED.update({
    "class-missing": (COMBINE + '(combine 1 2)', "no typeclass instance"),
    "class-exact-no-fallback": (COMBINE + '(define-instance (Combine ExactInteger) '
                                '(combine (lambda (x y) (+ x y)))) (combine 1 2)', "no typeclass instance"),
    "class-duplicate": (INT_COMBINE + '(define-instance (Combine i32) '
                        '(combine (lambda (x y) (+ x y))))', "duplicate typeclass instance"),
    "class-incomplete": (COMBINE + '(define-instance (Combine i32))', "every class method exactly once"),
    "class-head-variable": (COMBINE + '(define-instance (Combine ?) '
                            '(combine (lambda (x y) x)))', "concrete scalar or nominal types"),
    "class-head-union": (COMBINE + '(define-instance (Combine (U String i32)) '
                         '(combine (lambda (x y) x)))', "concrete scalar or nominal types"),
    "class-method-body": (COMBINE + '(define-instance (Combine i32) '
                          '(combine (lambda (x y) "bad")))', "type mismatch"),
    "class-method-arity": (COMBINE + '(define-instance (Combine i32) '
                           '(combine (lambda (x) x)))', "fixed-arity lambda of matching arity"),
    "class-no-constraint": (INT_COMBINE + '(: twice (All (T) (-> T T))) '
                            '(define (twice x) (combine x x))', "concrete static type or a declared constraint"),
    "class-let-no-constraint": (INT_COMBINE + '(: twice (All (T) (-> T T))) '
                                '(define (twice x) (let ((y x)) (combine y y)))', "concrete static type or a declared constraint"),
    "class-inst-no-constraint": (INT_COMBINE +
                                 '(define-class (Pick T) (: pick (-> T T))) '
                                 '(define-instance (Pick i32) (pick (lambda (x) x))) '
                                 '(: id (All (A) (-> A A))) (define (id x) x) '
                                 '(: hidden (All (T) (=> ((Combine T)) (-> T T)))) '
                                 '(define (hidden x) (inst (begin (pick x) id) i32) x)',
                                 "concrete static type or a declared constraint"),
    "class-unknown-selection": ('(define-class (Show T) (: show (-> T String))) '
                                 '(define-instance (Show Any) (show (lambda (x) "any"))) '
                                 '(: f (-> ? String)) (define (f x) (show x))', "cannot infer type argument"),
    "class-explicit-unknown": (INT_COMBINE + '(inst combine ?)', "concrete static type or a declared constraint"),
    "class-unresolved-value": (INT_COMBINE + '(write combine)', "overloaded callable requires inst"),
    "class-unused-unresolved-value": (INT_COMBINE + TWICE +
                                     '(: hidden (All (T) (=> ((Combine T)) (-> T T)))) '
                                     '(define (hidden x) (write combine) x)', "overloaded callable requires inst"),
    "class-unused-class-value": (INT_COMBINE + TWICE +
                                '(: hidden (All (T) (=> ((Combine T)) (-> T T)))) '
                                '(define (hidden x) (write Combine) x)', "typeclasses have no runtime value"),
    "class-effectful-alias": (INT_COMBINE + '(define alias (begin (display "e") combine))', "immutable identifier reference"),
    "class-effectful-inst": (INT_COMBINE + '(inst (begin (display "e") combine) i32)', "requires an identifier or static view"),
    "class-mutable-member": (COMBINE + '(define (plus x y) (+ x y)) '
                            '(define-instance (Combine i32) (combine plus)) '
                            '(set! plus (lambda (x y) x))', "immutable function bindings"),
    "class-local-generic": (INT_COMBINE + '(define (outer) ' + TWICE + '(twice 1))', "stable module-level lambdas"),
    "class-local-instance": (COMBINE + '(define (outer) (define-instance (Combine i32) '
                             '(combine (lambda (x y) (+ x y)))) 1)', "require module scope"),
    "class-poly-recursion": (INT_COMBINE + '(: loop (All (T) (=> ((Combine T)) (-> T T)))) '
                             '(define (loop x) ((inst loop i32) 1))', "type mismatch"),
    "class-class-value": (INT_COMBINE + '(write Combine)', "typeclasses have no runtime value"),
})


# ---- Build and execute ----


def arithmetic_examples():
    """Exact Python arithmetic supplies an independent bounded-input oracle."""
    edges = [-2147483648, -1073741825, -1073741824, -46341, -1, 0, 1,
             46341, 1073741823, 1073741824, 2147483647]
    generator = random.Random(20261010)
    pairs = [(a, b) for a in edges for b in edges]
    pairs += [(generator.randint(-2147483648, 2147483647),
               generator.randint(-2147483648, 2147483647)) for _ in range(40)]
    program = [IMPORTS, '(define (check expected actual) '
               '(unless (= expected actual) (error "arithmetic disagreement")))']
    for name, expression in (("plus", "(+ a b)"), ("minus", "(- a b)"),
                             ("times", "(* a b)"), ("cancel", "(- (+ a b) b)")):
        program.append(f'(: {name} (-> i32 i32 i32)) (define ({name} a b) {expression})')
    for name, condition in (("eq", "(= a b)"), ("lt", "(< a b)"), ("le", "(<= a b)"),
                            ("gt", "(> a b)"), ("ge", "(>= a b)"), ("wide-lt", "(< (+ a b) b)")):
        program.append(f'(: {name} (-> i32 i32 i32)) (define ({name} a b) (if {condition} 1 0))')
    comparisons = ("eq", "lt", "le", "gt", "ge", "wide-lt")
    program.append('(define (check-comparisons a b answers) ' + ' '.join(
        f'(check (vector-ref answers {index}) ({name} a b))'
        for index, name in enumerate(comparisons)) + ')')
    for a, b in pairs:
        for name, answer in (("plus", a + b), ("minus", a - b),
                             ("times", a * b), ("cancel", a)):
            if -2147483648 <= answer <= 2147483647:
                program.append(f'(check {answer} ({name} {a} {b}))')
        answers = ' '.join(str(int(value)) for value in (a == b, a < b, a <= b, a > b, a >= b, a + b < b))
        program.append(f'(check-comparisons {a} {b} #({answers}))')
    program.append('(display "arithmetic checks passed\\n")')
    return "\n".join(program) + "\n"


def command(arguments):
    return subprocess.run([str(arg) for arg in arguments], cwd=ROOT, text=True,
                          capture_output=True, timeout=180, check=False)


def compile_program(source, output, mode):
    return command([os.environ.get("CHIBI", "chibi-scheme"), "-I", "src",
                    "tests/build-typed-program.scm", ROOT, source, output, mode])


def require(condition, description, result):
    if not condition:
        raise RuntimeError(f"{description}: exit={result.returncode}\n"
                           f"stdout={result.stdout}\nstderr={result.stderr}")


def run_case(name, source, stdout, diagnostic, modes=("guarded", "optimized")):
    observations = []
    for mode in modes:
        output = BUILD / f"{name}-{mode}.wasm"
        built = compile_program(source, output, mode)
        require(built.returncode == 0, f"compile {name}/{mode}", built)
        result = command([os.environ.get("NODE", "node"), "--no-warnings",
                          ROOT / "scripts/run-wasi.mjs", output])
        require(result.stdout == stdout, f"output {name}/{mode}", result)
        require((result.returncode != 0) == bool(diagnostic), f"status {name}/{mode}", result)
        require(diagnostic in result.stderr, f"diagnostic {name}/{mode}", result)
        observations.append((result.returncode, result.stdout))
    assert observations[0] == observations[1], name
    print(f"passed typing: {name}", flush=True)


def check_streaming_folds():
    cases = {
        "checked-alias": ('(: f (-> i32 i32)) (define (f x) x) '
                          '(define alias f) (alias 2147483648)', "", "incorrect value type"),
        "untyped-result-guard": ('(define (f x) (ann x String)) (f 42)',
                                 "", "incorrect value type"),
        "count-through-iife": ('(write (call-with-values '
                               '(lambda () ((lambda () (values 1 2)))) list))', "(1 2)", ""),
        "guard-after-fold": ('(write (ann ((lambda () (+ 20 22))) ExactInteger))', "42", ""),
        "folded-false": ('(write (if ((lambda () #f)) 1 2))', "2", ""),
        "folded-null": ('(write ((lambda () (quote ()))))', "()", ""),
        "forward-alias": ('(define alias f) (define (f x) x) (alias 42)',
                          "", "read of an uninitialized binding"),
        "ignored-effect": ('(write ((lambda (ignored) 42) (begin (display "e") 7)))',
                            "e42", ""),
        "operator-effect": ('(write ((begin (display "o") (lambda (x) 42)) '
                             '(begin (display "a") 7)))', "ao42", ""),
        "ignored-count": ('((lambda (ignored) 42) (values 1 2))',
                           "", "expected a single value"),
        "private-candidate": ('(write (car (cons 42 #f)))', "42", ""),
    }
    # An expected result can introduce a guard inside an unannotated IIFE.
    # Raw interpretation of its syntax must not erase that generated guard.
    initializers = {
        "inherited-guard": '((lambda (v) v) (car (cons VALUE #f)))',
        "higher-order-guard": '((lambda (f) (f (car (cons VALUE #f)))) (lambda (v) v))',
        "factory-guard": '(((lambda () (lambda (v) v))) (car (cons VALUE #f)))',
        "let-guard": '(let ((v (car (cons VALUE #f)))) v)',
        "branch-guard": '(if #f  "unused" ((lambda (v) v) (car (cons VALUE #f))))',
    }
    for name, initializer in initializers.items():
        for suffix, value, stdout, diagnostic in [
            ("bad", "42", "", "incorrect value type"),
            ("good", '"ok"', '"ok"', ""),
        ]:
            program = f'(: x String) (define x {initializer.replace("VALUE", value)}) (write x)'
            cases[f"{name}-{suffix}"] = (program, stdout, diagnostic)
    for name, (program, stdout, diagnostic) in cases.items():
        source = BUILD / f"stream-{name}.scm"
        source.write_text(IMPORTS + program + "\n")
        run_case(f"stream-{name}", source, stdout, diagnostic, ("optimized", "folded"))
    for name, program in {
        "dead-branch": '(if #t 42 (ann "bad" ExactInteger))',
        "unused-body": '(ann (lambda () "bad") (-> ExactInteger)) 42',
    }.items():
        source = BUILD / f"stream-{name}.scm"
        source.write_text(IMPORTS + program + "\n")
        for mode in ("optimized", "folded"):
            result = compile_program(source, BUILD / f"stream-{name}-{mode}.wasm", mode)
            require(result.returncode != 0 and "type mismatch" in result.stderr,
                    f"reject stream-{name}/{mode}", result)
        print(f"rejected before folding: {name}", flush=True)


def main():
    BUILD.mkdir(parents=True, exist_ok=True)
    run_case("success", ROOT / "tests/programs/backend-typing.scm", "typing checks passed\n", "")
    run_case("typed-tail", ROOT / "tests/programs/backend-typed-tail.scm", "typed tail checks passed\n", "")
    run_case("polymorphism", ROOT / "tests/programs/backend-polymorphism.scm", "polymorphism checks passed\n", "")
    run_case("typeclasses", ROOT / "tests/programs/backend-typeclasses.scm", "typeclass checks passed\n", "")
    run_case("typeclass-tensors", ROOT / "tests/programs/backend-typeclass-tensors.scm", "typeclass tensor checks passed\n", "")
    run_case("typeclass-imports", ROOT / "tests/programs/backend-typeclass-imports.scm", "typeclass import checks passed\n", "")
    arithmetic = BUILD / "arithmetic.scm"
    arithmetic.write_text(arithmetic_examples())
    run_case("arithmetic", arithmetic, "arithmetic checks passed\n", "")
    for name, (program, stdout, diagnostic) in CASES.items():
        source = BUILD / f"{name}.scm"
        source.write_text(("" if name in ("rename", "record-standard") else IMPORTS) + program + "\n")
        run_case(name, source, stdout, diagnostic)
    for name, (program, diagnostic) in REJECTED.items():
        source = BUILD / f"{name}.scm"
        source.write_text(IMPORTS + program + "\n")
        result = compile_program(source, BUILD / f"{name}.wasm", "optimized")
        require(result.returncode != 0 and diagnostic in result.stderr, f"reject {name}", result)
        if name in ("poly-constant", "poly-unresolved"):
            require(re.search(re.escape(str(source)) + r":\d+:\d+:", result.stderr),
                    f"located diagnostic {name}", result)
        print(f"rejected as expected: {name}", flush=True)
    check_streaming_folds()


if __name__ == "__main__":
    main()
