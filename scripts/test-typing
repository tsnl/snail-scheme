#!/usr/bin/env python3
"""Check typing diagnostics and compare guarded/optimized linked Wasm behavior."""

import os
import random
import re
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build/typing-tests"
IMPORTS = "(import (scheme base) (scheme write) (scheme process-context) (snail typing))\n"
ABI_IMPORT = "(import (only (snail-scheme extensions) rust-call-with-result))\n"
ABI_CALL = "(rust-call-with-result (lambda () (values 1 2)) "

# ---- Counterexamples and observable behavior ----

# Expected stdout includes effects that must occur before the failing check.
CASES = {
    "poly-renamed": ('(import (prefix (snail typing) t:)) '
                     '(t:: id (t:All (A) (t:-> A A))) (define (id x) x) '
                     '(write ((t:inst id t:String) "renamed"))', '"renamed"', ""),
    "poly-call-order": ('(: first (All (A B) (-> A B A))) (define (first x y) x) '
                        '((begin (display "o") (inst first String String)) '
                        '(begin (display "a") 7) (begin (display "b") "good"))',
                        "abo", "incorrect value type"),
    "poly-inferred-guard": ('(: id (All (A) (-> A A))) (define (id x) (display "g") x) '
                            '(: f (-> ? String)) (define (f x) (display "f") (id x)) '
                            '(f 7)', "f", "incorrect value type"),
    "poly-i32-guard": ('(: id (All (A) (-> A A))) (define (id x) x) '
                       '(: f (-> ? i32)) (define (f x) (id x)) (f 2147483648)',
                       "", "incorrect value type"),
    "poly-concrete-entry": ('(: f (All (A) (-> A String A))) (define (f x y) x) '
                            '(apply f (list 7 8))', "", "incorrect value type"),
    "poly-count-entry": (ABI_IMPORT + '(: id (All (A) (-> A A))) (define (id x) x) ' +
                         ABI_CALL + '(lambda (value pair vector) '
                         '(display "a") ((inst id String) value)))',
                         "a", "expected a single value"),
    "poly-count-result": ('(: f (All (A) (-> A Any))) (define (f x) (values 1 2)) '
                          '(call-with-values (lambda () (apply (inst f String) (list "x"))) list)',
                          "", "expected a single value"),
    "poly-predicate-mutation": ('(: test (All (A B) (-> A B Boolean))) '
                                '(define (test x ignored) (string? x)) '
                                '(define x "old") (if ((inst test Any Any) x (set! x (quote changed))) (string-length x) 0)',
                                "", "incorrect value type"),
    "poly-predicate-effect": ('(define x "old") (: test (All (A) (-> A Boolean))) '
                              '(define (test value) (set! x (quote changed)) (string? value)) '
                              '(if ((inst test Any) x) (string-length x) 0)',
                              "", "incorrect value type"),
    "poly-erased-apply": ('(: id (All (A) (-> A A))) (define (id x) x) '
                          '(write (apply (inst id String) (list 42)))', "42", ""),
    "poly-apply-result": ('(: id (All (A) (-> A A))) (define (id x) x) '
                          '(: f (-> String)) (define (f) (apply (inst id String) (list 42))) '
                          '(f)', "", "incorrect value type"),
    "poly-instance-arity": ('(: id (All (A) (-> A A))) (define (id x) x) '
                            '((inst id String) "one" "two")', "", "wrong number of arguments"),
    "tail-host-isolation": (ABI_IMPORT +
                            '(: f (-> ExactInteger)) (define (f) ' + ABI_CALL +
                            '(lambda (value pair vector) 42))) (write (f))', "42", ""),
    "tail-count-any": ('(: f (-> ExactInteger Procedure Any)) '
                       '(define (f n next) (next n)) '
                       '(define (step n) (if (= n 0) (begin (display "done") (values 1 2)) '
                       '(f (- n 1) step))) (f 100000 step)', "done", "expected a single value"),
    "tail-range": ('(: f (-> ExactInteger Procedure i32)) (define (f n next) (next n)) '
                   '(define (step n) (if (= n 0) (begin (display "done") 2147483648) '
                   '(f (- n 1) step))) (f 100000 step)', "done", "incorrect value type"),
    "tail-check-order": ('(define-record-type <existing> (existing) existing?) '
                         '(: a (-> ExactInteger Procedure ExactInteger)) (define (a n next) (next n)) '
                         '(: b (-> ExactInteger Procedure <later>)) (define (b n next) (next n)) '
                         '(define (route-one n) (b n route-two)) '
                         '(define (route-two n) (a n finish)) '
                         '(define (finish n) (display "done") (existing)) '
                         '(a 0 route-one) (define-record-type <later> (later) later?)',
                         "done", "incorrect value type"),
    "tail-delayed-check": ('(define-record-type <existing> (existing) existing?) '
                           '(: f (-> Procedure <later>)) (define (f next) (next)) '
                           '(f (lambda () (display "done") (existing))) '
                           '(define-record-type <later> (later) later?)',
                           "done", "read of an uninitialized binding"),
    "tail-local-check-order": ('(define-record-type <existing> (existing) existing?) '
                               '(define container (cons (existing) #f)) '
