                        '(+ 9223372036854775807 1)))))', "done", "integer overflow"),
    "abi-argument-count": (ABI_IMPORT + ABI_CALL +
                           '(lambda (value pair vector) (display "a") (+ value 1)))',
                           "a", "expected a single value"),
    "abi-car-count": (ABI_IMPORT + ABI_CALL +
                      '(lambda (value pair vector) (display "a") (+ (car pair) 1)))',
                      "a", "expected a single value"),
    "abi-cdr-count": (ABI_IMPORT + ABI_CALL +
                      '(lambda (value pair vector) (display "a") (+ (cdr pair) 1)))',
                      "a", "expected a single value"),
    "abi-vector-count": (ABI_IMPORT + ABI_CALL +
                         '(lambda (value pair vector) (display "a") (+ (vector-ref vector 0) 1)))',
                         "a", "expected a single value"),
    "abi-order": (ABI_IMPORT + ABI_CALL +
                  '(lambda (value pair vector) (display "a") '
                  '((begin (display "o") +) value (begin (display "b") 1))))',
                  "a", "expected a single value"),
    "abi-heap-order": (ABI_IMPORT + ABI_CALL +
                       '(lambda (value pair vector) (display "a") '
                       '((begin (display "o") +) (car pair) (begin (display "b") 1))))',
                       "a", "expected a single value"),
    "abi-alias-count": (ABI_IMPORT + ABI_CALL +
                        '(lambda (value pair vector) (display "a") '
                        '(let ((saved value)) (display "b") saved)))',
                        "a", "expected a single value"),
    "abi-unused-count": (ABI_IMPORT + '(write ' + ABI_CALL +
                         '(lambda (value pair vector) 42)))', "42", ""),
    "abi-return-count": (ABI_IMPORT + '(write (call-with-values (lambda () ' + ABI_CALL +
                         '(lambda (value pair vector) value))) list))', "(1 2)", ""),
    "abi-assigned-count": (ABI_IMPORT + '(write ' + ABI_CALL +
                           '(lambda (value pair vector) (set! value 3) (+ value 1))))', "4", ""),
    "abi-typed-count": (ABI_IMPORT + ABI_CALL +
                        '(ann (lambda (value pair vector) 42) (-> Any Any Any ExactInteger)))',
                        "", "expected a single value"),
    "entry": ('(: f (-> ExactInteger ExactInteger)) (define (f x) (+ x 1)) '
              '(apply f (list "bad"))', "", "incorrect value type"),
    "order": ('(: f (-> ExactInteger ExactInteger ExactInteger)) (define (f x y) (+ x y)) '
              '(f (begin (display "a") "bad") (begin (display "b") 1))', "ab", "incorrect value type"),
    "values": ('(: f (-> ExactInteger)) (define (f) (values 1 2)) (f)', "", "expected a single value"),
    "uninitialized": ('(: x ExactInteger) (define x x) x', "", "read of an uninitialized binding"),
    "mutation": ('(define x 1) (define (change!) (set! x "bad")) '
                 '(if (exact-integer? x) (begin (change!) (+ x 1)) 0)', "", "expected a number"),
    "mutable-predicate": ('(define test exact-integer?) (set! test (lambda (x) #t)) '
                          '(define x "bad") (if (test x) (+ x 1) 0)', "", "expected a number"),
    "field-mutation": ('(define x (cons 1 2)) (if (exact-integer? (car x)) '
                       '(begin (set-car! x "bad") (+ (car x) 1)) 0)', "", "expected a number"),
    "result": ('(: f (-> ? ExactInteger)) (define (f thunk) (thunk)) '
               '(f (lambda () "bad"))', "", "incorrect value type"),
    "overflow": ('(: f (-> ExactInteger ExactInteger)) (define (f x) (+ x 1)) '
                 '(f 9223372036854775807)', "", "integer overflow"),
    "shadow": ('(let ((exact-integer? (lambda (x) #t))) '
               '(if (exact-integer? "bad") (+ "bad" 1) 0))', "", "expected a number"),
    "one-sided": ('(define (positive-integer? x) (and (exact-integer? x) (> x 0))) '
                  '(if (positive-integer? -1) 0 (write -1))', "-1", ""),
    "record-bypass": ('(import (only (snail-scheme core) %record-set!)) '
                      '(define-record-type <box> (box x) box? (x : ExactInteger unbox)) '
                      '(define b (box 1)) (%record-set! <box> (quote x) b "bad") (unbox b)',
                      "", "incorrect value type"),
    "i32-entry": ('(: f (-> i32 i32)) (define (f n) n) (f 2147483648)', "", "incorrect value type"),
    "i32-entry-low": ('(: f (-> i32 i32)) (define (f n) n) (f -2147483649)', "", "incorrect value type"),
    "i32-result": ('(: f (-> i32 i32)) (define (f n) (+ n 1)) (f 2147483647)',
                   "", "incorrect value type"),
    "i32-result-low": ('(: f (-> i32 i32)) (define (f n) (- n 1)) (f -2147483648)',
                       "", "incorrect value type"),
    "i32-tail-fibonacci-overflow": ('(: f (-> i32 i32 i32 i32)) '
                                    '(define (f n a b) (if (<= n 0) a '
                                    '(if (= n 1) b (f (- n 1) b (+ a b))))) (f 47 0 1)',
                                    "", "incorrect value type"),
    "i32-wide": ('(: f (-> i32 i32 i32)) (define (f a b) (- (+ a b) b)) '
                 '(write (f 2147483647 2147483647))', "2147483647", ""),
    "i32-dead-branch": ('(: f (-> i32 i32)) (define (f x) '
                        '(if (< x -2147483648) (* (* x x) x) x)) '
                        '(write (f -2147483648))', "-2147483648", ""),
    "i32-multiply-overflow": ('(: f (-> i32 i32)) (define (f x) (* x x)) '
                              '(f 46341)', "", "incorrect value type"),
    "i32-fallback-overflow": ('(: f (-> i32 i32)) (define (f x) (* (* x x) x)) '
                              '(f 2147483647)', "", "integer overflow"),
    "any-assertion": ('(: f (-> Any ExactInteger)) (define (f x) '
                      '(+ (ann x ExactInteger) 1)) (write (f 2))', "3", ""),
    "any-assertion-fail": ('(: f (-> Any ExactInteger)) (define (f x) '
                           '(+ (ann x ExactInteger) 1)) (f "bad")', "", "incorrect value type"),
    "nested-write": ('(: f (-> ExactInteger ? ExactInteger)) (define (f x g) '
                     '(define (change!) (set! x (g))) (change!) x) '
                     '(f 1 (lambda () "bad"))', "", "incorrect value type"),
    "predicate-effects": ('(define (is-int? x) (display "p") (exact-integer? x)) '
                          '(: f (-> (U String ExactInteger) ExactInteger)) '
                          '(define (f x) (if (is-int? x) (+ x 1) (string-length x))) '
                          '(write (f 1))', "p2", ""),
    "initializer-count": ('(: f (-> ExactInteger)) (define (f) '
                           '(define x (values 1 2)) x) (f)', "", "expected a single value"),
    "record-standard": ('(import (scheme base) (scheme write)) '
                        '(define-record-type <r> (r x) r? (x : set-x!) (y get-y)) '
                        '(define value (r 7)) (set-x! value 9) (write (: value))', "9", ""),
    "record-generative": ('(define (factory) (define-record-type <r> (r) r?) '
                          '(cons (r) r?)) (define a (factory)) (define b (factory)) '
                          '(write ((cdr a) (car b)))', "#f", ""),
    "record-nominal": ('(define-record-type <a> (a x) a? (x : ExactInteger ax)) '
                       '(define-record-type <b> (b x) b? (x : ExactInteger bx)) '
                       '(ax (b 1))', "", "incorrect value type"),
    "record-hygiene": ('(define-syntax make-type (syntax-rules () '
                       '((_ ctor pred getter) (define-record-type <hidden> '
                       '(ctor field) pred (field : ExactInteger getter))))) '
                       '(make-type a a? ax) (make-type b b? bx) (ax (b 1))',
                       "", "incorrect value type"),
    "snapshot": ('(define x 1) (let ((saved x)) (set! x "bad") '
                 '(if (exact-integer? saved) (write (+ saved 1)) 0))', "2", ""),
    "rename": ('(import (rename (snail typing) (: signature) (-> arrow) '
               '(ExactInteger Int)) (scheme base) (scheme write)) '
               '(signature add (arrow Int Int)) (define (add x) (+ x 1)) (write (add 9))', "10", ""),
}

REJECTED = {
    "inexact-complex-domain": ('(: f (-> Number InexactReal)) '
                               '(define (f x) (if (inexact? x) (ann x InexactReal) 0.0))',
                               "type mismatch"),
    "result-mismatch": ('(: f (-> ExactInteger String)) (define (f x) x)', "type mismatch"),
    "argument-mismatch": ('(: f (-> String ExactInteger)) (define (f x) (+ x 1))', "type mismatch"),
    "nominal-any": ('(: f (-> Any ExactInteger)) (define (f x) (+ x 1))', "type mismatch"),
    "false-summary": ('(define (positive-int? x) (and (exact-integer? x) (> x 0))) '
                      '(: f (-> (U String ExactInteger) ExactInteger)) '
                      '(define (f x) (if (positive-int? x) x (+ x 1)))', "type mismatch"),
    "integer-float": ('(: f (-> Number ExactInteger)) '
                      '(define (f x) (if (integer? x) x 0))', "type mismatch"),
    "opaque": ('(ann (car (list (lambda (x) x))) (-> Any Any))',
               "opaque function annotation"),
