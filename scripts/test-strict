#!/usr/bin/env python3
"""Check strict source contracts by compiling and executing native Wasm exports."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / "tests/strict"


# ---- Captured commands ----


def invoke(command, root, log):
    started = time.monotonic()
    try:
        process = subprocess.run(list(map(str, command)), cwd=root, text=True,
                                 capture_output=True, timeout=120)
        result = dict(command=list(map(str, command)), status=process.returncode,
                      stdout=process.stdout, stderr=process.stderr)
    except subprocess.TimeoutExpired:
        result = dict(command=list(map(str, command)), status="timeout", stdout="", stderr="timeout")
    result["seconds"] = time.monotonic() - started
    log.write_text(json.dumps(result, indent=2) + "\n")
    return result


def check_case(case, compiler, output):
    source = FIXTURES / (case["name"] + ".scm")
    artifact = output / (case["name"] + ".wasm")
    raw_artifact = Path(str(artifact) + ".raw.wasm")
    artifact.unlink(missing_ok=True)
    raw_artifact.unlink(missing_ok=True)
    command = [compiler / "scripts/build-strict", source, artifact]
    built = invoke(command, compiler, output / (case["name"] + "-compile.json"))
    result = dict(name=case["name"], source_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),
                  compile=built, passed=False)
    if "error" in case:
        diagnostic = built["stdout"] + built["stderr"]
        located = re.search(re.escape(source.name) + r":\d+:\d+:", diagnostic)
        result["passed"] = (isinstance(built["status"], int) and built["status"] != 0
                            and bool(re.search(case["error"], diagnostic, re.I)) and bool(located))
        return result
    if built["status"] != 0 or not artifact.is_file() or not raw_artifact.is_file():
        return result
    run = invoke([os.environ.get("NODE", "node"), FIXTURES / "run.mjs", artifact, case["result"]],
                 compiler, output / (case["name"] + "-run.json"))
    result.update(run=run, module_sha256=hashlib.sha256(artifact.read_bytes()).hexdigest())
    raw_run = invoke([os.environ.get("NODE", "node"), FIXTURES / "run.mjs", raw_artifact,
                      case["result"]], compiler, output / (case["name"] + "-raw-run.json"))
    result.update(raw_run=raw_run, raw_module_sha256=hashlib.sha256(raw_artifact.read_bytes()).hexdigest())
    result["passed"] = run["status"] == 0 and raw_run["status"] == 0
    return result


# ---- Independent contract fixtures ----


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--compiler", type=Path, default=ROOT)
    parser.add_argument("--output", type=Path, default=ROOT / "build/strict-contracts")
    parser.add_argument("cases", nargs="*")
    options = parser.parse_args()
    options.output.mkdir(parents=True, exist_ok=True)
    cases = json.loads((FIXTURES / "cases.json").read_text())
    if options.cases:
        known = {case["name"] for case in cases}
        if unknown := set(options.cases) - known:
            parser.error(f"unknown cases: {', '.join(sorted(unknown))}")
        cases = [case for case in cases if case["name"] in options.cases]
    results = []
    for case in cases:
        result = check_case(case, options.compiler.resolve(), options.output.resolve())
        results.append(result)
        (options.output / "results.json").write_text(json.dumps(results, indent=2) + "\n")
        print(("PASS" if result["passed"] else "FAIL") + " " + case["name"], flush=True)
    passed = sum(result["passed"] for result in results)
    print(f"Passed {passed}/{len(results)} strict compiler contracts")
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
