#!/usr/bin/env python3
"""Execute and retain matched Rust/llvmlite fixnum kernels on native and WASI."""

import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build/static-codegen"

# ---- Compilation and linking ----


def run(command, **kwargs):
    return subprocess.run(command, cwd=ROOT, check=True, **kwargs)


def scheme_ir():
    command = [os.environ.get("CHIBI", "chibi-scheme"), "-I", "src", "tests/emit-codegen-fixnum.scm"]
    return run(command, capture_output=True, text=True).stdout


def target_ir(directory, triple, module):
    rust = directory / "rust.ll"
    run(["rustc", "--edition=2024", "--target", triple, "-O", "-Cpanic=abort",
         "--emit=llvm-ir", "tests/codegen-fixnum.rs", "-o", str(rust)])
    metadata = "\n".join(line for line in rust.read_text().splitlines() if line.startswith("target "))
    # The .o suffix makes clang pass bitcode to LLD instead of compiling it first.
    source, bitcode = directory / "operations.ll", directory / "operations.o"
    source.write_text(metadata + "\n" + module)
    run(["opt", "-passes=default<O3>,verify", str(source), "-o", str(bitcode)])
    return bitcode


def linker_flags(wasm):
    if wasm:
        return ["-Clinker=wasm-ld", "-Clink-arg=--save-temps", "-Clink-arg=--lto-O3"]
    return ["-Clinker=rust-lld", "-Clink-arg=--save-temps", "-Clink-arg=--lto-O3"]


def compile_probe(directory, triple, bitcode, wasm):
    binary = directory / ("probe.wasm" if wasm else "probe")
    run(["rustc", "--edition=2024", "--target", triple, "-O", "-Cpanic=abort",
         "-Cembed-bitcode=yes", "-Clinker-plugin-lto", "-Clto=fat", *linker_flags(wasm),
         "tests/codegen-fixnum.rs", "-Clink-arg=" + str(bitcode), "-o", str(binary)])
    linked = Path(str(binary) + ".0.4.opt.bc")
    run(["llvm-dis", str(linked), "-o", str(directory / "linked.ll")])
    verify_inlining(directory / "linked.ll")
    run(["llc", str(linked), "-o", str(directory / "linked.s")])
    return binary


# ---- Execution ----


def verify_inlining(path):
    text = path.read_text()
    for name in ("probe_via_rust", "probe_via_llvm"):
        definitions = [line for line in text.splitlines()
                       if line.startswith("define ") and "@" + name + "(" in line]
        if len(definitions) != 1:
            raise RuntimeError(f"expected one retained {name} definition in {path}")
        start = text.index(definitions[0])
        body = text[start:text.index("\n}", start)]
        if " call " in body or " invoke " in body:
            raise RuntimeError(f"a call remains inside {name}; inspect {path}")


def check_target(triple, module):
    directory = BUILD / triple
    directory.mkdir(parents=True, exist_ok=True)
    wasm = triple.startswith("wasm")
    binary = compile_probe(directory, triple, target_ir(directory, triple, module), wasm)
    command = ([os.environ.get("NODE", "node"), "--no-warnings", "scripts/run-wasi.mjs", str(binary)]
               if wasm else [str(binary)])
    output = run(command, capture_output=True, text=True).stdout
    if output != "checked 65585 input pairs\n":
        raise RuntimeError(f"unexpected {triple} output: {output!r}")
    print(f"{triple}: {output.strip()}; inspect {directory / 'linked.ll'}")


def main():
    module = scheme_ir()
    for triple in ("i686-unknown-linux-musl", "wasm32-wasip1"):
        check_target(triple, module)


if __name__ == "__main__":
    main()
