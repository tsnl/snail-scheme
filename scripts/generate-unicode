#!/usr/bin/env python3
"""Generate native casing exceptions from Unicode 16 UnicodeData/CaseFolding."""

import argparse
import subprocess
import tempfile
from pathlib import Path


# ---- Native casing baseline ----

RUST_BASELINE = r'''
fn main() {
    println!("{}.{}.{}", char::UNICODE_VERSION.0, char::UNICODE_VERSION.1, char::UNICODE_VERSION.2);
    for character in (0..=0x10ffff).filter_map(char::from_u32) {
        let upper: String = character.to_uppercase().collect();
        let lower: String = character.to_lowercase().collect();
        if upper != character.to_string() || lower != character.to_string() {
            let codes = |text: &str| text.chars().map(|c| format!("{:x}", c as u32))
                .collect::<Vec<_>>().join(",");
            println!("{:x};{};{}", character as u32, codes(&upper), codes(&lower));
        }
    }
}
'''


def native_casing():
    with tempfile.TemporaryDirectory(prefix="snail-unicode-") as directory:
        source, executable = Path(directory) / "casing.rs", Path(directory) / "casing"
        source.write_text(RUST_BASELINE)
        subprocess.run(["rustc", "-O", source, "-o", executable], check=True)
        output = subprocess.check_output([executable], text=True)
    version, *rows = output.splitlines()
    return tuple(map(int, version.split('.'))), {int(code, 16): (tuple(int(c, 16) for c in upper.split(",")),
                           tuple(int(c, 16) for c in lower.split(",")))
            for code, upper, lower in (line.split(";") for line in rows)}


# ---- Unicode mappings ----

def mappings(data, folding):
    upper, lower, digits, simple, full = {}, {}, [], {}, {}
    if not folding.read_text().startswith("# CaseFolding-16.0.0.txt"):
        raise ValueError("expected Unicode 16.0 CaseFolding.txt")
    for line in data.read_text().splitlines():
        fields = line.split(";")
        code = int(fields[0], 16)
        upper[code] = int(fields[12], 16) if fields[12] else code
        lower[code] = int(fields[13], 16) if fields[13] else code
        if fields[6] == "0":
            digits.append(code)
    for line in folding.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        code, status, target, _ = line.split(";", 3)
        code, target = int(code, 16), tuple(int(c, 16) for c in target.split())
        if status.strip() in ("C", "S"):
            simple[code] = target[0]
        if status.strip() in ("C", "F"):
            full[code] = target
    return upper, lower, simple, full, digits


def scalar(codes, original):
    return codes[0] if len(codes) == 1 else original


def escaped(code):
    return rf"\u{{{code:x}}}"


# ---- Rust lookup tables ----

def generate(data, folding):
    upper, lower, simple, full, digits = mappings(data, folding)
    version, native = native_casing()
    for target in [*full.values(), *(pair[1] for pair in native.values())]:
        if not 1 <= len(target) <= 3 or any(not 0 <= code <= 0x10ffff or 0xd800 <= code <= 0xdfff for code in target):
            raise ValueError("full folding requires one through three valid output scalars")
    codes = sorted(set(native) | set(upper) | set(simple) | set(full))
    lines = ["//! Unicode 16.0 casing exceptions and decimal digits.",
             "//! Generated by scripts/generate-unicode against Rust's native casing.",
             "//! Unicode data © 2024 Unicode, Inc.; https://www.unicode.org/license.txt", "",
             "// Regenerate the exceptions when Rust changes its Unicode baseline.",
             "const _: () = assert!(" + " && ".join(
                 f"char::UNICODE_VERSION.{index} == {part}" for index, part in enumerate(version)) + ");", ""]
    for name, expected, direction in (("uppercase", upper, 0), ("lowercase", lower, 1),
                                      ("fold_character", simple, 1)):
        lines += [f"// ---- {name.replace('_', ' ').capitalize()} ----", "",
                  f"pub(crate) fn {name}(character: char) -> char {{", "    match character {"]
        for code in codes:
            actual = scalar(native.get(code, ((code,), (code,)))[direction], code)
            target = expected.get(code, code)
            if target != actual:
                lines.append(f"        '{escaped(code)}' => '{escaped(target)}',")
        operation = "to_uppercase" if direction == 0 else "to_lowercase"
        lines += [f"        _ => {{ let mut mapped = character.{operation}();",
                  "            let first = mapped.next().unwrap();",
                  "            if mapped.next().is_none() { first } else { character } }", "    }", "}", ""]
    lines += ["// ---- Full case folding ----", "",
              "// The pinned full mappings and native fallback contain one through three",
              "// scalars. The generator checks this bound; NUL remains an ordinary scalar.",
              "pub(crate) struct Folded {", "    pub(crate) scalars: [char; 3],",
              "    pub(crate) len: usize,", "}", "",
              "fn collect_folded(mapped: impl Iterator<Item = char>) -> Folded {",
              "    let mut result = Folded { scalars: ['\\0'; 3], len: 0 };",
              "    for scalar in mapped {", "        result.scalars[result.len] = scalar;",
              "        result.len += 1;", "    }", "    assert!(result.len > 0);", "    result", "}", "",
              "pub(crate) fn full_fold(character: char) -> Folded {", "    let exception = match character {"]
    for code in codes:
        target = full.get(code, (code,))
        if target != native.get(code, ((code,), (code,)))[1]:
            text = "".join(escaped(c) for c in target)
            lines.append(f"        '{escaped(code)}' => \"{text}\",")
    lines += ["        _ => return collect_folded(character.to_lowercase()),", "    };",
              "    collect_folded(exception.chars())", "}", "",
              "// ---- Decimal digits ----", "",
              "pub(crate) fn digit_value(character: char) -> Option<u8> {", "    const STARTS: &[u32] = &["]
    for start in range(0, len(digits), 8):
        lines.append("        " + ", ".join(f"0x{c:x}" for c in digits[start:start + 8]) + ",")
    lines += ["    ];", "    let point = character as u32;",
              "    let index = STARTS.partition_point(|start| *start <= point);",
              "    if index == 0 { return None; }", "    let digit = point - STARTS[index - 1];",
              "    (digit < 10).then_some(digit as u8)", "}"]
    return "\n".join(lines) + "\n"


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("unicode_data", type=Path)
    parser.add_argument("case_folding", type=Path)
    parser.add_argument("output", type=Path)
    args = parser.parse_args()
    existing = args.output.read_text() if args.output.exists() else ""
    marker, tests = "// ---- Tests ----", existing.partition("// ---- Tests ----")[2]
    args.output.write_text(generate(args.unicode_data, args.case_folding)
                           + ("\n" + marker + tests if tests else ""))
