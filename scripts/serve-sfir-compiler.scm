;; One explicitly owned compiler session. Requests supply source or owned syntax;
;; compilation sees only the resulting map and never discovers dependencies.
(import (scheme base) (scheme file) (scheme read) (scheme write) (scheme process-context)
        (chibi json) (snail-sfir frontend) (snail-sfir compiler)
        (snail-sfir library-transfer) (snail-scheme reader) (snail-scheme syntax-parser)
        (snail-scheme source) (snail-scheme strict-primitives) (snail-scheme chromium-trace))

;; ---- Session-owned parsed values and immutable maps ----

(define directory (cadr (command-line)))
(define maps '())
(define transfers '())
(define receiving-context (make-library-transfer-context))
(define primitive (make-primitive-library primitive-names))

(define (publish-map libraries)
  (let ((id (+ 1 (length maps))))
    (set! maps (cons (cons id libraries) maps)) id))
(define (get-map id)
  (let ((entry (assv id maps)))
    (unless entry (error "unknown compiler library map" id)) (cdr entry)))
(define (library-key value)
  (unless (and (vector? value) (> (vector-length value) 0))
    (error "library key requires at least one name"))
  (map (lambda (name)
         (unless (and (string? name) (> (string-length name) 0))
           (error "library key requires nonempty names"))
         (string->symbol name)) (vector->list value)))
(define (insert-library libraries key value)
  (cons (cons key value)
        (let remove ((items libraries))
          (cond ((null? items) '()) ((equal? key (caar items)) (remove (cdr items)))
                (else (cons (car items) (remove (cdr items))))))))
(define (insert-map id key value)
  (publish-map (insert-library (get-map id) (library-key key) value)))

;; ---- Source parsing and copied generator data ----

(define (source-library source text)
  (let ((forms (reader->syntax-list (string->reader source text))))
    (unless (= (length forms) 1) (error "source parsing requires one define-library" source))
    (parse-library (car forms))))
(define (parse-source-packet source text)
  (let ((output (open-output-string)))
    (write-library-transfer (source-library source text) output)
    (get-output-string output)))
(define (built-library identity packet)
  (let ((known (assoc identity transfers)))
    (if known (cdr known)
        (let* ((transfer (read-library-transfer (open-input-string packet)))
               (library (receive-library-transfer receiving-context transfer)))
          (set! transfers (cons (cons identity library) transfers)) library))))
(define (alias-library id from to)
  (let* ((libraries (get-map id)) (key (library-key from)) (entry (assoc key libraries)))
    (unless entry (error "alias source library is absent" key))
    (insert-map id to (cdr entry))))
(define (compile-map id key export)
  (let ((artifact (compile (get-map id) (make-entry (library-key key) (string->symbol export)) wasm-target)))
    (call-with-port (open-binary-output-file (string-append directory "/artifact.wasm"))
      (lambda (port) (write-bytevector (artifact-bytes artifact) port)))
    #t))

;; ---- Closed commands and recoverable diagnostics ----

(define (dispatch request)
  (let ((arguments (cdr (vector->list request))))
    (case (string->symbol (vector-ref request 0))
      ((parse) (apply parse-source-packet arguments))
      ((empty) (publish-map '()))
      ((primitives) (insert-map (car arguments) '#("sfir" "primitive") primitive))
      ((source) (insert-map (car arguments) (cadr arguments)
                            (source-library (list-ref arguments 2) (list-ref arguments 3))))
      ((built) (insert-map (car arguments) (cadr arguments)
                           (built-library (list-ref arguments 2) (list-ref arguments 3))))
      ((alias) (apply alias-library arguments))
      ((compile) (apply compile-map arguments))
      (else (error "unknown compiler service command")))))
(define (write-location location output)
  (display (loc-filename location) output) (display ":" output)
  (display (loc-line location) output) (display ":" output)
  (display (loc-column location) output) (display ": " output))
(define (failure-text failure)
  (let ((output (open-output-string)))
    (if (error-object? failure)
        (let ((details (error-object-irritants failure)))
          (when (and (pair? details) (loc? (car details))) (write-location (car details) output))
          (display (error-object-message failure) output)
          (for-each (lambda (value)
                      (unless (loc? value) (display " " output) (write value output))) details))
        (write failure output))
    (get-output-string output)))
(define (answer request)
  (guard (failure (else (vector #f (failure-text failure))))
    (vector #t (dispatch request))))
(define (write-response response output)
  (display (json->string response) output) (newline output) (flush-output-port output))
(define (serve input output)
  (write-response '#(#t "ready") output)
  (let loop ()
    (let ((line (read-line input)))
      (unless (eof-object? line)
        (let ((request (json-read (open-input-string line))))
          (if (equal? request '#("close")) (write-response '#(#t "closed") output)
              (begin (write-response (answer request) output) (loop))))))))

;; FIFO paths and diagnostic output belong to the caller's temporary session.
;; A failed request retains earlier immutable values and publishes no new map.
(call-with-input-file (string-append directory "/requests")
  (lambda (input)
    (call-with-output-file (string-append directory "/responses")
      (lambda (output)
        (with-chromium-trace-to (string-append directory "/compiler.trace.json")
                                (lambda () (serve input output)))))))
