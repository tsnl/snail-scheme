#!/usr/bin/env python3
"""Execute source recipes and their generated applications with separate dependency maps."""

import json
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / 'tests/sfir-generation'
OUTPUT = ROOT / 'build/sfir-generation'
RECORDS = []
ENVIRONMENT = {**os.environ, 'BINARYEN_CORES': '1', 'SFIR_GENERATION_TEST_OUTPUT': str(OUTPUT)}


# ---- Retained subprocess evidence ----


def run(command, status=0, errors=()):
    result = subprocess.run(list(map(str, command)), cwd=ROOT, capture_output=True, text=True,
                            timeout=240, env=ENVIRONMENT)
    RECORDS.append(dict(command=list(map(str, command)), status=result.returncode,
                        stdout=result.stdout, stderr=result.stderr))
    (OUTPUT / 'commands.json').write_text(json.dumps(RECORDS, indent=2) + '\n')
    assert result.returncode == status if isinstance(status, int) else result.returncode != 0, RECORDS[-1]
    assert all(error in result.stderr for error in errors), RECORDS[-1]
    if status == 0 and result.stdout:
        print(result.stdout, end='', flush=True)


def source(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text + '\n')
    return path


def build(path, name, *options, errors=()):
    run([ROOT / 'scripts/build-sfir', '-I', FIXTURES / 'lib', *options, path, OUTPUT / (name + '.wasm')],
        status='failure' if errors else 0, errors=errors)


def recipe(name, body, imports='(producer make)'):
    return source(OUTPUT / 'bad' / (name + '.sfir'), f'(generate-library (bad {name}) (import {imports}) {body})')


# ---- Compiled generation and application execution ----


def nested_generation():
    (OUTPUT / 'providers.jsonl').write_text('')
    for name in ('provider', 'consumer'):
        run([os.environ.get('WASM_AS', 'wasm-as'), '--enable-mutable-globals',
             FIXTURES / (name + '.wat'), '-o', OUTPUT / (name + '.wasm')])
    run([os.environ.get('CHIBI', 'chibi-scheme'), '-I', ROOT / 'src', FIXTURES / 'build.scm', ROOT, OUTPUT])
    run([os.environ.get('NODE', 'node'), FIXTURES / 'run.mjs', OUTPUT])


def command_targets():
    path = ROOT / 'examples/generation/main.sfir'
    for target in ('wasm', 'native'):
        run([ROOT / 'snail-sfir', 'run', '--target', target, '-I', ROOT / 'examples/generation', path], status=42)
    path = source(OUTPUT / 'source-context.sfir', '(import (generated offset))\n(value)')
    for target in ('wasm', 'native'):
        run([ROOT / 'snail-sfir', 'run', '--target', target, '--generation-provider', FIXTURES / 'providers.mjs',
             '-I', FIXTURES / 'lib', path], status=7)
    print('PASS generated libraries through public Wasm and native commands', flush=True)


# ---- Located grammar, preparation and checking failures ----


def recipe_failures():
    cases = [('wrong-result', '(ann 0 I64)', '', ('cannot unify', 'I64')),
             ('wrong-token', '(library-token (constant-library 42))', '(producer make) (sfir compiler-builder)', ('cannot unify', 'I64')),
             ('wrong-closure', '(lambda () 42)', '', ('cannot unify',)),
             ('missing-producer', '42', '(missing producer)', ('SFIR library not found', '(missing producer)')),
             ('missing-output', '(importing-library "missing" "generated")', '(producer make)',
              ('SFIR library not found', '(bad missing-output)', '(missing generated)', 'generated-import.sfir')),
             ('ill-typed', '(ill-typed-library)', '(producer make)', ('generated-invalid.sfir:19:4',)),
             ('ordinary-body', '(def local 42)', '', ('declaration is not an expression',))]
    for name, body, imports, errors in cases:
        path = recipe(name, body, imports)
        build(path, name, errors=errors + (() if name == 'ill-typed' else (name,)))
    path = source(OUTPUT / 'bad' / 'grammar.sfir', '(generate-library (bad grammar) (import) 1 2)')
    build(path, 'grammar', errors=('one import clause and one expression', str(path)))


def preparation_cycles():
    directory = OUTPUT / 'cycles'
    source(directory / 'cycle/a.sfir', '(define-library (cycle a) (import (cycle b)))')
    source(directory / 'cycle/b.sfir', '(generate-library (cycle b) (import (cycle a)) 0)')
    path = source(OUTPUT / 'cycle.sfir', '(import (cycle a))\n42')
    build(path, 'mixed-cycle', '-I', directory,
          errors=('cyclic library preparation', '(cycle a) (cycle b) (cycle a)', 'cycle/a.sfir', 'cycle/b.sfir'))
    source(directory / 'cycle/a.sfir', '(generate-library (cycle a) (import (cycle b)) 0)')
    build(path, 'producer-cycle', '-I', directory,
          errors=('cyclic library preparation', '(cycle a) (cycle b) (cycle a)'))
    path = recipe('self', '(importing-library "bad" "self")')
    build(path, 'generated-cycle', errors=('cyclic library preparation', '(bad self) (bad self)', str(path)))


def source_selection():
    first, second = OUTPUT / 'first', OUTPUT / 'second'
    path = source(OUTPUT / 'selection.sfir', '(import (chosen value))\n42')
    selected = source(first / 'chosen/value.sfir', '(define-library (wrong name))')
    source(second / 'chosen/value.sfir', '(define-library (chosen value))')
    build(path, 'selected-name', '-I', first, '-I', second, errors=('library name does not match import', str(selected)))
    source(selected, '(define-library (chosen value) (unsupported-clause))')
    build(path, 'selected-malformed', '-I', first, '-I', second,
          errors=('expected an import, export or library body clause', str(selected)))
    source(selected, '(generate-library (wrong recipe) (import) 42)')
    build(path, 'selected-recipe-name', '-I', first, '-I', second,
          errors=('library name does not match import', str(selected)))
    source(first / 'sfir/command.sfir', '(define-library (sfir command) (export answer) (begin (def answer (lambda () 42))))')
    path = source(OUTPUT / 'anonymous-key.sfir', '(import (sfir command))\n(answer)')
    run([ROOT / 'snail-sfir', 'run', '-I', first, path], status=42)


# ---- Explicit provider cleanup on execution and transfer failures ----


def provider_failures():
    provider = ['--generation-provider', FIXTURES / 'providers.mjs']
    for name, body, imports, message in [
            ('trap', '(begin (unreachable) (constant-library 42))', '(producer make) (only (sfir primitive) unreachable)', 'unreachable'),
            ('bad-location', '(begin (source-span (builder-name "bad") 0 1) (constant-library 42))',
             '(producer make) (sfir compiler-builder)', 'source locations are one-based')]:
        path = recipe(name, body, imports)
        build(path, name, *provider, errors=('SFIR library generation failed', message, str(path)))
        records = [json.loads(line) for line in (OUTPUT / 'providers.jsonl').read_text().splitlines()]
        assert [(record['action'], record['libraryKey']) for record in records[-2:]] == [
            ('open', ['bad', name]), ('close', ['bad', name])]
    body = '''(begin
      (let span (source-span (builder-name "invalid-transfer.sfir") 13 2))
      (let scope (library-scope))
      (let name (builder-name "duplicate"))
      (let exported (library-export name (import-reference scope name span)))
      (sfir-library (cons name (empty-list)) scope (empty-list)
        (cons exported (cons exported (empty-list))) (empty-list) span))'''
    build(recipe('bad-transfer', body, '(sfir compiler-builder) (only (sfir primitive) cons empty-list)'),
          'bad-transfer', *provider, errors=('duplicate transfer name', 'invalid-transfer.sfir:13:2'))
    records = [json.loads(line) for line in (OUTPUT / 'providers.jsonl').read_text().splitlines()]
    assert [(record['action'], record['libraryKey']) for record in records[-2:]] == [
        ('open', ['bad', 'bad-transfer']), ('close', ['bad', 'bad-transfer'])]
    broken = source(OUTPUT / 'broken-providers.mjs', '''export function createProviders() {
      return {providers: null, close() { throw new Error('cleanup sentinel'); }};
    }''')
    build(recipe('broken', '(constant-library 42)'), 'broken', '--generation-provider', broken,
          errors=('provider factory must return a provider Map', 'cleanup sentinel'))
    null_provider = source(OUTPUT / 'null-provider.mjs', '''import {readFileSync} from 'node:fs';
    export function createProviders() {
      const module = new WebAssembly.Module(readFileSync(new URL('./provider.wasm', import.meta.url)));
      const provider = new WebAssembly.Instance(module, {host: {offset() { throw null; }}});
      return {providers: new Map([['tests.source', provider]]), close() { throw new Error('cleanup after null'); }};
    }''')
    build(recipe('null-primary', '(constant-library (read-offset))', '(producer make) (producer services)'),
          'null-primary', '--generation-provider', null_provider,
          errors=('Caused by: null', 'cleanup after null'))
    build(recipe('no-provider', '(constant-library (read-offset))', '(producer make) (producer services)'),
          'no-provider', errors=('missing Wasm provider: tests.source', 'no-provider.sfir'))


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    nested_generation()
    command_targets()
    recipe_failures()
    preparation_cycles()
    source_selection()
    provider_failures()
    print('PASS recipe grammar, nominal result, source selection, preparation chains, located checking and failure cleanup', flush=True)


if __name__ == '__main__':
    main()
