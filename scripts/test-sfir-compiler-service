#!/usr/bin/env python3
"""Run the compiler and execution API from an actual linked SFIR build program."""

import json
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / 'tests/sfir-compiler-service'
OUTPUT = ROOT / 'build/sfir-compiler-service'
RECORDS = []


# ---- Retain correctness evidence, without claiming timing measurements ----


def run(command, cwd=ROOT):
    result = subprocess.run(list(map(str, command)), cwd=cwd, capture_output=True, text=True,
                            timeout=300, env={**os.environ, 'BINARYEN_CORES': '1'})
    RECORDS.append(dict(command=list(map(str, command)), status=result.returncode,
                        stdout=result.stdout, stderr=result.stderr))
    (OUTPUT / 'commands.json').write_text(json.dumps(RECORDS, indent=2) + '\n')
    assert result.returncode == 0, RECORDS[-1]
    if result.stdout:
        print(result.stdout, end='', flush=True)


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    for name in ('provider', 'wrong-provider', 'observer', 'reentry'):
        source = FIXTURES if name in ('observer', 'reentry') else ROOT / 'tests/sfir-execution'
        run([os.environ.get('WASM_AS', 'wasm-as'), '--enable-mutable-globals',
             source / (name + '.wat'), '-o', OUTPUT / (name + '.wasm')])
    run([os.environ.get('CHIBI', 'chibi-scheme'), '-I', ROOT / 'src', FIXTURES / 'build.scm', ROOT, OUTPUT])
    run([os.environ.get('NODE', 'node'), '--expose-gc', FIXTURES / 'run.mjs', OUTPUT], cwd=OUTPUT)
    run([os.environ.get('NODE', 'node'), FIXTURES / 'lifecycle.mjs', OUTPUT])


if __name__ == '__main__':
    main()
