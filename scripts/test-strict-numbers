#!/usr/bin/env python3
"""Check exact/binary64 boundaries against Python integers and Fraction."""

import argparse
from fractions import Fraction
import importlib.machinery
import json
import math
import os
from pathlib import Path
import random
import struct

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / 'tests/strict-numbers'
SUPPORT = importlib.machinery.SourceFileLoader('integer_tests', str(ROOT / 'scripts/test-strict-integer')).load_module()


# ---- Independent exact arithmetic and binary64 bit patterns ----


def bits(value):
    return str(struct.unpack('>Q', struct.pack('>d', value))[0])


def as_float(value):
    try:
        return float(value)
    except OverflowError:
        return -math.inf if value < 0 else math.inf


def fixtures():
    cases = []
    def add(label, operation, a=0, b=1, value=0.0, result=0.0, text='', error=False):
        cases.append(dict(label=label, operation=operation, a=str(a), b=str(b),
                          input=bits(value), bits=bits(result), text=str(text), error=error))
    ratios = [(0, 1), (1, 3), (-1, 3), (1, -3), (-1, -3), (2**10000, 2**10000+1)]
    for exponent in [-1076, -1075, -1074, -1023, -1022, -53, 0, 52, 53, 1023, 1024]:
        power = Fraction(2) ** exponent
        for multiplier in [Fraction(1), Fraction(3, 2), Fraction(5, 2), Fraction(7, 2)]:
            center = power * multiplier
            for offset in [0, Fraction(1, 2**60), -Fraction(1, 2**60)]:
                value = center * (1 + offset)
                ratios.append((value.numerator, value.denominator))
    # Halfway at maximum finite, at the normal/subnormal boundary, and around
    # a 53-bit integer distinguish one exact rounding from staged division.
    for center in [Fraction(2**1024 - 2**970), Fraction(2**53+1),
                   Fraction(2**53-1, 2**1075), Fraction(1, 2**1075)]:
        step = Fraction(1, 2**1200) if center < 1 else Fraction(1)
        for offset in [-step, 0, step]:
            value = center + offset
            ratios.extend([(value.numerator, value.denominator), (-value.numerator, value.denominator)])
    rng = random.Random(7124)
    for index in range(80):
        ratios.append((rng.getrandbits(rng.randrange(1, 2200)), rng.getrandbits(rng.randrange(1, 2200)) or 1))
    for index, (a, b) in enumerate(ratios):
        add(f'ratio-{index}', 0, a, b, result=as_float(Fraction(a, b)))
    for a in [0, 1, -1, 2**53-1, 2**53+1, 2**53+3, 2**1000+2**946+1, 2**1024, -2**1024]:
        add(f'integer-float-{a}', 5, a, result=as_float(a))
    values = [0.0, -0.0, 0.5, -0.5, 1.5, -1.5, 5e-324, -5e-324,
              2.2250738585072014e-308, 1.0000000000000002, 2**53, 2.0**63,
              math.nextafter(2.0**63, 0.0), 1.7976931348623157e308, math.inf, -math.inf, math.nan]
    for index, value in enumerate(values):
        valid = math.isfinite(value)
        add(f'exact-float-{index}', 1, value=value, text=math.trunc(value) if valid else '',
            error=not valid or value != math.trunc(value))
        add(f'truncate-float-{index}', 2, value=value, text=math.trunc(value) if valid else '', error=not valid)
    for a in [-2**100+13, -13, 0, 13, 2**100-13]:
        for b in [-2**70+9, -7, 7, 2**70-9]:
            add(f'floor-{a}-{b}', 3, a, b, text=a//b)
            add(f'modulo-{a}-{b}', 4, a, b, text=a%b)
            add(f'gcd-{a}-{b}', 6, a, b, text=math.gcd(a, b))
    add('ratio-zero-denominator', 0, 1, 0, error=True)
    for a, b in [(0, -17), (4, -8), (-4, -8), (2**250-2, 2**249-1), (0, 0), (1, 0)]:
        add(f'normalize-{a}-{b}', 7, a, b, text=str(Fraction(a, b)) if b else '', error=b == 0)
    fractions = [Fraction(0), Fraction(1), Fraction(-1, 2), Fraction(2, 3),
                 Fraction(2**100+1, 3**40), Fraction(-3**45, 2**170)]
    for left in fractions:
        for right in fractions:
            for operation, answer in [(8, left+right), (9, left-right), (10, left*right),
                                      (12, (left > right) - (left < right))]:
                add(f'rational-{operation}-{left}-{right}', operation, left, right, text=answer)
            add(f'rational-divide-{left}-{right}', 11, left, right,
                text=str(left/right) if right else '', error=right == 0)
        add(f'rational-truncate-{left}', 13, left, text=math.trunc(left))
        add(f'rational-floor-{left}', 16, left, text=math.floor(left))
    for index, value in enumerate([*values, 0.1, -0.1, 1e-200, -1e200]):
        valid = math.isfinite(value)
        add(f'rational-exact-float-{index}', 14, value=value,
            text=str(Fraction(value)) if valid else '', error=not valid)
        add(f'rational-roundtrip-{index}', 15, value=value,
            result=value if value else 0.0, error=not valid)
    return cases


# ---- The same exported Scheme operation runs on Wasm and native64 ----


def domain_source(output):
    source = output / 'domain.scm'
    text = (FIXTURES / 'domain.scm').read_text()
    for module in ['rational', 'number']:
        library = (ROOT / 'src/snail' / (module + '.sld')).read_text()
        text += '\n' + SUPPORT.form(library, '(begin\n      (define (test-' + module + ')')
        text += f'\n(unless (= (test-{module}) 42) (unreachable))\n'
    source.write_text(text)
    return source


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, default=ROOT / 'build/strict-numbers')
    parser.add_argument('--domain', action='store_true', help='Exercise parsed Number values and the linked scalar runtime')
    options = parser.parse_args(); output = options.output.resolve(); output.mkdir(parents=True, exist_ok=True)
    env = {**os.environ, 'BINARYEN_CORES': '1'}
    domain = importlib.machinery.SourceFileLoader('number_domain_cases', str(FIXTURES / 'domain.py')).load_module() if options.domain else None
    cases = domain.fixtures() if domain else fixtures()
    (output / 'oracle.json').write_text(json.dumps(cases, indent=2) + '\n')
    def execute(command, label, expected=0, environment=env):
        return SUPPORT.execute(command, output / (label + '.json'), environment, expected)
    def rows(items):
        return ''.join('\t'.join(str(item[key]) for key in ['operation', 'a', 'b', 'input', 'bits', 'text']) + '\n' for item in items)
    (output / 'valid.tsv').write_text(rows(item for item in cases if not item['error']))
    wasm = output / 'oracle.wasm'
    source = domain_source(output) if options.domain else FIXTURES / 'oracle.scm'
    execute([ROOT / 'scripts/build-strict', '--export', 'probe', source, wasm], 'compile')
    if options.domain:
        execute([env.get('CARGO', 'cargo'), 'rustc', '--crate-type=cdylib', '--quiet', '--offline',
                 '--release', '--target', 'wasm32-wasip1', '--target-dir', ROOT / 'build/wasm-runtime'], 'runtime')
    runtime = ROOT / 'build/wasm-runtime/wasm32-wasip1/release/snail_runtime.wasm'
    for kind, artifact in [('raw', Path(str(wasm) + '.raw.wasm')), ('optimized', wasm)]:
        if options.domain:
            linked = output / f'{kind}-linked.wasm'
            flags = ['--diagnostic-prune-only'] if kind == 'raw' else []
            execute([ROOT / 'scripts/link-strict-runtime', '--runtime', runtime, *flags, artifact, linked], kind + '-link')
            artifact = linked
        execute([env.get('NODE', 'node'), '--disable-warning=ExperimentalWarning', FIXTURES / 'oracle.mjs', artifact, output / 'oracle.json'], kind)
    native = output / 'native'
    transport = ROOT / 'tests/strict-integer'
    execute([ROOT / 'scripts/build-native', '--wasm', '--c-provider', 'oracle', transport / 'oracle.h',
             transport / 'oracle-provider.c', '--entry-c', FIXTURES / 'oracle.c', wasm, native], 'native-build')
    execute([native, output / 'valid.tsv'], 'native')
    execute([native, output / 'valid.tsv'], 'native-gc', environment={**env, 'SNAIL_NATIVE_GC_INTERVAL': '1'})
    for index, item in enumerate(item for item in cases if item['error']):
        path = output / f'failure-{index}.tsv'; path.write_text(rows([item]))
        record = execute([native, path], f'failure-{index}', expected='error')
        assert 'WebAssembly trap' in record['stderr'], record
    (output / 'summary.json').write_text(json.dumps(dict(passed=True, cases=len(cases), diagnostic_only=True)) + '\n')
    print(f'PASS {len(cases)} exact-number contracts: raw, optimized, native64 and forced GC', flush=True)


if __name__ == '__main__':
    main()
