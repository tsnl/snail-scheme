#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
output="$root/build/draw3d-tests"
mkdir -p "$output/lib/webgpu"
for fixture in math frame shader; do
  chibi-scheme -I "$root/bootstrap" "$root/tests/applications/build.scm" "$root" \
    "$root/tests/draw3d/$fixture.sld" "$output/$fixture.wasm" "$root/apps/siegework/src"
done
node "$root/tests/draw3d/run.mjs" "$output"
cp "$root/tests/draw3d/index.html" "$output/index.html"
cp "$root/src/webgpu/scene.mjs" "$output/lib/webgpu/scene.mjs"
