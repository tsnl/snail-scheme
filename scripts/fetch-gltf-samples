#!/usr/bin/env bash
# Fetches Khronos's glTF sample models into a viewer's output directory,
# for src/apps/viewer: `models/` there holds each model's glTF/ variant,
# and `models.html` links the viewer to each.
#
#   scripts/fetch-gltf-samples DIR [MODEL ...]
#
# With no MODEL, every model with a glTF/ variant. The models come from a
# sparse, blobless clone in build/gltf-samples, so only the files of the
# models asked for are downloaded; asking again adds to it.
set -euo pipefail
out=${1:?usage: scripts/fetch-gltf-samples DIR [MODEL ...]}
shift
cache=build/gltf-samples
if [ ! -d "$cache/.git" ]; then
  git clone --quiet --depth 1 --filter=blob:none --no-checkout \
    https://github.com/KhronosGroup/glTF-Sample-Assets.git "$cache"
  git -C "$cache" sparse-checkout init --no-cone
fi
if [ $# -eq 0 ]; then
  patterns=('/Models/*/glTF/')
else
  patterns=()
  for model in "$@"; do patterns+=("/Models/$model/glTF/"); done
fi
existing=$(git -C "$cache" sparse-checkout list 2>/dev/null || true)
git -C "$cache" sparse-checkout set --no-cone $existing "${patterns[@]}"
git -C "$cache" checkout --quiet
mkdir -p "$out"
ln -sfn "$(realpath "$cache/Models")" "$out/models"
{
  echo '<!doctype html><meta charset="utf-8"><title>Models</title>'
  echo '<style>body{font:14px system-ui,sans-serif;background:#111;color:#ddd;margin:24px}a{color:#9cf}li{margin:3px 0}</style>'
  echo '<h1>glTF sample models</h1><ul>'
  for gltf in "$cache"/Models/*/glTF/*.gltf; do
    [ -e "$gltf" ] || continue
    path=${gltf#"$cache/Models/"}
    echo "<li><a href=\"index.html?model=$path\">${path%%/*}</a></li>"
  done
  echo '</ul>'
} > "$out/models.html"
echo "$out/models.html"
