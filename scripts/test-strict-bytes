#!/usr/bin/env python3
"""Check all Unicode scalars against Python's UTF-8 codec on Wasm and native."""

import hashlib
import json
import os
from pathlib import Path
import struct
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / 'build/strict-bytes'
RECORDS = []


# ---- Captured commands and independent expected byte encodings ----


def run(command, status=0, stdout=None, diagnostic=None, **environment):
    process = subprocess.run(list(map(str, command)), cwd=ROOT, capture_output=True, text=True,
                             timeout=600, env={**os.environ, **environment})
    RECORDS.append(dict(command=list(map(str, command)), status=process.returncode,
                        stdout=process.stdout, stderr=process.stderr, environment=environment))
    (BUILD / 'commands.json').write_text(json.dumps(RECORDS, indent=2) + '\n')
    assert (process.returncode != 0 if status == 'error' else process.returncode == status), RECORDS[-1]
    assert stdout is None or process.stdout == stdout, RECORDS[-1]
    assert diagnostic is None or diagnostic in process.stderr, RECORDS[-1]


def write_oracle():
    path = BUILD / 'unicode.bin'
    with path.open('wb') as output:
        for scalar in range(0x110000):
            if not 0xD800 <= scalar <= 0xDFFF:
                encoded = chr(scalar).encode('utf-8')
                packed = int.from_bytes(encoded, 'little') + (len(encoded) << 32)
                output.write(struct.pack('<IQ', scalar, packed))
    assert path.stat().st_size == 1112064 * 12
    (BUILD / 'oracle.json').write_text(json.dumps(dict(scalars=1112064, bytes=path.stat().st_size,
         sha256=hashlib.sha256(path.read_bytes()).hexdigest(), python=sys.version), indent=2) + '\n')
    return path


# ---- Actual raw/optimized Wasm and native execution ----


def check_unicode(oracle):
    source = ROOT / 'tests/strict-bytes/unicode.scm'
    wasm, native = BUILD / 'unicode.wasm', BUILD / 'unicode-native'
    exports = ['--export', 'encode-scalar', '--export', 'decode-scalar']
    run([ROOT / 'scripts/build-strict', source, wasm, *exports])
    for module in [Path(str(wasm) + '.raw.wasm'), wasm]:
        run([os.environ.get('NODE', 'node'), ROOT / 'tests/strict-bytes/unicode.mjs', module, oracle],
            stdout='scalars 1112064\n')
    run([ROOT / 'scripts/build-native', '--strict', '--entry-c', ROOT / 'tests/strict-bytes/unicode.c',
         *exports, source, native])
    run([native, oracle], stdout='scalars 1112064\n')
    print('PASS all 1,112,064 Unicode scalars: encode/decode on raw Wasm, optimized Wasm and native', flush=True)


# ---- Literal validation limit is distinct from runtime allocation ----


def check_literal_limit():
    source, wasm = BUILD / 'literal-10000.scm', BUILD / 'literal-10000.wasm'
    literal = ' '.join(str(index % 256) for index in range(10000))
    source.write_text('(import (snail strict) (snail bytes))\n(define bytes #u8(' + literal + '))\n'
                      '(let loop ((i 0)) (if (= i 10000) 42 '
                      '(if (= (bytevector-u8-ref bytes i) (remainder i 256)) (loop (+ i 1)) (unreachable))))\n')
    run([ROOT / 'scripts/build-strict', source, wasm])
    for module in [Path(str(wasm) + '.raw.wasm'), wasm]:
        run([os.environ.get('NODE', 'node'), ROOT / 'tests/strict/run.mjs', module, '42'])
    run([ROOT / 'scripts/build-native', '--strict', source, BUILD / 'literal-native'])
    run([BUILD / 'literal-native'], status=42, SNAIL_NATIVE_GC_INTERVAL='1')
    oversized = BUILD / 'literal-10001.scm'
    oversized.write_text('(import (snail strict) (snail bytes))\n(bytevector-length #u8(' + literal + ' 0))\n')
    run([ROOT / 'scripts/build-strict', oversized, BUILD / 'too-large.wasm'], status='error',
        diagnostic='literal-10001.scm:2:20: bytevector literal exceeds Wasm array.new_fixed limit')
    print('PASS literal boundary: all 10,000 bytes checked; 10,001 rejected before invalid Wasm', flush=True)


def main():
    BUILD.mkdir(parents=True, exist_ok=True)
    log = BUILD / 'commands.json'
    if log.exists():
        RECORDS.extend(json.loads(log.read_text()))
    check_unicode(write_oracle())
    check_literal_limit()


if __name__ == '__main__':
    main()
