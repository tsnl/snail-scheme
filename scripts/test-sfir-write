#!/usr/bin/env python3
"""Execute exact typed datum output on both linked Wasm forms and native64."""

import argparse
import hashlib
import importlib.machinery
import json
import os
from pathlib import Path
import signal
import time

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / 'build' / f'sfir-write-{time.time_ns()}'
ARTIFACTS = OUTPUT
FIXTURES = ROOT / 'tests/sfir-write'
SUPPORT = importlib.machinery.SourceFileLoader('reader_checks', str(ROOT / 'scripts/test-sfir-reader')).load_module()
SUPPORT.OUTPUT = SUPPORT.ARTIFACTS = OUTPUT
SUPPORT.ENV['SNAIL_NATIVE_GC_INTERVAL'] = '1'
run = SUPPORT.run
EXPORTS = ['copy-output', 'roundtrip', 'graphs', 'deep-output', 'stdout-check', 'closed-empty',
           'callback-trap', 'invalid-character', 'invalid-handle', 'read-stdout', 'stdout-failure']


# ---- Fixed spellings independently specify complete Unicode output streams ----


def cases():
    values = [('()', '()', '()'), ('#t', '#t', '#t'), ('#f', '#f', '#f')]
    for source, written, shown in [(r'#\x0', r'#\x0', '\0'), (r'#\space', r'#\space', ' '),
            (r'#\newline', r'#\newline', '\n'), (r'#\tab', r'#\tab', '\t'), (r'#\return', r'#\return', '\r'),
            (r'#\)', r'#\)', ')'), (r'#\x', r'#\x', 'x'), (r'#\λ', r'#\λ', 'λ'),
            (r'#\x1f600', '#\\😀', '😀'), (r'#\x10ffff', '#\\\U0010ffff', '\U0010ffff'),
            (r'#\x85', r'#\x85', '\x85')]:
        values.append((source, written, shown))
    values += [('""', '""', ''),
        (r'"a\"b\\c\n\r\t\a\b\x0;\x7f;\x85;λ😀"',
         r'"a\"b\\c\n\r\t\x7;\x8;\x0;\x7f;\x85;λ😀"', 'a"b\\c\n\r\t\a\b\0\x7f\x85λ😀')]
    for name in ['a', 'λ', '+', '-', '...', '.a', 'lambda', '+foo', '-foo']:
        values.append((name, name, name))
    for name in ['', '123', '+i', '-i', '+inf.0', '+nan.0', '1/0', 'a b', '😀', '.', '#t', '123abc']:
        values.append(('|' + name + '|', '|' + name + '|', name))
    values.append((r'|a\|b\\c\x0;\n|', r'|a\|b\\c\x0;\n|', 'a|b\\c\0\n'))
    for source, written in [('0', '0'), ('-9223372036854775808', '-9223372036854775808'),
            ('9223372036854775807', '9223372036854775807'), ('9223372036854775808', '9223372036854775808'),
            ('-9223372036854775809', '-9223372036854775809'), ('#x20000000000000000', '36893488147419103232'),
            ('#e9007199254740993.0', '9007199254740993'), ('#e1.5', '3/2'), ('-2/4', '-1/2'), ('4/2', '2'),
            ('#e0.1+0.2i', '1/10+1/5i'), ('9223372036854775808-1/7i', '9223372036854775808-1/7i'),
            ('1+2i', '1+2i'), ('1-0.0i', '1.0-0.0i'), ('#i1+0i', '1.0+0.0i'),
            ('0.0', '0.0'), ('-0.0', '-0.0'), ('1e3', '1000.0'), ('1e-3', '0.001'),
            ('5e-324', '5e-324'), ('+inf.0', '+inf.0'), ('-inf.0', '-inf.0'), ('+nan.0', '+nan.0')]:
        values.append((source, written, written))
    for source, written in [('#e1e200', '1' + '0' * 200),
                            ('1/' + '1' + '0' * 80, '1/' + '1' + '0' * 80),
                            ('1.0+inf.0i', '1.0+inf.0i')]:
        values.append((source, written, written))
    values += [(r'(a "b" #\newline . c)', r'(a "b" #\newline . c)', '(a b \n . c)'),
        (r'#(a ("λ" . #\space) #u8(0 1 127 128 255))',
         r'#(a ("λ" . #\space) #u8(0 1 127 128 255))', '#(a (λ .  ) #u8(0 1 127 128 255))'),
        ('#()', '#()', '#()'), ('#u8()', '#u8()', '#u8()')]
    return values


def expected_graphs():
    shared = '#0=#(#1=(a) #1# #2="s" #2# #3=#u8(1 2) #3# #0#)'
    return '\n'.join(['#((a) (a))', '#0=(a . #0#)', '#0=(#0# . #0#)', '#0=(#0# . #0#)',
                      '#0=#(a #0#)', shared, shared, '#0=#((a . #1=(b c)) #1# #0#)']) + '\n'


# ---- Compile once and retain every actual host invocation ----


def build():
    source = OUTPUT / 'writer.wasm'
    exports = [word for name in EXPORTS for word in ['--export', name]]
    run([ROOT / 'scripts/build-sfir', *exports, FIXTURES / 'output.sfir', source], 'compile', timeout=900)
    run([os.environ.get('CARGO', 'cargo'), 'rustc', '--crate-type=cdylib', '--quiet', '--offline',
         '--release', '--target', 'wasm32-wasip1', '--target-dir', ROOT / 'build/wasm-runtime'], 'runtime')
    runtime = ROOT / 'build/wasm-runtime/wasm32-wasip1/release/snail_runtime.wasm'
    for name, suffix, flags in [('raw', '.raw.wasm', ['--diagnostic-prune-only']), ('optimized', '', [])]:
        run([ROOT / 'scripts/link-sfir-runtime', '--runtime', runtime, *flags,
             Path(str(source) + suffix), OUTPUT / (name + '.wasm')], name + '-link')
    run([ROOT / 'scripts/build-native', '--wasm', '--entry-c', FIXTURES / 'entry.c', source,
         OUTPUT / 'native'], 'native-build')


def check(system, action, expected='', failure=False):
    directory = OUTPUT / 'cases' / (system + '-' + action)
    directory.mkdir(parents=True)
    (directory / 'input.scm').write_text('\n'.join(row[0] for row in cases()) + '\n')
    SUPPORT.ENV['SNAIL_NATIVE_CLEANUP_LOG'] = str(directory / 'released')
    if system == 'native':
        command = [ARTIFACTS / 'native', action]
    else:
        command = [os.environ.get('NODE', 'node'), '--disable-warning=ExperimentalWarning',
                   FIXTURES / 'run.mjs', ARTIFACTS / (system + '.wasm'), directory, action]
    stdout = run(command, system + '-' + action, cwd=directory, failure=failure and system == 'native')
    if stdout != expected:
        raise RuntimeError(f'{system}-{action}: stdout differs: {stdout!r}')
    stderr = (OUTPUT / 'commands' / (system + '-' + action) / 'stderr').read_text()
    messages = dict(closed='unknown or closed file port', character='invalid Unicode scalar',
                    handle='unknown or closed file port', **{'read-stdout': 'unknown or closed file port'})
    if action in messages:
        assert messages[action] in stderr, (action, stderr)
    if not failure:
        assert not stderr, stderr
    if action == 'stdout-failure':
        assert ('No space left on device' in stderr if system == 'native'
                else any(text in stderr for text in ['I/O error', 'Input/output error'])), stderr
    if action == 'stream':
        for file, column in [('written.scm', 1), ('displayed.txt', 2)]:
            expected_bytes = ''.join(row[column] + '\n' for row in cases()).encode()
            if (directory / file).read_bytes() != expected_bytes:
                raise RuntimeError(f'{system}-{action}: exact {file} differs; see {directory}')
    if action == 'graphs':
        assert (directory / 'graphs.txt').read_bytes() == expected_graphs().encode()
    if action == 'deep':
        assert (directory / 'deep.txt').read_bytes() == ('(#(' * 4096 + 'end' + '))' * 4096 + '\n').encode()
    if failure and action != 'closed':
        assert (directory / 'pending.txt').read_bytes() == b'buffered'
    if system == 'native':
        released = int((directory / 'released').read_text())
        assert released == (5 if action == 'stream' else 1), (action, released)


# ---- Evidence includes exact source identities and complete terminal records ----


def freeze_sources():
    paths = [ROOT / name for name in ['lib/sfir/write.sfir', 'lib/sfir/io.sfir', 'src/strict_io.rs',
             'lib/sfir/datum.sfir', 'lib/sfir/number.sfir', 'src/strict_datum.rs',
             'scripts/test-sfir-write', 'scripts/test-sfir-reader', 'tests/native-cleanup-observer.h']]
    paths += sorted((ROOT / 'lib/sfir').glob('*.sfir'))
    paths += sorted((ROOT / 'src').rglob('*.sld'))
    paths += list(FIXTURES.iterdir())
    identities = {}
    for path in paths:
        relative = path.relative_to(ROOT)
        target = OUTPUT / 'sources' / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(path.read_bytes())
        identities[str(relative)] = hashlib.sha256(path.read_bytes()).hexdigest()
    (OUTPUT / 'source-identities.json').write_text(json.dumps(identities, indent=2) + '\n')


def main():
    global ARTIFACTS
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--reuse-artifacts', type=Path, help='reuse verified sources after driver/oracle corrections')
    options = parser.parse_args()
    ARTIFACTS = options.reuse_artifacts.resolve() if options.reuse_artifacts else OUTPUT
    SUPPORT.ARTIFACTS = ARTIFACTS
    OUTPUT.mkdir(parents=True)
    print(OUTPUT, flush=True)
    freeze_sources()
    SUPPORT.record_tools()
    oracle = run([os.environ.get('CHEZ', 'scheme'), '--script', FIXTURES / 'oracle.scm'], 'graph-oracle')
    assert oracle.replace('#vu8(', '#u8(') == expected_graphs()
    if options.reuse_artifacts:
        verify_reuse()
    else:
        build()
    SUPPORT.record_artifacts()
    for system in ['raw', 'optimized', 'native']:
        for action in ['stream', 'graphs', 'deep']:
            check(system, action)
        check(system, 'stdout', 'stdout:λ😀 (a "b")\nborrowed:!\n()\n')
        for action in ['closed', 'trap', 'character', 'handle', 'read-stdout', 'stdout-failure']:
            check(system, action, 'before trap' if action == 'trap' else '', failure=True)
        print('PASS typed datum output ' + system, flush=True)
    report = dict(systems=['raw linked Wasm', 'optimized linked Wasm', 'native64'],
                  datum_cases=len(cases()), graph_cases=8, depth=8192, terminal_failures=6,
                  stdout_ownership='borrowed; close is a no-op; standard descriptors never closed')
    (OUTPUT / 'validation.json').write_text(json.dumps(report, indent=2) + '\n')
    print('PASS complete typed datum output: ' + str(OUTPUT), flush=True)


def verify_reuse():
    previous = json.loads((ARTIFACTS / 'source-identities.json').read_text())
    native_record = next(ARTIFACTS.glob('native.native-*/build.json'))
    native_sources = json.loads(native_record.read_text())['sha256']
    for name, expected in previous.items():
        if name.startswith(('src/', 'lib/')) or name.endswith(('output.sfir', 'entry.c', 'native-cleanup-observer.h')):
            if name.endswith('entry.c'):
                expected = native_sources[str(ROOT / name)]
            assert hashlib.sha256((ROOT / name).read_bytes()).hexdigest() == expected, name
    identities = {name: hashlib.sha256((ARTIFACTS / name).read_bytes()).hexdigest()
                  for name in ['raw.wasm', 'optimized.wasm', 'writer.wasm', 'native']}
    (OUTPUT / 'reused-artifacts.json').write_text(json.dumps(dict(directory=str(ARTIFACTS),
        sha256=identities, native_source_record=str(native_record), compiled_sources_verified=True), indent=2) + '\n')


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, SUPPORT.interrupted)
    main()
