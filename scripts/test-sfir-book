#!/usr/bin/env python3
"""Execute the book's overview examples and its F32-to-I32 conversion."""

import json
import os
from pathlib import Path
import re
import runpy
import tempfile

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / 'tests/sfir-book'
SUPPORT = runpy.run_path(str(ROOT / 'tests/sfir-instances/check.py'))
run, succeeded, digest = SUPPORT['run'], SUPPORT['succeeded'], SUPPORT['digest']
CONVERSIONS = [('0', 0), ('-0', 0), ('127.75', 127), ('-127.75', -127),
               ('2147483520', 2147483520), ('-2147483648', -2147483648),
               ('2147483648', 'trap'), ('-2147483904', 'trap'),
               ('Infinity', 'trap'), ('-Infinity', 'trap'), ('NaN', 'trap')]
FIBONACCI_CHECK = '''
(if (= (fibonacci 10) 55)
    (if (= (fast-fibonacci 0) 0)
        (if (= (fast-fibonacci 1) 1)
            (if (= (fast-fibonacci 46) 1836311903) 42 (unreachable))
            (unreachable))
        (unreachable))
    (unreachable))
'''
COLOR_CHECK = '''
(if (string=? (to-hex-string (primary (red))) "#ff0000ff")
    (if (string=? (to-hex-string (primary (green))) "#00ff00ff")
        (if (string=? (to-hex-string (primary (blue))) "#0000ffff")
            (if (string=? (to-hex-string (rgb (vec3 (ann 1.0 F32) (ann 0.5 F32) (ann 0.0 F32))))
                         "#ff7f00ff") 42 (unreachable))
            (unreachable))
        (unreachable))
    (unreachable))
'''


# ---- Published source and actual target execution ----


def check(name, source, output, conversions=False):
    directory = output / name
    directory.mkdir()
    path, wasm = directory / 'program.sfir', directory / 'program.wasm'
    path.write_text(source)
    exports = ['--export', 'convert'] if conversions else []
    succeeded(run([ROOT / 'scripts/build-sfir', '-I', ROOT / 'examples', *exports, path, wasm],
                  directory / 'compile.json'))
    raw = Path(str(wasm) + '.raw.wasm')
    cases = CONVERSIONS if conversions else []
    for label, artifact in [('raw', raw), ('optimized', wasm)]:
        succeeded(run([os.environ.get('NODE', 'node'), FIXTURES / 'run.mjs', artifact, json.dumps(cases)],
                      directory / (label + '.json')))
    entry = directory / 'entry.c'
    entry.write_text(('#define TEST_CONVERSION\n' if conversions else '') + (FIXTURES / 'entry.c').read_text())
    executable = directory / 'program.native'
    succeeded(run([ROOT / 'scripts/build-native', '--wasm', '--entry-c', entry, raw, executable],
                  directory / 'native-build.json'))
    optimized, = directory.glob('program.native.native-*/optimized.wasm')
    assert optimized.read_bytes() == wasm.read_bytes(), 'native must lower the same optimized guest'
    succeeded(run([executable], directory / 'native.json', SNAIL_NATIVE_GC_INTERVAL='1'))
    for index, (value, expected) in enumerate(cases):
        record = run([executable, value, str(expected)], directory / f'native-{index}.json',
                     SNAIL_NATIVE_GC_INTERVAL='1')
        assert record['status'] == (1 if expected == 'trap' else 0), record
        assert record['stderr'] == ('WebAssembly trap\n' if expected == 'trap' else ''), record
    print('PASS raw/optimized Wasm and native:', name, flush=True)
    return dict(name=name, source_sha256=digest(path), raw_sha256=digest(raw),
                optimized_sha256=digest(wasm), native_sha256=digest(executable))


# ---- Tests ----


def main():
    book = ROOT / 'doc/book/sfir/index.md'
    blocks = re.findall(r'^```scheme\n(.*?)^```', book.read_text(), re.M | re.S)
    assert len(blocks) == 2, 'review the executable overview examples when their structure changes'
    parent = ROOT / 'build/sfir-book'
    parent.mkdir(parents=True, exist_ok=True)
    output = Path(tempfile.mkdtemp(prefix='attempt-', dir=parent))
    results = []
    for name, source, conversions in [('fibonacci', blocks[0] + FIBONACCI_CHECK, False),
                                      ('colors', blocks[1] + COLOR_CHECK, False),
                                      ('conversion', (FIXTURES / 'conversion.sfir').read_text(), True)]:
        results.append(check(name, source, output, conversions))
        (output / 'results.json').write_text(json.dumps(results, indent=2) + '\n')
    print('Retained outcomes:', output, flush=True)


if __name__ == '__main__':
    main()
