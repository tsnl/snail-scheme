#!/bin/sh
# Price paid exploration using the small model probe, without a renderer build.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${1-}" in --help|-h) node "$root/tests/applications/starter-economy-test.mjs" --help; exit ;; esac
output="$root/build/starter-economy-test"
mkdir -p "$output"
chibi-scheme -I "$root/bootstrap" "$root/tests/applications/build.scm" \
  "$root" "$root/tests/applications/max-dps-probe.sld" "$output/probe.wasm" \
  "$root/apps/siegework/src" "$root/tests/applications"
node "$root/tests/applications/starter-economy-test.mjs" "$output/probe.wasm" "$@"
