#!/usr/bin/env python3
"""Exercise shared input packets on linked Wasm and the identical native guest."""

import hashlib
import importlib.machinery
import json
import os
from pathlib import Path
import signal
import time

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / 'build' / f'sfir-input-packets-{time.time_ns()}'
FIXTURES = ROOT / 'tests/sfir-io'
SUPPORT = importlib.machinery.SourceFileLoader('reader_checks', str(ROOT / 'scripts/test-sfir-reader')).load_module()
SUPPORT.OUTPUT = SUPPORT.ARTIFACTS = OUTPUT
SUPPORT.ENV.update(CARGO_BUILD_JOBS='1', SNAIL_NATIVE_GC_INTERVAL='1')
run = SUPPORT.run
EXPORTS = ['copy-characters', 'mixed-readers', 'cached-close', 'copy-standard',
           'open-growing', 'peek-growing', 'read-growing', 'close-growing']


# ---- Freeze compiled sources and retain every command, including failures ----


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def freeze_sources():
    paths = [ROOT / name for name in ['Cargo.toml', 'Cargo.lock', 'scripts/test-sfir-input-packets',
             'scripts/test-sfir-reader', 'scripts/build-sfir', 'scripts/build-sfir.scm',
             'scripts/build-native', 'scripts/build-native.scm', 'scripts/link-sfir-runtime',
             'tests/native-cleanup-observer.h']]
    paths += [path for path in (ROOT / 'src').rglob('*') if path.is_file()]
    paths += sorted((ROOT / 'lib/sfir').glob('*.sfir'))
    paths += sorted(FIXTURES.glob('packet.*'))
    identities = {}
    for path in paths:
        relative = path.relative_to(ROOT)
        target = OUTPUT / 'sources' / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(path.read_bytes())
        identities[str(relative)] = digest(path)
    (OUTPUT / 'source-identities.json').write_text(json.dumps(identities, indent=2) + '\n')


# ---- Both engines receive the same mandatory-Binaryen optimized guest bytes ----


def build():
    guest = OUTPUT / 'guest.wasm'
    exports = [arg for name in EXPORTS for arg in ['--export', name]]
    run([ROOT / 'scripts/build-sfir', *exports, FIXTURES / 'packet.sfir', guest], 'compile', timeout=900)
    run([os.environ.get('CARGO', 'cargo'), 'rustc', '--crate-type=cdylib', '--offline', '--quiet',
         '--release', '--target', 'wasm32-wasip1', '--target-dir', ROOT / 'build/wasm-runtime'], 'runtime')
    runtime = ROOT / 'build/wasm-runtime/wasm32-wasip1/release/snail_runtime.wasm'
    for form, suffix, flags in [('raw', '.raw.wasm', ['--diagnostic-prune-only']), ('optimized', '', [])]:
        run([ROOT / 'scripts/link-sfir-runtime', '--runtime', runtime, *flags,
             Path(str(guest) + suffix), OUTPUT / (form + '.wasm')], form + '-link')
    run([ROOT / 'scripts/build-native', '--wasm', '--entry-c', FIXTURES / 'packet.c',
         Path(str(guest) + '.raw.wasm'), OUTPUT / 'native'], 'native-build', timeout=900)
    native_guest, = OUTPUT.glob('native.native-*/optimized.wasm')
    assert guest.read_bytes() == native_guest.read_bytes(), 'native and Wasm optimized guests differ'
    (OUTPUT / 'guest-identity.json').write_text(json.dumps(dict(sha256=digest(guest),
        wasm=str(guest), native=str(native_guest)), indent=2) + '\n')


# ---- Observe exact values, valid prefixes, resource release and EOF growth ----


def execute(form, name, contents, worker, expected, failure, releases):
    directory = OUTPUT / 'cases' / (name + '-' + form)
    directory.mkdir(parents=True)
    (directory / 'input.txt').write_bytes(contents)
    SUPPORT.ENV['SNAIL_NATIVE_CLEANUP_LOG'] = str(directory / 'released')
    command = ([OUTPUT / 'native', worker, expected] if form == 'native' else
               [os.environ.get('NODE', 'node'), '--disable-warning=ExperimentalWarning',
                FIXTURES / 'packet.mjs', OUTPUT / (form + '.wasm'), directory, worker, expected, int(failure)])
    label = name + '-' + form
    stdout = run(command, label, directory, failure=failure)
    record = json.loads((OUTPUT / 'commands' / label / 'record.json').read_text())
    assert record['returncode'] == int(failure), record
    if form == 'native':
        assert not stdout, stdout
        assert int((directory / 'released').read_text()) == releases
    else:
        assert json.loads(stdout) == dict(failed=failure, opened=releases, closed=releases, borrowedOpen=True)
    return directory, (OUTPUT / 'commands' / label / 'stderr').read_text()


def check(name, contents, worker='copy-characters', expected=None, error=None, prefix=None):
    failure = error is not None
    expected = len(contents.decode()) if expected is None and not failure else expected or 0
    releases = 2 if worker == 'copy-characters' else 1
    for form in ['raw', 'optimized', 'native']:
        directory, stderr = execute(form, name, contents, worker, expected, failure, releases)
        if failure:
            assert any(text in stderr.lower() for text in error), stderr
        else:
            assert not stderr, stderr
        if worker in ['copy-characters', 'copy-standard']:
            assert (directory / 'output.txt').read_bytes() == (prefix if failure else contents)


def main():
    OUTPUT.mkdir(parents=True)
    print(OUTPUT, flush=True)
    freeze_sources()
    SUPPORT.record_tools()
    build()
    SUPPORT.record_artifacts()
    for length in [0, 1, 6, 7, 8, 13, 14, 15, 8191, 8192, 8193]:
        check('ascii-' + str(length), b'a' * length)
    check('lane-extremes', b'\0\x7f' * 8)
    check('unicode', '\0\u007fabcdeλ😀\U0010ffffZ'.encode())
    check('split-unicode', b'a' * 8191 + 'λ😀\U0010ffffZ'.encode())
    check('mixed-readers', 'Aλline\r\n42 end\r\nZ'.encode(), 'mixed-readers', 1)
    check('eof-growth', b'', 'eof-growth', 0)
    for index, contents in enumerate([b'', 'abcdefg\0\u007fλ😀'.encode(), 'λabc😀'.encode()]):
        check('borrowed-stdin-' + str(index), contents, 'copy-standard')
        check('cached-close-' + str(index), contents, 'cached-close', error=['unknown or closed file port'])
    utf8_errors = ['utf-8', 'utf8', 'failed to fill whole buffer']
    for index, suffix in enumerate([b'\xff', b'\xf0\x9f', b'\xed\xa0\x80', b'\xc2a']):
        for length in [0, 1, 6, 7, 8, 8191]:
            prefix = b'a' * length
            check(f'prefix-{index}-{length}', prefix + suffix, error=utf8_errors, prefix=prefix)
        prefix = b'a' * 8191 + 'λ😀'.encode()
        check(f'unicode-prefix-{index}', prefix + suffix, error=utf8_errors, prefix=prefix)
    report = dict(systems=['raw linked Wasm', 'optimized linked Wasm', 'native64'],
                  native_forced_gc=True, native_wasm_guest_identical=True, performance_measurement=False,
                  semantics=['packet boundaries', 'NUL/DEL', 'split Unicode', 'mixed readers', 'aliases',
                             'borrowed stdin scalar interop', 'closed pending characters/EOF',
                             'EOF then file growth', 'valid prefix before malformed/truncated UTF-8'])
    (OUTPUT / 'validation.json').write_text(json.dumps(report, indent=2) + '\n')
    print('PASS packet input values, failure order and resource lifetimes: ' + str(OUTPUT), flush=True)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, SUPPORT.interrupted)
    main()
