#!/usr/bin/env python3
"""Execute linked SFIR text-file operations against real Node/WASI files."""

import json
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / 'build/sfir-io'
EXPORTS = ['format-number', 'unicode', 'callback-result', 'exists', 'remove', 'close-alias',
           'callback-close', 'escaped-alias', 'missing-directory', 'nul-path', 'delete-absent',
           'callback-trap', 'close-failure', 'invalid-character', 'invalid-handle', 'interrupted-path']
INPUT_EXPORTS = ['copy-lines', 'line-storage', 'close-input-alias', 'input-callback-close',
                 'input-escaped-alias', 'input-missing', 'input-callback-trap', 'read-invalid',
                 'input-raw-output', 'input-stale-handle', 'input-invalid-handle', 'input-invalid-peek']


# ---- Compile one fixture, then execute both retained compiler forms ----


def run(command, label):
    result = subprocess.run(list(map(str, command)), cwd=ROOT, text=True, capture_output=True, timeout=300)
    (OUTPUT / (label + '.json')).write_text(json.dumps(dict(command=list(map(str, command)),
        status=result.returncode, stdout=result.stdout, stderr=result.stderr), indent=2) + '\n')
    if result.returncode:
        raise SystemExit(result.stdout + result.stderr)


def check_form(source, label, runtime, contract):
    linked = OUTPUT / (label + '.wasm')
    flags = ['--diagnostic-prune-only'] if label.endswith('-raw') else []
    run([ROOT / 'scripts/link-sfir-runtime', '--runtime', runtime, *flags, source, linked], label + '-link')
    files = tempfile.mkdtemp(prefix=label + '-', dir=OUTPUT)
    host = 'input.mjs' if contract.startswith('input') else 'run.mjs'
    run([os.environ.get('NODE', 'node'), ROOT / 'tests/sfir-io' / host, linked, files, contract], label + '-run')
    print('PASS SFIR text I/O ' + label, flush=True)


def check_fixture(name, runtime):
    source = OUTPUT / (name + '.wasm')
    selected = EXPORTS if name == 'output' else INPUT_EXPORTS if name == 'input' else []
    exports = [word for export in selected for word in ('--export', export)]
    run([ROOT / 'scripts/build-sfir', *exports, ROOT / 'tests/sfir-io' / (name + '.sfir'), source], name + '-compile')
    check_form(Path(str(source) + '.raw.wasm'), name + '-raw', runtime, name)
    check_form(source, name + '-optimized', runtime, name)


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    run([os.environ.get('CARGO', 'cargo'), 'rustc', '--crate-type=cdylib', '--quiet', '--offline',
         '--release', '--target', 'wasm32-wasip1', '--target-dir', ROOT / 'build/wasm-runtime'], 'runtime')
    runtime = ROOT / 'build/wasm-runtime/wasm32-wasip1/release/snail_runtime.wasm'
    check_fixture('output', runtime)
    check_fixture('main-trap', runtime)
    check_fixture('input', runtime)
    check_fixture('input-main-trap', runtime)


if __name__ == '__main__':
    main()
