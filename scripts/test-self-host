#!/usr/bin/env python3
"""Run the compiled Wasm command and rebuild it with Node host effects."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]
CHIBI = os.environ.get("CHIBI", "chibi-scheme")
NODE = os.environ.get("NODE", "node")

# ---- Compiled command execution ----

def execute(command, *, environment=None):
    return subprocess.run(list(map(str, command)), cwd=ROOT, capture_output=True, text=True,
                          timeout=600, env={**os.environ, **(environment or {})})


def require(result, output=None, *, failure=False):
    if bool(result.returncode) != failure or (output is not None and result.stdout != output):
        raise RuntimeError(f"exit={result.returncode}\nstdout={result.stdout!r}\nstderr={result.stderr!r}")
    return result


def command(module, *arguments):
    return [NODE, "--no-warnings", ROOT / "scripts/run-wasi.mjs", module, *arguments]


def check_arguments(module, directory):
    source = directory / "args.scm"
    source.write_text('(import (scheme base) (scheme write) (scheme process-context))\n'
                      '(write (command-line)) (newline)\n')
    arguments = ['space in argument', '', '--help', '$(literal)`text`']
    expected = '(' + ' '.join(json.dumps(str(x)) for x in [source, *arguments]) + ')\n'
    require(execute(command(module, source, *arguments)), expected)
    require(execute(command(module, "--help")))
    require(execute(command(module, "--help"), environment={"WASM_OPT": "/missing/tool"}))
    failure = require(execute(command(module, source), environment={"WASM_OPT": "/missing/tool"}), failure=True)
    if "Binaryen tool is missing or unusable" not in failure.stderr:
        raise RuntimeError("compiler preflight lost its actionable diagnostic")


def check_entry(directory):
    source = directory / "entry.scm"
    source.write_text('(import (scheme base) (scheme write))\n'
                      '(display "initialized\n")\n'
                      '(define (main) (display "called\n") 7)\n')
    build = directory / "build.scm"
    quote = lambda value: json.dumps(str(value))
    main, script = directory / "main.wasm", directory / "script.wasm"
    build.write_text('(import (scheme base) (snail-scheme build) (snail-scheme chromium-trace))\n'
                     f'(with-chromium-trace-to {quote(directory / "build.trace.json")} (lambda ()\n'
                     f'(build-wasm {quote(ROOT)} {quote(source)} {quote(main)} (quote ()) (quote ()) (quote main))\n'
                     f'(build-wasm {quote(ROOT)} {quote(source)} {quote(script)})))\n')
    require(execute([CHIBI, "-I", ROOT / "src", build]))
    result = execute(command(main))
    if result.returncode != 7 or result.stdout != "initialized\ncalled\n":
        raise RuntimeError("explicit main did not initialize and execute exactly once")
    require(execute(command(script)), "initialized\n")


def check_rebuild(module, directory):
    replacement = directory / "replacement.wasm"
    require(execute(command(module, "-Isrc", ROOT / "build.scm", replacement)))
    if not replacement.read_bytes().startswith(b"\x00asm"):
        raise RuntimeError("replacement is not WebAssembly")
    check_arguments(replacement, directory)


# ---- Tests ----

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--interpreter", type=Path)
    args = parser.parse_args()
    module = args.interpreter or ROOT / "build/snail-scheme.wasm"
    if args.interpreter is None:
        require(execute([CHIBI, "-h512M", "-I", ROOT / "src", ROOT / "build.scm"]))
    with tempfile.TemporaryDirectory(prefix="snail-wasm-command-") as temporary:
        directory = Path(temporary)
        check_entry(directory)
        check_arguments(module, directory)
        check_rebuild(module, directory)
    print("Wasm command and compiler rebuild checks passed")


if __name__ == "__main__":
    main()
