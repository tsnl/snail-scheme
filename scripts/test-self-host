#!/usr/bin/env python3
"""Run the native interpreter, rebuild it without Chibi, then run its replacement."""

import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build/self-host-tests"
ARGUMENTS = ["space in argument", "", "--help", "$(literal)`text`"]


# ---- Literal scripts and native execution ----


def quote(value):
    return '"' + str(value).replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n') + '"'


def invoke(command, directory=ROOT, input="", **environment):
    return subprocess.run([str(value) for value in command], cwd=directory,
                          input=input, text=True, capture_output=True, timeout=1800,
                          env={**os.environ, "BINARYEN_CORES": "1", **environment})


def require(result, stdout="", status=0):
    if result.returncode != status or result.stdout != stdout:
        raise RuntimeError(f"exit={result.returncode}\nstdout={result.stdout!r}\nstderr={result.stderr!r}")
    if status == 0 and result.stderr:
        raise RuntimeError(result.stderr)
    return result


def require_native(path):
    with path.open("rb") as stream:
        if stream.read(4) != b"\x7fELF":
            raise RuntimeError(f"not a native ELF executable: {path}")


def write_script(directory, name, source):
    path = directory / name
    path.write_text(source)
    return path


# ---- Program handlers and script statements ----


def check_entry(directory):
    source = write_script(directory, "entry.scm", """(import (scheme base) (scheme write))
(display "initialize\\n")
(define (main) (display "main\\n") 7)
""")
    command, script = directory / "command", directory / "script"
    build = write_script(directory, "entry-build.scm",
                         '(import (scheme base) (snail-scheme native))\n' +
                         f"(build-native {quote(ROOT)} {quote(source)} {quote(command)} 'main)\n" +
                         f"(build-native {quote(ROOT)} {quote(source)} {quote(script)})\n")
    require(invoke([os.environ.get("CHIBI", "chibi-scheme"), "-I", ROOT / "src", build]))
    require_native(command)
    require_native(script)
    require(invoke([command]), "initialize\nmain\n", 7)
    require(invoke([script]), "initialize\n")
    require(invoke([command], SNAIL_NATIVE_GC_INTERVAL="1"), "initialize\nmain\n", 7)
    check_input_aliases(directory, source)
    check_link_failure(directory, source)
    print("passed explicit main and ordinary script entry", flush=True)


def check_input_aliases(directory, source):
    alias = directory / "source-alias.scm"
    alias.symlink_to(source)
    runtime = ROOT / "build/native-runtime/release/libsnail_runtime.a"
    stamp = runtime.stat().st_mtime_ns
    calls = [f'(build-native {quote(ROOT)} {quote(source)} {quote(output)})'
             for output in (source, alias, runtime)]
    body = '(import (scheme base) (snail-scheme native))\n'
    body += '\n'.join(f'(unless (guard (failure (else #t)) {call} #f) (error "accepted input alias"))'
                      for call in calls)
    build = write_script(directory, "aliases.scm", body)
    require(invoke([os.environ.get("CHIBI", "chibi-scheme"), "-I", ROOT / "src", build]))
    rejected = invoke([os.environ.get("CHIBI", "chibi-scheme"), "-I", ROOT / "src",
                       ROOT / "build.scm", ROOT / "main.scm"])
    if (rejected.returncode == 0 or "output must not replace" not in rejected.stderr or
            "intermediates retained" in rejected.stderr):
        raise RuntimeError(f"self-build did not reject its input before staging: {rejected}")
    if runtime.stat().st_mtime_ns != stamp or list(directory.glob('.snail-build-*')):
        raise RuntimeError("input alias check rebuilt runtime or created intermediates")


def check_link_failure(directory, source):
    output = directory / "link-output"
    output.write_text("previous executable")
    build = write_script(directory, "failed-link.scm", '(import (snail-scheme native))\n' +
                         f'(build-native {quote(ROOT)} {quote(source)} {quote(output)})\n')
    result = invoke([os.environ.get("CHIBI", "chibi-scheme"), "-I", ROOT / "src", build], CLANG="/missing/clang")
    retained = re.findall(r"build failed; intermediates retained: (.+)", result.stderr)
    if result.returncode == 0 or output.read_text() != "previous executable" or len(retained) != 1:
        raise RuntimeError(f"native link failure lost output or split its workspace: {result.stderr}")
    workspace = Path(retained[0])
    if workspace.parent != directory or not all((workspace / name).is_file() for name in
            ("program.wat", "program.wasm", "module.wasm", "module.ll")):
        raise RuntimeError("native link failure did not retain all compilation stages together")
    shutil.rmtree(workspace)


def check_script(interpreter, directory, **environment):
    temporary = directory / "script-temporaries"
    temporary.mkdir()
    environment = {**environment, "TMPDIR": str(temporary)}
    source = write_script(directory, "literal 'script.scm", """(import (scheme base) (scheme write) (scheme process-context))
(display "first\\n")
(define (main) (error "a script's helper must not become its entry"))
(write (command-line)) (newline)
(write (read-string 3)) (newline)
(write (utf8->string (bytevector-append (string->utf8 "λ") (bytevector 0 255)) 0 2)) (newline)
(write (bytevector-copy (bytevector 0 128 255) 1)) (newline)
(display "last\\n")
42
""")
    expected = ("first\n(" + " ".join(map(quote, [source.name, *ARGUMENTS])) +
                ')\n"aλ😀"\n"λ"\n#u8(128 255)\nlast\n')
    require(invoke([interpreter, source.name, *ARGUMENTS], directory, input="aλ😀z", **environment), expected)
    exit_source = write_script(directory, "exit.scm", '(import (scheme process-context)) (exit 7)\n')
    require(invoke([interpreter, exit_source], **environment), status=7)
    if list(temporary.iterdir()):
        raise RuntimeError("completed script retained temporary files")
    print("passed script order, stdin, argv, UTF-8, and exit status", flush=True)


# ---- Interpreter library options ----


def write_project_script(directory):
    first, second = directory / "first libraries", directory / "second libraries"
    for path in (first / "project", second / "project"):
        path.mkdir(parents=True)
    for path, increment in ((first, 2), (second, 59)):
        (path / "project/answer.sld").write_text(
            '(define-library (project answer) (export answer) '
            '(import (scheme base) (project helper)) '
            f'(begin (define answer (+ base {increment}))))')
    (first / "project/helper.sld").write_text(
        '(define-library (project helper) (export base) '
        '(import (scheme base)) (begin (define base 40)))')
    source = write_script(directory, "project.scm", """(import (scheme base) (scheme write)
        (scheme process-context) (project answer))
(write answer) (newline)
(write (command-line)) (newline)
""")
    return source, first.name, second.name


def check_library_options(interpreter, directory, **environment):
    source, first, second = write_project_script(directory)
    arguments = [*ARGUMENTS, "-I", "literal directory", "-Iscript-only", "--"]
    cases = [([f"-I{first}"], 42), (["-I", first], 42),
             ([f"-I{first}", "-I", second], 99), (["-I", second, f"-I{first}"], 42)]
    for options, answer in cases:
        expected = f"{answer}\n(" + " ".join(map(quote, [source.name, *arguments])) + ")\n"
        require(invoke([interpreter, *options, source.name, *arguments], directory, **environment), expected)
    source.rename(directory / "-Iscript.scm")
    expected = '42\n("-Iscript.scm" "-I" "literal")\n'
    require(invoke([interpreter, f"-I{first}", "--", "-Iscript.scm", "-I", "literal"],
                   directory, **environment), expected)
    print("passed attached/separate -I, prepending, transitive imports, literal argv, and --", flush=True)


def check_option_errors(interpreter, directory, **environment):
    temporary = directory / "option-temporaries"
    temporary.mkdir()
    cases = [([], "usage:"), (["-I"], "option requires an argument"),
             (["-Isrc"], "usage:"), (["-I", "src"], "usage:"),
             (["--"], "usage:"), (["-Isrc", "--"], "usage:"),
             (["-Z"], "unknown option")]
    for arguments, diagnostic in cases:
        result = invoke([interpreter, *arguments], directory, TMPDIR=str(temporary), **environment)
        if (result.returncode == 0 or diagnostic not in result.stderr or
                "usage: snail-scheme [-I DIRECTORY ...]" not in result.stderr):
            raise RuntimeError(f"missing interpreter option diagnostic: {result}")
    if list(temporary.iterdir()):
        raise RuntimeError("invalid options created compilation intermediates")
    print("passed missing script, missing -I directory, and unknown option diagnostics", flush=True)


def check_application_options(interpreter, directory, **environment):
    source = ROOT / "tests/programs/backend-options.scm"
    arguments = ["--verbose", "-o", "", "--output=a=b", "-I", "--", "file", "-v", ""]
    expected = ('(("--verbose" . #t) ("-o" . "") ("--output" . "a=b") ("-I" . "--"))\n'
                '("file" "-v" "")\n')
    require(invoke([interpreter, source, *arguments], directory, **environment), expected)
    for arguments, diagnostic in ((["--output"], "option requires an argument"),
                                  (["--verbose="], "option does not take an argument"),
                                  (["--unknown"], "unknown option")):
        result = invoke([interpreter, source, *arguments], directory, **environment)
        if result.returncode == 0 or diagnostic not in result.stderr or "usage: options-demo" not in result.stderr:
            raise RuntimeError(f"missing application option diagnostic: {result}")
    print("passed reusable options library in an ordinary native application", flush=True)


# ---- Failed publication and self-hosted replacement ----


def check_failed_build(interpreter, directory, **environment):
    output = directory / "keep-output"
    output.write_text("last successful artifact")
    source = write_script(directory, "broken.scm", "(")
    build = write_script(directory, "failed-build.scm", '(import (scheme base) (snail-scheme native))\n' +
                         f'(build-native {quote(ROOT)} {quote(source)} {quote(output)})\n')
    result = invoke([interpreter, build], **environment)
    if result.returncode == 0 or output.read_text() != "last successful artifact":
        raise RuntimeError(f"failed build replaced output: {result}")
    retained = [Path(path) for path in re.findall(r"build failed; intermediates retained: (.+)", result.stderr)]
    if len(retained) != 1 or not retained[0].is_dir() or retained[0].parent != directory:
        raise RuntimeError(f"failure did not retain one build workspace: {result.stderr}")
    # All reported paths belong to this test invocation, never to another build.
    shutil.rmtree(retained[0])
    print("passed failed-build publication and retained diagnostics", flush=True)


def check_self_host(interpreter, directory):
    blocked = write_script(directory, "blocked-chibi", '#!/bin/sh\necho unexpected-Chibi >&2\nexit 99\n')
    blocked.chmod(0o755)
    tools = directory / "tools"
    tools.mkdir()
    (tools / "chibi-scheme").symlink_to(blocked)
    environment = {"CHIBI": str(blocked), "PATH": str(tools) + os.pathsep + os.environ["PATH"]}
    replacement = directory / "rebuilt-snail-scheme"
    require(invoke([interpreter, "-Isrc", ROOT / "build.scm", replacement], **environment))
    require_native(replacement)
    check_script(replacement, directory, **environment)
    check_library_options(replacement, directory, **environment)
    check_option_errors(replacement, directory, **environment)
    check_application_options(replacement, directory, **environment)
    check_failed_build(replacement, directory, **environment)
    print("passed native compiler self-hosting with Chibi unavailable", flush=True)


# ---- Test entry point ----


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--interpreter", type=Path, help="reuse an already bootstrapped executable")
    options = parser.parse_args()
    BUILD.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="paths with spaces ", dir=BUILD) as name:
        directory = Path(name)
        check_entry(directory)
        interpreter = options.interpreter.resolve() if options.interpreter else directory / "snail-scheme"
        if not options.interpreter:
            require(invoke([os.environ.get("CHIBI", "chibi-scheme"), "-I", ROOT / "src", ROOT / "build.scm", interpreter]))
        require_native(interpreter)
        check_self_host(interpreter, directory)
    print("native self-hosting checks passed")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f"self-host test failed: {error}", file=sys.stderr)
        sys.exit(1)
