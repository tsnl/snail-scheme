#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
output=${UI_TEST_OUTPUT:-"$root/build/ui-tests"}
mkdir -p "$output"
chibi-scheme -I "$root/bootstrap" "$root/apps/ui-lab/build.scm" "$root" "$output/lab"
chibi-scheme -I "$root/bootstrap" "$root/tests/applications/build.scm" "$root" \
  "$root/tests/ui/layout.sld" "$output/layout.wasm"
if chibi-scheme -I "$root/bootstrap" "$root/tests/applications/build.scm" "$root" \
  "$root/tests/ui/reject-owner.sld" "$output/reject-owner.wasm" >"$output/reject-owner.log" 2>&1; then
  echo 'Expected the UI request owner mismatch to fail compilation' >&2
  exit 1
fi
rg -q 'type mismatch|cannot unify' "$output/reject-owner.log"
node "$root/tests/ui/bridge.mjs"
node "$root/tests/ui/runtime.mjs" "$output"
