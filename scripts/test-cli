#!/usr/bin/env python3
"""Exercise portable compilation, publication, literal arguments and Rust AWI."""

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build/cli-tests"
CARGO = BUILD / "cargo"
DRIVER = CARGO / "debug/snail-scheme"
ARGUMENTS = ["space in argument", "", "--help"]
EXPECTED = '("space in argument" "" "--help")\n'
SOURCE = '(import (scheme base) (scheme write) (scheme process-context))\n(write (cdr (command-line))) (newline)\n'


# ---- Test commands and traces ----


def invoke(command, cwd, **environment):
    return subprocess.run([str(arg) for arg in command], cwd=cwd, text=True,
                          capture_output=True, check=False, timeout=240,
                          env={**os.environ, **environment})


def require(result, stdout=None, code=0, diagnostic=None):
    if (result.returncode != code or (stdout is not None and result.stdout != stdout)
            or (diagnostic is not None and diagnostic not in result.stderr)):
        raise RuntimeError(f"exit={result.returncode}\nstdout={result.stdout!r}\n"
                           f"stderr={result.stderr!r}")
    return result


def cli(directory, *arguments, **environment):
    return invoke([DRIVER, *arguments], directory, **environment)


def trace_names(directory):
    names = set()
    for path in directory.glob("*.json"):
        lanes, previous = {}, {}
        for event in json.loads(path.read_text()):
            lane = (event["pid"], event["tid"])
            stack = lanes.setdefault(lane, [])
            if event["ts"] < previous.get(lane, 0):
                raise RuntimeError(f"trace clock went backwards: {path}")
            previous[lane] = event["ts"]
            if event["ph"] == "B":
                names.add(event["name"])
                stack.append(event["name"])
            elif event["ph"] == "E" and stack:
                stack.pop()
            else:
                raise RuntimeError(f"unmatched trace event: {event}")
        if any(lanes.values()):
            raise RuntimeError(f"unfinished trace spans: {path}")
    return names


# ---- Portable output and extension modules ----


def check_modes(directory, source):
    require(cli(directory, source, "--", *ARGUMENTS), EXPECTED)
    output = directory / "portable program.wasm"
    require(cli(directory, source, "-o", output), "")
    if not output.read_bytes().startswith(b"\0asm"):
        raise RuntimeError("output must be a WebAssembly module")
    command = [os.environ.get("NODE", "node"), "--no-warnings", ROOT / "scripts/run-wasi.mjs"]
    require(invoke([*command, output, *ARGUMENTS], directory), EXPECTED)
    expected = {"driver.execute", "driver.cargo-build", "driver.link-wasm", "driver.run",
                "source-file->wasm-file", "syntax-list->ir-library"}
    names = trace_names(directory / "build/traces")
    if not expected <= names:
        raise RuntimeError(f"missing trace spans: {expected - names}")
    if os.environ.get("SNAIL_WASM_NATIVE"):
        native = directory / "native program"
        require(cli(directory, source, "--native", "-o", native), "")
        require(invoke([native, *ARGUMENTS], directory), EXPECTED)


def check_emission(directory, source):
    result = require(cli(directory, source, "--emit-wat", CARGO="/nonexistent/snail-cargo"))
    if '(export "snail_main")' not in result.stdout:
        raise RuntimeError("WAT entry point missing")
    require(cli(directory, source, "--emit-wat", "-o", "--help"), "")
    if (directory / "--help").read_text() != result.stdout:
        raise RuntimeError("an output value was parsed as a flag")


def check_extension(directory):
    expected = '42\n("a Scheme pair retained by Rust" . 42)\n(14 . 42)\n42\n'
    result = cli(directory, ROOT / "examples/extension.scm",
                 "--extension", ROOT / "examples/extension", "--keep-build")
    require(result, expected)
    project = retained_project(result)
    command = [os.environ.get("NODE", "node"), "--no-warnings",
               ROOT / "tests/check-awi-roots.mjs", project / "program.wasm", "3"]
    require(invoke(command, directory), expected)
    shutil.rmtree(project)



def check_trace_decorator(directory):
    source = directory / "traced.scm"
    source.write_text(r'''(import (scheme base) (scheme write) (snail-scheme trace))
(define-traced (several first . rest) (apply values (cons first rest)))
(define-traced (none) (values))
(call-with-trace "quote\" slash\\ newline\nλ"
  (lambda ()
    (write (call-with-values (lambda () (several 1 2)) list)) (newline)
    (write (call-with-values none list)) (newline)))
''')
    with tempfile.TemporaryDirectory(prefix="external traces ") as name:
        traces = Path(name)
        require(cli(directory, source, SNAIL_TRACE_DIR=str(traces)), "(1 2)\n()\n")
        expected = {"several", "none", 'quote" slash\\ newline\nλ'}
        if not expected <= trace_names(traces):
            raise RuntimeError("decorator spans or external trace destination missing")


def check_failures(directory, source):
    require(cli(directory, source, "--emit-llvm"), "", 1, "retired")
    require(cli(directory, source, "--timing"), "", 1, "unknown option")
    require(cli(directory, source, "-o", source), "", 1, "must not replace")
    require(cli(directory, source, "-o", "unused", "--", "arg"), "", 1, "run mode")
    alias = directory / "source-link"
    alias.symlink_to(source)
    require(cli(directory, source, "-o", alias), "", 1, "must not replace")
    exiting = directory / "exit.scm"
    exiting.write_text('(import (scheme process-context)) (exit 7)\n')
    require(cli(directory, exiting), "", 7)
    unsupported = directory / "callcc.scm"
    unsupported.write_text('(import (scheme base)) (call/cc (lambda (k) (k 1)))\n')
    require(cli(directory, unsupported), "", 1, "call/cc is not supported")


def check_preserved_outputs(directory, source):
    broken, output = directory / "broken.scm", directory / "existing.wasm"
    broken.write_text("(\n")
    output.write_text("previous successful build")
    require(cli(directory, broken, "-o", output), "", 1)
    require(cli(directory, source, "-o", output, CARGO="/nonexistent/snail-cargo"), "", 1)
    if output.read_text() != "previous successful build":
        raise RuntimeError("failed compilation replaced an existing artifact")


def check_kept_project(directory, source):
    result = require(cli(directory, source, "--keep-build", "--emit-wat", "-o", "kept.wat"), "")
    project = retained_project(result)
    if not project.is_dir() or project.parent != ROOT / "build/cli":
        raise RuntimeError(f"invalid retained project: {project}")
    shutil.rmtree(project)



def retained_project(result):
    paths = [line.removeprefix("build project: ") for line in result.stderr.splitlines()
             if line.startswith("build project: ")]
    if len(paths) != 1:
        raise RuntimeError("retained project path missing")
    return Path(paths[0])


def main():
    BUILD.mkdir(parents=True, exist_ok=True)
    require(invoke(["cargo", "build", "--offline", "--quiet", "-p", "snail-driver",
                    "--target-dir", CARGO], ROOT), "")
    with tempfile.TemporaryDirectory(prefix="paths with spaces ", dir=BUILD) as name:
        directory = Path(name)
        source = directory / "quoted 'source.scm"
        source.write_text(SOURCE)
        check_modes(directory, source)
        check_emission(directory, source)
        check_extension(directory)
        check_trace_decorator(directory)
        check_failures(directory, source)
        check_preserved_outputs(directory, source)
        check_kept_project(directory, source)
    print("Wasm CLI and Rust AWI checks passed")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f"CLI test failed: {error}", file=sys.stderr)
        sys.exit(1)
