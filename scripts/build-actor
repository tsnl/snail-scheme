#!/usr/bin/env python3
"""Build a Scheme library for isolated Node actors with the current Wasm ABI."""

import argparse
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path)
    parser.add_argument("output", type=Path)
    options = parser.parse_args()
    options.output.resolve().parent.mkdir(parents=True, exist_ok=True)
    subprocess.run([os.environ.get("CHIBI", "chibi-scheme"), "-I", ROOT / "src",
                    ROOT / "scripts/build-actor.scm", ROOT, options.source.resolve(),
                    options.output.resolve()], check=True)


if __name__ == "__main__":
    main()
