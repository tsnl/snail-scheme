#!/usr/bin/env python3
"""Link SFIR native imports and exports to matching and mismatched Wasm functions."""

import json
import os
from pathlib import Path
import re
import runpy
import sys

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / "tests/sfir-extern"
OUTPUT = ROOT / "build/sfir-extern"
SUPPORT = runpy.run_path(str(ROOT / 'scripts/test-sfir-integration'))


# ---- Compile once, execute raw and optimized boundaries ----


def invoke(command, log):
    return SUPPORT['invoke'](command, ROOT, log)


def check(case, provider):
    source = FIXTURES / (case.get("source", case["name"]) + ".sfir")
    artifact = OUTPUT / (case["name"] + ".wasm")
    exports = [word for name in case.get("exports", []) for word in ("--export", name)]
    compiled = invoke([ROOT / "scripts/build-sfir", *exports, source, artifact],
                      OUTPUT / (case["name"] + "-compile.json"))
    if "error" in case:
        lines = (compiled['stdout'] + compiled['stderr']).splitlines()
        located = [line for line in lines if not case.get('located', True)
                   or re.search(re.escape(source.name) + r':\d+:\d+:', line)]
        return (compiled['status'] > 0 and not compiled['timeout']
                and not compiled['executing_descendants']
                and any(re.search(case['error'], line) for line in located))
    if not completed(compiled):
        return False
    node = [os.environ.get("NODE", "node"), *(["--expose-gc"] if case.get("gc") else [])]
    results = [invoke([*node, FIXTURES / "run.mjs", provider,
                       str(artifact) + suffix, case["name"]], OUTPUT / (case["name"] + suffix + "-run.json"))
               for suffix in (".raw.wasm", "")]
    return all(completed(result) for result in results)


def completed(result):
    return result['status'] == 0 and not result['timeout'] and not result['executing_descendants']


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    provider = OUTPUT / "provider.wasm"
    assembled = invoke([os.environ.get("WASM_AS", "wasm-as"), FIXTURES / "provider.wat", "-o", provider],
                       OUTPUT / "provider-assemble.json")
    if not completed(assembled):
        raise SystemExit(assembled['stderr'])
    cases = json.loads((FIXTURES / "cases.json").read_text())
    results = []
    for case in cases:
        result = dict(name=case["name"], passed=check(case, provider))
        results.append(result)
        (OUTPUT / "results.json").write_text(json.dumps(results, indent=2) + "\n")
        print(("PASS" if result["passed"] else "FAIL") + " " + result["name"], flush=True)
    passed = sum(result["passed"] for result in results)
    print(f"Passed {passed}/{len(results)} native boundary contracts")
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
