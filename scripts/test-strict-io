#!/usr/bin/env python3
"""Execute linked strict text-file operations against real Node/WASI files."""

import json
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / 'build/strict-io'
EXPORTS = ['format-number', 'unicode', 'callback-result', 'exists', 'remove', 'close-alias',
           'callback-close', 'escaped-alias', 'missing-directory', 'nul-path', 'delete-absent',
           'callback-trap', 'close-failure', 'invalid-character', 'invalid-handle', 'interrupted-path']


# ---- Compile one fixture, then execute both retained compiler forms ----


def run(command, label):
    result = subprocess.run(list(map(str, command)), cwd=ROOT, text=True, capture_output=True, timeout=300)
    (OUTPUT / (label + '.json')).write_text(json.dumps(dict(command=list(map(str, command)),
        status=result.returncode, stdout=result.stdout, stderr=result.stderr), indent=2) + '\n')
    if result.returncode:
        raise SystemExit(result.stdout + result.stderr)


def check_form(source, label, runtime, contract):
    linked = OUTPUT / (label + '.wasm')
    flags = ['--raw'] if label.endswith('-raw') else []
    run([ROOT / 'scripts/link-strict-runtime', '--runtime', runtime, *flags, source, linked], label + '-link')
    files = tempfile.mkdtemp(prefix=label + '-', dir=OUTPUT)
    run([os.environ.get('NODE', 'node'), ROOT / 'tests/strict-io/run.mjs', linked, files, contract], label + '-run')
    print('PASS strict text output ' + label, flush=True)


def check_fixture(name, runtime):
    source = OUTPUT / (name + '.wasm')
    exports = [word for export in EXPORTS for word in ('--export', export)] if name == 'output' else []
    run([ROOT / 'scripts/build-strict', *exports, ROOT / 'tests/strict-io' / (name + '.scm'), source], name + '-compile')
    check_form(Path(str(source) + '.raw.wasm'), name + '-raw', runtime, name)
    check_form(source, name + '-optimized', runtime, name)


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    run([os.environ.get('CARGO', 'cargo'), 'rustc', '--crate-type=cdylib', '--quiet', '--offline',
         '--release', '--target', 'wasm32-wasip1', '--target-dir', ROOT / 'build/wasm-runtime'], 'runtime')
    runtime = ROOT / 'build/wasm-runtime/wasm32-wasip1/release/snail_runtime.wasm'
    check_fixture('output', runtime)
    check_fixture('main-trap', runtime)


if __name__ == '__main__':
    main()
