#!/usr/bin/env python3
"""Execute shared scalar trigonometry in linked Wasm and the native backend."""

import json
import math
import os
from pathlib import Path
import subprocess
import time

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / 'build' / f'sfir-math-{time.time_ns()}'
INPUTS = ['-Infinity', '-1e300', '-1000', '-3.141592653589793', '-1.5707963267948966',
          '-1', '-0.5', '-2.2250738585072014e-308', '-5e-324', '-0', '0', '5e-324',
          '2.2250738585072014e-308', '0.5', '1', '1.5707963267948966',
          '3.141592653589793', '1000', '1e300', 'Infinity', 'NaN']


# ---- Retain failed attempts and compare values independently of the fixture ----

def run(command, label):
    command = list(map(str, command))
    result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, timeout=300,
                            env={**os.environ, 'BINARYEN_CORES': '1'})
    (OUTPUT / (label + '.json')).write_text(json.dumps(dict(command=command,
        status=result.returncode, stdout=result.stdout, stderr=result.stderr), indent=2) + '\n')
    if result.returncode or result.stderr:
        raise RuntimeError(result.stdout + result.stderr)
    return result.stdout


def expected_values():
    expected = []
    for source in INPUTS:
        for operation in (math.sin, math.cos, math.atan):
            try:
                expected.append(operation(float(source)))
            except ValueError:
                expected.append(math.nan)
    return expected


def check_values(output):
    actual, expected = list(map(float, output.splitlines())), expected_values()
    assert len(actual) == len(expected)
    for value, target in zip(actual, expected):
        if math.isnan(target):
            assert math.isnan(value)
        elif target == 0.0:
            assert value == 0.0 and math.copysign(1.0, value) == math.copysign(1.0, target)
        else:
            assert math.isfinite(value) and math.isclose(value, target, rel_tol=2e-15, abs_tol=0.0)


# ---- Both retained Wasm forms and the actual native C ABI ----

def check_wasm(source):
    runtime = ROOT / 'build/wasm-runtime/wasm32-wasip1/release/snail_runtime.wasm'
    run([os.environ.get('CARGO', 'cargo'), 'rustc', '--crate-type=cdylib', '--quiet', '--offline',
         '--release', '--target', 'wasm32-wasip1', '--target-dir', ROOT / 'build/wasm-runtime'], 'runtime')
    for suffix, flags in [('', []), ('.raw.wasm', ['--diagnostic-prune-only'])]:
        label = 'raw' if suffix else 'optimized'
        linked = OUTPUT / (label + '.wasm')
        run([ROOT / 'scripts/link-sfir-runtime', '--runtime', runtime, *flags,
             Path(str(source) + suffix), linked], label + '-link')
        check_values(run([os.environ.get('NODE', 'node'), '--disable-warning=ExperimentalWarning',
                          ROOT / 'tests/sfir-math.mjs', linked, *INPUTS], label + '-run'))


def main():
    OUTPUT.mkdir(parents=True)
    source = OUTPUT / 'sfir.wasm'
    run([ROOT / 'scripts/build-sfir', '--export', 'trigonometry', ROOT / 'tests/sfir-math.sfir', source], 'compile')
    check_wasm(source)
    native = OUTPUT / 'native'
    run([ROOT / 'scripts/build-native', '--wasm', '--entry-c', ROOT / 'tests/native-math.c', source, native], 'native-build')
    check_values(run([native, *INPUTS], 'native-run'))
    print(f'PASS {len(INPUTS) * 3} scalar trigonometry cases on raw/optimized linked Wasm and native: {OUTPUT}')


if __name__ == '__main__':
    main()
