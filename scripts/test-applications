#!/bin/sh
# Compiler/runtime regressions for the new shared libraries, not a benchmark.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
output="$root/build/application-tests"
mkdir -p "$output"
node "$root/tests/applications/save-service.mjs"
chibi-scheme -I "$root/bootstrap" \
  "$root/apps/siegework/build.scm" "$root" "$output/siegework"
for fixture in counter state testing counter-lofi immutable terrain pacing-probe invalid-output invalid-candidate invalid-initial invalid-state async-boundary async-view snapshot-cache browser-effects shader shader-lofi; do
  case "$fixture" in
    counter|state|testing) source="$root/examples/applications/$fixture.sld" ;;
    *) source="$root/tests/applications/$fixture.sld" ;;
  esac
  chibi-scheme -I "$root/bootstrap" \
    "$root/tests/applications/build.scm" "$root" "$source" "$output/$fixture.wasm" "$root/apps/siegework/src" "$root/tests/applications"
done
for fixture in reject-state reject-payload reject-owner; do
  if chibi-scheme -I "$root/bootstrap" \
    "$root/tests/applications/build.scm" "$root" "$root/tests/applications/$fixture.sld" \
    "$output/$fixture.wasm" "$root/apps/siegework/src" >"$output/$fixture.log" 2>&1; then
    printf 'Expected compile rejection: %s\n' "$fixture" >&2
    exit 1
  fi
  if ! rg -q 'type mismatch|cannot unify' "$output/$fixture.log"; then
    cat "$output/$fixture.log" >&2
    exit 1
  fi
  printf 'ok - compile rejects %s\n' "$fixture"
done
node "$root/tests/applications/runtime.mjs" "$output/siegework/solo" "$output" "$output/siegework"
node "$root/tests/applications/recording.mjs" "$output/siegework/solo"
node "$root/tests/applications/headless.mjs" "$output/siegework/solo"
node "$root/tests/draw3d/playtest.mjs" "$output/siegework/solo"
node "$root/tests/draw3d/colony.mjs" "$output/siegework/solo"
node "$root/tests/draw3d/onboarding.mjs" "$output/siegework/solo"
node "$root/tests/applications/colony-pacing.mjs" "$output/siegework/solo" "$output/pacing-probe.wasm" "$output/pacing-report.json"
"$root/scripts/max-dps-test" --output "$output/max-dps-report.json"
