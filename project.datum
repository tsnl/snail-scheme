((build-target siegework
               (browser
                (entry ((apps siegework application) Siegework))
                (library-roots ("src"))
                (public "src/apps/siegework/public")))
 (build-target hearsay
               (browser
                (entry ((apps hearsay application) Hearsay))
                (library-roots ("src"))
                (public "src/apps/hearsay/public")))
 (build-target highlight-book
               (program
                (entry "tools/highlight-book.sld"))))
