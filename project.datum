((build-target siegework
               (browser
                (entry ((siegework application) Siegework))
                (library-roots ("apps/siegework/src"))
                (public "apps/siegework/public")))
 (build-target hearsay
               (browser
                (entry ((hearsay application) Hearsay))
                (library-roots ("apps/hearsay/src"))
                (public "apps/hearsay/public"))))
