#!/usr/bin/env python3
"""Compile or run SFIR with WasmGC or the 64-bit native backend."""

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent


# ---- Command requests ----


def request(arguments):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='action', required=True)
    for action in ('compile', 'run'):
        command = commands.add_parser(action)
        command.add_argument('--target', choices=('wasm', 'native'), default='wasm')
        command.add_argument('-I', '--library', action='append', default=[], type=Path, metavar='DIR')
        command.add_argument('--generation-provider', type=Path, metavar='MODULE',
                             help='ES module providing foreign services to library generators')
        if action == 'compile':
            command.add_argument('-o', '--output', required=True, type=Path)
        command.add_argument('source', type=Path)
        if action == 'run':
            command.add_argument('arguments', nargs=argparse.REMAINDER)
    return parser.parse_args(arguments)


def check_destination(options):
    if options.action != 'compile':
        return
    output = options.output.resolve()
    inputs = (options.source.resolve(), Path(__file__).resolve())
    if options.generation_provider:
        inputs += (options.generation_provider.resolve(),)
    directories = (ROOT / 'src', ROOT / 'lib', ROOT / 'scripts', *options.library)
    if output in inputs or any(output.is_relative_to(path.resolve()) for path in directories):
        raise ValueError('compile output must not replace compiler or library inputs')


# ---- Build privately, then publish or run ----


def build(options, directory):
    libraries = [item for path in options.library for item in ('-I', str(path.resolve()))]
    if options.generation_provider:
        libraries += ['--generation-provider', str(options.generation_provider.resolve())]
    source = options.source.resolve()
    if options.target == 'native':
        artifact = directory / 'program'
        subprocess.run([ROOT / 'scripts/build-native', *libraries, source, artifact], check=True)
    else:
        artifact, module = directory / 'program.wasm', directory / 'module.wasm'
        subprocess.run([ROOT / 'scripts/build-sfir', '--command', *libraries, source, module], check=True)
        subprocess.run([ROOT / 'scripts/link-sfir-runtime', module, artifact], check=True)
    return artifact


def execute(options, artifact):
    command = [artifact] if options.target == 'native' else [
        os.environ.get('NODE', 'node'), ROOT / 'scripts/run-sfir.mjs', artifact]
    return subprocess.run([*command, *options.arguments]).returncode


def perform(options):
    check_destination(options)
    parent = options.output.absolute().parent if options.action == 'compile' else ROOT / 'build/sfir-runs'
    parent.mkdir(parents=True, exist_ok=True)
    directory = Path(tempfile.mkdtemp(prefix='.snail-sfir-', dir=parent))
    try:
        artifact = build(options, directory)
        if options.action == 'compile':
            os.replace(artifact, options.output.absolute())
            status = 0
        else:
            status = execute(options, artifact)
    except (OSError, subprocess.CalledProcessError):
        print(f'build evidence retained at {directory}', file=sys.stderr)
        raise
    shutil.rmtree(directory)
    return status


if __name__ == '__main__':
    try:
        sys.exit(perform(request(sys.argv[1:])))
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f'snail-sfir: {error}')
