;; These controls execute the unchanged upstream collection and call/cc bodies.
;; Expected observations are stated independently of the typed storage helpers.

;; ---- Shared tails and occurrence semantics ----

(define (original-collection-check valid message)
  (unless valid (error 'compiler-collections message)))
(define (original-position-and-zip)
  (let* ((values (list 3 7 3)) (right (list "a" "b" "unused"))
         (rows (pair-up (list 1 2) right)))
    (set-cdr! (car rows) "changed")
    (and (= (pos-in-list 3 values) 0) (= (pos-in-list 7 values) 1)
         (not (pos-in-list 5 values)) (eq? (nth-after values -2) values)
         (equal? rows '((1 . "changed") (2 . "b")))
         (equal? right '("a" "b" "unused"))
         (null? (pair-up '() right)))))
(define (original-sort)
  (let* ((trace 0) (input (list 1 2 3 4))
         (output (sort-list input
                            (lambda (a b) (set! trace (+ (* 100 trace) (* 10 a) b)) #f)))
         (ascending (list 1 2 3)) (sorted (sort-list ascending <)))
    (and (= trace 13243432) (equal? output '(4 2 3 1)) (equal? input '(1 2 3 4))
         (eq? (my-last-pair sorted) (my-last-pair ascending))
         (not (eq? sorted ascending))
         (eq? (sort-list (my-last-pair ascending) <) (my-last-pair ascending)))))
(define (original-occurrences)
  (let* ((left (list 1 1)) (right (list 2)) (joined (set-union left right))
         (present (list 1)) (last (list 1 3)))
    (and (equal? joined '(1 1 2)) (eq? (cddr joined) right)
         (eq? (set-union left present) present) (eq? (set-union left) left)
         (equal? (set-union left right last) '(2 1 3))
         (not (set-equal? '(1 1) '(1 2))) (set-equal? '(1 2 1) '(1 1 2)))))
(define (original-removal)
  (let* ((input (list 1 2 3 4)) (hit (set-remove input 2)) (miss (set-remove input 8)))
    (and (equal? hit '(1 3 4)) (eq? (cdr hit) (cddr input)) (not (eq? hit input))
         (equal? miss input) (not (eq? miss input))
         (not (eq? (my-last-pair miss) (my-last-pair input)))
         (eq? (set-remove input 1) (cdr input)) (eq? (set-member? 2 input) (cdr input))
         (eq? (set-adjoin input 2) input) (eq? (cdr (set-adjoin input 5)) input))))
(define (original-folds-and-conversion)
  (let* ((input (list 1 2 1 3)) (array (lst->vector input)) (copy (vector->lst array)))
    (vector-set! array 1 9)
    (and (equal? (set-difference input '(1)) '(2 3))
         (equal? (set-intersection input '(1)) '(1 1)) (eq? (set-intersection input) input)
         (equal? copy input) (not (eq? copy input)) (= (vector-ref array 1) 9)
         (= (vector-length (lst->vector '())) 0)
         (string=? (lst->string (string->lst "abλ")) "abλ"))))

;; ---- Dependency closure keeps old rounds and fresh wrapper identity ----

(define (original-graphs)
  (let* ((first (make-gnode 1 '(2 3)))
         (graph (list first (make-gnode 2 '(4)) (make-gnode 3 '(4)) (make-gnode 4 '())))
         (closed (transitive-closure graph)))
    (and (equal? (gnode-edges (car closed)) '(2 3 4))
         (equal? (gnode-edges first) '(2 3)) (not (eq? first (car closed)))
         (equal? (topological-sort closed) '((4) (2 3) (1))))))
(define (original-cycle)
  (let* ((graph (list (make-gnode 1 '(2)) (make-gnode 2 '(1))
                      (make-gnode 3 '()) (make-gnode 4 '(1))))
         (closed (transitive-closure graph)))
    (and (equal? (gnode-edges (car closed)) '(2 1))
         (equal? (topological-sort closed) '((3) (1 2) (4))))))
(define (original-duplicate-labels)
  (let* ((first (make-gnode 1 '(2 2))) (second (make-gnode 1 '()))
         (graph (list first second (make-gnode 2 '()))) (closed (transitive-closure graph)))
    (and (not (eq? first second)) (eq? (gnode-find 1 graph) first)
         (= (length (gnode-edges (car closed))) 2) (not (eq? second (cadr closed)))
         (equal? (topological-sort closed) '((1 2) (1))))))

;; ---- Stored queue tails can become detached through another alias ----

(define (original-queue-sharing)
  (let* ((input (list 1 2)) (queue (list->queue input)))
    (and (= (queue-put! queue 3) 3) (= (queue-get! queue) 1)
         (equal? input '(1 2 3)) (eq? (queue->list queue) (cdr input))
         (eq? (cdr queue) (my-last-pair input)))))
(define (original-queue-overwrite)
  (let* ((input (list 1)) (first (list->queue input)) (second (list->queue input)))
    (queue-put! first 2)
    (let ((detached (cdr first)))
      (queue-put! second 3)
      (queue-put! first 4)
      (and (equal? input '(1 3)) (equal? detached '(2 4))
           (= (car (cdr first)) 4) (= (car (cdr second)) 3)))))
(define (original-queue-final)
  (let ((queue (queue-empty)))
    (and (= (queue-put! queue 1) 1) (= (queue-get! queue) 1)
         (queue-empty? queue) (null? (cdr queue))
         (= (queue-put! queue 2) 2) (= (car (queue->list queue)) 2))))

;; ---- Original continuation escapes preserve earlier mutations ----

(define (original-counter)
  (let* ((limits 0)
         (counter (make-counter 4 5 (lambda () (set! limits (+ limits 1)) (compiler-abort)))))
    (and (= (counter) 4) (not (with-exception-handling (lambda () (counter) #t)))
         (= limits 1))))
(define (original-filter-abort)
  (let* ((input (list 1 2 3)) (trace 0)
         (finished
          (with-exception-handling
           (lambda ()
             (set-keep (lambda (value)
                         (set! trace (+ (* 10 trace) value))
                         (when (= value 2) (set-cdr! input (list 9)) (compiler-abort))
                         #t)
                       input)
             (set! trace 999) #t))))
    (and (not finished) (= trace 12) (equal? input '(1 9)))))
(define (original-queue-abort)
  (let* ((queue (queue-empty)) (marker 0)
         (finished (with-exception-handling
                    (lambda ()
                      (queue-put! queue 7) (set! marker (queue-get! queue))
                      (queue-get! queue) (set! marker 999) #t))))
    (and (not finished) (= marker 7) (queue-empty? queue) (null? (cdr queue)))))

(begin
  (original-collection-check (original-position-and-zip) "positions and dotted rows")
  (original-collection-check (original-sort) "sort order and sharing")
  (original-collection-check (original-occurrences) "set occurrences")
  (original-collection-check (original-removal) "removal sharing")
  (original-collection-check (original-folds-and-conversion) "folds and conversions")
  (original-collection-check (original-graphs) "dependency diamond")
  (original-collection-check (original-cycle) "dependency cycle")
  (original-collection-check (original-duplicate-labels) "duplicate graph labels")
  (original-collection-check (original-queue-sharing) "queue sharing")
  (original-collection-check (original-queue-overwrite) "queue stored-tail overwrite")
  (original-collection-check (original-queue-final) "final dequeue clears tail")
  (original-collection-check (original-counter) "counter limit abort")
  (original-collection-check (original-filter-abort) "filter abort after mutation")
  (original-collection-check (original-queue-abort) "queue abort after mutation")
  42)
