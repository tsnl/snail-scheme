;; This observes the new representations only. It is not a compiler workload
;; result, performance control, or substitute for the complete 497-line oracle.

;; ---- Mutable spine sharing and callback order ----

(define (probe-list-sharing)
  (let* ((tail (compiler-list 20)) (first (compiler-cons 10 tail))
         (copy (compiler-append first tail)) (alias first))
    (compiler-set-car! first 11)
    (compiler-set-car! tail 21)
    (and (= (compiler-car alias) 11) (= (compiler-car copy) 10)
         (= (compiler-car (compiler-cdr copy)) 20)
         (compiler-list-eq? (compiler-cdr (compiler-cdr copy)) tail)
         (= (compiler-car (compiler-cdr (compiler-cdr copy))) 21)
         (not (compiler-list-eq? first copy)))))
(define (probe-list-cycle)
  (let* ((first (compiler-list 1 2)) (last (compiler-cdr first)))
    (compiler-set-cdr! last first)
    (compiler-set-car! last 9)
    (and (compiler-list-eq? (compiler-cdr last) first)
         (= (compiler-car (compiler-cdr (compiler-cdr (compiler-cdr first)))) 9)
         (compiler-list-eq? (ann (compiler-empty) (CompilerList I64)) (compiler-empty)))))
(define (probe-list-order)
  (let* ((trace (ref 0))
         (result (compiler-map
                   (lambda (value) (ref-set! trace (+ (* 10 (ref-get trace)) value)) (* 2 value))
                   (compiler-list 1 2 3))))
    (and (= (ref-get trace) 123)
         (begin (ref-set! trace 0)
                (compiler-for-each (lambda (value) (ref-set! trace (+ (* 10 (ref-get trace)) value))) result)
                (= (ref-get trace) 246)))))
(define (probe-association-alias)
  (let* ((entry (compiler-make-pair 1 #f)) (alias entry))
    (compiler-pair-first-set! entry 2)
    (compiler-pair-rest-set! alias #t)
    (and (= (compiler-pair-first alias) 2) (compiler-pair-rest entry))))
(define (probe-map-tail-mutation)
  (let* ((input (compiler-list 1 2 3)) (old-tail (compiler-cdr input))
         (replacement (compiler-list 4 5)) (trace (ref 0))
         (output (compiler-map
                   (lambda (value)
                     (ref-set! trace (+ (* 10 (ref-get trace)) value))
                     (when (= value 1) (compiler-set-cdr! input replacement))
                     value)
                   input)))
    (and (= (ref-get trace) 145) (= (compiler-car old-tail) 2)
         (= (compiler-car (compiler-cdr old-tail)) 3)
         (compiler-list-eq? (compiler-cdr input) replacement)
         (not (compiler-list-eq? output input))
         (not (compiler-list-eq? (compiler-cdr output) replacement)))))

;; ---- Parent and cache updates preserve the source mutation contract ----

(define (probe-environment)
  (compiler-environment (ref (compiler-empty)) (compiler-empty) (compiler-empty) (compiler-none)))
(define (probe-node environment)
  (compiler-make-node (compiler-test-case) (compiler-none) (compiler-empty)
                      (compiler-free-valid (compiler-empty)) environment (compiler-none)))
(define (probe-invalid-free? node)
  (match (ref-get (compiler-node-free-cell node))
    ((compiler-free-invalid) #t) ((compiler-free-valid variables) #f)))
(define (probe-parent? child parent)
  (match (ref-get (compiler-node-parent-cell child))
    ((compiler-none) #f) ((compiler-some actual) (compiler-node-eq? actual parent))))
(define (probe-node-updates)
  (let* ((environment (probe-environment)) (root (probe-node environment))
         (middle (probe-node environment)) (old (probe-node environment))
         (fresh (probe-node environment)))
    (ref-set! (compiler-node-parent-cell middle) (compiler-some root))
    (ref-set! (compiler-node-parent-cell old) (compiler-some middle))
    (ref-set! (compiler-node-children-cell middle) (compiler-list old))
    (compiler-node-children-set! middle (compiler-list fresh))
    (and (probe-parent? fresh middle) (probe-parent? old middle)
         (probe-invalid-free? root) (probe-invalid-free? middle)
         (not (probe-invalid-free? fresh)) (not (probe-invalid-free? old)))))
(define (probe-environment-sharing)
  (let* ((first (probe-environment))
         (second (compiler-environment (compiler-environment-variable-cell first)
                                        (compiler-empty) (compiler-list (datum-boolean #t))
                                        (compiler-environment-parent first)))
         (variable (compiler-make-variable (compiler-anonymous-variable) (compiler-temporary-binding)
                                           (compiler-empty) (compiler-empty) (compiler-none))))
    (ref-set! (compiler-environment-variable-cell first) (compiler-list variable))
    (and (compiler-variable-eq? variable (compiler-car (ref-get (compiler-environment-variable-cell second))))
         (compiler-null? (compiler-environment-declarations first))
         (not (compiler-null? (compiler-environment-declarations second))))))
(define (probe-variable-positions)
  (let ((variable (compiler-make-variable (compiler-position-variable 0) (compiler-temporary-binding)
                                         (compiler-empty) (compiler-empty) (compiler-none))))
    (= (compiler-variable-position (ref-get (compiler-variable-name-cell variable))) 0)))

;; ---- Located improper tails and concrete callback fields ----

(define (probe-source-sharing)
  (let* ((leaf (compiler-make-source (compiler-atom (datum-boolean #t)) (compiler-unknown-location)))
         (tail (compiler-source-tail leaf))
         (root (compiler-make-source (compiler-source-list (compiler-source-pair (ref leaf) (ref tail)))
                                     (compiler-expression-location (datum-boolean #f) (compiler-some leaf)))))
    (compiler-source-code-set! leaf (compiler-atom (datum-boolean #f)))
    (and (ref-eq? (compiler-source-code-cell leaf)
                  (compiler-source-code-cell (compiler-source-tail-value tail)))
         (not (datum-boolean-value (compiler-atom-value (compiler-source-code leaf))))
         (ref-eq? (compiler-source-code-cell leaf)
                   (compiler-source-code-cell (compiler-option-value
                     (compiler-location-source (compiler-source-location root))))))))
(define (probe-callback)
  (let* ((count (ref 0))
         (macro (compiler-macro 2 (lambda (value) (ref-set! count (+ (ref-get count) 1)) value))))
    (and (datum-boolean-value ((compiler-macro-expand macro) (datum-boolean #t)))
         (= (ref-get count) 1))))
(if (and (probe-list-sharing) (probe-list-cycle) (probe-list-order) (probe-association-alias)
         (probe-map-tail-mutation)
         (probe-node-updates) (probe-environment-sharing) (probe-variable-positions)
         (probe-source-sharing) (probe-callback))
    42 0)
