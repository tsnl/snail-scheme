;; Internal algorithm and representation checks. These are not a replacement
;; compiler workload, assembly oracle, or performance sample.

;; ---- List positions, heterogeneous rows and alternating merge order ----

(define (collection-check valid message)
  (unless valid (datum-fail message)))
(define (same-collection? same? left right)
  (if (compiler-null? left) (compiler-null? right)
      (and (not (compiler-null? right)) (same? (compiler-car left) (compiler-car right))
           (same-collection? same? (compiler-cdr left) (compiler-cdr right)))))
(define (collection-index? result expected)
  (match result
    ((compiler-none) #f)
    ((compiler-some index) (= index expected))))
(define (probe-collection-positions)
  (let ((values (compiler-list 3 7 3)))
    (and (collection-index? (pos-in-list i64-eq 3 values) 0)
         (collection-index? (pos-in-list i64-eq 7 values) 1)
         (not (compiler-present? (pos-in-list i64-eq 5 values)))
         (compiler-list-eq? (nth-after values -2) values)
         (compiler-list-eq? (nth-after values 0) values)
         (compiler-list-eq? (nth-after values 2) (my-last-pair values))
         (collection-index? (string-pos-in-list "b" (compiler-list "a" "b" "a")) 1))))
(define (probe-collection-zip)
  (let* ((left (compiler-list 1 2)) (right (compiler-list "a" "b" "unused"))
         (rows (pair-up left right)) (first (compiler-car rows))
         (second (compiler-car (compiler-cdr rows))))
    (compiler-pair-rest-set! first "changed")
    (and (= (compiler-length rows) 2) (= (compiler-pair-first first) 1)
         (string=? (compiler-pair-rest first) "changed")
         (= (compiler-pair-first second) 2) (string=? (compiler-pair-rest second) "b")
         (string=? (compiler-car right) "a")
         (compiler-null? (pair-up (ann (compiler-empty) (CompilerList I64)) right)))))
(define (probe-collection-sort)
  (let* ((trace (ref 0)) (values (compiler-list 1 2 3 4))
         (sorted (sort-list values
                            (lambda (left right)
                              (ref-set! trace (+ (* 100 (ref-get trace)) (+ (* 10 left) right)))
                              #f))))
    (and (= (ref-get trace) 13243432)
         (same-collection? i64-eq sorted (compiler-list 4 2 3 1))
         (same-collection? i64-eq values (compiler-list 1 2 3 4)))))
(define (probe-collection-sort-sharing)
  (let* ((values (compiler-list 1 2 3)) (last (my-last-pair values))
         (sorted (sort-list values i64-lt)))
    (and (compiler-list-eq? (my-last-pair sorted) last)
         (not (compiler-list-eq? sorted values))
         (compiler-list-eq? (sort-list last i64-lt) last))))
(define (probe-collection-conversions)
  (let* ((values (compiler-list 1 2 3)) (array (lst->vector values))
         (copied (vector->lst array)))
    (vector-set! array 1 9)
    (and (same-collection? i64-eq copied values) (not (compiler-list-eq? copied values))
         (= (vector-ref array 1) 9) (= (compiler-car (compiler-cdr copied)) 2)
         (= (vector-length (lst->vector (ann (compiler-empty) (CompilerList I64)))) 0)
         (string=? (lst->string (string->lst "abλ")) "abλ"))))
(define (probe-collection-associations)
  (let* ((first (compiler-make-pair 2 "first")) (second (compiler-make-pair 2 "second"))
         (entries (compiler-list (compiler-make-pair 1 "other") first second))
         (found (compiler-option-value (compiler-assoc i64-eq 2 entries))))
    (compiler-pair-rest-set! found "changed")
    (and (ref-eq? (compiler-pair-first-cell found) (compiler-pair-first-cell first))
         (string=? (compiler-pair-rest first) "changed")
         (string=? (compiler-pair-rest second) "second")
         (not (compiler-present? (compiler-assoc i64-eq 3 entries)))
         (= (compiler-pair-rest (compiler-option-value
                                 (compiler-assoc string=? "a" (compiler-list (compiler-make-pair "a" 7))))) 7))))
(define (probe-collection-append-reverse)
  (let* ((first (compiler-list 1 2)) (last (compiler-list 3 4))
         (joined (compiler-append-lists (compiler-list first (compiler-empty) last)))
         (reversed (compiler-reverse joined)))
    (compiler-set-car! first 9)
    (compiler-set-car! last 8)
    (and (same-collection? i64-eq joined (compiler-list 1 2 8 4))
         (same-collection? i64-eq reversed (compiler-list 4 3 2 1))
         (compiler-list-eq? (compiler-cddr joined) last)
         (= (compiler-list-ref joined 2) 8) (= (compiler-cadddr joined) 4)
         (compiler-list-eq? (compiler-append-lists (compiler-list last)) last)
         (compiler-null? (compiler-append-lists (ann (compiler-empty) (CompilerList (CompilerList I64))))))))

;; ---- Occurrences, two equality scans, copied prefixes and shared tails ----

(define (probe-collection-union)
  (let* ((left (compiler-list 1 1)) (right (compiler-list 2))
         (joined (set-union i64-eq (compiler-list left right)))
         (present (compiler-list 1)) (last (compiler-list 1 3)))
    (and (same-collection? i64-eq joined (compiler-list 1 1 2))
         (compiler-list-eq? (nth-after joined 2) right)
         (compiler-list-eq? (set-union i64-eq (compiler-list left present)) present)
         (compiler-list-eq? (set-union i64-eq (compiler-list left)) left)
         (same-collection? i64-eq (set-union i64-eq (compiler-list left right last))
                           (compiler-list 2 1 3)))))
(define (probe-collection-removal)
  (let* ((values (compiler-list 1 2 3 4)) (suffix (nth-after values 2))
         (removed (set-remove i64-eq values 2)) (missing (set-remove i64-eq values 8)))
    (and (same-collection? i64-eq removed (compiler-list 1 3 4))
         (compiler-list-eq? (compiler-cdr removed) suffix)
         (not (compiler-list-eq? removed values))
         (same-collection? i64-eq missing values)
         (not (compiler-list-eq? missing values))
         (not (compiler-list-eq? (my-last-pair missing) (my-last-pair values)))
         (compiler-list-eq? (set-remove i64-eq values 1) (compiler-cdr values)))))
(define (probe-collection-equality)
  (let ((trace (ref 0)))
    (and (set-equal?
          (lambda (left right)
            (ref-set! trace (+ (* 100 (ref-get trace)) (+ (* 10 left) right)))
            (= left right))
          (compiler-list 1 2) (compiler-list 2 1))
         (= (ref-get trace) 121121112222)
         (not (set-equal? i64-eq (compiler-list 1 1) (compiler-list 1 2)))
         (set-equal? i64-eq (compiler-list 1 2 1) (compiler-list 1 1 2)))))
(define (probe-collection-set-folds)
  (let* ((left (compiler-list 1 2 1 3)) (right (compiler-list 1))
         (member (set-member? i64-eq 2 left)))
    (and (compiler-list-eq? (compiler-option-value member) (compiler-cdr left))
         (compiler-list-eq? (set-adjoin i64-eq left 2) left)
         (compiler-list-eq? (compiler-cdr (set-adjoin i64-eq left 4)) left)
         (same-collection? i64-eq (set-difference i64-eq left (compiler-list right))
                           (compiler-list 2 3))
         (same-collection? i64-eq (set-intersection i64-eq left (compiler-list right))
                           (compiler-list 1 1))
         (compiler-list-eq? (set-intersection i64-eq left (compiler-empty)) left))))
(define (probe-collection-filter-order)
  (let* ((input (compiler-list 1 2 3)) (trace (ref 0))
         (output (set-keep
                  (lambda (value)
                    (ref-set! trace (+ (* 10 (ref-get trace)) value))
                    (when (= value 1) (compiler-set-car! input 9))
                    (when (= value 2) (compiler-set-car! input 8))
                    #t)
                  input)))
    (and (= (ref-get trace) 123) (= (compiler-car input) 8)
         (same-collection? i64-eq output (compiler-list 9 2 3)))))

;; ---- Dependency rounds and ordered batches preserve node identities ----

(define (collection-variable index)
  (compiler-make-variable (compiler-position-variable index) (compiler-temporary-binding)
                          (compiler-empty) (compiler-empty) (compiler-none)))
(define (collection-label-index variable)
  (compiler-variable-position (ref-get (compiler-variable-name-cell variable))))
(define (collection-labels variables) (compiler-map collection-label-index variables))
(define (same-groups? actual expected)
  (same-collection?
   (lambda (actual expected) (same-collection? i64-eq (collection-labels actual) expected))
   actual expected))
(define (probe-collection-diamond)
  (let* ((a (collection-variable 1)) (b (collection-variable 2))
         (c (collection-variable 3)) (d (collection-variable 4))
         (first (make-gnode a (compiler-list b c)))
         (graph (compiler-list first (make-gnode b (compiler-list d))
                               (make-gnode c (compiler-list d)) (make-gnode d (compiler-empty))))
         (closed (transitive-closure graph)))
    (and (same-collection? i64-eq (collection-labels (gnode-edges (compiler-car closed)))
                           (compiler-list 2 3 4))
         (same-collection? i64-eq (collection-labels (gnode-edges first)) (compiler-list 2 3))
         (not (compiler-dependency-eq? first (compiler-car closed)))
         (same-groups? (topological-sort closed)
                       (compiler-list (compiler-list 4) (compiler-list 2 3) (compiler-list 1))))))
(define (probe-collection-cycle)
  (let* ((a (collection-variable 1)) (b (collection-variable 2))
         (c (collection-variable 3)) (d (collection-variable 4))
         (graph (compiler-list (make-gnode a (compiler-list b)) (make-gnode b (compiler-list a))
                               (make-gnode c (compiler-empty)) (make-gnode d (compiler-list a))))
         (closed (transitive-closure graph)))
    (and (same-collection? i64-eq (collection-labels (gnode-edges (compiler-car closed)))
                           (compiler-list 2 1))
         (same-groups? (topological-sort closed)
                       (compiler-list (compiler-list 3) (compiler-list 1 2) (compiler-list 4))))))
(define (probe-collection-duplicate-labels)
  (let* ((a (collection-variable 1)) (b (collection-variable 2))
         (first (make-gnode a (compiler-list b b))) (second (make-gnode a (compiler-empty)))
         (graph (compiler-list first second (make-gnode b (compiler-empty))))
         (closed (transitive-closure graph)))
    (and (not (compiler-dependency-eq? first second))
         (compiler-dependency-eq? (compiler-option-value (gnode-find a graph)) first)
         (= (compiler-length (gnode-edges (compiler-car closed))) 2)
         (not (compiler-dependency-eq? second (compiler-car (compiler-cdr closed))))
         (same-groups? (topological-sort closed)
                       (compiler-list (compiler-list 1 2) (compiler-list 1))))))

;; ---- Queue aliases retain the stored-tail behavior, including overwrites ----

(define (probe-collection-queue-sharing)
  (let* ((input (compiler-list 1 2)) (queue (list->queue input))
         (added (queue-put! queue 3)) (taken (queue-get! queue)))
    (and (= added 3) (= (compiler-success-value taken) 1)
         (same-collection? i64-eq input (compiler-list 1 2 3))
         (compiler-list-eq? (queue->list queue) (compiler-cdr input))
         (compiler-list-eq? (compiler-pair-rest queue) (my-last-pair input)))))
(define (probe-collection-queue-overwrite)
  (let* ((input (compiler-list 1)) (first (list->queue input)) (second (list->queue input)))
    (queue-put! first 2)
    (let ((detached (compiler-pair-rest first)))
      (queue-put! second 3)
      (queue-put! first 4)
      (and (same-collection? i64-eq input (compiler-list 1 3))
           (same-collection? i64-eq detached (compiler-list 2 4))
           (= (compiler-car (compiler-pair-rest first)) 4)
           (= (compiler-car (compiler-pair-rest second)) 3)))))
(define (probe-collection-queue-final)
  (let* ((queue (queue-empty)) (added (queue-put! queue 1)) (taken (queue-get! queue)))
    (and (= added 1) (= (compiler-success-value taken) 1) (queue-empty? queue)
         (compiler-null? (compiler-pair-rest queue))
         (= (queue-put! queue 2) 2) (= (compiler-car (queue->list queue)) 2))))

;; ---- Failure preserves earlier effects and stops before later traversal ----

(define (probe-collection-counter)
  (let* ((limits (ref 0))
         (counter (make-counter 4 5
                                (lambda ()
                                  (ref-set! limits (+ (ref-get limits) 1))
                                  (compiler-abort-result)))))
    (and (= (compiler-success-value (counter)) 4)
         (not (compiler-with-exception-handling
               (lambda ()
                 (match (counter)
                   ((compiler-success value) (compiler-success #t))
                   ((compiler-failure) (compiler-failure))))))
         (= (ref-get limits) 1))))
(define (probe-collection-failed-filter)
  (let* ((input (compiler-list 1 2 3)) (trace (ref 0))
         (finished
          (compiler-with-exception-handling
           (lambda ()
             (match (compiler-result-keep
                     (lambda (value)
                       (ref-set! trace (+ (* 10 (ref-get trace)) value))
                       (if (= value 2)
                           (begin (compiler-set-cdr! input (compiler-list 9))
                                  (compiler-abort-result))
                           (compiler-success #t)))
                     input)
               ((compiler-failure) (compiler-failure))
               ((compiler-success values) (ref-set! trace 999) (compiler-success #t)))))))
    (and (not finished) (= (ref-get trace) 12)
         (same-collection? i64-eq input (compiler-list 1 9)))))
(define (probe-collection-failed-map)
  (let ((trace (ref 0)))
    (and (not (compiler-with-exception-handling
               (lambda ()
                 (match (compiler-result-map
                         (lambda (value)
                           (ref-set! trace (+ (* 10 (ref-get trace)) value))
                           (if (= value 2) (compiler-abort-result) (compiler-success value)))
                         (compiler-list 1 2 3))
                   ((compiler-failure) (compiler-failure))
                   ((compiler-success values) (compiler-success #t))))))
         (= (ref-get trace) 12))))
(define (probe-collection-queue-abort)
  (let ((queue (queue-empty)) (marker (ref 0)))
    (and (not (compiler-with-exception-handling
               (lambda ()
                 (queue-put! queue 7)
                 (match (queue-get! queue)
                   ((compiler-failure) (compiler-failure))
                   ((compiler-success value)
                    (ref-set! marker value)
                    (match (queue-get! queue)
                      ((compiler-failure) (compiler-failure))
                      ((compiler-success later) (ref-set! marker 999) (compiler-success #t))))))))
         (= (ref-get marker) 7) (queue-empty? queue) (compiler-null? (compiler-pair-rest queue)))))

;; Each negative entry executes in a fresh process. Ordinary primitive failure
;; must escape the installed compiler handler and retain the preceding output.
(: collection-host-failure (-> (-> I64) I64))
(define (collection-host-failure operation)
  (write-string "before host failure\n")
  (compiler-with-exception-handling (lambda () (compiler-success (= (operation) 0))))
  (write-string "unexpected return\n")
  99)
(: collection-short-zip (-> I64))
(define (collection-short-zip)
  (collection-host-failure
   (lambda ()
     (compiler-length (pair-up (compiler-list 1) (ann (compiler-empty) (CompilerList String)))))))
(: collection-missing-node (-> I64))
(define (collection-missing-node)
  (collection-host-failure
   (lambda ()
     (compiler-length (transitive-closure
                       (compiler-list (make-gnode (collection-variable 1)
                                                  (compiler-list (collection-variable 2)))))))))
(: collection-negative-index (-> I64))
(define (collection-negative-index)
  (collection-host-failure (lambda () (compiler-list-ref (compiler-list 1) -1))))

;; ---- All checks execute; a failure names its independent contract ----

(begin
  (collection-check (probe-collection-positions) "collection positions")
  (collection-check (probe-collection-zip) "collection heterogeneous zip")
  (collection-check (probe-collection-sort) "collection alternating sort order")
  (collection-check (probe-collection-sort-sharing) "collection sort tail sharing")
  (collection-check (probe-collection-conversions) "collection vector/string conversions")
  (collection-check (probe-collection-associations) "collection first association and value alias")
  (collection-check (probe-collection-append-reverse) "collection append/reverse sharing")
  (collection-check (probe-collection-union) "collection union multiplicity and sharing")
  (collection-check (probe-collection-removal) "collection removal copying and sharing")
  (collection-check (probe-collection-equality) "collection equality two scans")
  (collection-check (probe-collection-set-folds) "collection set folds")
  (collection-check (probe-collection-filter-order) "collection chosen filter order")
  (collection-check (probe-collection-diamond) "collection dependency diamond")
  (collection-check (probe-collection-cycle) "collection dependency cycle")
  (collection-check (probe-collection-duplicate-labels) "collection graph label versus node identity")
  (collection-check (probe-collection-queue-sharing) "collection queue sharing")
  (collection-check (probe-collection-queue-overwrite) "collection queue stale-tail overwrite")
  (collection-check (probe-collection-queue-final) "collection final dequeue")
  (collection-check (probe-collection-counter) "collection counter failure")
  (collection-check (probe-collection-failed-filter) "collection filter failure order")
  (collection-check (probe-collection-failed-map) "collection map failure order")
  (collection-check (probe-collection-queue-abort) "collection queue failure after mutation")
  42)
