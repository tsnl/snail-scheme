(import (sfir primitive))
(define-extern record "instance.probe" "record" (-> I64 Unit))
(def history (ref (ann 0 I64)))
(def mark (lambda (digit) (begin (ref-set! history (i64-add (i64-mul (ref-get history) (ann 10 I64)) digit)) (record digit))))
(def observed (-> I64) (lambda () (ref-get history)))

;; ---- Independent annotations may correspond by a permutation ----

(def left (All (A B) (-> I64 A B A))
     (lambda (n first second)
       (if (i64-eq n (ann 0 I64)) first (right (i64-sub n (ann 1 I64)) second first))))
(def right (All (C D) (-> I64 C D D))
     (lambda (n first second)
       (if (i64-eq n (ann 0 I64)) second (left (i64-sub n (ann 1 I64)) second first))))

;; The inferred peer must work in both independent rigid checking scopes.
(def first (All (T) (-> I64 T T))
     (lambda (n value)
       (if (i64-eq n (ann 0 I64)) value (middle (i64-sub n (ann 1 I64)) value))))
(def middle
     (lambda (n value)
       (if (i64-eq n (ann 0 I64)) value (last (i64-sub n (ann 1 I64)) value))))
(def last (All (U) (-> I64 U U))
     (lambda (n value)
       (if (i64-eq n (ann 0 I64)) value (first (i64-sub n (ann 1 I64)) value))))
(def self (All (T Phantom) (-> I64 T T))
     (lambda (n value)
       (if (i64-eq n (ann 0 I64)) value
           ((inst self T Phantom) (i64-sub n (ann 1 I64)) value))))
(def nested (All (T) (-> I64 T T))
     (lambda (n value)
       (begin
         (def local (All (U) (-> I64 U T))
              (lambda (count ignored)
                (if (i64-eq count (ann 0 I64)) value
                    (local (i64-sub count (ann 1 I64)) ignored))))
         (if (i64-eq n (ann 0 I64)) (local (ann 5 I64) #t)
             (nested (i64-sub n (ann 1 I64)) value)))))

;; ---- External nominal and class identities survive the private template ----

(def Box (datatype (T) (box (value T unbox))))
(def boxed-left (All (T) (-> I64 (Box T) (Box T)))
     (lambda (n value)
       (if (i64-eq n (ann 0 I64)) value (boxed-right (i64-sub n (ann 1 I64)) value))))
(def boxed-right (All (U) (-> I64 (Box U) (Box U)))
     (lambda (n value)
       (if (i64-eq n (ann 0 I64)) value (boxed-left (i64-sub n (ann 1 I64)) value))))
(def Identity (typeclass (T) (: identity (-> T T))))
(def identity-i64 (instance (Identity I64) (identity (lambda (value) value))))
(def class-left (All (T) (=> ((Identity T)) (-> I64 T T)))
     (lambda (n value)
       (if (i64-eq n (ann 0 I64)) (identity value) (class-middle (i64-sub n (ann 1 I64)) value))))
(def class-middle
     (lambda (n value)
       (if (i64-eq n (ann 0 I64)) (identity value) (class-right (i64-sub n (ann 1 I64)) value))))
(def class-right (All (U) (=> ((Identity U)) (-> I64 U U)))
     (lambda (n value)
       (if (i64-eq n (ann 0 I64)) (identity value) (class-left (i64-sub n (ann 1 I64)) value))))

(mark (ann 1 I64))
(if (i64-eq (left (ann 10000 I64) (ann 42 I64) #t) (ann 42 I64)) (unit) (unreachable))
(if (right (ann 10001 I64) (ann 42 I64) #t) (unit) (unreachable))
(if (i64-eq (middle (ann 10002 I64) (ann 42 I64)) (ann 42 I64)) (unit) (unreachable))
(if (last (ann 10003 I64) #t) (unit) (unreachable))
(mark (ann 2 I64))
(if (i64-eq ((inst self I64 Bool) (ann 10004 I64) (ann 42 I64)) (ann 42 I64)) (unit) (unreachable))
(if (i64-eq (nested (ann 100 I64) (ann 42 I64)) (ann 42 I64)) (unit) (unreachable))
(if (i64-eq (unbox (boxed-left (ann 10005 I64) (box (ann 42 I64)))) (ann 42 I64)) (unit) (unreachable))
(if (i64-eq (class-right (ann 10006 I64) (ann 42 I64)) (ann 42 I64)) (unit) (unreachable))
(mark (ann 3 I64))
(if (i64-eq (observed) (ann 123 I64)) (ann 42 I64) (unreachable))
