(define-library (builder scalars)
  (import (sfir compiler-builder) (only (sfir primitive) cons empty-list))
  (export build-i64 build-f32 build-f64 build-bool build-char)
  (begin
    (def span (source-span (builder-name "generated-scalar.sfir") (ann 1 I32) (ann 1 I32)))
    (def constant (-> TypeSyntax Expression SfirLibrary)
         (lambda (type value)
           (begin
             (let scope (library-scope))
             (let result (binding scope (builder-name "result") span))
             (sfir-library (cons (builder-name "scalar") (empty-list)) scope (empty-list)
                           (cons (library-export (builder-name "run") (local-reference result span)) (empty-list))
                           (cons (definition result (function-type (empty-list) type)
                                   (lambda-expression (nested-scope scope) (empty-list) value span) span) (empty-list)) span))))
    (def build-i64 (-> I64 I64)
         (lambda (value) (library-token (constant (type-i64) (literal-i64 value span)))))
    (def build-f32 (-> F32 I64)
         (lambda (value) (library-token (constant (type-f32) (literal-f32 value span)))))
    (def build-f64 (-> F64 I64)
         (lambda (value) (library-token (constant (type-f64) (literal-f64 value span)))))
    (def build-bool (-> Bool I64)
         (lambda (value) (library-token (constant (type-bool) (literal-bool value span)))))
    (def build-char (-> Char I64)
         (lambda (value) (library-token (constant (type-char) (literal-char value span)))))))
