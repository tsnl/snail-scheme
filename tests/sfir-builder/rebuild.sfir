;; A compiled SFIR tree transformation exercises every inspection family.
;; It rebuilds syntax and copied literal payloads while keeping binder identities.
(define-library (builder rebuild)
  (import (sfir compiler-builder) (only (sfir primitive) empty-list cons car cdr null?))
  (export rebuild-library)
  (begin
    (def rebuild-name (-> Name Name) (lambda (name) (builder-name (builder-name-text name))))
    (def rebuild-span (-> SourceSpan SourceSpan)
         (lambda (original)
           (match (inspect-span original)
             ((view-span source line column) (source-span (rebuild-name source) line column)))))
    (def rebuild-scope (-> ScopeId ScopeId)
         (lambda (original)
           (match (inspect-scope original)
             ((view-scope) original)
             ((view-child-scope parent) original))))
    (def rebuild-binding (-> BindingId BindingId)
         (lambda (original)
           (match (inspect-binding original)
             ((view-binding scope name span) original))))
    (def rebuild-type (-> TypeSyntax TypeSyntax)
         (lambda (original)
           (match (inspect-type original)
             ((view-type-i32) (type-i32))
             ((view-type-i64) (type-i64))
             ((view-type-f32) (type-f32))
             ((view-type-f64) (type-f64))
             ((view-type-bool) (type-bool))
             ((view-type-char) (type-char))
             ((view-type-unit) (type-unit))
             ((view-type-string) (type-string))
             ((view-type-bytevector) (type-bytevector))
             ((view-type-never) (type-never))
             ((view-type-any) (type-any))
             ((view-function-type parameters result) (function-type (rebuild-types parameters) (rebuild-type result)))
             ((view-rest-type element) (rest-type (rebuild-type element)))
             ((view-variable-type variable) (variable-type (rebuild-type-variable variable)))
             ((view-reference-type element) (reference-type (rebuild-type element)))
             ((view-list-type element) (list-type (rebuild-type element)))
             ((view-vector-type element) (vector-type (rebuild-type element)))
             ((view-rest-function-type parameters rest result)
              (rest-function-type (rebuild-types parameters) (rebuild-type rest) (rebuild-type result)))
             ((view-nominal-type reference arguments) (nominal-type (rebuild-reference reference) (rebuild-types arguments))))))
    (def rebuild-reference (-> BindingReference BindingReference)
         (lambda (original)
           (match (inspect-reference original)
             ((view-local-reference binding span) (local-reference (rebuild-binding binding) (rebuild-span span)))
             ((view-import-reference scope name span) (import-reference (rebuild-scope scope) (rebuild-name name) (rebuild-span span))))))
    (def rebuild-expression (-> Expression Expression)
         (lambda (original)
           (match (inspect-expression original)
             ((view-number-literal spelling span) (literal-number spelling (rebuild-span span)))
             ((view-literal-i32 value span) (literal-i32 value (rebuild-span span)))
             ((view-literal-i64 value span) (literal-i64 value (rebuild-span span)))
             ((view-literal-f32 value span) (literal-f32 value (rebuild-span span)))
             ((view-literal-f64 value span) (literal-f64 value (rebuild-span span)))
             ((view-literal-bool value span) (literal-bool value (rebuild-span span)))
             ((view-literal-char value span) (literal-char value (rebuild-span span)))
             ((view-reference reference) (reference-expression (rebuild-reference reference)))
             ((view-lambda scope parameters body span)
              (lambda-expression
               (rebuild-scope scope)
               (rebuild-bindings parameters)
               (rebuild-expression body)
               (rebuild-span span)))
             ((view-application operator arguments span)
              (application-expression
               (rebuild-expression operator)
               (rebuild-expressions arguments)
               (rebuild-span span)))
             ((view-conditional test yes no span)
              (conditional-expression
               (rebuild-expression test)
               (rebuild-expression yes)
               (rebuild-expression no)
               (rebuild-span span)))
             ((view-string-literal value span) (literal-string value (rebuild-span span)))
             ((view-bytevector-literal value span) (literal-bytevector value (rebuild-span span)))
             ((view-rest-lambda scope parameters rest body span)
              (rest-lambda-expression
               (rebuild-scope scope)
               (rebuild-bindings parameters)
               (rebuild-binding rest)
               (rebuild-expression body)
               (rebuild-span span)))
             ((view-block scope statements result span)
              (block-expression
               (rebuild-scope scope)
               (rebuild-declarations statements)
               (rebuild-expression result)
               (rebuild-span span)))
             ((view-annotation expression type span)
              (annotation-expression (rebuild-expression expression) (rebuild-type type) (rebuild-span span)))
             ((view-instantiation reference arguments span)
              (instantiation-expression (rebuild-reference reference) (rebuild-types arguments) (rebuild-span span)))
             ((view-match subject arms span) (match-expression (rebuild-expression subject) (rebuild-arms arms) (rebuild-span span))))))
    (def rebuild-declaration (-> Declaration Declaration)
         (lambda (original)
           (match (inspect-declaration original)
             ((view-definition binding signature value span)
              (with-signature-location
               (signature-definition
                (rebuild-binding binding)
                (rebuild-signature signature)
                (rebuild-expression value)
                (rebuild-span span)) (rebuild-span (signature-location original))))
             ((view-inferred-definition binding value span)
              (inferred-definition (rebuild-binding binding) (rebuild-expression value) (rebuild-span span)))
             ((view-local-binding binding signature value span)
              (with-signature-location
               (local-binding
                (rebuild-binding binding)
                (rebuild-signature signature)
                (rebuild-expression value)
                (rebuild-span span)) (rebuild-span (signature-location original))))
             ((view-inferred-local-binding binding value span)
              (inferred-local-binding (rebuild-binding binding) (rebuild-expression value) (rebuild-span span)))
             ((view-expression-statement expression) (expression-statement (rebuild-expression expression)))
             ((view-datatype binding scope parameters cases span)
              (datatype-definition
               (rebuild-binding binding)
               (rebuild-scope scope)
               (rebuild-variables parameters)
               (rebuild-cases cases)
               (rebuild-span span)))
             ((view-typeclass binding scope parameters methods span)
              (typeclass-definition
               (rebuild-binding binding)
               (rebuild-scope scope)
               (rebuild-variables parameters)
               (rebuild-methods methods)
               (rebuild-span span)))
             ((view-instance binding head methods span)
              (instance-definition
               (rebuild-binding binding)
               (rebuild-constraint head)
               (rebuild-implementations methods)
               (rebuild-span span)))
             ((view-kind-annotation kind declaration span)
              (kind-annotated-definition (rebuild-kind kind) (rebuild-declaration declaration) (rebuild-span span)))
             ((view-extern binding module symbol type span)
              (extern-definition (rebuild-binding binding) module symbol (rebuild-type type) (rebuild-span span)))
             ((view-overload binding signature value span)
              (with-signature-location
               (overload-definition
                (rebuild-binding binding)
                (rebuild-signature signature)
                (rebuild-expression value)
                (rebuild-span span)) (rebuild-span (signature-location original)))))))
    (def rebuild-import-selection (-> ImportSelection ImportSelection)
         (lambda (original)
           (match (inspect-import-selection original)
             ((view-all) (all-imports))
             ((view-only selection names) (only-imports (rebuild-import-selection selection) (rebuild-names names)))
             ((view-rename selection renames) (rename-imports (rebuild-import-selection selection) (rebuild-renames renames))))))
    (def rebuild-import-rename (-> ImportRename ImportRename)
         (lambda (original)
           (match (inspect-import-rename original)
             ((view-rename-pair from to) (import-rename (rebuild-name from) (rebuild-name to))))))
    (def rebuild-import (-> Import Import)
         (lambda (original)
           (match (inspect-import original)
             ((view-import key selection scope span)
              (library-import
               (rebuild-names key)
               (rebuild-import-selection selection)
               (rebuild-scope scope)
               (rebuild-span span))))))
    (def rebuild-export (-> Export Export)
         (lambda (original)
           (match (inspect-export original)
             ((view-export name reference) (library-export (rebuild-name name) (rebuild-reference reference))))))
    (def rebuild-library (-> SfirLibrary SfirLibrary)
         (lambda (original)
           (match (inspect-library original)
             ((view-library key scope imports exports declarations span)
              (sfir-library
               (rebuild-names key)
               (rebuild-scope scope)
               (rebuild-imports imports)
               (rebuild-exports exports)
               (rebuild-declarations declarations)
               (rebuild-span span))))))
    (def rebuild-type-variable (-> TypeVariableId TypeVariableId)
         (lambda (original)
           (match (inspect-type-variable original)
             ((view-variable-id scope name span) original))))
    (def rebuild-constraint (-> ConstraintSyntax ConstraintSyntax)
         (lambda (original)
           (match (inspect-constraint original)
             ((view-constraint reference arguments span)
              (constraint (rebuild-reference reference) (rebuild-types arguments) (rebuild-span span))))))
    (def rebuild-signature (-> Signature Signature)
         (lambda (original)
           (match (inspect-signature original)
             ((view-binding-signature type) (binding-signature (rebuild-type type)))
             ((view-all-signature scope variables constraints type span)
              (all-signature
               (rebuild-scope scope)
               (rebuild-variables variables)
               (rebuild-constraints constraints)
               (rebuild-type type)
               (rebuild-span span))))))
    (def rebuild-kind (-> KindSyntax KindSyntax)
         (lambda (original)
           (match (inspect-kind original)
             ((view-kind-type) (kind-type))
             ((view-kind-constraint) (kind-constraint))
             ((view-kind-function parameters result) (function-kind (rebuild-kinds parameters) (rebuild-kind result)))
             ((view-kind-evidence requirement) (evidence-kind (rebuild-constraint requirement))))))
    (def rebuild-match-arm (-> MatchArm MatchArm)
         (lambda (original)
           (match (inspect-match-arm original)
             ((view-match-arm constructor scope parameters body span)
              (match-arm
               (rebuild-reference constructor)
               (rebuild-scope scope)
               (rebuild-bindings parameters)
               (rebuild-expression body)
               (rebuild-span span))))))
    (def rebuild-data-field (-> DataField DataField)
         (lambda (original)
           (match (inspect-data-field original)
             ((view-data-field name type span) (data-field (rebuild-name name) (rebuild-type type) (rebuild-span span)))
             ((view-accessor-field name type accessor span)
              (accessor-field (rebuild-name name) (rebuild-type type) (rebuild-binding accessor) (rebuild-span span))))))
    (def rebuild-data-constructor (-> DataCase DataCase)
         (lambda (original)
           (match (inspect-data-constructor original)
             ((view-data-case binding fields span) (data-constructor (rebuild-binding binding) (rebuild-fields fields) (rebuild-span span))))))
    (def rebuild-class-method (-> ClassMethod ClassMethod)
         (lambda (original)
           (match (inspect-class-method original)
             ((view-class-method binding type span) (class-method (rebuild-binding binding) (rebuild-type type) (rebuild-span span))))))
    (def rebuild-method-implementation (-> MethodImplementation MethodImplementation)
         (lambda (original)
           (match (inspect-method-implementation original)
             ((view-method-implementation method value span)
              (method-implementation (rebuild-reference method) (rebuild-expression value) (rebuild-span span))))))
    (def rebuild-names (-> (List Name) (List Name))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-name (car values)) (rebuild-names (cdr values))))))
    (def rebuild-bindings (-> (List BindingId) (List BindingId))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-binding (car values)) (rebuild-bindings (cdr values))))))
    (def rebuild-types (-> (List TypeSyntax) (List TypeSyntax))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-type (car values)) (rebuild-types (cdr values))))))
    (def rebuild-expressions (-> (List Expression) (List Expression))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-expression (car values)) (rebuild-expressions (cdr values))))))
    (def rebuild-declarations (-> (List Declaration) (List Declaration))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-declaration (car values)) (rebuild-declarations (cdr values))))))
    (def rebuild-renames (-> (List ImportRename) (List ImportRename))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-import-rename (car values)) (rebuild-renames (cdr values))))))
    (def rebuild-imports (-> (List Import) (List Import))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-import (car values)) (rebuild-imports (cdr values))))))
    (def rebuild-exports (-> (List Export) (List Export))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-export (car values)) (rebuild-exports (cdr values))))))
    (def rebuild-variables (-> (List TypeVariableId) (List TypeVariableId))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-type-variable (car values)) (rebuild-variables (cdr values))))))
    (def rebuild-constraints (-> (List ConstraintSyntax) (List ConstraintSyntax))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-constraint (car values)) (rebuild-constraints (cdr values))))))
    (def rebuild-kinds (-> (List KindSyntax) (List KindSyntax))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-kind (car values)) (rebuild-kinds (cdr values))))))
    (def rebuild-arms (-> (List MatchArm) (List MatchArm))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-match-arm (car values)) (rebuild-arms (cdr values))))))
    (def rebuild-fields (-> (List DataField) (List DataField))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-data-field (car values)) (rebuild-fields (cdr values))))))
    (def rebuild-cases (-> (List DataCase) (List DataCase))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-data-constructor (car values)) (rebuild-cases (cdr values))))))
    (def rebuild-methods (-> (List ClassMethod) (List ClassMethod))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-class-method (car values)) (rebuild-methods (cdr values))))))
    (def rebuild-implementations (-> (List MethodImplementation) (List MethodImplementation))
         (lambda (values)
           (if (null? values) (empty-list)
               (cons (rebuild-method-implementation (car values)) (rebuild-implementations (cdr values))))))
    ))
