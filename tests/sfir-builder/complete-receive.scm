;; This compiler host owns no producer code or heap. The only input is syntax.
(import (scheme base) (scheme file) (scheme process-context) (scheme write)
        (snail-scheme reader) (snail-scheme syntax-parser) (snail-scheme chromium-trace)
        (snail-scheme strict-primitives) (snail-sfir frontend) (snail-sfir compiler)
        (snail-sfir library-transfer) (only (snail-scheme test-utils) expect)
        (only (srfi 130) string-contains))
(define directory (cadr (command-line)))
(define (receive name)
  (receive-library-transfer (make-library-transfer-context)
                            (call-with-input-file (string-append directory "/" name ".json") read-library-transfer)))
(define generated (receive "complete"))
(define source
  (with-chromium-trace-to (string-append directory "/complete-source-parse.json")
                          (lambda () (parse-library (car (reader->syntax-list (file->reader "tests/sfir-builder/complete-source.sfir")))))))
(define provider
  (with-chromium-trace-to (string-append directory "/complete-provider-parse.json")
                          (lambda () (parse-library (car (reader->syntax-list (file->reader "tests/sfir-builder/complete-provider.sfir")))))))
(define primitive (cons '(sfir primitive) (make-primitive-library primitive-names)))
(define native-target (native64-target (list (make-native-import "tests.builder" "add" "builder_add" '(i32 i32) 'i32))))
(define (write-result library name export target extension)
  (let ((artifact (compile (list primitive (cons '(complete provider) provider) (cons '(complete result) library)) (make-entry '(complete result) export) target)))
    (call-with-port (open-binary-output-file (string-append directory "/" name extension))
      (lambda (port) (write-bytevector (artifact-bytes artifact) port)))))
(for-each
 (lambda (pair)
   (write-result (cdr pair) (string-append "complete-" (car pair)) 'run wasm-target ".wasm")
   (write-result (cdr pair) (string-append "complete-" (car pair)) 'run native-target ".o")
   (write-result (cdr pair) (string-append "complete-" (car pair) "-literals") 'literals wasm-target ".wasm"))
 (list (cons "generated" generated) (cons "source" source) (cons "parsed" (receive "parsed"))))
(for-each
 (lambda (case)
   (expect (guard (failure (else (and (error-object? failure)
                                      (if (string-contains (error-object-message failure) (cdr case)) #t #f))))
             (receive (string-append "bad-" (car case))) #f) #t))
 '(("future-let" . "escapes its lexical scope") ("variable-scope" . "different scope")
   ("escaped-variable" . "type variable escapes") ("block-parent" . "wrong parent")
   ("static-value" . "wrong kind") ("byte-range" . "byte literal")
   ("duplicate-static-binding" . "duplicate binding") ("forged-evidence" . "unsupported transfer scalar type")
   ("surrogate-text" . "Unicode scalar values") ("reserved-binding" . "reserved SFIR keyword")
   ("reserved-variable" . "reserved SFIR keyword") ("duplicate-variable-name" . "duplicate transfer name")
   ("class-as-type" . "wrong kind") ("value-as-constraint" . "wrong kind")
   ("shared-reference-first" . "escapes its lexical scope") ("shared-reference-last" . "escapes its lexical scope")))
(expect (guard (failure (else (and (error-object? failure)
                                   (if (string-contains (error-object-message failure) "static definition kind mismatch") #t #f))))
          (compile (list primitive (cons '(complete provider) provider) (cons '(invalid) (receive "bad-kind-mismatch"))) (make-entry '(invalid) 'run) wasm-target) #f) #t)
(display "PASS complete syntax reception, lexical/type ownership, declaration roles and unforgeable checking\n")
