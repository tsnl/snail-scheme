(import (scheme base)
        (only (snail-scheme options) test-options)
        (only (snail-scheme chromium-trace) test-chromium-trace with-chromium-trace-to)
        (only (chibi temp-file) call-with-temp-dir)
        (only (snail-scheme build) test-build)
        (only (snail-scheme common) display-error)
        (only (snail-scheme reader) test-reader)
        (only (snail-scheme parser) test-parser)
        (only (snail-scheme library) test-library)
        (only (snail-scheme wasm) test-wasm)
        (only (snail-scheme wasm-binary) test-wasm-binary)
        (only (snail-scheme llvmlite) test-llvmlite)
        (only (snail-scheme llvm) test-llvm)
        (only (snail-scheme syntax-parser) test-syntax-parser)
        (only (snail-scheme pattern) test-pattern)
        (only (snail-scheme types) test-types)
        (only (snail-scheme type-inference) test-type-inference)
        (only (snail-scheme expand) test-expand))

(test-options)
(test-chromium-trace)
(call-with-temp-dir
 "snail-unit-traces"
 (lambda (directory preserve)
   (with-chromium-trace-to
    (string-append directory "/tests.json")
    (lambda ()
      (test-build)
      (test-reader)
      (test-parser)
      (test-library)
      (test-wasm)
      (test-wasm-binary)
      (test-llvmlite)
      (test-llvm)
      (test-syntax-parser)
      (test-pattern)
      (test-types)
      (test-type-inference)
      (test-expand)))))
(display-error "All tests ok\n")
