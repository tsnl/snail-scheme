(import (scheme base)
        (only (snail-scheme options) test-options)
        (only (snail-scheme chromium-trace) test-chromium-trace with-chromium-trace-to)
        (only (chibi temp-file) call-with-temp-dir)
        (only (snail-scheme build) test-build)
        (only (snail-scheme artifacts) test-artifacts)
        (only (snail-scheme generation) test-generation)
        (only (snail-scheme hash-table) test-hash-table)
        (only (snail-scheme common) display-error)
        (only (snail-scheme reader) test-reader)
        (only (snail-scheme parser) test-parser)
        (only (snail-scheme library) test-library)
        (only (snail-scheme partial-eval) test-partial-eval)
        (only (snail-scheme wasm) test-wasm)
        (only (snail-scheme wasm-literals) test-wasm-literals)
        (only (snail-scheme syntax-parser) test-syntax-parser)
        (only (snail-scheme pattern) test-pattern)
        (only (snail-scheme type-analysis) test-type-analysis)
        (only (snail-scheme typeclasses) test-typeclasses)
        (only (snail-scheme iverson-ghost) test-iverson-ghost)
        (only (snail-scheme wasm-i32) test-wasm-i32)
        (only (snail-scheme types) test-types)
        (only (snail-scheme strict-types) test-strict-types)
        (only (snail-scheme wasm-extern) test-wasm-extern)
        (only (snail-scheme type-inference) test-type-inference)
        (only (snail-scheme expand) test-expand))

(test-options)
(test-chromium-trace)
(call-with-temp-dir
 "snail-unit-traces"
 (lambda (directory preserve)
   (with-chromium-trace-to
    (string-append directory "/tests.json")
    (lambda ()
      (test-build)
      (test-artifacts)
      (test-generation)
      (test-hash-table)
      (test-reader)
      (test-parser)
      (test-library)
      (test-partial-eval)
      (test-wasm)
      (test-wasm-literals)
      (test-syntax-parser)
      (test-pattern)
      (test-type-analysis)
      (test-typeclasses)
      (test-iverson-ghost)
      (test-wasm-i32)
      (test-types)
      (test-strict-types)
      (test-wasm-extern)
      (test-type-inference)
      (test-expand)))))
(display-error "All tests ok\n")
