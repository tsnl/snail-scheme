;; Source checks stay enabled; explicit contracts retain storage in every mode.
(import (scheme base) (scheme cxr) (scheme process-context)
        (snail-scheme compiler) (snail-scheme build) (snail-scheme chromium-trace)
        (snail-scheme wasm-storage) (snail-scheme type-analysis)
        (snail-scheme specialize) (snail-scheme wasm-representation))
(define arguments (cdr (command-line)))
(define root (car arguments))
(define source (cadr arguments))
(define output (caddr arguments))
(define mode (cadddr arguments))
(with-chromium-trace-to
 (string-append output ".trace.json")
 (lambda ()
   (parameterize ((storage-optimizations-enabled (not (string=? mode "off")))
                  (type-optimizations-enabled (not (string=? mode "guarded")))
                  (representation-optimizations-enabled (not (string=? mode "guarded")))
                  (specialization-enabled (not (string=? mode "guarded"))))
     (source-file->wat-file root source (string-append output ".wat")
                            '((array-boundaries . "snail.test"))))
   (link-wasm (string-append output ".wat") (build-runtime root) (string-append output ".wasm"))))
