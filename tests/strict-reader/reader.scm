(import (snail integer) (snail rational) (snail strict) (snail datum) (snail read) (snail io) (snail bytes))

;; ---- Exactness, stable symbols and observable mutable datum fields ----

(: parsed (-> String Number))
(define (parsed text) (parsed-number-value (string->number text)))
(: equivalence (-> Bool))
(define (equivalence)
  (let* ((one (datum-number (exact-number 1))) (two (datum-number (exact-number 2)))
         (left (datum-cons one (datum-null))) (right (datum-cons one (datum-null)))
         (bytes (bytevector 1 2)) (elements (vector one two)))
    (and (datum=? left right)
         (not (datum=? left (datum-cons two (datum-null))))
         (not (datum=? left (datum-cons one right)))
         (datum=? (datum-vector elements) (datum-vector (vector-copy elements)))
         (not (datum=? (datum-vector elements) (datum-vector (vector two one))))
         (datum=? (datum-bytevector bytes) (datum-bytevector (bytevector 1 2)))
         (not (datum=? (datum-bytevector bytes) (datum-bytevector (bytevector 1 3))))
         (not (datum=? (datum-string "1") one)))))
(: check (-> I64))
(define (check)
  (let* ((name (string->symbol "λ😀")) (same (string->symbol (string-copy "λ😀")))
         (pair (datum-cons (datum-symbol name) (datum-null))))
    (datum-set-car! pair (datum-number (parsed "#e9007199254740993.0")))
    (if (and (equivalence) (symbol=? name same) (string=? (symbol->string name) "λ😀")
             (number-equivalent? (parsed "#x-8000000000000000") (exact-number -9223372036854775808))
             (number-equivalent? (parsed "1+0i") (parsed "1"))
             (not (number-equivalent? (parsed "0.0") (parsed "-0.0")))
             (number-equivalent? (parsed "+nan.0") (parsed "-nan.0"))
             (not (number-equivalent? (parsed "1") (parsed "1.0")))
             (datum=? (datum-car pair) (datum-number (exact-number 9007199254740993)))
             (= (number->f64 (parsed "12.5")) 12.5))
        42 0)))

;; ---- Independently read mutable fields and names keep their ownership ----

(: storage (-> Bool))
(define (storage)
  (call-with-input-file "ownership.scm"
    (lambda (port)
      (let* ((pair (read-value! (read port))) (alias pair)
             (name (datum-symbol-value (datum-car pair)))
             (same (datum-symbol-value (read-value! (read port))))
             (spelling (symbol->string same))
             (first (datum-string-value (read-value! (read port))))
             (second (datum-string-value (read-value! (read port)))))
        (datum-set-cdr! pair (datum-number (exact-number 42)))
        (string-set! first 0 #\X)
        (string-set! spelling 0 #\X)
        (and (symbol=? name same) (string=? (symbol->string name) "same")
             (string=? first "Xext") (string=? second "text")
             (datum=? (datum-cdr alias) (datum-number (exact-number 42)))
             (read-end? (read port)))))))

;; ---- Observe every datum field independently of the final-value predicate ----

(define-extern emit-i64 "reader.test" "emit_i64" (-> I64 Unit))
(define-extern emit-f64 "reader.test" "emit_f64" (-> F64 Unit))
(define-extern emit-char "reader.test" "emit_char" (-> Char Unit))
(: observe-string (-> String Unit))
(define (observe-string text)
  (emit-i64 (string-length text))
  (let loop ((index 0))
    (unless (= index (string-length text))
      (emit-char (string-ref text index)) (loop (+ index 1)))))
(: observe-rational (-> Rational Unit))
(define (observe-rational value)
  (emit-i64 3)
  (observe-string (integer->string (rational-numerator value)))
  (observe-string (integer->string (rational-denominator value))))
(: observe-scalar (-> Scalar Unit))
(define (observe-scalar value)
  (match value
    ((exact-scalar value) (emit-i64 0) (emit-i64 value))
    ((rational-scalar value) (observe-rational value))
    ((inexact-scalar value) (emit-i64 1) (emit-f64 value))))
(: observe-number (-> Number Unit))
(define (observe-number value)
  (match value
    ((exact-number value) (emit-i64 0) (emit-i64 value))
    ((rational-number value) (observe-rational value))
    ((inexact-number value) (emit-i64 1) (emit-f64 value))
    ((complex-number real imaginary) (emit-i64 2) (observe-scalar real) (observe-scalar imaginary))))
(: observe (-> Datum Unit))
(define (observe datum)
  ;; Recursive constructors are private so callers cannot forge traversal IDs.
  ;; Observe the same nine public contents through read-only projections.
  (let ((kind (datum-kind datum)))
    (emit-i64 kind)
    (if (= kind 0) (unit)
        (if (= kind 1) (emit-i64 (if (datum-boolean-value datum) 1 0))
            (if (= kind 2) (emit-char (datum-character-value datum))
                (if (= kind 3) (observe-string (datum-string-value datum))
                    (if (= kind 4) (let ((value (datum-symbol-value datum))) (observe-string (symbol->string value)))
                        (if (= kind 5) (observe-number (datum-number-value datum))
                            (if (= kind 6) (begin (observe (datum-car datum)) (observe (datum-cdr datum)))
                                (if (= kind 7) (observe-vector (datum-vector-values datum))
                                    (observe-bytes (datum-bytevector-values datum))))))))))))
(: observe-vector (-> (Vector Datum) Unit))
(define (observe-vector values)
  (emit-i64 (vector-length values))
  (let loop ((index 0))
    (unless (= index (vector-length values))
      (observe (vector-ref values index)) (loop (+ index 1)))))
(: observe-bytes (-> Bytevector Unit))
(define (observe-bytes values)
  (emit-i64 (bytevector-length values))
  (let loop ((index 0))
    (unless (= index (bytevector-length values))
      (emit-i64 (bytevector-u8-ref values index)) (loop (+ index 1)))))
(: scan (-> I64))
(define (scan)
  (call-with-input-file "input.scm"
    (lambda (port)
      (let loop ((count 0))
        (match (read port)
          ((read-value value) (observe value) (loop (+ count 1)))
          ((read-end) (if (read-end? (read port)) count (unreachable)))
          ((read-error message) (emit-i64 99) (observe-string message) -1))))))
(unit)
