(import (snail strict) (snail datum))

;; ---- Exactness, stable symbols and observable mutable datum fields ----

(: parsed (-> String Number))
(define (parsed text) (parsed-number-value (string->number text)))
(: check (-> I64))
(define (check)
  (let* ((name (string->symbol "λ😀")) (same (string->symbol (string-copy "λ😀")))
         (pair (datum-cons (datum-symbol name) (datum-null))))
    (datum-set-car! pair (datum-number (parsed "#e9007199254740993.0")))
    (if (and (symbol=? name same) (string=? (symbol->string name) "λ😀")
             (number-equivalent? (parsed "#x-8000000000000000") (exact-number -9223372036854775808))
             (number-equivalent? (parsed "1+0i") (parsed "1"))
             (not (number-equivalent? (parsed "0.0") (parsed "-0.0")))
             (number-equivalent? (parsed "+nan.0") (parsed "-nan.0"))
             (not (number-equivalent? (parsed "1") (parsed "1.0")))
             (datum=? (datum-car pair) (datum-number (exact-number 9007199254740993)))
             (= (number->f64 (parsed "12.5")) 12.5))
        42 0)))
(unit)
