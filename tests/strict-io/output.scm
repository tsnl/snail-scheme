(import (snail strict) (snail io))

;; ---- Real text files and concrete callback results ----

(: format-number (-> I64 I64))
(define (format-number number)
  (call-with-output-file "number.txt"
    (lambda (port) (write-i64 number port) (newline port) number)))
(: unicode (-> I64))
(define (unicode)
  (call-with-output-file "λ😀.txt"
    (lambda (port)
      (write-string "\x0;λ😀\x10ffff;" port)
      (write-char #\newline port)
      42)))
(: callback-result (-> F64))
(define (callback-result)
  (call-with-output-file "result.txt" (lambda (port) (write-string "answer" port) 1.25)))
(: exists (-> Bool))
(define (exists) (file-exists? "λ😀.txt"))
(: remove (-> Unit))
(define (remove) (delete-file "λ😀.txt"))
(: close-alias (-> Unit))
(define (close-alias)
  (let* ((port (open-output-file "alias.txt")) (alias port))
    (write-string "once" alias)
    (close-output-port port)
    (close-output-port alias)))
(: callback-close (-> I64))
(define (callback-close)
  (call-with-output-file "self-close.txt"
    (lambda (port) (write-string "closed" port) (close-output-port port) 19)))

;; ---- Each failure runs in a fresh, terminal instance ----

(: escaped-alias (-> Unit))
(define (escaped-alias)
  (let ((port (call-with-output-file "escaped.txt" (lambda (port) port))))
    (close-output-port port)
    (write-char #\x port)))
(: missing-directory (-> Unit))
(define (missing-directory)
  (call-with-output-file "missing/file.txt" (lambda (port) (write-char #\x port))))
(: nul-path (-> Bool))
(define (nul-path) (file-exists? "nul\x0;path"))
(: delete-absent (-> Unit))
(define (delete-absent) (delete-file "absent.txt"))
(: callback-trap (-> Unit))
(define (callback-trap)
  (call-with-output-file "trap.txt" (lambda (port) (write-string "buffered" port) (unreachable))))
(: close-failure (-> Unit))
(define (close-failure)
  (let ((first (open-output-file "first.txt")) (second (open-output-file "second.txt")))
    (write-string "first" first)
    (write-string "second" second)
    (close-output-port first)))

;; Declaring the scalar character parameter as I32 deliberately tests malformed
;; foreign callers. Public Scheme callers use Char and cannot create a surrogate.
(define-extern raw-begin "snail.library" "snail:io/path-begin" (-> Unit))
(define-extern raw-character "snail.library" "snail:io/path-character" (-> I32 Unit))
(define-extern raw-close "snail.library" "snail:io/close" (-> I32 Unit))
(: invalid-character (-> Unit))
(define (invalid-character) (raw-begin) (raw-character (ann 55296 I32)))
(: invalid-handle (-> Unit))
(define (invalid-handle) (raw-close (ann -1 I32)))
(: interrupted-path (-> Unit))
(define (interrupted-path) (raw-begin) (raw-character (ann 65 I32)) (unreachable))
(unit)
