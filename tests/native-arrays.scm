(import (scheme base) (scheme write) (scheme process-context)
        (snail-scheme iverson-ghost) (snail-scheme extensions))
(define kept (array '(2) '(41 42) 'i32))
(rust-remember kept)
(let loop ((left 64))
  (when (> left 0)
    (array '(2) (list left left) 'i32)
    (loop (- left 1))))
(unless (equal? (array->vector kept) '#(41 42))
  (error "native retained numeric array differs"))
(when (and (pair? (cdr (command-line)))
           (string=? (cadr (command-line)) "arrays-trap"))
  (error "native numeric resource failure"))
(display "native numeric resource checks passed\n")
