;; Produce actual compiler artifacts for execution-adapter contracts.
(import (scheme base) (scheme file) (scheme process-context) (chibi filesystem)
        (lofi reader) (lofi syntax-parser) (wasm-native chromium-trace)
        (lofi primitives) (lofi frontend) (lofi compiler bootstrap)
        (lofi native)
        (only (lofi artifact) emit-artifact))

(define directory (cadr (command-line)))
(define (parsed text)
  (parse-library (car (reader->syntax-list (string->reader "execution-fixture.sld" text)))))
(define libraries
  (with-chromium-trace-to
   (string-append directory "/parse.json")
   (lambda ()
     (let ((state (parsed "(define-library (execution state)
                            (import (only (lofi primitive) ref ref-get ref-set! i32-add)) (export step)
                            (begin (define-extern mark \"probe\" \"mark\" (-> I32 Unit))
                              (mark (ann 1 I32)) (def counter (ref (ann 0 I32)))
                              (def step (-> I32 I32) (lambda (amount)
                                (begin (ref-set! counter (i32-add (ref-get counter) amount)) (ref-get counter))))))"))
           (facade (parsed "(define-library (execution facade)
                             (import (execution state) (only (execution alias))) (export (rename step main))
                             (begin (define-extern mark \"probe\" \"mark\" (-> I32 Unit)) (mark (ann 2 I32))))"))
           (failed (parsed "(define-library (execution failed)
                             (import (only (lofi primitive) unreachable)) (export entry)
                             (begin (define-extern mark \"probe\" \"mark\" (-> I32 Unit))
                               (def entry (-> I32 I32) (lambda (x) x)) (mark (ann 7 I32)) (unreachable)))"))
           (dependent (parsed "(define-library (execution dependent) (import (execution failed)) (export entry)
                                (begin (define-extern mark \"probe\" \"mark\" (-> I32 Unit)) (mark (ann 9 I32))))"))
           (scalars (parsed "(define-library (execution scalars) (import (only (lofi primitive) unit))
                              (export i32 i64 f32 f64 bool char unit-result)
                              (begin (def i32 (-> I32 I32) (lambda (x) x)) (def i64 (-> I64 I64) (lambda (x) x))
                                (def f32 (-> F32 F32) (lambda (x) x)) (def f64 (-> F64 F64) (lambda (x) x))
                                (def bool (-> Bool Bool) (lambda (x) x)) (def char (-> Char Char) (lambda (x) x))
                                (def unit-result (-> Unit) (lambda () (unit)))))"))
           (traps (parsed "(define-library (execution traps)
                            (import (only (lofi primitive) ref ref-get ref-set! i32-add i32-eq unreachable)) (export entry)
                            (begin (def counter (ref (ann 0 I32)))
                              (def entry (-> I32 I32) (lambda (x)
                                (begin (ref-set! counter (i32-add (ref-get counter) (ann 1 I32)))
                                  (if (i32-eq x (ann 0 I32)) (unreachable) (ref-get counter)))))))"))
           (foreign (parsed "(define-library (execution foreign) (export bad-bool bad-char callback)
                              (begin (define-extern bad-bool \"probe\" \"bad-bool\" (-> Bool))
                                (define-extern bad-char \"probe\" \"bad-char\" (-> Char))
                                (define-extern callback \"probe\" \"callback\" (-> I32))))")))
       (list (cons '(lofi primitive) (make-primitive-library primitive-names))
             (cons '(execution state) state) (cons '(execution alias) state) (cons '(execution facade) facade)
             (cons '(execution failed) failed) (cons '(execution dependent) dependent)
             (cons '(execution scalars) scalars) (cons '(execution traps) traps) (cons '(execution foreign) foreign))))))
(define (save artifact name)
  (call-with-port (open-binary-output-file (string-append directory "/" name))
    (lambda (port) (write-bytevector (artifact-bytes artifact) port))))
(define (build library export name)
  (save (compile libraries (make-entry library export)) (string-append name ".wasm")))

(build '(execution facade) 'main "state")
(build '(execution dependent) 'entry "failed")
(build '(execution traps) 'entry "traps")
(for-each (lambda (name) (build '(execution scalars) name (symbol->string name))) '(i32 i64 f32 f64 bool char unit-result))
(for-each (lambda (name) (build '(execution foreign) name (symbol->string name))) '(bad-bool bad-char callback))
(create-directory* (string-append directory "/native"))
(artifact->native-object (compile libraries (make-entry '(execution scalars) 'i32)) '()
                         (string-append directory "/native") (string-append directory "/native.o"))

;; Deliberately inconsistent saved metadata tests the actual export checks.
(for-each
 (lambda (case)
   (save (emit-artifact
          `(module (import "probe" "mark" (func $mark (param i32)))
                   (func (export "main") ,@(if (eq? case 'wrong-main) '((result i32)) '())
                         (call $mark (i32.const 8)) ,@(if (eq? case 'wrong-main) '((i32.const 0)) '()))
                   (func (export "entry") (param ,(if (eq? case 'wrong-entry) 'i64 'i32)) (result i32) (i32.const 0)))
          (make-entry '(execution invalid) 'entry) '(I32) 'I32)
         (string-append (symbol->string case) ".wasm")))
 '(wrong-main wrong-entry))
