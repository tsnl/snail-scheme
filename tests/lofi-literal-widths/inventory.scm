;; Record intrinsic numeric representations at source locations for migration
;; audits. This helper neither rewrites source nor participates in compilation.
(import
 (scheme base)
 (scheme file)
 (scheme write)
 (scheme process-context)
 (lofi compiler source-driver)
 (lofi compiler checked)
 (lofi compiler ir)
 (lofi compiler source)
 (only (lofi compiler infer) infer-literal judgment-type judgment-detail)
 (only (native chromium-trace) with-chromium-trace-to)
 (only (scheme hash-table) make-hash-table hash-table-ref/default hash-table-set!))

(define (record-literals program port)
  (let ((seen (make-hash-table eq?)))
    (define (visit node selected)
      (when (and (node? node) (not (hash-table-ref/default seen node #f)))
        (hash-table-set! seen node #t)
        (case (node-kind node)
          ((literal)
           (let* ((result (infer-literal node selected)) (type (judgment-type result)) (loc (node-loc node)))
             (when (and (loc? loc) (memq type '(I32 I64 F32 F64)))
               (write (list (loc-filename loc) (loc-line loc) (loc-column loc)
                            type (judgment-detail result)) port)
               (newline port))))
          ((annotation) (visit (annotation-expression node) (annotation-type node)))
          ((bind)
           (let ((declaration (binding-declaration (value-binding-definition node))))
             (visit (value-binding-initializer node) (and declaration (type-declaration-type declaration)))))
          (else (for-each (lambda (child) (visit child #f)) (children node))))))
    (visit (program-body program) #f)))

(let* ((arguments (cdr (command-line))) (root (car arguments))
       (source (cadr arguments)) (output (car (cddr arguments))))
  (with-chromium-trace-to
   (string-append output ".trace.json")
   (lambda ()
     (let ((program (source-file->core root source)))
       (call-with-output-file output
         (lambda (port) (record-literals program port)))))))
