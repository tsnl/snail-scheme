;; The producer map is explicit and is discarded before receiving its output.
(import
 (scheme base)
 (scheme file)
 (scheme process-context)
 (lofi reader)
 (lofi syntax-parser)
 (wasm-native chromium-trace)
 (lofi primitives)
 (lofi frontend)
 (lofi compiler bootstrap))

(define directory (cadr (command-line)))
(define (parse-file path) (parse-library (car (reader->syntax-list (file->reader path)))))
(define (parsed text) (parse-library (car (reader->syntax-list (string->reader "builder-provider.sld" text)))))
(define libraries
  (with-chromium-trace-to
   (string-append directory "/producer-parse.json")
   (lambda ()
     (list (cons '(lofi primitive) (make-primitive-library primitive-names))
           (cons '(lofi compiler-builder) (parse-file "src/lofi/compiler-builder.sld"))
           (cons '(builder producer) (parse-file "tests/lofi-builder/producer.sld"))
           (cons '(builder example) (parse-file "examples/library-builder.sld"))
           (cons '(builder scalars) (parse-file "tests/lofi-builder/scalars.sld"))
           (cons '(builder initial-failure)
                 (parsed "(define-library (builder initial-failure) (import (lofi compiler-builder)) (export run)
                            (begin (def run (-> I64) (lambda () (ann 0 I64)))
                              (source-span (builder-name \"bad-init.sld\") (ann 0 I32) (ann 1 I32))))"))
           (cons '(output arithmetic)
                 (parsed "(define-library (output arithmetic) (import (only (lofi primitive) i32-add))
                            (export sum) (begin (def sum (-> I32 I32 I32) (lambda (x y) (i32-add x y)))))"))))))
(for-each
 (lambda (name)
   (let ((artifact (compile libraries (make-entry '(builder producer) name))))
     (call-with-port (open-binary-output-file (string-append directory "/" (symbol->string name) ".wasm"))
       (lambda (port) (write-bytevector (artifact-bytes artifact) port)))))
 '(build fail wrong-token wrong-kind bad-location))
(let ((artifact (compile libraries (make-entry '(builder example) 'build))))
  (call-with-port (open-binary-output-file (string-append directory "/example.wasm"))
    (lambda (port) (write-bytevector (artifact-bytes artifact) port))))
(let ((artifact (compile libraries (make-entry '(builder initial-failure) 'run))))
  (call-with-port (open-binary-output-file (string-append directory "/initial-failure.wasm"))
    (lambda (port) (write-bytevector (artifact-bytes artifact) port))))
(for-each
 (lambda (name)
   (let ((artifact (compile libraries (make-entry '(builder scalars) name))))
     (call-with-port (open-binary-output-file (string-append directory "/" (symbol->string name) ".wasm"))
       (lambda (port) (write-bytevector (artifact-bytes artifact) port)))))
 '(build-i64 build-f32 build-f64 build-bool build-char))
