;; This compiler host owns no producer code or heap. The only input is syntax.
(import
 (scheme base)
 (scheme file)
 (scheme process-context)
 (scheme write)
 (chibi filesystem)
 (lofi compiler reader)
 (lofi compiler syntax-parser)
 (lofi host chromium-trace)
 (lofi compiler primitives)
 (lofi compiler frontend)
 (lofi compiler bootstrap)
 (lofi compiler library-transfer)
 (only (lofi host test-utils) expect)
 (only (srfi 130) string-contains))
(define directory (cadr (command-line)))
(define (receive name)
  (receive-library-transfer (make-library-transfer-context)
                            (call-with-input-file (string-append directory "/" name ".json") read-library-transfer)))
(define generated (receive "complete"))
(define source
  (with-chromium-trace-to (string-append directory "/complete-source-parse.json")
                          (lambda () (parse-library (car (reader->syntax-list (file->reader "tests/lofi-builder/complete-source.sld")))))))
(define provider
  (with-chromium-trace-to (string-append directory "/complete-provider-parse.json")
                          (lambda () (parse-library (car (reader->syntax-list (file->reader "tests/lofi-builder/complete-provider.sld")))))))
(define primitive (cons '(lofi primitive) (make-primitive-library primitive-names)))

(define (write-result library name export)
  (let ((artifact (compile (list primitive (cons '(complete provider) provider) (cons '(complete result) library)) (make-entry '(complete result) export))))
    (call-with-port (open-binary-output-file (string-append directory "/" name ".wasm"))
      (lambda (port) (write-bytevector (artifact-bytes artifact) port)))))
(for-each
 (lambda (pair)
   (write-result (cdr pair) (string-append "complete-" (car pair)) 'run)
   (write-result (cdr pair) (string-append "complete-" (car pair) "-literals") 'literals))
 (list (cons "generated" generated) (cons "source" source) (cons "parsed" (receive "parsed"))))
(for-each
 (lambda (case)
   (expect (guard (failure (else (and (error-object? failure)
                                      (if (string-contains (error-object-message failure) (cdr case)) #t #f))))
             (receive (string-append "bad-" (car case))) #f) #t))
 '(("future-let" . "escapes its lexical scope") ("variable-scope" . "different scope")
   ("escaped-variable" . "type variable escapes") ("block-parent" . "wrong parent")
   ("static-value" . "wrong kind") ("byte-range" . "byte literal")
   ("duplicate-static-binding" . "duplicate binding") ("forged-evidence" . "unsupported transfer scalar type")
   ("surrogate-text" . "Unicode scalar values") ("reserved-binding" . "reserved Lofi keyword")
   ("reserved-variable" . "reserved Lofi keyword") ("duplicate-variable-name" . "duplicate transfer name")
   ("class-as-type" . "wrong kind") ("value-as-constraint" . "wrong kind")
   ("kind-type" . "unsupported transfer node") ("kind-constraint" . "unsupported transfer node")
   ("kind-function" . "unsupported transfer node") ("kind-evidence" . "unsupported transfer node")
   ("kind-annotation" . "unsupported transfer node")
   ("rest-type" . "unsupported transfer node") ("rest-function-type" . "unsupported transfer node")
   ("rest-lambda" . "unsupported transfer node")
   ("shared-reference-first" . "escapes its lexical scope") ("shared-reference-last" . "escapes its lexical scope")))
(display "PASS complete syntax reception, lexical/type ownership, declaration roles and unforgeable checking\n")
