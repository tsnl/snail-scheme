;; Construct the source-equivalent library in complete-source.sld. Every
;; reference below names an identity or an explicitly imported binding.
(define-library (builder complete)
  (import (lofi compiler-builder) (lofi primitive) (builder rebuild))
  (export build)
  (begin
    (def items (All (T) (-> (Rest T) (List T))) (lambda values values))
    (def span (source-span (builder-name "complete-generated.sld") 17 3))
    (def named (-> ScopeId String BindingId)
         (lambda (scope text) (binding scope (builder-name text) span)))
    (def use (-> BindingId Expression)
         (lambda (binding) (reference-expression (local-reference binding span))))
    (def imported (-> ScopeId String Expression)
         (lambda (scope text) (reference-expression (import-reference scope (builder-name text) span))))
    (def call (-> Expression (Rest Expression) Expression)
         (lambda (operator . arguments) (application-expression operator arguments span)))
    (def integer (-> I32 Expression) (lambda (value) (literal-i32 value span)))

    ;; Generic schemes bind fresh type identities even when their names agree.
    (def identity-definition (-> ScopeId BindingId Declaration)
         (lambda (scope identity)
           (begin
             (let types (nested-scope scope))
             (let t (type-variable types (builder-name "T") span))
             (let signature (all-signature types (items t) (items)
                                           (function-type (items (variable-type t)) (variable-type t)) span))
             (let body (nested-scope scope))
             (let x (named body "value"))
             (signature-definition identity signature (lambda-expression body (items x) (use x) span) span))))
    ;; The two T spellings denote different rigid identities. The inner
    ;; initializer can still annotate its captured value with the outer T.
    (def nested-definition (-> ScopeId BindingId Declaration)
         (lambda (scope nested)
           (begin
             (let outer-types (nested-scope scope))
             (let outer-t (type-variable outer-types (builder-name "T") span))
             (let outer-signature (all-signature outer-types (items outer-t) (items)
                                                 (function-type (items (variable-type outer-t)) (variable-type outer-t)) span))
             (let outer-body (nested-scope scope))
             (let x (named outer-body "value"))
             (let block (nested-scope outer-body))
             (let inner (named block "inner"))
             (let inner-types (nested-scope block))
             (let inner-t (type-variable inner-types (builder-name "T") span))
             (let inner-signature (all-signature inner-types (items inner-t) (items)
                                                 (function-type (items (variable-type inner-t)) (variable-type inner-t)) span))
             (let inner-body (nested-scope block))
             (let y (named inner-body "value"))
             (let inner-block (nested-scope inner-body))
             (signature-definition nested outer-signature
                                   (lambda-expression outer-body (items x)
                                                      (block-expression block
                                                                        (items (signature-definition inner inner-signature
                                                                                                     (lambda-expression inner-body (items y)
                                                                                                                        (block-expression inner-block
                                                                                                                                          (items (expression-statement (annotation-expression (use x) (variable-type outer-t) span)))
                                                                                                                                          (use y) span) span) span))
                                                                        (call (use inner) (use x)) span) span) span))))
    (def reader-definition (-> ScopeId BindingId BindingId BindingId Declaration)
         (lambda (scope reader class method)
           (begin
             (let types (nested-scope scope))
             (let t (type-variable types (builder-name "T") span))
             (let requirement (constraint (local-reference class span) (items (variable-type t)) span))
             (let signature (all-signature types (items t) (items requirement)
                                           (function-type (items (variable-type t)) (type-i32)) span))
             (let body (nested-scope scope))
             (let x (named body "value"))
             (signature-definition reader signature
                                   (lambda-expression body (items x) (call (use method) (use x)) span) span))))
    (def box-definition (-> ScopeId BindingId BindingId BindingId Declaration)
         (lambda (scope box-type box accessor)
           (begin
             (let types (nested-scope scope))
             (let t (type-variable types (builder-name "T") span))
             (kind-annotated-definition (function-kind (items (kind-type)) (kind-type))
                                        (datatype-definition box-type types (items t)
                                                             (items (data-constructor box
                                                                                      (items (accessor-field (builder-name "value") (variable-type t) accessor span)) span)) span) span))))
    (def value-class (-> ScopeId BindingId BindingId Declaration)
         (lambda (scope class method)
           (begin
             (let types (nested-scope scope))
             (let t (type-variable types (builder-name "T") span))
             (kind-annotated-definition (function-kind (items (kind-type)) (kind-constraint))
                                        (typeclass-definition class types (items t)
                                                              (items (class-method method (function-type (items (variable-type t)) (type-i32)) span)) span) span))))
    (def value-instance (-> ScopeId BindingId BindingId BindingId Declaration)
         (lambda (scope instance-binding class method)
           (begin
             (let head (constraint (local-reference class span) (items (type-i32)) span))
             (let body (nested-scope scope))
             (let x (named body "value"))
             (kind-annotated-definition (evidence-kind head)
                                        (instance-definition instance-binding head
                                                             (items (method-implementation (local-reference method span)
                                                                                           (lambda-expression body (items x) (use x) span) span)) span) span))))
    (def rest-definition (-> ScopeId BindingId Declaration)
         (lambda (scope binding)
           (begin
             (let body (nested-scope scope))
             (let first (named body "first"))
             (let rest (named body "rest"))
             (definition binding (rest-function-type (items (type-i32)) (type-i32) (type-i32))
               (rest-lambda-expression body (items first) rest
                                       (call (imported scope "i32-add") (use first) (call (imported scope "car") (use rest))) span) span))))
    (def integer-overload (-> ScopeId BindingId Declaration)
         (lambda (scope family)
           (begin
             (let body (nested-scope scope))
             (let x (named body "value"))
             (overload-definition family (binding-signature (function-type (items (type-i32)) (type-i32)))
                                  (lambda-expression body (items x) (use x) span) span))))
    (def boolean-overload (-> ScopeId BindingId Declaration)
         (lambda (scope family)
           (begin
             (let body (nested-scope scope))
             (let x (named body "value"))
             (overload-definition family (binding-signature (function-type (items (type-bool)) (type-bool)))
                                  (lambda-expression body (items x)
                                                     (conditional-expression (use x) (literal-bool #f span) (literal-bool #t span) span) span) span))))

    ;; Local definitions are recursive; lets introduce identities sequentially.
    (def run-definition (-> ScopeId BindingId BindingId BindingId BindingId BindingId BindingId BindingId BindingId BindingId BindingId Declaration)
         (lambda (scope run box-type box accessor identity reader rest family counter nested)
           (begin
             (let function-scope (nested-scope scope))
             (let input (named function-scope "input"))
             (let body (nested-scope function-scope))
             (let first (named body "shadow"))
             (let later (named body "shadow"))
             (let captured (named body "captured"))
             (let capture-scope (nested-scope body))
             (let cell (named body "cell"))
             (let vector-value (named body "vector-value"))
             (let boxed (named body "boxed"))
             (let dynamic (named body "dynamic"))
             (let external (named body "external"))
             (let matched (named body "matched"))
             (let arm-scope (nested-scope body))
             (let field (named arm-scope "field"))
             (definition run (function-type (items (type-i32)) (type-i32))
               (lambda-expression function-scope (items input)
                                  (block-expression body
                                                    (items
                                                     (inferred-local-binding first (integer 5) span)
                                                     (inferred-definition captured (lambda-expression capture-scope (items) (use first) span) span)
                                                     (local-binding later (binding-signature (type-i32)) (integer 7) span)
                                                     (local-binding cell (binding-signature (reference-type (type-i32)))
                                                                    (call (imported scope "ref") (integer 2)) span)
                                                     (local-binding vector-value (binding-signature (vector-type (type-i32)))
                                                                    (call (imported scope "make-vector") (literal-i64 (ann 1 I64) span)
                                                                          (call (imported scope "car")
                                                                                (annotation-expression
                                                                                 (call (imported scope "cons") (integer 3) (call (imported scope "empty-list")))
                                                                                 (list-type (type-i32)) span))) span)
                                                     (local-binding boxed (binding-signature (nominal-type (local-reference box-type span) (items (type-i32))))
                                                                    (call (use box) (use input)) span)
                                                     (local-binding dynamic (binding-signature (type-any)) (use input) span)
                                                     (extern-definition external "tests.builder" "add" (function-type (items (type-i32) (type-i32)) (type-i32)) span)
                                                     (inferred-local-binding matched
                                                                             (match-expression (use boxed)
                                                                                               (items (match-arm (local-reference box span) arm-scope (items field) (use field) span)) span) span)
                                                     (expression-statement (call (imported scope "ref-set!") (use counter) (integer 3)))
                                                     (expression-statement (call (imported scope "unit"))))
                                                    (call (use external)
                                                          (call (use rest)
                                                                (call (use reader)
                                                                      (call (instantiation-expression (local-reference identity span) (items (type-i32)) span)
                                                                            (call (use nested) (call (use family) (use matched)))))
                                                                (call (use captured)))
                                                          (call (imported scope "i32-add")
                                                                (call (imported scope "i64->i32")
                                                                      (call (use family) (call (imported scope "i32->i64")
                                                                                               (annotation-expression (use dynamic) (type-i32) span))))
                                                                (call (imported scope "i32-add")
                                                                      (call (imported scope "ref-get") (use cell))
                                                                      (call (imported scope "i32-add") (use later)
                                                                            (call (imported scope "i32-add")
                                                                                  (call (imported scope "vector-ref") (use vector-value) (literal-i64 (ann 0 I64) span))
                                                                                  (call (imported scope "i32-add")
                                                                                        (call (use accessor) (use boxed))
                                                                                        (call (imported scope "ref-get") (use counter)))))))) span) span) span))))

    ;; Inspection returns copied text/bytes and preserves syntax child IDs.
    (def inspect-copies (-> Expression Expression Unit)
         (lambda (text bytes)
           (begin
             (match (inspect-expression text)
               ((view-string-literal value location) (string-set! value (ann 0 I64) #\x))
               ((view-number-literal spelling location) (unreachable))
               ((view-literal-i32 value location) (unreachable))
               ((view-literal-i64 value location) (unreachable))
               ((view-literal-f32 value location) (unreachable))
               ((view-literal-f64 value location) (unreachable))
               ((view-literal-bool value location) (unreachable))
               ((view-literal-char value location) (unreachable))
               ((view-bytevector-literal value location) (unreachable))
               ((view-reference reference) (unreachable))
               ((view-lambda scope parameters body location) (unreachable))
               ((view-rest-lambda scope parameters rest body location) (unreachable))
               ((view-application operator arguments location) (unreachable))
               ((view-conditional test yes no location) (unreachable))
               ((view-block scope statements result location) (unreachable))
               ((view-annotation expression type location) (unreachable))
               ((view-instantiation reference arguments location) (unreachable))
               ((view-match subject arms location) (unreachable)))
             (match (inspect-expression bytes)
               ((view-bytevector-literal value location) (bytevector-u8-set! value (ann 0 I64) (ann 255 I64)))
               ((view-number-literal spelling location) (unreachable))
               ((view-literal-i32 value location) (unreachable))
               ((view-literal-i64 value location) (unreachable))
               ((view-literal-f32 value location) (unreachable))
               ((view-literal-f64 value location) (unreachable))
               ((view-literal-bool value location) (unreachable))
               ((view-literal-char value location) (unreachable))
               ((view-string-literal value location) (unreachable))
               ((view-reference reference) (unreachable))
               ((view-lambda scope parameters body location) (unreachable))
               ((view-rest-lambda scope parameters rest body location) (unreachable))
               ((view-application operator arguments location) (unreachable))
               ((view-conditional test yes no location) (unreachable))
               ((view-block scope statements result location) (unreachable))
               ((view-annotation expression type location) (unreachable))
               ((view-instantiation reference arguments location) (unreachable))
               ((view-match subject arms location) (unreachable))))))
    (def produce (-> LofiLibrary)
         (lambda ()
           (begin
             (let scope (library-scope))
             (let box-type (named scope "Box")) (let box (named scope "box")) (let accessor (named scope "box-value"))
             (let class (named scope "Value")) (let method (named scope "value")) (let instance-binding (named scope "int-value"))
             (let identity (named scope "identity")) (let nested (named scope "nested")) (let reader (named scope "read-value"))
             (let rest (named scope "first-two")) (let family (named scope "choose"))
             (let counter (named scope "counter")) (let run (named scope "run"))
             (let text (named scope "text")) (let bytes (named scope "bytes")) (let literal-result (named scope "literal-result"))
             (let text-value (literal-string "A🙂\x0;Z" span))
             (let byte-value (literal-bytevector #u8(1 0 255) span))
             (let literal-scope (nested-scope scope))
             (inspect-copies text-value byte-value)
             (let result-library
                 (lofi-library (items (builder-name "complete") (builder-name "result")) scope
                               (items (library-import (items (builder-name "lofi") (builder-name "primitive")) (all-imports) scope span)
                                      (library-import (items (builder-name "complete") (builder-name "provider"))
                                                      (rename-imports (all-imports) (items (import-rename (builder-name "operation") (builder-name "choose")))) scope span))
                               (items (library-export (builder-name "run") (local-reference run span))
                                      (library-export (builder-name "literals") (local-reference literal-result span))
                                      (library-export (builder-name "Box") (local-reference box-type span))
                                      (library-export (builder-name "box") (local-reference box span)))
                               (items (box-definition scope box-type box accessor) (value-class scope class method)
                                      (value-instance scope instance-binding class method)
                                      (identity-definition scope identity) (nested-definition scope nested) (reader-definition scope reader class method)
                                      (rest-definition scope rest) (integer-overload scope family) (boolean-overload scope family)
                                      (inferred-local-binding counter (call (imported scope "ref") (integer 0)) span)
                                      (definition text (type-string) text-value span)
                                      (definition bytes (type-bytevector) byte-value span)
                                      (definition literal-result (function-type (items) (type-i32))
                                        (lambda-expression literal-scope (items)
                                                           (call (imported scope "i32-add")
                                                                 (call (imported scope "i64->i32")
                                                                       (call (imported scope "char->integer")
                                                                             (call (imported scope "string-ref") (use text) (literal-i64 (ann 0 I64) span))))
                                                                 (call (imported scope "i64->i32")
                                                                       (call (imported scope "bytevector-u8-ref") (use bytes) (literal-i64 (ann 0 I64) span)))) span) span)
                                      (run-definition scope run box-type box accessor identity reader rest family counter nested)) span))
             (match (inspect-library result-library)
               ((view-library key actual-scope imports exports declarations location)
                (if (same-scope? scope actual-scope)
                    (rebuild-library (lofi-library key actual-scope imports exports declarations location)) (unreachable)))))))
    (def build (-> I64) (lambda () (library-token (produce))))))
