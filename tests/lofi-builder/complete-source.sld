(define-library (complete source)
  (import
   (lofi primitive)
   (rename (complete provider) (operation choose)))
  (export run literals Box box)
  (begin
    (def Box (datatype (T)
               (box
                (value T box-value))))
    (def Value (typeclass (T) (: value (-> T I32))))
    (def int-value (instance (Value I32) (value (lambda (value) value))))
    (def identity (All (T) (-> T T)) (lambda (value) value))
    (def nested (All (Outer) (-> Outer Outer))
         (lambda (value)
           (begin
             (def inner (All (T) (-> T T))
                  (lambda (item) (begin (ann value Outer) item)))
             (inner value))))
    (def read-value (All (T) (requires (Value T)) (-> T I32)) (lambda (input) (value input)))
    (def first-two (-> I32 (Rest I32) I32) (lambda (first . rest) (i32-add first (car rest))))
    (define-overload choose (-> I32 I32) (lambda (value) value))
    (define-overload choose (-> Bool Bool) (lambda (value) (if value #f #t)))
    (let counter (ref 0))
    (def text String "A🙂\x0;Z")
    (def bytes Bytevector #u8(1 0 255))
    (def literals (-> I32)
         (lambda () (i32-add (i64->i32 (char->integer (string-ref text (ann 0 I64))))
                             (i64->i32 (bytevector-u8-ref bytes (ann 0 I64))))))
    (def run (-> I32 I32)
         (lambda (input)
           (begin
             (let shadow 5)
             (def captured (lambda () shadow))
             (let shadow I32 7)
             (let cell (Ref I32) (ref 2))
             (let vector-value (Vector I32) (make-vector (ann 1 I64) (car (ann (cons 3 (empty-list)) (List I32)))))
             (let boxed (Box I32) (box input))
             (let dynamic Any input)
             (define-extern external "tests.builder" "add" (-> I32 I32 I32))
             (let matched (match boxed ((box field) field)))
             (ref-set! counter 3)
             (unit)
             (external (first-two (read-value ((inst identity I32) (nested (choose matched)))) (captured))
                       (i32-add (i64->i32 (choose (i32->i64 (ann dynamic I32))))
                                (i32-add (ref-get cell)
                                         (i32-add shadow
                                                  (i32-add (vector-ref vector-value (ann 0 I64))
                                                           (i32-add (box-value boxed) (ref-get counter))))))))))))
