(import (scheme base) (scheme file) (scheme process-context)
        (lofi reader) (lofi syntax-parser) (wasm-native chromium-trace)
        (lofi primitives) (lofi frontend) (lofi compiler bootstrap) (lofi library-transfer))
(define directory (cadr (command-line)))
(define (parsed path) (parse-library (car (reader->syntax-list (file->reader path)))))
(with-chromium-trace-to
 (string-append directory "/complete-producer-parse.json")
 (lambda ()
   (let* ((libraries (list (cons '(lofi primitive) (make-primitive-library primitive-names))
                           (cons '(lofi compiler-builder) (parsed "src/lofi/compiler-builder.sld"))
                           (cons '(builder rebuild) (parsed "tests/lofi-builder/rebuild.sld"))
                           (cons '(builder complete) (parsed "tests/lofi-builder/complete.sld"))))
          (artifact (compile libraries (make-entry '(builder complete) 'build))))
     (call-with-port (open-binary-output-file (string-append directory "/complete-producer.wasm"))
       (lambda (port) (write-bytevector (artifact-bytes artifact) port))))))

;; Parse once; the resulting packet contains the parser's identities and syntax.
(with-chromium-trace-to
 (string-append directory "/parsed-producer-parse.json")
 (lambda ()
   (call-with-output-file (string-append directory "/parsed-source.json")
     (lambda (port) (write-library-transfer (parsed "tests/lofi-builder/complete-source.sld") port)))
   (let* ((libraries (list (cons '(lofi primitive) (make-primitive-library primitive-names))
                           (cons '(lofi compiler-builder) (parsed "src/lofi/compiler-builder.sld"))
                           (cons '(builder rebuild) (parsed "tests/lofi-builder/rebuild.sld"))
                           (cons '(builder parsed) (parsed "tests/lofi-builder/parsed-producer.sld"))))
          (artifact (compile libraries (make-entry '(builder parsed) 'build))))
     (call-with-port (open-binary-output-file (string-append directory "/parsed-producer.wasm"))
       (lambda (port) (write-bytevector (artifact-bytes artifact) port))))))
