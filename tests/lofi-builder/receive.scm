;; A new compiler host receives data only. It has no producer map or arena.
(import
 (scheme base)
 (scheme cxr)
 (scheme file)
 (scheme process-context)
 (scheme write)
 (lofi compiler reader)
 (lofi compiler syntax-parser)
 (native chromium-trace)
 (lofi compiler primitives)
 (lofi compiler frontend)
 (lofi compiler bootstrap)
 (lofi compiler library)
 (lofi compiler library-transfer)
 (only (lofi compiler ir) binding-origin value-binding-definition)
 (only (native test-utils) expect)
 (only (srfi 130) string-contains))

(define directory (cadr (command-line)))
(define context (make-library-transfer-context))
(define (read-transfer name)
  (call-with-input-file (string-append directory "/" name ".json") read-library-transfer))
(define transfer (read-transfer "first"))
(define first (receive-library-transfer context transfer))
(define same (receive-library-transfer context transfer))
(define copy (receive-library-transfer context (read-transfer "first")))
(define second (receive-library-transfer context (read-transfer "second")))
(define ill-typed (receive-library-transfer context (read-transfer "ill-typed")))
(define example (receive-library-transfer context (read-transfer "example")))
(expect (eq? first same) #t)
(expect (eq? (lofi-library-id first) (lofi-library-id copy)) #f)
(expect (eq? (lofi-library-id first) (lofi-library-id second)) #f)
(expect (eq? (binding-origin (value-binding-definition (car (lofi-library-declarations first))))
             (binding-origin (value-binding-definition (car (lofi-library-declarations second))))) #f)
(expect (lofi-library-name first) '(generated descriptive))

(define (parsed text) (parse-library (car (reader->syntax-list (string->reader "result-driver.sld" text)))))
(define libraries
  (with-chromium-trace-to
   (string-append directory "/receiver-parse.json")
   (lambda ()
     (list (cons '(lofi primitive) (make-primitive-library primitive-names))
           (cons '(output first) first) (cons '(output alias) first) (cons '(output second) second)
           (cons '(output example) example)
           (cons '(output arithmetic)
                 (parsed "(define-library (output arithmetic) (import (only (lofi primitive) i32-add))
                            (export sum) (begin (def sum (-> I32 I32 I32) (lambda (x y) (i32-add x y)))))"))
           (cons '(output combined)
                 (parsed "(define-library (output combined)
                            (import (rename (only (output first) run) (run first))
                                    (rename (only (output second) run) (run second))
                                    (only (output alias)) (only (lofi primitive) i32-add))
                            (export run) (begin (def run (-> I32 I32)
                              (lambda (x) (i32-add (first x) (second x))))))"))))))
(define (reject libraries key name message)
  (expect (guard (failure (else (and (error-object? failure)
                                     (if (string-contains (error-object-message failure) message) #t #f))))
            (compile libraries (make-entry key name)) #f) #t))

;; Missing output dependencies stay missing even though the producer used them.
(reject (list (cons '(output first) first)) '(output first) 'run "Lofi library not found")
(reject libraries '(output first) 'hidden "entry is not a public export")
(reject (cons (cons '(output invalid) ill-typed) libraries) '(output invalid) 'run "generated-example.sld:11:5:")
(for-each
 (lambda (selection)
   (let ((artifact (compile libraries (make-entry (car selection) (cadr selection)))))
     (call-with-port (open-binary-output-file (string-append directory "/" (caddr selection) ".wasm"))
       (lambda (port) (write-bytevector (artifact-bytes artifact) port)))))
 '(((output first) run "first-result") ((output alias) run "alias-result")
   ((output second) run "second-result") ((output first) reexport "reexport-result")
   ((output combined) run "combined-result")))
(let ((artifact (compile (list (cons '(generated answer) example))
                         (make-entry '(generated answer) 'run))))
  (call-with-port (open-binary-output-file (string-append directory "/example-result.wasm"))
    (lambda (port) (write-bytevector (artifact-bytes artifact) port))))
(display "PASS owned transfer identities, explicit result dependencies and located generated diagnostics\n")
(for-each
 (lambda (name)
   (let* ((library (receive-library-transfer context (read-transfer name)))
          (artifact (compile (list (cons '(scalar) library)) (make-entry '(scalar) 'run))))
     (call-with-port (open-binary-output-file (string-append directory "/" name "-result.wasm"))
       (lambda (port) (write-bytevector (artifact-bytes artifact) port)))))
 '("i64-min" "i64-max" "f32-zero" "f32-subnormal" "f32-max" "f64-roundtrip" "f64-max"
   "f64-subnormal" "f64-infinity" "f64-nan" "bool" "char"))
