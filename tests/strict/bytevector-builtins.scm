(import (snail strict) (snail bytes))
(define (same-bytes? left right)
  (and (= (bytevector-length left) (bytevector-length right))
       (let loop ((index 0))
         (or (= index (bytevector-length left))
             (and (= (bytevector-u8-ref left index) (bytevector-u8-ref right index))
                  (loop (+ index 1)))))))
(define source (bytevector 0 127 128 255))
(define alias (ann (ann source Top) Bytevector))
(define copied (bytevector-copy source))
(define joined (bytevector-append #u8() source #u8(42)))
(define one (bytevector-append source))
(define empty (make-bytevector 0))
(define overlap (bytevector 1 2 3 4 5))
(bytevector-u8-set! alias 0 254)
(bytevector-copy! overlap 1 overlap 0 4)
(define right-correct (same-bytes? overlap #u8(1 1 2 3 4)))
(bytevector-copy! overlap 0 overlap 1 5)
(define left-correct (same-bytes? overlap #u8(1 2 3 4 4)))
(bytevector-copy! overlap 5 overlap 5 5)
(define by-procedure bytevector-u8-ref)
(if (and (bytevector-eq? source alias)
         (= (by-procedure source 0) 254)
         (same-bytes? copied #u8(0 127 128 255))
         (same-bytes? joined #u8(0 127 128 255 42))
         (same-bytes? one copied)
         (not (bytevector-eq? one copied))
         (same-bytes? (bytevector-copy copied 1 3) #u8(127 128))
         (same-bytes? (bytevector-copy copied 2) #u8(128 255))
         (same-bytes? (make-bytevector 3 255) #u8(255 255 255))
         (same-bytes? (make-bytevector 2) #u8(0 0))
         (not (bytevector-eq? empty (bytevector-copy empty)))
         (not (bytevector-eq? (bytevector) (bytevector)))
         (not (bytevector-eq? (bytevector-append) empty))
         right-correct left-correct)
    42 (unreachable))
