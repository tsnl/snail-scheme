(import (snail strict))
(define-class (Zero T) (: zero (-> T)))
(define-instance (Zero I32) (zero (lambda () (ann 0 I32))))
(define-instance (Zero F64) (zero (lambda () 0.0)))
(: first I32)
(define first (zero))
(: second F64)
(define second (zero))
(if (and (i32-eq first (ann 0 I32)) (f64-eq second 0.0)) 42 0)
