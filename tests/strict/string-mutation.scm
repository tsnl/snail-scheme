(import (snail strict))
(define forward (string-copy "abcdef"))
(define backward (string-copy "abcdef"))
(define shared (ref forward))
(define alias (ref-get shared))
(string-copy! forward 2 forward 0 4)
(string-copy! backward 0 backward 2 6)
(string-copy! forward 6 backward 6 6)
(string-copy! (string) 0 "" 0 0)
(ref-set! shared (string-append forward backward))
(string-set! alias 0 #\Z)
(if (and (string=? alias "Zbabcd")
         (string-eq? alias forward)
         (string=? backward "cdefef")
         (string=? (ref-get shared) "ababcdcdefef")
         (not (string-eq? alias (ref-get shared))))
    42 (unreachable))
