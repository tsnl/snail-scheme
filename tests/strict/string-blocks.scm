(import (snail strict))

;; ---- Independent scalar oracle ----

(define (pattern-character index)
  (let ((choice (remainder index 5)))
    (if (= choice 0) #\null
        (if (= choice 1) #\é
            (if (= choice 2) #\x1f600
                (if (= choice 3) #\x10ffff #\x301))))))
(define (pattern-string length)
  (let ((value (make-string length)))
    (let loop ((index 0))
      (unless (= index length)
        (string-set! value index (pattern-character index))
        (loop (+ index 1))))
    value))
(define (copied-range? length at start end)
  (let* ((value (pattern-string length)) (before (string-copy value))
         (expected (string-copy value)))
    (let loop ((index start))
      (unless (= index end)
        (string-set! expected (+ at (- index start)) (string-ref before index))
        (loop (+ index 1))))
    (string-copy! value at value start end)
    (string=? value expected)))

;; ---- Fresh buffers, aliases and block-edge overlap ----

(define original (pattern-string 16385))
(define alias original)
(define copied (string-copy original))
(define middle (substring original 8191 16385))
(define joined (string-append "[" original "]"))
(string-set! alias 8192 #\Z)
(if (and (string-eq? alias original)
         (not (string-eq? copied original))
         (char=? (string-ref original 8192) #\Z)
         (char=? (string-ref copied 8192) (pattern-character 8192))
         (char=? (string-ref middle 1) (pattern-character 8192))
         (char=? (string-ref joined 8193) (pattern-character 8192))
         (char=? (string-ref copied 16384) (pattern-character 16384))
         (copied-range? 0 0 0 0)
         (copied-range? 1 0 0 1)
         (copied-range? 8191 1 0 8190)
         (copied-range? 8192 0 1 8192)
         (copied-range? 8193 1 0 8192)
         (copied-range? 16384 1 0 16383)
         (copied-range? 16384 0 1 16384)
         (copied-range? 16385 8190 8188 16381)
         (copied-range? 24579 8191 8189 16393)
         (copied-range? 24579 0 8190 24579)
         (copied-range? 24579 16387 0 8192)
         (copied-range? 32801 123 8159 25000)
         (copied-range? 24576 0 0 24576)
         (copied-range? 24579 24579 24579 24579))
    42 (unreachable))
