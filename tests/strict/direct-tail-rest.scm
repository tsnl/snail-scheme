(import (snail strict))

(define (exercise)
  (define count (ref 0))
  (: even (-> I64 Unit))
  (define (even n)
    (when (> n 0)
      (ref-set! count (+ 1 (ref-get count)))
      (odd (- n 1)))
    (unit))
  (: odd (-> I64 Unit))
  (define (odd n)
    (unless (= n 0)
      (ref-set! count (+ 1 (ref-get count)))
      (even (- n 1)))
    (unit))
  (: add-first (-> I64 (Rest I64) I64))
  (define (add-first first . remaining) (+ first (car remaining)))
  (define (stop) (unreachable))
  (even 100000)
  (if (= (ref-get count) 100000) (add-first 40 2 99) (stop)))

(exercise)
