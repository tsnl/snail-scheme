(import (snail strict))

(define count (ref 0))
(: through (-> (-> I64 Unit) I64 Unit))
(define (through action n)
  (action n)
  (unit)
  (unit))
(: down (-> I64 Unit))
(define (down n)
  (when (> n 0)
    (ref-set! count (+ (ref-get count) 1))
    (up (- n 1))))
(: up (-> I64 Unit))
(define (up n)
  (unless (= n 0)
    (ref-set! count (+ (ref-get count) 1))
    (through down (- n 1))))

(down 100000)
(ref-get count)
