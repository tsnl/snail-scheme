(import (snail strict))

(define (exercise)
  (define count (ref 0))
  (: loop (-> I64 Unit))
  (define (loop remaining)
    (when (> remaining 0)
      ((let ((next (- remaining 1)))
         (define (repeat)
           (ref-set! count (+ (ref-get count) 1))
           ((let () loop) next))
         repeat)))
    (unit))
  (: add-first (-> I64 (Rest I64) I64))
  (define (add-first first . remaining) (+ first (car remaining)))
  (loop 100000)
  (let again ((remaining 100000))
    (if (= remaining 0)
        (if (= (ref-get count) 100000) ((let () add-first) 40 2 99) 0)
        ((let () again) (- remaining 1)))))

(exercise)
