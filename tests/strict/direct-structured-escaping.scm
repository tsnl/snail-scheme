(import (snail strict))

(define calls (ref 0))
(define (make-counter seed early?)
  (define cell (ref seed))
  (define saved
    (lambda (amount)
      ((let ((increment amount))
         (define (apply)
           (ref-set! calls (+ (ref-get calls) 1))
           ((let () step) increment))
         apply))))
  (define early (if early? (saved 1) 0))
  (define (step amount)
    (ref-set! cell (+ (ref-get cell) amount))
    (ref-get cell))
  saved)
(define left (make-counter 40 #f))
(define right (make-counter 100 #f))
(define (make-next seed)
  ((let ((cell (ref seed)))
     (define (step amount)
       (ref-set! cell (+ (ref-get cell) amount))
       (ref-get cell))
     (define (build) (lambda (amount) ((let () step) amount)))
     build)))
(define next (make-next 40))
(: checked (-> I64))
(define (checked) ((make-counter 0 #t) 1))
(: observed (-> I64))
(define (observed) (ref-get calls))

(if (and (= (left 1) 41) (= (right 2) 102) (= (left 1) 42)
         (= (next 1) 41) (= (next 1) 42)) 42 0)
