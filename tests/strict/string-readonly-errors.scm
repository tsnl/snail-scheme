(import (snail strict))
(define literal (ref (ann (ann "abc" Top) String)))
(define effects (ref 0))
(define (mark digit value)
  (ref-set! effects (+ (* (ref-get effects) 10) digit))
  value)
(: set-literal (-> Unit))
(define (set-literal)
  (ref-set! effects 0)
  (string-set! (mark 1 (ref-get literal)) (mark 2 0) (mark 3 #\Z)))
(: set-effects (-> I64))
(define (set-effects) (ref-get effects))
(: copy-literal (-> Unit))
(define (copy-literal)
  (ref-set! effects 0)
  (string-copy! (mark 1 (ref-get literal)) (mark 2 0) (mark 3 "Z") (mark 4 0) (mark 5 1)))
(: copy-effects (-> I64))
(define (copy-effects) (ref-get effects))
(: empty-literal-copy (-> Unit))
(define (empty-literal-copy) (string-copy! "" 0 "" 0 0))
(: literal-endpoint-copy (-> Unit))
(define (literal-endpoint-copy) (string-copy! (ref-get literal) 3 "" 0 0))
(: unchanged (-> Bool))
(define (unchanged) (string=? (ref-get literal) "abc"))
42
