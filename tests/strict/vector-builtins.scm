(import (snail strict))
(define (copy-values source) (vector-append (empty-vector) (vector-copy source)))
(define integers (copy-values (list->vector (cons 40 (cons 2 '())))))
(define flags (copy-values (vector #t #f)))
(define returned (vector->list integers))
(if (and (= (vector-length (ann (vector-append) (Vector I64))) 0)
         (= (vector-length (ann (vector) (Vector Bool))) 0)
         (not (vector-eq? (ann (empty-vector) (Vector I64)) (ann (empty-vector) (Vector I64))))
         (vector-ref flags 0) (not (vector-ref flags 1)))
    (+ (car returned) (car (cdr returned))) (unreachable))
