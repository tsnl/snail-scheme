(import (snail strict))
(define-class (Copy T) (: copy-value (-> T T)))
(define-instance (Copy (Vector I64)) (copy-value vector-copy))
(define-instance (Copy (Vector Bool)) (copy-value vector-copy))
(define (copy-twice value) (copy-value (copy-value value)))
(define (invoke operation value) (operation value))
(define original (vector 40 2))
(define copied (copy-twice original))
(define flags (invoke copy-value (vector #t #f)))
(vector-set! copied 0 0)
(if (and (not (vector-eq? original copied))
         (vector-ref flags 0) (not (vector-ref flags 1)))
    (+ (vector-ref original 0) (vector-ref original 1)) (unreachable))
