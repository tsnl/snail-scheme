(import (snail strict))
(define-overload promote (-> I64 F64) i64->f64)
(: combine (All (A B R) (=> ((+ (-> A B R))) (-> A B R))))
(define (combine left right) (+ left right))
(: discard (All (A B R) (=> ((+ (-> A B R))) (-> A B Unit))))
(define (discard left right) (+ left right) (unit))
(define (nested value) (+ (promote value) (combine value 2.0)))
(discard 20 22.0)
(if (= (nested 20) 42.0) 42 (unreachable))
