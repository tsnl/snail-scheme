(import (snail strict))
(define-class (Convert A B) (: convert (-> A B)))
(define-instance (Convert I64 I32) (convert i64->i32))
(define-instance (Convert I64 F64) (convert i64->f64))
(: narrow I32)
(define narrow (convert 42))
(: floating F64)
(define floating (convert 42))
(if (and (= narrow (ann 42 I32)) (= floating 42.0)) 42 (unreachable))
