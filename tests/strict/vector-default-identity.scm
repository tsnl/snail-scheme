(import (snail strict))
(define calls (ref 0))
(define-instance (Default (Ref I64))
  (default (lambda ()
             (ref-set! calls (+ (ref-get calls) 1))
             (ref (ref-get calls)))))
(define empty (ann (make-vector 0) (Vector (Ref I64))))
(define values (make-vector 3))
(ref-set! (vector-ref values 0) 42)
(if (and (= (ref-get calls) 3) (= (vector-length empty) 0)
         (= (ref-get (vector-ref values 0)) 42)
         (= (ref-get (vector-ref values 1)) 2)
         (= (ref-get (vector-ref values 2)) 3)
         (not (ref-eq? (vector-ref values 0) (vector-ref values 1))))
    42 (unreachable))
