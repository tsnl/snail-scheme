(import (snail strict) (snail bytes))
(define target (bytevector 1 2 3))
(define effects (ref 0))
(define (mark digit value)
  (ref-set! effects (+ (* (ref-get effects) 10) digit)) value)
(: negative-length (-> I64))
(define (negative-length) (bytevector-length (make-bytevector -1)))
(: overflow-length (-> I64))
(define (overflow-length) (bytevector-length (make-bytevector 4294967296)))
(: empty-invalid-fill (-> I64))
(define (empty-invalid-fill) (bytevector-length (make-bytevector 0 256)))
(: negative-fill (-> I64))
(define (negative-fill) (bytevector-length (make-bytevector 0 -1)))
(: negative-index (-> I64))
(define (negative-index) (bytevector-u8-ref target -1))
(: wrapped-index (-> I64))
(define (wrapped-index) (bytevector-u8-ref target 4294967296))
(: endpoint-index (-> I64))
(define (endpoint-index) (bytevector-u8-ref target 3))
(: invalid-byte (-> Unit))
(define (invalid-byte) (bytevector-u8-set! target 0 256))
(: readonly-write (-> Unit))
(define (readonly-write)
  (bytevector-u8-set! (mark 1 #u8(0)) (mark 2 0) (mark 3 42)))
(: observed-effects (-> I64))
(define (observed-effects) (ref-get effects))
(: readonly-empty-copy (-> Unit))
(define (readonly-empty-copy) (bytevector-copy! #u8() 0 #u8() 0 0))
(: source-range (-> Unit))
(define (source-range) (bytevector-copy! target 0 #u8(9 8) 0 3))
(: target-range (-> Unit))
(define (target-range) (bytevector-copy! target 2 #u8(9 8) 0 2))
(: reversed-range (-> Unit))
(define (reversed-range) (bytevector-copy! target 0 #u8(9 8) 2 1))
(: negative-range (-> Unit))
(define (negative-range) (bytevector-copy! target 0 #u8(9 8) -1 0))
(: empty-source-range (-> Unit))
(define (empty-source-range) (bytevector-copy! target 0 #u8() 1 1))
(: empty-target-range (-> Unit))
(define (empty-target-range) (bytevector-copy! target 4 #u8() 0 0))
(: negative-copy (-> I64))
(define (negative-copy) (bytevector-length (bytevector-copy target -1 0)))
(: wrong-top (-> I64))
(define (wrong-top) (bytevector-length (ann (ann (vector 1 2) Top) Bytevector)))
(: wrong-string (-> I64))
(define (wrong-string) (string-length (ann (ann target Top) String)))
(: unchanged (-> Bool))
(define (unchanged)
  (and (= (bytevector-u8-ref target 0) 1) (= (bytevector-u8-ref target 1) 2)
       (= (bytevector-u8-ref target 2) 3)))
42
