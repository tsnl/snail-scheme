(import
 (snail core base)
 (only (snail core forms) host))
(extern released "test.owners" "released" (Fn I64 → Unit ! host))
(struct Resource
  ((value I64)))
(instance (Drop (! host) Resource)
  (define (drop (resource Resource)) (→ Unit) (! host)
    (match resource ((Resource value) (released value)))))
(define (create (value I64)) (→ (Rc Resource))
  (rc (Resource value)))
(define (read (owner (Rc Resource))) (→ I64) (! mut host)
  (● owner value))
(define (alias (owner (Rc Resource))) (→ (Rc Resource)) owner)
(define (duplicate (owner (Rc Resource))) (→ (Pair (Rc Resource) (Rc Resource)))
  (Pair owner owner))
(define (pair-value (owners (Pair (Rc Resource) (Rc Resource)))) (→ I64) (! mut host)
  (+ (● (● owners first) value) (● (● owners second) value)))
(define (combine (a (Rc Resource)) (b (Rc Resource))) (→ I64) (! mut host)
  (+ (● a value) (● b value)))
(define (optional (value I64)) (→ (Option Any))
  (if (< value 0) (None)
      (Some (type-convert (ann (lambda (x) (+ value x)) (Fn I64 → I64)) Any))))
(define (optional-value (value (Option Any))) (→ I64)
  (match value
    ((None) -1)
    ((Some value)
     (match (try-convert value (Fn I64 → I64))
       ((Ok call) (call 1))
       ((Err _) -2)))))
(expose create "create")
(expose read "read")
(expose alias "alias")
(expose duplicate "duplicate")
(expose pair-value "pair-value")
(expose combine "combine")
(expose optional "optional")
(expose optional-value "optional-value")
