;; Ordinary Chibi scripts orchestrate tests; Cargo supplies native fixtures only.
(import (scheme base) (scheme process-context) (snail-tests harness)
        (snail-tests contracts) (snail-tests targets) (snail-tests streams)
        (snail-tests commands) (snail-tests native) (snail-tests native-loading) (snail-tests chez-bridge) (snail-tests view-traces))
(define arguments (cdr (command-line)))
(define repository (car arguments))
(define suite (cadr arguments))
(initialize-suite! repository (cddr arguments) suite)
(artifacts (absolute-path (argument-value "--reuse-artifacts" (output))))
(create-directory* (output))
(dynamic-wind (lambda () #f) (lambda ()
                               (cond
                                ((member suite '("sfir" "sfir-integration" "sfir-extern" "sfir-conformance-audit" "sfir-instances" "sfir-recursion" "sfir-literal-widths")) (run-contract-suite suite))
                                ((member suite '("sfir-integer" "sfir-numbers" "sfir-arithmetic" "sfir-narrowing" "sfir-bytes" "sfir-math" "sfir-scalars")) (run-target-suite suite))
                                ((member suite '("sfir-reader" "sfir-text" "sfir-write" "sfir-input-packets" "sfir-io")) (run-stream-suite suite))
                                ((member suite '("native")) (run-native-suite))
                                ((string=? suite "sfir-native-loading") (run-native-loading))
                                ((string=? suite "sfir-native-loading-lost-host") (native-loading-lost-host))
                                ((string=? suite "sfir-chez-bridge") (run-chez-bridge))
                                ((string=? suite "view-traces") (run-view-traces))
                                (else (run-command-suite suite)))) finalize-records!)
