;; Compile supplied library values. Filesystem writes surround the compiler API.
(import
 (scheme base)
 (scheme file)
 (scheme process-context)
 (chibi filesystem)
 (lofi compiler reader)
 (lofi compiler syntax-parser)
 (lofi host chromium-trace)
 (lofi compiler primitives)
 (lofi compiler frontend)
 (lofi compiler bootstrap)
 (only (lofi host test-utils) expect)
 (only (srfi 130) string-contains))

(define directory (cadr (command-line)))
(define (parsed text)
  (parse-library (car (reader->syntax-list (string->reader "entry-fixture.sld" text)))))
(define libraries
  (with-chromium-trace-to
   (string-append directory "/parse.json")
   (lambda ()
     (let ((provider (parsed "(define-library (entry provider)
                               (import (only (lofi primitive) i32-add))
                               (export (rename worker public-worker))
                               (begin (define-extern tick \"entry.test\" \"tick\" (-> I32))
                                 (def offset (tick))
                                 (def secret (-> I32) (lambda () 40))
                                 (def worker (lambda (x) (i32-add (i32-add (secret) offset) x)))))"))
           (facade (parsed "(define-library (entry facade)
                             (import (rename (entry provider) (public-worker selected))
                               (only (entry alias)) (only (entry decoy)))
                             (export (rename selected main) (rename selected another))
                             (begin (def worker (-> I32 I32) (lambda (x) 1000)) (def entry (ann 666 I64))))"))
           (decoy (parsed "(define-library (entry decoy)
                            (begin (def worker (-> I32 I32) (lambda (x) 999))))")))
       (list (cons '(lofi primitive) (make-primitive-library primitive-names))
             (cons '(entry provider) provider) (cons '(entry alias) provider)
             (cons '(entry facade) facade) (cons '(entry other-facade) facade) (cons '(entry decoy) decoy))))))

(define (build-artifact entry)
  (let ((artifact (compile libraries entry)))
    (expect (eq? (artifact-entry artifact) entry) #t)
    (expect (artifact-parameters artifact) '(I32))
    (expect (artifact-result artifact) 'I32)
    artifact))

;; Both public aliases name the same provider through different map aliases.
(for-each
 (lambda (selection)
   (let* ((name (symbol->string (cdr selection))) (entry (make-entry (car selection) (cdr selection)))
          (artifact (build-artifact entry)))
     (call-with-port (open-binary-output-file (string-append directory "/" name ".wasm"))
       (lambda (port) (write-bytevector (artifact-bytes artifact) port)))))
 '(((entry facade) . main) ((entry other-facade) . another)))
