;; Ordinary compiled Lofi owns and transforms the result of ordinary parsing.
(define-library (parsed program)
  (import (lofi base) (lofi compiler) (lofi compiler-builder) (builder rebuild))
  (export main)
  (begin

    ;; ---- Failures remain values, and diagnostics retain source locations ----

    (define-extern observe-character "tests" "character" (-> Char Unit))
    (define-extern observe-message "tests" "message" (-> Unit))
    (define-extern fail "tests" "fail" (-> Unit))
    (def report (-> String I64 Unit)
         (lambda (text index)
           (if (= index (string-length text)) (observe-message)
               (begin (observe-character (string-ref text index)) (report text (+ index (ann 1 I64)))))))
    (def require (All (T) (-> (CompilerResult T) T))
         (lambda (result)
           (match result
             ((compiler-success value) value)
             ((compiler-failure message) (begin (report message (ann 0 I64)) (fail) (unreachable))))))
    (def reject (All (T) (-> (CompilerResult T) Unit))
         (lambda (result)
           (match result
             ((compiler-success value) (begin (fail) (unreachable)))
             ((compiler-failure message) (report message (ann 0 I64))))))
    (def assert (-> Bool Unit) (lambda (condition) (if condition (unit) (fail))))
    (def key (-> String (List String)) (lambda (name) (cons name (empty-list))))
    (def expect-i32 (-> ScalarValue I32 Unit)
         (lambda (value expected)
           (match value
             ((scalar-i32 actual) (assert (= actual expected)))
             ((scalar-i64 actual) (fail)) ((scalar-f32 actual) (fail)) ((scalar-f64 actual) (fail))
             ((scalar-bool actual) (fail)) ((scalar-char actual) (fail)) ((scalar-unit) (fail)))))
    (def run (-> LibraryMap String String ScalarValue)
         (lambda (libraries selected name)
           (begin
             (let artifact (require (compile libraries (entry (key selected) name))))
             (let runtime (require (instantiate (require (load artifact)) (provider-set "probe"))))
             (let result (require (invoke-entry runtime (empty-list))))
             (require (close-instance runtime)) result)))

    ;; ---- Typed views preserve syntax identities while changing public names ----

    (def scope-of (-> LofiLibrary ScopeId)
         (lambda (syntax-value)
           (match (inspect-library syntax-value)
             ((view-library key scope imports exports declarations span) scope))))
    (def rename-library (-> LofiLibrary LofiLibrary)
         (lambda (syntax-value)
           (match (inspect-library syntax-value)
             ((view-library key scope imports exports declarations span)
              (match (inspect-export (car exports))
                ((view-export name reference)
                 (lofi-library (cons (builder-name "transformed") (empty-list)) scope imports
                               (cons (library-export (builder-name "answer") reference) (empty-list))
                               declarations span)))))))
    (def parse-state (-> LofiLibrary)
         (lambda ()
           (begin
             (let text (string-copy
                        "(define-library (state) (import (lofi primitive)) (export run)
                           (begin (define-extern mark \"probe\" \"mark\" (-> I32 Unit)) (mark 5)
                             (let value 40) (def captured (lambda () value)) (let value I32 2)
                             (def run (-> I32) (lambda () (i32-add (captured) value)))))"))
             (let original (require (parse-library "first-class.lofi" text)))
             (let separate (require (parse-library "first-class.lofi" text)))
             (assert (not (same-scope? (scope-of original) (scope-of separate))))
             (string-set! text (ann 0 I64) #\X)
             original)))
    (def parsed-values (-> LibraryMap Unit)
         (lambda (base)
           (begin
             (let original (parse-state))
             (let first (require (library-map-insert base (key "first") original)))
             (let aliases (require (library-map-insert first (key "alias") original)))
             (let app (require (parse-library "alias-app.lofi"
                                              "(define-library (app) (import (first) (only (alias))) (export run))")))
             (let libraries (require (library-map-insert aliases (key "app") app)))
             (expect-i32 (run libraries "app" "run") 42)
             (let changed (rename-library (rebuild-library original)))
             (assert (same-scope? (scope-of original) (scope-of changed)))
             (let transformed (require (library-map-insert base (key "changed") changed)))
             (expect-i32 (run transformed "changed" "answer") 42)
             (reject (compile transformed (entry (key "changed") "run")))
             (expect-i32 (run first "first" "run") 42))))

    ;; ---- Parsing succeeds before import resolution and representation selection ----

    (def delayed-checking (-> LibraryMap Unit)
         (lambda (base)
           (begin
             (let missing (require (parse-library "missing.lofi"
                                                  "(define-library (missing) (import (absent)) (export run) (begin (def run (lambda () remote))))")))
             (let imports (require (library-map-insert base (key "missing") missing)))
             (reject (compile imports (entry (key "missing") "run")))
             (let invalid (require (parse-library "wide-error.lofi"
                                                  "(define-library (wide) (export run) (begin (def run (-> I64) (lambda () 9223372036854775808))))")))
             (let too-wide (require (library-map-insert base (key "wide") invalid)))
             (reject (compile too-wide (entry (key "wide") "run")))
             (let rest (require (parse-library "rest-error.lofi"
                                               "(define-library (rest) (export run) (begin (def run (Rest I32) 1)))")))
             (let wrong-rest (require (library-map-insert base (key "rest") rest)))
             (reject (compile wrong-rest (entry (key "rest") "run")))
             (reject (parse-library "vector-error.lofi" "(define-library (bad) (begin (def value #(1 2))))"))
             (reject (parse-library "grammar-error.lofi" "(define-library (bad) (wrong))"))
             (reject (parse-library "multiple.lofi" "(define-library (one)) (define-library (two))")))))
    (def main (-> I32)
         (lambda ()
           (begin
             (let base (require (library-map-primitives (require (empty-library-map)))))
             (parsed-values base)
             (delayed-checking base)
             42))) ))
