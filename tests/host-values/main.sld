(import
 (snail core base))
(record Resource
  ((value I64)))
(define (create (value I64)) (→ Resource)
  (new Resource (value value)))
(define (read (resource Resource)) (→ I64)
  (● resource value))
(define (alias (resource Resource)) (→ Resource) resource)
(define (duplicate (resource Resource)) (→ (Pair Resource Resource))
  (new Pair (first resource) (second resource)))
(define (pair-value (resources (Pair Resource Resource))) (→ I64)
  (+ (● resources first value) (● resources second value)))
(define (combine (a Resource) (b Resource)) (→ I64)
  (+ (● a value) (● b value)))
(define (optional (value I64)) (→ (Option Any))
  (if (< value 0) (None)
      (Some (Any (ann (lambda (x) (+ value x)) (Fn I64 → I64))))))
(define (optional-value (value (Option Any))) (→ I64)
  (match value
    ((None) -1)
    ((Some value)
     (match (downcast (Fn I64 → I64) value)
       ((Some call) (call 1))
       ((None) -2)))))
(expose create "create")
(expose read "read")
(expose alias "alias")
(expose duplicate "duplicate")
(expose pair-value "pair-value")
(expose combine "combine")
(expose optional "optional")
(expose optional-value "optional-value")
