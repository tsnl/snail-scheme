(define-library (tests draw3d math)
  (export answer)
  (import
   (scheme base)
   (draw3d math)
   (draw3d scene)
   (webgpu shader)
   (only (lofi core) ann -> I32 I64)
   (only (lofi base) i32->i64))
  (begin
    (define (near? a b) (and (< (- a b) 0.0001) (> (- a b) -0.0001)))
    (define (project-row matrix row point)
      (+ (+ (* (vector-ref matrix (i32->i64 row)) (vec3-x point))
            (* (vector-ref matrix (i32->i64 (+ row 4))) (vec3-y point)))
         (+ (* (vector-ref matrix (i32->i64 (+ row 8))) (vec3-z point))
            (vector-ref matrix (i32->i64 (+ row 12))))))
    (define (depth camera distance)
      (let ((matrix (camera-matrix camera)) (point (v+ (camera-eye camera) (v* (camera-forward camera) distance))))
        (/ (project-row matrix 2 point) (project-row matrix 3 point))))
    (define (camera-contract? camera)
      (let* ((matrix (camera-matrix camera)) (hit (car (ray-ground (camera-ray camera 0.25 -0.5) 0.0)))
             (w (project-row matrix 3 hit)))
        (and (near? (depth camera 0.1) 0.0) (near? (depth camera 100.0) 1.0)
             (near? (/ (project-row matrix 0 hit) w) 0.25)
             (near? (/ (project-row matrix 1 hit) w) -0.5))))
    (define (camera-contracts?)
      (let ((eye (vec3 0.0 -10.0 10.0)) (target (vec3 0.0 0.0 0.0)) (up (vec3 0.0 0.0 1.0)))
        (and (camera-contract? (orthographic-camera eye target up 12.0 1.5 0.1 100.0))
             (camera-contract? (perspective-camera eye target up 1.7320508 1.5 0.1 100.0)))))
    (define (shaders?)
      (and (shader-valid? (compile-scene-shader (gpu (project position)) (gpu (lambert color normal))))
           (not (shader-valid? (compile-shader (gpu (project position)) (gpu color))))
           (not (shader-valid? (compile-scene-shader (gpu (project color)) (gpu color))))
           (not (shader-valid? (compile-scene-shader (gpu (project position)) (gpu (project normal)))))))
    (define answer (ann (lambda () (if (and (test-math) (test-scene) (camera-contracts?) (shaders?)) 1 0)) (-> I32)))))
