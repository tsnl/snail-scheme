(module
 (rec (type $empty (struct))
      (type $grouped (func (param i32) (result i32))))
 (rec (type $same-empty (struct))
      (type $same-grouped (func (param i32) (result i32))))
 (type $plain (func (param i32) (result i32)))
 (type $plain-empty (struct))
 (rec (type $a (struct (field (ref null $b))))
      (type $b (struct (field i32) (field (ref null $a)))))
 (rec (type $same-a (struct (field (ref null $same-b))))
      (type $same-b (struct (field i32) (field (ref null $same-a)))))
 (table $functions 1 1 funcref)
 (elem (table $functions) (i32.const 0) func $increment)
 (global $effects (mut i32) (i32.const 0))
 (func $increment (type $grouped) (param $n i32) (result i32)
       (i32.add (local.get $n) (i32.const 1)))
 (func $effect (param $n i32) (result eqref)
       (global.set $effects (i32.add (global.get $effects) (i32.const 1)))
       (ref.i31 (local.get $n)))
 (func (export "check") (result i32)
       (local $object (ref $a))
       (local.set $object (struct.new $a (struct.new $b (i32.const 42) (ref.null $a))))
       (if (i32.eqz (ref.test (ref $same-a) (local.get $object))) (then unreachable))
       (if (i32.ne (struct.get $same-b 0 (ref.cast (ref $same-b)
                              (struct.get $same-a 0 (ref.cast (ref $same-a) (local.get $object)))))
                   (i32.const 42)) (then unreachable))
       (if (ref.test (ref $plain-empty) (struct.new $empty)) (then unreachable))
       (if (i32.eqz (ref.test (ref null none) (ref.null none))) (then unreachable))
       (drop (select (result eqref) (call $effect (i32.const 1))
                     (call $effect (i32.const 2)) (i32.const 0)))
       (if (i32.ne (global.get $effects) (i32.const 2)) (then unreachable))
       (i32.const 0))
 (func (export "call-grouped") (param $n i32) (result i32)
       (call_indirect $functions (type $same-grouped) (local.get $n) (i32.const 0)))
 (func (export "call-singleton") (param $n i32) (result i32)
       (call_indirect $functions (type $plain) (local.get $n) (i32.const 0)))
 (func (export "negative-zero") (result f64) (f64.const -0.0))
 (func (export "nan-payload") (result i64)
       (i64.reinterpret_f64 (f64.const nan:0x8000000000005)))
 (func (export "negative-nan-payload") (result i64)
       (i64.reinterpret_f64 (f64.const -nan:0x8000000000005)))
 (func (export "escaped\2dname") (result i32) (i32.const 19))
 (func (export "wide-float") (result i64)
       (i64.reinterpret_f64 (f64.const 9223372036854775808)))
 (func (export "large-float") (result i64)
       (i64.reinterpret_f64 (f64.const 100000000000000000000)))
 (func (export "signed-boundary") (result i64) (i64.const 9223372036854775808))
 (func (export "all-bits") (result i64) (i64.const 18446744073709551615)))
