(import
 (lofi base))
((lambda (limit)
   (begin
     (def first (All (A) (-> I64 A Bool))
          (lambda (count value)
            (if (i64-eq count (ann 0 I64))
                (< value limit)
                (second (i64-sub count (ann 1 I64)) value))))
     (def second (All (B) (-> I64 B Bool))
          (lambda (count value)
            (if (i64-eq count (ann 0 I64))
                (< value limit)
                (first (i64-sub count (ann 1 I64)) value))))
     (ann 42 I64)))
 (ann 2 I64))
