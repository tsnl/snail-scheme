(import
 (lofi primitive))
(def Equal (typeclass (T) (: same? (-> T T Bool))))
(def equal-i64 (instance (Equal I64) (same? i64-eq)))
(def outer (All (T) (requires (Equal T)) (-> T Bool))
     (lambda (value)
       (begin
         (def even (-> I64 Bool)
              (lambda (count)
                (if (i64-eq count (ann 0 I64))
                    (same? value value)
                    (odd (i64-sub count (ann 1 I64))))))
         (def odd (-> I64 Bool)
              (lambda (count)
                (if (i64-eq count (ann 0 I64))
                    (same? value value)
                    (even (i64-sub count (ann 1 I64))))))
         (even (ann 20 I64)))))
(if (outer (ann 42 I64)) (ann 42 I64) (ann 0 I64))
