(import
 (lofi base))
((lambda (limit)
   (begin
     (def even (-> I64 Bool)
          (lambda (count)
            (if (i64-eq count (ann 0 I64))
                (< (ann 0 I64) limit)
                (odd (i64-sub count (ann 1 I64))))))
     (def odd (-> I64 Bool)
          (lambda (count)
            (if (i64-eq count (ann 0 I64))
                (< (ann 0 I64) limit)
                (even (i64-sub count (ann 1 I64))))))
     (if (even (ann 20 I64)) (ann 42 I64) (ann 0 I64))))
 (ann 2 I64))
