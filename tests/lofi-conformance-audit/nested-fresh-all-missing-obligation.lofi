(import (lofi primitive))
(def Equal (typeclass (T) (: same? (-> T T Bool))))
(def equal-i64 (instance (Equal I64) (same? i64-eq)))
(def outer (All (T) (=> ((Equal T)) (-> T Bool)))
     (lambda (outer-value)
       (begin
         (def inner (All (T) (-> T Bool))
              (lambda (inner-value) (same? inner-value inner-value)))
         (inner outer-value))))
(if (outer (ann 42 I64)) (ann 42 I64) (ann 0 I64))
