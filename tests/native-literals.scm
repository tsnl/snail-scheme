(import (scheme base) (scheme write))
;; The bootstrap reader rejects datum labels. Create the cycle by updating a
;; mutable literal field; native static reference slots must still trace it.
(define cycle '("λ😀"))
(set-cdr! cycle cycle)
(define shared (vector cycle cycle))
(let loop ((n 1000))
  (when (> n 0)
    (make-vector 16 n)
    (loop (- n 1))))
(unless (and (eq? cycle (cdr cycle))
             (string=? (car cycle) "λ😀")
             (eq? (vector-ref shared 0) (vector-ref shared 1)))
  (error "native literal identity differs"))
(display "native literal checks passed\n")
