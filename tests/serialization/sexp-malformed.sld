(import
 (scheme base)
 (lofi sexp)
 (only (lofi core) def ann -> I64))
(def empty-text (-> I64) (lambda () (text->sexp "") (ann 0 I64)))
(def text-trailing (-> I64) (lambda () (text->sexp "0 1") (ann 0 I64)))
(def text-open-list (-> I64) (lambda () (text->sexp "(0") (ann 0 I64)))
(def text-close-list (-> I64) (lambda () (text->sexp ")") (ann 0 I64)))
(def text-open-string (-> I64) (lambda () (text->sexp "\"unfinished") (ann 0 I64)))
(def text-escape (-> I64) (lambda () (text->sexp "\"\\q\"") (ann 0 I64)))
(def text-surrogate (-> I64) (lambda () (text->sexp "\"\\xd800;\"") (ann 0 I64)))
(def text-unicode-overflow (-> I64) (lambda () (text->sexp "|\\x110000;|") (ann 0 I64)))
(def text-empty-hex (-> I64) (lambda () (text->sexp "\"\\x;\"") (ann 0 I64)))
(def text-positive-overflow (-> I64) (lambda () (text->sexp "9223372036854775808") (ann 0 I64)))
(def text-negative-overflow (-> I64) (lambda () (text->sexp "-9223372036854775809") (ann 0 I64)))
(def text-bad-integer (-> I64) (lambda () (text->sexp "12z") (ann 0 I64)))
(def text-byte-overflow (-> I64) (lambda () (text->sexp "#u8(256)") (ann 0 I64)))
(def text-byte-negative (-> I64) (lambda () (text->sexp "#u8(-1)") (ann 0 I64)))
(def text-byte-empty (-> I64) (lambda () (text->sexp "#u8(\"\")") (ann 0 I64)))
(def text-unknown-sharp (-> I64) (lambda () (text->sexp "#f") (ann 0 I64)))
(def binary-empty (-> I64) (lambda () (binary->sexp #u8()) (ann 0 I64)))
(def binary-trailing (-> I64) (lambda () (binary->sexp #u8(0 1)) (ann 0 I64)))
(def binary-truncated-integer (-> I64) (lambda () (binary->sexp #u8(211 0 0)) (ann 0 I64)))
(def binary-unsigned-overflow (-> I64) (lambda () (binary->sexp #u8(207 128 0 0 0 0 0 0 0)) (ann 0 I64)))
(def binary-truncated-bytes (-> I64) (lambda () (binary->sexp #u8(198 255 255 255 255)) (ann 0 I64)))
(def binary-truncated-list (-> I64) (lambda () (binary->sexp #u8(221 255 255 255 255)) (ann 0 I64)))
(def binary-truncated-string (-> I64) (lambda () (binary->sexp #u8(219 255 255 255 255)) (ann 0 I64)))
(def binary-extension (-> I64) (lambda () (binary->sexp #u8(199 0 2)) (ann 0 I64)))
(def binary-extension-truncated (-> I64) (lambda () (binary->sexp #u8(199 1 1)) (ann 0 I64)))
(def binary-map (-> I64) (lambda () (binary->sexp #u8(128)) (ann 0 I64)))
(def binary-reserved (-> I64) (lambda () (binary->sexp #u8(193)) (ann 0 I64)))
(def binary-invalid-utf8 (-> I64) (lambda () (binary->sexp #u8(161 255)) (ann 0 I64)))
(def binary-overlong-utf8 (-> I64) (lambda () (binary->sexp #u8(162 192 128)) (ann 0 I64)))
(def binary-surrogate-utf8 (-> I64) (lambda () (binary->sexp #u8(163 237 160 128)) (ann 0 I64)))
(def binary-unicode-overflow (-> I64) (lambda () (binary->sexp #u8(164 244 144 128 128)) (ann 0 I64)))
(def binary-truncated-utf8 (-> I64) (lambda () (binary->sexp #u8(162 240 144)) (ann 0 I64)))
(ann 42 I64)
