(import
 (scheme base)
 (scheme immutable)
 (lofi sexp)
 (lofi bytes)
 (only (lofi core) ann I64)
 (only (lofi base) string=?))
(define (roundtrip value)
  (and (sexp=? value (text->sexp (sexp->text value)))
       (sexp=? value (binary->sexp (sexp->binary value)))))
(define integers
  (list (ann -9223372036854775808 I64) (ann -9223372036854775807 I64)
        (ann -2147483649 I64) (ann -2147483648 I64) (ann -32769 I64) (ann -32768 I64)
        (ann -129 I64) (ann -128 I64) (ann -33 I64) (ann -32 I64) (ann -1 I64)
        (ann 0 I64) (ann 1 I64) (ann 127 I64) (ann 128 I64) (ann 255 I64)
        (ann 256 I64) (ann 65535 I64) (ann 65536 I64) (ann 4294967295 I64)
        (ann 4294967296 I64) (ann 9223372036854775807 I64)))
(define (integer-boundaries values)
  (or (null? values)
      (and (roundtrip (sexp-integer (car values))) (integer-boundaries (cdr values)))))
(define (bytes-match? left right)
  (and (= (bytevector-length left) (bytevector-length right))
       (let loop ((at (ann 0 I64)))
         (or (= at (bytevector-length left))
             (and (= (bytevector-u8-ref left at) (bytevector-u8-ref right at))
                  (loop (+ at (ann 1 I64))))))))
(define (encoding value expected) (bytes-match? (sexp->binary value) expected))
(define (binary-roundtrip value) (sexp=? value (binary->sexp (sexp->binary value))))
(define (sizes count)
  (and (binary-roundtrip (sexp-string (make-string count #\λ)))
       (binary-roundtrip (sexp-symbol (make-string count #\a)))
       (binary-roundtrip (sexp-bytes (make-bytevector count (ann 255 I64))))))
(define (children count)
  (let loop ((count count) (values (empty-list)))
    (if (= count (ann 0 I64)) values
        (loop (- count (ann 1 I64)) (cons (sexp-integer count) values)))))
(define text-source (make-string (ann 3 I64) #\a))
(define parsed-symbol (text->sexp text-source))
(string-set! text-source (ann 0 I64) #\b)
(define byte-source (bytevector (ann 196 I64) (ann 1 I64) (ann 42 I64)))
(define parsed-bytes (binary->sexp byte-source))
(bytevector-u8-set! byte-source (ann 2 I64) (ann 0 I64))
(if (and (integer-boundaries integers)
         (encoding (sexp-integer (ann -9223372036854775808 I64)) #u8(211 128 0 0 0 0 0 0 0))
         (encoding (sexp-integer (ann 9223372036854775807 I64)) #u8(211 127 255 255 255 255 255 255 255))
         (encoding (sexp-integer (ann 128 I64)) #u8(204 128))
         (encoding (sexp-integer (ann -33 I64)) #u8(208 223))
         (encoding (sexp-string "A") #u8(161 65))
         (encoding (sexp-symbol "A") #u8(199 1 1 65))
         (encoding (sexp-bytes #u8(0 255)) #u8(196 2 0 255))
         (encoding (sexp-list (list (sexp-integer (ann 1 I64)))) #u8(145 1))
         (sizes (ann 0 I64)) (sizes (ann 15 I64)) (sizes (ann 16 I64))
         (sizes (ann 31 I64)) (sizes (ann 32 I64)) (sizes (ann 255 I64))
         (sizes (ann 256 I64)) (sizes (ann 65535 I64)) (sizes (ann 65536 I64))
         (binary-roundtrip (sexp-list (children (ann 16 I64))))
         (binary-roundtrip (sexp-list (children (ann 65536 I64))))
         (string=? (sexp-symbol-value parsed-symbol) "aaa")
         (= (bytevector-u8-ref (sexp-bytes-value parsed-bytes) (ann 0 I64)) (ann 42 I64))
         (sexp=? (binary->sexp #u8(207 127 255 255 255 255 255 255 255))
                 (sexp-integer (ann 9223372036854775807 I64)))
         (sexp=? (binary->sexp #u8(212 1 65)) (sexp-symbol "A"))
         (roundtrip (sexp-string "\x0;\x7f;\x80;\x7ff;\x800;\xd7ff;\xe000;\xffff;\x10000;\x10ffff;")))
    (ann 42 I64) (ann 0 I64))
