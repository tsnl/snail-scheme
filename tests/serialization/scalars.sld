(import
 (scheme base)
 (lofi serialization)
 (only (lofi sexp) sexp=?)
 (only (lofi core) data deriving ann I32 I64 Bool Char Unit)
 (only (lofi base) string-copy string=? unreachable)
 (only (lofi scalar-text) Symbol string->symbol symbol->string symbol=? i64->string))

(data Scalars ()
  (scalars
   (minimum I64 scalars-minimum)
   (maximum I64 scalars-maximum)
   (yes Bool scalars-yes)
   (no Bool scalars-no)
   (character Char scalars-character)
   (nothing Unit scalars-nothing)
   (symbol Symbol scalars-symbol)
   (empty Symbol scalars-empty))
  (deriving derive-serialize derive-deserialize))

(define (assert condition) (unless condition (unreachable)))
(define spelling (string-copy "snow λ\x0;"))
(define name (string->symbol spelling))
(define original
  (scalars (ann -9223372036854775808 I64) (ann 9223372036854775807 I64)
           #t #f #\x1f642 (unit) name (string->symbol "")))
(define wire (serialize original))
(define copy (ann (deserialize (binary->sexp (sexp->binary (text->sexp (sexp->text wire))))) Scalars))
(string-set! spelling (ann 0 I64) #\X)
(define fresh (symbol->string (scalars-symbol copy)))
(string-set! fresh (ann 0 I64) #\Y)
(assert (sexp=? wire (serialize copy)))
(assert (= (scalars-minimum copy) (ann -9223372036854775808 I64)))
(assert (= (scalars-maximum copy) (ann 9223372036854775807 I64)))
(assert (and (scalars-yes copy) (not (scalars-no copy))))
(assert (char=? (scalars-character copy) #\x1f642))
(scalars-nothing copy)
(assert (symbol=? name (scalars-symbol copy)))
(assert (symbol=? (scalars-empty copy) (string->symbol "")))
(assert (string=? (symbol->string name) "snow λ\x0;"))
(assert (string=? (i64->string (scalars-minimum copy)) "-9223372036854775808"))
(assert (string=? (i64->string (scalars-maximum copy)) "9223372036854775807"))
(ann 42 I32)
