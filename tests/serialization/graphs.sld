(import
 (scheme base)
 (scheme immutable)
 (lofi serialization)
 (only (lofi core) data deriving instance ann match I32 I64)
 (only (lofi base) Default default ref ref-get ref-set! ref-eq? string-eq? string-copy
       vector-eq? bits->f32 f32->bits bits->f64 f64->bits unreachable)
 (only (lofi bytes) bytevector bytevector-eq? bytevector-u8-ref bytevector-u8-set!))

(data Node ()
  (empty-node)
  (linked-node
   (next (Ref Node) node-next))
  (vector-node
   (values (Vector Node) node-values))
  (deriving derive-serialize derive-deserialize))
(instance default-node (Default Node) (default empty-node))
(data Graph ()
  (graph
   (first (Ref Node) graph-first)
   (second (Ref Node) graph-second)
   (vector-cycle (Vector Node) graph-vector-cycle)
   (text String graph-text)
   (text-alias String graph-text-alias)
   (bytes Bytevector graph-bytes)
   (bytes-alias Bytevector graph-bytes-alias)
   (numbers (Vector I32) graph-numbers)
   (numbers-alias (Vector I32) graph-numbers-alias)
   (nested (List (List I32)) graph-nested)
   (small F32 graph-small)
   (large F64 graph-large))
  (deriving derive-serialize derive-deserialize))

(define (assert condition) (unless condition (unreachable)))
(define (cycle? node)
  (match (ref-get node)
    ((empty-node) #f)
    ((linked-node next) (ref-eq? node next))
    ((vector-node values) #f)))
(define (vector-cycle? values)
  (match (vector-ref values (ann 0 I64))
    ((empty-node) #f)
    ((vector-node other) #f)
    ((linked-node next)
     (match (ref-get next)
       ((empty-node) #f)
       ((linked-node other) #f)
       ((vector-node other) (vector-eq? values other))))))
(define cyclic-vector
  (let* ((next (ref (empty-node))) (values (vector (linked-node next))))
    (ref-set! next (vector-node values)) values))
(define original
  (let* ((node (ref (empty-node))) (text (string-copy "α😀"))
         (bytes (bytevector (ann 0 I64) (ann 255 I64))) (numbers (vector (ann 7 I32))))
    (ref-set! node (linked-node node))
    (graph node node cyclic-vector text text bytes bytes numbers numbers
           (list (list (ann 42 I32)) (empty-list))
           (bits->f32 (ann 2143289410 I32)) (bits->f64 (ann -9223372036854775808 I64)))))
(define wire (serialize original))
(define restored
  (ann (deserialize (binary->sexp (sexp->binary (text->sexp (sexp->text wire))))) Graph))
(assert (ref-eq? (graph-first restored) (graph-second restored)))
(assert (cycle? (graph-first restored)))
(assert (vector-cycle? (graph-vector-cycle restored)))
(assert (not (ref-eq? (graph-first original) (graph-first restored))))
(assert (string-eq? (graph-text restored) (graph-text-alias restored)))
(assert (not (string-eq? (graph-text original) (graph-text restored))))
(assert (bytevector-eq? (graph-bytes restored) (graph-bytes-alias restored)))
(assert (not (bytevector-eq? (graph-bytes original) (graph-bytes restored))))
(assert (vector-eq? (graph-numbers restored) (graph-numbers-alias restored)))
(assert (not (vector-eq? (graph-numbers original) (graph-numbers restored))))
(bytevector-u8-set! (graph-bytes restored) (ann 0 I64) (ann 42 I64))
(assert (= (bytevector-u8-ref (graph-bytes-alias restored) (ann 0 I64)) (ann 42 I64)))
(assert (= (bytevector-u8-ref (graph-bytes original) (ann 0 I64)) (ann 0 I64)))
(vector-set! (graph-numbers restored) (ann 0 I64) (ann 42 I32))
(assert (= (vector-ref (graph-numbers-alias restored) (ann 0 I64)) (ann 42 I32)))
(assert (= (f32->bits (graph-small restored)) (ann 2143289410 I32)))
(assert (= (f64->bits (graph-large restored)) (ann -9223372036854775808 I64)))
(assert (= (car (car (graph-nested restored))) (ann 42 I32)))
(ann 42 I32)
