(import
 (scheme base)
 (scheme immutable)
 (lofi sexp)
 (lofi bytes)
 (only (lofi core) ann I64)
 (only (lofi base) string=?))
(define tree
  (sexp-list
   (list (sexp-symbol "object") (sexp-integer (ann -9223372036854775808 I64))
         (sexp-integer (ann 9223372036854775807 I64))
         (sexp-string "λ😀\n\x0;\"\\") (sexp-symbol "a|b\\c\t")
         (sexp-bytes #u8(0 1 127 128 255))
         (sexp-list (list (sexp-list (empty-list)))))))
(if (and (sexp=? tree (text->sexp (sexp->text tree)))
         (sexp=? tree (binary->sexp (sexp->binary tree)))
         (sexp=? (text->sexp "(foo 0 -1 +2 #u8(0 255) \"hi\" ||)")
                 (text->sexp "(|foo| 0 -1 2 #u8(0 255) \"hi\" ||)"))
         (string=? (sexp->text (sexp-symbol "1")) "|1|"))
    (ann 42 I64) (ann 0 I64))
