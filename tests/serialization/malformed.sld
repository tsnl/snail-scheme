(import
 (scheme base)
 (lofi serialization)
 (only (lofi core) data deriving def ann -> I32))
(data Stock ()
  (stock
   (ore I32 stock-ore))
  (deriving derive-deserialize))
(data Links ()
  (links
   (first (Ref I32) links-first)
   (second (Ref I32) links-second))
  (deriving derive-deserialize))
(data Mixed ()
  (mixed
   (text String mixed-text)
   (number (Ref I32) mixed-number))
  (deriving derive-deserialize))
(define (decode-stock text) (stock-ore (ann (deserialize (text->sexp text)) Stock)))
(define (decode-links text) (ann (deserialize (text->sexp text)) Links) (ann 42 I32))
(def wrong-type (-> I32) (lambda () (decode-stock "(data Other stock (ore (I32 42)))")))
(def wrong-constructor (-> I32) (lambda () (decode-stock "(data |#f:Stock| other (ore (I32 42)))")))
(def wrong-field (-> I32) (lambda () (decode-stock "(data |#f:Stock| stock (credits (I32 42)))")))
(def missing-field (-> I32) (lambda () (decode-stock "(data |#f:Stock| stock)")))
(def extra-field (-> I32) (lambda () (decode-stock "(data |#f:Stock| stock (ore (I32 42)) (extra (I32 0)))")))
(def wrong-scalar (-> I32) (lambda () (decode-stock "(data |#f:Stock| stock (ore (I64 42)))")))
(def overflowing-i32 (-> I32) (lambda () (decode-stock "(data |#f:Stock| stock (ore (I32 2147483648)))")))
(def extra-scalar (-> I32) (lambda () (decode-stock "(data |#f:Stock| stock (ore (I32 42 0)))")))
(def unknown-reference (-> I32)
     (lambda () (decode-links "(data |#f:Links| links (first (link 0 |(Ref I32)|)) (second (link 0 |(Ref I32)|)))")))
(def duplicate-object (-> I32)
     (lambda () (decode-links "(data |#f:Links| links (first (object 0 |(Ref I32)| (I32 1))) (second (object 0 |(Ref I32)| (I32 2))))")))
(def negative-object (-> I32)
     (lambda () (decode-links "(data |#f:Links| links (first (object -1 |(Ref I32)| (I32 1))) (second (link -1 |(Ref I32)|)))")))
(def wrong-reference-type (-> I32)
     (lambda ()
       (ann (deserialize (text->sexp "(data |#f:Mixed| mixed (text (object 0 String \"text\")) (number (link 0 |(Ref I32)|)))")) Mixed)
       (ann 42 I32)))
(def invalid-bool (-> I32)
     (lambda () (ann (deserialize (text->sexp "(Bool maybe)")) Bool) (ann 42 I32)))
(def invalid-char (-> I32)
     (lambda () (ann (deserialize (text->sexp "(Char 55296)")) Char) (ann 42 I32)))
(ann 42 I32)
