(import
 (scheme base)
 (lofi serialization)
 (application serialization)
 (only (lofi core) data deriving ann I32 I64)
 (only (lofi base) unreachable)
 (only (lofi bytes) bytevector bytevector-u8-ref))
(data Payload ()
  (payload
   (bytes Bytevector payload-bytes))
  (deriving derive-serialize derive-deserialize))
(define bytes (bytevector (ann 255 I64) (ann 128 I64) (ann 0 I64) (ann 254 I64) (ann 42 I64)))
(define words (encode-snapshot (ann 3 I32) (payload bytes)))
(define restored (ann (decode-snapshot words) Payload))
(unless (= (vector-ref words (ann 0 I64)) (ann 3 I32)) (unreachable))
(unless (= (bytevector-u8-ref (payload-bytes restored) (ann 0 I64)) (ann 255 I64)) (unreachable))
(unless (= (bytevector-u8-ref (payload-bytes restored) (ann 1 I64)) (ann 128 I64)) (unreachable))
(unless (= (bytevector-u8-ref (payload-bytes restored) (ann 3 I64)) (ann 254 I64)) (unreachable))
(ann 42 I32)
