(import
 (scheme base)
 (lofi serialization)
 (only (lofi core) data deriving instance ann I32 I64)
 (only (lofi base) Default default ref ref-get ref-set! vector-eq? empty-vector unreachable))
(data Item ()
  (item
   (value I32 item-value))
  (deriving derive-serialize derive-deserialize))
(define calls (ref (ann 0 I32)))
(instance default-item (Default Item)
          (default (lambda () (ref-set! calls (+ (ref-get calls) 1)) (item 0))))
(data Bag ()
  (bag
   (first (Vector Item) bag-first)
   (alias (Vector Item) bag-alias)
   (other (Vector Item) bag-other))
  (deriving derive-serialize derive-deserialize))
(define (assert condition) (unless condition (unreachable)))
(define empty (ann (empty-vector) (Vector Item)))
(define empty-copy (ann (deserialize (serialize (bag empty empty empty))) Bag))
(assert (= (ref-get calls) 0))
(assert (= (vector-length (bag-first empty-copy)) (ann 0 I64)))
(assert (vector-eq? (bag-first empty-copy) (bag-other empty-copy)))
(define first (vector (item 42)))
(define other (vector (item 42)))
(define full-copy (ann (deserialize (serialize (bag first first other))) Bag))
(assert (= (ref-get calls) 2))
(assert (vector-eq? (bag-first full-copy) (bag-alias full-copy)))
(assert (not (vector-eq? (bag-first full-copy) (bag-other full-copy))))
(item-value (vector-ref (bag-other full-copy) (ann 0 I64)))
