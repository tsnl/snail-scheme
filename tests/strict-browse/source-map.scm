(import (scheme base) (scheme cxr) (scheme write) (scheme file) (scheme process-context)
        (snail-scheme strict-compiler) (snail-scheme strict-specialize)
        (snail-scheme strict-wasm) (snail-scheme source) (snail-scheme chromium-trace)
        (only (snail-scheme ir) node-kind node-data node-loc value-definition-name)
        (only (snail-scheme wasm) write-wasm))

;; ---- Reproduce the clean module while recording its concrete source sites ----

(define arguments (cdr (command-line)))
(define (field value) (display value) (display #\tab))
(define (record-function function)
  (let ((location (node-loc (function-source function))))
    (field "function") (field (function-index function))
    (field (loc-filename location)) (field (loc-line location))
    (display (loc-column location)) (newline)))
(define (record-binding value)
  (let ((initializer (value-initializer value)))
    (when (and initializer (eq? (node-kind initializer) 'closure))
      (field "binding") (field (value-definition-name (value-source value)))
      (display (function-index (car (node-data initializer)))) (newline))))
(define (generate-map)
  (define program (monomorphize (strict-source-file->core (car arguments) (cadr arguments))
                                'bench 'configured-count))
  (for-each record-function (mono-program-functions program))
  (for-each record-binding (site-values (mono-program-globals program)))
  (call-with-output-file (caddr arguments) (lambda (port) (write-wasm (strict-core->wasm program) port))))
(with-chromium-trace-to (string-append (caddr arguments) ".trace.json") generate-map)
