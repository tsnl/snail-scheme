;; Chibi executes compiler implementation tests; product inputs are Lofi.
(import (scheme base) (scheme write)
        (only (wasm-native chromium-trace) with-chromium-trace-to)
        (only (chibi temp-file) call-with-temp-dir)
        (only (lofi reader) test-reader)
        (only (lofi parser) test-parser)
        (only (lofi resolved-library) test-library)
        (only (lofi syntax-parser) test-syntax-parser)
        (only (lofi ir) test-ir)
        (only (lofi frontend) test-frontend)
        (only (lofi macros) test-macros)
        (only (lofi compiler bootstrap) test-compiler)
        (only (lofi source-driver) test-source-driver)
        (only (lofi artifact) test-artifact)
        (only (lofi library-transfer) test-library-transfer)
        (only (lofi numeric-literals) test-numeric-literals)
        (only (lofi types) test-types)
        (only (lofi hashmap) test-hashmap)
        (only (lofi infer) test-infer)
        (only (lofi specialize) test-specialize)
        (only (lofi wasm-extern) test-wasm-extern))

(test-compiler)
(test-artifact)
(test-library-transfer)
(call-with-temp-dir
 "lofi-unit-traces"
 (lambda (directory preserve)
   (with-chromium-trace-to
    (string-append directory "/tests.json")
    (lambda ()
      (test-reader)
      (test-parser)
      (test-library)
      (test-syntax-parser)
      (test-ir)
      (test-frontend)
      (test-macros)
      (test-source-driver)
      (test-numeric-literals)
      (test-types)
      (test-hashmap)
      (test-infer)
      (test-specialize)
      (test-wasm-extern)))))
(display "All Lofi compiler host tests passed\n")
