;; Chibi executes compiler implementation tests; product inputs are Lofi.
(import
 (scheme base)
 (scheme write)
 (only (lofi host json) test-json)
 (only (lofi host process) test-process)
 (only (lofi host chromium-trace) test-chromium-trace)
 (only (lofi host wasm) test-wasm)
 (only (lofi host chromium-trace) with-chromium-trace-to)
 (only (chibi temp-file) call-with-temp-dir)
 (only (lofi compiler reader) test-reader)
 (only (lofi compiler parser) test-parser)
 (only (lofi compiler resolved-library) test-library)
 (only (lofi compiler syntax-parser) test-syntax-parser)
 (only (lofi compiler ir) test-ir)
 (only (lofi compiler frontend) test-frontend)
 (only (lofi compiler macros) test-macros)
 (only (lofi compiler bootstrap) test-compiler)
 (only (lofi compiler profile) test-compiler-profile)
 (only (lofi compiler source-driver) test-source-driver)
 (only (lofi compiler artifact) test-artifact)
 (only (lofi compiler library-transfer) test-library-transfer)
 (only (lofi compiler numeric-literals) test-numeric-literals)
 (only (lofi compiler types) test-types)
 (only (lofi compiler typed) test-typed)
 (only (lofi compiler overloads) test-overloads)
 (only (lofi compiler hashmap) test-hashmap)
 (only (lofi compiler infer) test-infer)
 (only (lofi compiler specialize) test-specialize)
 (only (lofi compiler wasm-extern) test-wasm-extern))

(test-json)
(test-process)
(test-chromium-trace)
(test-compiler)
(test-compiler-profile)
(test-artifact)
(test-library-transfer)
(call-with-temp-dir
 "lofi-unit-traces"
 (lambda (directory preserve)
   (with-chromium-trace-to
    (string-append directory "/tests.json")
    (lambda ()
      (test-wasm)
      (test-reader)
      (test-parser)
      (test-library)
      (test-syntax-parser)
      (test-ir)
      (test-frontend)
      (test-macros)
      (test-source-driver)
      (test-numeric-literals)
      (test-types)
      (test-typed)
      (test-overloads)
      (test-hashmap)
      (test-infer)
      (test-specialize)
      (test-wasm-extern)))))
(display "All Lofi compiler host tests passed\n")
