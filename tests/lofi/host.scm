;; Chibi executes compiler implementation tests; product inputs are Lofi.
(import (scheme base) (scheme write)
        (only (wasm-native chromium-trace) with-chromium-trace-to)
        (only (chibi temp-file) call-with-temp-dir)
        (only (snail-scheme reader) test-reader)
        (only (snail-scheme parser) test-parser)
        (only (snail-scheme library) test-library)
        (only (snail-scheme syntax-parser) test-syntax-parser)
        (only (snail-scheme ir) test-ir)
        (only (snail-lofi frontend) test-frontend)
        (only (snail-lofi compiler) test-compiler)
        (only (snail-lofi source-driver) test-source-driver)
        (only (snail-lofi artifact) test-artifact)
        (only (snail-lofi library-transfer) test-library-transfer)
        (only (snail-lofi numeric-literals) test-numeric-literals)
        (only (snail-scheme strict-types) test-strict-types)
        (only (snail-scheme hashmap) test-hashmap)
        (only (snail-scheme strict-infer) test-strict-infer)
        (only (snail-scheme strict-specialize) test-strict-specialize)
        (only (snail-scheme wasm-extern) test-wasm-extern))

(test-compiler)
(test-artifact)
(test-library-transfer)
(call-with-temp-dir
 "lofi-unit-traces"
 (lambda (directory preserve)
   (with-chromium-trace-to
    (string-append directory "/tests.json")
    (lambda ()
      (test-reader)
      (test-parser)
      (test-library)
      (test-syntax-parser)
      (test-ir)
      (test-frontend)
      (test-source-driver)
      (test-numeric-literals)
      (test-strict-types)
      (test-hashmap)
      (test-strict-infer)
      (test-strict-specialize)
      (test-wasm-extern)))))
(display "All Lofi compiler host tests passed\n")
