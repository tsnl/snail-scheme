(import (scheme base) (scheme file) (scheme process-context)
        (scheme load) (snail-scheme wasm) (snail-scheme llvm) (snail-scheme chromium-trace))
(load "tests/native-datums.scm")
(define directory (cadr (command-line)))
(with-chromium-trace-to (string-append directory "/semantics.trace.json")
                        (lambda ()
                          (wasm->llvm-file native-test-module (string-append directory "/semantics.ll"))
                          (call-with-output-file (string-append directory "/semantics.wat")
                            (lambda (port) (write-wasm native-test-module port)))
                          ;; Lower a second time after printing to catch mutation of shared datums.
                          (wasm->llvm-file native-test-module (string-append directory "/semantics-again.ll"))))
