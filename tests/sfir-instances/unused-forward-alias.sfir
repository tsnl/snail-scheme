(import (sfir primitive))
(define-extern record "instance.probe" "record" (-> I64 Unit))

;; The unused method must read later now; later's effect must not run.
(define history (ref (ann 1 I64)))
(define observed (-> I64) (lambda () (ref-get history)))
(define-class (Identity T) (: identity (-> T T)))
(record (ann 1 I64))
(define-instance (Identity I64) (identity later))
(define later (-> I64 I64)
  (begin
    (record (ann 9 I64))
    (ref-set! history (ann 9 I64))
    (lambda (value) value)))
(ann 42 I64)
