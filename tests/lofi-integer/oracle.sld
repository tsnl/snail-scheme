(import (lofi base) (lofi integer))

;; ---- Scalar test transport; numbers remain in Lofi ----

(define-extern argument-length "oracle" "argument_length" (-> I32 I64))
(define-extern argument-character "oracle" "argument_character" (-> I32 I64 Char))
(define-extern emit-character "oracle" "emit_character" (-> Char Unit))
(def argument
     (lambda (index)
       (begin (let count (argument-length index))
              (begin (let text (make-string count))
                     (begin
                       (def loop
                            (lambda (at)
                              (if (= at count)
                                  text
                                  (begin (string-set! text at (argument-character index at)) (loop (+ at (ann 1 I64)))))))
                       (loop (ann 0 I64)))))))
(def emit
     (lambda (text)
       (begin
         (def loop
              (lambda (at)
                (if (= at (string-length text))
                    (unit)
                    (begin
                      (emit-character (string-ref text at)) (loop (+ at (ann 1 I64)))
                      (unit)))))
         (loop (ann 0 I64)))))

;; ---- Public operations and ownership observations ----

(def alias-check
     (lambda (text)
       (begin (let value (integer-from-string text))
              (begin (let saved (integer->string value))
                     (begin (let negative (integer-negate value))
                            (begin (let sum (+ value value))
                                   (begin (let quotient-value (quotient value (integer-from-i64 (ann 2 I64))))
                                          (begin
                                            (string-set! text (ann 0 I64) #\9)
                                            (begin (let copy (integer->string value))
                                                   (begin
                                                     (string-set! copy (ann 0 I64) #\8)
                                                     (if (if (string=? (integer->string value) saved)
                                                             (if (= (+ value negative) (integer-from-i64 (ann 0 I64)))
                                                                 (if (= (- sum value) value)
                                                                     (= (+ (* quotient-value (integer-from-i64 (ann 2 I64)))
                                                                           (remainder value (integer-from-i64 (ann 2 I64)))) value)
                                                                     #f)
                                                                 #f)
                                                             #f)
                                                         value
                                                         (unreachable))))))))))))
(def same-sign-aliases?
     (lambda (original opposite positive snapshot)
       (if (= original snapshot)
           (if (= opposite (integer-negate snapshot)) (= positive (integer-abs snapshot)) #f)
           #f)))
(def division-equation?
     (lambda (answer dividend divisor)
       (= dividend (+ (* (division-quotient answer) divisor) (division-remainder answer)))))
(def long-division-alias-check
     (lambda (left right)
       (begin (let left-snapshot (integer-from-string (integer->string left)))
              (begin (let right-snapshot (integer-from-string (integer->string right)))
                     (begin (let opposite-left (integer-negate left))
                            (begin (let positive-left (integer-abs left))
                                   (begin (let opposite-right (integer-negate right))
                                          (begin (let positive-right (integer-abs right))
                                                 (begin (let answer (integer-divide left right))
                                                        (begin (let alias-answer (integer-divide opposite-left positive-right))
                                                               (if (if (division-equation? answer left-snapshot right-snapshot)
                                                                       (if (division-equation? alias-answer (integer-negate left-snapshot) (integer-abs right-snapshot))
                                                                           (if (same-sign-aliases? left opposite-left positive-left left-snapshot)
                                                                               (same-sign-aliases? right opposite-right positive-right right-snapshot)
                                                                               #f)
                                                                           #f)
                                                                       #f)
                                                                   left
                                                                   (unreachable))))))))))))
(def same-truth?
     (lambda (left right) (if left right (not right))))
(def interface-check
     (lambda (left right)
       (begin (let order (integer-compare left right))
              (begin (let zero (integer-from-i64 (ann 0 I64)))
                     (begin (let positive (integer-abs left))
                            (begin (let answer (integer-sqrt/remainder positive))
                                   (if (if (same-truth? (< left right) (< order (ann 0 I64)))
                                           (if (same-truth? (<= left right) (<= order (ann 0 I64)))
                                               (if (same-truth? (> left right) (> order (ann 0 I64)))
                                                   (if (same-truth? (>= left right) (>= order (ann 0 I64)))
                                                       (if (same-truth? (integer-zero? left) (= left zero))
                                                           (if (same-truth? (integer-negative? left) (< left zero))
                                                               (if (= (- left) (integer-negate left))
                                                                   (if (= (integer-power left (ann 3 I64)) (* (* left left) left))
                                                                       (if (= (root-value answer) (integer-sqrt positive))
                                                                           (= positive (+ (* (root-value answer) (root-value answer))
                                                                                          (root-remainder answer)))
                                                                           #f)
                                                                       #f)
                                                                   #f)
                                                               #f)
                                                           #f)
                                                       #f)
                                                   #f)
                                               #f)
                                           #f)
                                       left
                                       (unreachable))))))))

(def integer-probe (-> I64 I64)
     (lambda (operation)
       (begin (let text (argument (ann 0 I32)))
              (begin (let a (integer-from-string text))
                     (begin (let b (integer-from-string (argument (ann 1 I32))))
                            (begin
                              (emit (integer->string
                                     (if (= operation (ann 0 I64))
                                         a
                                         (if (= operation (ann 1 I64))
                                             (+ a b)
                                             (if (= operation (ann 2 I64))
                                                 (- a b)
                                                 (if (= operation (ann 3 I64))
                                                     (* a b)
                                                     (if (= operation (ann 4 I64))
                                                         (quotient a b)
                                                         (if (= operation (ann 5 I64))
                                                             (remainder a b)
                                                             (if (= operation (ann 6 I64))
                                                                 (integer-sqrt a)
                                                                 (if (= operation (ann 7 I64))
                                                                     (integer-expt a b)
                                                                     (if (= operation (ann 8 I64))
                                                                         (integer-from-i64 (integer-compare a b))
                                                                         (if (= operation (ann 9 I64))
                                                                             (integer-from-i64 (integer->i64 a))
                                                                             (if (= operation (ann 10 I64))
                                                                                 (root-remainder (integer-sqrt/remainder a))
                                                                                 (if (= operation (ann 11 I64))
                                                                                     (alias-check text)
                                                                                     (if (= operation (ann 12 I64))
                                                                                         (long-division-alias-check a b)
                                                                                         (if (= operation (ann 13 I64))
                                                                                             (interface-check a b)
                                                                                             (if (= operation (ann 14 I64)) (integer-power a (integer->i64 b)) (unreachable))))))))))))))))))
                              (ann 1 I64)))))))
(unit)
