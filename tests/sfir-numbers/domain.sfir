(import (sfir base) (sfir integer) (sfir rational) (sfir number) (sfir datum))

;; ---- Scalar test transport and a checked complete token ----

(define-extern argument-length "oracle" "argument_length" (-> I32 I64))
(define-extern argument-character "oracle" "argument_character" (-> I32 I64 Char))
(define-extern emit-character "oracle" "emit_character" (-> Char Unit))
(def argument
  (lambda (index)
    (begin (let count (argument-length index))
      (begin (let text (make-string count))
        (begin
          (def loop
            (lambda (at)
              (if (= at count)
                  text
                  (begin (string-set! text at (argument-character index at)) (loop (+ at 1))))))
          (loop 0))))))
(def emit
  (lambda (text)
    (begin
      (def loop
        (lambda (at)
          (if (= at (string-length text))
              (unit)
              (begin
                (emit-character (string-ref text at)) (loop (+ at 1))
                (unit)))))
      (loop 0))))
(def parsed
  (lambda (text)
    (match (string->number text)
      ((parsed-number value) value)
      ((not-a-number) (unreachable)) ((number-error message) (unreachable)))))

;; ---- The Number boundary uses its ordinary static operator families ----

(def arithmetic
  (lambda (operation left right)
    (if (= operation 1)
        (+ left right)
        (if (= operation 2) (- left right) (if (= operation 3) (* left right) (/ left right))))))
(def projection
  (lambda (operation value)
    (if (= operation 7)
        (truncate value)
        (if (= operation 9)
            (number-numerator value)
            (if (= operation 10)
                (number-denominator value)
                (if (= operation 11)
                    (number-real-part value)
                    (if (= operation 12)
                        (number-imag-part value)
                        (if (= operation 16)
                            (number-negate value)
                            (if (= operation 17) (number-abs value) (number-from-integer (number->integer value)))))))))))
(def domain-bits
  (lambda (value)
    (+ (if (number-exact? value) 1 0)
       (+ (if (number-real? value) 2 0)
          (+ (if (number-rational? value) 4 0)
             (+ (if (number-integer? value) 8 0) (if (number-exact-integer? value) 16 0)))))))
(def comparison
  (lambda (left right)
    (+ (if (= left right) 1 0)
       (+ (if (< left right) 2 0)
          (+ (if (<= left right) 4 0) (+ (if (> left right) 8 0) (if (>= left right) 16 0)))))))
(def radix-number
  (lambda (operation)
    (begin (let sfir-migration-let-1 (argument (ann 0 I32))) (let sfir-migration-let-2 (integer->i64 (integer-from-string (argument (ann 1 I32)))))
      (let text sfir-migration-let-1)
(let base sfir-migration-let-2)
(if (= operation 19)
          (parsed-number-value (string->number text base))
          (number-from-integer (integer-from-string/radix text base))))))
(def observed-number
  (lambda (operation value)
    (if (= operation 5)
        (number-exact (inexact-number value))
        (if (>= operation 19)
            (radix-number operation)
            (begin (let left (parsed (argument (ann 0 I32))))
              (if (= operation 0)
                  left
                  (if (<= operation 4)
                      (arithmetic operation left (parsed (argument (ann 1 I32))))
                      (projection operation left))))))))
(def scalar-observation
  (lambda (operation)
    (begin (let left (parsed (argument (ann 0 I32))))
      (if (= operation 6)
          (number->f64 (number-inexact left))
          (if (= operation 14)
              (i64->f64 (domain-bits left))
              (begin (let right (parsed (argument (ann 1 I32))))
                (if (= operation 13)
                    (i64->f64 (comparison left right))
                    (if (number-equivalent? left right) 1.0 0.0))))))))

(def probe (-> I64 F64 F64)
  (lambda (operation value)
    (if (if (= operation 6) #t (if (>= operation 13) (<= operation 15) #f))
        (scalar-observation operation)
        (begin (let number (observed-number operation value))
          (begin (let text (number->string number))
            (begin
              (if (number-equivalent? number (parsed text))
                  (unit)
                  (begin (unreachable)
                         (unit)))
              (emit text) 0.0))))))
(unit)

;; Execute the retained module tests through their ordinary SFIR exports.
(if (= (test-rational) 42) (unit) (unreachable))
(if (= (test-number) 42) (unit) (unreachable))
