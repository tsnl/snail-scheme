;; Chez-only state probes inspect consumption after a locally caught error.
;; They do not claim that a guest can recover from a fatal Rust ABI failure.

;; ---- Owned handles distinguish rejecting access from consuming a token ----

(define open-token (scalar-service "snail:datum/token-open"))
(define add-character (scalar-service "snail:datum/token-character"))
(define parse-token (scalar-service "snail:datum/token-parse"))
(define close-token (scalar-service "snail:datum/token-close"))
(define intern-token (scalar-service "snail:datum/token-intern"))
(define token-length (scalar-service "snail:datum/token-text-length"))
(define scalar-kind (scalar-service "snail:datum/number-kind"))
(define (stage-token text)
  (let ((handle (open-token)))
    (string-for-each (lambda (character) (add-character handle character)) text)
    handle))
(define (expect-token-error expected action)
  (let ((message (guard (condition (else (condition-message condition))) (action) #f)))
    (unless (and (string? message) (string=? message expected))
      (error 'ownership "wrong token diagnostic" expected message))))
(define (expect-consumed handle)
  (expect-token-error "invalid or closed token handle" (lambda () (token-length handle))))
(define (check-repeated-parse)
  (let ((handle (stage-token "1")))
    (parse-token handle)
    (expect-token-error "token has already been parsed" (lambda () (parse-token handle)))
    (expect-consumed handle)))
(define (check-rejected-intern text)
  (let ((handle (stage-token text)))
    (parse-token handle)
    (expect-token-error "symbol interning requires an unparsed text handle" (lambda () (intern-token handle)))
    (expect-consumed handle)))
(define (check-interleaved-handles)
  (let ((number (stage-token "1/2")) (word (stage-token "name")))
    (unless (= (parse-token number) 5) (error 'ownership "expected exact lexical fraction"))
    (unless (= (parse-token word) 0) (error 'ownership "expected identifier"))
    (intern-token word)
    (expect-consumed word)
    (unless (= (scalar-kind number 0) 5) (error 'ownership "other token was changed"))
    (close-token number)
    (expect-consumed number)))
(define (check-rejected-append)
  (let ((handle (stage-token "1")))
    (parse-token handle)
    (expect-token-error "token has already been parsed" (lambda () (add-character handle #\2)))
    (unless (= (scalar-kind handle 0) 1) (error 'ownership "append rejection consumed token"))
    (close-token handle)))
(check-repeated-parse)
(check-rejected-intern "1")
(check-rejected-intern "1/0")
(check-interleaved-handles)
(check-rejected-append)
(display "PASS Chez token ownership transitions\n")
