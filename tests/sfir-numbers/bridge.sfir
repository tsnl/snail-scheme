(import (sfir core))

;; ---- Scalar-only observation of owned token fields ----

(define-extern argument-length "oracle" "argument_length" (-> I32 I64))
(define-extern argument-character "oracle" "argument_character" (-> I32 I64 Char))
(define-extern emit-character "oracle" "emit_character" (-> Char Unit))
(define-extern token-open "snail.library" "snail:datum/token-open" (-> I32))
(define-extern token-character "snail.library" "snail:datum/token-character" (-> I32 Char Unit))
(define-extern token-close "snail.library" "snail:datum/token-close" (-> I32 Unit))
(define-extern token-parse "snail.library" "snail:datum/token-parse-radix" (-> I32 I32 I32))
(define-extern token-intern "snail.library" "snail:datum/token-intern" (-> I32 I32))
(define-extern token-kind "snail.library" "snail:datum/number-kind" (-> I32 I32 I32))
(define-extern token-integer "snail.library" "snail:datum/number-integer" (-> I32 I32 I64))
(define-extern token-real "snail.library" "snail:datum/number-real" (-> I32 I32 F64))
(define-extern token-radix "snail.library" "snail:datum/number-radix" (-> I32 I32 I32))
(define-extern token-scale "snail.library" "snail:datum/number-scale" (-> I32 I32 I64))
(define-extern token-digits-length "snail.library" "snail:datum/number-text-length" (-> I32 I32 I32 I32))
(define-extern token-digits-character "snail.library" "snail:datum/number-text-character" (-> I32 I32 I32 I32 Char))
(define-extern token-error-length "snail.library" "snail:datum/error-length" (-> I32 I32))
(define-extern token-error-character "snail.library" "snail:datum/error-character" (-> I32 I32 Char))
(define-extern real-text "snail.library" "snail:datum/real-text" (-> F64 I32))
(define-extern text-length "snail.library" "snail:datum/token-text-length" (-> I32 I32))
(define-extern text-character "snail.library" "snail:datum/token-text-character" (-> I32 I32 Char))

(define stage-argument
  (lambda ()
    (let ((handle (token-open)) (count (argument-length (ann 0 I32))))
      (begin
        (define loop
          (lambda (at)
            (if (= at count)
                handle
                (begin (token-character handle (argument-character (ann 0 I32) at)) (loop (+ at 1))))))
        (loop 0)))))
(define argument-radix
  (lambda ()
    (begin
      (define loop
        (lambda (at value)
          (if (= at (argument-length (ann 1 I32)))
              (i64->i32 value)
              (loop (+ at 1) (+ (* value 10) (- (char->integer (argument-character (ann 1 I32) at)) 48))))))
      (loop 0 0))))
(define emit-natural
  (lambda (value)
    (begin
      (if (<= value -10)
          (begin (emit-natural (quotient value 10))
                 (unit))
          (unit))
      (emit-character (integer->char (- 48 (remainder value 10)))))))
(define emit-integer
  (lambda (value)
    (begin
      (if (< value 0)
          (begin (emit-character #\-)
                 (unit))
          (unit))
      (emit-natural (if (< value 0) value (- 0 value))))))
(define emit-text
  (lambda (handle)
    (let ((count (i32->i64 (text-length handle))))
      (begin
        (define loop
          (lambda (at)
            (if (= at count)
                (unit)
                (begin
                  (emit-character (text-character handle (i64->i32 at))) (loop (+ at 1))
                  (unit)))))
        (loop 0)))))
(define emit-real
  (lambda (value)
    (let ((handle (real-text value)))
      (begin (emit-text handle) (token-close handle)))))
(define emit-digits
  (lambda (handle part term)
    (let ((count (i32->i64 (token-digits-length handle part term))))
      (begin
        (define loop
          (lambda (at)
            (if (= at count)
                (unit)
                (begin
                  (emit-character (token-digits-character handle part term (i64->i32 at))) (loop (+ at 1))
                  (unit)))))
        (loop 0)))))
(define emit-fraction
  (lambda (handle part)
    (begin
      (emit-integer (i32->i64 (token-radix handle part))) (emit-character #\:)
      (emit-integer (token-scale handle part)) (emit-character #\:)
      (emit-digits handle part (ann 0 I32)) (emit-character #\/)
      (emit-digits handle part (ann 1 I32)))))
(define emit-scalar
  (lambda (handle part)
    (let ((kind (i32->i64 (token-kind handle part))))
      (begin
        (emit-character #\|) (emit-integer kind) (emit-character #\:)
        (if (= kind 1)
            (emit-integer (token-integer handle part))
            (if (= kind 2) (emit-real (token-real handle part)) (emit-fraction handle part)))))))
(define emit-error
  (lambda (handle)
    (begin
      (emit-character #\|)
      (let ((count (i32->i64 (token-error-length handle))))
        (begin
          (define loop
            (lambda (at)
              (if (= at count)
                  (unit)
                  (begin
                    (emit-character (token-error-character handle (i64->i32 at))) (loop (+ at 1))
                    (unit)))))
          (loop 0))))))
(define emit-classification
  (lambda (handle kind)
    (begin
      (emit-integer kind)
      (if (= kind 4)
          (emit-error handle)
          (if (= kind 0)
              (unit)
              (begin
                (emit-scalar handle (ann 0 I32))
                (if (if (= kind 3) #t (if (= kind 7) #t (= kind 8)))
                    (begin (emit-scalar handle (ann 1 I32))
                           (unit))
                    (unit))
                (unit)))))))

;; ---- Invalid operations remain separate from successful observations ----

(define probe-token
  (lambda (operation)
    (let ((handle (stage-argument)))
      (let ((kind (i32->i64 (token-parse handle (argument-radix)))))
        (begin
          (if (= operation 0)
              (emit-classification handle kind)
              (if (= operation 2)
                  (emit-integer (token-integer handle (ann 0 I32)))
                  (if (= operation 3)
                      (emit-real (token-real handle (ann 0 I32)))
                      (if (= operation 4)
                          (token-close handle)
                          (if (= operation 5)
                              (begin (token-parse handle (ann 10 I32)) (unit))
                              (if (= operation 6)
                                  (token-character handle #\a)
                                  (if (= operation 7)
                                      (begin (token-intern handle) (unit))
                                      (if (= operation 8)
                                          (begin (token-close handle) (emit-text handle))
                                          (if (= operation 9)
                                              (emit-fraction handle (ann 0 I32))
                                              (if (= operation 10)
                                                  (emit-scalar handle (ann 2 I32))
                                                  (begin
                                                    (token-close handle)
                                                    (if (= operation 11) (emit-scalar handle (ann 0 I32)) (emit-error handle)))))))))))))
          (token-close handle))))))

(define probe (-> I64 F64 F64)
  (lambda (operation value)
    (begin
      (if (= operation 1) (emit-real value) (probe-token operation))
      0.0)))
(unit)
