(import (sfir core) (sfir integer))

;; ---- Scalar test transport; numbers remain in SFIR ----

(define-extern argument-length "oracle" "argument_length" (-> I32 I64))
(define-extern argument-character "oracle" "argument_character" (-> I32 I64 Char))
(define-extern emit-character "oracle" "emit_character" (-> Char Unit))
(define argument
  (lambda (index)
    (let ((count (argument-length index)))
      (let ((text (make-string count)))
        (begin
          (define loop
            (lambda (at)
              (if (= at count)
                  text
                  (begin (string-set! text at (argument-character index at)) (loop (+ at 1))))))
          (loop 0))))))
(define emit
  (lambda (text)
    (begin
      (define loop
        (lambda (at)
          (if (= at (string-length text))
              (unit)
              (begin
                (emit-character (string-ref text at)) (loop (+ at 1))
                (unit)))))
      (loop 0))))

;; ---- Public operations and ownership observations ----

(define alias-check
  (lambda (text)
    (let ((value (integer-from-string text)))
      (let ((saved (integer->string value)))
        (let ((negative (integer-negate value)))
          (let ((sum (+ value value)))
            (let ((quotient-value (quotient value (integer-from-i64 2))))
              (begin
                (string-set! text 0 #\9)
                (let ((copy (integer->string value)))
                  (begin
                    (string-set! copy 0 #\8)
                    (if (if (string=? (integer->string value) saved)
                            (if (= (+ value negative) (integer-from-i64 0))
                                (if (= (- sum value) value)
                                    (= (+ (* quotient-value (integer-from-i64 2))
                                          (remainder value (integer-from-i64 2))) value)
                                    #f)
                                #f)
                            #f)
                        value
                        (unreachable))))))))))))
(define same-sign-aliases?
  (lambda (original opposite positive snapshot)
    (if (= original snapshot)
        (if (= opposite (integer-negate snapshot)) (= positive (integer-abs snapshot)) #f)
        #f)))
(define division-equation?
  (lambda (answer dividend divisor)
    (= dividend (+ (* (division-quotient answer) divisor) (division-remainder answer)))))
(define long-division-alias-check
  (lambda (left right)
    (let ((left-snapshot (integer-from-string (integer->string left))))
      (let ((right-snapshot (integer-from-string (integer->string right))))
        (let ((opposite-left (integer-negate left)))
          (let ((positive-left (integer-abs left)))
            (let ((opposite-right (integer-negate right)))
              (let ((positive-right (integer-abs right)))
                (let ((answer (integer-divide left right)))
                  (let ((alias-answer (integer-divide opposite-left positive-right)))
                    (if (if (division-equation? answer left-snapshot right-snapshot)
                            (if (division-equation? alias-answer (integer-negate left-snapshot) (integer-abs right-snapshot))
                                (if (same-sign-aliases? left opposite-left positive-left left-snapshot)
                                    (same-sign-aliases? right opposite-right positive-right right-snapshot)
                                    #f)
                                #f)
                            #f)
                        left
                        (unreachable))))))))))))
(define same-truth?
  (lambda (left right) (if left right (not right))))
(define interface-check
  (lambda (left right)
    (let ((order (integer-compare left right)))
      (let ((zero (integer-from-i64 0)))
        (let ((positive (integer-abs left)))
          (let ((answer (integer-sqrt/remainder positive)))
            (if (if (same-truth? (< left right) (< order 0))
                    (if (same-truth? (<= left right) (<= order 0))
                        (if (same-truth? (> left right) (> order 0))
                            (if (same-truth? (>= left right) (>= order 0))
                                (if (same-truth? (integer-zero? left) (= left zero))
                                    (if (same-truth? (integer-negative? left) (< left zero))
                                        (if (= (- left) (integer-negate left))
                                            (if (= (integer-power left 3) (* (* left left) left))
                                                (if (= (root-value answer) (integer-sqrt positive))
                                                    (= positive (+ (* (root-value answer) (root-value answer))
                                                                   (root-remainder answer)))
                                                    #f)
                                                #f)
                                            #f)
                                        #f)
                                    #f)
                                #f)
                            #f)
                        #f)
                    #f)
                left
                (unreachable))))))))

(define integer-probe (-> I64 I64)
  (lambda (operation)
    (let ((text (argument (ann 0 I32))))
      (let ((a (integer-from-string text)))
        (let ((b (integer-from-string (argument (ann 1 I32)))))
          (begin
            (emit (integer->string
                   (if (= operation 0)
                       a
                       (if (= operation 1)
                           (+ a b)
                           (if (= operation 2)
                               (- a b)
                               (if (= operation 3)
                                   (* a b)
                                   (if (= operation 4)
                                       (quotient a b)
                                       (if (= operation 5)
                                           (remainder a b)
                                           (if (= operation 6)
                                               (integer-sqrt a)
                                               (if (= operation 7)
                                                   (integer-expt a b)
                                                   (if (= operation 8)
                                                       (integer-from-i64 (integer-compare a b))
                                                       (if (= operation 9)
                                                           (integer-from-i64 (integer->i64 a))
                                                           (if (= operation 10)
                                                               (root-remainder (integer-sqrt/remainder a))
                                                               (if (= operation 11)
                                                                   (alias-check text)
                                                                   (if (= operation 12)
                                                                       (long-division-alias-check a b)
                                                                       (if (= operation 13)
                                                                           (interface-check a b)
                                                                           (if (= operation 14) (integer-power a (integer->i64 b)) (unreachable))))))))))))))))))
            1))))))
(unit)
