;; Compile supplied library values. Filesystem writes surround the compiler API.
(import (scheme base) (scheme file) (scheme process-context)
        (snail-scheme reader) (snail-scheme syntax-parser)
        (snail-scheme chromium-trace) (snail-scheme strict-primitives)
        (snail-sfir frontend) (snail-sfir compiler)
        (only (snail-scheme test-utils) expect)
        (only (srfi 130) string-contains))

(define directory (cadr (command-line)))
(define (parsed text)
  (parse-library (car (reader->syntax-list (string->reader "entry-fixture.sfir" text)))))
(define libraries
  (with-chromium-trace-to
   (string-append directory "/parse.json")
   (lambda ()
     (let ((provider (parsed "(define-library (entry provider)
                               (import (only (sfir primitive) i32-add))
                               (export (rename worker public-worker))
                               (begin (define-extern tick \"entry.test\" \"tick\" (-> I32))
                                 (def offset (tick))
                                 (def secret (-> I32) (lambda () 40))
                                 (def worker (lambda (x) (i32-add (i32-add (secret) offset) x)))))"))
           (facade (parsed "(define-library (entry facade)
                             (import (rename (entry provider) (public-worker selected))
                               (only (entry alias)) (only (entry decoy)))
                             (export (rename selected main) (rename selected another))
                             (begin (def worker (-> I32 I32) (lambda (x) 1000)) (def entry (ann 666 I64))))"))
           (decoy (parsed "(define-library (entry decoy)
                            (begin (def worker (-> I32 I32) (lambda (x) 999))))")))
       (list (cons '(sfir primitive) (make-primitive-library primitive-names))
             (cons '(entry provider) provider) (cons '(entry alias) provider)
             (cons '(entry facade) facade) (cons '(entry other-facade) facade) (cons '(entry decoy) decoy))))))

(define native-target (native64-target (list (make-native-import "entry.test" "tick" "entry_tick" '() 'i32))))
(define (write-artifact entry target path)
  (let ((artifact (compile libraries entry target)))
    (expect (eq? (artifact-entry artifact) entry) #t)
    (expect (eq? (artifact-target artifact) target) #t)
    (expect (artifact-parameters artifact) '(I32))
    (expect (artifact-result artifact) 'I32)
    (call-with-port (open-binary-output-file path)
      (lambda (port) (write-bytevector (artifact-bytes artifact) port)))))
(define (reject-native imports message)
  (expect (guard (failure (else (and (error-object? failure)
                                     (if (string-contains (error-object-message failure) message) #t #f))))
            (compile libraries (make-entry '(entry facade) 'main) (native64-target imports)) #f) #t))

;; Both public aliases name the same provider through different map aliases.
(for-each
 (lambda (selection)
   (let* ((name (symbol->string (cdr selection))) (entry (make-entry (car selection) (cdr selection))))
     (write-artifact entry wasm-target (string-append directory "/" name ".wasm"))
     (write-artifact entry native-target (string-append directory "/" name ".o"))))
 '(((entry facade) . main) ((entry other-facade) . another)))
(reject-native '() "native import has no provider declaration")
(reject-native (list (make-native-import "entry.test" "tick" "entry_tick" '() 'i64))
               "native provider signature does not match Wasm import")
