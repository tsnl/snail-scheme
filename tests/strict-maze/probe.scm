;; These observations use the same original or adapted Maze operations.
;; Representation selectors read links directly; observing them never compresses
;; a union-find path or changes a maze parent.

;; ---- Work counters and complete ordered wall observations ----

(define probe-counts (make-vector 16 0))
(define probe-snapshots (ref #f))
(define (probe-tick index)
  (vector-set! probe-counts index (+ (vector-ref probe-counts index) 1)))
(define (probe-reset)
  (let loop ((index 0))
    (unless (= index 16) (vector-set! probe-counts index 0) (loop (+ index 1)))))
(define (probe-assert label passed)
  (emit-i64 label) (emit-i64 (if passed 1 0))
  (unless passed (unreachable)))
(define (probe-work)
  (emit-i64 200)
  (let loop ((index 0))
    (unless (= index 16) (emit-i64 (vector-ref probe-counts index)) (loop (+ index 1)))))
(define (probe-wall wall)
  (emit-i64 (probe-x (wall:owner wall))) (emit-i64 (probe-y (wall:owner wall)))
  (emit-i64 (probe-x (wall:neighbor wall))) (emit-i64 (probe-y (wall:neighbor wall)))
  (emit-i64 (wall:bit wall)))
(define (probe-wall-vector stage walls)
  (when (ref-get probe-snapshots)
    (emit-i64 stage) (emit-i64 (vector-length walls))
    (let loop ((index 0))
      (unless (= index (vector-length walls))
        (probe-wall (vector-ref walls index)) (loop (+ index 1)))))
  walls)
(define (probe-visit wall)
  (probe-tick 9)
  (when (ref-get probe-snapshots) (emit-i64 102) (probe-wall wall)))
(define (probe-set-id set cells)
  (let loop ((index 0))
    (if (= index (vector-length cells)) -1
        (if (probe-set-same? set (cell:reachable (vector-ref cells index))) index
            (loop (+ index 1))))))
(define (probe-parent-id cell columns)
  (if (probe-parent-present? cell)
      (let ((parent (probe-parent-cell cell)))
        (+ (* columns (quotient (probe-y parent) 2)) (quotient (probe-x parent) 3))) -1))
(define (probe-cell-state cell cells columns)
  (emit-i64 (probe-x cell)) (emit-i64 (probe-y cell))
  (emit-i64 (cell:walls cell)) (emit-i64 (if (cell:mark cell) 1 0))
  (emit-i64 (probe-parent-id cell columns))
  (let ((set (cell:reachable cell)))
    (emit-i64 (probe-set-size-field set))
    (emit-i64 (if (probe-set-linked? set) (probe-set-id (probe-set-next set) cells) -1))))
(define (probe-grid stage grid)
  (when (ref-get probe-snapshots)
    (emit-i64 stage) (emit-i64 (harr:nrows grid)) (emit-i64 (harr:ncols grid))
    (let ((cells (harr:elts grid)))
      (let loop ((index 0))
        (unless (= index (vector-length cells))
          (probe-cell-state (vector-ref cells index) cells (harr:ncols grid))
          (loop (+ index 1)))))))
(define (probe-after-dig grid walls)
  (when (ref-get probe-snapshots)
    (emit-i64 103) (emit-i64 (vector-length walls))
    (emit-i64 (vector-ref probe-counts 9))
    (emit-i64 (- (vector-length walls) (vector-ref probe-counts 9))))
  (probe-grid 104 grid))
(define (probe-finished-maze grid entrance exit)
  (when (ref-get probe-snapshots) (emit-i64 105) (emit-i64 entrance) (emit-i64 exit))
  (probe-grid 106 grid))
(define (probe-characters chars)
  (emit-i64 107)
  (let loop ((chars chars))
    (unless (null? chars) (emit-char (car chars)) (loop (cdr chars)))))

;; ---- Signed integer helpers, deterministic RNG, and set identity ----

(define (probe-integers)
  (let outer ((x -9))
    (unless (> x 9)
      (let inner ((y -4))
        (unless (> y 4)
          (unless (= y 0) (emit-i64 (div x y)) (emit-i64 (mod x y)))
          (emit-i64 (bitwise-and x y)) (inner (+ y 1))))
      (outer (+ x 1))))
  (let ((state (random-state 20)))
    (let loop ((index 0))
      (unless (= index 10) (emit-i64 (rand state)) (loop (+ index 1))))))
(define (probe-union-find)
  (let* ((a (base-set 1)) (b (base-set 1)) (c (base-set 2)))
    (probe-assert 1 (not (probe-set-same? a b)))
    (union! a b)
    (probe-assert 2 (and (probe-set-same? (probe-set-next a) b) (= (set-size a) 2)))
    (union! b c)
    (probe-assert 3 (and (probe-set-same? (probe-set-next b) c)
                         (probe-set-same? (probe-set-next a) b)))
    (probe-assert 4 (probe-set-same? (get-set-root a) c))
    (probe-assert 5 (and (probe-set-same? (probe-set-next a) c)
                         (probe-set-same? (probe-set-next b) c) (= (set-size a) 4)))))
(define (probe-cell-aliases)
  (let* ((grid (gen-maze-array 2 2)) (cell (href/rc grid 0 0))
         (wall (make-wall cell (href/rc grid 0 1) 1)))
    (probe-assert 6 (probe-cell-same? cell (wall:owner wall)))
    (set-cell:walls (wall:owner wall) 23)
    (probe-assert 7 (= (cell:walls (href/rc grid 0 0)) 23))
    (set-wall:neighbor wall cell)
    (probe-assert 8 (probe-cell-same? cell (wall:neighbor wall)))))

;; ---- A separate complete snapshot precedes full-count counter execution ----

(define (probe-run count rows columns expected)
  (probe-integers) (probe-union-find) (probe-cell-aliases)
  (probe-reset) (ref-set! probe-snapshots #t)
  (let ((result (run rows columns))) (probe-characters result))
  (ref-set! probe-snapshots #f) (probe-work) (probe-reset)
  (let loop ((index 0) (result (initial-output)))
    (if (< index count)
        (loop (+ index 1) (character-output (run rows columns)))
        (begin (probe-work) (if (same-output? result expected) 1 0)))))
