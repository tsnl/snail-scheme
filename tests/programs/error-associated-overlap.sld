(import
 (snail core base)
 (snail core io))

(typeclass (Op E A B)
  (type Output)
  (declare (op (left A) (right B)) (→ Output) (! E)))
(instance (Op (!) I64 I64)
  (type Output I64)
  (define (op (a I64) (b I64)) (→ I64)
    (+ a b)))
(instance (Op (!) I64 I64)
  (type Output String)
  (define (op (a I64) (b I64)) (→ String)
    (show (+ a b))))
