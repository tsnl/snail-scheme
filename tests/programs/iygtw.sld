(import
 (snail core base)
 (snail core io)
 (snail shell wire)
 (snail shell game physics)
 (snail shell game locomotion)
 (snail shell game terrain)
 (snail shell graphics pod)
 (snail shell graphics animation)
 (snail shell graphics gltf animation)
 (snail shell game vehicle)
 (apps iygtw soil)
 (apps iygtw rider)
 (apps iygtw ride))

(define (check (ok Bool) (why String)) (→ Unit) (unless ok (panic why)))
(define (ticks (v Valley) (s Ride) (n I64) (turn F64) (pedal Bool) (back Bool) (brake Bool))
  (→ Ride)
  (if (= n 0) s (ticks v (step-ride v s turn pedal back brake) (- n 1) turn pedal back brake)))
(define (survey (v Valley)) (→ Unit)
  (let ((g (● v ground)) (bridge (xz 16.0 -32.7)) (water (xz 55.3 -34.0)))
    (check (= (surface-at v bridge) 3) "road and bridge decks disagree")
    (check (> (ground-height g bridge) (ground-height g water)) "bridge submerged")
    (check (clear? bridge 0.24 (nearby-solids g bridge 1.0)) "bridge centre blocked")
    (check (not (clear? water 0.24 (nearby-solids g water 1.0))) "open pond rideable")
    (check (string=? (place-at v bridge) "Mill Bridge") "unmarked crossing")))
(define (crossing (v Valley) (x F64) (z F64) (direction F64)) (→ Unit)
  (let* ((s (start-ride v))
         (p (xz x (+ z (* direction 6.5))))
         (angle (if (> direction 0.0) 0.0 3.14159265)))
    (set! (● s bike) (body p angle)) (set! (● s dog) (body (offset p (xz 1.0 0.0) 0.6) angle))
    (let ((end (ticks v s 600 0.0 #t #f #f)))
      (check (> (* direction (- z (● end bike position z))) 6.0)
             "bridge cannot be ridden end to end"))))

(define (ride (v Valley)) (→ Unit)
  (let* ((s (start-ride v)) (pedal (ticks v s 120 0.0 #t #f #f))
         (coast (ticks v pedal 35 0.0 #f #f #f)) (stop (ticks v coast 120 0.0 #f #f #t))
         (right (ticks v pedal 16 1.0 #t #f #f)) (left (ticks v pedal 16 -1.0 #t #f #f)))
    (let ((once (step-ride v s 1.0 #t #f #f)) (launch (ticks v s 15 0.0 #t #f #f)))
      (check (< 0.0 (● once steer)) "wheel ignored steering")
      (check (< (● once steer) 0.05) "wheel snapped to full lock")
      (check (< (● once lean) 0.001) "stationary rider banked")
      (check (> (● launch standing) 0.42) "rider stayed seated on departure")
      (check (< (● coast standing) (● pedal standing)) "rider stayed standing while freewheeling"))
    (check (string=? (place-at v (● s bike position)) "Lantern Row") "spawn")
    (check (= (surface-at v (● s bike position)) 1) "spawn off the lane")
    (check (> (● pedal metres) 3.0) "cannot ride out of Lantern Row")
    (check (> (● coast wheel) (● pedal wheel)) "wheel froze while coasting")
    (check (= (● coast crank) (● pedal crank)) "freewheel drove the cranks")
    (check (= (signed-speed (● stop bike)) 0.0) "brake cannot hold")
    (check (< (signed-speed (● (ticks v stop 24 0.0 #f #t #f) bike)) 0.0) "cannot back up")
    (check (> (● right bike heading) (● left bike heading)) "steering direction")
    (check (< (distance (● coast bike position) (● coast dog position)) 6.0) "Moss lost the rider")
    (let ((restored (ann (deserialize (serialize coast)) Ride)))
      (let* ((custom (Ride-samples-set (Ride-light-set restored 2) 4))
             (reset (reset-ride v custom)))
        (check (and (= (● reset light) 2) (= (● reset samples) 4) (= (● reset metres) 0.0))
               "reset lost the graphics settings"))
      (check (and (= (● coast metres) (● restored metres)) (= (● coast wheel) (● restored wheel))
                  (= (distance (● coast dog position) (● restored dog position)) 0.0))
             "save round trip"))))
(define (socket (r Rig) (pose (Array Mat4x4f)) (name String)) (→ Vec4f)
  (match (named-node r name)
    ((Some n) (● (array-ref pose n) w))
    (_ (panic (string-append "missing Roadster socket " name)))))
(define (clip-frame (a Rigged) (name String) (phase F64)) (→ (Array Mat4x4f))
  (let ((r (● a rig)) (c (named-clip a name)))
    (posed-nodes r (sample-pose r c (* phase (● c duration))) unit-matrix)))
(define (gap (foot Vec4f) (pedal Vec4f)) (→ Vec4f)
  (v4 (- (● foot x) (● pedal x)) (- (● foot y) (● pedal y)) (- (● foot z) (● pedal z)) 0.0))
(define (same-gap (a Vec4f) (b Vec4f)) (→ Bool)
  (and (< (abs (- (● a x) (● b x))) 0.002) (< (abs (- (● a y) (● b y))) 0.002)
       (< (abs (- (● a z) (● b z))) 0.002)))
(define (arm-length (a Vec4f) (b Vec4f)) (→ F64)
  (let ((x (f32->f64 (- (● a x) (● b x)))) (y (f32->f64 (- (● a y) (● b y))))
        (z (f32->f64 (- (● a z) (● b z)))))
    (sqrt (+ (+ (* x x) (* y y)) (* z z)))))
(define (foot-gap (r Rig) (p (Array Mat4x4f)) (side String)) (→ Vec4f)
  (gap (socket r p (string-append side "Foot")) (socket r p (string-append side "Pedal"))))
(define (rider-rig (a Rigged)) (→ Unit)
  (let* ((r (● a rig)) (start (clip-frame a "Pedal" 0.0)) (half (clip-frame a "Pedal" 0.5))
         (travel (gap (socket r start "RFoot") (socket r half "RFoot"))))
    (check (> (+ (abs (● travel y)) (abs (● travel z))) 0.29)
           "feet did not travel around the crank")
    (for-each (lambda (i)
                (let* ((t (/ (i64->f64 i) 32.0)) (sit (clip-frame a "Pedal" t))
                       (stand (clip-frame a "Climb" t)))
                  (check (> (- (● (socket r stand "Body") y) (● (socket r sit "Body") y)) 0.075)
                         "climbing left the pelvis in the saddle")
                  (for-each (lambda (side)
                              (let ((rest (foot-gap r start side)))
                                (check (and (same-gap rest (foot-gap r sit side))
                                            (same-gap rest (foot-gap r stand side)))
                                       "shoe slid off its pedal"))) (list "L" "R"))))
              (iota 33))
    (for-each (lambda (name)
                (for-each (lambda (time)
                            (let* ((joints (clip-frame a name time))
                                   (arm (lambda (part) (socket r joints (string-append "R" part)))))
                              (check
                               (and (< (abs (- (arm-length (arm "UpperArm") (arm "Forearm")) 0.267))
                                       0.002)
                                    (< (abs (- (arm-length (arm "Forearm") (arm "Hand")) 0.228))
                                       0.002))
                               "arm stretched or changed proportion")))
                          (list 0.0 0.5 1.0)))
              (list "Reach" "Standing reach" "Backing reach" "Brace" "Idle" "Walk" "Run"))
    (let* ((rest (posed-nodes r (● r rest) unit-matrix))
           (inv (lambda (name)
                  (match (find (lambda (j)
                                 (= (● j node) (match (named-node r name) ((Some n) n) (_ -1))))
                               (● r joints))
                    ((Some j) (● j inverse-bind)) (_ (panic "missing bind pose"))))))
      (for-each (lambda (side)
                  (let* ((name (string-append side "UpperArm"))
                         (socket-in-body (product-column (inv "Body") (socket r rest name))))
                    (for-each (lambda (step)
                                (let* ((body (clip-frame a "Walk back" step))
                                       (shoulder (product-column (array-ref body
                                                                            (match (named-node r
                                                                                               "Body")
                                                                              ((Some n) n)
                                                                              (_ -1)))
                                                                 socket-in-body)))
                                  (for-each (lambda (turn)
                                              (let ((grip (clip-frame a "Backing reach" turn)))
                                                (check (same-gap shoulder (socket r grip name))
                                                       "backing detached arm at shoulder")
                                                (check (same-gap
                                                        (socket r grip (string-append side "Hand"))
                                                        (socket r
                                                                (clip-frame a "Reach" turn)
                                                                (string-append side "Hand")))
                                                       "backing hand left the handlebar")))
                                            (list 0.0 0.25 0.5 0.75 1.0))))
                              (list 0.0 0.25 0.5 0.75 1.0)))) (list "L" "R")))
    (for-each (lambda (side)
                (let ((hand (string-append side "Hand")))
                  (for-each (lambda (t)
                              (check (same-gap (socket r (clip-frame a "Reach" t) hand)
                                               (socket r (clip-frame a "Standing reach" t) hand))
                                     "standing rider lost the handlebar")) (list 0.0 0.5 1.0))))
              (list "L" "R"))))
(define (climbing (v Valley)) (→ Unit)
  (let* ((s (start-ride v)) (p (xz -7.0 32.0)) (b (body p 0.0)))
    (set! (● s bike) (Body-velocity-set b (xz 0.0 -5.0)))
    (let ((up (ticks v s 25 0.0 #t #f #f)) (glide (ticks v s 25 0.0 #f #f #f)))
      (check (> (signed-speed (● up bike)) 3.6) "expected a climb above launch speed")
      (check (and (> (● up standing) 0.67) (= (● glide standing) 0.0))
             "climb posture failed to follow load on the pedals"))))
(define (approach (v Valley) (speed F64)) (→ Ride)
  (let* ((s (start-ride v)) (p (xz -8.5 43.5)) (b (body p -1.5707963)))
    (set! (● s bike) (Body-velocity-set b (xz (negate speed) 0.0))) s))

(define (crashes (v Valley)) (→ Unit)
  (let* ((gentle (ticks v (approach v 2.8) 22 0.0 #f #f #f))
         (healed (ticks v gentle 140 0.0 #f #f #t))
         (crash (ticks v (approach v 8.0) 12 0.0 #f #f #f))
         (landed (ticks v crash 360 0.0 #t #f #f))
         (recovered (remount-ride v landed)))
    (check (and (not (fallen? (● gentle rider))) (> (● gentle rider brace) 0.1)
                (< (● healed rider brace) 0.01)) "a low speed contact should yield then recover")
    (check (and (fallen? (● crash rider)) (not (can-remount? (● crash rider))))
           "head-on collision did not release the rider")
    (match (● landed rider fall)
      ((Some f) (let* ((p (● f torso center)) (at (xz (● p x) (● p z))))
                  (check (and (> (- (● p y) (ground-height (● v ground) at)) 0.10)
                              (< (- (● p y) (ground-height (● v ground) at)) 1.15)
                              (> (distance at (● landed bike position)) 0.28))
                         "rider should land on the surveyed ground independently of the bicycle")))
      (_ (panic "holding the pedals remounted a fallen rider")))
    (check (and (can-remount? (● landed rider)) (not (fallen? (● recovered rider)))
                (< (distance (● recovered bike position) (● landed bike position)) 1.3))
           "could not remount beside the collision")
    (let ((backed (ticks v recovered 60 0.0 #f #t #f)))
      (check (and (> (- (● backed bike position x) (● recovered bike position x)) 1.0)
                  (< (● backed wheel) (● recovered wheel)) (= (● backed crank) (● recovered crank)))
             "walking back must clear the wall, roll the wheels back and leave the cranks still"))
    (check (fallen? (● (ann (deserialize (serialize crash)) Ride) rider)) "fall missing from save"))
  (let* ((wall (list (footprint 0.0 -1.0 20.0 0.2)))
         (b (Body-velocity-set (body (xz 0.0 -0.43) 1.30)
                               (offset (xz 0.0 0.0) (forward 1.30) 8.0)))
         (dim (new CarDimensions (wheelbase 1.08) (width 0.52) (length 1.76)))
         (hit (bicycle-contact b dim 0.0 8.0 wall 0.12)))
    (check (and (> (● hit bike velocity x) 7.0) (> (abs (● hit lost z)) 1.0)
                (not (fallen? (rider-response (● v ground) (mounted-rider) b hit #f))))
           "a scrape should preserve speed along the wall")))

(define (foot-ticks (v Valley) (s Ride) (n I64) (side F64) (ahead Bool) (run Bool) (yaw F64))
  (→ Ride)
  (if (= n 0)
      s
      (foot-ticks v (step-player v s side ahead #f #f run yaw) (- n 1) side ahead run yaw)))
(define (explore (v Valley)) (→ Unit)
  (let* ((start (start-ride v)) (half (ticks v (use-bicycle v start) 13 0.0 #f #f #f))
         (parked (ticks v (ann (deserialize (serialize half)) Ride) 13 0.0 #f #f #f))
         (home (● parked bike position))
         (walked (foot-ticks v parked 100 0.0 #t #f 0.0))
         (ran (foot-ticks v parked 100 0.0 #t #t 0.0))
         (across (foot-ticks v parked 35 -1.0 #f #f 0.0))
         (saved (ann (deserialize (serialize ran)) Ride)))
    (check (and (> (foot-fraction (● half travel)) 0.46) (< (foot-fraction (● half travel)) 0.54)
                (= (foot-fraction (● parked travel)) 1.0)
                (> (distance (● (player-body parked) position) home) 0.70))
           "restoring midway through a dismount should finish beside the bike")
    (check (and (> (● ran metres) (* 2.1 (● walked metres))) (> (pace (player-body ran)) 3.5)
                (< (distance (● (player-body ran) position) (● ran dog position)) 3.4)
                (> (distance (● ran dog position) home) 3.0)
                (< (● (player-body across) position x) (● (player-body parked) position x))
                (= (distance (● ran bike position) home) 0.0) (= (● ran crank) 0.0))
           "camera-relative travel, dog, or parked bicycle followed the wrong actor")
    (check (and (= (distance (● (player-body ran) position) (● (player-body saved) position)) 0.0)
                (= (distance (● saved bike position) home) 0.0)
                (match (● (use-bicycle v saved) travel) ((OnFoot _) #t) (_ #f)))
           "using the bicycle from across the road moved it")
    (let* ((beside (start-ride v)) (at (xz -8.82 38.0))
           (fence (begin (set! (● beside bike) (body at 0.0)) (use-bicycle v beside))))
      (check
       (and (match (● fence travel) ((GettingOff w _) (> (● w body position x) (● at x))) (_ #f))
            (not (nearby-bicycle? v beside (walker (xz -9.85 38.0) 0.0))))
       "the courier must use the clear side and cannot reach the bike through the fence"))
    (let ((mounted (ticks v (use-bicycle v parked) 26 0.0 #f #f #f)))
      (check (and (match (● mounted travel) ((Astride) #t) (_ #f))
                  (> (● (ticks v mounted 50 0.0 #t #f #f) metres) (● mounted metres)))
             "could not return to the saddle and pedal"))
    (let* ((riding (ticks v start 52 0.0 #t #f #f)) (braking (use-bicycle v riding)))
      (check (and (match (● braking travel) ((Slowing) #t) (_ #f))
                  (match (● (use-bicycle v braking) travel) ((Astride) #t) (_ #f))
                  (match (● (ticks v braking 120 0.0 #f #f #f) travel) ((OnFoot _) #t) (_ #f)))
             "a moving rider must brake before planting a foot"))))
(define (stride-contacts (v Valley)) (→ Unit)
  (let* ((g (● v ground)) (p (● (start-ride v) bike position)) (w (walker p 0.0))
         (wall (list (footprint (● p x) (- (● p z) 0.85) 6.0 0.12))))
    (let loop ((n 0) (w w))
      (let ((next (step-walker g w 0.0 1.0 #t 0.0 wall 0.02)))
        (if (< n 85) (loop (+ n 1) next)
            (check (and (< (distance p (● next body position)) 0.65)
                        (= (● w phase) (● next phase))
                        (= (pace (● next body)) 0.0))
                   "running into a wall must stop the feet"))))
    (let* ((diag (step-walker g w 1.0 1.0 #t 0.0 (Nil) 0.02))
           (straight (step-walker g w 0.0 1.0 #t 0.0 (Nil) 0.02))
           (east (step-walker g w 0.0 1.0 #t 1.5707963 (Nil) 0.02)))
      (check (and (< (abs (- (pace (● diag body)) (pace (● straight body)))) 0.0001)
                  (> (● east body velocity x) 0.1) (< (abs (● east body velocity z)) 0.001)
                  (> (● east body heading) 0.0) (< (● east body heading) 0.21))
             "diagonal motion or turning ignores input in the view frame"))))
(define (foot-rig (a Rigged)) (→ Unit)
  (let* ((r (● a rig)) (p (clip-frame a "Idle" 0.0)) (walk (clip-frame a "Walk" 0.0))
         (step (clip-frame a "Walk" 0.25)) (run (clip-frame a "Run" 0.63))
         (left (clip-frame a "Step left" 0.0)) (right (clip-frame a "Step right" 0.0)))
    (check (and (< (● (socket r p "LFoot") y) 0.11) (< (● (socket r p "RFoot") y) 0.11)
                (> (● (socket r p "Head") y) 1.25)
                (< (abs (- (- (● (socket r step "RFoot") z) (● (socket r walk "RFoot") z)) 0.33))
                   0.012)
                (> (● (socket r run "RFoot") y) 0.25)
                (> (● (socket r left "RFoot") y) (● (socket r left "LFoot") y))
                (> (● (socket r right "LFoot") y) (● (socket r right "RFoot") y)))
           "the walking sole must plant, the running toe lift, and the free leg clear the saddle")))
(define (rain-road (v Valley)) (→ Unit)
  (let* ((pool (list-ref (● v basins) 0)) (p (● pool at)) (s (fresh-soil))
         (b (body (offset p (xz 0.0 1.0) 0.90) 0.0))
         (a (body (offset p (xz 0.0 1.0) 0.54) 0.08))
         (wet (press-wheels (● v basins) s b a (lambda (q) #t) 1.0 #t))
         (d (press-wheels (● v basins) s b a (lambda (q) #f) 1.0 #t))
         (off (press-wheels (● v basins) s b a (lambda (q) #t) 1.0 #f)))
    (check (and (= (length (● wet ruts)) 2) (null? (● d ruts)) (null? (● off ruts)))
           "both grounded tyres should press just the soft ground")
    (let* ((at (● (list-ref (● wet ruts) 0) b))
           (twice (press-wheels (● v basins) (clear-wheel-contact wet) b a (lambda (q) #t) 1.0 #t)))
      (check (and (> (rut-depth wet at) 0.008) (> (rut-depth twice at) (rut-depth wet at))
                  (<= (rut-depth twice at) 0.035))
             "repeated wheel loading must deepen a bounded rut"))
    (check (and (< (wetness (● v basins) wet p) (wetness (● v basins) s p))
                (> (pool-level (Some (list-ref (● wet wakes) 0)) 900)
                   (pool-level (Some (list-ref (● wet wakes) 0)) 1)))
           "water should displace on passage and seep back")
    (let loop ((soil wet) (n 0))
      (if (> n (+ rut-life 120)) (check (null? (● soil ruts)) "ruts never softened")
          (loop (press-wheels (● v basins) soil a a (lambda (q) #t) 1.0 #f) (+ n 1))))
    (let* ((s (start-ride v)) (ride (begin (set! (● s soil) wet) s))
           (loaded (ann (deserialize (serialize ride)) Ride)) (reset (reset-ride v loaded)))
      (check (and (= (length (● reset soil ruts)) 2) (= (● loaded soil tick) 1))
             "reset or reload erased the marked ground"))))

(define (main (out OutputPort) (fs Fs)) (→ Unit)
  (let ((file
         (lambda (name)
           (read-bytes fs (string-append "src/apps/iygtw/willowbank/main.resources/" name)))))
    (let ((v (Valley-basins-set
              (read-valley (file "ground.bin") (file "surfaces.bin") (file "waymarks.bin"))
              (read-basins (file "basins.bin")))))
      (survey v) (ride v) (climbing v) (rain-road v) (crashes v) (explore v) (stride-contacts v)
      (let ((a (read-rigged-gltf (file "roadster.glb") "./" (lambda (paths) (Nil)))))
        (rider-rig a)
        (foot-rig a))
      (for-each (lambda (d) (crossing v 16.0 -32.7 d) (crossing v -51.8 -29.4 d)
                        (crossing v -76.0 -31.3 d) (crossing v 83.3 -24.0 d)) (list 1.0 -1.0))))
  (check (> (pedal-speed 4.0 -0.10 1 #f #f #f 0.02) (pedal-speed 4.0 0.10 1 #f #f #f 0.02)) "grade")
  (check (> (pedal-speed 4.0 0.0 1 #f #f #f 0.02) (pedal-speed 4.0 0.0 0 #f #f #f 0.02))
         "rolling resistance")
  (check (and (< (pedal-speed 0.0 -0.32 0 #f #t #f 0.02) 0.0)
              (< (pedal-speed -0.8 -0.32 0 #f #f #f 0.02) -0.70)
              (= (pedal-speed 0.0 0.3 2 #f #t #t 0.02) 0.0))
         "reverse should work on grades, coast when released, and obey the brake")
  (let ((grade 0.12) (dt 0.02))
    (check (> (+ (pedal-speed 5.0 grade 1 #t #f #f dt) (* dt (* 8.7 grade)))
              (+ (pedal-speed 5.0 0.0 1 #t #f #f dt) 0.003))
           "standing climb did not add force at the pedals"))
  (write-line out "Willowbank ground, bicycle and companion"))
