(import
 (snail core base)
 (snail core io))

;; A suspension that may be resumed cannot leave the function an array is
;; generated by: the loop that calls it could not go on from the middle.
(define pausing (→ (Prompt I64 I64)) (make-prompt))

(define (main (out OutputPort)) (→ Unit)
  (write-line out "before")
  (display out
           (with-prompt pausing
                        (lambda ()
                          (array-length
                           (array-generate 3 (lambda (index) (suspend pausing index)))))
                        (lambda (index resume) (resume index))))
  (write-line out "not reached")
  (unit))
