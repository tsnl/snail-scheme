(import (scheme base))

;; This fixture returns 42 to its Wasm host. It exercises representation and
;; calling conventions without relying on the foreign I/O services.
(define (check expected actual)
  (if (not (equal? expected actual)) (error "WasmGC regression" expected actual)))

(check 75025 (let fib ((n 25)) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))))
(check 42 (let ((x 40)) ((lambda (increment) (+ x increment)) 2)))
(check 42 (let ((x 0)) (let ((put (lambda (value) (set! x value)))) (put 42) x)))
(check 42 (let () (define (first) (second)) (define (second) 42) (first)))
(check '(1 2 3) ((lambda elements elements) 1 2 3))
(check '(3 4) ((lambda (a b . rest) rest) 1 2 3 4))
(check 10 (apply + 1 2 '(3 4)))
(check 42 (call-with-values (lambda () (values 40 2)) +))
(check '() (call-with-values (lambda () (values)) list))
(check 42 (begin (values 1 2 3) 42))
(check 2000000 (let loop ((n 0)) (if (= n 2000000) n (loop (+ n 1)))))
(check 20000 (let loop ((n 0)) (if (= n 20000) n (apply loop (list (+ n 1))))))
(check 42 (let ((pair (cons 1 2))) (set-car! pair 40) (set-cdr! pair 2) (+ (car pair) (cdr pair))))
(check '(1 9 3) (let ((value (vector 1 2 3))) (vector-set! value 1 9) (vector->list value)))
(check '#(7 7 7) (make-vector 3 7))
(check "aλ!" (string #\a #\λ #\!))
(check 3 (string-length "aλ!"))
(check #\λ (string-ref "aλ!" 1))
(check "λ!" (substring "aλ!" 1 3))
(check "aλ!" (string-append "a" "λ" "!"))
(check #t (eq? 'same (string->symbol "same")))
(check "same" (symbol->string 'same))
(check #f (string? 'same))
(check #f (symbol? "same"))
(check #f (char? #t))
(check #f (boolean? #\a))
(check #t (char=? #\a #\a #\a))
(check #f (char=? #\a #\a #\b))
(check #t (char<? #\a #\b #\c))
(check #t (char<=? #\0 #\5 #\9))
(check #f (char<=? #\0 #\x #\9))
(check #t (char>? #\c #\b #\a))
(check #t (char>=? #\c #\c #\a))
(check #t (string=? "same" "same" "same"))
(check #f (string=? "same" "same" "different"))
(check #t (eqv? #\λ (integer->char (char->integer #\λ))))
(check '#u8(1 255 3) (let ((value (bytevector 1 2 3))) (bytevector-u8-set! value 1 255) value))
(check #f (vector? '#u8(1 2)))
(check #f (bytevector? '#(1 2)))
(define-record-type <point> (point x y) point? (x point-x set-point-x!) (y point-y))
(define-record-type <other> (other x) other? (x other-x))
(check 42 (let ((value (point 1 2))) (set-point-x! value 40) (+ (point-x value) (point-y value))))
(check #f (point? (other 1)))
(check #f (pair? (point 1 2)))
(check 1073741824 (+ 1073741823 1))
(check -1073741825 (- -1073741824 1))
(check 4294967296 (* 65536 65536))
(check 3 (/ 9 3))
(check 1.5 (/ 3 2))
(check -3 (quotient -10 3))
(check -1 (remainder -10 3))
(check 2 (modulo -10 3))
(check -2 (modulo 10 -3))
(check #t (= 9007199254740992 9007199254740992.0))
(check #f (= 9007199254740993 9007199254740992.0))
(check #t (integer? 42.0))
(check #f (exact-integer? 42.0))
(check #t (number? 42.0))
(check #t (procedure? check))
42
