(import
 (snail core base)
 (snail core io)
 (snail shell number))

(: parse (-> String Number))
(define (parse text)
  (match (string->number text)
    ((Some n) n)
    ((None) (panic (string-append "not a number: " text)))))

(for-each (lambda (text) (write-line (show (parse text))))
          (list "42" "-17" "6/4" "1.5" "1e3" "+inf.0" "123456789012345678901234567890"))
(write-line (show (+ (parse "1/3") (parse "1/6"))))
(write-line (show (* (parse "2/3") (parse "3"))))
(write-line (show (+ (parse "1/2") (parse "0.25"))))
(write-line (show (number-divide (parse "10") (parse "4"))))
(write-line (show (< (parse "1/3") (parse "0.34"))))
(write-line (show (string->number "abc")))
(write-line (show (number-integer? (parse "8/4"))))
