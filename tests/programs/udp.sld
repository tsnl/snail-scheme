(import
 (only (snail core forms) host)
 (snail core base)
 (only (snail shell task) tasks)
 (rename (snail core io) (write write-value))
 (only (snail shell task) dispatch)
 (snail shell socket))

(define (require (result (Result T SocketError))) (→ T) (∀ (T))
  (match result
    ((Ok value) value)
    ((Err error) (panic (● error code)))))

(define (main) (→ Unit) (! host mut output-port tcp udp tasks)
  ;; A program waits on sockets from a task, which the scheduler runs once
  ;; main returns.
  (dispatch
   (lambda ()
     (let* ((first (require (bind (require (endpoint "127.0.0.1" 0)))))
            (second (require (bind (require (endpoint "127.0.0.1" 0)))))
            (peer (require (endpoint "127.0.0.1" (● second port))))
            (listener (require (listen (require (endpoint "127.0.0.1" 0))))))
       ;; Owner-local handle numbers can coincide. Their token types cannot.
       (match (close-udp (new UdpSocket (token (● listener token)) (port 0)))
         ((Err error) (write-line (● error code)))
         ((Ok _) (panic "TCP token used as UDP")))
       (require (close-listener listener))
       (display (require (send first peer #u8())))
       (newline)
       (display (vector-length (● (require (receive second 0)) bytes)))
       (newline)
       (display (require (send first peer #u8(0 255 128 1))))
       (newline)
       (let ((packet (require (receive second 4))))
         (write-value (vector->list (● packet bytes)))
         (newline)
         (display (and (string=? (Endpoint-address (● packet peer)) "127.0.0.1")
                       (= (Endpoint-port (● packet peer)) (● first port))))
         (newline))
       (require (send first peer #u8(1 2)))
       (match (receive second 1)
         ((Err error) (write-line (● error code)))
         ((Ok _) (panic "oversized UDP receive succeeded")))
       (require (send first peer #u8(3)))
       (match (send first (require (endpoint "127.0.0.1" 0)) #u8(4))
         ((Err error) (write-line (● error code)))
         ((Ok _) (panic "a datagram was sent to port 0")))
       ;; A receive takes 0 to 65,507 bytes, and a datagram carries at most that.
       (for-each (lambda (maximum)
                   (match (receive second maximum)
                     ((Err error) (write-line (● error code)))
                     ((Ok _) (panic "a receive out of bounds was started"))))
                 (list (ann -1 I32) (ann 65508 I32)))
       (match (send first peer (vector-generate 65508 (lambda (_) (i32->u8 0))))
         ((Err error) (write-line (● error code)))
         ((Ok _) (panic "an oversized datagram was sent")))
       (write-value (vector->list (● (require (receive second 1)) bytes)))
       (newline)
       (require (close-udp first))
       (require (close-udp first))
       (require (close-udp second)))

     ;; Runtime shutdown also closes delivered datagram sockets left open.
     (require (bind (require (endpoint "127.0.0.1" 0))))
     (unit)))
  (unit))
