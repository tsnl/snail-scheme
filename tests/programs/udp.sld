(import
 (snail core base)
 (rename (snail core io) (write write-value))
 (only (snail shell task) dispatch)
 (snail shell socket))

(define (require (result (Result T SocketError))) (→ T) (∀ (T))
  (match result
    ((Ok value) value)
    ((Err error) (panic (● error code)))))

(define (main (tcp Tcp) (udp Udp) (out OutputPort)) (→ Unit)
  ;; A program waits on sockets from a task, which the scheduler runs once
  ;; main returns.
  (dispatch
   (lambda ()
     (let* ((first (require (udp::bind (require (endpoint "127.0.0.1" 0)))))
            (second (require (udp::bind (require (endpoint "127.0.0.1" 0)))))
            (peer (require (endpoint "127.0.0.1" (● second port))))
            (listener (require (tcp::listen (require (endpoint "127.0.0.1" 0))))))
       ;; Owner-local handle numbers can coincide. Their token types cannot.
       (match (udp::close-udp (new UdpSocket (token (● listener token)) (port 0)))
         ((Err error) (write-line out (● error code)))
         ((Ok _) (panic "TCP token used as UDP")))
       (require (tcp::close-listener listener))
       (display out (require (udp::send first peer #u8())))
       (newline out)
       (display out (array-length (● (require (udp::receive second 0)) bytes)))
       (newline out)
       (display out (require (udp::send first peer #u8(0 255 128 1))))
       (newline out)
       (let ((packet (require (udp::receive second 4))))
         (write-value out (array->list (● packet bytes)))
         (newline out)
         (display out (and (string=? (Endpoint-address (● packet peer)) "127.0.0.1")
                           (= (Endpoint-port (● packet peer)) (● first port))))
         (newline out))
       (require (udp::send first peer #u8(1 2)))
       (match (udp::receive second 1)
         ((Err error) (write-line out (● error code)))
         ((Ok _) (panic "oversized UDP receive succeeded")))
       (require (udp::send first peer #u8(3)))
       (match (udp::send first (require (endpoint "127.0.0.1" 0)) #u8(4))
         ((Err error) (write-line out (● error code)))
         ((Ok _) (panic "a datagram was sent to port 0")))
       ;; A receive takes 0 to 65,507 bytes, and a datagram carries at most that.
       (for-each (lambda (maximum)
                   (match (udp::receive second maximum)
                     ((Err error) (write-line out (● error code)))
                     ((Ok _) (panic "a receive out of bounds was started"))))
                 (list (ann -1 I32) (ann 65508 I32)))
       (match (udp::send first peer (array-generate 65508 (lambda (_) (i32->u8 0))))
         ((Err error) (write-line out (● error code)))
         ((Ok _) (panic "an oversized datagram was sent")))
       (write-value out (array->list (● (require (udp::receive second 1)) bytes)))
       (newline out)
       (require (udp::close-udp first))
       (require (udp::close-udp first))
       (require (udp::close-udp second)))

     ;; Runtime shutdown also closes delivered datagram sockets left open.
     (require (udp::bind (require (endpoint "127.0.0.1" 0))))
     (unit)))
  (unit))
