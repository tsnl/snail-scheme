(import
 (snail core base)
 (snail core io)
 (snail shell math)
 (snail shell resource)
 (snail shell game biped)
 (apps iygtw walking reference)
 (apps iygtw walk))

(define (check (ok Bool) (message String)) (→ Unit) (unless ok (panic message)))
(define (travel (clip Stride) (ground (Array F64)) (w (Array F64)) (speed F64) (ticks I64)) (→ F64)
  (reset-walk! ground clip 0.0)
  (let loop ((tick 0) (phase 0.0))
    (if (or (= tick ticks) (fallen? ground))
        (let ((x (link-x 0))) (end-biped!) x)
        (let ((p (next-phase clip phase speed)))
          (step-walk! w (reference-pose clip p) speed ground)
          (loop (+ tick 1) p)))))

(define (main (out OutputPort) (resources Resources)) (→ Unit)
  (let* ((clip (read-stride resources)) (pose (reference-pose clip 0.0))
         (wrap (reference-pose clip 1.0))
         (half (reference-pose clip (/ 0.5 (i64->f64 (● clip frames)))))
         (next (reference-pose clip (/ 1.0 (i64->f64 (● clip frames)))))
         (g (course (walking-ground resources) lantern-row)) (w (trained-policy resources)))
    (check (and (= (● clip frames) 38) (< (abs (- (● clip length) 1.239)) 0.00001)) "walk units")
    (for-each (lambda (i)
                (check (= (array-ref pose i) (array-ref wrap i)) "loop seam")
                (check
                 (< (abs (- (array-ref half i) (* 0.5 (+ (array-ref pose i) (array-ref next i)))))
                    0.00001)
                 "between mocap frames")) (iota 12))
    (check (> (course-height g 5.0) (course-height g 0.0)) "Lantern Row must climb")
    (let ((before (travel clip g (initial-policy) 1.0 120)) (after (travel clip g w 1.0 120)))
      (check (and (> after 2.2) (> after (+ before 1.0)))
             "trained walker must make progress uphill")
      (check (< (abs (- after (travel clip g w 1.0 120))) 0.00001) "a reset must clear contacts"))
    (let* ((flat (make-array 49 0.0)) (slow (travel clip flat w 0.8 240))
           (fast (travel clip flat w 1.2 240)))
      (check (and (> slow 5.0) (> fast (+ slow 0.25))) "a faster command must cover more ground"))
    (write-line out "Walking reference, trained motors and Willowbank terrain")))
