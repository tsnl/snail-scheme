  reconciled -> publish 2
  published 2 -> release 2; notify succeeded 2 published 2
  touched /r/apps/p/main.sld -> arm
  timer -> notify building 3 published 2; build 3
  built 3 a candidate -> reconcile
  reconciled -> publish 3
  published 3 -> release 3; reclaim /r/apps/p/build/g1; notify succeeded 3 published 3
  touched /r/apps/p/main.sld -> arm
  timer -> notify building 4 published 3; build 4
