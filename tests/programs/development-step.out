  timer -> nothing
an input edited while building supersedes the attempt
  resident started -> reconcile
  reconciled -> arm
  timer -> notify building 1; build 1
  touched /r/apps/p/lib/util.sld -> nothing
  built 1 a candidate -> reconcile
  reconciled -> discard 1
  discarded 1 -> abandon 1; notify superseded 1; arm
  timer -> notify building 2; build 2
a file the build does not read does not
  resident started -> reconcile
  reconciled -> arm
  timer -> notify building 1; build 1
  touched /r/apps/p/notes.txt -> nothing
  built 1 a candidate -> reconcile
  reconciled -> publish 1
  published 1 -> release 1; notify succeeded 1 published 1 run app available
