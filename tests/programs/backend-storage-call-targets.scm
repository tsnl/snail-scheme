(import (scheme base) (scheme read) (scheme write)
        (only (snail-scheme core) : -> Vector InexactReal))

;; ---- Recursive ordinary targets inside specialized lexical copies ----

(define size (read))
(define objects (make-vector size (cons 1099511627776 0.25)))
(let loop ((index 0))
  (when (< index size)
    (vector-set! objects index (cons (+ 1099511627776 index) 0.25))
    (loop (+ index 1))))
(define alias (vector-copy objects))
(define shared 0.25)
(define (update)
  (let loop ((index 0))
    (when (< index size)
      (let ((object (vector-ref objects index)))
        (set-car! object (+ (car object) 1))
        (set-cdr! object (+ (cdr object) shared)))
      (set! shared (+ shared 0.5))
      (loop (+ index 1)))))
(update)
(let loop ((index 0))
  (when (< index size)
    (let ((left (vector-ref objects index)) (right (vector-ref alias index)))
      (unless (and (eq? left right)
                   (= (car right) (+ 1099511627777 index))
                   (= (cdr right) (+ 0.5 (* 0.5 index))))
        (error "recursive target lost shared storage" index)))
    (loop (+ index 1))))
(unless (= shared (+ 0.25 (* 0.5 size))) (error "recursive target lost cell writes"))

;; ---- An opaque generic entry bridges to a concrete worker ----

(: replace (-> Vector InexactReal))
(define (replace object)
  (vector-set! object 0 "changed")
  1.25)
(define escaped (vector replace))
(define destination (vector 0.25))
(unless (= 1.25 (apply (vector-ref escaped 0) (list destination)))
  (error "bridge result changed"))
(unless (string=? (vector-ref destination 0) "changed")
  (error "bridge write missing from shared storage"))
(display "storage call target checks passed\n")
