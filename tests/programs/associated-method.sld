(import
 (snail core base)
 (snail core io))
(struct (Box A)
  ((value A)))
(typeclass (Extract A) (type Output) (: extract (impl (Fn A -> Output))))
(instance (Extract I64) (type Output I64) (define (extract value) value))
(instance (Extract Bool) (type Output String) (define (extract value) (if value "yes" "no")))
(typeclass (Combine A)
  (type Output)
  (: combine (All (B) (requires (Extract B)) (impl (Fn A B -> (Pair Output (Extract.Output B)))))))
(instance (Combine (Box A))
  (requires (Extract A))
  (type Output (Extract.Output A))
  (define (combine a b) (match a ((Box value) (Pair (extract value) (extract b))))))
(match (combine (Box (ann 1 I64)) #t)
  ((Pair a b) (display a) (newline) (write-line b)))
