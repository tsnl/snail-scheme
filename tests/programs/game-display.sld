(import
 (snail core base)
 (snail core io)
 (snail shell page)
 (snail shell game display))

(record Device
  ((now I64)
   (divisor I32)
   (meter I32)))
(define (panel (device Device)) (→ GameDisplay)
  (game-display (new Clock (monotonic-nanoseconds (lambda () (● device now))))
                (new PageStorage
                  (read-setting (lambda (name _)
                                  (if (string=? name "refresh-divisor")
                                      (● device divisor)
                                      (● device meter))))
                  (write-setting (lambda (name value)
                                   (if (string=? name "refresh-divisor")
                                       (set! (● device divisor) value)
                                       (set! (● device meter) value))))
                  (load-count (lambda () -1))
                  (loaded-byte (lambda (_) (panic "unexpected slot read")))
                  (store-save (lambda (_) (panic "display settings wrote the game slot"))))))
(define (expect (yes Bool) (why String)) (→ Unit) (unless yes (panic why)))
(define (tick-refreshes (d GameDisplay) (divisor I64) (hz I64)) (→ Unit)
  (change-display! d (RefreshDivisor (show divisor)))
  (let loop ((i 0) (previous 0) (drawn 0))
    (when (< i (* 2 hz))
      (let ((time (quotient (* 1000 i) hz)))
        (match (display-frame! d (i64->i32 (- time previous)) #f #f)
          ((Some elapsed)
           (expect (= (modulo i divisor) 0) "early draw")
           (expect (= (i32->i64 elapsed) (- time drawn)) "camera lost time between refreshes")
           (loop (+ i 1) time time))
          ((None) (expect (> (modulo i divisor) 0) "missing draw") (loop (+ i 1) time drawn)))))))
(define (main (out OutputPort)) (→ Unit)
  (let* ((device (new Device (now 0) (divisor 1) (meter 1))) (d (panel device)))
    (define (at (ms I64)) (→ Unit) (set! (● device now) (* ms 1000000)) (presented! d))
    (for-each
     (lambda (hz) (for-each (lambda (n) (tick-refreshes (panel device) n hz)) (list 1 2 3 4 5 7)))
     (list 60 120 144))
    (change-display! d (RefreshDivisor "2147483647"))
    (for-each (lambda (invalid) (change-display! d (RefreshDivisor invalid)))
              (list "" "0" "-1" "1.5" "2147483648"))
    (expect (= (● device divisor) 2147483647) "invalid divisor changed the preference")
    (expect (match (display-frame! d 17 #f #t) ((Some 17) #t) (_ #f)) "forced redraw")
    (expect (match (display-frame! d 17 #f #f) ((None) #t) (_ #f)) "double draw after reset")
    (expect (match (display-frame! d 17 #t #f) ((None) #t) (_ #f)) "paused game drew")
    (expect (match (display-frame! d 17 #t #t) ((Some 17) #t) (_ #f)) "paused resize lost")
    (expect (match (display-frame! d 17 #f #f) ((Some 17) #t) (_ #f)) "resume delayed")
    (for-each at (list 0 16 116 132 148 164 180 196 212 228 244 260))
    (expect (string=? (● d reading) "42 FPS · 100 ms max") "a fast frame flattened a hitch")
    (interrupt-display! d)
    (at 50000)
    (for-each (lambda (i) (at (+ 50000 (* 10 (+ i 1))))) (iota 25))
    (expect (string=? (● d reading) "100 FPS · 10 ms max") "pause counted as a frame")
    (at 50375)
    (for-each (lambda (i) (at (+ 50375 (* 10 (+ i 1))))) (iota 850))
    (expect (string=? (● d reading) "100 FPS · 10 ms max") "an old peak stayed in the graph")
    (change-display! d (ShowMeter #f)) (at 90000)
    (let ((restored (panel device)))
      (expect (and (not (● restored visible)) (= (● restored divisor) 2147483647))
              "preferences lost"))
    (write-line out "display cadence and frame times")))
