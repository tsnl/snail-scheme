(define (f x)
  (let loop ((i 0) (acc (Nil)))
    (if (< i x)
        (loop (+ i 1)
              (Cons i acc))
        acc)))
(import
 (snail core base)
 (snail core io)
 (only (snail core table) empty-table))
(record Point
  ((x F64)
   (y F64)) (deriving Show))
(match value
  ((Some x) (display x))
  (_ (unit)))
(with-prompt stopping
             (lambda ()
               (display "a
b")
               (display #\())
             (lambda (value resume) (unit)))
(foo bar
     baz
     qux)
(foo
 bar
 baz)
;;; three semicolons stay
   ;;; even indented
(let* ((a 1)
       (b 2))
  (+ a b))
(foo bar
     baz
  qux)
(result-let* ((a (Ok 1)))
  (Ok a))
(result-let* ((a (Ok 1)))
  (Ok a))
(let ((x 1))
  (x))
(let* ((x 1))
  (x))
(retry-let ((x 1))
  (x))
(custom-let* ((x 1))
  (x))
(def-let ((x 1))
  (x))
(outlet ((x 1))
        (x))
(custom-let-later ((x 1))
                  (x))
(retry-let loop ((x 1))
  (loop x))
