(import (scheme base) (scheme write) (snail typing))

(define (check expected actual)
  (unless (equal? expected actual) (error "specialization disagreement" expected actual)))

;; Ordinary inferred calls keep independent concrete domains.
(define (identity x) x)
(define (forward x) (identity x))
(check 2147483648 (forward 2147483648))
(check 2.5 (forward 2.5))
(check "text" (forward "text"))
(check #\x3bb (forward #\x3bb))
(check #f (forward #f))
(define pair (cons 1 2))
(define saved-vector (vector 1 2))
(check #t (eq? pair (identity pair)))
(check #t (eq? saved-vector (identity saved-vector)))
(check #t (eq? identity (identity identity)))
(vector-set! (identity saved-vector) 1 7)
(check 7 (vector-ref saved-vector 1))

;; Explicit unused binders remain accepted; only the used binder enters copies.
(: keep (All (Unused A) (-> A A)))
(define (keep x) x)
(check "inferred" (keep "inferred"))
(check "explicit" ((inst keep ExactInteger String) (car '("explicit"))))
(check #t (eq? keep (inst keep String ExactInteger)))
(check 42 (apply (inst keep ExactInteger String) '(42)))

;; The same nested source and argument domain need distinct capture guarantees.
(define (with-offset offset n)
  (define (add-to-offset x) (+ offset x))
  (add-to-offset n))
(check 14 (with-offset 10 4))
(check 5.5 (with-offset 1.5 4))
(define (replace-capture initial replacement)
  (define (change!) (set! initial replacement))
  (change!) initial)
(check "new" (replace-capture "old" "new"))

;; Concrete parameter/result storage spans arithmetic and typed references.
(: float-loop (-> InexactReal ExactInteger InexactReal))
(define (float-loop value n)
  (if (= n 0) value (float-loop (+ value 0.5) (- n 1))))
(check 50000.5 (float-loop 0.5 100000))
(: left (-> String ExactInteger String))
(: right (-> String ExactInteger String))
(define (left value n) (if (= n 0) value (right value (- n 1))))
(define (right value n) (if (= n 0) value (left value (- n 1))))
(check "tail" (left "tail" 100000))
(: cancel (-> i32 i32 i32))
(define (cancel x y) (- (+ x y) y))
(check 2147483647 (cancel 2147483647 2147483647))
(: code (-> Char ExactInteger))
(define (code character) (char->integer character))
(check 955 (code #\x3bb))
(: text-size (-> String ExactInteger))
(define (text-size text) (string-length text))
(check 4 (apply text-size '("four")))

;; Unknown callbacks and multiple values keep the generic tail protocol.
(define (invoke function argument) (function argument))
(check 8 (invoke (lambda (x) (+ x 1)) 7))
(check '(1 2) (call-with-values (lambda () (invoke (lambda (x) (values x 2)) 1)) list))
(define effects '())
(define (remember x) (set! effects (cons x effects)) x)
(check 'argument ((begin (remember 'operator) identity) (remember 'argument)))
(check '(operator argument) effects)

;; Recursive summaries cannot generalize variables still shared by the group.
(define (mutual-f x) (mutual-g x))
(define (mutual-g y) (if (pair? y) (mutual-f "string") y))
(define (mutual-h x) (mutual-g x))
(check "string" (identity (mutual-h (cons 1 2))))

;; A budget miss gives the visitor less evidence than conditional inference.
;; The enclosing tail call must keep the generic result ABI in that case.
(define (crowded x) x)
(define (budget-forward x) (identity (crowded x)))
(crowded 1)
(crowded 2147483648)
(crowded 1.5)
(crowded #f)
(crowded #t)
(crowded #\a)
(crowded "text")
(crowded '(1 2))
(check '#(3 4) (budget-forward '#(3 4)))
(display "specialization checks passed\n")
