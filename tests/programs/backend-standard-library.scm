(import (scheme base) (scheme char) (scheme complex) (scheme inexact) (scheme hash-table)
        (snail typing)
        (scheme read) (scheme write) (scheme file) (scheme time))

(define (check expected actual)
  (unless (equal? expected actual) (error "standard library mismatch" expected actual)))
(define (near expected actual)
  (unless (< (magnitude (- expected actual)) 0.000000000001)
    (error "numeric result outside tolerance" expected actual)))

;; ---- Derived syntax and exactness ----

(check '(3 2) (do ((a 0 (+ a 1)) (b 5 (- b 1))) ((= a 3) (list a b))))
(check 7 (do ((unchanged 7)) (#t unchanged)))
(check '(4 4) (do ((a 1 (+ a b)) (b 3 (+ b a))) ((> a 3) (list a b))))
(check #t (exact? 12))
(check #f (exact? 12.0))
(check #t (inexact? (inexact 12)))
(check 12 (exact 12.0))
(check 9 (square 3))
(check '(2.0 4.0 -2.0 -4.0) (map round '(2.5 3.5 -2.5 -3.5)))
(check '(3 -2.0 4.0 -2.0) (list (floor 3) (floor -1.2) (ceiling 3.2) (truncate -2.8)))
(check #t (inexact? (min 2 3.0)))
(check 4 (max 1 4 2))
(check #t (odd? -3))
(check #t (even? 4))
(check #t (odd? 3.0))
(check #t (integer? (make-rectangular 4 0.0)))
(check 6 (gcd -12 18 0))
(check 36 (lcm 12 -18))
(check 6.0 (gcd 12.0 18))
(check #t (inexact? (lcm 12 18.0)))
(check 0 (gcd))
(check 1 (lcm))
(check '(-2 1) (call-with-values (lambda () (floor/ -5 3)) list))
(check '(-1 -2) (call-with-values (lambda () (truncate/ -5 3)) list))
(check '(-2.0 1.0) (call-with-values (lambda () (floor/ -5.0 3)) list))
(check 1024 (expt 2 10))
(check 9223372036854775807 (expt 9223372036854775807 1))
(check 1 (expt 9223372036854775807 0))
(near 0.25 (expt 2 -2))
(check #t (inexact? (expt 2.0 3)))
(check +inf.0 (expt -inf.0 0.5))
(check -9223372036854775808 (expt -2 63))
(check -1 (expt -1 9223372036854775807))
(check '(3037000499 5928526806)
       (call-with-values (lambda () (exact-integer-sqrt 9223372036854775807)) list))
(check '(3.0 8.0) (list (numerator 0.375) (denominator 0.375)))
(check '(7 1) (list (numerator 7) (denominator 7)))

;; ---- Complex arithmetic and native math ----

(define z (make-rectangular 3 4))
(check #t (eqv? z '3+4i))
(check #t (eqv? z (vector-ref '#(3+4i) 0)))
(check #t (number? z))
(check #t (complex? z))
(check #f (real? z))
(check #f (pair? z))
(check #t (exact? z))
(check '(3 4) (list (real-part z) (imag-part z)))
(check #t (= (+ z 2) (make-rectangular 5 4)))
(check #t (= (* z z) (make-rectangular -7 24)))
(check #t (eqv? (* z z) (expt z 2)))
(check #t (exact? (expt z 2)))
(check #t (eqv? (make-rectangular 0 2) (expt (make-rectangular 1 1) 2)))
(check #t (eqv? (make-rectangular 1 0) (expt z 0)))
(near (make-rectangular 0 1) (expt (make-rectangular -1 0.0) 0.5))
(near (make-rectangular 0 -1) (expt (make-rectangular -1 -0.0) 0.5))
(near (make-rectangular 0 1) (expt -1 0.5))
(check #t (= (/ z z) 1))
(check #t (= (- z) (make-rectangular -3 -4)))
(check #t (eqv? z (read (open-input-string "3+4i"))))
(check #t (inexact? (inexact z)))
(check #t (exact? (exact (inexact z))))
(check #t (eqv? z (string->number (number->string z))))
(check #t (eqv? z (string->number (number->string z 16) 16)))
(near 5 (magnitude z))
(near 0 (angle 2))
(near z (make-polar (magnitude z) (angle z)))
(near (make-rectangular 0 1) (sqrt -1))
(near (make-rectangular 0 1) (sqrt (make-rectangular -1 0.0)))
(near z (exp (log z)))
(near 1 (+ (square (sin z)) (square (cos z))))
(check #t (finite? z))
(check #t (infinite? (make-rectangular +inf.0 1)))
(check #t (infinite? (make-rectangular +nan.0 +inf.0)))
(check #t (nan? (make-rectangular +nan.0 +inf.0)))
(near (make-rectangular 0 (/ (acos -1) (log 2))) (log -1 2))
(check #t (nan? (make-rectangular 1 +nan.0)))

;; ---- Numeric type boundaries and hashing ----

(: typed-number (-> Number Number))
(define (typed-number value) (+ value 1))
(: typed-complex (-> Complex Complex))
(define (typed-complex value) value)
(check #t (eqv? (typed-number z) (make-rectangular 4 4)))
(check #t (eqv? (typed-complex z) z))
(: inexact-number (-> Number Number))
(define (inexact-number value)
  (if (inexact? value) (ann value Number) (ann value Number)))
(check #t (eqv? (inexact-number (make-rectangular 1 2.0)) (make-rectangular 1 2.0)))
(check #t (eqv? (inexact-number z) z))
(: real-number (-> Number Number))
(define (real-number value)
  (if (real? value) (ann value Number) (ann value Number)))
(check #t (eqv? (real-number z) z))
(check #t (eqv? (real-number (make-rectangular 4 0.0)) (make-rectangular 4 0.0)))
(define numeric-keys (make-hash-table eqv?))
(hash-table-set! numeric-keys z 42 (make-rectangular 1 -0.0) 7)
(check 42 (hash-table-ref numeric-keys (make-rectangular 3 4)))
(check 7 (hash-table-ref numeric-keys (make-rectangular 1 0.0)))
(define structural-keys (make-hash-table equal?))
(hash-table-set! structural-keys (list z) 42)
(check 42 (hash-table-ref structural-keys (list (make-rectangular 3 4))))
(define folded-keys (make-hash-table string-ci=?))
(hash-table-set! folded-keys "StraßeΣςİ" 42)
(check 42 (hash-table-ref folded-keys "STRASSEσσi\x307;"))

;; ---- Unicode, mutation, and callbacks ----

(check #t (string<? "a" "b" "c"))
(check #f (string<? "a" "c" "b"))
(check #t (string-ci=? "Straße" "STRASSE"))
(check #t (char-ci=? #\ς #\σ))
(check #t (char-ci<? #\a #\B #\c))
(check "STRASSE" (string-upcase "Straße"))
(check "strasse" (string-foldcase "Straße"))
(check #\ß (char-upcase #\ß))
(check #\ᾼ (char-upcase #\ᾳ))
(check #\i (char-downcase #\İ))
(check #\İ (char-foldcase #\İ))
(check #\ᾳ (char-foldcase #\ᾼ))
(check #\σ (char-foldcase #\ς))
(check 3 (digit-value #\٣))
(check #f (char-numeric? #\Ⅷ))
(define text (make-string 3 #\λ))
(string-set! text 1 #\😀)
(check "λ😀λ" text)
(check '#u8(255 255 255) (make-bytevector 3 255))
(check '#(11 22) (vector-map + '#(1 2 3) '#(10 20)))
(define collected '())
(vector-for-each (lambda (value) (set! collected (cons value collected))) '#(1 2))
(check '(2 1) collected)

;; ---- Ports, files, and clocks ----

(define input (open-input-string "1"))
(check #t (port? input))
(check #t (input-port? input))
(check #f (output-port? input))
(check #t (textual-port? input))
(check #f (binary-port? input))
(check #f (port? 1))
(close-input-port input)
(close-input-port input)
(check #t (input-port? input))
(check #f (input-port-open? input))
(define output (open-output-string))
(write-string "aλ😀z" output 1 3)
(flush-output-port output)
(check "λ😀" (get-output-string output))
(close-output-port output)
(close-output-port output)
(check "λ😀" (get-output-string output))
(check #t (output-port? output))
(check #f (output-port-open? output))
(define path "build/backend-tests/standard-library.txt")
(with-output-to-file path (lambda () (write-string "λ\n")))
(check "λ" (with-input-from-file path (lambda () (read-line))))
(check #t (file-exists? path))
(define binary (open-binary-input-file path))
(close-input-port binary)
(close-input-port binary)
(check #t (input-port? binary))
(check #t (binary-port? binary))
(check #f (input-port-open? binary))
(delete-file path)
(check #f (file-exists? path))
(check #t (inexact? (current-second)))
(check #t (exact-integer? (current-jiffy)))
(display "standard library checks passed\n")
