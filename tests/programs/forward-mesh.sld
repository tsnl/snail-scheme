(import
 (snail core base)
 (snail core io)
 (snail shell graphics forward convex))

;; Splitting the six octahedron vertices into 24 seam vertices is normal in
;; a glTF with hard shading normals. Reversing the complete shell is convex too.
(define (points (top F64)) (→ (List (List F64)))
  (list (list 1.0 0.0 0.0) (list 0.0 1.0 0.0)
        (list -1.0 0.0 0.0) (list 0.0 -1.0 0.0) (list 0.0 0.0 top) (list 0.0 0.0 -1.0)))
(define faces (→ (List I64))
  (list 0 1 4  1 2 4  2 3 4  3 0 4  1 0 5  2 1 5  3 2 5  0 3 5))
(define (main (out OutputPort)) (→ Unit)
  (let* ((vertices (points 1.0))
         (seams (map (lambda (i) (list-ref vertices i)) faces))
         (separate (map (lambda (v) (Cons (+ 8.0 (list-ref v 0)) (list-tail v 1))) vertices)))
    (for-each (lambda (v) (write-line out (show v)))
              (list (convex-shell? vertices faces)
                    (convex-shell? seams (iota (length faces)))
                    (convex-shell? vertices (reverse faces))
                    (convex-shell? (list (list 0.0 0.0 0.0)
                                         (list 2.0 0.0 0.0)
                                         (list 2.0 1.0 0.0)
                                         (list 0.0 1.0 0.0))
                                   (list 0 1 2 0 2 3))
                    (convex-shell? (list (list 0.0 0.0 0.0)
                                         (list 2.0 0.0 0.0)
                                         (list 0.5 0.25 0.0)
                                         (list 0.0 1.0 0.0))
                                   (list 0 1 2 0 2 3))
                    ;; The four upper triangles now meet inside the lower pyramid.
                    (convex-shell? (points -0.3) faces)
                    (convex-shell? vertices (list-tail faces 3))
                    (convex-shell? vertices (append (list 1 0 4) (list-tail faces 3)))
                    (convex-shell? vertices (append faces (take faces 3)))
                    (convex-shell? vertices (append (list 0 0 4) (list-tail faces 3)))
                    (convex-shell? (append vertices separate)
                                   (append faces (map (lambda (i) (+ i 6)) faces)))))))
