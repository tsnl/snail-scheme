(import
 (snail core base)
 (snail core io))

(define (v) (→ (Array I64)) (array-generate 5 (lambda (i) (* i i))))

(define (s) (→ String) "hello")

(define (main (out OutputPort)) (→ Unit) (! mut)
  (define a (make-array 3 0))

  (display out (array-ref (v) 3))
  (newline out)
  (write out (array->list (array-map (lambda (x) (+ x 1)) (v))))
  (newline out)
  (display out (array-fold + 0 (v)))
  (newline out)
  (write out (array->list (array-set (v) 0 100)))
  (newline out)
  (write out (array->list (array-append (subarray (v) 1 3) (list->array (list 7 8)))))
  (newline out)
  (array-set! a 1 42)
  (write out (array->list (array-copy a)))
  (newline out)
  (write-line out (string-append (s) (string-append ", " "world")))
  (display out (string-length (s)))
  (newline out)
  (write-line out (substring (s) 1 4))
  (write-line out (list->string (reverse (string->list (s)))))
  (display out (string=? (s) "hello"))
  (newline out)
  (write-line out (string-join (list "a" "b" "c") "-"))
  (write out (list "x" "y"))
  (newline out)
  (display out (char->integer #\A))
  (newline out)
  (write-line out (repr (string-index "abc" #\c)))
  (unit))
