(import
 (snail-core base)
 (snail-core io))

(define v (vector-generate 5 (lambda (i) (* i i))))
(display (vector-ref v 3))
(newline)
(display (vector->list (vector-map (lambda (x) (+ x 1)) v)))
(newline)
(display (vector-fold + 0 v))
(newline)
(display (vector->list (vector-set v 0 100)))
(newline)
(display
 (vector->list (vector-append (subvector v 1 3) (list->vector (list 7 8)))))
(newline)
(define a (make-array 3 0))
(array-set! a 1 42)
(display (vector->list (array->vector a)))
(newline)
(define s "hello")
(write-line (string-append s (string-append ", " "world")))
(display (string-length s))
(newline)
(write-line (substring s 1 4))
(write-line (list->string (reverse (string->list s))))
(display (string=? s "hello"))
(newline)
(write-line (string-join (list "a" "b" "c") "-"))
(display (list "x" "y"))
(newline)
(display (char->integer #\A))
(newline)
(write-line (show (string-index "abc" #\c)))
