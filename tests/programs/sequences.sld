(import
 (snail core base)
 (snail core io))

(define v (vector-generate 5 (lambda (i) (* i i))))



(define s "hello")

(define (main) (→ Unit) (! mut output-port)
  (define a (make-array 3 0))

  (display (vector-ref v 3))
  (newline)
  (write (vector->list (vector-map (lambda (x) (+ x 1)) v)))
  (newline)
  (display (vector-fold + 0 v))
  (newline)
  (write (vector->list (vector-set v 0 100)))
  (newline)
  (write (vector->list (vector-append (subvector v 1 3) (list->vector (list 7 8)))))
  (newline)
  (array-set! a 1 42)
  (write (vector->list (array->vector a)))
  (newline)
  (write-line (string-append s (string-append ", " "world")))
  (display (string-length s))
  (newline)
  (write-line (substring s 1 4))
  (write-line (list->string (reverse (string->list s))))
  (display (string=? s "hello"))
  (newline)
  (write-line (string-join (list "a" "b" "c") "-"))
  (write (list "x" "y"))
  (newline)
  (display (char->integer #\A))
  (newline)
  (write-line (repr (string-index "abc" #\c)))
  (unit))
