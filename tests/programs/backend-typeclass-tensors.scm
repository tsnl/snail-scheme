(import (scheme base) (scheme write) (snail typing)
        (prefix (snail-scheme iverson-typed) t:))

(define (check expected actual)
  (unless (equal? expected actual) (error "tensor interface mismatch" expected actual)))

(: twice-square (All (T) (=> ((t:TensorOperations T)) (-> T T))))
(define (twice-square x) (t:tensor-add (t:tensor-square x) (t:tensor-square x)))

(define data (t:tensor '(2 2) '(1 2 3 4) 'f32))
(define variable (t:symbolic-input 'x))
(define graph (twice-square variable))
(check '#(2.0 8.0 18.0 32.0) (t:immediate-values (twice-square data)))
(check '(add (mul x x) (mul x x)) (t:symbolic->datum graph))
(check '#(2.0 8.0 18.0 32.0) (t:immediate-values (t:evaluate graph (lambda (name) data))))
(check '#(10.0 14.0 14.0 20.0) (t:immediate-values (t:tensor-gram data)))
(check '(matmul (transpose x) x) (t:symbolic->datum (t:tensor-gram variable)))
(check '#(10.0 14.0 14.0 20.0)
       (t:immediate-values (t:evaluate (t:tensor-gram variable) (lambda (name) data))))
(check '#(10.0) (t:immediate-values (t:evaluate (t:tensor-sum (t:symbolic-constant data)) (lambda (name) data))))
(define eager-square (inst t:tensor-square t:<immediate-tensor>))
(check '#(1.0 4.0 9.0 16.0) (t:immediate-values (eager-square data)))
(display "typeclass tensor checks passed\n")
