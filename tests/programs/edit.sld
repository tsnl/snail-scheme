;; Editing must work before a program parses. Check both the new text and
;; the selection, including reader literals, malformed brackets and scalars
;; that occupy two UTF-16 code units in the browser.
(import
 (snail core base)
 (snail core io)
 (snail shell edit))

(: check-edit (-> String String String I64 I64 String I64 I64 Unit ! console))
(define (check-edit label text key from to expected start end)
  (let* ((change (delimiter-change text key from to))
         (changed (string-append (substring text 0 (Change-start change))
                                 (Change-text change)
                                 (substring text (Change-end change) (string-length text)))))
    (unless (and (string=? changed expected)
                 (= (Change-selection-start change) start)
                 (= (Change-selection-end change) end))
      (panic label))
    (write-line label)))

(check-edit "pair" "" "(" 0 0 "()" 1 1)
(check-edit "brackets" "" "[" 0 0 "[]" 1 1)
(check-edit "wrap" "a 😀 b" "(" 2 3 "a (😀) b" 3 4)
(check-edit "wrap string" "\"x\"" "(" 0 3 "(\"x\")" 1 4)
(check-edit "split string" "\"xyz\"" "(" 1 3 "\"(z\"" 2 2)
(check-edit "inside string" "\"()\"" "(" 2 2 "\"(()\"" 3 3)
(check-edit "after string" "\"x\"" "(" 3 3 "\"x\"()" 4 4)
(check-edit "unfinished string" "\"x" "(" 2 2 "\"x(" 3 3)
(check-edit "wrap comment boundary" ";x\n" "(" 0 2 "(\n" 1 1)
(check-edit "wrap unfinished literal" "\"x" "(" 0 2 "(" 1 1)
(check-edit "line comment" ";x\n" "(" 2 2 ";x(\n" 3 3)
(check-edit "block comment" "#|x|#" "(" 3 3 "#|x(|#" 4 4)
(check-edit "after block comment" "#|x|#" "(" 5 5 "#|x|#()" 6 6)
(check-edit "unfinished block comment" "#|x" "(" 3 3 "#|x(" 4 4)
(check-edit "datum comment" "#;(x)" "(" 4 4 "#;(x()" 5 5)
(check-edit "character prefix" "#\\" "(" 2 2 "#\\(" 3 3)
(check-edit "after character" "#\\(" "(" 3 3 "#\\(()" 4 4)
(check-edit "skip closer" "()" ")" 1 1 "()" 2 2)
(check-edit "skip unmatched closer" "]" "]" 0 0 "]" 1 1)
(check-edit "literal closer" "\")\"" ")" 1 1 "\"))\"" 2 2)
(check-edit "backspace pair" "()" "Backspace" 1 1 "" 0 0)
(check-edit "backspace after pair" "[]" "Backspace" 2 2 "" 0 0)
(check-edit "delete pair" "()" "Delete" 0 0 "" 0 0)
(check-edit "delete within pair" "[]" "Delete" 1 1 "" 0 0)
(check-edit "literal deletion" "\"()\"" "Backspace" 2 2 "\")\"" 1 1)
(check-edit "reader prefix deletion" "#u8()" "Backspace" 5 5 "#u8(" 4 4)
(check-edit "ordinary deletion" "a😀b" "Backspace" 2 2 "ab" 1 1)
(check-edit "ordinary forward deletion" "a😀b" "Delete" 1 1 "ab" 1 1)
(check-edit "delete selection" "(abc)" "Backspace" 1 4 "()" 1 1)
(check-edit "start boundary" "x" "Backspace" 0 0 "x" 0 0)
(check-edit "end boundary" "x" "Delete" 1 1 "x" 1 1)
(check-edit "matching open" "(x)" "M" 0 0 "(x)" 2 2)
(check-edit "matching close" "(x)" "M" 2 2 "(x)" 0 0)
(check-edit "adjacent match" "()" "M" 1 1 "()" 0 0)
(check-edit "select inner" "(a [b])" "ArrowUp" 4 4 "(a [b])" 3 6)
(check-edit "expand selection" "(a [b])" "ArrowUp" 3 6 "(a [b])" 0 7)
(check-edit "include reader prefix" "#u8(1)" "ArrowUp" 4 4 "#u8(1)" 0 6)
(check-edit "mismatch barrier" "(a [b) c]" "M" 0 0 "(a [b) c]" 0 0)

;; A reader datum comment contributes no structural parentheses. Recovery
;; resumes after a mismatch without inventing a pair across the error.
(unless (= (length (delimiter-pairs "#; (ignored) (#\\) \"(\" #| ) |# x)")) 1)
  (panic "reader boundaries"))
(unless (= (length (delimiter-pairs "(a [b) c] (d)")) 1)
  (panic "recovery"))
(write-line "reader boundaries and recovery")
