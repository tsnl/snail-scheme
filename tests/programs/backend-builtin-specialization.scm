(import (scheme base) (scheme write) (snail typing))
(define (check expected actual)
  (unless (equal? expected actual) (error "builtin specialization disagreement" expected actual)))

;; Public rest entries construct only their required fresh list spine.
(define (rest first . others) (cons first others))
(check '(1) (rest 1))
(check '(1 2 3) (rest 1 2 3))
(check '(1 2 3) (apply rest '(1 2 3)))
(check #f (eq? (cdr (rest 1 2)) (cdr (rest 1 2))))
(define (cut-rest first . rest) (set-cdr! rest '()) rest)
(check '(1) (cut-rest 0 1 2))
(define (replace-rest first . rest) (set! rest (list first)) rest)
(check '(9) (replace-rest 9 1 2))
(check '(1 2 3) (map car '((1 a) (2 b) (3 c))))
(check '(11 22) (map + '(1 2 3) '(10 20)))
(check '(2 3) (memv 2 '(1 2 3)))
(check '(b c) (memq 'b '(a b c)))
(check '("b" "c") (member "b" '("a" "b" "c")))

;; Immutable aliases carry code identity while actual closures keep captures.
(define (map-alias callback items)
  (define alias callback)
  (map alias items))
(check '(1 2) (map-alias car '((1) (2))))
(define (with-offset offset values)
  (define (add value) (+ offset value))
  (map-alias add values))
(check '(11 12) (with-offset 10 '(1 2)))
(check '(2.5 3.5) (with-offset 1.5 '(1 2)))
(define (changed-callback callback items)
  (set! callback cdr)
  (map callback items))
(check '((a) (b)) (changed-callback car '((1 a) (2 b))))
(define effects '())
(for-each (lambda (x) (set! effects (cons x effects))) '(1 2 3))
(check '(3 2 1) effects)
;; Preserve callback-before-cdr traversal even when a callback changes the tail.
(define changing-list (list 1 2 3))
(check '(1) (map (lambda (x) (set-cdr! changing-list '()) x) changing-list))
(set! changing-list (list 1 2 3))
(set! effects '())
(for-each (lambda (x) (set! effects (cons x effects)) (set-cdr! changing-list '())) changing-list)
(check '(1) effects)

;; Array combinators allocate fresh shallow results and copy overlap correctly.
(define pair (cons 'shared 'element))
(define vector-a (vector pair #\a))
(define vector-b (vector #f "text"))
(define appended (vector-append #() vector-a vector-b))
(check 4 (vector-length appended))
(check #t (eq? pair (vector-ref appended 0)))
(vector-set! appended 1 'changed)
(check #\a (vector-ref vector-a 1))
(check #f (eq? vector-a (vector-append vector-a)))
(check '#() (vector-append))
(check '#(#\a #f) (vector-copy (vector-append vector-a vector-b) 1 3))
(check '#(#f "text") (apply vector-append (list #() vector-b)))
(define overlap (vector 1 2 3 4))
(vector-copy! overlap 1 overlap 0 3)
(check '#(1 1 2 3) overlap)
(vector-copy! overlap 0 overlap 1 4)
(check '#(1 2 3 3) overlap)
(check '#(1 2) (vector-map car '#((1) (2))))
(check '#(11 22) (vector-map + '#(1 2 3) '#(10 20)))

;; vector-map previously snapshotted inputs before callbacks. Preserve it.
(define changing (vector 1 2))
(check '#(1 2) (vector-map (lambda (x) (vector-set! changing 1 99) x) changing))
(check '#(1 99) changing)
(set! effects '())
(vector-for-each (lambda (x) (set! effects (cons x effects))) '#(1 2 3))
(check '(3 2 1) effects)

;; Known callback code does not manufacture an All source instantiation.
(: identity (All (A) (-> A A)))
(define (identity x) x)
(define (invoke callback value) (callback value))
(check 42 (invoke identity 42))
(check "text" (invoke identity "text"))
(define (tail n callback) (if (= n 0) (callback n) (tail (- n 1) callback)))
(check 0 (tail 100000 identity))
(display "builtin specialization checks passed\n")
