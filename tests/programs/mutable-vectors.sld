(import
 (snail core base)
 (snail core io))

(struct Box
  ((value I64)))

(define bytes (→ Bytes) #u8(1 2 3))

(define grown (→ (Vector I64))
  (unsafe-total
   (lambda ()
     (let ((items (vector)))
       (vector-push! items 10)
       (vector-push! items 20)
       (match (vector-pop! items) ((Some value) (unit)) ((None) (panic "missing element")))
       items))))

(define cooked-bytes (→ Bytes)
  (unsafe-total
   (lambda ()
     (let ((items bytes) (alias bytes))
       (vector-set! items 0 (ann 9 U8))
       (vector-push! items (ann 4 U8))
       (vector-append items alias)))))

(define (main) (→ Unit) (! mut output-port)
  (let* ((items (make-vector 0 0)) (alias items))
    (do ((index 0 (+ index 1))) ((= index 9)) (vector-push! items index))
    (write (vector->list alias)) (newline)
    (vector-set! alias 0 90)
    (match (vector-pop! items) ((Some value) (write value)) ((None) (panic "missing element")))
    (newline)
    (write (vector->list (vector-append (subvector alias 0 2) (make-vector 1 99)))) (newline)
    (let ((copy (vector-copy items)))
      (vector-set! copy 0 10)
      (write (vector-ref items 0)) (newline))
    (vector-copy! alias 2 alias 0 3)
    (write (vector->list items)) (newline))
  (let* ((items (make-vector 1 (Box 3))) (copy (vector-copy items)))
    (set! (● (vector-ref copy 0) value) 4)
    (write (● (vector-ref items 0) value)) (newline))
  (let* ((chars (string->vector "abc")) (text (vector->string chars)))
    (vector-set! chars 0 #\x)
    (vector-push! chars #\d)
    (write-line (string-append text (vector->string chars)))
    (write-line "abc"))
  (let* ((items bytes) (alias items))
    (vector-set! items 0 (ann 7 U8))
    (vector-push! alias (ann 4 U8))
    (write (vector->list items)) (newline)
    (write (vector->list bytes)) (newline))
  (write (vector->list cooked-bytes)) (newline)
  (let ((items grown))
    (vector-push! items 30)
    (write (vector->list items)) (newline)
    (write (vector->list grown)) (newline))
  (let ((items (make-vector 1 0)))
    (vector-for-each (lambda (value) (when (< value 3) (vector-push! items (+ value 1)))) items)
    (write (vector->list items)) (newline)))
