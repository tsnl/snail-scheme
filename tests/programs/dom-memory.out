typed 12.5 [] 1
<ul><li>one &lt; two</li><li>deux</li></ul><input .value="typed" .scrollTop=12.5 .disabled=true @keydown></input>
create-element 1 ul
create-element 2 li
create-element 3 li
create-element 4 input
set-attribute 1 class "items"
insert 1 into 0
insert 2 into 1
insert 3 into 1 before 2
create-text 5 "one < two"
insert 5 into 2
set-text 3 "two"
set-text 3 "deux"
insert 3 into 1
insert 4 into 0
set-property 4 value "typed"
set-property 4 scrollTop 12.5
set-property 4 disabled true
set-attribute 1 class ""
listen 4 keydown #1 3 chords 0+"Tab" 1+"s"
listen 2 click #2 0 always
unlisten #2
focus 4
after
