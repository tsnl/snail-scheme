(import (scheme base) (scheme write) (snail typing))
(import (prefix (testing polymorphism) imported:))

(define (check expected actual)
  (unless (equal? expected actual) (error "polymorphism disagreement" expected actual)))

(: identity (All (A) (-> A A)))
(define (identity x) x)
(check 42 (identity 42))
(check "hello" (identity "hello"))
(check #f (identity #f))
(check 42 (imported:identity 42))
(check "library" ((inst imported:identity String) "library"))
(check "exported view" (imported:text-id "exported view"))

(: shadowed (All (String) (-> String String)))
(define (shadowed x) x)
(check #t (shadowed #t))
(define-syntax make-identity
  (syntax-rules ()
    ((_ name) (begin (: name (All (Hidden) (-> Hidden Hidden))) (define (name x) x)))))
(make-identity macro-id-one)
(make-identity macro-id-two)
(check "hygiene" (macro-id-one (macro-id-two "hygiene")))

(: string-id (-> String String))
(define string-id (inst identity String))
(define string-id-alias string-id)
(check "view" (string-id-alias "view"))
(check #t (eq? identity string-id))
(check #t (eq? identity (inst identity ExactInteger)))

(: identity-alias (All (B) (-> B B)))
(define identity-alias identity)
(check 'same (identity-alias 'same))
(: contextual-id (-> String String))
(define contextual-id identity)
(check "context" (contextual-id "context"))

(: from-dynamic (-> ? String))
(define (from-dynamic x) (identity x))
(check "checked" (from-dynamic "checked"))
(check "explicit" ((inst identity String) (car '("explicit"))))
(check 7 ((inst identity ?) (car '(7))))

(: choose (All (A) (-> Boolean A A A)))
(define (choose first? x y) (if first? x y))
(: mixed (U String Boolean))
(define mixed (choose #f "text" #f))
(check #f mixed)

(: default (All (A) (-> (U False A) A A)))
(define (default x alternative) (if x x alternative))
(check "fallback" (default #f "fallback"))
(check 7 (default 7 "fallback"))

(: first (All (A B) (-> A B A)))
(define (first x y) x)
(check "first" (first "first" #t))
(: same (All (A B) (-> A B Boolean)))
(define (same x y) (eq? x y))
(check #t (same #t #t))
(: constant (All (A) (-> ExactInteger)))
(define (constant) 7)
(check 7 ((inst constant String)))

(: keep (All (A) (-> A A)))
(define (keep x) (if (string? x) x x))
(: size-if-string (All (A) (-> A ExactInteger)))
(define (size-if-string x) (if (string? x) (string-length x) 0))
(check "retained" (keep "retained"))
(check 4 (size-if-string "four"))
(check 0 (size-if-string 42))
(: is-string (All (A) (-> A Boolean)))
(define (is-string x) (string? x))
(: measure (-> (U String ExactInteger) ExactInteger))
(define (measure x) (if (is-string x) (string-length x) (+ x 1)))
(check 4 (measure "four"))
(check 43 (measure 42))

(: replace (All (A) (-> A A A)))
(define (replace x y)
  (define (change!) (set! x y))
  (change!) x)
(check "new" (replace "old" "new"))

(define-record-type <box> (box value) box? (value : ExactInteger unbox))
(define saved (box 10))
(check #t (eq? saved (identity saved)))
(check 10 (unbox ((inst identity <box>) saved)))
(: keep-box (All (A) (-> A A)))
(define (keep-box x) (if (box? x) (begin (unbox x) x) x))
(check #t (eq? saved (keep-box saved)))

(: loop (All (A) (-> A ExactInteger A)))
(define (loop x n)
  (if (= n 0) x (let ((next (- n 1))) (loop x next))))
(check "tail" (loop "tail" 1000000))

(: even-loop (All (A) (-> A ExactInteger A)))
(: odd-loop (All (B) (-> B ExactInteger B)))
(define (even-loop x n) (if (= n 0) x (odd-loop x (- n 1))))
(define (odd-loop x n) (if (= n 0) x (even-loop x (- n 1))))
(check "mutual" (even-loop "mutual" 1000000))

(check "joined" ((if #t (inst identity String) contextual-id) "joined"))
(display "polymorphism checks passed\n")
