(import
 (snail core base)
 (snail core io))

(record Token
  ((number I64)
   (label String)))

(instance (Drop (! output-port) Token)
  (define (drop (token Token)) (→ Unit) (! output-port)
    (match token
      ((Token _ label) (write-line label)))))

(define (shared (function (Fn I64 → I64 ! mut output-port))) (→ I64) (! mut output-port)
  (+ (function 1) (function 2)))

(define (single-call (function (Fn I64 → I64 ! mut output-port))) (→ I64) (! mut output-port)
  (function 5))

(define (consume (function (FnOnce I64 → I64 ! mut output-port))) (→ I64) (! mut output-port)
  (function 7))

(define (main) (→ Unit) (! mut output-port)

  (let* ((token (rc (new Token (number 10) (label "shared drop"))))
         (function (ann (lambda (value) (+ (● token number) value))
                        (Fn I64 → I64 ! mut output-port))))
    (write-line (show (shared function))))
  (let* ((token (rc (new Token (number 20) (label "single shared drop"))))
         (function (ann (lambda (value) (+ (● token number) value))
                        (Fn I64 → I64 ! mut output-port))))
    (write-line (show (single-call function))))
  (let* ((token (new Token (number 30) (label "one-shot drop")))
         (function (ann (lambda (value) (drop token) (+ value 1))
                        (FnOnce I64 → I64 ! mut output-port))))
    (write-line (show (function 6))))
  (let* ((token (new Token (number 40) (label "uncalled drop")))
         (function (ann (lambda (value) (drop token) (+ value 1))
                        (FnOnce I64 → I64 ! mut output-port))))
    (drop function))
  (let* ((token (rc (new Token (number 50) (label "consumed shared"))))
         (function (ann (lambda (value) (+ (● token number) value))
                        (Fn I64 → I64 ! mut output-port))))
    (write-line (show (consume (once function)))))
  (let* ((token (rc (new Token (number 60) (label "adapted shared"))))
         (function (ann (lambda (value) (+ (● token number) value))
                        (Fn I64 → I64 ! mut output-port)))
         (single (once function)))
    (write-line (show (single 8))))
  (let* ((token (rc (new Token (number 70) (label "abandoned shared"))))
         (function (ann (lambda (value) (+ (● token number) value))
                        (Fn I64 → I64 ! mut output-port)))
         (single (once function)))
    (drop single))
  (let* ((token (rc (new Token (number 80) (label "erased shared"))))
         (function (ann (lambda (value) (+ (● token number) value))
                        (Fn I64 → I64 ! mut output-port)))
         (single (once function)))
    (write-line (show (single 9))))
  (unit))
