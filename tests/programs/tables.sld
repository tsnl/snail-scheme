(import
 (lofi base)
 (lofi io)
 (lofi table))

(define table (make-table))
(for-each (lambda (i) (table-set! table (string-append "key" (show i)) (* i i))) (iota 1000))
(table-set! table "key7" -1)
(display (table-count table))
(newline)
(display (table-ref table "key7"))
(newline)
(display (table-ref table "key999"))
(newline)
(display (table-ref table "missing"))
(newline)
(display (fold-left + 0 (table-values table)))
(newline)
(display (delete-duplicates string=? (list "a" "b" "a" "c" "b")))
(newline)
(display (list (take (iota 5) 2) (drop (iota 5) 3)))
(newline)
