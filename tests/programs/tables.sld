(import
 (snail core base)
 (snail core io)
 (snail core table))

(define (main (out OutputPort)) (→ Unit) (! mut)
  (define table
    (fold-left (lambda (table i) (table-set table (string-append "key" (show i)) (* i i)))
               (empty-table)
               (iota 1000)))
  (define updated (table-set table "key7" -1))
  (display out (table-count updated))
  (newline out)
  (write out (table-ref updated "key7"))
  (newline out)
  ;; Setting a key makes a new table; the old one still has its value.
  (write out (table-ref table "key7"))
  (newline out)
  (write out (table-ref updated "key999"))
  (newline out)
  (write out (table-ref updated "missing"))
  (newline out)
  (display out (fold-left + 0 (table-values updated)))
  (newline out)
  (write out (delete-duplicates string=? (list "a" "b" "a" "c" "b")))
  (newline out)
  (write out (list (take (iota 5) 2) (list-drop (iota 5) 3)))
  (newline out)
  (unit))
