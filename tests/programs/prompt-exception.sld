(import
 (snail core base)
 (snail core io))

;; A suspension nothing resumes is an exception: nothing after it runs, in
;; the function that suspends or in any between it and its `with-prompt`.
(define failing (→ (Prompt String Never)) (make-prompt))

(define (fail (why String)) (→ A) (∀ (A))
  (absurd (suspend failing why)))

(define (attempt (work (Fn → A ! e))) (→ (Result A String)) (! e) (∀ (A e))
  (with-prompt failing (lambda () (Ok (work))) (lambda (why resume) (Err why))))

(define (checked (out OutputPort) (n I64)) (→ I64) (! mut)
  (when (< n 0)
    (fail (string-append "negative: " (show n))))
  (write-line out (string-append "added " (show n)))
  n)

(define (total (out OutputPort) (items (List I64))) (→ I64) (! mut)
  (fold-left (lambda (sum n) (+ sum (checked out n))) 0 items))

(define (report (out OutputPort) (result (Result I64 String))) (→ Unit) (! mut)
  (match result
    ((Ok value) (write-line out (show value)))
    ((Err why) (write-line out (string-append "failed: " why)))))

(define (main (out OutputPort)) (→ Unit) (! mut)
  (report out (attempt (lambda () (total out (list 1 2 3)))))
  (report out (attempt (lambda () (total out (list 1 -2 3)))))
  ;; A handler that fails again reaches the `with-prompt` outside its own.
  (report out
          (attempt (lambda ()
                     (match (attempt (lambda () (total out (list -7))))
                       ((Ok value) value)
                       ((Err why) (fail (string-append "again, " why)))))))
  ;; A failure passes through a function an array is generated by, and
  ;; one a cache remembers, which keeps nothing of the failed call.
  (report out
          (attempt (lambda () (array-length (array-generate 3 (lambda (index) (checked out (- 1 index))))))))
  (let ((remembered (cache (lambda (n) (checked out n)))))
    (report out (attempt (lambda () (remembered -1))))
    (report out (attempt (lambda () (+ (remembered 5) (remembered 5))))))
  (unit))
