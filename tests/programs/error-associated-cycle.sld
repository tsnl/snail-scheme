(import
 (snail core base)
 (snail core io))

(typeclass (First A)
  (type Output)
  (: first (-> A Output)))
(typeclass (Second A)
  (type Output)
  (: second (-> A Output)))
(instance (First A)
  (requires (Second A))
  (type Output (Second.Output A))
  (define (first value) (second value)))
(instance (Second A)
  (requires (First A))
  (type Output (First.Output A))
  (define (second value) (first value)))
(first (ann 1 I64))
