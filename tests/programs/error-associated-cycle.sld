(import
 (snail core base)
 (snail core io))

(typeclass (First A)
  (type Output)
  (: first (impl (Fn A → Output))))
(typeclass (Second A)
  (type Output)
  (: second (impl (Fn A → Output))))
(instance (First A)
  (⊨ (Second A))
  (type Output (Second.Output A))
  (define first (lambda (value) (second value))))
(instance (Second A)
  (⊨ (First A))
  (type Output (First.Output A))
  (define second (lambda (value) (first value))))
(first (ann 1 I64))
