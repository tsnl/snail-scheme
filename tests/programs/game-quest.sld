(import
 (snail core base)
 (snail core io)
 (snail shell game quest))
(enum Job (Waiting) (Collecting ((have I64))) (Paid) (Cancelled))
(enum Notice (Hire) (Crate ((amount I64))) (Quit))
(define-quest (advance Job Notice)
  ((Waiting) (Hire) (Collecting 0))
  ((Collecting n) (Crate amount) (if (>= (+ n amount) 3) (Paid) (Collecting (+ n amount))))
  ((Collecting _) (Quit) (Cancelled)))
(define (main (out OutputPort)) (→ Unit)
  (let* ((start (advance (Waiting) (list (Crate 9) (Hire) (Crate 7))))
         (two (advance start (list (Crate 2))))
         (paid (advance two (list (Crate 1) (Quit)))))
    (unless (and (match start ((Collecting 0) #t) (_ #f))
                 (match two ((Collecting 2) #t) (_ #f))
                 (match (advance two (list (Quit) (Crate 1))) ((Cancelled) #t) (_ #f))
                 (match (advance paid (list (Hire) (Crate 1))) ((Paid) #t) (_ #f)))
      (panic "quest order, payload or terminal state"))
    (write-line out "Ordered quest observations, counted goals and branching passed.")))
