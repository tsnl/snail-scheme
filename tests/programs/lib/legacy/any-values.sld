(generate-library (legacy any-values)
                  (import
                   (snail core base)
                   (scheme compiler))
                  (scheme->snail-core-library
                   (list "legacy" "any-values")
                   "(define value #f)
(set! value 9223372036854775808)
(write (+ value 1)) (newline)
(set! value 'symbol)
(write (list (symbol? value) (string? value) (string? (symbol->string value)))) (newline)
(write (+ 1/2 2)) (newline)
(write (list (- 2.5 1) (- 1 2.5) (/ 2) (integer? (/ 4 2)))) (newline)
(write (if '() 'truthy 'wrong)) (newline)
(write (cond ((+ 1 2) => (lambda (x) (+ x 4))) (else 'wrong))) (newline)
(write (case value ((other) 'wrong) ((symbol) 'matched) (else 'wrong))) (newline)
(write (vector)) (newline)
(write '#()) (newline)
(write '#(1 #f symbol \"text\")) (newline)
(write '(1 . 2)) (newline)
(write (apply + '(1 2 3))) (newline)
(write (map (lambda (x) (/ x 2)) '(1 2 3))) (newline)
(write (list (and) (or) (and 1 \"yes\") (or #f 'yes))) (newline)"))
