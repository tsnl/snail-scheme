;; A library generated by a program: the squares are computed when the
;; library is built, and the recipe returns the library as syntax.
(generate-library (sample table)
                  (import
                   (lofi base)
                   (lofi syntax))
                  (form "define-library"
                        (list (form "sample" (list (SymbolSyntax "table")))
                              (form "export" (list (SymbolSyntax "squares")))
                              (form "import" (list (form "lofi" (list (SymbolSyntax "base")))))
                              (form "begin"
                                    (list (form "define"
                                                (list (SymbolSyntax "squares")
                                                      (form "list" (map (lambda (i) (IntegerSyntax (* i i))) (iota 6))))))))))
