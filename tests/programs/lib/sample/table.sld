;; A library generated by a program: the squares are computed when the
;; library is built, and the recipe returns the library as syntax.
(generate-library (sample table)
                  (import
                   (snail-core base)
                   (snail-core syntax))
                  (library-syntax (list "sample" "table")
                                  (list "squares")
                                  (list (list "snail-core" "base"))
                                  (list (form "define"
                                              (list (SymbolSyntax "squares")
                                                    (form "list"
                                                          (map (lambda (i)
                                                                 (IntegerSyntax
                                                                  (* i i)))
                                                               (iota 6))))))))
