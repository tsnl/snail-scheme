;; A library generated by a program: the squares are computed when the
;; library is built, and the program prints the library's source text.
(generate-library (sample table)
                  (import
                   (lofi base))
                  (string-append "(define-library (sample table)"
                                 " (export squares)"
                                 " (import (lofi base))"
                                 " (begin (define squares (list "
                                 (string-join (map (lambda (i) (show (* i i))) (iota 6)) " ")
                                 "))))"))
