(import
 (only (snail core forms) host)
 (snail core base)
 (snail core io)
 (snail shell future))

(record Counter
  ((value I64)))

(define (main) (→ Unit) (! host mut output-port)
  (let ((wakes (new Counter (value 0))) (notifications (new Counter (value 0))))
    (handle completion
        ((completed (lambda () (set! (● notifications value) (+ 1 (● notifications value))))))
      (match (ann (make-promise) (Pair (Promise I64) (Future I64)))
        ((Pair promise future)
         (on-ready future (lambda () (set! (● wakes value) 100)))
         (on-ready future (lambda () (set! (● wakes value) (+ 1 (● wakes value)))))
         (write-line (show (● wakes value)))
         (fulfill promise 42)
         (write-line (show (● wakes value)))
         (on-ready future (lambda () (set! (● wakes value) (+ 1 (● wakes value)))))
         (write-line (show (● wakes value)))
         (match (poll future)
           ((Ready result) (write-line (show result)))
           ((Pending) (unit)))))
      (match (ann (make-promise) (Pair (Promise I64) (Future I64)))
        ((Pair promise future)
         (on-ready future (lambda () (set! (● wakes value) (+ 1 (● wakes value)))))))
      (write-line (show (● wakes value)))
      (write-line (show (● notifications value)))))
  (unit))
