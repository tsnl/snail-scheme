(import
 (snail core base)
 (snail core io)
 (snail shell future))

(let ((wakes (ref 0)) (notifications (ref 0)))
  (handle completion
      ((completed (lambda () (ref-set! notifications (+ 1 (ref-get notifications))))))
    (match (ann (make-promise) (Pair (Promise I64) (Future I64)))
      ((Pair promise future)
       (let* ((future (on-ready future (lambda () (ref-set! wakes 100))))
              (future (on-ready future (lambda () (ref-set! wakes (+ 1 (ref-get wakes)))))))
         (write-line (show (ref-get wakes)))
         (drop (fulfill promise 42))
         (write-line (show (ref-get wakes)))
         (let ((future (on-ready future (lambda () (ref-set! wakes (+ 1 (ref-get wakes)))))))
           (write-line (show (ref-get wakes)))
           (match (poll future)
             ((Ready (Completed result)) (write-line (show result)))
             ((Ready (Abandoned)) (panic "unexpected abandonment"))
             ((Pending future) (drop future)))))))
    (match (ann (make-promise) (Pair (Promise I64) (Future I64)))
      ((Pair promise future)
       (let ((future (on-ready future (lambda () (ref-set! wakes (+ 1 (ref-get wakes)))))))
         (drop promise)
         (drop future))))
    (write-line (show (ref-get wakes)))
    (write-line (show (ref-get notifications)))))
