(import
 (snail core base)
 (snail core io)
 (snail shell utf8)
 (snail shell graphics pod)
 (snail shell graphics animation)
 (snail shell graphics gltf)
 (snail shell graphics gltf animation))

(define (check (yes Bool) (why String)) (→ Unit) (unless yes (panic why)))
(define (near (a F32) (b F32)) (→ Bool) (< (abs (- a b)) 0.0001))
(define (model-at (fs Fs) (path String)) (→ Rigged)
  (read-rigged-gltf (read-bytes fs path)
                    "./"
                    (lambda (paths) (map (lambda (p) (read-bytes fs p)) paths))))

;; The hinge pivots at (1,0,0). Its inverse bind also cancels the stand's
;; z translation. The mesh node's separate translation must never reach it.
(define (hinge (fs Fs)) (→ Unit)
  (let* ((model (model-at fs "tests/programs/data/hinge.gltf")) (rig (● model rig))
         (clip (named-clip model "fold")) (rest (sample-pose rig clip 0.0))
         (half (sample-pose rig clip 0.5)) (tip (list-ref (joint-palette rig half unit-matrix) 1))
         (mesh (list-ref (● model model placed) 0))
         (weight (list-ref (● model binding vertices) 1)))
    (match (named-node rig "hinge")
      ((Some n) (let ((socket (array-ref (posed-nodes rig half unit-matrix) n)))
                  (check (and (near (● socket w x) 1.0) (near (● socket w z) 4.0)
                              (near (● socket x y) 0.7071068))
                         "attachment must follow the posed node")))
      (_ (panic "missing hinge socket")))
    (check (and (near (● tip x x) 0.7071068) (near (● tip x y) 0.7071068)
                (near (● tip w x) 0.2928932) (near (● tip w y) -0.7071068)
                (near (● tip w z) 0.0)) "shortest quaternion arc around the hinge")
    (check (and (= (list-ref (● mesh matrix) 12) 0.0) (= (● weight joints y) 1)
                (near (● weight weights y) (/ 127.0 255.0))) "strided mixed-width skin binding")
    ;; Another skin reverses the order and omits inverse binds. A rigid
    ;; attachment follows the matrix-only stand through its own palette slot.
    (let* ((pal (joint-palette rig rest unit-matrix)) (attached (list-ref pal 4))
           (bindings (● model binding vertices)))
      (check (and (= (length pal) 5) (= (● (list-ref bindings 3) joints x) 4)
                  (= (● (list-ref bindings 6) joints x) 2) (near (● (list-ref pal 2) w x) 1.0)
                  (near (● attached w x) 3.0) (near (● attached w z) 4.0))
             "mixed skins and rigid attachment"))
    (let* ((end (sample-pose rig clip 2.0)) (a (list-ref (joint-palette rig rest unit-matrix) 1))
           (b (list-ref (joint-palette rig end unit-matrix) 1))
           (mix (list-ref (joint-palette rig (blend-poses rest end 0.5) unit-matrix) 1)))
      (check (and (near (● a w x) 0.0) (near (● a w y) 0.0) (near (● a x x) 1.0)
                  (near (● b w y) 1.0) (near (● mix w y) (- 1.0 0.7071068)))
             "independent poses, step at final key, local crossfade"))
    (let* ((stretched (sample-pose rig (named-clip model "stretch") 0.5))
           (m (list-ref (joint-palette rig stretched unit-matrix) 1))
           (upper (blend-branch rest half 1.0 (named-branch rig "hinge"))))
      (check (and (near (● m x x) 1.5) (near (● m y y) 1.0)
                  (near (● (list-ref (joint-palette rig upper unit-matrix) 1) x y) 0.7071068))
             "scale and branch mask"))
    (check (and (= (clip-time clip -0.25 #t) 0.75) (= (clip-time clip 1.0 #t) 0.0)
                (= (clip-time clip 2.0 #f) 1.0)) "loop and clamp")))

(define (refused (text String) (reason String)) (→ Unit)
  (match (attempt-reading (lambda () (read-rigged-gltf (string->utf8 text) "" (lambda (_) (Nil)))))
    ((Err why) (check (string=? why reason) why)) ((Ok _) (panic "accepted invalid rig"))))

(define (main (out OutputPort) (fs Fs)) (→ Unit)
  (hinge fs)
  (refused "{\"nodes\":[{\"children\":[1,1]},{}]}" "a node has multiple parents")
  (refused "{\"nodes\":[{\"children\":[1]},{\"children\":[0]}]}" "the rig's nodes form a loop")
  (refused (string-append "{\"nodes\":[{}],\"animations\":[{\"channels\":[{\"sampler\":0,"
                          "\"target\":{\"node\":0,\"path\":\"rotation\"}}],"
                          "\"samplers\":[{\"interpolation\":\"CUBICSPLINE\"}]}]}")
           "unsupported animation interpolation: CUBICSPLINE")
  (let* ((m (model-at fs "src/apps/last-mile/main.resources/crew.glb"))
         (rig (● m rig))
         (walk (named-clip m "walk")))
    (check (> (length (● rig joints)) 1) "crew skin")
    (check
     (any? (lambda (v) (and (> (● v weights x) 0.0) (> (● v weights y) 0.0)))
           (● m binding vertices))
     "crew has weighted vertices")
    (check (and (> (● walk duration) 0.0) (not (null? (named-branch rig "Spine")))) "crew clips"))
  (write-line out "Skinned animation"))
