(import (scheme base) (scheme write) (snail typing))

;; ---- Fresh allocations and shared mutable state ----

(define (check expected actual)
  (unless (equal? expected actual)
    (error "storage sharing disagreement" expected actual)))
(define (make-cell value) (vector value))
(define (put! cell value) (vector-set! cell 0 value))
(define (identity value) value)
(define first (make-cell 0))
(define second (make-cell 0))
(put! second "text")
(check 0 (vector-ref first 0))
(check "text" (vector-ref second 0))
(check #f (eq? first second))

(define shared (make-cell 2147483648))
(define (shared-cell ignored) shared)
(define shared-alias (identity (shared-cell #f)))
(put! shared-alias "shared")
(check #t (eq? shared shared-alias))
(check "shared" (vector-ref (shared-cell 1.25) 0))

;; A copied outer container has a fresh slot but retains its nested aliases.
(define nested (vector 1.25))
(define outer (vector nested))
(define outer-copy (vector-copy outer))
(put! (vector-ref outer-copy 0) #f)
(check '#(#f) nested)
(check #t (eq? nested (vector-ref outer 0)))
(put! outer-copy "independent")
(check #t (eq? nested (vector-ref outer 0)))
(check "independent" (vector-ref outer-copy 0))

(define numeric-source (vector 1.25 2.5))
(define numeric-copy (vector-append numeric-source))
(put! numeric-copy "independent")
(check '#(1.25 2.5) numeric-source)
(check '#("independent" 2.5) numeric-copy)

;; ---- Closure families and shared cells ----

(define (make-updater initial)
  (define current initial)
  (define (read-current) current)
  (define (write-current value) (set! current value))
  (vector read-current write-current))
(define updater (make-updater 1.25))
(define read-current (vector-ref updater 0))
(define write-current (vector-ref updater 1))
(write-current 2.5)
(check 2.5 (read-current))
(write-current "changed")
(check "changed" (read-current))

(define integer-updater (make-updater 2147483648))
((vector-ref integer-updater 1) 4294967296)
(check 4294967296 ((vector-ref integer-updater 0)))
(check "changed" (read-current))

(: make-counter (-> InexactReal Procedure))
(define (make-counter initial)
  (: current InexactReal)
  (define current initial)
  (: increment (-> InexactReal InexactReal))
  (define (increment step)
    (set! current (+ current step))
    current)
  increment)
(define counter (make-counter 1.25))
(check 1.75 (counter 0.5))
(check 2.25 (apply counter (list 0.5)))

;; Capture before initialization must retain the location rather than its value.
(define (early-capture)
  (: value InexactReal)
  (define (read-value) value)
  (define value 1.25)
  (read-value))
(check 1.25 (early-capture))
(display "storage sharing checks passed\n")
