(import
 (snail core base)
 (snail core io))

(struct Resource
  ((value I64)))

(instance (Drop (! output-port) Resource)
  (define (drop (resource Resource)) (→ Unit) (! output-port)
    (match resource ((Resource value) (display value) (newline)))))

(define (main) (→ Unit) (! mut output-port)
  (let ((items (make-vector 2 (rc (Resource 1)))))
    (vector-set! items 0 (rc (Resource 2)))
    (display (● (vector-ref items 1) value)) (newline)
    (vector-set! items 1 (rc (Resource 3)))
    (display 4) (newline))
  (display 5)
  (newline)
  (let ((items (make-vector 2 (rc (Resource 6)))))
    (let ((copy (vector-set items 0 (rc (Resource 7)))))
      (display (● (vector-ref items 0) value)) (newline)
      (display (● (vector-ref copy 0) value)) (newline)))
  (display 8)
  (newline)
  (let ((items (vector-generate 3 (lambda (index) (rc (Resource (+ 10 index)))))))
    (vector-copy! items 1 items 0 2)
    (display (● (vector-ref items 2) value)) (newline)
    (display 20) (newline))
  (display 21)
  (newline)
  (let ((weak (let ((value (rc (Resource 30)))) (rc-downgrade value))))
    (match (weak-rc-upgrade weak)
      ((None) (display 31) (newline))
      ((Some value) (display (● value value)) (newline))))
  (unit))
