(import (scheme base) (scheme inexact) (scheme process-context) (scheme hash-table) (scheme comparator))

;; Compile the shared bootstrap once, then exercise independent failure paths.
(case (string->symbol (cadr (command-line)))
  ((arity) ((lambda (x) x)))
  ((uninitialized) (letrec ((x x)) x))
  ((values) (cons (values 1 2) '()))
  ((numeric-type) (+ 1 #f))
  ((numeric-values) (+ 1 (values 2 3)))
  ((numeric-arity) (-))
  ((symbol-character) (char->integer 'literal))
  ((symbol-string) (symbol->string "literal"))
  ((string-symbol) (string->symbol 'literal))
  ((inexact-type) (sqrt #f))
  ((inexact-arity) (sqrt 1 2))
  ((inexact-optional-type) (log 2 #f))
  ((inexact-optional-arity) (atan 1 2 3))
  ((overflow) (+ 9223372036854775807 1))
  ((binary-range) (bytevector-copy (bytevector 1) 2))
  ((binary-utf8) (utf8->string (bytevector 255)))
  ((hash-immutable) (hash-table-set! (hash-table (make-eq-comparator) 'a 1) 'a 2))
  ((hash-missing) (hash-table-ref (make-hash-table eq?) 'absent))
  ((hash-invalid) (hash-table-set! (make-hash-table equal? (lambda (key) -1)) 'a 1))
  ((hash-key-type)
   (hash-table-set! (make-hash-table (make-comparator number? = #f (lambda (key) 0))) 'a 1))
  ((hash-equality-mutation)
   (letrec ((table (make-hash-table (lambda (a b) (hash-table-clear! table) (equal? a b))
                                    (lambda (key) 0))))
     (hash-table-set! table 'a 1)
     (hash-table-ref table 'a)))
  ((hash-traversal-mutation)
   (let ((table (make-hash-table eq?)))
     (hash-table-set! table 'a 1)
     (hash-table-find (lambda (key value)
                        (hash-table-delete! table key) (hash-table-set! table 'b 2) #t)
                      table (lambda () #f))))
  (else (error "unknown backend error case")))
