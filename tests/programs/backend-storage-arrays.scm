(import (scheme base) (scheme write) (scheme complex) (scheme process-context) (snail unsafe))

;; ---- One contract across typed and erased aliases ----

(define (check expected actual)
  (unless (equal? expected actual) (error "array storage disagreement" expected actual)))
(define (opaque value) (vector-ref (vector value) 0))
(: repeat (All (T) (-> (Storage T) T (Array T))))
(define (repeat storage value) (array.new storage 3 value))
(: preserve (All (T) (-> (Array T) (Array T))))
(define (preserve value) value)
(define integers (repeat storage.i64 9007199254740993))
(define floats (array.new storage.f64 3 -0.0))
(define polymorphic-floats (repeat storage.f64 1.25))
(define flags (repeat storage.boolean #t))
(define characters (repeat storage.character #\λ))
(define narrow (array.new storage.i32 2 2147483647))
(define singles (array.new storage.f32 2 (f32.demote_f64 1.1)))
(check 9007199254740993 (array.ref integers 2))
(check 1.25 (array.ref polymorphic-floats 2))
(check (string->number "-inf.0") (/ 1.0 (array.ref floats 1)))
(check (f64.promote_f32 (f32.demote_f64 1.1)) (array.ref singles 0))
(check 2147483647 (array.ref narrow 1))
(define negative-zero (array.new storage.f32 1 (f32.demote_f64 -0.0)))
(define infinity (array.new storage.f32 1 (f32.demote_f64 (string->number "+inf.0"))))
(define not-a-number (array.new storage.f32 1 (f32.demote_f64 (string->number "+nan.0"))))
(check (string->number "-inf.0") (/ 1.0 (array.ref negative-zero 0)))
(check (string->number "+inf.0") (array.ref infinity 0))
(check #f (= (array.ref not-a-number 0) (array.ref not-a-number 0)))

(check #t (vector? floats))
(check #t (eq? floats (opaque floats)))
((opaque vector-set!) floats 1 2.5)
(check 2.5 (array.ref floats 1))
(array.set! flags 0 #f)
(array.set! characters 1 #\z)
(check '(#f #t #t) (vector->list flags))
(check '(#\λ #\z #\λ) (vector->list characters))

;; ---- Bulk operations retain the codec and reference identity ----

(define appended (array.append storage.f64 floats floats))
(check 6 (array.length appended))
(array.set! appended 1 7.5)
(check 2.5 (array.ref floats 1))
(array.copy! appended 1 appended 0 4)
(check '(-0.0 -0.0 7.5 -0.0 -0.0 -0.0)
       (vector->list appended))
(check (string->number "-inf.0") (/ 1.0 (array.ref appended 5)))
(check 0 (array.length (array.append storage.pair (array.empty storage.pair) (array.empty storage.pair))))
(define item (cons 1 2))
(define references (array.new storage.pair 2 item))
(define reference-copy (array.append storage.pair references references))
(check #t (eq? item (array.ref reference-copy 3)))
(set-car! (array.ref reference-copy 3) 42)
(check 42 (car (array.ref references 0)))
(define nested-vector (vector 1))
(define mutable-string (string #\a))
(define bytes (bytevector 1))
(define-record-type <entry> (entry value) entry? (value entry-value set-entry-value!))
(define record (entry 1))
(define vectors (array.new storage.vector 1 nested-vector))
(define strings (array.new storage.string 1 mutable-string))
(define bytevectors (array.new storage.bytevector 1 bytes))
(define records (array.new storage.record 1 record))
(define complexes (array.new storage.complex 1 (make-rectangular 1.0 2.0)))
(vector-set! (array.ref vectors 0) 0 42)
(string-set! (array.ref strings 0) 0 #\z)
(bytevector-u8-set! (array.ref bytevectors 0) 0 42)
(set-entry-value! (array.ref records 0) 42)
(check #t (eq? nested-vector (array.ref vectors 0)))
(check #t (eq? mutable-string (array.ref strings 0)))
(check #t (eq? bytes (array.ref bytevectors 0)))
(check #t (eq? record (array.ref records 0)))
(check 42 (vector-ref nested-vector 0))
(check #\z (string-ref mutable-string 0))
(check 42 (bytevector-u8-ref bytes 0))
(check 42 (entry-value record))
(check 1.0 (real-part (array.ref complexes 0)))
(check 2.0 (imag-part (array.ref complexes 0)))
(define closures (array.new storage.closure 2 (lambda (x) (+ x 1))))
(check 42 ((array.ref closures 1) 41))
(check "#<storage>" (let ((port (open-output-string))) (write storage.f64 port) (get-output-string port)))

(: update-opaque (-> (Array F64) F64))
(define (update-opaque values)
  (array.set! values 0 (f64.add (array.ref values 0) 1.0))
  (array.ref values 0))
;; The factory identity is hidden; its established contract still authorizes
;; direct f64 array loads and stores in the declared consumer.
(check 2.25 (update-opaque ((opaque array.new) storage.f64 2 1.25)))

;; Empty arrays still distinguish contracts; no element scan may seal a vector.
(define mode (if (null? (cdr (command-line))) "pass" (cadr (command-line))))
(cond ((string=? mode "write") ((opaque vector-set!) floats 0 "bad"))
      ((string=? mode "raw-vector") (ann (opaque (make-vector 0 1.5)) (Array F64)))
      ((string=? mode "empty-contract") (ann (opaque (array.empty storage.boolean)) (Array I32)))
      ((string=? mode "narrow-write") ((opaque vector-set!) narrow 0 2147483648))
      ((string=? mode "f32-write") ((opaque vector-set!) singles 0 1.1))
      ((string=? mode "mixed-copy") ((opaque array.copy!) floats 0 integers 0 1))
      ((string=? mode "witness-contract") (ann (opaque storage.boolean) (Storage I32)))
      ((string=? mode "empty-append")
       ((opaque array.append) storage.f64 (array.empty storage.boolean) (array.empty storage.f64)))
      ((string=? mode "empty-tail")
       ((opaque array.append) storage.f64 floats (array.empty storage.boolean)))
      ((string=? mode "zero-fill") ((opaque array.new) storage.f64 0 #f))
      ((string=? mode "negative-length") ((opaque array.new) storage.f64 -1 1.25))
      ((string=? mode "erased-identity")
       (ann ((opaque (inst preserve F64)) (array.empty storage.eqref)) (Array F64)))
      (else (display "array storage checks passed\n")))
