(import (scheme base) (scheme write) (scheme char) (scheme comparator) (scheme hash-table))

(define (check condition message) (unless condition (error message)))
(define (integers count procedure)
  (let loop ((index 0)) (unless (= index count) (procedure index) (loop (+ index 1)))))

;; Equal-shaped mutable objects must keep their own values through growth and mutation.
(define identities (make-hash-table eq?))
(define keys (make-vector 3000))
(integers 3000 (lambda (index)
                 (let ((key (cons 1 2))) (vector-set! keys index key) (hash-table-set! identities key index))))
(integers 3000 (lambda (index)
                 (let ((key (vector-ref keys index)))
                   (set-car! key index)
                   (check (= index (hash-table-ref identities key)) "mutable identity key"))))
(hash-table-set! identities #f #f identities identities)
(check (hash-table-contains? identities #f) "stored false is present")
(check (eq? (hash-table-ref identities identities) identities) "self reference")
(check (= (hash-table-delete! identities #f #f identities) 2) "count successful deletions")

;; All collisions remain correct; updater callbacks can rebuild the whole table.
(define collisions (make-hash-table equal? (lambda (key) 0)))
(integers 80 (lambda (index) (hash-table-set! collisions (list index) index)))
(hash-table-update! collisions '(42) (lambda (old) (hash-table-clear! collisions) (+ old 1)))
(check (= (hash-table-ref collisions '(42)) 43) "callback must relocate entry")
(check (= (hash-table-intern! collisions '(1)
                              (lambda () (hash-table-set! collisions '(1) 99) 7)) 7) "intern result")
(check (= (hash-table-ref collisions '(1)) 7) "intern commits after callback")
(define replacement-key (list 1))
(hash-table-set! collisions replacement-key 8)
(check (hash-table-find (lambda (key value) (eq? key replacement-key)) collisions (lambda () #f))
       "replace the equivalent key representative")
(hash-table-for-each (lambda (key value) (values)) collisions)
(hash-table-for-each (lambda (key value) (values 1 2)) collisions)
(check (= (hash '(1 2) 'ignored) (hash '(1 2))) "legacy hash argument is optional")
(check (= (hash-table-fold + 0 (hash-table (make-eqv-comparator) 1 2 3 4)) 10) "fold values")

;; Hashes must agree with the runtime's equality, including cycles and zero signs.
(define values-table (make-hash-table eqv?))
(hash-table-set! values-table 1073741824 'wide 0.0 'zero #\λ 'character)
(check (eq? (hash-table-ref values-table (+ 1073741823 1)) 'wide) "boxed exact equality")
(check (eq? (hash-table-ref values-table -0.0) 'zero) "zero signs")
(define cycle-a (cons 1 '()))
(set-cdr! cycle-a cycle-a)
(define cycle-b (cons 1 '()))
(define cycle-c (cons 1 cycle-b))
(set-cdr! cycle-b cycle-c)
(define structural (make-hash-table equal?))
(hash-table-set! structural cycle-a 'cycle (vector (list 1 2) "λ") 'vector)
(check (eq? (hash-table-ref structural cycle-b) 'cycle) "equal cyclic unfoldings")
(check (eq? (hash-table-ref structural (vector (list 1 2) (string #\λ))) 'vector) "structural vector")
(define text (make-hash-table string-ci=?))
(hash-table-set! text "HELLO" 42)
(check (= (hash-table-ref text "hello") 42) "case-insensitive keys")

;; Live traversal observes values changed before their visit. Membership stays fixed.
(define live (make-hash-table eq?))
(hash-table-set! live 'a 0 'b 0)
(define visited 0)
(hash-table-find
 (lambda (key value)
   (set! visited (+ visited 1))
   (if (= visited 1)
       (begin (hash-table-set! live 'a 1 'b 1) #f)
       (begin (check (= value 1) "traversal must read the current value") #t)))
 live (lambda () (error "find did not stop")))

;; Constructors, copies, mapping, set operations, and corresponding entry lists.
(define source (alist->hash-table '((a . 1) (a . 99) (b . 2)) eq?))
(check (= (hash-table-ref source 'a) 1) "first alist association wins")
(check (not (hash-table-mutable? (hash-table-copy source))) "copy is immutable by default")
(define copy (hash-table-copy source #t))
(hash-table-union! copy (hash-table (make-eq-comparator) 'a 99 'c 3))
(check (= (hash-table-ref copy 'a) 1) "union keeps first value")
(hash-table-intersection! copy source)
(check (hash-table=? (make-eqv-comparator) copy source) "intersection")
(hash-table-xor! copy source)
(check (hash-table-empty? copy) "xor")
(hash-table-map! (lambda (key value) (+ value 10)) source)
(check (= (hash-table-count (lambda (key value) (> value 10)) source) 2) "map and count")
(call-with-values (lambda () (hash-table-entries source))
  (lambda (keys values) (for-each (lambda (key value) (check (= (hash-table-ref source key) value) "entry alignment")) keys values)))
(hash-table-prune! (lambda (key value) (eq? key 'a)) source)
(call-with-values (lambda () (hash-table-pop! source))
  (lambda (key value) (check (and (eq? key 'b) (= value 12)) "pop values")))
(check (hash-table-empty? source) "pop removes entry")
(display "hash table checks passed") (newline)
