(import
 (snail core base)
 (snail core io)
 (cache-fixture))

(define (through-function (f (Fn → Cell))) (→ I64) (● (f) value))

(record Resource
  ((id I64)))

(define (captured-callback) (→ (Fn I64 → I64))
  (let ((resource (new Resource (id 90))))
    (cache (lambda (key) (+ key (● resource id))))))

;; A cached function may call itself while it computes a miss.
(record Reentry
  ((callback (Option (Fn I64 → I64)))
   (entered Bool)))

(define (reentrant-test (out OutputPort)) (→ Unit)
  (let* ((state (new Reentry (callback (None)) (entered #f)))
         (memo (lru-cache 2
                          (lambda (key)
                            (if (● state entered) key
                                (begin
                                  (set! (● state entered) #t)
                                  (match (● state callback)
                                    ((None) 0)
                                    ((Some inside)
                                     (inside 20)
                                     (inside 30)
                                     (+ (inside key) 1)))))))))
    (set! (● state callback) (Some memo))
    (write-line out (show (memo 10)))
    (write-line out (show (memo 10)))))

(define (extra-tests (out OutputPort)) (→ Unit)
  ;; Growing and colliding buckets preserve every cached object.
  (let ((memo (cache (lambda (key) (new Cell (value key))))))
    (for-each (lambda (index) (set! (● (memo (* index 8)) value) (+ index 100))) (iota 128))
    (write-line out (show (fold-left (lambda (sum index) (+ sum (● (memo (* index 8)) value)))
                                     0 (iota 128)))))
  (let* ((calls (new Cell (value 0)))
         (factory (lambda ()
                    (set! (● calls value) (+ (● calls value) 1))
                    (lambda (key) (+ key (● calls value)))))
         (memo (cache (factory))))
    (write-line out (show (memo 10)))
    (write-line out (show (memo 20)))
    (write-line out (show (● calls value))))
  (let* ((calls (new Cell (value 0)))
         (memo (lru-cache 0 (lambda ()
                              (set! (● calls value) (+ (● calls value) 1))
                              (● calls value)))))
    (write-line out (show (memo)))
    (write-line out (show (memo))))
  ;; Nullary enum cases are equal across independently linked modules.
  (let ((memo (cache (lambda (key) (ann (new Cell (value 0)) Cell)))))
    (set! (● (memo (external-none)) value) 17)
    (write-line out (show (● (memo (ann (None) (Option I64))) value))))
  (let ((memo (cache (lambda (key) (new Cell (value 0))))))
    (set! (● (memo (external-nil)) value) 18)
    (write-line out (show (● (memo (ann (Nil) (List I64))) value))))
  ;; The builtin itself can be passed as a monomorphic function value.
  (let* ((wrap cache) (memo (wrap (lambda (key) (new Cell (value key))))))
    (set! (● (memo 8) value) 80)
    (write-line out (show (● (memo 8) value))))
  (let ((memo (captured-callback)))
    (write-line out (show (memo 1)))
    (write-line out (show (memo 1)))
    (write-line out (show (memo 2)))))

(define (main (out OutputPort)) (→ Unit)
  (let ((one (cache one)) (bounded (lru-cache 2 bounded))
        (pair-cell (cache pair-cell)) (snapshot (cache snapshot))
        (float-cell (cache float-cell)))
    (let ((first (one)))
      (set! (● first value) 7)
      (write-line out (show (through-function one))))
    (let ((first (bounded 1)) (second (bounded 2)))
      (set! (● first value) 11)
      (set! (● second value) 22)
      (write-line out (show (● (bounded 1) value)))
      (write-line out (show (● (bounded 3) value)))
      (write-line out (show (● (bounded 2) value)))
      (write-line out (show (● second value))))
    (let ((first (pair-cell 4 "a")))
      (set! (● first value) 44)
      (write-line out (show (● (pair-cell 4 (make-string 1 #\a)) value)))
      (write-line out (show (● (pair-cell 4 "b") value))))
    (let ((key (new Cell (value 5))))
      (write-line out (show (● (snapshot key) value)))
      (set! (● key value) 6)
      (write-line out (show (● (snapshot key) value)))
      (write-line out (show (● (snapshot (new Cell (value 6))) value))))
    (let ((positive (float-cell (bits->f64 0)))
          (nan (float-cell (bits->f64 9221120237041090561))))
      (set! (● positive value) 71)
      (set! (● nan value) 72)
      (write-line out (show (● (float-cell (bits->f64 0)) value)))
      (write-line out (show (● (float-cell (bits->f64 -9223372036854775808)) value)))
      (write-line out (show (● (float-cell (bits->f64 9221120237041090561)) value)))))
  ;; Each evaluation allocates its own cache; aliases preserve it.
  (let ((first (memo-slot)) (second (memo-slot)))
    (set! (● (first) value) (Some 42))
    (write-line out (show (match (● (first) value) ((Some value) value) ((None) 0))))
    (write-line out (show (match (● (second) value) ((Some value) value) ((None) 0)))))
  ;; Effects happen only on a miss, without changing the function's row.
  (let* ((calls (new Cell (value 0)))
         (memo (cache (lambda (key)
                        (set! (● calls value) (+ (● calls value) 1))
                        (+ key (● calls value)))))
         (alias memo))
    (write-line out (show (memo 10)))
    (write-line out (show (alias 10)))
    (write-line out (show (memo 20)))
    (write-line out (show (● calls value))))
  (extra-tests out)
  (reentrant-test out))
