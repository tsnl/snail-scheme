(import
 (snail core base)
 (snail core io))

(define (root) (→ String) "build/tests/files-create")

(define (report (out OutputPort) (result (Result Unit FileError))) (→ Unit) (! mut)
  (write-line out (match result ((Ok _) "created") ((Err (AlreadyExists)) "exists") (_ "failed"))))

(define (main (fs Fs) (out OutputPort)) (→ Unit) (! mut)
  (remove-tree fs (root))
  (make-directories fs (root))
  (report out (write-text-file fs (string-append (root) "/new.txt") "" (CreateNew)))
  (write-text-file fs (string-append (root) "/new.txt") "kept" (ReplaceExisting))
  (report out (write-text-file fs (string-append (root) "/new.txt") "" (CreateNew)))
  (write-line out (read-file fs (string-append (root) "/new.txt")))
  (make-symbolic-link fs "missing" (string-append (root) "/link.txt"))
  (report out (write-text-file fs (string-append (root) "/link.txt") "" (CreateNew)))
  (write-line out (show (file-exists? fs (string-append (root) "/missing"))))
  (write-line out (match (write-text-file fs (string-append (root) "/absent.txt") "no" (ReplaceExisting))
                ((Err (NotFound)) "missing") (_ "wrong")))
  (write-line out (show (file-exists? fs (string-append (root) "/absent.txt"))))
  (write-text-file fs (string-append (root) "/either.txt") "first" (CreateOrReplace))
  (write-text-file fs (string-append (root) "/either.txt") "second" (CreateOrReplace))
  (write-line out (read-file fs (string-append (root) "/either.txt")))
  (remove-tree fs (root))
  (unit))
