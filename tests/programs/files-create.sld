(import
 (snail core base)
 (snail core io))

(define (root) (→ String) "build/tests/files-create")

(define (report (result (Result Unit File-error))) (→ Unit) (! Output-port)
  (write-line (match result ((Ok _) "created") ((Err (Already-exists)) "exists") (_ "failed"))))

(define (main) (→ Unit) (! Fs Output-port)
  (remove-tree (root))
  (make-directories (root))
  (report (write-text-file (string-append (root) "/new.txt") "" (Create-new)))
  (write-text-file (string-append (root) "/new.txt") "kept" (Replace-existing))
  (report (write-text-file (string-append (root) "/new.txt") "" (Create-new)))
  (write-line (read-file (string-append (root) "/new.txt")))
  (make-symbolic-link "missing" (string-append (root) "/link.txt"))
  (report (write-text-file (string-append (root) "/link.txt") "" (Create-new)))
  (write-line (show (file-exists? (string-append (root) "/missing"))))
  (write-line (match (write-text-file (string-append (root) "/absent.txt") "no" (Replace-existing))
                ((Err (Not-found)) "missing") (_ "wrong")))
  (write-line (show (file-exists? (string-append (root) "/absent.txt"))))
  (write-text-file (string-append (root) "/either.txt") "first" (Create-or-replace))
  (write-text-file (string-append (root) "/either.txt") "second" (Create-or-replace))
  (write-line (read-file (string-append (root) "/either.txt")))
  (remove-tree (root))
  (unit))
