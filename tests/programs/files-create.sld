(import
 (snail core base)
 (snail core io))

(define (root) (→ String) "build/tests/files-create")

(define (report (result (Result Unit FileError))) (→ Unit) (! output-port)
  (write-line (match result ((Ok _) "created") ((Err (AlreadyExists)) "exists") (_ "failed"))))

(define (main) (→ Unit) (! fs output-port)
  (remove-tree (root))
  (make-directories (root))
  (report (write-text-file (string-append (root) "/new.txt") "" (CreateNew)))
  (write-text-file (string-append (root) "/new.txt") "kept" (ReplaceExisting))
  (report (write-text-file (string-append (root) "/new.txt") "" (CreateNew)))
  (write-line (read-file (string-append (root) "/new.txt")))
  (make-symbolic-link "missing" (string-append (root) "/link.txt"))
  (report (write-text-file (string-append (root) "/link.txt") "" (CreateNew)))
  (write-line (show (file-exists? (string-append (root) "/missing"))))
  (write-line (match (write-text-file (string-append (root) "/absent.txt") "no" (ReplaceExisting))
                ((Err (NotFound)) "missing") (_ "wrong")))
  (write-line (show (file-exists? (string-append (root) "/absent.txt"))))
  (write-text-file (string-append (root) "/either.txt") "first" (CreateOrReplace))
  (write-text-file (string-append (root) "/either.txt") "second" (CreateOrReplace))
  (write-line (read-file (string-append (root) "/either.txt")))
  (remove-tree (root))
  (unit))
