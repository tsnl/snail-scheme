text:   (car x)
began
indented: taken, selection 2-2, line height 0.0
saved
late: refused, value 0
field gone
online
<div><button id="indent" @click></button><button id="late" @click></button><button id="hide" @click></button></div>
set-property 2 value ""
wake
fire text input #1
set-property 2 value "(car x)"
fire indent click #2
insert-text 2 0 0 "  "
select 2 2 2
focus 2
measure 2
wake
set-property 2 value "  (car x)"
fire window keydown #6
fire late click #3
fire hide click #4
confirm "Hide the field?"
wake
remove 2
insert-text 2 0 0 "late " (removed)
wake
wake
fire window online #5
close
