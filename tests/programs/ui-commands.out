text:   (car x)
indented, line height 0.0
field gone
late, value 0
<div><button id="indent" @click></button><button id="late" @click></button><button id="hide" @click></button></div>
set-property 2 value ""
fire text input #1
set-property 2 value "(car x)"
fire indent click #2
insert-text 2 0 0 "  "
select 2 2 2
focus 2
measure 2
wake
set-property 2 value "  (car x)"
fire late click #3
fire hide click #4
remove 2
wake
insert-text 2 0 0 "late " (removed)
wake
close
