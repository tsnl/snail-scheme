(import
 (snail core base)
 (snail core io)
 (snail shell math)
 (snail shell wire)
 (snail shell graphics gltf)
 (snail shell game vehicle)
 (snail shell game boarding)
 (snail shell game dialogue)
 (snail shell game physics)
 (snail shell game humanoid)
 (snail shell game pedestrian)
 (apps last-mile district)
 (apps last-mile game))

(define (check (yes Bool) (why String)) (→ Unit) (unless yes (panic why)))
(define (keys (bits I64)) (→ Order) (new Order (buttons bits) (interact #f)))
(define use (→ Order) (new Order (buttons 0) (interact #t)))

(define (collisions) (→ Unit)
  (let* ((walls (list (footprint 2.0 0.0 0.2 8.0)))
         (hit (travel (xz 0.0 0.0) (xz 300.0 3.0) 0.0 0.4 walls 0.1)))
    (check (< (abs (- (● hit position x) 1.5)) 0.0001) "crossed a thin wall")
    (check (> (● hit position z) 0.29) "failed to slide")
    (let ((corner
           (travel (xz -3.0 -3.0) (xz 60.0 60.0) 0.0 0.3 (list (footprint 0.0 0.0 0.4 0.4)) 0.1)))
      (check (< (● corner position z) 0.0) "diagonal crossed a corner"))
    (check (= (trace-distance (xz 0.0 0.0) (xz 1.0 0.0) 40.0 walls) 1.9) "paint crossed a wall")
    (check (= (trace-distance (xz 0.0 9.0) (xz 0.0 1.0) 4.0 walls) 4.0) "parallel paint shot")))

(define (wait! (w Game) (ticks I64)) (→ Unit)
  (for-each (lambda (_) (step! w quiet)) (iota ticks)))

(define (drive-to! (w Game) (waypoint XZ) (reach F64)) (→ Unit)
  (let loop ((ticks 0))
    (let* ((b (● w cab)) (p (● b position)) (d (distance p waypoint))
           (angle (- (heading-to p waypoint) (● b heading)))
           (steering (if (> (cos angle) 0.9998) 0 (if (> (sin angle) 0.0) 8 4))))
      (when (> d reach)
        (check (< ticks 240)
               (string-append "missed waypoint " (show (● waypoint x)) "," (show (● waypoint z))
                              " at "
                              (show (● p x))
                              ","
                              (show (● p z))
                              " heading "
                              (show (● b heading))))
        (step! w (keys (+ steering (if (< (signed-speed b) 3.6) 1 0))))
        (loop (+ ticks 1))))))
(define (brake! (w Game)) (→ Unit)
  (for-each (lambda (_) (step! w (keys 32))) (iota 10)))
(define (boarding) (→ Unit)
  (let* ((car (body (xz 0.0 0.0) pi)) (right (door-point car sedan (PassengerDoor)))
         (left (door-point car sedan (DriverDoor)))
         (obstacle (list (footprint (● right x) (● right z) 0.4 0.4)))
         (r (AtDoor (body (xz -2.4 0.0) 0.0))))
    (check (and (< (● right x) -1.0) (> (● left x) 1.0))
           "doors failed to rotate with reversing car")
    (check (and (not (door-clear? car sedan (PassengerDoor) obstacle))
                (door-clear? car sedan (DriverDoor) obstacle)
                (aboard? (leave-seat (Aboard) car sedan (PassengerDoor) obstacle)))
           "wrong or obstructed exit")
    (check (match (advance-rider r car sedan (PassengerDoor) obstacle 0.05) ((AtDoor _) #t) (_ #f))
           "boarded through obstruction")
    (let ((moved (body (xz 0.0 -2.0) pi)))
      (let loop ((at r) (ticks 0))
        (unless (aboard? at)
          (check (< ticks 90) "did not board after car repositioned")
          (loop (advance-rider at moved sedan (PassengerDoor) obstacle 0.05) (+ ticks 1)))))
    ;; Starting across the chassis requires walking around an end.
    (let loop ((at (AtDoor (body right pi))) (ticks 0))
      (unless (aboard? at)
        (check (< ticks 100) "no walking route around car")
        (loop (advance-rider at car sedan (DriverDoor) (Nil) 0.05) (+ ticks 1))))))

(define (reloading) (→ Unit)
  (let ((w (new-world)))
    (step! w use)
    (let loop ((ticks 0))
      (unless (> (seat-weight (● w driver)) 0.0)
        (check (< ticks 40) "never crossed the sill") (step! w quiet) (loop (+ ticks 1))))
    (let* ((at (driver-body w)) (other (restore-game (save-game w))) (before (● w cab position)))
      (check (and (< (distance (● at position) (● (driver-body other) position)) 0.000001)
                  (> (seat-weight (● other driver)) 0.0) (< (seat-weight (● other driver)) 1.0))
             "seat pose lost midway through boarding")
      (step! w (keys 1)) (step! other (keys 1))
      (check (< (distance before (● w cab position)) 0.000001) "drove through boarding actor")
      (wait! w 20) (wait! other 20)
      (let ((a (save-game w)) (b (save-game other)))
        (check (and (= (array-length a) (array-length b))
                    (every? (lambda (i) (= (array-ref a i) (array-ref b i)))
                            (iota (array-length a))))
               "reload diverged after boarding")))))

(define (cue-order) (→ Unit)
  (let ((w (new-world)))
    (set! (● w mission) (FindMark)) (set! (● w driver) (Aboard)) (set! (● w rosa) (Aboard))
    (set! (● w cab) (body shoot-mark (negate (/ pi 2.0))))
    (step! w quiet)
    (check (match (● w mission) ((FindMark) #t) (_ #f)) "called action facing away")
    (set! (● w cab) (new Body (position shoot-mark) (velocity (xz 1.0 0.0)) (heading (/ pi 2.0))))
    (step! w (keys 16))
    (check (match (● w mission) ((FindMark) #t) (_ #f)) "called action while moving")
    (set! (● w cooldown) 0)
    (set! (● w cab) (body shoot-mark (/ pi 2.0)))
    (step! w (keys 16))
    (check (match (● w mission) ((OnCue) #t) (_ #f)) "early shot banked on the cue tick")
    (wait! w 9)
    (check (gate-up? w) "early shot opened gate")
    (step! w (keys 16))
    (check (not (gate-up? w)) "on-cue hit failed")))

(define (mission (fs Fs)) (→ Unit)
  (let ((w (new-world)))
    (step! w use)
    (wait! w 35)
    (check (match (● w mission) ((MeetRosa) #t) (_ #f)) "driver failed to board")
    (drive-to! w (xz 0.0 8.5) 0.85)
    (brake! w)
    (wait! w 65)
    (check (and (aboard? (● w rosa)) (match (● w mission) ((FindMark) #t) (_ #f)))
           "passenger not aboard")
    (speak! w 1)
    (let ((restored (restore-game (save-game w))))
      (check (match (● restored talk) ((Some c) (string=? (● c page) "cue")) (_ #f))
             "lost Ink reply")
      (drive-to! restored (xz 0.0 -1.65) 0.45)
      (drive-to! restored (xz 4.0 -5.5) 0.95)
      (drive-to! restored shoot-mark 0.65)
      (brake! restored)
      (check (match (● restored mission) ((OnCue) #t) (_ #f))
             "action called without stopping on the mark")
      (step! restored (keys 16))
      (check (match (● restored mission) ((ToCuttingRoom) #t) (_ #f)) "missed prop plate")
      (drive-to! restored (xz 16.9 -5.2) 0.45)
      (drive-to! restored (xz 20.5 -11.1) 1.1)
      (drive-to! restored editor-stop 0.65)
      (brake! restored)
      (wait! restored 100)
      (check (match (● restored mission) ((Finished) #t) (_ #f)) "Rosa did not deliver the reel"))
    (let ((old (restore-game (read-bytes fs "tests/programs/data/last-mile-v1.bin"))))
      (check (and (= (● old tick) 197) (aboard? (● old driver)) (aboard? (● old rosa))
                  (match (● old mission) ((ToCuttingRoom) #t) (_ #f))) "v1 save migration"))))

(define (actors) (→ Unit)
  (let* ((p (pedestrian (xz 0.0 0.0) (xz 0.0 -5.0)))
         (s (pose (animate resting (Bracing) 0.3 0.05))))
    (check (and (> (● s reach) 0.0) (> (● s step) 0.0)) "brace interrupts stride")
    (advance-pedestrian! p (Some (xz -2.0 0.0)) (Nil) 0.05)
    (check (> (● p body position x) 0.0) "pedestrian did not flee")
    (for-each (lambda (i) (advance-pedestrian! p (None) (Nil) 0.05)) (iota 70))
    (check (< (● p body position z) 0.0) "pedestrian did not resume route")))

(define (car-model (fs Fs)) (→ Unit)
  (let ((g (read-gltf (read-bytes fs "src/apps/last-mile/public/sedan.glb") "./")))
    (check (> (length (● g placed)) 0) "sedan has no triangles")
    (check (any? (lambda (m) (>= (● m base-texture) 0)) (● g materials)) "sedan palette missing")))

(define (bicycles) (→ Unit)
  (let* ((b (body (xz 0.0 0.0) 0.0)) (v (bicycle-step b sedan 0.3 5.0 (Nil) 0.1))
         (f (bicycle-step v sedan 0.3 5.0 (Nil) 0.1))
         (a (* (/ 0.5 (● sedan wheelbase)) (tan 0.3)))
         (rear (offset (● f position) (forward a) (* -0.5 (● sedan wheelbase))))
         (rev (bicycle-step (bicycle-step b sedan 0.3 -5.0 (Nil) 0.1) sedan 0.3 -5.0 (Nil) 0.1)))
    (check (= (● v heading) 0.0) "stationary steering rotated chassis")
    (check (< (abs (- (● f heading) a)) 0.000001) "bicycle turn rate")
    (check (< (distance rear (xz 0.0 (- (* 0.5 (● sedan wheelbase)) 0.5))) 0.000001)
           "rear axle advance")
    (check (< (abs (+ (● rev heading) a)) 0.000001) "reverse steering")
    (let ((hit (bicycle-step v sedan 0.0 5.0 (list (footprint 0.0 -2.6 4.0 0.1)) 0.1)))
      (check (= (signed-speed hit) 0.0) "bumper crossed a wall"))))

(define (main (out OutputPort) (fs Fs)) (→ Unit)
  (collisions) (actors) (bicycles) (boarding) (reloading) (cue-order) (car-model fs) (mission fs)
  (write-line out
              "Rosa boarded, answered, called action and delivered the reel on a driven take."))
