(import
 (snail core base)
 (snail core io)
 (snail shell math)
 (snail shell wire)
 (snail shell graphics gltf)
 (snail shell game vehicle)
 (snail shell game physics)
 (snail shell game humanoid)
 (snail shell game pedestrian)
 (apps last-mile district)
 (apps last-mile game))

(define (check (yes Bool) (why String)) (→ Unit) (unless yes (panic why)))
(define (keys (bits I64)) (→ Order) (new Order (buttons bits) (interact #f)))
(define use (→ Order) (new Order (buttons 0) (interact #t)))

(define (collisions) (→ Unit)
  (let* ((walls (list (footprint 2.0 0.0 0.2 8.0)))
         (hit (travel (xz 0.0 0.0) (xz 300.0 3.0) 0.0 0.4 walls 0.1)))
    (check (< (abs (- (● hit position x) 1.5)) 0.0001) "crossed a thin wall")
    (check (> (● hit position z) 0.29) "failed to slide")
    (let ((corner
           (travel (xz -3.0 -3.0) (xz 60.0 60.0) 0.0 0.3 (list (footprint 0.0 0.0 0.4 0.4)) 0.1)))
      (check (< (● corner position z) 0.0) "diagonal crossed a corner"))
    (check (= (trace-distance (xz 0.0 0.0) (xz 1.0 0.0) 40.0 walls) 1.9) "paint crossed a wall")
    (check (= (trace-distance (xz 0.0 9.0) (xz 0.0 1.0) 4.0 walls) 4.0) "parallel paint shot")))

(define (walk-to! (w World) (goal XZ)) (→ Unit)
  (let loop ((steps 0))
    (let* ((b (carrier w)) (p (● b position)) (turn (- (heading-to p goal) (● b heading))))
      (unless (< (distance p goal) 0.7)
        (check (< steps 250) "walking route obstructed")
        (step! w (keys (if (> (cos turn) 0.992) 1 (if (> (sin turn) 0.0) 8 4))))
        (loop (+ steps 1))))))

(define (crossing! (w World)) (→ Unit)
  (let loop ((steps 0))
    (when (> (● w cab position z) -29.5)
      (check (< steps 300) "car held at gate")
      (step! w (keys 17))
      (loop (+ steps 1)))))

(define (mission) (→ Unit)
  (let ((w (new-world)))
    (step! w use)
    (check (match (● w seat) ((Driving) #t) (_ #f)) "failed to board")
    (crossing! w)
    (check (match (● w mission) ((ToEditor) #t) (_ #f)) "prop plate still standing")
    (let ((restored (ann (deserialize (serialize w)) World)))
      (check (= (● w cab position z) (● restored cab position z)) "parked cab lost on reload")
      (step! restored use)
      (check (match (● restored seat) ((Driving) #t) (_ #f)) "left a moving vehicle")
      (let brake ()
        (when (> (signed-speed (● restored cab)) 0.9) (step! restored (keys 2)) (brake)))
      (step! restored use)
      (walk-to! restored (xz -2.4 -33.0))
      (walk-to! restored (xz 19.0 -33.0))
      (walk-to! restored cutting-room)
      (step! restored use)
      (check (match (● restored mission) ((Wrapped) #t) (_ #f)) "film never delivered"))))

(define (actors) (→ Unit)
  (let* ((p (pedestrian (xz 0.0 0.0) (xz 0.0 -5.0)))
         (s (pose (animate resting (Bracing) 0.3 0.05))))
    (check (and (> (● s reach) 0.0) (> (● s step) 0.0)) "brace interrupts stride")
    (advance-pedestrian! p (Some (xz -2.0 0.0)) (Nil) 0.05)
    (check (> (● p body position x) 0.0) "pedestrian did not flee")
    (for-each (lambda (i) (advance-pedestrian! p (None) (Nil) 0.05)) (iota 70))
    (check (< (● p body position z) 0.0) "pedestrian did not resume route")))

(define (car-model (fs Fs)) (→ Unit)
  (let ((g (read-gltf (read-bytes fs "src/apps/last-mile/public/sedan.glb") "./")))
    (check (> (length (● g placed)) 0) "sedan has no triangles")
    (check (any? (lambda (m) (>= (● m base-texture) 0)) (● g materials)) "sedan palette missing")))

(define (bicycles) (→ Unit)
  (let* ((b (body (xz 0.0 0.0) 0.0)) (v (bicycle-step b sedan 0.3 5.0 (Nil) 0.1))
         (f (bicycle-step v sedan 0.3 5.0 (Nil) 0.1))
         (a (* (/ 0.5 (● sedan wheelbase)) (tan 0.3)))
         (rear (offset (● f position) (forward a) (* -0.5 (● sedan wheelbase))))
         (rev (bicycle-step (bicycle-step b sedan 0.3 -5.0 (Nil) 0.1) sedan 0.3 -5.0 (Nil) 0.1)))
    (check (= (● v heading) 0.0) "stationary steering rotated chassis")
    (check (< (abs (- (● f heading) a)) 0.000001) "bicycle turn rate")
    (check (< (distance rear (xz 0.0 (- (* 0.5 (● sedan wheelbase)) 0.5))) 0.000001)
           "rear axle advance")
    (check (< (abs (+ (● rev heading) a)) 0.000001) "reverse steering")
    (let ((hit (bicycle-step v sedan 0.0 5.0 (list (footprint 0.0 -2.6 4.0 0.1)) 0.1)))
      (check (= (signed-speed hit) 0.0) "bumper crossed a wall"))))

(define (main (out OutputPort) (fs Fs)) (→ Unit)
  (collisions) (actors) (bicycles) (car-model fs) (mission)
  (write-line out
              "Bicycle steering, curb contact, pedestrian recovery, a saved take and the delivery passed."))
