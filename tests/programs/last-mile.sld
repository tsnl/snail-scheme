(import
 (snail core base)
 (snail core io)
 (snail shell math)
 (snail shell resource)
 (snail shell game physics)
 (snail shell game atlas)
 (snail shell game roads)
 (snail shell game traffic)
 (snail shell game vehicle)
 (snail shell game rigid-body)
 (only (snail shell game chassis) chassis-body)
 (snail shell game boarding)
 (snail shell game pedestrian)
 (apps last-mile assets)
 (apps last-mile gps)
 (only (apps last-mile render) Chase follow)
 (apps last-mile game)
 (apps last-mile district))
(define (check (yes Bool) (why String)) (→ Unit) (unless yes (panic why)))
(define (keys (c DriverControls) (bits I64))
  (→ Order)
  (new Order (driving c) (buttons bits) (interact #f)))
(define (collisions) (→ Unit)
  (let* ((walls (list (footprint 2.0 0.0 0.2 8.0)))
         (hit (travel (xz 0.0 0.0) (xz 300.0 3.0) 0.0 0.4 walls 0.1)))
    (check (< (abs (- (● hit position x) 1.5)) 0.0001) "crossed a thin wall")
    (check (> (● hit position z) 0.29) "failed to slide")
    (let ((corner
           (travel (xz -3.0 -3.0) (xz 60.0 60.0) 0.0 0.3 (list (footprint 0.0 0.0 0.4 0.4)) 0.1)))
      (check (< (● corner position z) 0.0) "diagonal crossed a corner"))
    (let ((box (list (footprint 0.0 0.0 2.0 2.0))))
      (check (= (trace-distance (xz 3.0 3.0) (xz -1.0 -1.0) 8.0 box) 2.0) "diagonal corner")
      (check (= (trace-distance (xz 1.0 -4.0) (xz 0.0 1.0) 8.0 box) 3.0) "parallel face")
      (check (= (trace-distance (xz 0.0 0.0) (xz 0.0 0.0) 8.0 box) 0.0) "inside the wall")
      (check (= (trace-distance (xz 2.0 0.0) (xz -0.00000001 0.0) 8.0 box) 8.0) "nearly parallel"))
    (check (= (trace-distance (xz 0.0 0.0) (xz 1.0 0.0) 40.0 walls) 1.9) "paint crossed a wall")
    (check (= (trace-distance (xz 0.0 9.0) (xz 0.0 1.0) 4.0 walls) 4.0) "parallel paint shot")))

(define (wait! (g Area) (r Roads) (w Shift) (ticks I64)) (→ Unit)
  (let ((q (keys (neutral-driver) 0))) (for-each (lambda (_) (step! g r w q)) (iota ticks))))

(define (drive-to! (g Area) (r Roads) (w Shift) (c DriverControls) (waypoint XZ) (reach F64))
  (→ Unit)
  (let loop ((ticks 0))
    (let* ((b (● w game cab)) (p (● b position)) (d (distance p waypoint))
           (angle (- (heading-to p waypoint) (● b heading)))
           (steering (if (> (cos angle) 0.9998) 0 (if (> (sin angle) 0.0) 8 4))))
      (when (> d reach)
        (check (< ticks 1600)
               (string-append "missed waypoint " (show (● waypoint x)) "," (show (● waypoint z))
                              " at "
                              (show (● p x))
                              ","
                              (show (● p z))
                              " heading "
                              (show (● b heading))))
        (step! g
               r w
               (keys c (+ steering
                          (cond ((< (signed-speed b) 3.6) 1)
                                ((> (signed-speed b) 4.0) 32)
                                (else 0)))))
        (loop (+ ticks 1))))))
(define (brake! (g Area) (r Roads) (w Shift) (c DriverControls)) (→ Unit)
  (for-each (lambda (_) (step! g r w (keys c 32))) (iota 24)))
(define (boarding) (→ Unit)
  (let* ((car (body (xz 0.0 0.0) pi)) (right (door-point car sedan (PassengerDoor)))
         (left (door-point car sedan (DriverDoor)))
         (obstacle (list (footprint (● right x) (● right z) 0.4 0.4)))
         (r (AtDoor (body (xz -2.4 0.0) 0.0))))
    (check (and (< (● right x) -1.0) (> (● left x) 1.0))
           "doors failed to rotate with reversing car")
    (check (and (not (door-clear? car sedan (PassengerDoor) obstacle))
                (door-clear? car sedan (DriverDoor) obstacle)
                (aboard? (leave-seat (Aboard) car sedan (PassengerDoor) obstacle)))
           "wrong or obstructed exit")
    (check (match (advance-rider r car sedan (PassengerDoor) obstacle 0.05) ((AtDoor _) #t) (_ #f))
           "boarded through obstruction")
    (let ((moved (body (xz 0.0 -2.0) pi)))
      (let loop ((at r) (ticks 0))
        (unless (aboard? at)
          (check (< ticks 90) "did not board after car repositioned")
          (loop (advance-rider at moved sedan (PassengerDoor) obstacle 0.05) (+ ticks 1)))))
    ;; Starting across the chassis requires walking around an end.
    (let loop ((at (AtDoor (body right pi))) (ticks 0))
      (unless (aboard? at)
        (check (< ticks 100) "no walking route around car")
        (loop (advance-rider at car sedan (DriverDoor) (Nil) 0.05) (+ ticks 1))))))

(define (bicycles) (→ Unit)
  (let* ((b (body (xz 0.0 0.0) 0.0)) (v (bicycle-step b sedan 0.3 5.0 (Nil) 0.1))
         (f (bicycle-step v sedan 0.3 5.0 (Nil) 0.1))
         (a (* (/ 0.5 (● sedan wheelbase)) (tan 0.3)))
         (rear (offset (● f position) (forward a) (* -0.5 (● sedan wheelbase))))
         (rev (bicycle-step (bicycle-step b sedan 0.3 -5.0 (Nil) 0.1) sedan 0.3 -5.0 (Nil) 0.1)))
    (check (= (● v heading) 0.0) "stationary steering rotated chassis")
    (check (< (abs (- (● f heading) a)) 0.000001) "bicycle turn rate")
    (check (< (distance rear (xz 0.0 (- (* 0.5 (● sedan wheelbase)) 0.5))) 0.000001)
           "rear axle advance")
    (check (< (abs (+ (● rev heading) a)) 0.000001) "reverse steering")
    (let ((hit (bicycle-step v sedan 0.0 5.0 (list (footprint 0.0 -2.6 4.0 0.1)) 0.1)))
      (check (= (signed-speed hit) 0.0) "bumper crossed a wall"))))

(define (parked (p XZ) (yaw F64)) (→ Shift)
  (let ((w (new-world)))
    (set! (● w game driver) (Aboard))
    (set! (● w game passenger) (Aboard))
    (set! (● w game cab) (body p yaw))
    w))

(define (grades (g Area) (r Roads)) (→ Unit)
  (let ((c (neutral-driver))
        (other (neutral-driver))
        (west (parked (xz 55.0 -5.5) (* -0.5 pi)))
        (east (parked (xz 55.0 -5.5) (* 0.5 pi))))
    (for-each (lambda (_) (step! g r west (keys c 1)) (step! g r east (keys other 1))) (iota 18))
    (check (> (- (signed-speed (● east game cab)) (signed-speed (● west game cab))) 1.0)
           "Lombard grade failed to affect acceleration")
    (for-each (lambda (_) (step! g r east (keys other 32))) (iota 20))
    (let ((p (● east game cab position)))
      (for-each (lambda (_) (step! g r east (keys other 32))) (iota 20))
      (check (< (distance p (● east game cab position)) 0.00001) "parked car drifted downhill"))))

(define (kerbs (g Area) (r Roads)) (→ Unit)
  (let* ((c (neutral-driver)) (w (parked (xz 0.0 15.0) (* 0.5 pi)))
         (height (lambda ((x F64)) (→ F64) (area-height g (xz x 15.0))))
         (sidewalk (- (height 3.0) (+ (height 2.0) (- (height 2.0) (height 1.0))))))
    (check (and (> sidewalk 0.13) (< sidewalk 0.19)) "Leavenworth kerb was flattened")
    (let loop ((ticks 0))
      (when (< (● w game cab position x) 4.8)
        (check (< ticks 100) "kerb stopped the sedan") (step! g r w (keys c 1)) (loop (+ ticks 1))))
    (for-each (lambda (_) (step! g r w (keys c 1))) (iota 100))
    (check (< (● w game cab position x) 12.0) "drove through the house beyond the sidewalk")
    (check (> (- (area-height g (xz -149.0 -6.0)) (area-height g (xz -2.0 -8.0))) 30.0)
           "lost the descent from Hyde to Leavenworth")))

(define (interpolation) (→ Unit)
  (let* ((a (body (xz 0.0 0.0) (- pi 0.1))) (b (body (xz 8.0 0.0) (- 0.1 pi)))
         (v (between-bodies a b 0.25)))
    (check (< (abs (- (● v position x) 2.0)) 0.00001)
           "rendered position snapped to a simulation tick")
    (check (< (abs (- (● v heading) (- pi 0.05))) 0.00001) "camera turned through the long arc")))


(define (service (g Area) (r Roads) (w Shift)) (→ Unit)
  (let ((c (neutral-driver)) (feet (map (lambda (p) (● p body position)) (● w game residents)))
        (car (chassis-body (list-ref (● w cars) 1))))
    (drive-to! g r w c (● (current-pickup (● w game)) stop) 0.9) (brake! g r w c) (wait! g r w 65)
    (check (aboard? (● w game passenger)) "waiting fare did not board")
    (check
     (and (>= (length (filter (lambda (p) (> (distance (● p first) (● p second body position)) 0.4))
                              (zip feet (● w game residents))))
              3)
          (> (distance (● car position) (● (chassis-body (list-ref (● w cars) 1)) position))
             0.4))
     "street life did not advance")
    (let ((v (restore-game (save-game w))))
      (check (and (aboard? (● v game passenger))
                  (match (● v game fare) ((Hired) #t) (_ #f)))
             "occupied cab lost its passenger")
      ;; This driver follows recorded checkpoints and cannot overtake. Other cars
      ;; are exercised at pickup and in the traffic stopping-distance checks.
      (set! (● v game traffic) (Nil))
      ;; Follow the individual bends instead of taking a straight line through Lombard.
      (for-each (lambda (p) (drive-to! g r v c p 2.0))
                (list (xz -146.5 -1.6)
                      (xz -141.0 -5.5)
                      (xz -137.9 -5.6)
                      (xz -124.5 -13.7)
                      (xz -120.1 -11.1)
                      (xz -114.8 -2.5) (xz -109.8 -0.7) (xz -100.9 -12.0) (xz -95.4 -13.8)
                      (xz -91.5 -11.8)
                      (xz -85.5 -2.6)
                      (xz -81.5 -0.9)
                      (xz -78.2 -2.3)
                      (xz -71.2 -13.3)
                      (xz -67.8 -14.3)
                      (xz -62.9 -12.5)
                      (xz -56.2 -2.6)
                      (xz -51.9 -0.7)
                      (xz -47.4 -3.3)
                      (xz -41.9 -12.8)
                      (xz -37.8 -14.0)
                      (xz -33.1 -11.9)
                      (xz -27.1 -2.6)
                      (xz -22.8 -0.6)
                      (xz -13.2 -8.5)
                      (xz -2.0 -6.3)
                      (xz 6.0 -5.25)
                      (xz 140.8 -5.2)
                      (xz 146.6 -11.1)))
      (drive-to! g r v c (● (current-drop (● v game)) stop) 0.8) (brake! g r v c) (wait! g r v 24)
      (check (and (= (● v game rides) 1)
                  (> (● v game bank) 400)
                  (match (● v game fare) ((Paid _ cash) (= cash (● v game bank))) (_ #f)))
             "trip did not settle")
      (let ((again (restore-game (save-game v))) (receipt (● v game bank)))
        (let next-offer ((ticks 0))
          (when (= (● again game dispatch) 0)
            (check (< ticks 90) "next fare never dispatched")
            (wait! g r again 1) (next-offer (+ ticks 1))))
        (check (and (= (● again game bank) receipt)
                    (= (● again game rides) 1)
                    (= (● again game dispatch) 1))
               "receipt paid twice")
        (let* ((gps (new-gps)) (p (● again game cab position)) (w (● again game)))
          (navigate! gps r p (objective (● v game)) (● w tick))
          (check (and (null? (● gps path)) (string=? (guidance gps r p) "Waiting for dispatch"))
                 "paid fare still had a route")
          (navigate! gps r p (objective w) (● w tick))
          (let ((pickup (● gps revision)))
            (check (and (= (● gps target dispatch) 1) (< (gps-distance gps r p) 6.0))
                   "Min's pickup at the same curb was skipped")
            (wait! g r again 90)
            (navigate! gps r p (objective w) (● w tick))
            (check (and (aboard? (● w passenger)) (> (● gps revision) pickup)
                        (> (gps-distance gps r p) 400.0)
                        (< (distance (● gps target point) (● (stand 2) stop)) 0.01))
                   "Min boarded without a fresh route to Washington Square")))))))
(define (road-handling) (→ Unit)
  (let ((c (neutral-driver)))
    (adjust-driver! c 1.0 1.0 0.05)
    (check (and (> (● c wheel) 0.1) (< (● c wheel) 0.2) (< (● c pedal) 0.3))
           "keys snapped to full wheel or throttle")
    (let ((fast (road-steering sedan 0.59 20.0 0.0 0.0))
          (braking (road-steering sedan 0.59 20.0 -7.4 0.0)))
      (check (and (< braking fast) (< (/ (* 400.0 (tan fast)) (● sedan wheelbase)) 8.21))
             "lost the combined tyre grip limit"))
    (let loop ((speed 10.0) (distance 0.0))
      (if (= speed 0.0)
          (check (and (> distance 4.9) (< distance 5.3)) "level-road stopping distance")
          (let ((next (road-speed speed 0.0 #t 0.0 0.05)))
            (loop next (+ distance (* 0.025 (+ speed next)))))))
    (check (and (< (road-speed 10.0 0.0 #f 0.1 0.05) (road-speed 10.0 0.0 #f 0.0 0.05))
                (= (road-speed 0.0 0.0 #t -0.22 0.05) 0.0)) "hill braking or rolling resistance")))
(define (moving-cars) (→ Unit)
  (let ((at (body (xz 0.0 0.0) 0.0)) (before (body (xz 0.0 4.8) 0.0))
        (near (body (xz 0.0 4.1) 0.0)) (side (body (xz 3.2 0.0) 0.0)))
    (check (closing-on-car? before near at sedan) "cars could drive into each other's bumpers")
    (check (not (closing-on-car? near before at sedan)) "car could not reverse out of contact")
    (check (not (closing-on-car? before side at sedan)) "parallel lanes blocked each other")))
(define (collision-fleet (g Area) (r Roads)) (→ Unit)
  ;; Suspend all three cars above the road. A glancing cab impact must reach
  ;; the second traffic car even while the player is standing on the sidewalk.
  (let* ((s (new-world)) (w (● s game)) (at (● w cab position))
         (center (v3 (● at x) (+ 8.0 (area-height g at)) (● at z)))
         (car (lambda ((x F64) (z F64)) (→ RigidBody)
                (box-body 1500.0 (v3 1.875 1.42 4.6) (v+ center (v3 x 0.0 z)) (around-y 0.0))))
         (cab (car 0.0 0.0)) (first (car 0.8 -4.45)) (second (car 0.8 -8.91)))
    (set! (● w driver) (Ground (body (offset at (xz 1.0 0.0) 8.0) 0.0)))
    (set! (● w traffic) (map (lambda (i) (seed-motor r at i)) (iota 2)))
    (set! (● s cars) (list cab first second))
    (apply-impulse! cab (● cab center) (v3 0.0 0.0 -15000.0))
    (wait! g r s 4)
    (check (and (> (● (velocity cab) z) -8.5) (< (● (velocity first) z) -0.4)
                (< (● (velocity second) z) -0.4) (> (abs (● (spin cab) y)) 0.04))
           "cab and traffic did not exchange off-centre and chained impulses")
    (let* ((loaded (restore-game (save-game s))) (copy (list-ref (● loaded cars) 0)))
      (check (and (= (● copy center y) (● cab center y))
                  (= (● copy orientation axis y) (● cab orientation axis y))
                  (= (● copy angular y) (● cab angular y))
                  (= (● copy momentum z) (● cab momentum z)))
             "airborne chassis lost pose or momentum on reload"))))

(define (chase-camera) (→ Unit)
  (let* ((start (follow (None) (v3 0.0 4.0 0.0) 3.13 0.0 8.0))
         (target (v3 0.5 4.4 0.0)) (first (follow (Some start) target -3.13 0.016 8.0))
         (second (follow (Some first) target -3.13 0.016 8.0))
         (one (follow (Some start) target -3.13 0.032 8.0))
         (cut (follow (Some one) (v3 300.0 0.0 0.0) 0.0 0.016 8.0)))
    (check (and (> (● first focus y) 4.0) (< (● first focus y) 4.02) (> (● first heading) 3.13)
                (< (squared (v- (● second focus) (● one focus))) 1e-16)
                (= (● cut focus x) 300.0))
           "chase rig snapped over a bump or depended on frame subdivision")))

(define (pedestrian-impact (g Area) (r Roads)) (→ Unit)
  (let* ((s (new-world)) (w (● s game)) (at (● w cab position)) (ahead (forward (● w cab heading)))
         (p (offset at ahead 3.4)) (walker (pedestrian p (offset p ahead 15.0))))
    (set! (● w residents) (list walker)) (ensure-cars! g r s)
    (let* ((cab (list-ref (● s cars) 0)) (nose (rotated (● cab orientation) (v3 0.0 0.0 -1.0))))
      (apply-impulse! cab (● cab center) (scaled nose 18240.0))
      (let loop ((tick 0) (peak 0.0))
        (step! g r s (keys (neutral-driver) 0))
        (match (fall-at s 2)
          ((Some hit)
           (let* ((b (● hit motion)) (pos (● walker body position))
                  (height (- (● b center y) (area-height g pos)))
                  (high (max peak height)))
             (if (> tick 8)
                 (let ((saved (restore-game (save-game s))))
                   (check (and (> high 1.02) (> (distance p pos) 2.0)
                               (> (signed-speed (● w cab)) 8.5)
                               (match (fall-at saved 2)
                                 ((Some k) (= (● k motion angular x) (● b angular x))) (_ #f)))
                          (string-append "pedestrian contact height "
                                         (show high)
                                         ", travel "
                                         (show (distance p pos))
                                         ", cab speed "
                                         (show (signed-speed (● w cab)))))
                   (wait! g r s 180)
                   (check (match (fall-at s 2) ((None) #t) (_ #f))
                          "walker never regained foot control"))
                 (loop (+ tick 1) high))))
          (_ (check (< tick 5) "moving cab missed pedestrian") (loop (+ tick 1) peak)))))))

(define legacy-shift (→ Resource) (link-file "data/taxi-v1.save"))
(define rigid-shift (→ Resource) (link-file "data/taxi-v2.save"))
(define graphics-shift (→ Resource) (link-file "data/taxi-v4.save"))
(define impact-shift (→ Resource) (link-file "data/taxi-v3.save"))
;; Recorded with the published two-dimensional game, after Rosa boards and
;; the driver asks for directions. This fixture keeps that wire layout fixed.
(define (legacy-fare (g Area) (roads Roads) (data Bytes)) (→ Unit)
  (let ((s (restore-game data)))
    (ensure-cars! g roads s)
    (check (and (= (length (● s cars)) 6) (= (length (● s game residents)) 6)
                (= (● s graphics resolution) 720) (aboard? (● s game passenger))
                (match (● s game fare) ((Hired) #t) (_ #f)))
           "published fare failed to migrate")))
(define (recovery (g Area) (roads Roads)) (→ Unit)
  (let* ((s (new-world)) (w (● s game)) (p (● w cab position)))
    (set! (● w fare) (Hired)) (set! (● w passenger) (Aboard))
    (set! (● w driver) (Ground (body p 0.0)))
    (set! (● w bank) 1234) (set! (● w rides) 2) (set! (● w metres) 480.0) (set! (● w tick) 950)
    (set! (● s graphics) (new Graphics (resolution 1080) (bounces 5) (samples 2)))
    (set! (● s sensitivity) 2)
    (ensure-cars! g roads s)
    (let ((cab (list-ref (● s cars) 0)))
      (set! (● cab center) (v+ (● cab center) (v3 1.0 8.0 0.0)))
      (set! (● cab orientation) (rotation (v3 0.0 0.0 1.0) 0.0))
      (set! (● cab angular) (v3 40.0 0.0 0.0))
      (check (recover-cab! g roads s) "could not find a recovery lane")
      (let ((safe (list-ref (● s cars) 0)))
        (check (and (aboard? (● w driver))
                    (aboard? (● w passenger))
                    (match (● w fare) ((Hired) #t) (_ #f))
                    (= (● w bank) 1234) (= (● w rides) 2) (= (fare-cents w) 550) (= (● w tick) 950)
                    (= (squared (spin safe)) 0.0) (= (squared (velocity safe)) 0.0)
                    (> (● (rotated (● safe orientation) (v3 0.0 1.0 0.0)) y) 0.9)
                    (< (- (● safe center y) (area-height g (● w cab position))) 0.9))
               "recovery lost fare progress or did not seat the driver in a stopped upright cab")))
    (let ((fresh (restart-shift (restore-game (save-game s)))))
      (check (and (= (● fresh game bank) 0) (= (● fresh game rides) 0) (= (● fresh game tick) 0)
                  (= (● fresh game metres) 0.0) (match (● fresh game fare) ((Waiting) #t) (_ #f))
                  (= (● fresh graphics resolution) 1080) (= (● fresh graphics bounces) 5)
                  (= (● fresh graphics samples) 2) (= (● fresh sensitivity) 2))
             "fresh shift or preferences failed"))))
(define (traffic-stop (r Roads)) (→ Unit)
  (let loop ((from 0))
    (match (find (lambda (to) (> (edge-distance r from to) 20.0)) (exits r from))
      ((Some to)
       (let* ((motor (new Motor (from from) (to to) (metres 2.0) (speed 4.0) (seed 1)))
              (car (motor-body r motor))
              (ahead (offset (● car position) (forward (● car heading)) 5.0))
              (stopped
               (fold-left (lambda (m _) (advance-motor r m (list ahead) 0.05)) motor (iota 20))))
         (check (and (= (● stopped speed) 0.0) (< (● stopped metres) 3.0)
                     (> (● (advance-motor r stopped (Nil) 0.05) speed) 0.0))
                "traffic failed to stop short of a pedestrian or resume when clear")))
      (_ (loop (+ from 1))))))
(define (bridge (atlas Atlas) (p XZ) (minimum F64)) (→ Unit)
  (let ((g (open-area atlas p)))
    (check (and (> (area-height g p) minimum) (clear? p 0.5 (area-solids g p 3.0)))
           "drivable bridge lost its deck above the water")))
(define (lake-waterline (atlas Atlas)) (→ Unit)
  ;; Lake Merced straddles this sector edge. Both sides use one DEM waterline.
  (let* ((a (xz -7938.0 7908.0))
         (b (xz -7934.0 7908.0))
         (g (open-area atlas a))
         (h (area-height g a)))
    (check (and (not (= (sector-id atlas a) (sector-id atlas b))) (> h 5.0) (< h 6.0)
                (< (abs (- h (area-height g b))) 0.001))
           "lake dropped to sea level or split at its sector boundary")))
(define (board-at-rank (g Area) (r Roads) (dispatch I64)) (→ Unit)
  (let ((c (neutral-driver)) (w (new-world)))
    (check (start-stand! (● w game) dispatch) "could not start a new shift")
    (drive-to! g r w c (● (current-pickup (● w game)) stop) 2.5)
    (brake! g r w c) (wait! g r w 72)
    (check (aboard? (● w game passenger))
           (string-append "could not board at " (● (current-pickup (● w game)) name)))))
(define (coverage (atlas Atlas) (r Roads)) (→ Unit)
  (let ((home (nearest-road r (● (stand 0) stop))))
    (for-each (lambda (i)
                (let* ((s (stand (pickup-index i)))
                       (p (● s stop))
                       (g (open-area atlas p))
                       (id (nearest-road r p))
                       (out (road-route r home id)) (back (road-route r id home)))
                  (check (and (not (null? (● g sectors))) (clear? p 0.40 (area-solids g p 3.0)))
                         "cab stand outside mapped streets")
                  (check (and (not (null? out)) (not (null? back)))
                         (string-append "unroutable stand: " (● s name)))
                  (board-at-rank g r i)
                  (when (= (pickup-index i) 12)
                    (check (> (route-length r out) 8500.0) "island GPS did not use the bridge"))))
              (iota 16))))
(define (detour (r Roads)) (→ Unit)
  (let* ((gps (new-gps))
         (start (● (stand 0) stop))
         (beach (● (stand 6) stop))
         (hill (● (stand 8) stop)))
    (navigate! gps r start (new Destination (dispatch 0) (kind (Deliver)) (point beach)) 0)
    (check (> (gps-distance gps r start) 10000.0) "GPS used a straight line to the beach")
    (let ((revision (● gps revision)))
      (navigate! gps r hill (new Destination (dispatch 0) (kind (Deliver)) (point beach)) 20)
      (check (and (> (● gps revision) revision)
                  (= (list-ref (● gps path) 0) (nearest-road r hill)))
             "GPS ignored a detour to Twin Peaks"))))
(define (castro-storefront (atlas Atlas)) (→ Unit)
  (let* ((s (stand 14)) (p (offset (● s stop) (forward (● s heading)) -10.0)))
    (check (string=? (nearest-sign (open-area atlas p) p) "Thailand Restaurant")
           "the Castro rank lost its nearest named storefront")))
(define (traffic-clearance (g Area) (r Roads) (cab Body)) (→ Unit)
  (let ((p (● cab position)))
    (for-each
     (lambda (v)
       (let* ((driver (Body-velocity-set cab v))
              (count (fold-left
                      (lambda (n seed)
                        (match (replacement-motor g r driver (Nil) seed)
                          ((Some m)
                           (let ((q (● (motor-body r m) position)))
                             (check (and (>= (distance p q) 96.0)
                                         (< (+ (* (● v x) (- (● q x) (● p x)))
                                               (* (● v z) (- (● q z) (● p z))))
                                            0.0))
                                    "traffic appeared in a speeding cab's approach")
                             (check (match (replacement-motor g r driver (list q) seed)
                                      ((None) #t)
                                      (_ #f))
                                    "traffic spawned through an occupied lane")
                             (+ n 1))) (_ n)))
                      0 (iota 64))))
         (check (> count 0) "traffic never found a safe lane")))
     (list (xz 0.0 -32.0) (xz 0.0 32.0) (xz 32.0 0.0) (xz -32.0 0.0)))))
(define (check-area-rays (g Area)) (→ Unit)
  (for-each (lambda (p)
              (let ((walls (area-solids g p 40.0)))
                (for-each (lambda (v)
                            (check (= (area-trace-distance g p v 20.0)
                                      (trace-distance p v 20.0 walls)) "packed terrain ray"))
                          (list (xz 0.0 0.0) (xz -1.0 0.0) (xz 0.0 1.0)
                                (xz 0.75 -0.75) (xz 2.0 1.0)))))
            (list (xz -145.0 12.0) (xz -145.0 0.0) (xz -140.0 -3.5) (xz 0.0 0.0))))

(define (sector-edges (atlas Atlas)) (→ Unit)
  (let* ((g (open-area atlas (xz -145.0 12.0))) (start (● g center)))
    (check-area-rays g)
    (let* ((p (xz -145.0 -40.0)) (before (area-height g p)))
      (prepare-area! g (xz 45.0 12.0))
      (check (and (= (focus-sector g (xz -145.0 -5.0)) start)
                  (= (focus-sector g p) (sector-id atlas p)))
             "an unexpected turn did not take priority beyond the focus margin")
      (check (match (prepare-area! g p) ((None) #t) (_ #f)) "loaded a whole new row in one frame")
      (for-each (lambda (_) (prepare-area! g p) (unit)) (iota 3))
      (match (prepare-area! g p)
        ((Some ready)
         (check (= (● g center) start) "prefetch changed the active physics or minimap")
         (check (= (● ready center) (sector-id atlas p)) "warmed the wrong sector")
         (check (= before (area-height ready p))
                "a missed prediction lost the ground under the cab")
         (focus-area! g p)
         (check (and (= (length (● ready sectors)) (length (● g sectors)))
                     (every? (lambda (pair) (= (● pair first id) (● pair second id)))
                             (zip (● ready sectors) (● g sectors))))
                "warm and resident triangle order differed"))
        (_ (panic "next sector did not warm"))))
    (focus-area! g (xz -145.0 45.0))
    (focus-area! g (xz -145.0 -5.0))
    (check (= (● g center) start) "changed scene while straddling a sector boundary")
    (focus-area! g (xz -145.0 -40.0))
    (check (not (= (● g center) start)) "kept the old scene after leaving its margin")))
(define (main (out OutputPort) (resources Resources)) (→ Unit)
  (let* ((atlas (read-atlas (read-resources resources city-bands)))
         (r (read-roads (read-resource resources streets-model)))
         (w (new-world)) (g (open-area atlas (● w game cab position))))
    (collisions)
    (boarding)
    (bicycles)
    (road-handling)
    (moving-cars)
    (chase-camera)
    (pedestrian-impact g r)
    (collision-fleet g r)
    (recovery g r)
    (legacy-fare g r (read-resource resources legacy-shift))
    (let ((old (restore-game (read-resource resources rigid-shift))))
      (check (and (= (length (● old cars)) 6) (= (● old sensitivity) 2)
                  (null? (● old falls)) (aboard? (● old game passenger)))
             "published rigid-body shift failed to migrate"))
    ;; Captured with the released CabShift schema at 360p, with a fare and impact in progress.
    (let ((old (restore-game (read-resource resources impact-shift))))
      (check (and (= (● old graphics resolution) 360) (= (● old graphics bounces) 1)
                  (= (● old graphics samples) 1) (= (● old sensitivity) 2)
                  (= (● old game bank) 1234) (aboard? (● old game passenger))
                  (match (● old game fare) ((Hired) #t) (_ #f))
                  (= (● (list-ref (● old cars) 0) center z) 7.0) (list-ref (● old braking) 0)
                  (match (fall-at old 1) ((Some k) (= (● k rest) 1.5)) (_ #f)))
             "published cab shift lost its lighting or fare during migration"))
    ;; The last release saved a directions choice alongside this active, metered fare.
    (let ((old (restore-game (read-resource resources graphics-shift))))
      (check (and (aboard? (● old game passenger)) (match (● old game fare) ((Hired) #t) (_ #f))
                  (= (● old sensitivity) 2)
                  (= (● old game bank) 850)
                  (= (fare-cents (● old game)) 500)
                  (= (● (objective (● old game)) dispatch) 0))
             "published metered fare lost its passenger, money or destination"))
    (traffic-stop r)
    (traffic-clearance g r (● w game cab))
    (interpolation)
    (grades g r)
    (kerbs g r)
    (bridge atlas (xz -4943.96 -2907.9) 60.0) (bridge atlas (xz 2966.92 1375.81) 49.0)
    (let ((clock (clock-minute (● w game))))
      (shift-time! (● w game))
      (check (= (clock-minute (● w game)) (modulo (+ clock 360) 1440)) "shift clock failed"))
    (populate! g r w) (service g r w) (coverage atlas r)
    (lake-waterline atlas) (sector-edges atlas) (castro-storefront atlas) (detour r)
    (write-line out "Taxi fare paid once, citywide streets and island routes connected.")))
