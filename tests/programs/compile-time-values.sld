(import (snail core base) (snail core io))
(struct Cell ((value I64)))
(struct Twice ((first Cell) (second Cell)))
(define (factorial (n I64)) (→ I64)
  (if (= n 0) 1 (* n (factorial (- n 1)))))
(define answer (→ I64) (factorial 6))
(define later (→ I64) earlier)
(define earlier (→ I64) (if #t 42 later))
(define pair (→ Twice)
  (let ((cell (Cell 1))) (Twice cell cell)))
(define numbers (→ (Vector I64)) (vector-generate 4 (lambda (i) (* i i))))
(let ((one pair) (two pair))
  (set! (● one first value) 9)
  (display (● one second value))
  (display (● two first value))
  (display answer)
  (display later)
  (display (vector-ref numbers 3))
  (newline))
