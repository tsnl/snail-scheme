(import (scheme base) (scheme write))
(define (check value expected)
  (if (not (equal? value expected)) (error "storage check failed" value expected)))
(define integers (vector 1073741824 1073741825))
(vector-set! integers 1 (+ (vector-ref integers 0) 7))
(check (vector-ref integers 1) 1073741831)
(define reals (make-vector 8 1.5))
(vector-set! reals 3 (+ (vector-ref reals 0) 0.25))
(check (vector-ref reals 3) 1.75)
(define booleans (vector #t #f))
(vector-set! booleans 0 #f)
(check (vector-ref booleans 0) #f)
(define characters (vector #\a #\b))
(vector-set! characters 1 #\z)
(check (vector-ref characters 1) #\z)
(define shared (cons 'old 'tail))
(define references (vector shared shared))
(set-car! (vector-ref references 0) 'new)
(check (eq? (vector-ref references 1) shared) #t)
(check (car (vector-ref references 1)) 'new)
;; The fresh destination's later String write must not broaden integers.
(define copied (vector-append integers integers))
(vector-set! copied 0 "changed")
(check (vector-ref copied 0) "changed")
(check (vector-ref integers 0) 1073741824)
;; One alias-changing write broadens this allocation from the beginning.
(define mixed (vector #t #f))
(define alias mixed)
(vector-set! alias 0 #\x)
(check (vector-ref mixed 0) #\x)
(vector-copy! mixed 1 mixed 0 1)
(check (vector-ref mixed 1) #\x)
(display "fixed vector storage checks passed\n")
