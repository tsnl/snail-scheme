(import (scheme base) (scheme read) (scheme write))

(define (check expected actual)
  (unless (equal? expected actual) (error "datum input mismatch" expected actual)))

(define input (open-input-string "42 λ '(a . #(\"λ\\x1f600;\" #\\space #u8(0 255)))"))
(check 42 (read input))
(check #\space (peek-char input))
(check #\space (peek-char input))
(check #\space (read-char input))
(check 'λ (read input))
(check #t (eq? 'λ (read (open-input-string "λ"))))
(check #t (eq? 'λ (string->symbol "λ")))
(check '(quote (a . #("λ😀" #\space #u8(0 255)))) (read input))
(check #t (eof-object? (read input)))
(check #t (eof-object? (read input)))
(check #t (eof-object? (eof-object)))

(define comments (open-input-string "#| outer #| inner |# |# #;#;a b #!fold-case HELLO #!no-fold-case HELLO |HELLO|"))
(check 'hello (read comments))
(check 'HELLO (read comments))
(check 'HELLO (read comments))
(parameterize ((current-input-port (open-input-string "#x10 #i2 #e3.0")))
  (check 16 (read))
  (check #t (inexact? (read)))
  (check 3 (read)))

(define cycle (read (open-input-string "#1=(a . #1#)")))
(check #t (eq? cycle (cdr cycle)))
(define shared (read (open-input-string "(#1=#(x) #1#)")))
(check #t (eq? (car shared) (cadr shared)))
(define vector-cycle (read (open-input-string "#1=#(#1#)")))
(check #t (eq? vector-cycle (vector-ref vector-cycle 0)))

(define lines (open-input-string "λ\r\nnext\rfinal"))
(check "λ" (read-line lines))
(check "next" (read-line lines))
(check "final" (read-line lines))
(check #t (eof-object? (read-line lines)))
(define output (open-output-string))
(write-char #\λ output)
(write-char #\newline output)
(check "λ\n" (get-output-string output))

;; These exercise allocation/root retention and heap-based parser nesting.
(define flat (open-output-string))
(write-char #\( flat)
(let loop ((index 0))
  (when (< index 5000) (display "1 " flat) (loop (+ index 1))))
(write-char #\) flat)
(check 5000 (length (read (open-input-string (get-output-string flat)))))
(define deep (open-output-string))
(let loop ((index 0))
  (when (< index 2000) (write-char #\( deep) (loop (+ index 1))))
(display "0" deep)
(let loop ((index 0))
  (when (< index 2000) (write-char #\) deep) (loop (+ index 1))))
(define nested (read (open-input-string (get-output-string deep))))
(check 0 (let loop ((value nested)) (if (pair? value) (loop (car value)) value)))
(check 9007199254740993 (read (open-input-string "#e9007199254740993.0")))
(check 9223372036854775808.0 (read (open-input-string "#i9223372036854775808")))
(check 18446744073709551616.0 (read (open-input-string "#i#x10000000000000000")))
(check -inf.0 (/ 1 (read (open-input-string "#i-0"))))
(check #f (string->number "9223372036854775808oops"))
(check (string->symbol "line\r\nend") (read (open-input-string "|line\r\nend|")))
(for-each
 (lambda (text)
   (let ((symbol (string->symbol text)) (port (open-output-string)))
     (write symbol port)
     (check symbol (read (open-input-string (get-output-string port))))))
 '("x |\\\n" "123" "+i" "." ""))
(display "datum input checks passed\n")
