(import
 (snail core base)
 (snail core io)
 (snail shell wire)
 (snail shell game dialogue))
(define (expect (yes Bool)) (→ Unit) (unless yes (panic "dialogue cursor")))
(define (at (value (Option Cursor)))
  (→ Cursor)
  (match value ((Some c) c) (_ (panic "missing passage"))))
(define (main (out OutputPort)) (→ Unit)
  (let* ((book (new Dialogue (start "platform")
                    (pages (list (new Passage
                                   (id "platform")
                                   (lines (list "Last train." "Are you coming?"))
                                   (choices (list (new Reply (text "Yes") (next "train"))
                                                  (new Reply (text "No") (next "end")))))
                                 (new Passage
                                   (id "train")
                                   (lines (list "Doors closing."))
                                   (choices (Nil)))
                                 (new Passage (id "end") (lines (Nil)) (choices (Nil)))))))
         (first (at (open-dialogue book))) (choose (at (continue-dialogue book first)))
         (restored (ann (deserialize (serialize choose)) Cursor)))
    (expect (and (null? (replies book first)) (string=? (spoken book first) "Last train.")))
    (expect (string=? (spoken book (at (answer-dialogue book first 1))) "Last train."))
    (expect (and (= (length (replies book restored)) 2)
                 (string=? (spoken book restored) "Are you coming?")))
    (expect (string=? (● (at (continue-dialogue book choose)) page) "platform"))
    (expect (string=? (● (at (answer-dialogue book choose 9)) page) "platform"))
    (let ((last (at (answer-dialogue book choose 0))))
      (expect (string=? (spoken book last) "Doors closing."))
      (expect (match (continue-dialogue book last) ((None) #t) (_ #f))))
    (expect (match (answer-dialogue book restored 1) ((None) #t) (_ #f)))
    (write-line out "Lines, branching choices, saved cursors and endings passed.")))
