;; Independent observations execute the original and typed graph algorithms.
;; Host adapters supply only representation selectors and scalar trace output.

;; ---- Work counts and ordered graph snapshots ----

(define probe-counts (make-vector 30 0))
(define probe-snapshots (ref #t))
(define (probe-tick index)
  (vector-set! probe-counts index (+ (vector-ref probe-counts index) 1)))
(define (probe-reset)
  (let loop ((index 0))
    (unless (= index (vector-length probe-counts))
      (vector-set! probe-counts index 0) (loop (+ index 1)))))
(define (probe-assert label condition)
  (emit-i64 label) (emit-i64 (if condition 1 0))
  (unless condition (unreachable)))
(define (probe-string value)
  (emit-i64 (string-length value))
  (let loop ((index 0))
    (unless (= index (string-length value))
      (emit-char (string-ref value index)) (loop (+ index 1)))))
(define (probe-node-id value nodes)
  (let loop ((nodes nodes) (index 0))
    (if (null? nodes) -1
        (if (conform-eq? value (car nodes)) index (loop (cdr nodes) (+ index 1))))))
(define (probe-links values nodes)
  (emit-i64 (conform-length values))
  (conform-for-each (lambda (value) (emit-i64 (probe-node-id value nodes))) values))
(define (probe-blue edge nodes)
  (probe-string (conform-symbol->string (operation edge)))
  (emit-i64 (probe-node-id (arg-node edge) nodes))
  (emit-i64 (probe-node-id (res-node edge) nodes)))
(define (probe-node node nodes)
  (probe-string (internal-node-name node))
  (probe-links (internal-node-green-edges node) nodes)
  (probe-links (internal-node-red-edges node) nodes)
  (emit-i64 (probe-blue-state node))
  (when (= (probe-blue-state node) 2)
    (emit-i64 (conform-length (probe-blue-list node)))
    (conform-for-each (lambda (edge) (probe-blue edge nodes)) (probe-blue-list node))))
(define (probe-table table nodes)
  (emit-i64 (conform-length (probe-rows table)))
  (conform-for-each
    (lambda (row)
      (emit-i64 (probe-node-id (probe-row-key row) nodes))
      (emit-i64 (conform-length (probe-row-values row)))
      (conform-for-each
        (lambda (entry)
          (emit-i64 (probe-node-id (probe-entry-key entry) nodes))
          (emit-i64 (probe-node-id (probe-entry-value entry) nodes)))
        (probe-row-values row)))
    (probe-rows table)))
(define (probe-graph stage graph)
  (when (ref-get probe-snapshots)
    (emit-i64 stage)
    (emit-i64 (conform-length (graph-nodes graph)))
    (conform-for-each (lambda (node) (probe-node node (graph-nodes graph))) (graph-nodes graph))
    (probe-table (already-met graph) (graph-nodes graph))
    (probe-table (already-joined graph) (graph-nodes graph))))
(define (probe-cache-result value)
  (when (= (probe-blue-state value) 0) (probe-tick 8))
  value)
(define (probe-insert value)
  (probe-tick 7)
  (when (= (probe-blue-state value) 0) (probe-tick 29)))
(define (probe-work)
  (emit-i64 200) (emit-i64 (vector-length probe-counts))
  (let loop ((index 0))
    (unless (= index (vector-length probe-counts))
      (emit-i64 (vector-ref probe-counts index)) (loop (+ index 1)))))

;; ---- Identity, aliasing, and functional collection ordering ----

(define (probe-node-list=? left right)
  (if (null? left) (null? right)
      (and (not (null? right)) (conform-eq? (car left) (car right))
           (probe-node-list=? (cdr left) (cdr right)))))
(define (probe-strings=? left right)
  (if (null? left) (null? right)
      (and (not (null? right)) (string=? (car left) (car right))
           (probe-strings=? (cdr left) (cdr right)))))
(define (probe-setup)
  (setup (symbol-name (conform-string->symbol "a"))
         (symbol-name (conform-string->symbol "b")) (text-name "c") (text-name "d")))
(define (probe-plain text)
  (let ((node (make-node (text-name text)))) (set-blue-edges! node '()) node))
(define (probe-copy-aliases)
  (probe-setup)
  (let* ((a (probe-a)) (b (probe-b)) (copy (copy-node a))
         (graph (make-graph a b any-node none-node)) (other (copy-graph graph)))
    (probe-assert 1 (not (conform-eq? a copy)))
    (probe-assert 2 (string-eq? (internal-node-name a) (internal-node-name copy)))
    (probe-assert 3 (probe-edge-same? (car (blue-edges a)) (car (blue-edges copy))))
    (probe-assert 4 (probe-node-list=? (graph-nodes graph) (graph-nodes other)))
    (probe-copy-mutations a b copy graph other)))
(define (probe-copy-mutations a b copy graph other)
  (set-internal-node-name! copy "renamed")
  (set-green-edges! copy (conform-list b))
  (set-arg-node! (car (blue-edges copy)) b)
  (add-graph-nodes! other copy)
  (probe-assert 5 (and (string=? (internal-node-name a) "a") (null? (green-edges a))))
  (probe-assert 6 (conform-eq? (arg-node (car (blue-edges a))) b))
  (probe-assert 7 (and (= (conform-length (graph-nodes graph)) 4) (= (conform-length (graph-nodes other)) 5)))
  (probe-shared-tables a b copy graph other))
(define (probe-shared-tables a b copy graph other)
  (probe-assert 8 (and (probe-table-same? (already-met graph) (already-met other))
                       (probe-table-same? (already-joined graph) (already-joined other))))
  (insert! (already-met other) a b copy)
  (insert! (already-met graph) a b a)
  (insert! (already-joined other) a b b)
  (probe-assert 9 (and (conform-eq? (probe-hit-value (lookup (already-met other) a b)) a)
                       (conform-eq? (probe-hit-value (lookup (already-joined graph) a b)) b)))
  (probe-assert 10 (and (not (probe-hit? (lookup (already-met graph) b a)))
                        (= (conform-length (probe-row-values (car (probe-rows (already-met graph))))) 2))))
(define (probe-name-conversion)
  (let* ((text (make-string 2 #\x)) (symbol (conform-string->symbol "xx"))
         (first (make-node (text-name text))) (second (make-node (text-name text)))
         (third (make-node (symbol-name symbol))) (fourth (make-node (symbol-name symbol))))
    (probe-assert 11 (not (conform-eq? first second)))
    (probe-assert 12 (and (string-eq? text (internal-node-name first))
                         (string-eq? (internal-node-name first) (internal-node-name second))))
    (probe-assert 13 (and (string=? (internal-node-name third) (internal-node-name fourth))
                         (not (conform-eq? third fourth))))))
(define (probe-sort-and-sets)
  (let* ((a (probe-plain "aa")) (b (probe-plain "bb"))
         (c (probe-plain "cc")) (d (probe-plain "dd")) (nodes (conform-list a b c d)))
    (probe-assert 14 (probe-node-list=? (sort-list nodes (lambda (x y) #f)) (conform-list c a d b)))
    (probe-assert 15 (probe-node-list=? (car (classify nodes)) (conform-list b d a c)))
    (probe-assert 16 (probe-node-list=? (intersect nodes (conform-list c a)) (conform-list a c)))
    (probe-assert 17 (probe-node-list=? (union (conform-list a b c) (conform-list c d)) (conform-list b a c d)))
    (probe-assert 18 (probe-node-list=? (eliminate b nodes) (conform-list a c d)))))

;; ---- Temporary assumptions, missing operations, and canonical tables ----

(define (probe-red-transitions)
  (let* ((p (probe-plain "p")) (q (probe-plain "q")) (r (probe-plain "r")))
    (set-blue-edges! p (conform-list (make-blue-edge phi-operation any-node p)))
    (set-blue-edges! q (conform-list (make-blue-edge phi-operation any-node q)))
    (set-blue-edges! r (conform-list (make-blue-edge phi-operation any-node r)
                                  (make-blue-edge theta-operation any-node r)))
    (probe-assert 19 (conforms? p q))
    (probe-assert 20 (and (null? (red-edges p)) (green-edge? p q)))
    (probe-assert 21 (not (conforms? q r)))
    (probe-assert 22 (and (null? (red-edges q)) (null? (green-edges q))))
    (probe-assert 23 (and (probe-op-hit? (lookup-op phi-operation p))
                         (not (probe-op-hit? (lookup-op theta-operation p)))))
    (set-blue-edges! r (conform-list (make-blue-edge phi-operation any-node p)
                                  (make-blue-edge phi-operation any-node q)))
    (probe-assert 34 (conform-eq? (res-node (probe-op-value (lookup-op phi-operation r))) p))))
(define (probe-special-nodes)
  (let ((unresolved (make-node (text-name "unfinished"))))
    (probe-assert 24 (and (= (probe-blue-state unresolved) 0) (= (probe-blue-state none-node) 1)
                         (= (probe-blue-state any-node) 2)))
    (set-blue-edges! none-node '())
    (set-green-edges! none-node (conform-list any-node))
    (probe-assert 25 (and (= (probe-blue-state none-node) 1) (null? (internal-node-green-edges none-node))))
    (probe-assert 26 (and (green-edge? none-node any-node) (red-edge? none-node any-node)
                         (not (green-edge? any-node none-node)) (not (red-edge? any-node none-node))))
    (let ((ordinary (probe-plain "none")))
      (probe-assert 33 (and (not (none-node? ordinary)) (null? (blue-edges ordinary)))))))
(define (probe-canonical-table)
  (let* ((x (probe-plain "x")) (y (probe-plain "y")) (z (probe-plain "z"))
         (graph (make-graph x y z any-node none-node)))
    (set-green-edges! x (conform-list y x z)) (set-red-edges! x (conform-list y x))
    (set-blue-edges! x (conform-list (make-blue-edge phi-operation y y)))
    (insert! (already-met graph) y x z) (insert! (already-met graph) x y y)
    (insert! (already-met graph) x z y) (insert! (already-met graph) z x y)
    (insert! (already-joined graph) x y y)
    (probe-canonical-result graph x y z)))
(define (probe-canonical-result graph x y z)
  (let ((reduced (canonicalize-graph graph
                   (conform-list (conform-list x y) (conform-list z) (conform-list any-node) (conform-list none-node)))))
    (probe-assert 27 (probe-node-list=? (graph-nodes reduced) (conform-list x z any-node none-node)))
    (probe-assert 28 (not (probe-table-same? (already-met graph) (already-met reduced))))
    (probe-assert 29 (conform-eq? (probe-hit-value (lookup (already-met reduced) x z)) x))
    (probe-assert 30 (conform-eq? (probe-hit-value (lookup (already-met graph) x z)) y))
    (probe-assert 31 (and (conform-eq? (arg-node (car (blue-edges x))) x)
                         (conform-eq? (res-node (car (blue-edges x))) x)))
    (probe-assert 35 (probe-node-list=? (green-edges x) (conform-list x x z)))
    (probe-assert 36 (probe-node-list=? (red-edges x) (conform-list x x)))
    (probe-assert 37 (and (= (conform-length (probe-rows (already-joined reduced))) 1)
                         (null? (probe-row-values (car (probe-rows (already-joined reduced)))))))
    (probe-assert 38 (not (probe-row-same? (car (probe-rows (already-met graph)))
                                        (car (probe-rows (already-met reduced))))))
    (probe-graph 99 reduced)))

;; ---- One complete canonical lattice, independent of the final name predicate ----

(define (probe-all)
  (probe-copy-aliases) (probe-name-conversion) (probe-sort-and-sets)
  (probe-red-transitions) (probe-special-nodes) (probe-canonical-table)
  (probe-reset)
  (probe-setup)
  (let ((graph (make-lattice (make-graph (probe-a) (probe-b) (probe-c) (probe-d) any-node none-node) #f)))
    (probe-graph 102 graph)
    (probe-work)
    (probe-assert 32 (= (conform-length (graph-nodes graph)) 31)))
  1)

;; The counted full run checks each iteration separately. Clean timing still
;; uses the original single final-result predicate and has no probe counters.
(define (probe-test names)
  (test (car names) (car (cdr names)) (car (cdr (cdr names))) (car (cdr (cdr (cdr names))))))
(define (probe-delta previous)
  (let loop ((index 0))
    (unless (= index (vector-length probe-counts))
      (let ((current (vector-ref probe-counts index)))
        (emit-i64 (- current (vector-ref previous index)))
        (vector-set! previous index current))
      (loop (+ index 1)))))
(define (probe-full count names expected)
  (ref-set! probe-snapshots #f)
  (probe-reset)
  (let ((previous (make-vector 30 0)))
    (let loop ((index 0))
      (if (= index count) (begin (emit-i64 201) (emit-i64 index) (probe-work) 1)
          (begin
            (unless (probe-strings=? (probe-test names) expected) (unreachable))
            (emit-i64 202) (emit-i64 (+ index 1)) (probe-delta previous)
            (loop (+ index 1)))))))
(: probe-fatal (-> I64 I64))
(define (probe-fatal command)
  (if (= command 9001) (begin (green-edges any-node) 0)
      (if (= command 9002) (begin (red-edges none-node) 0)
          (if (= command 9003) (begin (car (blue-edges (make-node (text-name "unfinished")))) 0)
              (if (= command 9004) (begin (set-blue-edges! any-node '()) 0)
                  (unreachable))))))
(: probe-run (-> I64 (List Name) (List String) I64))
(define (probe-run count names expected)
  (if (>= count 9000) (probe-fatal count)
      (if (= count 1) (probe-all) (probe-full count names expected))))
