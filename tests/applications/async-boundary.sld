;; Tiny actual Wasm reducers isolate asynchronous host ordering from game rules.
(define-library (async-boundary)
  (export answer)
  (import
   (scheme base)
   (only (lofi core) ann -> I32 define-extern)
   (only (lofi base) unreachable))
  (begin
    (define-extern read "snail.reducer" "read" (-> I32 I32 I32))
    (define-extern stage "snail.reducer" "write" (-> I32 I32 I32 Unit))
    (define-extern send "snail.reducer" "command" (-> I32 I32 I32 I32 Unit))
    (define-extern note "snail.reducer" "note" (-> I32 I32 Unit))
    (define-extern label "snail.reducer" "label" (-> I32 I32 Unit))

    (define (change slot amount)
      (cond ((< slot 2)
             (stage 1 1 (+ (read 1 1) amount))
             (note -1 1) (note 0 65) (send 2 0 amount 0))
            ((= slot 2) (stage 1 2 amount))
            ((= slot 3) (stage 1 1 0) (stage 1 3 (+ (read 1 3) 1)))
            ((= slot 4) (stage 1 1 99) (note -1 1) (note 0 1114112))
            ((= slot 5) (stage 1 1 99) (send 1 99 0 0))
            (else (stage 1 1 99) (unreachable))))

    (define answer
      (ann (lambda (operation a b c)
             (cond ((= operation 0)
                    (cond ((= a 1) 4) ((= a 2) 2) (else 1)))
                   ((= operation 1) (stage a 0 1) 1)
                   ((= operation 2) (change a b) 1)
                   ((= operation 3)
                    (stage 2 1 (+ (read 2 1) b)) (send 1 0 b 0) 1)
                   ((= operation 4) (label -1 1) (label 0 65) 1)
                   (else 1)))
           (-> I32 I32 I32 I32 I32)))))
