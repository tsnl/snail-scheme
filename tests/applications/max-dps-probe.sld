;; Scalar observations of the real model keep the capacity test's economy,
;; weapons and waves tied to Scheme. The starter experiment also accepts paid
;; survey orders in an explicitly instantaneous fixture; neither host test is a
;; second game simulation.
(define-library (tests max-dps-probe)
  (export answer)
  (import
   (scheme base)
   (scheme immutable)
   (siegework model)
   (siegework terrain)
   (only (siegework state) validate-world)
   (only (lofi core) ann -> I32 I64))
  (begin

    ;; ---- Controlled model observations ----

    (define (empty-started-world seed)
      (let* ((world (seeded-world (initial-world) seed))
             (world (extract-world world (+ (world-hub-x world) 4) (- (world-hub-y world) 2))))
        (world-bots-set (world-buildings-set world (empty-list)) (empty-list))))
    (define (fixture-building kind level x y)
      (make-building 4 kind x y level (building-health kind) 0 2 0
                     (cell-x x) (cell-y y) 0 0 -1 -1))
    (define (fixture-worker id x y job target)
      (make-bot id (cell-x x) (cell-y y) job target 0 0 (empty-list) 14 0 0))
    (define (shot-world seed level)
      (let* ((world (empty-started-world seed))
             (x (+ (world-hub-x world) 4)) (y (world-hub-y world))
             (gun (fixture-building 2 level x y))
             (enemy (make-enemy 5 (cell-x x) (cell-y y) 10000 0 4 (empty-list) #f 0)))
        (advance-world (world-enemies-set (world-buildings-set world (list gun)) (list enemy)))))
    (define (enemy-health-total enemies)
      (if (null? enemies) 0 (+ (enemy-hp (car enemies)) (enemy-health-total (cdr enemies)))))
    (define (wave-health seed tick)
      (enemy-health-total (world-enemies (advance-world (world-tick-set (empty-started-world seed) (- tick 1))))))
    (define (first-production world elapsed)
      (cond ((> (world-produced world) 0) elapsed)
            ((>= elapsed 1000) -1)
            (else (first-production (advance-world world) (+ elapsed 1)))))
    (define (production-period seed)
      (let* ((world (empty-started-world seed))
             (x (+ (world-hub-x world) 4)) (y (- (world-hub-y world) 2)))
        (first-production
         (world-bots-set (world-buildings-set world (list (fixture-building 1 1 x y)))
                         (list (fixture-worker 1 x y 8 4))) 0)))
    (define (idle-workers count x y)
      (if (= count 0) (empty-list)
          (cons (fixture-worker count x y 0 0) (idle-workers (- count 1) x y))))
    (define (upgrade-allowed? seed kind level)
      (let* ((world (world-credits-set (empty-started-world seed) 1000000))
             (x (+ (world-hub-x world) 4)) (y (world-hub-y world)))
        (not (= (world-notice
                 (upgrade-world (world-buildings-set world (list (fixture-building kind level x y))) x y)) 11))))
    (define (level-limit seed kind level)
      (cond ((not (upgrade-allowed? seed kind level)) level)
            ((>= level 10) -1)
            (else (level-limit seed kind (+ level 1)))))
    (define (mine-slots seed level)
      (let* ((world (empty-started-world seed))
             (x (+ (world-hub-x world) 4)) (y (- (world-hub-y world) 2))
             (world (world-buildings-set world (list (fixture-building 1 level x y))))
             (world (world-bots-set world (idle-workers (worker-capacity world) x y)))
             (bots (world-bots (advance-world world))))
        (+ (workers-at bots 8 4) (workers-at bots 9 4))))
    (define (advance-count world ticks)
      (if (= ticks 0) world (advance-count (advance-world world) (- ticks 1))))
    (define (expanded-hub world level)
      (if (= level 0) world
          (expanded-hub (advance-count (upgrade-world world (world-hub-x world) (world-hub-y world)) hub-upgrade-ticks)
                        (- level 1))))
    (define (capacity-world seed level)
      (let ((world (empty-started-world seed)))
        (expanded-hub (world-bots-set (world-credits-set world 1000000)
                                      (list (fixture-worker 1 (world-hub-x world) (world-hub-y world) 0 0))) level)))

    ;; ---- Paid survey experiment, without elapsed time or enemies ----

    ;; This one-cell fixture is private to each Wasm instance. The initial mine
    ;; spends real starting cash before its finite reserve is moved to delivered
    ;; ore. Material invariants hold, but extraction and delivery take no time.
    (define scout-state (vector (initial-world)))
    (define (scout-world) (vector-ref scout-state (ann 0 I64)))
    (define (reset-scout! seed)
      (begin
        (vector-set! scout-state (ann 0 I64) (seeded-world (initial-world) seed))
        0))
    (define (tile seed cell)
      (+ (* 2 (deposit-rate seed (index-x cell) (index-y cell)))
         (if (ground? seed (index-x cell) (index-y cell)) 1 0)))
    (define (scout-tile cell)
      (let ((world (scout-world)))
        (if (and (visible? world (index-x cell) (index-y cell))
                 (surveyed? (world-surveys world) (index-x cell) (index-y cell)))
            (tile (world-seed world) cell) -1)))
    (define (completed-buildings buildings)
      (if (null? buildings) buildings
          (cons (building-stage-set (car buildings) 2) (completed-buildings (cdr buildings)))))
    (define (complete-scout-project world cell)
      (let* ((world (world-buildings-set world (completed-buildings (world-buildings world))))
             (site (car (building-at (world-buildings world) (index-x cell) (index-y cell))))
             (survey (make-survey (building-x site) (building-y site) (building-radius site))))
        (validate-world
         (rebuild-transport
          (world-bots-set (world-surveys-set world (cons survey (world-surveys world)))
                          (world-bots (seeded-world (initial-world) (world-seed world))))))))
    (define (scout-purchase! kind cell)
      (let ((outcome (place-cell-outcome (scout-world) kind cell)))
        (begin
          (when (= (construction-reason outcome) 0)
            (vector-set! scout-state (ann 0 I64) (complete-scout-project (construction-world outcome) cell)))
          (construction-reason outcome))))
    (define (drain-deposit deposits cell)
      (if (null? deposits) deposits
          (cons (if (= (deposit-cell (car deposits)) cell) (make-deposit cell 0) (car deposits))
                (drain-deposit (cdr deposits) cell))))
    ;; These three ledgers and the underground reserve change together. Copying
    ;; the concrete World keeps this fixture out of the product's public API.
    (define (deliver-starter world cell amount)
      (make-world
       (world-tick world)
       (world-outcome world)
       (+ (world-credits world) amount)
       (world-hull world)
       (world-kills world)
       (world-next-id world)
       (world-buildings world)
       (world-bots world)
       (world-enemies world)
       (world-surveys world)
       (world-focus world)
       (world-plan world)
       (+ (world-delivered world) amount)
       (+ (world-produced world) amount)
       (world-spent world)
       (world-lost world)
       (world-notice world)
       (world-paused world)
       (world-seed world)
       (world-casualties world)
       (world-lost-ore world)
       (world-alerts world)
       (world-run-marker world)
       (world-rails world)
       (world-local-spent world)
       (world-nests world)
       (world-last-reveal-tick world)
       (world-breaches world)
       (world-excavations world)
       (world-started world)
       (world-tracks world)
       (world-hub-capacity-level world)
       (drain-deposit (world-deposits world) cell)))
    (define (fund-starter!)
      (let* ((world (scout-world)) (buildings (world-buildings world)))
        (if (or (> (world-produced world) 0)
                (not (= (list-size buildings) 1)) (not (= (building-kind (car buildings)) 1))) -1
                (let* ((site (car buildings)) (cell (cell-index (building-x site) (building-y site)))
                       (reserve (ore-remaining world (building-x site) (building-y site))))
                  (begin
                    (vector-set! scout-state (ann 0 I64) (validate-world (deliver-starter world cell reserve)))
                    reserve)))))

    ;; ---- One typed scalar entry for the host's named queries ----

    (define answer
      (ann
       (lambda (operation value seed)
         (cond ((= operation 0) (world-credits (initial-world)))
               ((= operation 1) (list-size (world-bots (initial-world))))
               ((= operation 2) (building-cost value))
               ((= operation 3) (upgrade-cost (fixture-building (quotient value 10) (remainder value 10) 0 0)))
               ((= operation 4) worker-cost)
               ((= operation 5) worker-assembly-ticks)
               ((= operation 6) maximum-workers)
               ((= operation 7) maximum-buildings)
               ((= operation 8) (- 10000 (enemy-health-total (world-enemies (shot-world seed value)))))
               ((= operation 9) (building-cooldown (car (world-buildings (shot-world seed 1)))))
               ((= operation 10) (production-period seed))
               ((= operation 11) (next-attack-tick value))
               ((= operation 12) (wave-health seed value))
               ((= operation 13) (attack-size value))
               ((= operation 14) (attack-kind value))
               ((= operation 15) (deposit-rate seed (index-x value) (index-y value)))
               ((= operation 16) map-width)
               ((= operation 17) map-height)
               ((= operation 18) (spawn-x seed))
               ((= operation 19) (spawn-y seed))
               ((= operation 20) final-siege-tick)
               ((= operation 21) (level-limit seed value 1))
               ((= operation 22) (mine-slots seed value))
               ((= operation 23) (deposit-capacity seed (index-x value) (index-y value)))
               ((= operation 24) (hub-upgrade-cost (capacity-world seed value)))
               ((= operation 25) (worker-capacity (capacity-world seed value)))
               ((= operation 26) hub-upgrade-ticks)
               ((= operation 27) maximum-hub-capacity-level)
               ((= operation 28) (reset-scout! seed))
               ((= operation 29) (scout-tile value))
               ((= operation 30) (placement-reason (scout-world) 3 (index-x value) (index-y value)))
               ((= operation 31) (scout-purchase! 3 value))
               ((= operation 32) (scout-purchase! 1 value))
               ((= operation 33) (world-credits (scout-world)))
               ((= operation 34) (world-spent (scout-world)))
               ((= operation 35) (fund-starter!))
               ((= operation 36) (building-radius (fixture-building (quotient value 10) (remainder value 10) 0 0)))
               ((= operation 37) (survey-radius (car (world-surveys (scout-world)))))
               ((= operation 38) (tile seed value))
               ((= operation 39) (list-size (walking-path seed (spawn-x seed) (spawn-y seed)
                                                          (index-x value) (index-y value) (empty-list) #t)))
               (else -1)))
       (-> I32 I32 I32 I32)))))
