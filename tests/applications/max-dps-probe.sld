;; Scalar observations of the real model keep the capacity test's economy,
;; weapons and waves tied to Scheme. Constructed worlds isolate one operation;
;; the capacity simulation lives in max-dps-test.mjs, not in the game.
(define-library (tests max-dps-probe)
  (export answer)
  (import
   (scheme base)
   (scheme immutable)
   (siegework model)
   (siegework terrain)
   (only (lofi core) ann -> I32))
  (begin

    ;; ---- Controlled model observations ----

    (define (empty-started-world seed)
      (let* ((world (seeded-world (initial-world) seed))
             (world (extract-world world (+ (world-hub-x world) 4) (- (world-hub-y world) 2))))
        (world-bots-set (world-buildings-set world (empty-list)) (empty-list))))
    (define (fixture-building kind level x y)
      (make-building 4 kind x y level (building-health kind) 0 2 0
                     (cell-x x) (cell-y y) 0 0 -1 -1))
    (define (fixture-worker id x y job target)
      (make-bot id (cell-x x) (cell-y y) job target 0 0 (empty-list) 14 0 0))
    (define (shot-world seed level)
      (let* ((world (empty-started-world seed))
             (x (+ (world-hub-x world) 4)) (y (world-hub-y world))
             (gun (fixture-building 2 level x y))
             (enemy (make-enemy 5 (cell-x x) (cell-y y) 10000 0 4 (empty-list) #f 0)))
        (advance-world (world-enemies-set (world-buildings-set world (list gun)) (list enemy)))))
    (define (enemy-health-total enemies)
      (if (null? enemies) 0 (+ (enemy-hp (car enemies)) (enemy-health-total (cdr enemies)))))
    (define (wave-health seed tick)
      (enemy-health-total (world-enemies (advance-world (world-tick-set (empty-started-world seed) (- tick 1))))))
    (define (first-production world elapsed)
      (cond ((> (world-produced world) 0) elapsed)
            ((>= elapsed 1000) -1)
            (else (first-production (advance-world world) (+ elapsed 1)))))
    (define (production-period seed)
      (let* ((world (empty-started-world seed))
             (x (+ (world-hub-x world) 4)) (y (- (world-hub-y world) 2)))
        (first-production
         (world-bots-set (world-buildings-set world (list (fixture-building 1 1 x y)))
                         (list (fixture-worker 1 x y 8 4))) 0)))
    (define (idle-workers count x y)
      (if (= count 0) (empty-list)
          (cons (fixture-worker count x y 0 0) (idle-workers (- count 1) x y))))
    (define (worker-limit world count)
      (let ((candidate (world-bots-set world (idle-workers count (world-hub-x world) (world-hub-y world)))))
        (cond ((= (fabrication-reason candidate) 8) count)
              ((>= count 100) -1)
              (else (worker-limit world (+ count 1))))))
    (define (upgrade-allowed? seed kind level)
      (let* ((world (world-credits-set (empty-started-world seed) 1000000))
             (x (+ (world-hub-x world) 4)) (y (world-hub-y world)))
        (not (= (world-notice
                 (upgrade-world (world-buildings-set world (list (fixture-building kind level x y))) x y)) 11))))
    (define (level-limit seed kind level)
      (cond ((not (upgrade-allowed? seed kind level)) level)
            ((>= level 10) -1)
            (else (level-limit seed kind (+ level 1)))))
    (define (mine-slots seed level)
      (let* ((world (empty-started-world seed))
             (x (+ (world-hub-x world) 4)) (y (- (world-hub-y world) 2))
             (world (world-buildings-set world (list (fixture-building 1 level x y))))
             (world (world-bots-set world (idle-workers (worker-limit (initial-world) 1) x y)))
             (bots (world-bots (advance-world world))))
        (+ (workers-at bots 8 4) (workers-at bots 9 4))))

    ;; ---- One typed scalar entry for the host's named queries ----

    (define answer
      (ann
       (lambda (operation value seed)
         (cond ((= operation 0) (world-credits (initial-world)))
               ((= operation 1) (list-size (world-bots (initial-world))))
               ((= operation 2) (building-cost value))
               ((= operation 3) (upgrade-cost (fixture-building (quotient value 10) (remainder value 10) 0 0)))
               ((= operation 4) worker-cost)
               ((= operation 5) worker-assembly-ticks)
               ((= operation 6) (worker-limit (initial-world) 1))
               ((= operation 7) maximum-buildings)
               ((= operation 8) (- 10000 (enemy-health-total (world-enemies (shot-world seed value)))))
               ((= operation 9) (building-cooldown (car (world-buildings (shot-world seed 1)))))
               ((= operation 10) (production-period seed))
               ((= operation 11) (next-attack-tick value))
               ((= operation 12) (wave-health seed value))
               ((= operation 13) (attack-size value))
               ((= operation 14) (attack-kind value))
               ((= operation 15) (deposit-rate seed (index-x value) (index-y value)))
               ((= operation 16) map-width)
               ((= operation 17) map-height)
               ((= operation 18) (spawn-x seed))
               ((= operation 19) (spawn-y seed))
               ((= operation 20) final-siege-tick)
               ((= operation 21) (level-limit seed value 1))
               ((= operation 22) (mine-slots seed value))
               (else -1)))
       (-> I32 I32 I32 I32)))))
