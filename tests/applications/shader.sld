(define-library (tests shader)
  (export answer)
  (import (scheme base) (webgpu shader) (only (lofi core) ann -> I32)
          (only (lofi base) string=?))
  (begin
    (define-syntax clip (syntax-rules () ((_) (gpu (vec4 position zero one)))))
    (define (valid-compositions?)
      (and (shader-valid? (compile-shader (clip) (gpu (* color one))))
           (shader-valid? (compile-shader (gpu (* one (vec4 position zero one))) (gpu (* one color))))
           (shader-valid? (compile-shader (gpu (vec4 (* position position) zero one)) (gpu (* color color))))
           (shader-valid? (compile-shader (gpu (vec4 (* one (* position zero)) (* one one) one)) (gpu color)))
           (shader-valid? (compile-shader (gpu color) (gpu color)))))
    (define (invalid-compositions?)
      (and (not (shader-valid? (compile-shader (gpu (* position color)) (gpu color))))
           (not (shader-valid? (compile-shader (gpu (vec4 color zero one)) (gpu color))))
           (not (shader-valid? (compile-shader (gpu (vec4 position color one)) (gpu color))))
           (not (shader-valid? (compile-shader (gpu (* one one)) (gpu color))))
           (not (shader-valid? (compile-shader (clip) (gpu position))))
           (not (shader-valid? (compile-shader (clip) (gpu (* position zero)))))
           (not (shader-valid? (compile-shader (clip) (gpu (vec4 (* position zero) zero one)))))))
    (define (construction-matches?)
      (string=? (shader-text (compile-shader (clip) (gpu (* color one))))
                (shader-text (compile-shader (shader-vec4 (shader-position) (shader-zero) (shader-one))
                                             (shader-product (shader-color) (shader-one))))))
    (define answer
      (ann (lambda ()
             (if (and (valid-compositions?) (invalid-compositions?) (construction-matches?)) 1 0)) (-> I32)))))
