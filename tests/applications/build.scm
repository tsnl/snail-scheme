(import (scheme base) (scheme process-context) (scheme file) (scheme cxr) (scheme write)
        (chibi filesystem) (wasm-native process) (wasm-native chromium-trace) (lofi compiler bootstrap) (lofi source-driver)
        (only (lofi frontend) make-primitive-library) (only (lofi primitives) primitive-names))
(define args (cdr (command-line)))
(define root (car args))
(define source (cadr args))
(define output (caddr args))
(with-chromium-trace-to (string-append output ".trace.json") (lambda ()
                                                               (let-values (((key libraries)
                                                                             (collect-source-file source (list (path-join root "src") (path-join root "apps/siegework/src"))
                                                                                                  (list (cons '(lofi primitive) (make-primitive-library primitive-names)))
                                                                                                  (make-generation-context (path-join root "scripts/run-lofi-generator.mjs") #f))))
                                                                 (write-bytes output (artifact-bytes (compile libraries (make-entry key 'answer)))))))
