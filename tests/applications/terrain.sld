;; This fixture compiles the real terrain library and runs through Wasm.
(define-library (tests terrain)
  (export answer)
  (import (scheme base)
          (scheme immutable)
          (siegework terrain)
          (only (lofi core) ann -> I32))
  (begin

    ;; ---- Seed 1 preserves the published geography ----

    (define (original-ground? x y)
      (and (inside? x y)
           (not (and (>= x 23) (<= x 24) (< y 31) (or (< y 16) (> y 19))))
           (not (and (= y 10) (< x 19) (or (< x 10) (> x 13))))
           (not (and (>= x 32) (<= x 38) (>= y 25) (<= y 28)))))
    (define (original-rate x y)
      (cond ((and (= x 12) (= y 20)) 2)
            ((and (= x 5) (= y 5)) 3)
            ((and (= x 36) (= y 12)) 6)
            (else 0)))
    (define (original-cells? cell)
      (or (= cell (* map-width map-height))
          (let ((x (index-x cell)) (y (index-y cell)))
            (and (if (original-ground? x y) (ground? 1 x y) (not (ground? 1 x y)))
                 (= (original-rate x y) (deposit-rate 1 x y))
                 (original-cells? (+ cell 1))))))

    ;; ---- Saved seeds reproduce complete maps ----

    (define (fingerprint seed cell total)
      (if (= cell (* map-width map-height)) total
          (let* ((x (index-x cell)) (y (index-y cell))
                 (value (+ (if (ground? seed x y) 1 0) (* 10 (deposit-rate seed x y)))))
            (fingerprint seed (+ cell 1) (remainder (+ (* total 31) value) 65521)))))
    (define (stable-maps?)
      (and (= (fingerprint 1 0 0) 15568)
           (= (fingerprint 2 0 0) 61530)
           (= (fingerprint 3 0 0) 37630)
           (= (fingerprint 37 0 0) 29728)
           (= (fingerprint 249 0 0) 24256)
           (= (fingerprint 250 0 0) 48844)
           (= (fingerprint 251 0 0) 64377)
           (= (fingerprint 65535 0 0) 24758)))
    (define (seed-cycle?)
      (and (= (next-map-seed -1) 1) (= (next-map-seed 0) 1)
           (= (next-map-seed 1) 2) (= (next-map-seed 2) 3)
           (= (next-map-seed 65534) 65535) (= (next-map-seed 65535) 1)))

    ;; ---- All generated sites have useful walking routes ----

    (define all-surveys (list (make-survey 24 18 64)))
    (define (route-valid? seed x y a b surveys hazards path)
      (if (null? path) (and (= x a) (= y b))
          (let ((nx (index-x (car path))) (ny (index-y (car path))))
            (and (= (distance x y nx ny) 1) (ground? seed nx ny)
                 (surveyed? surveys nx ny) (not (surveyed? hazards nx ny))
                 (route-valid? seed nx ny a b surveys hazards (cdr path))))))
    (define (reachable? seed x y a b)
      (route-valid? seed x y a b all-surveys (empty-list)
                    (walking-path seed x y a b all-surveys #f)))
    (define (clear-row? seed x y)
      (or (= x 30) (and (ground? seed x y) (clear-row? seed (+ x 1) y))))
    (define (wide-crossing? seed y)
      (and (< y 29)
           (or (and (clear-row? seed 20 y)
                    (clear-row? seed 20 (+ y 1))
                    (clear-row? seed 20 (+ y 2)))
               (wide-crossing? seed (+ y 1)))))
    (define (viable-map? seed)
      (and (ground? seed hub-x hub-y) (= (deposit-rate seed 12 20) 2)
           (= (deposit-rate seed (northern-x seed) (northern-y seed)) 3)
           (= (deposit-rate seed (eastern-x seed) (eastern-y seed)) 6)
           (wide-crossing? seed 0)
           (reachable? seed hub-x hub-y 12 20)
           (reachable? seed hub-x hub-y (northern-x seed) (northern-y seed))
           (reachable? seed hub-x hub-y (eastern-x seed) (eastern-y seed))
           (reachable? seed 46 5 hub-x hub-y)
           (reachable? seed 46 32 hub-x hub-y)))
    (define (viable-seeds? seed step remaining)
      (or (= remaining 0)
          (and (viable-map? seed) (viable-seeds? (+ seed step) step (- remaining 1)))))

    ;; ---- Surveys and ephemeral hazards constrain the same search ----

    (define (path-length path)
      (if (null? path) 0 (+ 1 (path-length (cdr path)))))
    (define (avoids-circle?)
      (let* ((hazards (list (make-survey 10 22 1)))
             (path (avoiding-path 1 8 22 12 22 all-surveys hazards)))
        (and (= (path-length path) 8)
             (route-valid? 1 8 22 12 22 all-surveys hazards path))))
    (define (leaves-boundary?)
      (let* ((hazards (list (make-survey 9 22 1)))
             (path (avoiding-path 1 8 22 12 22 all-surveys hazards)))
        (and (not (null? path))
             (route-valid? 1 8 22 12 22 all-surveys hazards path))))
    (define (respects-hazards?)
      (and (avoids-circle?) (leaves-boundary?)
           (null? (avoiding-path 1 8 22 12 22 all-surveys (list (make-survey 8 22 1))))
           (null? (avoiding-path 1 8 22 12 22 all-surveys (list (make-survey 12 22 1))))
           (null? (avoiding-path 1 8 22 12 22 (empty-list) (empty-list)))))
    (define (respects-surveys?)
      (let ((local (list (make-survey hub-x hub-y 7))))
        (and (= (path-length (walking-path 1 hub-x hub-y 12 20 local #f)) 6)
             (null? (walking-path 1 hub-x hub-y 5 5 local #f))
             (not (null? (walking-path 1 hub-x hub-y 5 5 local #t))))))
    (define (rejects-endpoints?)
      (and (null? (walking-path 1 -1 22 12 20 all-surveys #t))
           (null? (walking-path 1 8 22 48 20 all-surveys #t))
           (null? (walking-path 1 8 22 23 0 all-surveys #t))
           (null? (walking-path 1 23 0 8 22 all-surveys #t))))

    ;; ---- Tests ----

    (define answer
      (ann (lambda ()
             (cond ((not (original-cells? 0)) -1)
                   ((not (stable-maps?)) -2)
                   ((not (seed-cycle?)) -3)
                   ((not (viable-seeds? 1 1 64)) -4)
                   ((not (viable-seeds? 1 509 129)) -5)
                   ((not (viable-map? 65535)) -6)
                   ((not (respects-surveys?)) -7)
                   ((not (respects-hazards?)) -8)
                   ((not (rejects-endpoints?)) -9)
                   (else 1)))
           (-> I32)))))
