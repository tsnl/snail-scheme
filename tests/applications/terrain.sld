;; This fixture compiles the real terrain library and runs through Wasm.
(define-library (tests terrain)
  (export answer)
  (import
   (scheme base)
   (scheme immutable)
   (siegework terrain)
   (only (lofi core) ann -> I32))
  (begin

    ;; ---- The starter neighborhood follows the randomized spawn ----

    (define (home-x x) (+ (- (spawn-x 1) hub-x) x))
    (define (home-y y) (+ (- (spawn-y 1) hub-y) y))
    (define (original-ground? x y)
      (and (not (and (>= x 23) (<= x 24) (< y 31) (or (< y 16) (> y 19))))
           (not (and (= y 10) (< x 19) (or (< x 10) (> x 13))))
           (not (and (>= x 32) (<= x 38) (>= y 25) (<= y 28)))))
    (define (original-rate x y)
      (cond ((and (= x 12) (= y 20)) 2)
            ((and (= x 5) (= y 5)) 3)
            ((and (= x 36) (= y 12)) 6)
            (else 0)))
    (define (cleared-front? x y front)
      (and (< front 3)
           (or (within? x y (front-x 1 front) (front-y 1 front) 10)
               (cleared-front? x y (+ front 1)))))
    (define (original-cells? cell)
      (or (= cell (* 48 36))
          (let* ((x (remainder cell 48)) (y (quotient cell 48)) (wx (home-x x)) (wy (home-y y)))
            (and (if (or (original-ground? x y) (cleared-front? wx wy 0)) (ground? 1 wx wy) (not (ground? 1 wx wy)))
                 (not (water? 1 wx wy)) (= (original-rate x y) (deposit-rate 1 wx wy))
                 (original-cells? (+ cell 1))))))

    ;; ---- Saved seeds reproduce the entire compact world ----

    (define (fingerprint seed cell total)
      (if (= cell (* map-width map-height)) total
          (let* ((x (index-x cell)) (y (index-y cell))
                 (kind (if (ground? seed x y) 1 (if (water? seed x y) 2 0)))
                 (value (+ kind (* 10 (deposit-rate seed x y)))))
            (fingerprint seed (+ cell 1) (remainder (+ (* total 31) value) 65521)))))
    (define (stable-maps?)
      (and (= (fingerprint 1 0 0) 11165)
           (= (fingerprint 2 0 0) 25115)
           (= (fingerprint 3 0 0) 49315)
           (= (fingerprint 37 0 0) 2066)
           (= (fingerprint 249 0 0) 38322)
           (= (fingerprint 250 0 0) 42873)
           (= (fingerprint 251 0 0) 44140)
           (= (fingerprint 65535 0 0) 45257)))
    (define (seed-cycle?)
      (and (= (next-map-seed -1) 1) (= (next-map-seed 0) 1)
           (= (next-map-seed 1) 2) (= (next-map-seed 2) 3)
           (= (next-map-seed 65534) 65535) (= (next-map-seed 65535) 1)))
    (define (fronts-separated? seed front other)
      (or (= other 3)
          (and (not (within? (front-x seed front) (front-y seed front) (front-x seed other) (front-y seed other) 50))
               (fronts-separated? seed front (+ other 1)))))
    (define (fronts-valid? seed front)
      (or (= front 3)
          (let ((x (front-x seed front)) (y (front-y seed front)))
            (and (within? (spawn-x seed) (spawn-y seed) x y 41)
                 (not (within? (spawn-x seed) (spawn-y seed) x y 31))
                 (>= x 15) (<= x (- map-width 16)) (>= y 15) (<= y (- map-height 16))
                 (= (deposit-rate seed x y) 0) (ground? seed x y)
                 (fronts-separated? seed front (+ front 1)) (fronts-valid? seed (+ front 1))))))
    (define (placements-valid? seed)
      (and (within? (spawn-x seed) (spawn-y seed) 64 64 8) (fronts-valid? seed 0)
           (= (deposit-capacity seed (+ (spawn-x seed) 4) (- (spawn-y seed) 2)) 600)
           (= (deposit-capacity seed (northern-x seed) (northern-y seed)) 900)
           (= (deposit-capacity seed (eastern-x seed) (eastern-y seed)) 1800)
           (ground? seed (eastern-x seed) (eastern-y seed))
           (ground? seed (spawn-x seed) (spawn-y seed))))
    (define (all-placements? seed)
      (or (> seed 65535) (and (placements-valid? seed) (all-placements? (+ seed 1)))))

    ;; ---- Full routes obey every tile and reach their actual endpoint ----

    (define all-surveys (list (make-survey 64 64 128)))
    (define (route-valid? seed x y a b surveys hazards path tunneling)
      (if (null? path) (and (= x a) (= y b))
          (let ((nx (index-x (car path))) (ny (index-y (car path))))
            (and (= (distance x y nx ny) 1) (inside? nx ny)
                 (if tunneling (not (water? seed nx ny)) (ground? seed nx ny))
                 (surveyed? surveys nx ny) (not (surveyed? hazards nx ny))
                 (route-valid? seed nx ny a b surveys hazards (cdr path) tunneling)))))
    (define (reachable? seed x y a b)
      (route-valid? seed x y a b all-surveys (empty-list)
                    (walking-path seed x y a b all-surveys #f) #f))
    (define (reachable-fronts? seed front)
      (or (= front 3)
          (and (reachable? seed (spawn-x seed) (spawn-y seed) (front-x seed front) (front-y seed front))
               (reachable-fronts? seed (+ front 1)))))
    (define (viable-map? seed)
      (let ((x (spawn-x seed)) (y (spawn-y seed)))
        (and (= (deposit-rate seed (+ x 4) (- y 2)) 2)
             (= (deposit-rate seed (northern-x seed) (northern-y seed)) 3)
             (= (deposit-rate seed (eastern-x seed) (eastern-y seed)) 6)
             (reachable? seed x y (+ x 4) (- y 2))
             (reachable? seed x y (northern-x seed) (northern-y seed))
             (reachable? seed x y (eastern-x seed) (eastern-y seed))
             (reachable-fronts? seed 0))))
    (define (viable-seeds? seed step remaining)
      (or (= remaining 0)
          (and (viable-map? seed) (viable-seeds? (+ seed step) step (- remaining 1)))))
    (define (distant-routes? seed)
      (and (reachable? seed 1 1 126 126) (reachable? seed 2 64 126 64)
           (route-valid? seed (nest-x seed) (nest-y seed) (spawn-x seed) (spawn-y seed)
                         all-surveys (empty-list)
                         (tunneling-path seed (nest-x seed) (nest-y seed) (spawn-x seed) (spawn-y seed)) #t)))
    (define (path-length path)
      (if (null? path) 0 (+ 1 (path-length (cdr path)))))

    ;; ---- Surveys and ephemeral hazards constrain the same search ----

    (define (home-survey x y radius) (make-survey (home-x x) (home-y y) radius))
    (define (avoids-circle?)
      (let* ((hazards (list (home-survey 10 22 1)))
             (path (avoiding-path 1 (home-x 8) (home-y 22) (home-x 12) (home-y 22) all-surveys hazards)))
        (and (= (path-length path) 8)
             (route-valid? 1 (home-x 8) (home-y 22) (home-x 12) (home-y 22) all-surveys hazards path #f))))
    (define (leaves-boundary?)
      (let* ((hazards (list (home-survey 9 22 1)))
             (path (avoiding-path 1 (home-x 8) (home-y 22) (home-x 12) (home-y 22) all-surveys hazards)))
        (and (not (null? path))
             (route-valid? 1 (home-x 8) (home-y 22) (home-x 12) (home-y 22) all-surveys hazards path #f))))
    (define (respects-hazards?)
      (and (avoids-circle?) (leaves-boundary?)
           (null? (avoiding-path 1 (home-x 8) (home-y 22) (home-x 12) (home-y 22)
                                 all-surveys (list (home-survey 8 22 1))))
           (null? (avoiding-path 1 (home-x 8) (home-y 22) (home-x 12) (home-y 22)
                                 all-surveys (list (home-survey 12 22 1))))))
    (define (respects-surveys?)
      (let ((local (list (home-survey 8 22 7))))
        (and (= (path-length (walking-path 1 (home-x 8) (home-y 22) (home-x 12) (home-y 20) local #f)) 6)
             (null? (walking-path 1 (home-x 8) (home-y 22) (home-x 5) (home-y 5) local #f))
             (not (null? (walking-path 1 (home-x 8) (home-y 22) (home-x 5) (home-y 5) local #t))))))
    (define (rejects-endpoints?)
      (and (null? (walking-path 1 -1 (home-y 22) (home-x 12) (home-y 20) all-surveys #t))
           (null? (walking-path 1 (home-x 8) (home-y 22) map-width (home-y 20) all-surveys #t))
           (null? (walking-path 1 (home-x 8) (home-y 22) (home-x 23) (home-y 0) all-surveys #t))
           (null? (walking-path 1 (home-x 23) (home-y 0) (home-x 8) (home-y 22) all-surveys #t))))
    (define (direct-fire?)
      (and (clear-shot? 1 (cell-x (home-x 12)) (cell-y (home-y 9)) (cell-x (home-x 12)) (cell-y (home-y 11)))
           (not (clear-shot? 1 (cell-x (home-x 6)) (cell-y (home-y 9)) (cell-x (home-x 6)) (cell-y (home-y 11))))
           (not (clear-shot? 1 (cell-x (home-x 9)) (cell-y (home-y 9)) (cell-x (home-x 10)) (cell-y (home-y 10))))
           (not (clear-shot? 1 (cell-x (home-x 10)) (cell-y (home-y 10)) (cell-x (home-x 9)) (cell-y (home-y 9))))
           (observed-shot? 1 all-surveys (cell-x (home-x 12)) (cell-y (home-y 9)) (cell-x (home-x 12)) (cell-y (home-y 11)))
           (not (observed-shot? 1 (list (home-survey 12 9 0))
                                (cell-x (home-x 12)) (cell-y (home-y 9)) (cell-x (home-x 12)) (cell-y (home-y 11))))))

    ;; ---- Water blocks both movement modes, while mountains permit tunnels ----

    (define (first-water seed cell)
      (cond ((= cell (* map-width map-height)) -1)
            ((water? seed (index-x cell) (index-y cell)) cell)
            (else (first-water seed (+ cell 1)))))
    (define (lake-routes? seed cell)
      (let* ((left (+ (* (quotient (index-x cell) 32) 32) 2))
             (row (+ (* (quotient (index-y cell) 32) 32) 16)) (right (+ left 28))
             (walk (walking-path seed left row right row all-surveys #f))
             (tunnel (tunneling-path seed left row right row)))
        (and (> (path-length walk) 28) (> (path-length tunnel) 28)
             (route-valid? seed left row right row all-surveys (empty-list) walk #f)
             (route-valid? seed left row right row all-surveys (empty-list) tunnel #t)
             (clear-shot? seed (cell-x left) (cell-y row) (cell-x right) (cell-y row)))))
    (define (water-restrictions? seed)
      (let ((cell (first-water seed 0)))
        (and (>= cell 0) (lake-routes? seed cell)
             (null? (walking-path seed (spawn-x seed) (spawn-y seed) (index-x cell) (index-y cell) all-surveys #t))
             (null? (tunneling-path seed (spawn-x seed) (spawn-y seed) (index-x cell) (index-y cell))))))
    (define (mountain-tunnel?)
      (let ((path (tunneling-path 1 (home-x 22) (home-y 0) (home-x 25) (home-y 0))))
        (and (= (path-length path) 3)
             (route-valid? 1 (home-x 22) (home-y 0) (home-x 25) (home-y 0) all-surveys (empty-list) path #t))))
    (define (permanent-breach?)
      (let* ((x (home-x 6)) (y (home-y 10)) (opened (list (cell-index x y)))
             (path (walking-open-path 1 opened x (- y 1) x (+ y 1) all-surveys #f)))
        (and (not (ground? 1 x y)) (open-ground? 1 opened x y)
             (= (path-length path) 2) (= (car path) (cell-index x y))
             (clear-open-shot? 1 opened (cell-x x) (cell-y (- y 1)) (cell-x x) (cell-y (+ y 1)))
             (= (path-length (avoiding-open-path 1 opened x (- y 1) x (+ y 1) all-surveys (empty-list))) 2)
             (not (null? (escape-open-path 1 opened x y all-surveys (list (make-survey x (+ y 1) 2))))))))
    (define (water-cannot-open?)
      (let* ((cell (first-water 1 0)) (opened (list cell)) (x (index-x cell)) (y (index-y cell)))
        (and (not (open-ground? 1 opened x y))
             (null? (walking-open-path 1 opened (spawn-x 1) (spawn-y 1) x y all-surveys #t)))))

    ;; ---- Search improvements, escape and bounded failure are observable ----

    ;; The eastern branch first discovers (9,24) at five steps. Reaching it
    ;; through the west takes three; updating that open cell yields 12, not 14.
    (define improvement-surveys
      (list (home-survey 8 22 0) (home-survey 9 22 0) (home-survey 10 22 0)
            (home-survey 8 23 0) (home-survey 10 23 0)
            (home-survey 8 24 0) (home-survey 9 24 0) (home-survey 10 24 0) (home-survey 14 24 0)
            (home-survey 9 25 0) (home-survey 14 25 0)
            (home-survey 9 26 0) (home-survey 10 26 0) (home-survey 11 26 0)
            (home-survey 12 26 0) (home-survey 13 26 0) (home-survey 14 26 0)))
    (define (improves-open-route?)
      (let ((path (walking-path 1 (home-x 8) (home-y 22) (home-x 14) (home-y 24) improvement-surveys #f)))
        (and (= (path-length path) 12)
             (route-valid? 1 (home-x 8) (home-y 22) (home-x 14) (home-y 24)
                           improvement-surveys (empty-list) path #f))))
    (define (escape-valid? x y hazards path)
      (if (null? path) (not (surveyed? hazards x y))
          (let ((nx (index-x (car path))) (ny (index-y (car path))))
            (and (= (distance x y nx ny) 1) (ground? 1 nx ny)
                 (not (and (= nx (home-x 9)) (= ny (home-y 22))))
                 (escape-valid? nx ny hazards (cdr path))))))
    (define (nearest-escape?)
      (let* ((hazards (list (home-survey 9 22 2)))
             (path (escape-path 1 (home-x 8) (home-y 22) all-surveys hazards)))
        (and (= (path-length path) 2) (escape-valid? (home-x 8) (home-y 22) hazards path))))
    (define (bounded-failure?)
      (null? (walking-path 1 96 96 2 2
                           (list (make-survey 96 96 32) (make-survey 2 2 0)) #f)))
    (define (cart-detour?)
      (let* ((a (cell-index (home-x 8) (home-y 22))) (b (+ a 1)) (c (+ a 2))
             (d (+ a map-width)) (e (+ d 1)) (f (+ d 2))
             (fast (list (make-cart-edge (rail-edge a d) 1) (make-cart-edge (rail-edge d e) 1)
                         (make-cart-edge (rail-edge e f) 1) (make-cart-edge (rail-edge f c) 1)))
             (path (cart-path 1 (empty-list) fast (index-x a) (index-y a) (index-x c) (index-y c) all-surveys (empty-list))))
        (and (= (path-length path) 4) (= (car path) d)
             (rail-step? fast a d) (rail-step? fast d a) (not (rail-step? fast a b))
             (= (path-length (cart-path 1 (empty-list) (empty-list) (index-x a) (index-y a)
                                        (index-x c) (index-y c) all-surveys (empty-list))) 2))))

    ;; ---- Tests ----

    (define answer
      (ann (lambda ()
             (cond ((not (and (= map-width 128) (= map-height 128) (original-cells? 0))) -1)
                   ((not (stable-maps?)) -2)
                   ((not (seed-cycle?)) -3)
                   ((not (all-placements? 1)) -4)
                   ((not (viable-seeds? 1 1 64)) -5)
                   ((not (viable-seeds? 1 509 129)) -6)
                   ((not (viable-map? 65535)) -7)
                   ((not (respects-surveys?)) -8)
                   ((not (respects-hazards?)) -9)
                   ((not (rejects-endpoints?)) -10)
                   ((not (direct-fire?)) -11)
                   ((not (and (distant-routes? 1) (distant-routes? 2) (distant-routes? 37) (distant-routes? 65535))) -12)
                   ((not (and (water-restrictions? 1) (water-restrictions? 37) (mountain-tunnel?))) -13)
                   ((not (improves-open-route?)) -14)
                   ((not (nearest-escape?)) -15)
                   ((not (bounded-failure?)) -16)
                   ((not (permanent-breach?)) -17)
                   ((not (water-cannot-open?)) -18)
                   ((not (cart-detour?)) -19)
                   (else 1)))
           (-> I32)))))
