(module
  (import "snail.core.support" "memory" (memory 0))
  (type $S (struct (field i64)))
  (type $P (struct (field (mut (ref null $S)))))
  (import "snail.core.support" "snail:gc/collect" (func $collect))
  (import "snail.core.support" "snail:gc/profile" (func $profile (param i32)))
  (import "snail.core.support" "snail:gc/profile-allocations" (func $allocations (result i64)))

  (func $dead-loop (param $n i32) (result i64)
    (local $i i32) (local $p (ref null $S)) (local $sum i64)
    (loop $again
      (local.set $p (struct.new $S (i64.extend_i32_u (local.get $i))))
      (call $collect)
      (local.set $sum (i64.add (local.get $sum) (struct.get $S 0 (local.get $p))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $again (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $sum))

  (func $overlap-loop (param $n i32) (result i64)
    (local $i i32) (local $p (ref null $S)) (local $old (ref null $S))
    (loop $again
      (local.set $p (struct.new $S (i64.extend_i32_u (local.get $i))))
      (call $collect)
      (if (i32.ne (local.get $i) (i32.const 0))
        (then
          (if (ref.eq (local.get $p) (local.get $old)) (then (unreachable)))
          (if (i64.ne (struct.get $S 0 (local.get $old))
                (i64.extend_i32_u (i32.sub (local.get $i) (i32.const 1))))
            (then (unreachable)))))
      (local.set $old (local.get $p))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $again (i32.lt_u (local.get $i) (local.get $n))))
    (struct.get $S 0 (local.get $old)))

  (func $container-loop (param $n i32) (result i64)
    (local $i i32) (local $sum i64) (local $p (ref null $S)) (local $holder (ref null $P))
    (local.set $holder (struct.new $P (ref.null $S)))
    (loop $again
      (local.set $p (struct.new $S (i64.extend_i32_u (local.get $i))))
      (if (i32.ne (local.get $i) (i32.const 0))
        (then
          (if (ref.eq (local.get $p) (struct.get $P 0 (local.get $holder))) (then (unreachable)))
          (if (i64.ne (struct.get $S 0 (struct.get $P 0 (local.get $holder)))
                (i64.extend_i32_u (i32.sub (local.get $i) (i32.const 1))))
            (then (unreachable)))))
      (struct.set $P 0 (local.get $holder) (local.get $p))
      (local.set $p (ref.null $S))
      (call $collect)
      (local.set $sum (i64.add (local.get $sum) (struct.get $S 0 (struct.get $P 0 (local.get $holder)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $again (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $sum))

  (func $main (export "main") (result i32)
    (call $profile (i32.const 1))
    (if (i64.ne (call $dead-loop (i32.const 100)) (i64.const 4950)) (then (unreachable)))
    (if (i64.ne (call $allocations) (i64.const 0)) (then (unreachable)))
    (if (i64.ne (call $overlap-loop (i32.const 100)) (i64.const 99)) (then (unreachable)))
    (if (i64.ne (call $allocations) (i64.const 100)) (then (unreachable)))
    (if (i64.ne (call $container-loop (i32.const 100)) (i64.const 4950)) (then (unreachable)))
    (if (i64.ne (call $allocations) (i64.const 200)) (then (unreachable)))
    (call $profile (i32.const 0))
    (i32.const 0)))
