;; Valid literals in constant arithmetic compile; executing the operation traps.
(def constant-arithmetic (-> I32 Unit)
     (lambda (mode)
       (begin (record (ann 1 I64))
              (if (= mode 0) (begin (+ 2147483647 1) (unit))
                  (if (= mode 1) (begin (* (ann -9223372036854775808 I64) (ann -1 I64)) (unit))
                      (if (= mode 2) (begin (* (ann 3.4028234663852886e38 F32) (ann 2.0 F32)) (unit))
                          (begin (* 1.7976931348623157e308 2.0) (unit)))))
              (record (ann 9 I64)))))
42
