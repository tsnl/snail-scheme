(import (sfir base))
(define-extern record "instance.probe" "record" (-> I64 Unit))

;; Arguments escape the guest in source order, including before a trap.
(def touch (All (T) (-> I64 T T)) (lambda (marker value) (begin (record marker) value)))
(def select-operation (All (T) (-> (Vector T) I32 T))
     (lambda (operations index) (begin (record (ann 3 I64)) (vector-ref operations (i32->i64 index)))))

;; ---- I32 calls through primitives, overloads and mutable function storage ----

(def i32-operations (vector i32-add i32-sub i32-mul i32-quotient i32-remainder))
(def direct-i32 (-> I32 I32 I32 I32)
     (lambda (operation left right)
       (if (= operation 0)
           (i32-add (touch (ann 1 I64) left) (touch (ann 2 I64) right))
           (if (= operation 1)
               (i32-sub (touch (ann 1 I64) left) (touch (ann 2 I64) right))
               (if (= operation 2)
                   (i32-mul (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                   (if (= operation 3)
                       (i32-quotient (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                       (if (= operation 4)
                           (i32-remainder (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                           (unreachable))))))))
(def overload-i32 (-> I32 I32 I32 I32)
     (lambda (operation left right)
       (if (= operation 0)
           (+ (touch (ann 1 I64) left) (touch (ann 2 I64) right))
           (if (= operation 1)
               (- (touch (ann 1 I64) left) (touch (ann 2 I64) right))
               (if (= operation 2)
                   (* (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                   (if (= operation 3)
                       (quotient (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                       (if (= operation 4)
                           (remainder (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                           (unreachable))))))))
(def calculate-i32 (-> I32 I32 I32 I32 I32)
     (lambda (route operation left right)
       (if (= route 0) (direct-i32 operation left right)
           (if (= route 1) (overload-i32 operation left right)
               ((select-operation i32-operations operation)
                (touch (ann 1 I64) left) (touch (ann 2 I64) right))))))
(def discard-i32 (-> Bool I32 I32 I32 I32 Unit)
     (lambda (selected route operation left right)
       (begin (if selected (begin (calculate-i32 route operation left right) (unit)) (unit))
              (record (ann 9 I64)))))

