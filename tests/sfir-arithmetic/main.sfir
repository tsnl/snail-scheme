;; ---- F32 calls through primitives, overloads and mutable function storage ----

(def f32-operations (vector f32-add f32-sub f32-mul f32-div))
(def direct-f32 (-> I32 F32 F32 F32)
     (lambda (operation left right)
       (if (= operation 0)
           (f32-add (touch (ann 1 I64) left) (touch (ann 2 I64) right))
           (if (= operation 1)
               (f32-sub (touch (ann 1 I64) left) (touch (ann 2 I64) right))
               (if (= operation 2)
                   (f32-mul (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                   (if (= operation 3)
                       (f32-div (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                       (unreachable)))))))
(def overload-f32 (-> I32 F32 F32 F32)
     (lambda (operation left right)
       (if (= operation 0)
           (+ (touch (ann 1 I64) left) (touch (ann 2 I64) right))
           (if (= operation 1)
               (- (touch (ann 1 I64) left) (touch (ann 2 I64) right))
               (if (= operation 2)
                   (* (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                   (if (= operation 3)
                       (/ (touch (ann 1 I64) left) (touch (ann 2 I64) right))
                       (unreachable)))))))
(def calculate-f32 (-> I32 I32 F32 F32 F32)
     (lambda (route operation left right)
       (if (= route 0) (direct-f32 operation left right)
           (if (= route 1) (overload-f32 operation left right)
               ((select-operation f32-operations operation)
                (touch (ann 1 I64) left) (touch (ann 2 I64) right))))))
(def discard-f32 (-> Bool I32 I32 F32 F32 Unit)
     (lambda (selected route operation left right)
       (begin (if selected (begin (calculate-f32 route operation left right) (unit)) (unit))
              (record (ann 9 I64)))))

