;; Numeric arrays use Wasm storage widths; reference arrays keep native pointers.
;; Both the direct datum lowering and the mandatory Binaryen path execute these.
(define native-array-storage-declarations
  '((type $storage-u8 (array (mut i8)))
    (type $storage-u16 (array (mut i16)))
    (type $storage-i32 (array (mut i32)))
    (type $storage-f32 (array (mut f32)))
    (type $storage-f64 (array (mut f64)))
    (type $storage-immutable (array i8))
    (global $empty-one (ref $storage-immutable) (array.new_default $storage-immutable (i32.const 0)))
    (global $empty-two (ref $storage-immutable) (array.new_default $storage-immutable (i32.const 0)))
    (global $static-u8 (ref $storage-u8)
            (array.new_fixed $storage-u8 3 (i32.const 255) (i32.const 4660) (i32.const 128)))
    (global $static-u16 (ref $storage-u16)
            (array.new_fixed $storage-u16 3 (i32.const 65535) (i32.const 74565) (i32.const 32768)))
    (global $static-i32 (ref $storage-i32)
            (array.new_fixed $storage-i32 3 (i32.const -1) (i32.const 42) (i32.const 2147483647)))
    (global $static-f32 (ref $storage-f32) (array.new_default $storage-f32 (i32.const 3)))
    ;; Non-default f32 constant expressions use ordinary module initialization.
    (global $global-f32-bits (ref $storage-f32)
            (array.new_fixed $storage-f32 2 (f32.const -0.0) (f32.const nan:0x412345)))
    (global $static-f64 (ref $storage-f64)
            (array.new_fixed $storage-f64 3 (f64.const -0.0) (f64.const 1.5)
                             (f64.const nan:0x8000000001234)))
    (global $static-refs (ref $refs) (array.new_default $refs (i32.const 3)))
    ;; Default integer payloads must stay numeric during static packing.
    (type $default-fields (struct (field i8) (field i16) (field i32)))
    (global $default-fields (ref $default-fields) (struct.new_default $default-fields))
    (global $default-u8 (ref $storage-u8) (array.new_default $storage-u8 (i32.const 3)))
    (global $default-u16 (ref $storage-u16) (array.new_default $storage-u16 (i32.const 3)))
    (global $default-i32 (ref $storage-i32) (array.new_default $storage-i32 (i32.const 3)))

    ;; ---- Dynamic fills and physical layout observations ----

    (func (export "storage-u8") (param $length i32) (param $value i32) (result eqref)
          (array.new $storage-u8 (local.get $value) (local.get $length)))
    (func (export "storage-u16") (param $length i32) (param $value i32) (result eqref)
          (array.new $storage-u16 (local.get $value) (local.get $length)))
    (func (export "storage-i32") (param $length i32) (param $value i32) (result eqref)
          (array.new $storage-i32 (local.get $value) (local.get $length)))
    (func (export "storage-f32") (param $length i32) (param $bits i32) (result eqref)
          (array.new $storage-f32 (f32.reinterpret_i32 (local.get $bits)) (local.get $length)))
    (func (export "storage-f64") (param $length i32) (param $bits i64) (result eqref)
          (array.new $storage-f64 (f64.reinterpret_i64 (local.get $bits)) (local.get $length)))
    (func (export "storage-static-u8") (result eqref) (global.get $static-u8))
    (func (export "storage-static-u16") (result eqref) (global.get $static-u16))
    (func (export "storage-static-i32") (result eqref) (global.get $static-i32))
    (func (export "storage-static-f32") (result eqref) (global.get $static-f32))
    (func (export "storage-static-f64") (result eqref) (global.get $static-f64))
    (func (export "storage-global-f32-bits") (result eqref) (global.get $global-f32-bits))
    (func (export "storage-identity") (result i32)
          (i32.and (ref.eq (global.get $empty-one) (global.get $empty-one))
                   (i32.eqz (ref.eq (global.get $empty-one) (global.get $empty-two)))))

    ;; Dynamic references keep access checks present through Binaryen. The host
    ;; also probes tagged native words; operand side effects precede each trap.
    (global $storage-order (mut i32) (i32.const 0))
    (func (export "storage-order") (result i32) (global.get $storage-order))
    (func (export "storage-access")
          (param $array (ref null $storage-u8)) (param $index i32) (param $operation i32) (result i32)
          (global.set $storage-order (i32.const 0))
          (if (result i32) (i32.eqz (local.get $operation))
              (then (array.len (local.get $array)))
              (else
               (if (result i32) (i32.eq (local.get $operation) (i32.const 1))
                   (then (array.get_u $storage-u8 (local.get $array)
                                      (block (result i32) (global.set $storage-order (i32.const 1))
                                             (local.get $index))))
                   (else
                    (array.set $storage-u8 (local.get $array)
                               (block (result i32) (global.set $storage-order (i32.const 1))
                                      (local.get $index))
                               (block (result i32) (global.set $storage-order (i32.const 2))
                                      (i32.const 42)))
                    (i32.const 42))))))

    ;; Earlier references exist only on the operand stack while later operands
    ;; allocate. Forced collection must retain them without a local or global alias.
    (func (export "storage-roots") (result i64)
          (struct.get $box 0 (ref.cast (ref $box)
                                       (array.get $refs
                                                  (array.new $refs (struct.new $box (i64.const 77) (ref.null eq))
                                                             (block (result i32)
                                                                    (drop (array.new_default $storage-u8 (i32.const 19)))
                                                                    (i32.const 3)))
                                                  (i32.const 2)))))

    ;; ---- Truncation, copies in both directions and static mutation ----

    (func (export "storage-check") (param $seed i32) (result i32)
          (local $a (ref $storage-u8)) (local $b (ref $storage-u16))
          (local $c (ref $storage-i32)) (local $d (ref $storage-f32))
          (local $e (ref $storage-f64))
          (if (struct.get_u $default-fields 0 (global.get $default-fields)) (then unreachable))
          (if (struct.get_u $default-fields 1 (global.get $default-fields)) (then unreachable))
          (if (struct.get $default-fields 2 (global.get $default-fields)) (then unreachable))
          (if (array.get_u $storage-u8 (global.get $default-u8) (i32.const 2)) (then unreachable))
          (if (array.get_u $storage-u16 (global.get $default-u16) (i32.const 2)) (then unreachable))
          (if (array.get $storage-i32 (global.get $default-i32) (i32.const 2)) (then unreachable))
          (local.set $a (array.new $storage-u8 (local.get $seed) (i32.const 4)))
          (array.set $storage-u8 (local.get $a) (i32.const 0) (i32.const 128))
          (array.set $storage-u8 (local.get $a) (i32.const 1) (i32.const 4660))
          (array.copy $storage-u8 $storage-u8 (local.get $a) (i32.const 1)
                      (local.get $a) (i32.const 0) (i32.const 3))
          (if (i32.ne (array.get_s $storage-u8 (local.get $a) (i32.const 1)) (i32.const -128))
              (then unreachable))
          (if (i32.ne (array.get_u $storage-u8 (local.get $a) (i32.const 2)) (i32.const 52))
              (then unreachable))
          (array.copy $storage-u8 $storage-u8 (local.get $a) (i32.const 0)
                      (local.get $a) (i32.const 1) (i32.const 3))
          (if (i32.ne (array.get_u $storage-u8 (local.get $a) (i32.const 2))
                      (i32.and (local.get $seed) (i32.const 255))) (then unreachable))
          (array.copy $storage-u8 $storage-u8 (local.get $a) (i32.const 4)
                      (local.get $a) (i32.const 4) (i32.const 0))
          (array.copy $storage-u8 $storage-u8 (global.get $static-u8) (i32.const 0)
                      (local.get $a) (i32.const 0) (i32.const 3))
          (if (i32.ne (array.get_u $storage-u8 (global.get $static-u8) (i32.const 1))
                      (i32.const 52)) (then unreachable))
          (local.set $b (array.new_fixed $storage-u16 3
                                         (local.get $seed) (i32.const 65535) (i32.const 74565)))
          (array.copy $storage-u16 $storage-u16 (local.get $b) (i32.const 0)
                      (local.get $b) (i32.const 1) (i32.const 2))
          (if (i32.ne (array.get_s $storage-u16 (local.get $b) (i32.const 0)) (i32.const -1))
              (then unreachable))
          (if (i32.ne (array.get_u $storage-u16 (local.get $b) (i32.const 1)) (i32.const 9029))
              (then unreachable))
          (array.set $storage-u16 (global.get $static-u16) (i32.const 2) (i32.const 65536))
          (if (array.get_u $storage-u16 (global.get $static-u16) (i32.const 2)) (then unreachable))
          (local.set $c (array.new $storage-i32 (local.get $seed) (i32.const 3)))
          (array.set $storage-i32 (local.get $c) (i32.const 1) (i32.const -1))
          (array.copy $storage-i32 $storage-i32 (local.get $c) (i32.const 2)
                      (local.get $c) (i32.const 1) (i32.const 1))
          (if (i32.ne (array.get $storage-i32 (local.get $c) (i32.const 2)) (i32.const -1))
              (then unreachable))
          (local.set $d (array.new $storage-f32 (f32.const 1.5) (i32.const 3)))
          (array.set $storage-f32 (local.get $d) (i32.const 1) (f32.const -0.0))
          (array.copy $storage-f32 $storage-f32 (global.get $static-f32) (i32.const 0)
                      (local.get $d) (i32.const 0) (i32.const 3))
          (if (i32.ne (i32.reinterpret_f32 (array.get $storage-f32 (global.get $static-f32) (i32.const 1)))
                      (i32.const -2147483648)) (then unreachable))
          (local.set $e (array.new_default $storage-f64 (i32.const 2)))
          (array.copy $storage-f64 $storage-f64 (local.get $e) (i32.const 0)
                      (global.get $static-f64) (i32.const 0) (i32.const 2))
          (if (i64.ne (i64.reinterpret_f64 (array.get $storage-f64 (local.get $e) (i32.const 0)))
                      (i64.const -9223372036854775808)) (then unreachable))
          ;; A mutable static reference array remains a permanent GC root.
          (array.set $refs (global.get $static-refs) (i32.const 1)
                     (struct.new $box (i64.const 42) (ref.null eq)))
          (drop (array.new_default $storage-u8 (i32.const 19)))
          (if (i64.ne (struct.get $box 0 (ref.cast (ref $box)
                                                   (array.get $refs (global.get $static-refs) (i32.const 1))))
                      (i64.const 42)) (then unreachable))
          (i32.const 1))

    ;; ---- Packed bounds and null traps, including zero-length copies ----

    (func (export "storage-trap") (param $kind i32)
          (if (i32.eqz (local.get $kind))
              (then (drop (array.get_u $storage-u8 (global.get $static-u8) (i32.const -1)))))
          (if (i32.eq (local.get $kind) (i32.const 1))
              (then (array.set $storage-u16 (global.get $static-u16) (i32.const 3) (i32.const 0))))
          (if (i32.eq (local.get $kind) (i32.const 2))
              (then (array.copy $storage-i32 $storage-i32
                                (global.get $static-i32) (i32.const 4)
                                (global.get $static-i32) (i32.const 0) (i32.const 0))))
          (if (i32.eq (local.get $kind) (i32.const 3))
              (then (array.copy $storage-u8 $storage-u8 (ref.null $storage-u8) (i32.const 0)
                                (global.get $static-u8) (i32.const 0) (i32.const 0))))
          (if (i32.eq (local.get $kind) (i32.const 4))
              (then (array.copy $storage-u16 $storage-u16 (global.get $static-u16) (i32.const 0)
                                (global.get $static-u16) (i32.const -1) (i32.const 2)))))))
