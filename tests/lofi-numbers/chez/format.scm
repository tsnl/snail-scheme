    (define (exponent-character? character) (or (char=? character #\e) (char=? character #\E)))
    (define (decimal-mantissa? text)
      (let ((dot (text-index text (lambda (character) (char=? character #\.)))))
        (if dot
            (let ((digits (string-append (substring text 0 dot)
                                         (substring text (+ dot 1) (string-length text)))))
              (unsigned-digits? digits 10))
