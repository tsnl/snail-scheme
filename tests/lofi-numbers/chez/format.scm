    (define (decimal-text? text)
      (let* ((text (without-sign text)) (exponent (text-index text exponent-character?)))
        (if exponent
            (and (decimal-mantissa? (substring text 0 exponent))
                 (signed-digits? (substring text (+ exponent 1) (string-length text)) 10))
            (and (text-index text (lambda (character) (char=? character #\.)))
                 (decimal-mantissa? text)))))
    (define (nonfinite-token text)
      (cond ((string-ci=? text "+inf.0") +inf.0) ((string-ci=? text "-inf.0") -inf.0)
            ((or (string-ci=? text "+nan.0") (string-ci=? text "-nan.0")) +nan.0)
            (else #f)))
    (define (parse-binary64 text)
      (or (nonfinite-token text) (and (decimal-text? text) (host-string->number text))))
    (define (decimal-scale exponent places)
      ;; Bound the exponent by the final scale before scanning. An exponent just
      ;; above I64_MAX can still fit after fractional places are subtracted. These
      ;; bounded host index intermediates never become Scheme numeric values.
      (let* ((negative (text-starts? exponent #\-))
             (limit (if negative (- 9223372036854775807 places) (+ 9223372036854775807 places)))
             (value (and (>= limit 0) (bounded-magnitude (without-sign exponent) 10 limit))))
        (if value (- (if negative (- value) value) places)
            (token-failure "exact decimal exponent exceeds supported allocation index range"))))
    (define (exact-decimal-parts text mantissa exponent)
      (let* ((dot (text-index mantissa (lambda (character) (char=? character #\.))))
             (digits (if dot (string-append (substring mantissa 0 dot)
                                            (substring mantissa (+ dot 1) (string-length mantissa))) mantissa))
             (places (if dot (- (string-length mantissa) dot 1) 0)))
        (cond ((not (unsigned-digits? digits 10)) (token-failure "nonfinite number has no exact value"))
              ((zero-digits? digits) (token-integer 0))
              (else (let ((scale (decimal-scale exponent places)))
                      (if (token-failure? scale) scale
                          (token-fraction (if (text-starts? text #\-) (string-append "-" digits) digits)
                                          "1" 10 scale #f)))))))
    (define (exact-decimal-token text)
      (let* ((unsigned (without-sign text)) (at (text-index unsigned exponent-character?)))
        (exact-decimal-parts text (if at (substring unsigned 0 at) unsigned)
                             (if at (substring unsigned (+ at 1) (string-length unsigned)) "0"))))
    (define (decimal-token text exactness)
