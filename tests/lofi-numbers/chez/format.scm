    (define (token-components first second radix exactness kind)
      (let ((left (real-token first radix exactness)))
        (if (token-failure? left) left
            (let ((right (real-token second radix exactness)))
              (cond ((token-failure? right) right) ((not (and left right)) #f)
                    ((eq? kind 'rectangular) (token-rectangular left right))
                    (else (token-polar left right (eq? exactness 'exact))))))))
    (define (rectangular-split body radix)
      (let loop ((at (- (string-length body) 1)))
        (and (> at 0)
             (if (and (memv (string-ref body at) '(#\+ #\-))
                      (not (and (= radix 10) (exponent-character? (string-ref body (- at 1))))))
                 at (loop (- at 1))))))
    (define (rectangular-token body radix exactness)
      (let* ((split (rectangular-split body radix))
             (real (if split (substring body 0 split) "0"))
             (imaginary (if split (substring body split (string-length body)) body)))
        (and (or (text-starts? imaginary #\+) (text-starts? imaginary #\-))
             (token-components real (if (= (string-length imaginary) 1)
                                        (string-append imaginary "1") imaginary)
                               radix exactness 'rectangular))))
    (define (prefixed-number-token fields)
      (let* ((text (vector-ref fields 0)) (radix (vector-ref fields 1)) (exactness (vector-ref fields 2))
             (size (string-length text)) (polar (text-index text (lambda (character) (char=? character #\@)))))
        (cond (polar (token-components (substring text 0 polar) (substring text (+ polar 1) size)
                                       radix exactness 'polar))
              ((and (> size 0) (char-ci=? (string-ref text (- size 1)) #\i))
               (rectangular-token (substring text 0 (- size 1)) radix exactness))
              (else (let ((value (real-token text radix exactness)))
                      (if (or (not value) (token-failure? value)) value (token-scalar value)))))))
    (define (number-token text radix)
      (and (memv radix '(2 8 10 16))
           (let ((prefixes (numeric-prefixes text radix)))
             (and prefixes (prefixed-number-token prefixes)))))

    ;; ---- Typed ABI projections expose only the requested scalar field ----

    (define (token-scalar-kind scalar)
      (match scalar ((token-integer value) 1) ((token-real value) 2)
             ((token-fraction numerator denominator radix scale inexact) (if inexact 6 5))))
    (define (token-number-kind number)
      (match number ((token-scalar value) (token-scalar-kind value))
             ((token-rectangular real imaginary) 3) ((token-polar radius angle exact) (if exact 8 7))))
    (define (token-component number part)
      (match number
        ((token-scalar value) (if (= part 0) value (error 'token "numeric component index out of range")))
        ((token-rectangular real imaginary)
         (case part ((0) real) ((1) imaginary) (else (error 'token "numeric component index out of range"))))
        ((token-polar radius angle exact)
         (case part ((0) radius) ((1) angle) (else (error 'token "numeric component index out of range"))))))
    (define (token-scalar-integer scalar)
      (unless (eq? (vector-ref scalar 0) 'token-integer)
        (error 'token "numeric component is not a machine integer"))
      (vector-ref scalar 1))
    (define (token-scalar-real scalar)
      (unless (eq? (vector-ref scalar 0) 'token-real)
        (error 'token "numeric component is not inexact"))
      (vector-ref scalar 1))
    (define (token-scalar-fraction scalar)
      (unless (eq? (vector-ref scalar 0) 'token-fraction)
        (error 'token "numeric component has no exact digit fields"))
      scalar)
    (define (token-scalar-text scalar term)
      (match (token-scalar-fraction scalar)
        ((token-fraction numerator denominator radix scale inexact)
         (case term ((0) numerator) ((1) denominator) (else (error 'token "exact numeric term index out of range"))))))
    (define (token-scalar-radix scalar)
      (match (token-scalar-fraction scalar) ((token-fraction numerator denominator radix scale inexact) radix)))
    (define (token-scalar-scale scalar)
      (match (token-scalar-fraction scalar) ((token-fraction numerator denominator radix scale inexact) scale)))

    ;; ---- Binary64 text uses a shortest decimal with Rust's display layout ----

    ;; The layout follows Rust Debug: exponent notation below 10^-4 and from 10^16,
    ;; with a decimal point for finite values rendered without an exponent. Chez's
    ;; choice of shortest digits must be compared byte for byte with the target,
    ;; including tie-sensitive values; round-trip equality alone is insufficient.
    (define (without-precision text)
      ;; Chez appends an R6RS precision suffix to subnormals, for example 5e-324|1.
      ;; It describes the binary64 value, not part of the decimal exponent.
      (let ((at (text-index text (lambda (character) (char=? character #\|)))))
        (if at (substring text 0 at) text)))
    (define (decimal-layout text)
      (let* ((negative (text-starts? text #\-)) (unsigned (without-sign text))
             (at (text-index unsigned exponent-character?))
             (mantissa (if at (substring unsigned 0 at) unsigned))
             (exponent (if at (host-string->number (substring unsigned (+ at 1) (string-length unsigned))) 0))
             (dot (text-index mantissa (lambda (character) (char=? character #\.))))
             (digits (if dot (string-append (substring mantissa 0 dot)
                                            (substring mantissa (+ dot 1) (string-length mantissa))) mantissa)))
        (vector negative digits (+ exponent (if dot dot (string-length mantissa))))))
    (define (trim-decimal-layout layout)
      (let* ((digits (vector-ref layout 1)) (count (string-length digits)))
        (let start ((first 0))
          (if (and (< first (- count 1)) (char=? (string-ref digits first) #\0)) (start (+ first 1))
              (let end ((last count))
                (if (and (> last (+ first 1)) (char=? (string-ref digits (- last 1)) #\0)) (end (- last 1))
                    (vector (vector-ref layout 0) (substring digits first last) (- (vector-ref layout 2) first))))))))
    (define (scientific-decimal digits point)
      (let ((exponent (- point 1)))
        (string-append (substring digits 0 1)
                       (if (= (string-length digits) 1) "" (string-append "." (substring digits 1 (string-length digits))))
                       "e" (if (>= exponent 0) "+" "") (host-number->string exponent))))
    (define (fixed-decimal digits point)
      (let ((count (string-length digits)))
        (cond ((<= point 0) (string-append "0." (make-string (- point) #\0) digits))
              ((>= point count) (string-append digits (make-string (- point count) #\0) ".0"))
              (else (string-append (substring digits 0 point) "." (substring digits point count))))))
    (define (binary64-text value)
      (cond ((nan? value) "+nan.0") ((= value +inf.0) "+inf.0") ((= value -inf.0) "-inf.0")
            ((= value 0.0) (if (eqv? value -0.0) "-0.0" "0.0"))
            (else (let* ((layout (trim-decimal-layout (decimal-layout (without-precision (host-number->string value)))))
                         (digits (vector-ref layout 1)) (point (vector-ref layout 2)))
                    (string-append (if (vector-ref layout 0) "-" "")
                                   (if (or (<= point -4) (> point 16)) (scientific-decimal digits point)
                                       (fixed-decimal digits point)))))))

    binary64-text))
(define case-arguments (vector "" ""))
(define case-output (open-output-string))
(define (argument-length index) (string-length (vector-ref case-arguments index)))
(define (argument-character index at) (string-ref (vector-ref case-arguments index) at))
(define (emit-character character) (write-char character case-output))
(define (float-from-bits bits)
  (let ((bytes (make-bytevector 8)))
    (bytevector-u64-native-set! bytes 0 bits) (bytevector-ieee-double-native-ref bytes 0)))
(define (float-bits value)
  (let ((bytes (make-bytevector 8)))
    (bytevector-ieee-double-native-set! bytes 0 value) (bytevector-u64-native-ref bytes 0)))

(call-with-input-file (cadr (command-line))
  (lambda (port)
    (let loop ()
      (let ((line (get-line port)))
        (unless (eof-object? line)
          (display (binary64-text (float-from-bits (string->number line 16)))) (newline) (loop))))))
