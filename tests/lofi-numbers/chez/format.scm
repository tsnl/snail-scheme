              (cond ((and (memv prefix '(#\e #\i)) (eq? exactness 'automatic))
                     (loop (+ at 2) radix seen-radix (if (char=? prefix #\e) 'exact 'inexact)))
                    ((and (memv prefix '(#\b #\o #\d #\x)) (not seen-radix))
                     (loop (+ at 2) (case prefix ((#\b) 2) ((#\o) 8) ((#\x) 16) (else 10)) #t exactness))
                    (else #f)))
