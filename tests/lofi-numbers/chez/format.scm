      (token-scalar (value TokenScalar))
      (token-rectangular (real TokenScalar) (imaginary TokenScalar))
      (token-polar (radius TokenScalar) (angle TokenScalar) (exact Bool)))
    (define-data TokenFailure (token-failure (message String token-failure-message)))
    (define (token-failure? value)
      (and (vector? value) (eq? (vector-ref value 0) 'token-failure)))
    (define (text-index text predicate)
      (let loop ((at 0))
        (and (< at (string-length text))
             (if (predicate (string-ref text at)) at (loop (+ at 1))))))
    (define (text-starts? text character)
      (and (> (string-length text) 0) (char=? (string-ref text 0) character)))
    (define (without-sign text)
