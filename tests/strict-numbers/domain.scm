(import (snail strict) (snail integer) (snail rational) (snail number) (snail datum))

;; ---- Scalar test transport and a checked complete token ----

(define-extern argument-length "oracle" "argument_length" (-> I32 I64))
(define-extern argument-character "oracle" "argument_character" (-> I32 I64 Char))
(define-extern emit-character "oracle" "emit_character" (-> Char Unit))
(define (argument index)
  (let* ((count (argument-length index)) (text (make-string count)))
    (let loop ((at 0))
      (if (= at count) text
          (begin (string-set! text at (argument-character index at)) (loop (+ at 1)))))))
(define (emit text)
  (let loop ((at 0))
    (unless (= at (string-length text))
      (emit-character (string-ref text at)) (loop (+ at 1)))))
(define (parsed text)
  (match (string->number text)
    ((parsed-number value) value)
    ((not-a-number) (unreachable)) ((number-error message) (unreachable))))

;; ---- The Number boundary uses its ordinary static operator families ----

(define (arithmetic operation left right)
  (if (= operation 1) (+ left right)
      (if (= operation 2) (- left right)
          (if (= operation 3) (* left right) (/ left right)))))
(define (projection operation value)
  (if (= operation 7) (truncate value)
      (if (= operation 9) (number-numerator value)
          (if (= operation 10) (number-denominator value)
              (if (= operation 11) (number-real-part value)
                  (if (= operation 12) (number-imag-part value)
                      (if (= operation 16) (number-negate value)
                          (if (= operation 17) (number-abs value)
                              (number-from-integer (number->integer value))))))))))
(define (domain-bits value)
  (+ (if (number-exact? value) 1 0)
     (+ (if (number-real? value) 2 0)
        (+ (if (number-rational? value) 4 0)
           (+ (if (number-integer? value) 8 0) (if (number-exact-integer? value) 16 0))))))
(define (comparison left right)
  (+ (if (= left right) 1 0)
     (+ (if (< left right) 2 0)
        (+ (if (<= left right) 4 0) (+ (if (> left right) 8 0) (if (>= left right) 16 0))))))
(define (radix-number operation)
  (let ((text (argument (ann 0 I32))) (base (integer->i64 (integer-from-string (argument (ann 1 I32))))))
    (if (= operation 19) (parsed-number-value (string->number text base))
        (number-from-integer (integer-from-string/radix text base)))))
(define (observed-number operation value)
  (if (= operation 5) (number-exact (inexact-number value))
      (if (>= operation 19) (radix-number operation)
          (let ((left (parsed (argument (ann 0 I32)))))
            (if (= operation 0) left
                (if (<= operation 4) (arithmetic operation left (parsed (argument (ann 1 I32))))
                    (projection operation left)))))))
(define (scalar-observation operation)
  (let ((left (parsed (argument (ann 0 I32)))))
    (if (= operation 6) (number->f64 (number-inexact left))
        (if (= operation 14) (i64->f64 (domain-bits left))
            (let ((right (parsed (argument (ann 1 I32)))))
              (if (= operation 13) (i64->f64 (comparison left right))
                  (if (number-equivalent? left right) 1.0 0.0)))))))
(: probe (-> I64 F64 F64))
(define (probe operation value)
  (if (or (= operation 6) (and (>= operation 13) (<= operation 15))) (scalar-observation operation)
      (let* ((number (observed-number operation value)) (text (number->string number)))
        (unless (number-equivalent? number (parsed text)) (unreachable))
        (emit text) 0.0)))
(unit)
