(import (sfir base))
(def Marker (typeclass ( T) (: mark (-> I64))))
(def sfir-migration-instance-1 (instance (Marker I32) (mark (lambda () 20))))
(def sfir-migration-instance-2 (instance (Marker F64) (mark (lambda () 22))))
;; The two methods have identical arrow shapes; their class arguments still
;; select distinct implementations.
(def mark-integer
  (inst mark I32))
(def mark-float
  (inst mark F64))
(+ (mark-integer) (mark-float))
