(import (sfir core))

;; ---- First-class operations retain the complete word contract ----

;; Load first-class operations through cells before applying signed words and
;; wrapped shift counts. Direct calls below exercise ordinary primitive use too.
(define mask-i32
  (ref i32-bitwise-and))
(define shift-i32
  (ref i32-shift-right/logical))
(define mask-i64
  (ref i64-bitwise-and))
(define shift-i64
  (ref i64-shift-right/logical))
(define xor-i32
  (ref i32-bitwise-xor))
(define xor-i64
  (ref i64-bitwise-xor))

(define test-i32
  (lambda ()
    (let ((mask (ref-get mask-i32)) (shift (ref-get shift-i32)) (xor (ref-get xor-i32)))
      (if (= (i32->i64 (mask -1 42)) 42)
          (if (= (i32->i64 (mask -2147483648 -1)) -2147483648)
              (if (= (i32->i64 (mask -1431655766 1431655765)) 0)
                  (if (= (i32->i64 (xor -1 1)) -2)
                      (if (= (i32->i64 (xor -2147483648 2147483647)) -1)
                          (if (= (i32->i64 (xor -1431655766 1431655765)) -1)
                              (if (= (i32->i64 (xor -2147483648 -2147483648)) 0)
                                  (if (= (i32->i64 (shift -1 1)) 2147483647)
                                      (if (= (i32->i64 (shift -2147483648 31)) 1)
                                          (if (= (i32->i64 (shift -1 0)) -1)
                                              (if (= (i32->i64 (shift -2147483648 32)) -2147483648)
                                                  (if (= (i32->i64 (shift -2147483648 33)) 1073741824)
                                                      (if (= (i32->i64 (shift -1 -1)) 1)
                                                          (if (= (i32->i64 (shift -1 -32)) -1)
                                                              (if (= (i32->i64 (shift -1 2147483647)) 1) (= (i32->i64 (shift -1 -2147483648)) -1) #f)
                                                              #f)
                                                          #f)
                                                      #f)
                                                  #f)
                                              #f)
                                          #f)
                                      #f)
                                  #f)
                              #f)
                          #f)
                      #f)
                  #f)
              #f)
          #f))))

(define test-i64
  (lambda ()
    (let ((mask (ref-get mask-i64)) (shift (ref-get shift-i64)) (xor (ref-get xor-i64)))
      (if (= (mask -1 42) 42)
          (if (= (mask -9223372036854775808 -1) -9223372036854775808)
              (if (= (mask -6148914691236517206 6148914691236517205) 0)
                  (if (= (xor -1 1) -2)
                      (if (= (xor 1 1099511627776) 1099511627777)
                          (if (= (xor -9223372036854775808 9223372036854775807) -1)
                              (if (= (xor -9223372036854775808 -9223372036854775808) 0)
                                  (if (= (shift -1 1) 9223372036854775807)
                                      (if (= (shift -9223372036854775808 63) 1)
                                          (if (= (shift -1 0) -1)
                                              (if (= (shift -9223372036854775808 64) -9223372036854775808)
                                                  (if (= (shift -9223372036854775808 65) 4611686018427387904)
                                                      (if (= (shift -1 -1) 1)
                                                          (if (= (shift -1 -64) -1)
                                                              (if (= (shift -1 9223372036854775807) 1) (= (shift -1 -9223372036854775808) -1) #f)
                                                              #f)
                                                          #f)
                                                      #f)
                                                  #f)
                                              #f)
                                          #f)
                                      #f)
                                  #f)
                              #f)
                          #f)
                      #f)
                  #f)
              #f)
          #f))))

(if (if (test-i32)
        (if (test-i64)
            (if (= (i32->i64 (i32-bitwise-and 255 15)) 15)
                (if (= (i32->i64 (i32-shift-right/logical 256 4)) 16)
                    (if (= (i32->i64 (i32-bitwise-xor 255 15)) 240)
                        (if (= (i64-bitwise-xor 1099511627776 1) 1099511627777)
                            (if (= (i64-bitwise-and 1152921503533105152 1073741823) 0)
                                (= (i64-shift-right/logical 1152921503533105152 30) 1073741823)
                                #f)
                            #f)
                        #f)
                    #f)
                #f)
            #f)
        #f)
    42
    (unreachable))
