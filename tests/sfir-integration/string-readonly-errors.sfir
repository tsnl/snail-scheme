(import (sfir base))
(def literal
     (ref (ann (ann "abc" Any) String)))
(def effects
     (ref (ann 0 I64)))
(def mark
     (lambda (digit value)
       (begin
         (ref-set! effects (+ (* (ref-get effects) (ann 10 I64)) digit))
         value)))

(def set-literal (-> Unit)
     (lambda ()
       (begin
         (ref-set! effects (ann 0 I64))
         (string-set! (mark (ann 1 I64) (ref-get literal)) (mark (ann 2 I64) (ann 0 I64)) (mark (ann 3 I64) #\Z)))))

(def set-effects (-> I64)
     (lambda () (ref-get effects)))

(def copy-literal (-> Unit)
     (lambda ()
       (begin
         (ref-set! effects (ann 0 I64))
         (string-copy! (mark (ann 1 I64) (ref-get literal)) (mark (ann 2 I64) (ann 0 I64)) (mark (ann 3 I64) "Z") (mark (ann 4 I64) (ann 0 I64)) (mark (ann 5 I64) (ann 1 I64))))))

(def copy-effects (-> I64)
     (lambda () (ref-get effects)))

(def empty-literal-copy (-> Unit)
     (lambda () (string-copy! "" (ann 0 I64) "" (ann 0 I64) (ann 0 I64))))

(def literal-endpoint-copy (-> Unit)
     (lambda () (string-copy! (ref-get literal) (ann 3 I64) "" (ann 0 I64) (ann 0 I64))))

(def unchanged (-> Bool)
     (lambda () (string=? (ref-get literal) "abc")))
(ann 42 I64)
