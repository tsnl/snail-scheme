(import (sfir base) (sfir bytes))
(def same-bytes?
     (lambda (left right)
       (if (= (bytevector-length left) (bytevector-length right))
           (begin
             (def loop
                  (lambda (index)
                    (if (= index (bytevector-length left))
                        #t
                        (if (= (bytevector-u8-ref left index) (bytevector-u8-ref right index))
                            (loop (+ index (ann 1 I64)))
                            #f))))
             (loop (ann 0 I64)))
           #f)))
(def source
     (bytevector (ann 0 I64) (ann 127 I64) (ann 128 I64) (ann 255 I64)))
(def alias
     (ann (ann source Any) Bytevector))
(def copied
     (bytevector-copy source))
(def joined
     (bytevector-append #u8() source #u8(42)))
(def one
     (bytevector-append source))
(def empty
     (make-bytevector (ann 0 I64)))
(def overlap
     (bytevector (ann 1 I64) (ann 2 I64) (ann 3 I64) (ann 4 I64) (ann 5 I64)))
(bytevector-u8-set! alias (ann 0 I64) (ann 254 I64))
(bytevector-copy! overlap (ann 1 I64) overlap (ann 0 I64) (ann 4 I64))
(def right-correct
     (same-bytes? overlap #u8(1 1 2 3 4)))
(bytevector-copy! overlap (ann 0 I64) overlap (ann 1 I64) (ann 5 I64))
(def left-correct
     (same-bytes? overlap #u8(1 2 3 4 4)))
(bytevector-copy! overlap (ann 5 I64) overlap (ann 5 I64) (ann 5 I64))
(def by-procedure
     bytevector-u8-ref)
(if (if (bytevector-eq? source alias)
        (if (= (by-procedure source (ann 0 I64)) (ann 254 I64))
            (if (same-bytes? copied #u8(0 127 128 255))
                (if (same-bytes? joined #u8(0 127 128 255 42))
                    (if (same-bytes? one copied)
                        (if (not (bytevector-eq? one copied))
                            (if (same-bytes? (bytevector-copy copied (ann 1 I64) (ann 3 I64)) #u8(127 128))
                                (if (same-bytes? (bytevector-copy copied (ann 2 I64)) #u8(128 255))
                                    (if (same-bytes? (make-bytevector (ann 3 I64) (ann 255 I64)) #u8(255 255 255))
                                        (if (same-bytes? (make-bytevector (ann 2 I64)) #u8(0 0))
                                            (if (not (bytevector-eq? empty (bytevector-copy empty)))
                                                (if (not (bytevector-eq? (bytevector) (bytevector)))
                                                    (if (not (bytevector-eq? (bytevector-append) empty))
                                                        (if right-correct left-correct #f)
                                                        #f)
                                                    #f)
                                                #f)
                                            #f)
                                        #f)
                                    #f)
                                #f)
                            #f)
                        #f)
                    #f)
                #f)
            #f)
        #f)
    (ann 42 I64)
    (unreachable))
