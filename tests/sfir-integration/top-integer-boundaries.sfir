(import (sfir core))

(define round-trip (-> I64 I64)
  (lambda (n) (ann (ann n Top) I64)))
(if (if (= (round-trip -9223372036854775808) -9223372036854775808)
        (if (= (round-trip -1073741825) -1073741825)
            (if (= (round-trip -1073741824) -1073741824)
                (if (= (round-trip -1) -1)
                    (if (= (round-trip 1073741823) 1073741823)
                        (if (= (round-trip 1073741824) 1073741824)
                            (= (round-trip 9223372036854775807) 9223372036854775807)
                            #f)
                        #f)
                    #f)
                #f)
            #f)
        #f)
    42
    0)
