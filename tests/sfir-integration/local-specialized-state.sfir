(import (sfir base))
(def exercise
     (lambda (seed)
       (begin (let cell (ref seed))
              (begin (let counted (lambda (x)
                                    (begin (ref-set! cell (+ (ref-get cell) 1)) x)))
                     (begin
                       (counted 42)
                       (counted #t)
                       (ref-get cell))))))
(exercise 40)
