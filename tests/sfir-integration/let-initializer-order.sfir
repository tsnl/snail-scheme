(import (sfir base))
(def cell
     (ref 0))
(def record
     (lambda (digit)
       (begin
         (ref-set! cell (+ (* (ref-get cell) 10) digit))
         digit)))
(begin (let sfir-migration-let-1 (record 4)) (let sfir-migration-let-2 (record 2))
       (let first sfir-migration-let-1)
       (let second sfir-migration-let-2)
       (ref-get cell))
