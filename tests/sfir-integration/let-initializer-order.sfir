(import (sfir base))
(def cell
     (ref (ann 0 I64)))
(def record
     (lambda (digit)
       (begin
         (ref-set! cell (+ (* (ref-get cell) (ann 10 I64)) digit))
         digit)))
(begin (let sfir-migration-let-1 (record (ann 4 I64))) (let sfir-migration-let-2 (record (ann 2 I64)))
       (let first sfir-migration-let-1)
       (let second sfir-migration-let-2)
       (ref-get cell))
