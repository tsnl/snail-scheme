(import (sfir base))
(def calls
     (ref 0))
(def sfir-migration-instance-1 (instance (Default (Ref I64))
                                         (default (lambda ()
                                                    (begin
                                                      (ref-set! calls (+ (ref-get calls) 1))
                                                      (ref (ref-get calls)))))))
(def empty
     (ann (make-vector 0) (Vector (Ref I64))))
(def values
     (make-vector 3))
(ref-set! (vector-ref values 0) 42)
(if (if (= (ref-get calls) 3)
        (if (= (vector-length empty) 0)
            (if (= (ref-get (vector-ref values 0)) 42)
                (if (= (ref-get (vector-ref values 1)) 2)
                    (if (= (ref-get (vector-ref values 2)) 3)
                        (not (ref-eq? (vector-ref values 0) (vector-ref values 1)))
                        #f)
                    #f)
                #f)
            #f)
        #f)
    42
    (unreachable))
