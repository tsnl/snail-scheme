(import (sfir base))
(def calls
     (ref (ann 0 I64)))
(def sfir-migration-instance-1 (instance (Default (Ref I64))
                                         (default (lambda ()
                                                    (begin
                                                      (ref-set! calls (+ (ref-get calls) (ann 1 I64)))
                                                      (ref (ref-get calls)))))))
(def empty
     (ann (make-vector (ann 0 I64)) (Vector (Ref I64))))
(def values
     (make-vector (ann 3 I64)))
(ref-set! (vector-ref values (ann 0 I64)) (ann 42 I64))
(if (if (= (ref-get calls) (ann 3 I64))
        (if (= (vector-length empty) (ann 0 I64))
            (if (= (ref-get (vector-ref values (ann 0 I64))) (ann 42 I64))
                (if (= (ref-get (vector-ref values (ann 1 I64))) (ann 2 I64))
                    (if (= (ref-get (vector-ref values (ann 2 I64))) (ann 3 I64))
                        (not (ref-eq? (vector-ref values (ann 0 I64)) (vector-ref values (ann 1 I64))))
                        #f)
                    #f)
                #f)
            #f)
        #f)
    (ann 42 I64)
    (unreachable))
