(import (sfir core))

(define digits
  (ref 0))
(define record
  (lambda (digit)
    (begin
      (ref-set! digits (+ (* 10 (ref-get digits)) digit))
      digit)))
(define answer
  ((let ((left (record 3)) (right (record 4)))
     (begin
       (define middle
         (record 5))
       (define finish
         (lambda (first second)
           (begin
             (record 7)
             (+ (+ first second) (+ (+ left right) middle)))))
       (record 6)
       finish))
   (record 1) (record 2)))

(if (if (= answer 15) (= (ref-get digits) 1234567) #f) 42 0)
