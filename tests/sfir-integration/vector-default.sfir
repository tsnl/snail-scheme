(import (sfir base))
(def values
  (make-vector 3))
(vector-set! values 1 42)
(def floats
  (ann (make-vector 2) (Vector F64)))
(def empty
  (ann (make-vector 0) (Vector Bool)))

(def build (All (T) (=> ((Default T)) (-> I64 (Vector T))))
  (lambda (count) (make-vector count)))
(if (if (= (vector-ref values 0) 0)
        (if (= (vector-ref values 1) 42)
            (if (= (vector-ref values 2) 0)
                (if (= (vector-ref floats 0) 0.0)
                    (if (= (vector-length empty) 0) (not (vector-ref (ann (build 1) (Vector Bool)) 0)) #f)
                    #f)
                #f)
            #f)
        #f)
    42
    (unreachable))
