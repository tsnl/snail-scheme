(import (sfir base))
(def source
     (string #\A #\null #\é #\x1f600))
(def copied
     (string-copy source))
(def middle
     (substring source (ann 1 I64) (ann 3 I64)))
(def joined
     (string-append "" "[" source "]" ""))
(def one
     (string-append source))
(def empty
     (string-append))
(def chars
     (string->list source))
(string-set! source (ann 0 I64) #\Z)
(if (if (string=? copied "A\x0;é😀")
        (if (string=? (list->string chars) copied)
            (if (string=? middle "\x0;é")
                (if (string=? joined "[A\x0;é😀]")
                    (if (string=? one copied)
                        (if (not (string-eq? one copied))
                            (if (not (string-eq? (string-copy empty) empty))
                                (if (not (string-eq? (substring source (ann 4 I64) (ann 4 I64)) empty))
                                    (if (not (string-eq? (string) (string)))
                                        (if (string=? (list->string (empty-list )) "")
                                            (if (string=? (make-string (ann 2 I64)) "\x0;\x0;")
                                                (if (string=? (make-string (ann 3 I64) #\λ) "λλλ")
                                                    (if (not (string=? "ab" "ac")) (not (string=? "a" "ab")) #f)
                                                    #f)
                                                #f)
                                            #f)
                                        #f)
                                    #f)
                                #f)
                            #f)
                        #f)
                    #f)
                #f)
            #f)
        #f)
    (ann 42 I64)
    (unreachable))
