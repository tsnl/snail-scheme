(import (sfir base))
(def count
     (ref (ann 0 I64)))
(define-overload add-two (-> I64 I64) implementation)
(def implementation
     (begin (ref-set! count (+ (ref-get count) (ann 1 I64)))
            (lambda (value) (i64-add value (ann 2 I64)))))
(def first
     (add-two (ann 38 I64)))
(def second
     (add-two first))
(if (= (ref-get count) (ann 1 I64)) second (unreachable))
