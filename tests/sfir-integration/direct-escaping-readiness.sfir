(import (sfir base))

(def state
     (ref 0))
(def make-probe
     (lambda (early?)
       (begin
         (def probe
              (lambda ()
                (begin
                  (ref-set! state (+ 1 (ref-get state)))
                  (later))))
         (def early
              (if early? (probe) 0))
         (def later
              (lambda () (vector-ref payload 0)))
         (def payload
              (make-vector 1 42))
         probe)))
(def saved
     (make-probe #f))

(def checked (-> I64)
     (lambda () ((make-probe #t))))

(def before (-> I64)
     (lambda () (ref-get state)))

(def after (-> I64)
     (lambda () (saved)))

(def observed (-> I64)
     (lambda () (ref-get state)))

42
