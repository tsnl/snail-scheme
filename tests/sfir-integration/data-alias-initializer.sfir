(import (sfir base))
(def calls
     (ref (ann 0 I64)))
(def Box (datatype ( T) (box (value T unbox))))
(def make
     (begin (ref-set! calls (+ (ref-get calls) (ann 1 I64))) box))
(def first
     (make (ann 40 I64)))
(def second
     (make (+ (unbox first) (ann 2 I64))))
(if (= (ref-get calls) (ann 1 I64)) (unbox second) (unreachable))
