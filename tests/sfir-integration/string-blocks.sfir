(import (sfir base))

;; ---- Independent scalar oracle ----

(def pattern-character
  (lambda (index)
    (begin (let choice (remainder index 5))
      (if (= choice 0)
          #\null
          (if (= choice 1) #\é (if (= choice 2) #\x1f600 (if (= choice 3) #\x10ffff #\x301)))))))
(def pattern-string
  (lambda (length)
    (begin (let value (make-string length))
      (begin
        (begin
          (def loop
            (lambda (index)
              (if (= index length)
                  (unit)
                  (begin
                    (string-set! value index (pattern-character index))
                    (loop (+ index 1))
                    (unit)))))
          (loop 0))
        value))))
(def copied-range?
  (lambda (length at start end)
    (begin (let value (pattern-string length))
      (begin (let before (string-copy value))
        (begin (let expected (string-copy value))
          (begin
            (begin
              (def loop
                (lambda (index)
                  (if (= index end)
                      (unit)
                      (begin
                        (string-set! expected (+ at (- index start)) (string-ref before index))
                        (loop (+ index 1))
                        (unit)))))
              (loop start))
            (string-copy! value at value start end)
            (string=? value expected)))))))

;; ---- Fresh buffers, aliases and block-edge overlap ----

(def original
  (pattern-string 16385))
(def alias
  original)
(def copied
  (string-copy original))
(def middle
  (substring original 8191 16385))
(def joined
  (string-append "[" original "]"))
(string-set! alias 8192 #\Z)
(if (if (string-eq? alias original)
        (if (not (string-eq? copied original))
            (if (char=? (string-ref original 8192) #\Z)
                (if (char=? (string-ref copied 8192) (pattern-character 8192))
                    (if (char=? (string-ref middle 1) (pattern-character 8192))
                        (if (char=? (string-ref joined 8193) (pattern-character 8192))
                            (if (char=? (string-ref copied 16384) (pattern-character 16384))
                                (if (copied-range? 0 0 0 0)
                                    (if (copied-range? 1 0 0 1)
                                        (if (copied-range? 8191 1 0 8190)
                                            (if (copied-range? 8192 0 1 8192)
                                                (if (copied-range? 8193 1 0 8192)
                                                    (if (copied-range? 16384 1 0 16383)
                                                        (if (copied-range? 16384 0 1 16384)
                                                            (if (copied-range? 16385 8190 8188 16381)
                                                                (if (copied-range? 24579 8191 8189 16393)
                                                                    (if (copied-range? 24579 0 8190 24579)
                                                                        (if (copied-range? 24579 16387 0 8192)
                                                                            (if (copied-range? 32801 123 8159 25000)
                                                                                (if (copied-range? 24576 0 0 24576) (copied-range? 24579 24579 24579 24579) #f)
                                                                                #f)
                                                                            #f)
                                                                        #f)
                                                                    #f)
                                                                #f)
                                                            #f)
                                                        #f)
                                                    #f)
                                                #f)
                                            #f)
                                        #f)
                                    #f)
                                #f)
                            #f)
                        #f)
                    #f)
                #f)
            #f)
        #f)
    42
    (unreachable))
