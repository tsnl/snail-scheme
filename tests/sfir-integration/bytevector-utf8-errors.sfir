(import (sfir core) (sfir bytes))

(define isolated-tail (-> I64)
  (lambda () (string-length (utf8->string #u8(128)))))

(define invalid-lead (-> I64)
  (lambda () (string-length (utf8->string #u8(255)))))

(define truncated-two (-> I64)
  (lambda () (string-length (utf8->string #u8(194)))))

(define truncated-three (-> I64)
  (lambda () (string-length (utf8->string #u8(224 160)))))

(define truncated-four (-> I64)
  (lambda () (string-length (utf8->string #u8(240 144 128)))))

(define bad-tail (-> I64)
  (lambda () (string-length (utf8->string #u8(224 65 128)))))

(define overlong-two (-> I64)
  (lambda () (string-length (utf8->string #u8(192 128)))))

(define overlong-three (-> I64)
  (lambda () (string-length (utf8->string #u8(224 159 191)))))

(define overlong-four (-> I64)
  (lambda () (string-length (utf8->string #u8(240 143 191 191)))))

(define surrogate (-> I64)
  (lambda () (string-length (utf8->string #u8(237 160 128)))))

(define too-large (-> I64)
  (lambda () (string-length (utf8->string #u8(244 144 128 128)))))

(define cut-start (-> I64)
  (lambda () (string-length (utf8->string #u8(195 169) 1))))

(define cut-end (-> I64)
  (lambda () (string-length (utf8->string #u8(195 169) 0 1))))

(define negative-start (-> I64)
  (lambda () (string-length (utf8->string #u8() -1 0))))

(define past-end (-> I64)
  (lambda () (string-length (utf8->string #u8() 1 1))))

(define reversed (-> I64)
  (lambda () (string-length (utf8->string #u8(65) 1 0))))

(define encode-range (-> I64)
  (lambda () (bytevector-length (string->utf8 "A" 0 2))))

(define encode-negative (-> I64)
  (lambda () (bytevector-length (string->utf8 "A" -1 0))))
42
