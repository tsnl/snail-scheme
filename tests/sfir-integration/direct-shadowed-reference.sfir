(import (sfir base))

(def exercise
     (lambda (seed)
       (begin
         (def cell
              (ref seed))
         (def left
              (lambda (n)
                (begin
                  (def step
                       (lambda ()
                         (begin
                           (ref-set! cell (+ (ref-get cell) (ann 1 I64)))
                           (right n))))
                  (step))))
         (def right
              (lambda (n) (+ n (ref-get cell))))
         (begin (let cell (ref (ann 0 I64))) (+ (left (ann 1 I64)) (ref-get cell))))))

(exercise (ann 40 I64))
