(import (sfir base))

(def effects
  (ref 0))

(def checked (-> I64)
  (lambda ()
    (begin
      (def read-later
        (lambda ()
          (begin
            (ref-set! effects (+ (ref-get effects) 1))
            later)))
      (def invoke
        read-later)
      (def early
        (invoke))
      (def later
        42)
      early)))

(def observed (-> I64)
  (lambda () (ref-get effects)))
42
