(import (sfir core))

(define effects
  (ref 0))

(define checked (-> I64)
  (lambda ()
    (begin
      (define read-later
        (lambda ()
          (begin
            (ref-set! effects (+ (ref-get effects) 1))
            later)))
      (define invoke
        read-later)
      (define early
        (invoke))
      (define later
        42)
      early)))

(define observed (-> I64)
  (lambda () (ref-get effects)))
42
