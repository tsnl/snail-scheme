(import (sfir core))

(define state
  (ref 0))

(define calls (-> I64)
  (lambda () (ref-get state)))

(define after-forward (-> I64)
  (lambda () (ref-get state)))

(define checked (-> Unit)
  (lambda ()
    (begin
      (ref-set! state 1)
      (ann (ann 42 Top) Unit)
      (unit))))

(define forward (-> Unit)
  (lambda ()
    (begin
      (define early
        (begin (ref-set! state 2) later (unit)))
      (define later
        (unit))
      early
      (unit))))

42
