(import (sfir base))

(def exercise
     (lambda ()
       (begin
         (def count
              (ref 0))
         (def loop (-> I64 Unit)
              (lambda (remaining)
                (begin
                  (if (> remaining 0)
                      (begin
                        ((begin (let next (- remaining 1))
                                (begin
                                  (def repeat
                                       (lambda ()
                                         (begin
                                           (ref-set! count (+ (ref-get count) 1))
                                           ((begin loop) next))))
                                  repeat)))
                        (unit))
                      (unit))
                  (unit))))
         (def add-first (-> I64 (Rest I64) I64)
              (lambda (first . remaining) (+ first (car remaining))))
         (loop 100000)
         (begin
           (def again
                (lambda (remaining)
                  (if (= remaining 0)
                      (if (= (ref-get count) 100000) ((begin add-first) 40 2 99) 0)
                      ((begin again) (- remaining 1)))))
           (again 100000)))))

(exercise)
