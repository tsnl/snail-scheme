;; Canonical paraffins control flow, partitions and accumulation order from
;; r7rs-benchmarks 85f6acdc4cc4e2b857f307ba56bd0ba931dcccd1. Tagged H/C and
;; BCP/CCP vectors become closed immutable variants; numeric partition vectors
;; and the two-list result retain their original homogeneous representation.
(import (sfir base))
(def Radical (datatype () (H) (C (first Radical) (second Radical) (third Radical))))
(def Paraffin (datatype ()
                        (BCP (first Radical) (second Radical))
                        (CCP (first Radical) (second Radical) (third Radical) (fourth Radical))))
(def max
     (lambda (a b) (if (> a b) a b)))
(def list-length
     (lambda (xs) (if (null? xs) (ann 0 I64) (+ (ann 1 I64) (list-length (cdr xs))))))
(def gen
     (lambda (n)
       (begin (let n/2 (quotient n (ann 2 I64)))
              (begin (let radicals (make-vector (+ n/2 (ann 1 I64)) (cons (H) (empty-list ))))
                     (begin

                       (def rads-of-size
                            (lambda (n)
                              (begin
                                (def loop1
                                     (lambda (ps lst)
                                       (if (null? ps)
                                           lst
                                           (begin (let p (car ps))
                                                  (begin (let nc1 (vector-ref p (ann 0 I64)))
                                                         (begin (let nc2 (vector-ref p (ann 1 I64)))
                                                                (begin (let nc3 (vector-ref p (ann 2 I64)))
                                                                       (begin
                                                                         (def loop2
                                                                              (lambda (rads1 lst)
                                                                                (if (null? rads1)
                                                                                    lst
                                                                                    (begin
                                                                                      (def loop3
                                                                                           (lambda (rads2 lst)
                                                                                             (if (null? rads2)
                                                                                                 lst
                                                                                                 (begin
                                                                                                   (def loop4
                                                                                                        (lambda (rads3 lst)
                                                                                                          (if (null? rads3)
                                                                                                              lst
                                                                                                              (cons (C
                                                                                                                     (car rads1)
                                                                                                                     (car rads2)
                                                                                                                     (car rads3))
                                                                                                                    (loop4 (cdr rads3)
                                                                                                                           lst)))))
                                                                                                   (loop4 (if (= nc2 nc3) rads2 (vector-ref radicals nc3)) (loop3 (cdr rads2)
                                                                                                                                                                  lst))))))
                                                                                      (loop3 (if (= nc1 nc2) rads1 (vector-ref radicals nc2)) (loop2 (cdr rads1)
                                                                                                                                                     lst))))))
                                                                         (loop2 (vector-ref radicals nc1) (loop1 (cdr ps)
                                                                                                                 lst))))))))))
                                (loop1 (three-partitions (- n (ann 1 I64))) (empty-list )))))

                       (def bcp-generator
                            (lambda (j)
                              (if (not (= (remainder j (ann 2 I64)) (ann 0 I64)))
                                  (empty-list )
                                  (begin
                                    (def loop1
                                         (lambda (rads1 lst)
                                           (if (null? rads1)
                                               lst
                                               (begin
                                                 (def loop2
                                                      (lambda (rads2 lst)
                                                        (if (null? rads2)
                                                            lst
                                                            (cons (BCP
                                                                   (car rads1)
                                                                   (car rads2))
                                                                  (loop2 (cdr rads2)
                                                                         lst)))))
                                                 (loop2 rads1 (loop1 (cdr rads1)
                                                                     lst))))))
                                    (loop1 (vector-ref radicals (quotient j (ann 2 I64))) (empty-list ))))))

                       (def ccp-generator
                            (lambda (j)
                              (begin
                                (def loop1
                                     (lambda (ps lst)
                                       (if (null? ps)
                                           lst
                                           (begin (let p (car ps))
                                                  (begin (let nc1 (vector-ref p (ann 0 I64)))
                                                         (begin (let nc2 (vector-ref p (ann 1 I64)))
                                                                (begin (let nc3 (vector-ref p (ann 2 I64)))
                                                                       (begin (let nc4 (vector-ref p (ann 3 I64)))
                                                                              (begin
                                                                                (def loop2
                                                                                     (lambda (rads1 lst)
                                                                                       (if (null? rads1)
                                                                                           lst
                                                                                           (begin
                                                                                             (def loop3
                                                                                                  (lambda (rads2 lst)
                                                                                                    (if (null? rads2)
                                                                                                        lst
                                                                                                        (begin
                                                                                                          (def loop4
                                                                                                               (lambda (rads3 lst)
                                                                                                                 (if (null? rads3)
                                                                                                                     lst
                                                                                                                     (begin
                                                                                                                       (def loop5
                                                                                                                            (lambda (rads4 lst)
                                                                                                                              (if (null? rads4)
                                                                                                                                  lst
                                                                                                                                  (cons (CCP
                                                                                                                                         (car rads1)
                                                                                                                                         (car rads2)
                                                                                                                                         (car rads3)
                                                                                                                                         (car rads4))
                                                                                                                                        (loop5 (cdr rads4)
                                                                                                                                               lst)))))
                                                                                                                       (loop5 (if (= nc3 nc4) rads3 (vector-ref radicals nc4)) (loop4 (cdr rads3)
                                                                                                                                                                                      lst))))))
                                                                                                          (loop4 (if (= nc2 nc3) rads2 (vector-ref radicals nc3)) (loop3 (cdr rads2)
                                                                                                                                                                         lst))))))
                                                                                             (loop3 (if (= nc1 nc2) rads1 (vector-ref radicals nc2)) (loop2 (cdr rads1)
                                                                                                                                                            lst))))))
                                                                                (loop2 (vector-ref radicals nc1) (loop1 (cdr ps)
                                                                                                                        lst)))))))))))
                                (loop1 (four-partitions (- j (ann 1 I64))) (empty-list )))))

                       (begin
                         (def loop
                              (lambda (i)
                                (if (> i n/2)
                                    (vector (bcp-generator n)
                                            (ccp-generator n))
                                    (begin
                                      (vector-set! radicals i (rads-of-size i))
                                      (loop (+ i (ann 1 I64)))))))
                         (loop (ann 1 I64))))))))

(def three-partitions
     (lambda (m)
       (begin
         (def loop1
              (lambda (lst nc1)
                (if (< nc1 (ann 0 I64))
                    lst
                    (begin
                      (def loop2
                           (lambda (lst nc2)
                             (if (< nc2 nc1)
                                 (loop1 lst
                                        (- nc1 (ann 1 I64)))
                                 (loop2 (cons (vector nc1 nc2 (- m (+ nc1 nc2))) lst)
                                        (- nc2 (ann 1 I64))))))
                      (loop2 lst (quotient (- m nc1) (ann 2 I64)))))))
         (loop1 (empty-list ) (quotient m (ann 3 I64))))))

(def four-partitions
     (lambda (m)
       (begin
         (def loop1
              (lambda (lst nc1)
                (if (< nc1 (ann 0 I64))
                    lst
                    (begin
                      (def loop2
                           (lambda (lst nc2)
                             (if (< nc2 nc1)
                                 (loop1 lst
                                        (- nc1 (ann 1 I64)))
                                 (begin (let start (max nc2 (- (quotient (+ m (ann 1 I64)) (ann 2 I64)) (+ nc1 nc2))))
                                        (begin
                                          (def loop3
                                               (lambda (lst nc3)
                                                 (if (< nc3 start)
                                                     (loop2 lst (- nc2 (ann 1 I64)))
                                                     (loop3 (cons (vector nc1 nc2 nc3 (- m (+ nc1 (+ nc2 nc3)))) lst)
                                                            (- nc3 (ann 1 I64))))))
                                          (loop3 lst (quotient (- m (+ nc1 nc2)) (ann 2 I64))))))))
                      (loop2 lst (quotient (- m nc1) (ann 3 I64)))))))
         (loop1 (empty-list ) (quotient m (ann 4 I64))))))

(def nb
     (lambda (n)
       (begin (let x (gen n))
              (+ (list-length (vector-ref x (ann 0 I64)))
                 (list-length (vector-ref x (ann 1 I64)))))))

(nb (ann 10 I64))
