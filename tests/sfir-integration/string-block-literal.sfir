(define shared
  (literal))
(define copied
  (string-copy shared))
(define expected-character
  (lambda (index)
    (if (= index 8192)
        #\x10ffff
        (let ((offset (remainder index 129)))
          (if (= offset 128) #\newline (if (= offset 127) #\x1f600 #\λ))))))
(define complete-literal?
  (lambda (value)
    (if (= (string-length value) 8193)
        (begin
          (define loop
            (lambda (index)
              (if (= index 8193)
                  #t
                  (if (char=? (string-ref value index) (expected-character index)) (loop (+ index 1)) #f))))
          (loop 0))
        #f)))

(define set-literal (-> Unit)
  (lambda () (string-set! shared 8192 #\Z)))

(define copy-literal (-> Unit)
  (lambda () (string-copy! shared 8191 "ZZ" 0 2)))

(define empty-literal-copy (-> Unit)
  (lambda () (string-copy! shared 8193 "" 0 0)))

(define unchanged (-> Bool)
  (lambda () (complete-literal? shared)))
(string-set! copied 8192 #\Z)
(if (if (string-eq? shared (literal))
        (if (not (string-eq? shared copied))
            (if (char=? (string-ref copied 8192) #\Z) (complete-literal? shared) #f)
            #f)
        #f)
    42
    (unreachable))
