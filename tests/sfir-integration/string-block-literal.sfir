λλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλλ􏿿"))
(def shared
     (literal))
(def copied
     (string-copy shared))
(def expected-character
     (lambda (index)
       (if (= index (ann 8192 I64))
           #\x10ffff
           (begin (let offset (remainder index (ann 129 I64)))
                  (if (= offset (ann 128 I64)) #\newline (if (= offset (ann 127 I64)) #\x1f600 #\λ))))))
(def complete-literal?
     (lambda (value)
       (if (= (string-length value) (ann 8193 I64))
           (begin
             (def loop
                  (lambda (index)
                    (if (= index (ann 8193 I64))
                        #t
                        (if (char=? (string-ref value index) (expected-character index)) (loop (+ index (ann 1 I64))) #f))))
             (loop (ann 0 I64)))
           #f)))

(def set-literal (-> Unit)
     (lambda () (string-set! shared (ann 8192 I64) #\Z)))

(def copy-literal (-> Unit)
     (lambda () (string-copy! shared (ann 8191 I64) "ZZ" (ann 0 I64) (ann 2 I64))))

(def empty-literal-copy (-> Unit)
     (lambda () (string-copy! shared (ann 8193 I64) "" (ann 0 I64) (ann 0 I64))))

(def unchanged (-> Bool)
     (lambda () (complete-literal? shared)))
(string-set! copied (ann 8192 I64) #\Z)
(if (if (string-eq? shared (literal))
        (if (not (string-eq? shared copied))
            (if (char=? (string-ref copied (ann 8192 I64)) #\Z) (complete-literal? shared) #f)
            #f)
        #f)
    (ann 42 I64)
    (unreachable))
