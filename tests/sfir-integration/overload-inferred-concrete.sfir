(import (sfir base))
(define-overload increment (lambda (value) (i64-add value (ann 1 I64))))
(define-overload increment (lambda (value) (f64-add value 1.0)))
(define-overload convert i64->f64)
(define-overload convert f64->i64)
(i64-add (increment (ann 0 I64)) (convert (increment (convert (ann 40 I64)))))
