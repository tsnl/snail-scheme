(import (sfir core))
(define-class (Combine T) (: combine (-> T T T)))
(define-instance (Combine I64) (combine (lambda (a b) (+ a b))))
(define combine-alias
  combine)

(define selected (-> I64 I64 I64)
  combine-alias)
(define twice-with
  (lambda (operation x) (operation x x)))
(twice-with selected 21)
