(import (sfir base))
(def forward
     (string-copy "abcdef"))
(def backward
     (string-copy "abcdef"))
(def shared
     (ref forward))
(def alias
     (ref-get shared))
(string-copy! forward (ann 2 I64) forward (ann 0 I64) (ann 4 I64))
(string-copy! backward (ann 0 I64) backward (ann 2 I64) (ann 6 I64))
(string-copy! forward (ann 6 I64) backward (ann 6 I64) (ann 6 I64))
(string-copy! (string) (ann 0 I64) "" (ann 0 I64) (ann 0 I64))
(ref-set! shared (string-append forward backward))
(string-set! alias (ann 0 I64) #\Z)
(if (if (string=? alias "Zbabcd")
        (if (string-eq? alias forward)
            (if (string=? backward "cdefef")
                (if (string=? (ref-get shared) "ababcdcdefef")
                    (not (string-eq? alias (ref-get shared)))
                    #f)
                #f)
            #f)
        #f)
    (ann 42 I64)
    (unreachable))
