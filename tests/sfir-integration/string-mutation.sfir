(import (sfir base))
(def forward
     (string-copy "abcdef"))
(def backward
     (string-copy "abcdef"))
(def shared
     (ref forward))
(def alias
     (ref-get shared))
(string-copy! forward 2 forward 0 4)
(string-copy! backward 0 backward 2 6)
(string-copy! forward 6 backward 6 6)
(string-copy! (string) 0 "" 0 0)
(ref-set! shared (string-append forward backward))
(string-set! alias 0 #\Z)
(if (if (string=? alias "Zbabcd")
        (if (string-eq? alias forward)
            (if (string=? backward "cdefef")
                (if (string=? (ref-get shared) "ababcdcdefef")
                    (not (string-eq? alias (ref-get shared)))
                    #f)
                #f)
            #f)
        #f)
    42
    (unreachable))
