(import (sfir base))

(def make-probe
     (lambda (start)
       (begin (let sfir-migration-let-1 (+ start 1))
              (let sfir-migration-let-2 (vector start (+ start 2)))
              (let sfir-migration-let-3 (ref start))
              (let value sfir-migration-let-1)
              (let items sfir-migration-let-2)
              (let shared sfir-migration-let-3)
              (begin
                (def advance
                     (lambda (delta)
                       (begin
                         (ref-set! shared (+ (ref-get shared) delta))
                         (+ value (+ (vector-ref items 1) (ref-get shared))))))
                (lambda (delta) (advance delta))))))

(def first
     (make-probe 10))
(def second
     (make-probe 20))
(+ (first 1) (+ (first 2) (second 3)))
