(import (sfir core))

(define make-probe
  (lambda (count)
    (begin
      (define loop
        (lambda (n)
          (begin
            (define owned
              n)
            (define hold
              (lambda () (lambda () owned)))
            (if (= n 0)
                (hold)
                (let ((previous (loop (- n 1))) (current (hold)))
                  (lambda () (+ (previous) (current))))))))
      (loop count))))

(+ 6 ((make-probe 8)))
