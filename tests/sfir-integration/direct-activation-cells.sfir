(import (sfir base))

(def make-probe
  (lambda (count)
    (begin
      (def loop
        (lambda (n)
          (begin
            (def owned
              n)
            (def hold
              (lambda () (lambda () owned)))
            (if (= n 0)
                (hold)
                (begin (let sfir-migration-let-1 (loop (- n 1))) (let sfir-migration-let-2 (hold))
                  (let previous sfir-migration-let-1)
(let current sfir-migration-let-2)
(lambda () (+ (previous) (current))))))))
      (loop count))))

(+ 6 ((make-probe 8)))
