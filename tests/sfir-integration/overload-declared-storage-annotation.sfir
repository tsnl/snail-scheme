(import (sfir base))

(def first (Ref (Vector I64))
     (ref (empty-vector)))
(def second
     (ref (empty-vector)))
(define-overload stored-first (-> (Vector I64)) (lambda () (ref-get first)))
(define-overload stored-second (-> (Vector I64)) (lambda () (ref-get second)))
(ref-set! first (make-vector (ann 1 I64) (ann 20 I64)))
(ref-set! second (make-vector (ann 1 I64) (ann 22 I64)))
(+ (vector-ref (stored-first) (ann 0 I64)) (vector-ref (stored-second) (ann 0 I64)))
