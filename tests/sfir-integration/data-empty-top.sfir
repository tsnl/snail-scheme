(import (sfir base))
(def First (datatype () (first)))
(def Second (datatype () (second)))
(def Marker (datatype ( T) (marker)))

(def nominal (-> I64)
     (lambda ()
       (match (ann (ann (first) Any) Second) ((second) (ann 0 I64)))))

(def arguments (-> I64)
     (lambda ()
       (match (ann (ann (ann (marker) (Marker I32)) Any) (Marker Char))
         ((marker) (ann 0 I64)))))

(def valid (-> I64)
     (lambda ()
       (match (ann (ann (ann (marker) (Marker Char)) Any) (Marker Char))
         ((marker) (ann 42 I64)))))
(ann 42 I64)
