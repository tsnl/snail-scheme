(import (sfir base))
(def count
  (ref 0))
(define-overload add-two implementation)
(def implementation
  (begin (ref-set! count (+ (ref-get count) 1))
         (lambda (value) (i64-add value 2))))
(def first
  (add-two 38))
(def second
  (add-two first))
(if (= (ref-get count) 1) second (unreachable))
