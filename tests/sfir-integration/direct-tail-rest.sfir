(import (sfir base))

(def exercise
  (lambda ()
    (begin
      (def count
        (ref 0))
      (def even (-> I64 Unit)
        (lambda (n)
          (begin
            (if (> n 0)
                (begin
                  (ref-set! count (+ 1 (ref-get count)))
                  (odd (- n 1))
                  (unit))
                (unit))
            (unit))))
      (def odd (-> I64 Unit)
        (lambda (n)
          (begin
            (if (= n 0)
                (unit)
                (begin
                  (ref-set! count (+ 1 (ref-get count)))
                  (even (- n 1))
                  (unit)))
            (unit))))
      (def add-first (-> I64 (Rest I64) I64)
        (lambda (first . remaining) (+ first (car remaining))))
      (def stop
        (lambda () (unreachable)))
      (even 100000)
      (if (= (ref-get count) 100000) (add-first 40 2 99) (stop)))))

(exercise)
