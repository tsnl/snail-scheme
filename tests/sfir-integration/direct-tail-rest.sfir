(import (sfir core))

(define exercise
  (lambda ()
    (begin
      (define count
        (ref 0))
      (define even (-> I64 Unit)
        (lambda (n)
          (begin
            (if (> n 0)
                (begin
                  (ref-set! count (+ 1 (ref-get count)))
                  (odd (- n 1))
                  (unit))
                (unit))
            (unit))))
      (define odd (-> I64 Unit)
        (lambda (n)
          (begin
            (if (= n 0)
                (unit)
                (begin
                  (ref-set! count (+ 1 (ref-get count)))
                  (even (- n 1))
                  (unit)))
            (unit))))
      (define add-first (-> I64 (Rest I64) I64)
        (lambda (first . remaining) (+ first (car remaining))))
      (define stop
        (lambda () (unreachable)))
      (even 100000)
      (if (= (ref-get count) 100000) (add-first 40 2 99) (stop)))))

(exercise)
