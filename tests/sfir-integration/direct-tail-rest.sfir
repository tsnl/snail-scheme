(import (sfir base))

(def exercise
     (lambda ()
       (begin
         (def count
              (ref (ann 0 I64)))
         (def even (-> I64 Unit)
              (lambda (n)
                (begin
                  (if (> n (ann 0 I64))
                      (begin
                        (ref-set! count (+ (ann 1 I64) (ref-get count)))
                        (odd (- n (ann 1 I64)))
                        (unit))
                      (unit))
                  (unit))))
         (def odd (-> I64 Unit)
              (lambda (n)
                (begin
                  (if (= n (ann 0 I64))
                      (unit)
                      (begin
                        (ref-set! count (+ (ann 1 I64) (ref-get count)))
                        (even (- n (ann 1 I64)))
                        (unit)))
                  (unit))))
         (def add-first (-> I64 (Rest I64) I64)
              (lambda (first . remaining) (+ first (car remaining))))
         (def stop
              (lambda () (unreachable)))
         (even (ann 100000 I64))
         (if (= (ref-get count) (ann 100000 I64)) (add-first (ann 40 I64) (ann 2 I64) (ann 99 I64)) (stop)))))

(exercise)
