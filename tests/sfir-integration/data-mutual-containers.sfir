(import (sfir core))
(define-data Node
  (node (children (Ref (List Edge)) node-children) (cache (Vector Edge) node-cache)))
(define-data Edge (edge (target Node edge-target)))
(define root
  (node (ref (quote ())) (empty-vector)))
(define link
  (edge root))
(ref-set! (node-children root) (cons link (quote ())))
(define other
  (node (ref (quote ())) (vector link)))
(if (ref-eq? (node-children (edge-target (vector-ref (node-cache other) 0)))
             (node-children (edge-target (car (ref-get (node-children root))))))
    23
    0)
