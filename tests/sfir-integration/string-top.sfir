(import (sfir base))
(def Text (datatype () (text (content String text-content))))
(def saved
  (ref (ann (string-copy "α😀") Any)))
(def values
  (vector (ann (text (ann (ref-get saved) String)) Any)))
(def text-value
  (ann (vector-ref values 0) Text))
(def reader
  (lambda ()
    (begin (let value (text-content text-value))
      (lambda () (string-ref value 1)))))
(def read-character
  (reader))
(string-set! (ann (ref-get saved) String) 1 #\é)
(if (char=? (read-character) #\é) 42 (unreachable))
