(import (sfir core))
(define-data Text (text (content String text-content)))
(define saved
  (ref (ann (string-copy "α😀") Top)))
(define values
  (vector (ann (text (ann (ref-get saved) String)) Top)))
(define text-value
  (ann (vector-ref values 0) Text))
(define reader
  (lambda ()
    (let ((value (text-content text-value)))
      (lambda () (string-ref value 1)))))
(define read-character
  (reader))
(string-set! (ann (ref-get saved) String) 1 #\é)
(if (char=? (read-character) #\é) 42 (unreachable))
