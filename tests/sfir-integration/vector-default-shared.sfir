(import (sfir core))
(define count
  (ref 0))
(define shared
  (ref 0))
(define-instance (Default (Ref I64))
  (default (lambda ()
             (begin
               (ref-set! count (+ (ref-get count) 1))
               shared))))
(define empty
  (ann (make-vector 0) (Vector (Ref I64))))
(define values
  (ann (make-vector 3) (Vector (Ref I64))))
(ref-set! (vector-ref values 1) 42)
(if (if (= (ref-get count) 3)
        (if (= (vector-length empty) 0)
            (if (ref-eq? (vector-ref values 0) (vector-ref values 2))
                (if (= (ref-get (vector-ref values 0)) 42) (= (ref-get shared) 42) #f)
                #f)
            #f)
        #f)
    42
    (unreachable))
