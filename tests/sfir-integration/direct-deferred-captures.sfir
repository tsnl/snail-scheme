(import (sfir core))

(define exercise
  (lambda ()
    (begin
      (define choose
        (lambda (use-later?) (if use-later? (later) 20)))
      (define before
        (choose #f))
      (define later
        (lambda () (vector-ref payload 0)))
      (define payload
        (make-vector 1 22))
      (+ before (choose #t)))))

(exercise)
