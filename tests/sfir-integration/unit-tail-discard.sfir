(import (sfir base))

(def state
     (ref (ann 0 I64)))
(def wide
     (lambda ()
       (begin (ref-set! state (+ (ref-get state) (ann 1 I64))) (ann 7 I64))))
(def narrow
     (lambda ()
       (begin (ref-set! state (+ (ref-get state) (ann 1 I64))) (ann 7 I32))))
(def flag
     (lambda ()
       (begin (ref-set! state (+ (ref-get state) (ann 1 I64))) #t)))
(def discard-wide
     (lambda () (if #t
                    (begin (wide)
                           (unit))
                    (unit))))
(def discard-narrow
     (lambda () (if #f
                    (unit)
                    (begin (narrow)
                           (unit)))))
(def discard-flag
     (lambda ()
       (begin (flag) (unit) (unit))))

(ann (discard-wide) Unit)
(ann (discard-narrow) Unit)
(ann (discard-flag) Unit)
(ref-get state)
