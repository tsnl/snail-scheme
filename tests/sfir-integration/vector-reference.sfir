(import (sfir core))
(define shared
  (ref 0))
(define original
  (make-vector 2 shared))
(define copied
  (vector-copy original))
(define appended
  (vector-append (empty-vector) original copied (empty-vector)))
(ref-set! (vector-ref appended 3) 42)
(vector-set! original 0 (ref 7))
(if (if (ref-eq? (vector-ref copied 0) (vector-ref original 1))
        (if (= (ref-get (vector-ref original 0)) 7)
            (if (= (ref-get (vector-ref original 1)) 42) (not (vector-eq? copied original)) #f)
            #f)
        #f)
    42
    (unreachable))
