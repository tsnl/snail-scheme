;; String is fixed type syntax, so the former imported alias is spelled directly.
(import (sfir base))

(def literal (-> String)
     (lambda () "A\x0;é😀"))
(def value
     (literal))
(if (if (= (string-length value) (ann 4 I64))
        (if (= (string-length "") (ann 0 I64))
            (if (char=? (string-ref value (ann 0 I64)) #\A)
                (if (= (char->integer (string-ref value (ann 1 I64))) (ann 0 I64))
                    (if (= (char->integer (string-ref value (ann 2 I64))) (ann 233 I64))
                        (if (= (char->integer (string-ref value (ann 3 I64))) (ann 128512 I64)) (string-eq? value (literal)) #f)
                        #f)
                    #f)
                #f)
            #f)
        #f)
    (ann 42 I64)
    (unreachable))
