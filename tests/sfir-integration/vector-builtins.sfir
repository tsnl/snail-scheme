(import (sfir base))
(def copy-values
     (lambda (source) (vector-append (empty-vector) (vector-copy source))))
(def integers
     (copy-values (list->vector (cons (ann 40 I64) (cons (ann 2 I64) (empty-list ))))))
(def flags
     (copy-values (vector #t #f)))
(def returned
     (vector->list integers))
(if (if (= (vector-length (ann (vector-append) (Vector I64))) (ann 0 I64))
        (if (= (vector-length (ann (vector) (Vector Bool))) (ann 0 I64))
            (if (not (vector-eq? (ann (empty-vector) (Vector I64)) (ann (empty-vector) (Vector I64))))
                (if (vector-ref flags (ann 0 I64)) (not (vector-ref flags (ann 1 I64))) #f)
                #f)
            #f)
        #f)
    (+ (car returned) (car (cdr returned)))
    (unreachable))
