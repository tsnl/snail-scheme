(import (sfir base))

(def saved
     (ref (ann (lambda () (ann 0 I64)) (-> I64))))
(def answer
     ((begin
        (begin
          (def value
               (lambda () (ann 42 I64)))
          (ref-set! saved value)
          value))))
(def choose
     (lambda (flag)
       ((begin
          (begin
            (def yes
                 (lambda () answer))
            (def no
                 (lambda () (ann 0 I64)))
            (if flag yes no))))))

(if (if (= ((ref-get saved)) (ann 42 I64)) (if (= (choose #t) (ann 42 I64)) (= (choose #f) (ann 0 I64)) #f) #f) (ann 42 I64) (ann 0 I64))
