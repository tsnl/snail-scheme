(import (sfir core))

(define saved
  (ref (ann (lambda () 0) (-> I64))))
(define answer
  ((let ()
     (begin
       (define value
         (lambda () 42))
       (ref-set! saved value)
       value))))
(define choose
  (lambda (flag)
    ((let ()
       (begin
         (define yes
           (lambda () answer))
         (define no
           (lambda () 0))
         (if flag yes no))))))

(if (if (= ((ref-get saved)) 42) (if (= (choose #t) 42) (= (choose #f) 0) #f) #f) 42 0)
