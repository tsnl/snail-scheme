(import (lofi base))

(def round-trip (-> I64 I64)
     (lambda (n) (ann (ann n Any) I64)))
(if (if (= (round-trip (ann -9223372036854775808 I64)) (ann -9223372036854775808 I64))
        (if (= (round-trip (ann -1073741825 I64)) (ann -1073741825 I64))
            (if (= (round-trip (ann -1073741824 I64)) (ann -1073741824 I64))
                (if (= (round-trip (ann -1 I64)) (ann -1 I64))
                    (if (= (round-trip (ann 1073741823 I64)) (ann 1073741823 I64))
                        (if (= (round-trip (ann 1073741824 I64)) (ann 1073741824 I64))
                            (= (round-trip (ann 9223372036854775807 I64)) (ann 9223372036854775807 I64))
                            #f)
                        #f)
                    #f)
                #f)
            #f)
        #f)
    (ann 42 I64)
    (ann 0 I64))
