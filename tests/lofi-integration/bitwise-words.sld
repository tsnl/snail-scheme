(import
 (lofi base))

;; ---- First-class operations retain the complete word contract ----

;; Load first-class operations through cells before applying signed words and
;; wrapped shift counts. Direct calls below exercise ordinary primitive use too.
(def mask-i32
     (ref i32-bitwise-and))
(def shift-i32
     (ref i32-shift-right/logical))
(def mask-i64
     (ref i64-bitwise-and))
(def shift-i64
     (ref i64-shift-right/logical))
(def xor-i32
     (ref i32-bitwise-xor))
(def xor-i64
     (ref i64-bitwise-xor))

(def test-i32
     (lambda ()
       (begin (let lofi-migration-let-1 (ref-get mask-i32)) (let lofi-migration-let-2 (ref-get shift-i32)) (let lofi-migration-let-3 (ref-get xor-i32))
              (let mask lofi-migration-let-1)
              (let shift lofi-migration-let-2)
              (let xor lofi-migration-let-3)
              (if (= (i32->i64 (mask -1 42)) (ann 42 I64))
                  (if (= (i32->i64 (mask -2147483648 -1)) (ann -2147483648 I64))
                      (if (= (i32->i64 (mask -1431655766 1431655765)) (ann 0 I64))
                          (if (= (i32->i64 (xor -1 1)) (ann -2 I64))
                              (if (= (i32->i64 (xor -2147483648 2147483647)) (ann -1 I64))
                                  (if (= (i32->i64 (xor -1431655766 1431655765)) (ann -1 I64))
                                      (if (= (i32->i64 (xor -2147483648 -2147483648)) (ann 0 I64))
                                          (if (= (i32->i64 (shift -1 1)) (ann 2147483647 I64))
                                              (if (= (i32->i64 (shift -2147483648 31)) (ann 1 I64))
                                                  (if (= (i32->i64 (shift -1 0)) (ann -1 I64))
                                                      (if (= (i32->i64 (shift -2147483648 32)) (ann -2147483648 I64))
                                                          (if (= (i32->i64 (shift -2147483648 33)) (ann 1073741824 I64))
                                                              (if (= (i32->i64 (shift -1 -1)) (ann 1 I64))
                                                                  (if (= (i32->i64 (shift -1 -32)) (ann -1 I64))
                                                                      (if (= (i32->i64 (shift -1 2147483647)) (ann 1 I64)) (= (i32->i64 (shift -1 -2147483648)) (ann -1 I64)) #f)
                                                                      #f)
                                                                  #f)
                                                              #f)
                                                          #f)
                                                      #f)
                                                  #f)
                                              #f)
                                          #f)
                                      #f)
                                  #f)
                              #f)
                          #f)
                      #f)
                  #f))))

(def test-i64
     (lambda ()
       (begin (let lofi-migration-let-4 (ref-get mask-i64)) (let lofi-migration-let-5 (ref-get shift-i64)) (let lofi-migration-let-6 (ref-get xor-i64))
              (let mask lofi-migration-let-4)
              (let shift lofi-migration-let-5)
              (let xor lofi-migration-let-6)
              (if (= (mask (ann -1 I64) (ann 42 I64)) (ann 42 I64))
                  (if (= (mask (ann -9223372036854775808 I64) (ann -1 I64)) (ann -9223372036854775808 I64))
                      (if (= (mask (ann -6148914691236517206 I64) (ann 6148914691236517205 I64)) (ann 0 I64))
                          (if (= (xor (ann -1 I64) (ann 1 I64)) (ann -2 I64))
                              (if (= (xor (ann 1 I64) (ann 1099511627776 I64)) (ann 1099511627777 I64))
                                  (if (= (xor (ann -9223372036854775808 I64) (ann 9223372036854775807 I64)) (ann -1 I64))
                                      (if (= (xor (ann -9223372036854775808 I64) (ann -9223372036854775808 I64)) (ann 0 I64))
                                          (if (= (shift (ann -1 I64) (ann 1 I64)) (ann 9223372036854775807 I64))
                                              (if (= (shift (ann -9223372036854775808 I64) (ann 63 I64)) (ann 1 I64))
                                                  (if (= (shift (ann -1 I64) (ann 0 I64)) (ann -1 I64))
                                                      (if (= (shift (ann -9223372036854775808 I64) (ann 64 I64)) (ann -9223372036854775808 I64))
                                                          (if (= (shift (ann -9223372036854775808 I64) (ann 65 I64)) (ann 4611686018427387904 I64))
                                                              (if (= (shift (ann -1 I64) (ann -1 I64)) (ann 1 I64))
                                                                  (if (= (shift (ann -1 I64) (ann -64 I64)) (ann -1 I64))
                                                                      (if (= (shift (ann -1 I64) (ann 9223372036854775807 I64)) (ann 1 I64)) (= (shift (ann -1 I64) (ann -9223372036854775808 I64)) (ann -1 I64)) #f)
                                                                      #f)
                                                                  #f)
                                                              #f)
                                                          #f)
                                                      #f)
                                                  #f)
                                              #f)
                                          #f)
                                      #f)
                                  #f)
                              #f)
                          #f)
                      #f)
                  #f))))

(if (if (test-i32)
        (if (test-i64)
            (if (= (i32->i64 (i32-bitwise-and 255 15)) (ann 15 I64))
                (if (= (i32->i64 (i32-shift-right/logical 256 4)) (ann 16 I64))
                    (if (= (i32->i64 (i32-bitwise-xor 255 15)) (ann 240 I64))
                        (if (= (i64-bitwise-xor (ann 1099511627776 I64) (ann 1 I64)) (ann 1099511627777 I64))
                            (if (= (i64-bitwise-and (ann 1152921503533105152 I64) (ann 1073741823 I64)) (ann 0 I64))
                                (= (i64-shift-right/logical (ann 1152921503533105152 I64) (ann 30 I64)) (ann 1073741823 I64))
                                #f)
                            #f)
                        #f)
                    #f)
                #f)
            #f)
        #f)
    (ann 42 I64)
    (unreachable))
