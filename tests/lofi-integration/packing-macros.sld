(import
 (lofi base)
 (lofi bytes)
 (only (scheme immutable) list)
 (rename (only (lofi base) vector) (vector packed-vector)))

(def history (ref 0))
(def mark (-> I32 I32)
     (lambda (digit)
       (begin (ref-set! history (+ (* (ref-get history) 10) digit)) digit)))
(def select (-> I32 (Vector I32) I32)
     (lambda (first values) (+ first (vector-ref values (ann 0 I64)))))
(def result
     ((begin (mark 4) select) (mark 1) (packed-vector (mark 2) (mark 3))))
(def convert (All (T) (-> (-> (List T) (Vector T)) (List T) (Vector T)))
     (lambda (worker values) (worker values)))
(def values (convert list->vector (list 42)))
(def hygienic
     (begin
       (let cons 0)
       (let empty-list 0)
       (let list 0)
       (let list->vector 0)
       (packed-vector 42)))
(def empty (Vector I32) (packed-vector))
(def text (string-concatenate (list (string #\a) (string #\b))))
(def bytes (bytevector-concatenate (list (bytevector (ann 42 I64)) (bytevector))))
(def assert (-> Bool Unit) (lambda (test) (if test (unit) (unreachable))))
(assert (= (ref-get history) 1234))
(assert (= result 3))
(assert (= (vector-length empty) (ann 0 I64)))
(assert (= (vector-ref hygienic (ann 0 I64)) 42))
(assert (string=? text "ab"))
(assert (= (bytevector-u8-ref bytes (ann 0 I64)) (ann 42 I64)))
(vector-ref values (ann 0 I64))
