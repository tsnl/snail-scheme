(import (lofi base))
;; These declarations are authored explicitly; macro syntax and grammar aliases
;; are absent from Lofi. Both members still share one overload family.
(define-overload select (-> I64 I64) (lambda (value) value))
(define-overload select (-> Bool I64) (lambda (value) (if value (ann 42 I64) (ann 0 I64))))
(select #t)
