(import (lofi base))
(def truncates
     (lambda (operation input expected) (= (operation input) expected)))
(def nan32
     (truncate (/ (ann 0.0 F32) (ann 0.0 F32))))
(def nan64
     (truncate (/ 0.0 0.0)))
(def infinity32
     (/ (ann 1.0 F32) (ann 0.0 F32)))
(def infinity64
     (/ 1.0 0.0))
(if (if (truncates truncate (ann 3.75 F32) (ann 3.0 F32))
        (if (truncates truncate (ann -3.75 F32) (ann -3.0 F32))
            (if (truncates truncate 3.75 3.0)
                (if (truncates truncate -3.75 -3.0)
                    (if (< (/ (ann 1.0 F32) (truncate (ann -0.75 F32))) (ann 0.0 F32))
                        (if (< (/ 1.0 (truncate -0.75)) 0.0)
                            (if (> (/ (ann 1.0 F32) (truncate (ann 0.75 F32))) (ann 0.0 F32))
                                (if (> (/ 1.0 (truncate 0.75)) 0.0)
                                    (if (truncates truncate infinity32 infinity32)
                                        (if (truncates truncate infinity64 infinity64)
                                            (if (truncates truncate (- (ann 0.0 F32) infinity32) (- (ann 0.0 F32) infinity32))
                                                (if (truncates truncate (- 0.0 infinity64) (- 0.0 infinity64))
                                                    (if (not (= nan32 nan32))
                                                        (if (not (= nan64 nan64))
                                                            (if (truncates truncate (ann 18446744073709551616.0 F32) (ann 18446744073709551616.0 F32))
                                                                (truncates truncate 18446744073709551616.0 18446744073709551616.0)
                                                                #f)
                                                            #f)
                                                        #f)
                                                    #f)
                                                #f)
                                            #f)
                                        #f)
                                    #f)
                                #f)
                            #f)
                        #f)
                    #f)
                #f)
            #f)
        #f)
    (ann 42 I64)
    (unreachable))
