(import
 (snail core base)
 (snail core io)
 (only (snail core forms) host)
 (snail shell task)
 (snail shell future)
 (prefix (snail shell async) async-)
 (prefix (snail shell async-files) file-))

(define (check (ok Bool) (label String)) (→ Unit) (! output-port)
  (if ok (write-line label) (panic label)))

(define (success (result (Result Bytes file-FileError)) (size I64)) (→ Bool)
  (match result ((Ok bytes) (= (vector-length bytes) size)) (_ #f)))

(define (cases (directory String)) (→ Unit) (! mut completion tasks file-files output-port host)
  (let ((path (string-append directory "/bytes")))
    (check (match (file-read-file path 4)
             ((Ok bytes) (and (= (vector-length bytes) 4)
                              (= (vector-ref bytes 1) (i32->u8 0))
                              (= (vector-ref bytes 3) (i32->u8 255))))
             (_ #f)) "exact limit")
    (check (match (file-read-file path 3) ((Err (file-TooLarge)) #t) (_ #f)) "size bound")
    (check (match (file-read-file (string-append directory "/missing") 4)
             ((Err (file-NotFound)) #t) (_ #f)) "missing file")
    (check (match (file-read-file path -1) ((Err (file-InvalidInput)) #t) (_ #f)) "invalid bound")
    (let ((future (async-dispatch (once (lambda () (file-read-file path 4))))))
      (match (poll future)
        ((Pending future)
         (write-line "dispatch returns before work")
         (match (async-await-future future)
           ((Completed result) (check (success result 4) "future result"))
           ((Abandoned) (panic "read abandoned"))))
        ((Ready _) (panic "dispatch ran inline"))))
    (match (async-await-future (async-after 5))
      ((Completed _) (write-line "timer progresses"))
      ((Abandoned) (panic "timer abandoned")))
    (let ((future (async-dispatch (once (lambda () (file-read-file path 4))))))
      (yield)
      (tasks-close!)
      (match (poll future)
        ((Ready (Abandoned)) (write-line "suspended read abandoned"))
        ((Pending future) (drop future) (panic "cancellation left producer pending"))
        ((Ready _) (panic "read finished before cancellation"))))))

(let ((directory (list-ref (command-line) 1)))
  (drop (make-directories directory))
  (write-file (string-append directory "/empty") "")
  (write-bytes (string-append directory "/bytes")
               (list->vector (list (i32->u8 97) (i32->u8 0) (i32->u8 98) (i32->u8 255))))
  (match (file-read-file (string-append directory "/empty") 0)
    ((Ok bytes)
     (check (= (vector-length bytes) 0) "empty file")
     (cases directory))
    ((Err (file-Unavailable)) (write-line "SKIP: native async file provider unavailable"))
    (_ (panic "empty file read failed")))
  (drop (remove-tree directory)))
