(import (snail strict))
(define-extern collect "probe" "callback" (-> Unit))
(define data (vector 0 1 2 3 4 5))
(define trace (ref 0))
(define (mark digit) (ref-set! trace (+ (* (ref-get trace) 10) digit)))
(: worker (-> I32 I32))
(define (worker x) x)
(: read (-> I64 I64))
(define (read index) (vector-ref data index))
(: marks (-> I64))
(define (marks) (ref-get trace))
(: reset (-> Unit))
(define (reset)
  (ref-set! trace 0)
  (let loop ((index 0))
    (unless (= index 6)
      (vector-set! data index index)
      (loop (+ index 1)))))
(: write (-> I64 Unit))
(define (write index)
  ((begin (mark 4) vector-set!)
   (begin (mark 1) data)
   (begin (mark 2) index)
   (begin (mark 3) 99)))
(: allocate (-> I64 I64))
(define (allocate count)
  (vector-length (make-vector (begin (mark 1) count) (begin (mark 2) 42))))
(: copy (-> I64 I64 I64 Unit))
(define (copy at start end)
  ((begin (mark 6) vector-copy!)
   (begin (mark 1) data) (begin (mark 2) at)
   (begin (mark 3) data) (begin (mark 4) start) (begin (mark 5) end)))
(: gc-check (-> I64))
(define (gc-check)
  (let* ((cell (ref 42)) (values (make-vector 2 cell)))
    (collect)
    (ref-set! (vector-ref values 0) 43)
    (ref-get (vector-ref values 1))))
42
