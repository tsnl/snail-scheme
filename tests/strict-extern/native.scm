(import (snail strict))
(define-class (Combine T) (: combine (-> T T T)))
(define-instance (Combine I32) (combine native-add))
(define-extern native-add "probe" "add" (-> I32 I32 I32))
(define-extern mark "probe" "mark" (-> I32 Unit))
(define-extern id-i64 "probe" "id64" (-> I64 I64))
(define-extern id-f32 "probe" "idf32" (-> F32 F32))
(define-extern id-f64 "probe" "idf64" (-> F64 F64))
(define-extern id-bool "probe" "id32" (-> Bool Bool))
(define-extern id-char "probe" "id32" (-> Char Char))
(: worker (-> I32 I32))
(define worker
  (let ((state (ref (ann 0 I32))))
    (mark (ann 9 I32))
    (lambda (amount)
      (ref-set! state (i32-add (ref-get state) amount))
      (ref-get state))))
(: void-worker (-> I32 Unit))
(define (void-worker digit)
  (define (invoke action) (action digit))
  (invoke mark)
  (unit))
(: class-worker (-> I32 I32))
(define (class-worker x) (combine x (ann 2 I32)))
(: class-value-worker (-> I32 I32))
(define (class-value-worker x)
  (define (invoke f) (f x (ann 2 I32)))
  (invoke combine))
(: local-worker (-> I32 I32))
(define (local-worker x)
  (define-extern local-add "probe" "add" (-> I32 I32 I32))
  (local-add x (ann 2 I32)))
(define-syntax native-identity
  (syntax-rules ()
    ((_ value)
     (let ()
       (define-extern foreign "probe" "id32" (-> I32 I32))
       (foreign value)))))
(: macro-worker (-> I32 I32))
(define (macro-worker foreign) (native-identity foreign))
(: i64-worker (-> I64 I64))
(define i64-worker id-i64)
(: f32-worker (-> F32 F32))
(define f32-worker id-f32)
(: f64-worker (-> F64 F64))
(define f64-worker id-f64)
(: bool-worker (-> Bool Bool))
(define bool-worker id-bool)
(: char-worker (-> Char Char))
(define char-worker id-char)
((begin (mark (ann 3 I32)) native-add)
 (begin (mark (ann 1 I32)) (ann 20 I32))
 (begin (mark (ann 2 I32)) (ann 22 I32)))
