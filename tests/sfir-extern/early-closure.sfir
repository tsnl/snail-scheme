(import (sfir core))

(define-extern mark "probe" "mark" (-> I32 Unit))
(define base
  (ann 40 I32))

(define worker (-> I32 I32)
  (lambda (value) (+ base value)))
(define invoke
  (lambda (callback) (callback)))
(define pending
  ((lambda ()
     (begin
       (define read-later
         (lambda ()
           (begin
             (mark (ann 3 I32))
             (+ base later))))
       (invoke read-later)))))
(define later
  (ann 2 I32))
pending
