(import (sfir base))
(define-extern collect "probe" "callback" (-> Unit))
(def data
     (vector 0 1 2 3 4 5))
(def trace
     (ref 0))
(def mark
     (lambda (digit) (ref-set! trace (+ (* (ref-get trace) 10) digit))))

(def worker (-> I32 I32)
     (lambda (x) x))

(def read (-> I64 I64)
     (lambda (index) (vector-ref data index)))

(def marks (-> I64)
     (lambda () (ref-get trace)))

(def reset (-> Unit)
     (lambda ()
       (begin
         (ref-set! trace 0)
         (begin
           (def loop
                (lambda (index)
                  (if (= index 6)
                      (unit)
                      (begin
                        (vector-set! data index index)
                        (loop (+ index 1))
                        (unit)))))
           (loop 0)))))

(def write (-> I64 Unit)
     (lambda (index)
       ((begin (mark 4) vector-set!)
        (begin (mark 1) data)
        (begin (mark 2) index)
        (begin (mark 3) 99))))

(def allocate (-> I64 I64)
     (lambda (count)
       (vector-length (make-vector (begin (mark 1) count) (begin (mark 2) 42)))))

(def copy (-> I64 I64 I64 Unit)
     (lambda (at start end)
       ((begin (mark 6) vector-copy!)
        (begin (mark 1) data) (begin (mark 2) at)
        (begin (mark 3) data) (begin (mark 4) start) (begin (mark 5) end))))

(def gc-check (-> I64)
     (lambda ()
       (begin (let cell (ref 42))
              (begin (let values (make-vector 2 cell))
                     (begin
                       (collect)
                       (ref-set! (vector-ref values 0) 43)
                       (ref-get (vector-ref values 1)))))))
42
