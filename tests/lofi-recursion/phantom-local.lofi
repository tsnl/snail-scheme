(import (lofi primitive))
(def recur (All (T) (-> I64 I64))
     (lambda (n)
       (begin
         (let local (lambda (value) (ann value T)))
         (local (ann 42 I64))
         (local #t)
         (if (i64-eq n (ann 0 I64)) (ann 42 I64)
             ((inst recur T) (i64-sub n (ann 1 I64)))))))
(ann 42 I64)
