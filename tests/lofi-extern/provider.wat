(module
  (import "host" "callback" (func $callback))
  (export "callback" (func $callback))
  (global $trace (export "trace") (mut i32) (i32.const 0))
  (global $marks (export "marks") (mut i32) (i32.const 0))
  (func $record (param $digit i32)
    (global.set $trace (i32.add (i32.mul (global.get $trace) (i32.const 10)) (local.get $digit))))
  (func (export "mark") (param $digit i32)
    (global.set $marks (i32.add (global.get $marks) (i32.const 1)))
    (call $record (local.get $digit)))
  (func (export "add") (param $a i32) (param $b i32) (result i32)
    (call $record (i32.const 4))
    (i32.add (local.get $a) (local.get $b)))
  (func (export "id32") (param i32) (result i32) (local.get 0))
  (func (export "id64") (param i64) (result i64) (local.get 0))
  (func (export "idf32") (param f32) (result f32) (local.get 0))
  (func (export "idf64") (param f64) (result f64) (local.get 0)))
