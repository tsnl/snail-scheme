;; Drive the real loopback server and observe its public HTTP boundary.
(define-library (snail-tests view-traces)
  (export run-view-traces)
  (import (scheme base) (scheme char) (scheme file) (scheme write) (srfi 1) (srfi 18)
          (chibi filesystem) (chibi pathname) (srfi 151)
          (only (chibi process) fork execute kill waitpid signal/term)
          (only (chibi string) string-contains string-prefix? string-cursor<? string-cursor-forward substring-cursor) (snail-tests harness))
  (begin

    ;; ---- Selected trace and contained UI requests ----

    (define (url-name text)
      (apply string-append
             (map (lambda (byte)
                    (if (or (<= 48 byte 57) (<= 65 byte 90) (<= 97 byte 122) (memv byte '(45 46 95 126)))
                        (string (integer->char byte))
                        (let ((hex (string-upcase (number->string byte 16))))
                          (string-append "%" (if (= 1 (string-length hex)) "0" "") hex))))
                  (bytevector->u8-list (string->utf8 text)))))
    (define (bytevector->u8-list bytes)
      (map (lambda (index) (bytevector-u8-ref bytes index)) (iota (bytevector-length bytes))))
    (define (request base route expected)
      (let* ((directory (make-build-directory (output) "http-"))
             (headers (path-join directory "headers")) (body (path-join directory "body"))
             (record (checked "request" (list "curl" "--path-as-is" "--silent" "--show-error" "--max-time" "5"
                                              "--dump-header" headers "--output" body "--write-out" "%{http_code}" (string-append base route)))))
        (assert-equal (field record 'stdout) (number->string expected) route)
        (cons (read-text headers) (read-bytes body))))
    (define (check-http base directory trace ui)
      (let* ((response (request base "/" 200)) (headers (car response)) (page (utf8->string (cdr response)))
             (name (path-strip-directory trace)))
        (assert-that (contains? (string-downcase headers) "cache-control: no-store"))
        (assert-that (and (contains? page "theme: 'dark'") (contains? page "location.origin")))
        (assert-that (and (contains? page (url-name name)) (not (contains? page name))))
        (assert-that (string-cursor<? (string-contains page "location.replace") (string-contains page "loader.js")))
        (assert-equal (cdr (request base "/index.html" 200)) (cdr response)))
      (let* ((route (string-append "/trace/" (url-name (path-strip-directory trace)))) (response (request base route 200)))
        (assert-equal (cdr response) (read-bytes trace))
        (assert-that (contains? (string-downcase (car response)) "cache-control: no-store"))
        (write-text trace "new trace contents")
        (assert-equal (cdr (request base route 200)) (string->utf8 "new trace contents")))
      (let ((response (request base "/version/engine.wasm" 200)))
        (assert-that (contains? (string-downcase (car response)) "content-type: application/wasm"))
        (assert-equal (cdr response) #u8(0 97 115 109)))
      (write-text (path-join directory "outside.json") "an unselected file")
      (assert-that (symbolic-link-file (path-join directory "outside.json") (path-join ui "escape.json")))
      ;; A permissive decoder would expose these existing UI files.
      (for-each (lambda (name) (write-text (path-join ui name) "invalid escape accepted"))
                '("\x1;.json" "%.json" "%0.json"))
      (for-each (lambda (route) (request base route 404))
                '("/trace/outside.json" "/trace/%2e%2e/outside.json" "/%2e%2e/outside.json" "/escape.json"
                  "/trace/%00.json" "/%+1.json" "/%-0.json" "/%.json" "/%0.json"))
      (assert-equal (cdr (request base "/version/engine.wasm" 200)) #u8(0 97 115 109)))

    ;; ---- A test owns the server process until all requests finish ----

    (define (redirect-output descriptor path)
      (let ((file (open path (bitwise-ior open/write open/create open/truncate) #o600)))
        (assert-that file)
        ;; Chibi's descriptor operation returns #f even after a successful dup2.
        (duplicate-file-descriptor-to file descriptor)
        ;; Closing the port also marks Chibi's descriptor wrapper closed.
        (close-output-port (open-output-file-descriptor file))))
    (define (start-server trace ui stdout stderr)
      (let ((pid (fork)))
        (assert-that pid)
        (when (zero? pid)
          (redirect-output 1 stdout) (redirect-output 2 stderr)
          (execute "env" (list "env" (string-append "PERFETTO_UI=" ui) (path "scripts/view-traces") trace "--port" "0")))
        pid))
    (define (server-base stdout)
      (let loop ((attempt 0))
        (let ((text (if (file-exists? stdout) (read-text stdout) "")))
          (cond ((contains? text "http://127.0.0.1:")
                 (let* ((start (string-contains text "http://127.0.0.1:"))
                        (end (string-contains text "/" (string-cursor-forward text start 7))))
                   (substring-cursor text start end)))
                ((= attempt 500) (error "view-traces did not report its loopback address" stdout))
                (else (thread-sleep! .01) (loop (+ attempt 1)))))))
    (define (run-view-traces)
      (let* ((directory (make-build-directory (output) "server-"))
             (trace (path-join directory "<compiler> 'λ' %?#.trace.json")) (ui (path-join directory "ui")))
        (write-text trace "[{\"ph\":\"M\"}]") (create-directory* (path-join ui "version"))
        (write-text (path-join ui "index.html") "<!doctype html><head></head><body><script src=\"loader.js\"></script></body>")
        (write-bytes (path-join ui "version/engine.wasm") #u8(0 97 115 109))
        (checked "dependency" (list (path "scripts/view-traces") trace)
                 '((status . 1) (error . "enter nix-shell first") (environment . (("PERFETTO_UI" . #f)))))
        (for-each (lambda (arguments) (checked "invalid-cli" (cons (path "scripts/view-traces") arguments)
                                               '((status . 2) (error . "usage:"))))
                  (list (list (path-join directory "absent")) (list directory) (list trace "--port" "-1")))
        (let* ((stdout (path-join directory "stdout")) (stderr (path-join directory "stderr"))
               (pid (start-server trace ui stdout stderr)))
          (write-json (path-join directory "process.json") `((pid . ,pid) (trace . ,trace) (ui . ,ui)))
          (dynamic-wind (lambda () #f) (lambda () (check-http (server-base stdout) directory trace ui))
                        (lambda () (kill pid signal/term) (waitpid pid 0))))
        (complete! "trace viewer HTTP startup, live trace, UI MIME and containment" '((passed . #t)))))))
