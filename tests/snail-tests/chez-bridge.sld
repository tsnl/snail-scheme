;; Frozen Chez controls remain independent of the SFIR compiler implementation.
(define-library (snail-tests chez-bridge)
  (export run-chez-bridge)
  (import (scheme base) (scheme cxr) (scheme file) (scheme inexact) (scheme write)
          (srfi 1) (chibi pathname) (only (chibi string) string-split string-prefix? string-contains substring-cursor)
          (snail-tests harness))
  (begin

    ;; ---- Reviewed library profiles and unchanged external control sources ----

    (define (library-root) (argument-value "--library-root" (root)))
    (define (target-root) (argument-value "--target-root" (root)))
    (define (control name) (fixture "sfir-numbers" "chez" name))
    (define (check-profile!)
      (let* ((provenance (read-json (control "provenance.json")))
             (profiles (cons (cons "original-freeze" (field provenance 'sfir_libraries))
                             (map (lambda (review) (cons (field review 'name) (field review 'sfir_libraries))) (rows (field provenance 'compatibility_reviews #())))))
             (profile (find (lambda (profile)
                              (every (lambda (entry) (equal? (file-sha256 (path-join (library-root) (symbol->string (car entry)))) (cdr entry))) (cdr profile))) profiles)))
        (assert-that profile "SFIR libraries do not match a complete reviewed Chez control profile")
        (for-each (lambda (entry) (assert-equal (file-sha256 (path (symbol->string (car entry)))) (cdr entry))) (field provenance 'fixtures))
        (write-json (build-path "library-review.json") `((profile . ,(car profile))))))
    (define (case-data cases)
      (apply string-append (map (lambda (case)
                                  (string-append "#(" (join (list (json-text (field case 'label)) (number-text (field case 'operation))
                                                                  (json-text (field case 'a)) (json-text (field case 'b)) (field case 'input) (field case 'bits)
                                                                  (json-text (field case 'text)) (if (field case 'error) "#t" "#f")) " ") ")\n")) cases)))
    (define (run-control label source data count)
      (let ((record (checked label (append (list (tool-name "CHEZ" "scheme") "--script" source) (if data (list data) '())))))
        (when count (assert-equal (field record 'stdout) (string-append (number->string count) "\n"))) record))
    (define (check-domain)
      (let* ((cases (rows (read-json (path-join (library-root) "tests/sfir-numbers/domain.json"))))
             (data (write-source "domain-input.scm" (case-data cases))))
        (write-json (build-path "domain-oracle.json") (list->vector cases))
        (run-control "domain-chez" (control "domain.scm") data (length cases))))

    ;; ---- Every binary64 text byte agrees with the static Rust reference ----

    (define (check-formatting)
      (let* ((source (read-text (path-join (library-root) "src/lib.rs")))
             (start (string-contains source "fn float_text("))
             (end (string-contains source "// ---- Tests ----" start))
             (body (substring-cursor source start end))
             (reference (fixture "sfir-numbers" "format-reference.rs"))
             (binary (path "tests/target/release/format-reference")) (data (build-path "format-input.txt")))
        (assert-that (starts? (read-text reference) (string-append body "fn main()")) "static Rust formatter reference drifted")
        (write-bytes data (read-bytes (fixture "sfir-numbers" "format-input.txt")))
        (checked "format-reference-build" (list (tool-name "CARGO" "cargo") "build" "--offline" "--release" "--quiet"
                                                "--manifest-path" (path "tests/Cargo.toml") "--target-dir" (path "tests/target") "--bin" "format-reference")
                 `((environment . ,(native-cargo-environment (path "build/native-runtime")))))
        (let* ((reference (lines (command-output "format-reference-run" (list binary data))))
               (actual (lines (field (run-control "format-chez" (control "format.scm") data #f) 'stdout)))
               (bits (lines (read-text data))))
          (assert-equal (length actual) (length bits)) (assert-equal reference actual "complete Rust/Chez formatting comparison")
          (write-json (build-path "format-comparison.json") `((cases . ,(length bits)) (mismatches . #())))
          (map (lambda (bits text)
                 `((label . ,(string-append "binary64-" bits)) (operation . 1) (a . "") (b . "10")
                   (input . ,(number->string (string->number bits 16))) (bits . "0") (text . ,text) (error . #f))) bits reference))))
    (define (scalar-tsv cases)
      (apply string-append (map (lambda (case) (string-append (join (map (lambda (key) (number-text (field case key)))
                                                                         '(operation a b input bits text)) "\t") "\n")) cases)))
    (define (check-scalar-abi cases runtime)
      (let* ((wasm (build-path "scalar.wasm")) (native (build-path "scalar-native"))
             (valid (filter (lambda (case) (not (field case 'error))) cases))
             (failures (filter (lambda (case) (field case 'error)) cases)))
        (write-json (build-path "scalar-valid.json") (list->vector valid))
        (checked "scalar-compile" (list (path-join (target-root) "scripts/build-sfir") "--export" "probe" (fixture "sfir-numbers" "bridge.sfir") wasm))
        (for-each (lambda (form)
                    (let ((linked (build-path (string-append "scalar-" form "-linked.wasm"))))
                      (checked (string-append "scalar-" form "-link")
                               (append (list (path-join (target-root) "scripts/link-sfir-runtime") "--runtime" runtime)
                                       (if (string=? form "raw") '("--diagnostic-prune-only") '())
                                       (list (if (string=? form "raw") (string-append wasm ".raw.wasm") wasm) linked)))
                      (checked (string-append "scalar-" form) (node (path-join (target-root) "tests/sfir-numbers/oracle.mjs") linked (build-path "scalar-valid.json")))
                      (indexed-for-each (lambda (index case)
                                          (let ((data (build-path (string-append "scalar-failure-" (number->string index) ".json"))))
                                            (write-json data (vector (cons '(error . #f) (filter (lambda (entry) (not (eq? (car entry) 'error))) case))))
                                            (checked (string-append form "-failure-" (number->string index))
                                                     (node (path-join (target-root) "tests/sfir-numbers/oracle.mjs") linked data)
                                                     `((status . error) (error . ,(field case 'message)))))) failures))) '("raw" "optimized"))
        (build-native wasm native (path-join (target-root) "tests/sfir-numbers/oracle.rs")
                      (list (list "oracle" (path-join (target-root) "tests/sfir-integer/oracle-provider.rs"))))
        (write-text (build-path "scalar-valid.tsv") (scalar-tsv valid))
        (checked "scalar-native" (list native (build-path "scalar-valid.tsv")))
        (indexed-for-each (lambda (index case)
                            (let ((data (write-source (string-append "scalar-failure-" (number->string index) ".tsv") (scalar-tsv (list case)))))
                              (checked (string-append "scalar-native-failure-" (number->string index)) (list native data)
                                       `((status . error) (error . ,(field case 'message)))))) failures)))

    ;; ---- Complete adapted reader streams and canonical benchmark controls ----

    (define (check-benchmark! stdout name)
      (let ((records (filter (lambda (line) (starts? line "+!CSVLINE!+")) (lines stdout))))
        (assert-equal (length records) 1)
        (let ((fields (string-split (substring (car records) 11) #\,)))
          (assert-equal (length fields) 3) (assert-equal (car fields) "chez")
          (assert-equal (car (string-split (cadr fields) #\:)) name)
          (let ((seconds (string->number (caddr fields)))) (assert-that (and seconds (finite? seconds) (> seconds 0)))))))
    (define (check-reader-controls benchmarks)
      (let ((cases (field (read-json (fixture "sfir-reader" "cases.json")) 'valid)))
        (for-each (lambda (case)
                    (let* ((name (symbol->string (car case))) (sources (cdr case))
                           (original (if (vector? sources) (vector-ref sources 1) sources))
                           (adapted (if (vector? sources) (vector-ref sources 0) sources))
                           (observations (map (lambda (system text)
                                                (let ((directory (build-path "reader-controls" name system)))
                                                  (create-directory* directory) (write-text (path-join directory "input.scm") text)
                                                  (command-output (string-append name "-" system)
                                                                  (list (tool-name "CHEZ" "scheme") "--script"
                                                                        (if (string=? system "original") (fixture "sfir-reader" "oracle.scm") (control "reader.scm")))
                                                                  `((directory . ,directory))))) '("original" "adapted") (list original adapted))))
                      (assert-equal (car observations) (cadr observations) name))) cases))
      (for-each (lambda (name)
                  (let* ((static (path-join benchmarks "benchmarks/sfir" name)) (data (read-bytes (path-join static "input.txt"))))
                    (for-each (lambda (system)
                                (let* ((directory (build-path "reader-controls" name system))
                                       (program (path-join static (string-append "chez-" system ".scm")))
                                       (before (read-bytes program)))
                                  (create-directory* (path-join directory "inputs")) (write-bytes (path-join directory "input.txt") data)
                                  (for-each (lambda (file) (write-bytes (path-join directory "inputs" file)
                                                                        (read-bytes (path "benchmarks/r7rs-benchmarks/inputs" file)))) '("sum1.data" "parsing.data"))
                                  (write-bytes (path-join directory "control.scm") before)
                                  (write-json (path-join directory "source.json") `((path . ,program) (sha256 . ,(file-sha256 program))))
                                  (check-benchmark! (command-output (string-append name "-" system)
                                                                    (list (tool-name "CHEZ" "scheme") "--script" program) `((directory . ,directory) (input . ,(utf8->string data)))) name)
                                  (assert-equal (read-bytes program) before))) '("original" "adapted")))) '("sum1" "read1" "parsing")))
    (define (run-chez-bridge)
      (check-profile!) (freeze-sources! "sfir-numbers")
      (check-domain)
      (let ((cases (append (rows (read-json (fixture "sfir-numbers" "scalar-cases.json"))) (check-formatting))))
        (write-json (build-path "scalar-oracle.json") (list->vector cases))
        (let ((source (write-source "scalar-input.scm" (case-data cases))))
          (run-control "scalar-chez" (control "scalar.scm") source (length cases)))
        (run-control "ownership-chez" (control "ownership.scm") #f #f)
        (when (argument-present? "--runtime") (check-scalar-abi cases (argument-value "--runtime" #f)))
        (when (argument-present? "--reader-root") (check-reader-controls (argument-value "--reader-root" #f)))
        (complete! "static Chez Number, exact formatting and scalar ownership controls" `((passed . #t) (cases . ,(length cases))))))))
