;; Public commands and compiled build programs execute their existing fixtures.
(define-library (snail-tests commands)
  (export run-command-suite optimizer-scope)
  (import
   (scheme base)
   (scheme cxr)
   (scheme file)
   (scheme process-context)
   (scheme write)
   (srfi 1)
   (only (chibi ast) setenv unsetenv)
   (lofi host json)
   (chibi pathname)
   (chibi regexp)
   (chibi regexp pcre)
   (only (chibi string) string-split string-suffix? call-with-input-string)
   (snail-tests harness))
  (begin

    ;; ---- Explicit fixture programs and provider objects ----

    (define (assemble suite name source)
      (checked (string-append name "-assemble") (list (tool-name "WASM_AS" "wasm-as") "--enable-mutable-globals"
                                                      (fixture suite (string-append source ".wat")) "-o" (build-path (string-append name ".wasm")))))
    (define (fixture-host suite name . arguments)
      (checked name (apply chibi (fixture suite (string-append name ".scm")) arguments)))
    (define (fixture-node suite name . arguments)
      (checked name (apply node (fixture suite (string-append name ".mjs")) arguments)))

    (define (merge-provider guest provider module linked)
      (checked "provider-link" (append (list (tool-name "WASM_MERGE" "wasm-merge")) binaryen-features
                                       (list guest "program" provider module "-o" linked))))
    (define (build-test-harness!)
      (checked "test-harness" (list (tool-name "CARGO" "cargo") "build" "--offline" "--quiet"
                                    "--manifest-path" (path "tests/Cargo.toml") "--target-dir" (path "tests/target"))
               '()))
    (define (optimizer-scope operation . expected)
      (build-test-harness!)
      (let* ((optimizer (car (lines (command-output "find-optimizer" (list "which" (tool-name "WASM_OPT" "wasm-opt"))))))
             (log (build-path "optimizer.jsonl")) (wrapper (path "tests/target/debug/optimizer-probe")))
        (write-text log "")
        (let* ((environment `(("WASM_OPT" . ,wrapper) ("LOFI_TEST_OPTIMIZER" . ,optimizer) ("LOFI_TEST_OPTIMIZER_LOG" . ,log)))
               (previous (map (lambda (entry) (cons (car entry) (get-environment-variable (car entry)))) environment)))
          (dynamic-wind
              (lambda () (for-each (lambda (entry) (setenv (car entry) (cdr entry))) environment))
              (lambda () (parameterize ((test-environment (append environment (test-environment)))) (operation)))
              (lambda () (for-each (lambda (entry) (if (cdr entry) (setenv (car entry) (cdr entry)) (unsetenv (car entry)))) previous))))
        (let ((records (map (lambda (line) (call-with-input-string line json-read)) (lines (read-text log)))))
          (assert-that (every (lambda (row) (member (if (null? expected) "-O3" (car expected))
                                                    (strings (field row 'command)))) records) records)
          records)))
    (define (run-entry)
      (let ((optimizations (optimizer-scope (lambda () (fixture-host "lofi-entry" "build" (output))))))
        (assert-equal (length optimizations) 2 "both public entry artifacts use optimization"))
      (assemble "lofi-entry" "provider" "provider")
      (for-each (lambda (name)
                  (let ((linked (build-path (string-append name ".linked.wasm"))))
                    (merge-provider (build-path (string-append name ".wasm")) (build-path "provider.wasm") "entry.test" linked)
                    (fixture-node "lofi-entry" "run" linked))) '("main" "another")))
    (define (run-execution)
      (fixture-host "lofi-execution" "build" (output))
      (for-each (lambda (name) (assemble "lofi-execution" name name)) '("provider" "wrong-provider" "callback-provider" "start" "mutable-import"))
      (fixture-node "lofi-execution" "run" (output)))
    (define (run-binaryen)
      (let ((original (build-path "original.wasm")) (optimized (build-path "optimized.wasm")))
        (checked "assemble" (append (list (tool-name "WASM_AS" "wasm-as") (path "tests/binaryen-groups.wat"))
                                    binaryen-features (list "-g" "-o" original)))
        (checked "optimize" (append (list (tool-name "WASM_OPT" "wasm-opt") original) binaryen-features
                                    (list "-g" "-O3" "--closed-world" "--always-inline-max-function-size=40" "--converge" "-o" optimized)))
        (for-each (lambda (artifact) (checked (path-strip-directory artifact) (node (path "tests/binaryen-groups.mjs") artifact)))
                  (list original optimized))))

    ;; ---- Published book examples execute on both Wasm forms ----

    (define (book-blocks)
      (let loop ((remaining (lines (read-text (path "doc/book/lofi/index.md")))) (active? #f) (text '()) (result '()))
        (cond ((null? remaining) (reverse result))
              ((string=? (car remaining) "```scheme") (loop (cdr remaining) #t '() result))
              ((and active? (string=? (car remaining) "```")) (loop (cdr remaining) #f '() (cons (string-append (join (reverse text) "\n") "\n") result)))
              (else (loop (cdr remaining) active? (if active? (cons (car remaining) text) text) result)))))
    (define (book-case name text conversions)
      (let* ((directory (build-path name)) (source (path-join directory "program.sld"))
             (wasm (path-join directory "program.wasm")))
        (create-directory* directory) (write-text source text)
        (build-guest source wasm (if conversions '("convert") '()) (list "-I" (path "examples")))
        (for-each (lambda (artifact) (fixture-node "lofi-book" "run" artifact (json-text (list->vector (or conversions '())))))
                  (list wasm (string-append wasm ".raw.wasm")))))
    (define (run-book)
      (let ((blocks (book-blocks)) (data (read-json (fixture "lofi-book" "cases.json"))))
        (assert-equal (length blocks) 2 "review executable book overview structure")
        (book-case "fibonacci" (string-append (car blocks) (field data 'fibonacci)) #f)
        (book-case "colors" (string-append (cadr blocks) (field data 'colors)) #f)
        (book-case "conversion" (read-text (fixture "lofi-book" "conversion.sld")) (rows (field data 'conversions)))))

    ;; ---- Public command status, publication, cleanup and standard input ----

    (define (public-command label arguments . options)
      (apply checked label (append (list (path "lofi")) arguments) options))
    (define (command-source name text) (write-source (string-append name ".sld") (string-append text "\n")))
    (define (compile-command-source label source destination checks options)
      (public-command label (append (list "compile" "-o" destination) options (list source)) checks))
    (define (execute-command-source label source arguments checks options)
      (public-command label (append '("run") options (list source) arguments) checks))
    (define (check-public-command)
      (for-each (lambda (case)
                  (let ((source (command-source (car case) (string-append "(import (lofi primitive))\n" (cadr case)))))
                    (execute-command-source (car case) source
                                            '("--help" "-I" "" "a b") `((status . ,(caddr case))) '())))
                '(("default-integer" "42" 42) ("answer with space" "(ann 42 I64)" 42) ("too-large" "(ann 256 I64)" 1)
                  ("negative" "(ann -1 I64)" 1) ("unit" "(ref-set! (ref (ann 0 I64)) (ann 1 I64))" 0)))
      (let* ((destination (build-path "published.wasm"))
             (valid (command-source "valid" "(ann 42 I64)")))
        (compile-command-source "publish" valid destination '() '())
        (let ((before (read-bytes destination)))
          (compile-command-source "publish-type-failure" (command-source "float" "1.5") destination
                                  '((status . 1) (error . "command result must be")) '())
          (assert-equal (read-bytes destination) before)
          (compile-command-source "publish-tool-failure" valid destination
                                  '((status . 1) (error . "wasm-opt") (environment . (("WASM_OPT" . "/missing/wasm-opt")))) '())
          (assert-equal (read-bytes destination) before))
        (checked "published-execute" (node (path "scripts/run-lofi.mjs") destination) '((status . 42))))
      (let* ((destination (build-path "cleanup.txt"))
             (source (command-source "cleanup"
                                     (string-append "(import (lofi base) (lofi io))\n(def port (open-output-file " (json-text destination) "))\n"
                                                    "(write-string \"buffered before trap\" port)\n(vector-ref (vector (ann 1 I64)) (ann 2 I64))"))))
        (execute-command-source "cleanup" source '() '((status . 1)) '())
        (assert-equal (read-text destination) "buffered before trap"))
      (let* ((destination (build-path "stdin.wasm"))
             (host (node (path "scripts/run-lofi.mjs") destination)))
        (compile-command-source "stdin-build" (fixture "lofi" "standard-input.sld") destination '() '())
        (for-each (lambda (text) (checked "stdin-execute" host `((input . ,text) (stdout . ,text)))) '("λ😀\n\x0;é" ""))))
    (define (check-command-profile flags expected)
      (let ((records (optimizer-scope
                      (lambda ()
                        (public-command (string-append "generated-command" expected)
                                        (append '("run") flags
                                                (list "-I" (path "examples/generation")
                                                      (path "examples/generation/main.sld"))) '((status . 42))))
                      expected)))
        (assert-equal (length records) 3 "producer, guest and final link share the selected profile")))
    (define (run-public-command)
      (public-command "help" '("--help") '((environment . (("CHIBI" . "/missing/chibi") ("WASM_OPT" . "/missing/wasm-opt")))))
      (public-command "target-rejected" '("run" "--target" "native" "unused.sld") '((status . 1) (error . "--target")))
      (for-each (lambda (case) (check-command-profile (car case) (cadr case)))
                '((() "-O1") (("--debug") "-O1") (("--release") "-O3")))
      (check-public-command)
      (let ((source (command-source "protected" "(ann 42 I64)")))
        (public-command "protect-source" (list "compile" "-o" source source) '((status . 1) (error . "must not replace")))
        (assert-equal (read-text source) "(ann 42 I64)\n")))

    ;; ---- Executable recipes retain separate producer and application providers ----

    (define (generation-build source name options errors)
      (let ((record (checked name (append (list (path "scripts/build-lofi") "-I" (fixture "lofi-generation" "lib")) options
                                          (list source (build-path (string-append name ".wasm"))))
                             `((status . ,(if (null? errors) 0 'error))))))
        (for-each (lambda (message) (assert-that (contains? (field record 'stderr) message) record message)) errors)))
    (define (recipe name body imports)
      (write-source (string-append "bad/" name ".sld")
                    (string-append "(generate-library (bad " name ") (import " imports ") " body ")\n")))
    (define (provider-closed! name)
      (let* ((records (map (lambda (line) (call-with-input-string line json-read)) (lines (read-text (build-path "providers.jsonl")))))
             (last (take-right records 2)))
        (assert-equal (map (lambda (record) (field record 'action)) last) '("open" "close"))
        (for-each (lambda (record) (assert-equal (strings (field record 'libraryKey)) (list "bad" name))) last)))
    (define (generation-failures)
      (for-each (lambda (case)
                  (let* ((name (car case)) (source (recipe name (cadr case) (caddr case)))
                         (errors (cadddr case)))
                    (generation-build source name '() (append errors (if (string=? name "ill-typed") '() (list name))))))
                '(("wrong-result" "(ann 0 I64)" "" ("cannot unify" "I64"))
                  ("wrong-closure" "(lambda () 42)" "" ("cannot unify"))
                  ("missing-producer" "42" "(missing producer)" ("Lofi library not found" "(missing producer)"))
                  ("missing-output" "(importing-library \"(bad missing-output)\" \"(missing generated)\")" "(producer make)" ("Lofi library not found" "(bad missing-output)" "(missing generated)" "missing-output.sld#generated"))
                  ("ill-typed" "(ill-typed-library \"(bad ill-typed)\")" "(producer make)" ("ill-typed.sld#generated:2:"))
                  ("wrong-name" "(constant-library \"(other name)\" 42)" "(producer make)" ("generated library name does not match recipe" "(other name)"))
                  ("not-library" "\"(def value 42)\"" "" ("generated text must contain one define-library form"))
                  ("unparsable" "\"(define-library (bad unparsable)\"" "" ("cannot parse Lofi source" "unparsable.sld#generated"))
                  ("ordinary-body" "(def local 42)" "" ("declaration is not an expression"))))
      (let ((source (write-source "bad/grammar.sld" "(generate-library (bad grammar) (import) 1 2)\n")))
        (generation-build source "grammar" '() (list "one import clause and one expression" source)))
      (let ((source (write-source "cycle.sld" "(import (cycle a))\n42\n")) (directory (build-path "cycles")))
        (write-source "cycles/cycle/a.sld" "(define-library (cycle a) (import (cycle b)))\n")
        (write-source "cycles/cycle/b.sld" "(generate-library (cycle b) (import (cycle a)) 0)\n")
        (generation-build source "mixed-cycle" (list "-I" directory) '("cyclic library preparation" "(cycle a) (cycle b) (cycle a)" "cycle/a.sld" "cycle/b.sld"))
        (write-source "cycles/cycle/a.sld" "(generate-library (cycle a) (import (cycle b)) 0)\n")
        (generation-build source "producer-cycle" (list "-I" directory) '("cyclic library preparation" "(cycle a) (cycle b) (cycle a)")))
      (let ((source (recipe "self" "(importing-library \"(bad self)\" \"(bad self)\")" "(producer make)")))
        (generation-build source "generated-cycle" '() (list "cyclic library preparation" "(bad self) (bad self)" source))))
    (define (generation-selection)
      (let* ((source (write-source "selection.sld" "(import (chosen value))\n42\n"))
             (selected (write-source "first/chosen/value.sld" "(define-library (wrong name))\n"))
             (options (list "-I" (build-path "first") "-I" (build-path "second"))))
        (write-source "second/chosen/value.sld" "(define-library (chosen value))\n")
        (generation-build source "selected-name" options (list "library name does not match import" selected))
        (write-text selected "(define-library (chosen value) (unsupported-clause))\n")
        (generation-build source "selected-malformed" options (list "expected an import, export or library body clause" selected))
        (write-text selected "(generate-library (wrong recipe) (import) 42)\n")
        (generation-build source "selected-recipe-name" options (list "library name does not match import" selected))
        (write-source "first/lofi/command.sld" "(define-library (lofi command) (export answer) (begin (def answer (lambda () 42))))\n")
        (public-command "anonymous-key" (list "run" "-I" (build-path "first")
                                              (write-source "anonymous-key.sld" "(import (lofi command))\n(answer)\n")) '((status . 42)))))
    (define (generation-provider-failures)
      (let ((options (list "--generation-provider" (fixture "lofi-generation" "providers.mjs"))))
        (for-each (lambda (case)
                    (let ((source (recipe (car case) (cadr case) (caddr case))))
                      (generation-build source (car case) options (list "Lofi library generation failed" (cadddr case) source))
                      (provider-closed! (car case))))
                  '(("trap" "(begin (unreachable) (constant-library \"(bad trap)\" 42))" "(producer make) (only (lofi primitive) unreachable)" "unreachable")))
        (let ((broken (write-source "broken-providers.mjs" "export function createProviders() { return {providers: null, close() { throw new Error('cleanup sentinel'); }}; }")))
          (generation-build (recipe "broken" "(constant-library \"(bad broken)\" 42)" "(producer make)") "broken" (list "--generation-provider" broken)
                            '("provider factory must return a provider Map" "cleanup sentinel")))
        (let ((reserved (write-source "reserved-providers.mjs" "export function createProviders() { return {providers: new Map([['lofi:generator', null]]), close() {}}; }")))
          (generation-build (recipe "reserved" "(constant-library \"(bad reserved)\" 42)" "(producer make)") "reserved" (list "--generation-provider" reserved)
                            '("provider module lofi:generator is reserved")))
        (let ((provider (write-source "null-provider.mjs" "import {readFileSync} from 'node:fs'; export function createProviders() { const module = new WebAssembly.Module(readFileSync(new URL('./provider.wasm', import.meta.url))); const provider = new WebAssembly.Instance(module, {host: {offset() { throw null; }}}); return {providers: new Map([['tests.source', provider]]), close() { throw new Error('cleanup after null'); }}; }")))
          (generation-build (recipe "null-primary" "(constant-library \"(bad null-primary)\" (read-offset))" "(producer make) (producer services)")
                            "null-primary" (list "--generation-provider" provider) '("Caused by: null" "cleanup after null")))
        (generation-build (recipe "no-provider" "(constant-library \"(bad no-provider)\" (read-offset))" "(producer make) (producer services)")
                          "no-provider" '() '("missing Wasm provider: tests.source" "no-provider.sld"))))
    (define (run-generation)
      (parameterize ((test-environment (cons (cons "LOFI_GENERATION_TEST_OUTPUT" (output)) (test-environment))))
        (write-text (build-path "providers.jsonl") "")
        (for-each (lambda (name) (assemble "lofi-generation" name name)) '("provider" "consumer"))
        (fixture-host "lofi-generation" "build" (root) (output)) (fixture-node "lofi-generation" "run" (output))
        (execute-command-source "generated-command" (path "examples/generation/main.sld") '()
                                '((status . 42)) (list "-I" (path "examples/generation")))
        (execute-command-source "source-context" (write-source "source-context.sld" "(import (generated offset))\n(value)\n") '()
                                '((status . 7)) (list "--generation-provider" (fixture "lofi-generation" "providers.mjs")
                                                      "-I" (fixture "lofi-generation" "lib")))
        (generation-failures) (generation-selection) (generation-provider-failures)))

    ;; ---- Compiler-host trace JSON and abandoned prefix behavior ----

    (define (run-chromium-trace)
      (let* ((directory (make-build-directory (output) "trace files "))
             (command (chibi (fixture "lofi" "host-trace.scm"))))
        (checked "trace-complete" (append command (list directory)) '((stdout . "trace file checks passed\n")))
        (let* ((outer (rows (read-json (path-join directory "outer.json"))))
               (inner (rows (read-json (path-join directory "inner.json"))))
               (empty (rows (read-json (path-join directory "empty.json"))))
               (name "quote\" slash\\ line\n tab\t λ\x0;"))
          (assert-equal (car outer) (car inner)) (assert-equal (car inner) (car empty))
          (assert-equal (length empty) 1) (assert-equal (field (car outer) 'name) "thread_name")
          (assert-equal (field (field (car outer) 'args) 'name) "Scheme")
          (assert-equal (map (lambda (event) (field event 'name)) (cdr outer)) (list name "zero" "single" "after" "outer"))
          (assert-equal (map (lambda (event) (field event 'name)) (cdr inner)) '("inner"))
          (for-each (lambda (event)
                      (assert-equal (field event 'ph) "X") (assert-equal (field event 'pid) 1) (assert-equal (field event 'tid) 1)
                      (assert-that (and (exact-integer? (field event 'ts)) (>= (field event 'ts) 0)
                                        (exact-integer? (field event 'dur)) (>= (field event 'dur) 0)))) (append (cdr outer) (cdr inner)))
          (let ((parent (last outer)))
            (for-each (lambda (event) (assert-that (<= (field parent 'ts) (field event 'ts) (+ (field parent 'ts) (field parent 'dur)))))
                      (drop-right (cdr outer) 1))))
        (checked "trace-abort" (append command (list directory "abort")) '((status . error) (stdout . "") (error . "expected failure")))
        (let* ((prefix (read-text (path-join directory "outer.json")))
               (events (rows (call-with-input-string (string-append prefix "\n]") json-read))))
          (assert-that (not (string-suffix? "]" (car (reverse (lines prefix))))))
          (assert-equal (map (lambda (event) (field event 'name)) events) '("thread_name" "completed")))
        (checked "trace-directory-failure" (append command (list (path-join directory "absent"))) '((status . error) (stdout . "")))
        (checked "trace-unbound" (append command '("unbound")) '((status . error) (stdout . "") (error . "chromium-trace: no active with-chromium-trace-to scope")))))

    ;; ---- Ordered complete backend execution ----

    (define (backend-command suite)
      (append (if (field suite 'script)
                  (list (path "scripts" (field suite 'script)))
                  (chibi (path "tests/run.scm") (root) (field suite 'suite)))
              (strings (field suite 'arguments #()))))
    (define (selected-backend-suites)
      (let* ((suites (rows (read-json (path "tests/backend-suites.json"))))
             (names (map (lambda (suite) (field suite 'name)) suites))
             (selected (argument-positionals)))
        (assert-that (pair? suites) "backend suite inventory is empty")
        (assert-equal (length names) (length (delete-duplicates names)) "duplicate backend suites")
        (assert-equal (length selected) (length (delete-duplicates selected)) "duplicate selected suites")
        (for-each (lambda (name) (assert-that (member name names) "unknown backend suite" name)) selected)
        (filter (lambda (suite) (or (null? selected) (member (field suite 'name) selected))) suites)))
    (define (run-backend)
      (let* ((suites (selected-backend-suites))
             (names (list->vector (map (lambda (suite) (field suite 'name)) suites))))
        (write-json (build-path "selection.json") `((suites . ,names)))
        (for-each (lambda (suite)
                    (checked (field suite 'name) (backend-command suite) '((timeout . 7200)))) suites)
        (complete! "backend suites" `((suites . ,names)))))
    (define (run-command-suite suite)
      (cond ((string=? suite "build") (run-public-command)) ((string=? suite "backend") (run-backend))
            ((string=? suite "binaryen") (run-binaryen)) ((string=? suite "lofi-entry") (run-entry))
            ((string=? suite "lofi-execution") (run-execution))
            ((string=? suite "lofi-book") (run-book)) ((string=? suite "lofi-generation") (run-generation))
            ((string=? suite "chromium-trace") (run-chromium-trace))
            (else (error "unknown test suite" suite))))))
