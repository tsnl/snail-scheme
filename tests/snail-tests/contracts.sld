;; Syntax, inference and initialization contracts retain both Wasm forms.
(define-library (snail-tests contracts)
  (export run-contract-suite)
  (import
   (scheme base)
   (scheme cxr)
   (scheme char)
   (scheme write)
   (srfi 1)
   (only (chibi string) string-suffix? call-with-output-string)
   (srfi 95)
   (chibi pathname)
   (chibi regexp)
   (chibi regexp pcre)
   (snail-tests harness))
  (begin

    ;; ---- Located rejections and complete case inventories ----

    (define (matches? pattern text) (and (regexp-search (pcre->regexp pattern) text) #t))
    (define (compiler-script script) (path-join (argument-value "--compiler" (root)) "scripts" script))
    (define (diagnostic? record source pattern located?)
      (and (positive? (field record 'status))
           (any (lambda (line)
                  (and (or (not located?)
                           (and (contains? line (path-strip-directory source))
                                (matches? ":[0-9]+:[0-9]+:" line)))
                       (matches? (string-append "(?i)" pattern) line)))
                (lines (string-append (field record 'stdout) (field record 'stderr))))))
    (define (retained-cases cases check)
      (let ((results '()))
        (for-each
         (lambda (case)
           (let* ((name (field case 'name))
                  (result (guard (failure (else `((name . ,name) (passed . #f)
                                                  (error . ,(call-with-output-string (lambda (port) (write failure port)))))))
                            (check case))))
             (set! results (append results (list result)))
             (write-json (build-path "results.json") (list->vector results))
             (display (if (field result 'passed) "PASS " "FAIL ")) (display name) (newline))) cases)
        (write-json (build-path "completion.json")
                    `((completed . ,(length results))
                      (failed . ,(list->vector (map (lambda (row) (field row 'name))
                                                    (filter (lambda (row) (not (field row 'passed))) results))))))
        (assert-that (every (lambda (row) (field row 'passed)) results) "compiler contract failures" (build-path "results.json"))))
    (define (check-inventory! suite cases)
      (let ((names (map (lambda (case) (field case 'name)) cases))
            (files (filter (lambda (file) (string-suffix? ".sld" file)) (directory-files (fixture suite)))))
        (assert-equal (length names) (length (delete-duplicates names)) "duplicate fixture names")
        (assert-equal (sort names string<?)
                      (sort (map path-strip-extension files) string<?) "fixture inventory differs" suite)))
    (define (integration-case suite case)
      (let* ((name (field case 'name))
             (source (fixture suite (string-append (field case 'source name) ".sld")))
             (wasm (build-path (string-append name ".wasm")))
             (exports (field case 'exports '()))
             (names (if (vector? exports) (strings exports) (map (lambda (entry) (symbol->string (car entry))) exports)))
             (record (invoke (string-append name "-compile")
                             (append (list (compiler-script "build-lofi") source wasm "--library" (fixture suite))
                                     (append-map (lambda (name) (list "--export" name)) names)))))
        (if (field case 'error)
            `((name . ,name) (compile . ,record)
              (passed . ,(diagnostic? record (field case 'diagnostic_source source)
                                      (field case 'error) (field case 'located #t))))
            (begin
              (assert-equal (field record 'status) 0 name record)
              (for-each
               (lambda (suffix)
                 (let ((artifact (string-append wasm suffix)))
                   (assert-that (file-exists? artifact) "missing compiled artifact" artifact)
                   (if (string=? suite "lofi-extern")
                       (checked (string-append name suffix "-run")
                                (node (fixture suite "run.mjs") (build-path "provider.wasm") artifact name))
                       (checked (string-append name suffix "-run")
                                (node (fixture suite "run.mjs") artifact (field case 'result) (json-text exports))))))
               '(".raw.wasm" ""))
              `((name . ,name) (compile . ,record) (passed . #t)
                (source_sha256 . ,(file-sha256 source)) (module_sha256 . ,(file-sha256 wasm))
                (raw_module_sha256 . ,(file-sha256 (string-append wasm ".raw.wasm"))))))))
    (define (run-integration suite)
      (let ((cases (rows (read-json (fixture suite "cases.json")))))
        (unless (string=? suite "lofi-extern") (check-inventory! suite cases))
        (when (string=? suite "lofi-extern")
          (checked "provider-assemble" (list (tool-name "WASM_AS" "wasm-as")
                                             (fixture suite "provider.wat") "-o" (build-path "provider.wasm"))))
        (let ((selected (argument-positionals)))
          (unless (null? selected)
            (for-each (lambda (name) (assert-that (any (lambda (case) (string=? name (field case 'name))) cases)
                                                  "unknown case" name)) selected)
            (set! cases (filter (lambda (case) (member (field case 'name) selected)) cases))))
        (write-json (build-path "selection.json")
                    `((manifest_sha256 . ,(file-sha256 (fixture suite "cases.json")))
                      (cases . ,(list->vector (map (lambda (case) (field case 'name)) cases)))))
        (retained-cases cases (lambda (case) (integration-case suite case)))))

    ;; ---- Explicit syntax fixtures generated as ordinary data ----

    (define (run-syntax-contracts)
      (let* ((data (read-json (fixture "lofi" "contracts.json")))
             (cases (append-map
                     (lambda (group)
                       (map (lambda (entry) `((name . ,(symbol->string (car entry)))
                                              (source . ,(vector-ref (cdr entry) 0)) (expected . ,(vector-ref (cdr entry) 1))
                                              (rejected . ,(eq? group 'fail)))) (field data group))) '(pass fail))))
        (for-each (lambda (entry)
                    (let ((target (build-path "lib" (symbol->string (car entry)))))
                      (create-directory* (path-directory target)) (write-text target (string-append (cdr entry) "\n"))))
                  (field data 'modules))
        (retained-cases cases
                        (lambda (case)
                          (let* ((name (field case 'name)) (text (field case 'source))
                                 (source (write-source (string-append name ".sld")
                                                       (string-append (if (starts? text "(define-library") "" "(import (lofi primitive))\n") text "\n")))
                                 (wasm (build-path (string-append name ".wasm")))
                                 (record (invoke name (list (compiler-script "build-lofi") "-I" (build-path "lib") source wasm))))
                            (if (field case 'rejected)
                                (assert-that (and (not (zero? (field record 'status)))
                                                  (contains? (field record 'stderr) (field case 'expected))) case record)
                                (begin (assert-equal (field record 'status) 0 case record)
                                       (checked (string-append name "-run") (node (fixture "lofi" "run.mjs") wasm (field case 'expected)))))
                            `((name . ,name) (passed . #t) (rejected . ,(field case 'rejected))))))))

    ;; ---- Instance ordering, recursive readiness and literal boundaries ----

    (define (check-instance suite name expected history)
      (let* ((directory (build-path name)) (wasm (path-join directory "program.wasm"))
             (raw (string-append wasm ".raw.wasm")) (native (path-join directory "program.native")))
        (create-directory* directory)
        (checked (string-append name "-compile")
                 (list (compiler-script "build-lofi") "--export" "observed" (fixture suite (string-append name ".sld")) wasm))
        (for-each (lambda (artifact)
                    (checked (string-append name (if (string=? artifact raw) "-raw" "-optimized"))
                             (node (fixture "lofi-instances" "run.mjs") artifact expected history))) (list raw wasm))
        (build-native raw native (fixture "lofi-instances" "entry.rs")
                      (list (list "instance.probe" (fixture "lofi-instances" "probe.rs"))))
        (native-guest-identical! native wasm)
        (let ((record (checked (string-append name "-native") (list native)
                               `((status . ,(if (string=? expected "trap") 1 0))
                                 (environment . (("SNAIL_NATIVE_GC_INTERVAL" . "1")))))))
          (assert-equal (field record 'stdout)
                        (apply string-append (map (lambda (digit) (string-append "effect:" (string digit) "\n")) (string->list history))))
          (assert-equal (field record 'stderr) (if (string=? expected "trap") "WebAssembly trap\n" "")))
        `((name . ,name) (passed . #t) (expected . ,expected) (history . ,history)
          (raw . ,(file-sha256 raw)) (optimized . ,(file-sha256 wasm)) (native . ,(file-sha256 native)))))
    (define (infer-rejection suite name pattern)
      (let* ((source (fixture suite (string-append name ".sld")))
             (record (invoke name (chibi (fixture "lofi-recursion" "infer.scm")
                                         (argument-value "--compiler" (root)) source (build-path (string-append name ".trace.json"))))))
        (assert-that (diagnostic? record source pattern #t) name record)
        `((name . ,name) (passed . #t) (status . ,(field record 'status)))))
    (define recursion-rejections
      '(("inferred-self" . "occurs check") ("inferred-mutual" . "occurs check")
        ("annotated-self" . "occurs check") ("annotated-mutual" . "occurs check")
        ("annotated-narrowing" . "recursive use cannot specialize") ("independent-binders" . "recursive use cannot specialize")
        ("phantom-instantiation" . "occurs check") ("nested-rigid" . "recursive use cannot specialize|rigid type escapes|type mismatch")
        ("phantom-local" . "type mismatch") ("expansive-shared" . "type mismatch")
        ("annotated-expansive" . "recursive use cannot specialize") ("rigid-body" . "recursive use cannot specialize")))
    (define (run-ordered-suite suite)
      (let* ((cases (cond ((string=? suite "lofi-instances")
                           '(("initialization" "42" "12345") ("unused-forward-alias" "trap" "1")
                             ("trapping-expression" "trap" "12") ("ordinary-calls" "42" "12345678")))
                          ((string=? suite "lofi-recursion")
                           '(("generic-groups" "42" "123") ("safe-values" "42" "123")
                             ("early-value" "trap" "12") ("early-capture" "trap" "1")))
                          (else '(("defaults" "42" "1") ("any-projection" "trap" "1")))))
             (rejections (cond ((string=? suite "lofi-recursion") recursion-rejections)
                               ((string=? suite "lofi-instances")
                                (map (lambda (name) (cons name "type mismatch; cannot unify"))
                                     '("wrong-result" "immediate-parameter" "named-parameter" "aliased-parameter")))
                               (else
                                (map (lambda (file)
                                       (let ((name (path-strip-extension file)))
                                         (cons name (cond ((member name '("reject-default-range" "reject-any-range")) "integer literal is outside representation range")
                                                          ((string=? name "reject-overload") "no compatible overload signature")
                                                          (else "type mismatch; cannot unify")))))
                                     (filter (lambda (file) (and (starts? file "reject-") (string-suffix? ".sld" file)))
                                             (directory-files (fixture suite))))))))
        (let ((results (map (lambda (entry) (infer-rejection suite (car entry) (cdr entry))) rejections)))
          (for-each (lambda (case) (set! results (append results (list (apply check-instance suite case))))
                            (write-json (build-path "results.json") (list->vector results))) cases)
          (when (string=? suite "lofi-instances")
            (let* ((wasm (build-path "former-forward-alias.wasm")) (native (build-path "former-forward-alias.native")))
              (build-guest (fixture "lofi-integration" "typeclass-member-initializer.sld") wasm '())
              (for-each (lambda (artifact) (checked "former-forward-alias" (node (fixture "lofi-integration" "run.mjs") artifact "trap")))
                        (list wasm (string-append wasm ".raw.wasm")))
              (build-native (string-append wasm ".raw.wasm") native (fixture "lofi-instances" "entry.rs")
                            (list (list "instance.probe" (fixture "lofi-instances" "probe.rs"))))
              (native-guest-identical! native wasm)
              (checked "former-forward-alias-native" (list native) '((status . 1) (stdout . "") (error . "WebAssembly trap"))))))))
    (define (run-contract-suite suite)
      (cond ((string=? suite "lofi") (run-syntax-contracts))
            ((member suite '("lofi-integration" "lofi-extern" "lofi-conformance-audit")) (run-integration suite))
            (else (run-ordered-suite suite))))))
