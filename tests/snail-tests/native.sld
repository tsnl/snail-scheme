;; Actual native execution checks instruction, ABI, GC and resource contracts.
(define-library (snail-tests native)
  (export run-native-suite)
  (import (scheme base) (scheme cxr) (scheme char) (scheme file) (scheme write) (scheme process-context)
          (srfi 1) (chibi pathname) (chibi regexp) (chibi regexp pcre)
          (only (chibi process) execute fork waitpid)
          (only (chibi filesystem) symbolic-link-file)
          (snail-tests streams) (rename (snail-tests harness) (checked checked-command)))
  (begin

    (define (checked label command . options)
      (let* ((options (if (null? options) '() (car options)))
             (stdout (field options 'stdout ""))
             (record (checked-command label command
                                      (filter (lambda (entry) (not (and (eq? (car entry) 'stdout) (not (cdr entry))))) options))))
        (when stdout (assert-equal (field record 'stdout) stdout label))
        (when (and (zero? (field record 'status)) (field options 'stderr #t))
          (assert-equal (field record 'stderr) "" label))
        record))

    ;; ---- Deterministic LLVM, V8 parity and every native trap ----

    (define (native-fixture source name options)
      (let ((native (build-path name)))
        (checked (string-append name "-build") (append (list (path "scripts/build-native")) options (list source native))) native))
    (define (check-array-access-traps native)
      (for-each (lambda (case)
                  (for-each (lambda (operation)
                              (checked (string-append "array-access-" (car case) "-" (number->string operation))
                                       (list native "storage-access-trap" (car case) operation)
                                       '((status . 1) (error . "WebAssembly trap"))))
                            (cdr case)))
                '(("null" 0 1 2) ("i31" 0 1 2) ("empty" 1 2) ("upper" 1 2))))
    (define (run-semantics)
      (checked "emit-semantics" (chibi (path "tests/build-native-datums.scm") (output)))
      (assert-equal (read-bytes (build-path "semantics.ll")) (read-bytes (build-path "semantics-again.ll")))
      (checked "assemble-semantics" (append (list (tool-name "WASM_AS" "wasm-as")) binaryen-features
                                            (list (build-path "semantics.wat") "-o" (build-path "semantics.wasm"))))
      (checked "v8-semantics" (node (path "tests/check-native-semantics.mjs") (build-path "semantics.wasm") (build-path "saturation.json")))
      (let* ((entry (path "tests/native-runner.rs"))
             (native (native-fixture (build-path "semantics.ll") "semantics" (list "--llvm" "--entry-rust" entry))))
        (checked "semantics" (list native) '((environment . (("SNAIL_NATIVE_GC_INTERVAL" . "1")))))
        (indexed-for-each (lambda (index sample)
                            (checked (string-append "saturation-" (number->string index)) (list native "saturate" (field sample 'input))
                                     `((stdout . ,(string-append (join (strings (field sample 'results)) " ") "\n")))))
                          (read-json (build-path "saturation.json")))
        (for-each (lambda (kind) (checked (string-append "trap-" (number-text kind)) (list native kind)
                                          '((status . 1) (error . "WebAssembly trap")))) (append (iota 13) '("subtype-trap")))
        (for-each (lambda (kind) (checked (string-append "storage-trap-" (number->string kind)) (list native "storage-trap" kind)
                                          '((status . 1) (error . "WebAssembly trap")))) (iota 5))
        (check-array-access-traps native)
        (let ((stress (native-fixture (build-path "semantics-stress.ll") "semantics-stress" (list "--llvm" "--entry-rust" entry))))
          (checked "semantics-stress" (list stress) '((environment . (("SNAIL_NATIVE_TAIL_STRESS" . "1"))))))
        (let ((optimized (native-fixture (build-path "semantics.wasm") "optimized-semantics" (list "--wasm" "--entry-rust" entry))))
          (checked "optimized-semantics" (list optimized) '((environment . (("SNAIL_NATIVE_GC_INTERVAL" . "1")))))
          (check-array-access-traps optimized)
          (for-each (lambda (kind) (checked (string-append "optimized-storage-trap-" (number->string kind)) (list optimized "storage-trap" kind)
                                            '((status . 1) (error . "WebAssembly trap")))) (iota 5)))))
    (define (run-element-segments)
      (for-each (lambda (case)
                  (let* ((length (car case)) (offset (cadr case)) (elements (caddr case)) (traps? (cadddr case))
                         (name (join (list "element" (number->string length) (number->string offset) (if (string=? elements "") "empty" "nonempty")) "-"))
                         (wat (write-source (string-append name ".wat")
                                            (string-append "(module (table " (number->string length) " funcref) (func $f) (elem (i32.const "
                                                           (number->string offset) ") func " elements ") (func (export \"size\") (result i32) (table.size 0))"
                                                           " (func (export \"main\") (result i32) (i32.const 0)))\n")))
                         (wasm (build-path (string-append name ".wasm"))))
                    (checked (string-append name "-assemble") (append (list (tool-name "WASM_AS" "wasm-as")) binaryen-features (list wat "-o" wasm)))
                    (let* ((native (native-fixture wasm name '("--wasm")))
                           (optimized (native-guest-path native)))
                      (checked (string-append name "-v8")
                               (list (tool-name "NODE" "node") "-e"
                                     "const fs=require('fs');WebAssembly.instantiate(fs.readFileSync(process.argv[1])).catch(e=>{if(e instanceof WebAssembly.RuntimeError)process.exit(1);throw e;});" optimized)
                               `((status . ,(if traps? 1 0))))
                      (checked name (list native) (append `((status . ,(if traps? 1 0))) (if traps? '((error . "WebAssembly trap")) '()))))))
                '((0 0 "" #f) (0 1 "" #t) (0 -1 "" #t) (1 0 "$f" #f) (1 1 "$f" #t))))
    (define (native-build-command source name directory)
      (append (list "env")
              (map (lambda (entry) (string-append (car entry) "=" (cdr entry))) (test-environment))
              (list (string-append "SNAIL_PROCESS_RECORD=" (path-join directory "process.json"))
                    (cdr (assoc "SNAIL_NATIVE_SUPERVISOR" (test-environment))) "--command" "900000" "--"
                    "sh" "-c" "exec \"$@\" >\"$0/stdout\" 2>\"$0/stderr\"" directory
                    (path "scripts/build-native") "--wasm" source (build-path name))))
    (define (spawn-native-build source name)
      (let* ((directory (make-build-directory (build-path "commands") (string-append name "-build-")))
             (command (native-build-command source name directory)))
        (write-json (path-join directory "command.json") (list->vector command))
        (let ((pid (fork)))
          (assert-that pid "cannot fork concurrent native build")
          (when (zero? pid)
            ;; Chibi's emergency-exit calls libc exit: inherited buffered input
            ;; can seek the parent's script. Replace the child image immediately.
            (execute (car command) command) (emergency-exit 127))
          (list pid directory))))
    (define (check-concurrent-build child)
      (let ((directory (cadr child)) (status (caddr child)))
        (write-json (path-join directory "terminal.json") `((wait_status . ,status)))
        (assert-equal status 0 "concurrent native build" directory)
        (let ((record (read-json (path-join directory "process.json"))))
          (assert-that (field record 'descendants_gone) "concurrent build cleanup" directory)
          (assert-that (not (field record 'timed_out)) "concurrent build timed out" directory)
          (assert-equal (rows (field record 'unexpected_descendants)) '() "concurrent build descendants" directory))
        (for-each (lambda (stream) (assert-equal (read-text (path-join directory stream)) "" directory stream)) '("stdout" "stderr"))))
    (define (run-concurrent-builds)
      ;; Distinct guest objects must remain distinct in the shared Cargo target.
      (let ((children (map (lambda (pair) (spawn-native-build (build-path (car pair)) (cadr pair)))
                           '(("element-0-0-empty.wasm" "concurrent-valid") ("element-0-1-empty.wasm" "concurrent-trap")))))
        (for-each check-concurrent-build
                  (map (lambda (child) (append child (list (cadr (waitpid (car child) 0))))) children)))
      (checked "concurrent-valid" (list (build-path "concurrent-valid")))
      (checked "concurrent-trap" (list (build-path "concurrent-trap")) '((status . 1) (error . "WebAssembly trap"))))

    ;; ---- Literal Rust scalar declarations establish the provider contract ----

    (define (run-providers)
      (let ((options (list "--rust-provider" "fixture" (path "tests/native-mixed.rs"))))
        (checked "mixed" (list (native-fixture (path "tests/native-mixed.sfir") "mixed" options)))
        (let ((source (write-source "wrong-signature.sfir"
                                    "(import (sfir primitive))\n(define-extern f \"fixture\" \"scalar_i32\" (-> I64 I64))\n(f (ann 1 I64))\n")))
          (checked "signature-rejected" (append (list (path "scripts/build-native")) options (list source (build-path "wrong-signature")))
                   '((status . 1) (error . "native provider signature does not match Wasm import")))
          (assert-that (not (file-exists? (build-path "wrong-signature"))))))
      (for-each (lambda (case)
                  (let ((provider (write-source "unsupported-provider.rs" (car case))))
                    (checked "unsupported-provider" (list (path "scripts/build-native") "--rust-provider" "bad" provider
                                                          (path "tests/native-mixed.sfir") (build-path "bad-provider"))
                             `((status . error) (error . ,(cadr case))))))
                '(("#[unsafe(export_name = \"f\")] pub extern \"C\" fn f(value: *const i32) -> i32 { 0 }" "unsupported native Rust scalar type")
                  ("#[unsafe(export_name = \"f\")] pub unsafe extern \"C\" fn f(value: i32, ...) -> i32 { 0 }" "unsupported Rust parameter declaration")
                  ("#[unsafe(export_name = \"f\")] pub extern \"system\" fn f(value: i32) -> i32 { value }" "unsupported Rust export declaration syntax")
                  ("#[unsafe(export_name = \"f\")] pub extern \"C\" fn f(value: bool) -> i32 { 0 }" "unsupported native Rust scalar type")))
      (let* ((exports '("worker" "round32" "view64" "view32"))
             (native (native-fixture (fixture "sfir-extern" "round.sfir") "round"
                                     (append (list "--entry-rust" (path "tests/native-round.rs")) (append-map (lambda (name) (list "--export" name)) exports)))))
        (checked "round" (list native)))
      (for-each (lambda (case)
                  (let ((native (native-fixture (fixture "sfir-integration" (string-append (car case) ".sfir")) (car case) '())))
                    (checked (car case) (list native) `((status . ,(cadr case)) (environment . (("SNAIL_NATIVE_GC_INTERVAL" . "1")))))))
                '(("data-native-fields" 12) ("data-tree" 14) ("data-gcbench" 62) ("data-empty-cases" 42)
                  ("string-literals" 42) ("string-block-literal" 42) ("bytevector-builtins" 42) ("bytevector-utf8" 42)
                  ("direct-self-environment" 42))))
    (define (bytevector-entry source names)
      (let* ((declarations
              (map (lambda (name index)
                     (let* ((match (regexp-search (pcre->regexp (string-append "\\(def\\s+" name "\\s+\\(->\\s+(I64|Bool|Unit)\\s*\\)")) source))
                            (kind (regexp-match-submatch match 1)) (type (cond ((string=? kind "I64") " -> i64") ((string=? kind "Bool") " -> i32") (else ""))))
                       (string-append "#[link_name = \"wasm." name "\"] fn probe" (number->string index) "()" type ";"))) names (iota (length names))))
             (calls (map (lambda (name index) (string-append "\"" name "\" => { probe" (number->string index) "(); },")) names (iota (length names)))))
        (string-append "#[path = " (json-text (path "tests/native-support.rs")) "] mod support;\nunsafe extern \"C\" { #[link_name=\"wasm.main\"] fn guest_main()->i64;\n"
                       (join declarations "\n") "}\nfn main(){ let a=support::initialize(); assert_eq!(a.len(),2); unsafe {assert_eq!(guest_main(),42); match a[1].as_str(){"
                       (join calls "\n") "_=>panic!(\"unknown probe\")}} support::finish(0);}\n")))
    (define (run-bytevector-traps)
      (for-each (lambda (case)
                  (let ((name (field case 'name)))
                    (when (member name '("bytevector-errors" "bytevector-utf8-errors"))
                      (let* ((names (map (lambda (entry) (symbol->string (car entry)))
                                         (filter (lambda (entry) (string=? (cdr entry) "trap")) (field case 'exports))))
                             (source (fixture "sfir-integration" (string-append name ".sfir")))
                             (entry (write-source (string-append name "-entry.rs") (bytevector-entry (read-text source) names)))
                             (native (native-fixture source name (append (list "--entry-rust" entry) (append-map (lambda (name) (list "--export" name)) names)))))
                        (for-each (lambda (export) (checked (string-append name "-" export) (list native export)
                                                            '((status . 1) (error . "WebAssembly trap") (environment . (("SNAIL_NATIVE_GC_INTERVAL" . "1")))))) names)))))
                (rows (read-json (fixture "sfir-integration" "cases.json")))))

    ;; ---- Owned file resources are observed before every process exit ----

    (define (observe native name arguments releases failure? environment prepare)
      (let ((directory (make-build-directory (output) (string-append name "-"))))
        (prepare directory)
        (checked name (append (list native) arguments)
                 `((directory . ,directory) (status . ,(if failure? 1 0))
                   (environment . ,(append environment `(("SNAIL_NATIVE_CLEANUP_LOG" . ,(path-join directory "released")) ("SNAIL_NATIVE_GC_INTERVAL" . "1"))))))
        (assert-equal (string->number (car (lines (read-text (path-join directory "released"))))) releases name)
        directory))
    (define (run-native-io)
      (let* ((native (native-fixture (fixture "sfir-io" "output.sfir") "io"
                                     (append (list "--entry-rust" (path "tests/native-io-runner.rs"))
                                             (append-map (lambda (name) (list "--export" name)) io-exports))))
             (nothing (lambda (directory) #f)))
        (observe native "normal" '() 3 #f '() nothing)
        (let ((directory (observe native "unicode" '("unicode") 1 #f '() nothing)))
          (assert-equal (read-bytes (path-join directory "λ😀.txt")) (string->utf8 "\x0;λ😀\x10ffff;\n")))
        (for-each (lambda (value)
                    (let ((directory (observe native "number" (list "number" value) 1 #f '() nothing)))
                      (assert-equal (read-text (path-join directory "number.txt")) (string-append value "\n"))))
                  '("-9223372036854775808" "9223372036854775807" "9007199254740993" "-1" "0"))
        (let ((directory (observe native "trap" '("trap") 1 #t '() nothing)))
          (assert-equal (read-text (path-join directory "trap.txt")) "buffered"))
        (for-each (lambda (case) (observe native (car case) (list (car case)) (cadr case) #t '() nothing))
                  '(("missing" 0) ("character" 0) ("handle" 0) ("alias" 1)))
        (let ((directory (observe native "io-error" '("io-error") 2 #t '()
                                  (lambda (directory) (assert-that (symbolic-link-file "/dev/full" (path-join directory "first.txt")))))))
          (assert-that (contains? (read-text (field (read-json (build-path "io-error.json")) 'stderr_path)) "No space left on device"))
          (assert-equal (read-text (path-join directory "second.txt")) "second"))
        (for-each (lambda (environment) (observe native "initialization-failure" '() 0 #t environment nothing))
                  '((("SNAIL_GC_HEAP_BYTES" . "1")) (("SNAIL_GC_INITIAL_BYTES" . "1"))
                    (("SNAIL_GC_INITIAL_BYTES" . "65536") ("SNAIL_GC_HEAP_BYTES" . "32768"))))
        (let* ((exhaust (native-fixture (path "tests/native-exhaust.sfir") "exhaust"
                                        (list "--export" "read-huge" "--entry-rust" (path "tests/native-lifecycle.rs"))))
               (directory (observe exhaust "exhaust" '() 1 #t '(("SNAIL_GC_HEAP_BYTES" . "32768")) nothing)))
          (assert-equal (read-text (path-join directory "exhaust.txt")) "buffered before exhaustion"))))
    (define (input-observe native label contents arguments releases failure?)
      (observe native (string-append "input-" label) arguments releases failure? '()
               (lambda (directory)
                 (let ((target (path-join directory "λ😀.txt")))
                   (if contents (write-bytes target contents) (create-directory* target))))))
    (define (run-native-input)
      (let* ((native (native-fixture (fixture "sfir-io" "input.sfir") "input"
                                     (append (list "--entry-rust" (path "tests/native-input-runner.rs"))
                                             (append-map (lambda (name) (list "--export" name)) input-exports))))
             (cases (append '(("" "" 0) ("\n" "\n" 1) ("\n\n" "\n\n" 2) ("last" "last\n" 1)
                              ("last\r" "last\n" 1) ("\r" "\n" 1) ("first\nlast\n" "first\nlast\n" 2)
                              ("a\rb\r\nc\n\r\n\rfinal" "a\nb\nc\n\n\nfinal\n" 6)
                              ("\x0;λ😀\x10ffff;\n\t\x85;\x2028;\x2029;" "\x0;λ😀\x10ffff;\n\t\x85;\x2028;\x2029;\n" 2))
                            (map (lambda (length) (let ((line (make-string length #\😀)))
                                                    (list (string-append line "\r\nend") (string-append line "\nend\n") 2)))
                                 '(1 63 64 65 127 128 129 4095 4096 4097 65537)))))
        (indexed-for-each (lambda (index case)
                            (let ((directory (input-observe native (number->string index) (string->utf8 (car case)) (list "copy" (caddr case)) 2 #f)))
                              (assert-equal (read-bytes (path-join directory "lines.txt")) (string->utf8 (cadr case))))) cases)
        (input-observe native "ownership" (string->utf8 "same\nsame\n") '("ownership") 3 #f)
        (for-each (lambda (case) (input-observe native (car case) (string->utf8 "line\n") (list (car case)) (cadr case) #t))
                  '(("alias" 1) ("missing" 0) ("trap" 1) ("output" 1) ("stale" 1) ("handle" 0) ("peek" 0)))
        (indexed-for-each (lambda (index contents)
                            (let ((directory (input-observe native (string-append "invalid-" (number->string index)) contents '("invalid") 2 #t)))
                              (assert-equal (read-text (path-join directory "buffered.txt")) "released after read failure")))
                          (list #u8(255) #u8(240 159) #u8(13 255) #f)))
      (let ((native (native-fixture (fixture "sfir-io" "input-main-trap.sfir") "input-main-trap"
                                    (list "--entry-rust" (path "tests/native-lifecycle.rs")))))
        (input-observe native "main-trap" (string->utf8 "line\n") '() 1 #t)))
    (define (run-build-ownership)
      (let ((source (write-source "ownership/main.sfir" "42\n")) (destination (build-path "ownership/application"))
            (alias (build-path "ownership/source-alias")))
        (write-text destination "previous executable")
        (checked "publication-failure" (list (path "scripts/build-native") source destination)
                 '((status . 1) (error . "missing or unusable") (environment . (("WASM_OPT" . "/missing/wasm-opt")))))
        (assert-equal (read-text destination) "previous executable")
        (assert-that (symbolic-link-file source alias))
        (checked "protect-source-alias" (list (path "scripts/build-native") source alias)
                 '((status . 1) (error . "must not replace an input")))))
    (define (run-native-suite)
      (run-semantics) (run-element-segments) (run-concurrent-builds)
      (checked "collector-contracts" (list (tool-name "CARGO" "cargo") "test" "--offline" "--features" "native-runtime"
                                           "--manifest-path" (path "wasm-native/Cargo.toml"))
               `((stdout . #f) (stderr . #f) (environment . ,(native-cargo-environment (path "build/native-runtime")))))
      (run-providers) (run-bytevector-traps) (run-native-io) (run-native-input) (run-build-ownership)
      (checked "instance-ordering" (chibi (path "tests/run.scm") (root) "sfir-instances") '((stdout . #f)))
      (freeze-sources! "native")
      (complete! "native semantics, collection, ABI, traps, files and ownership" '((passed . #t) (actual_native_execution . #t))))))
