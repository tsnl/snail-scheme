;; Opaque Scheme handles exercise real independently owned native processes.
(define-library (snail-tests native-loading)
  (export run-native-loading native-loading-lost-host)
  (import (scheme base) (scheme cxr) (scheme file) (scheme inexact) (scheme write)
          (srfi 1) (srfi 18) (chibi bytevector) (only (chibi ast) gc)
          (only (chibi filesystem) rename-file)
          (only (chibi string) call-with-output-string string-split)
          (chibi regexp) (chibi regexp pcre)
          (wasm-native execute) (only (snail-tests commands) optimizer-scope) (snail-tests harness))
  (begin

    ;; ---- Explicit linking and retained owned-instance evidence ----

    (define (providers)
      (list (make-rust-provider "probe" (fixture "lofi-native-loading" "provider.rs")) (runtime-provider)))
    (define (linked name . selected)
      (link-native (load-native (read-bytes (build-path (string-append name ".o"))))
                   (if (null? selected) (providers) (car selected)) (output) (runtime-root)))
    (define (environment name)
      `(("SNAIL_NATIVE_GC_INTERVAL" . "1") ("SNAIL_GC_STATS" . "1")
        ("SNAIL_TEST_EFFECTS" . ,(build-path (string-append name "-effects")))
        ("SNAIL_TEST_CHILD" . ,(build-path (string-append name "-child")))
        ("SNAIL_TEST_RESOURCE" . ,(build-path (string-append name "-resource")))))
    (define (instance linked name . extra)
      (instantiate linked `((environment . ,(append (if (null? extra) '() (car extra)) (environment name))))))
    (define (fails thunk message)
      (let ((failed? #f))
        (guard (failure (else (set! failed? #t)
                              (assert-that (contains? (if (error-object? failure) (error-object-message failure)
                                                          (call-with-output-string (lambda (port) (write failure port)))) message)
                                           "wrong failure diagnostic" message failure))) (thunk))
        (assert-that failed? "expected failure" message)))
    (define (gone pid)
      (let loop ((attempt 0))
        (cond ((not (file-exists? (string-append "/proc/" (number->string pid)))) #t)
              ((= attempt 500) (error "owned process remains" pid))
              (else (thread-sleep! .01) (loop (+ attempt 1))))))
    (define (child-gone name)
      (gone (string->number (car (lines (read-text (build-path (string-append name "-child"))))))))
    (define (resource-closed name)
      (assert-equal (read-text (build-path (string-append name "-resource"))) "x"))
    (define (effects name)
      (map (lambda (line) (cadr (string-split line #\space))) (lines (read-text (build-path (string-append name "-effects"))))))

    ;; ---- Independent globals, closures and exact semantic scalar transport ----

    (define (check-state)
      (let* ((code (linked "state")) (first (instance code "first")) (second (instance code "second")))
        (assert-equal (map (lambda (amount) (invoke-entry first (list amount))) '(10 20 1)) '(11 31 32))
        (assert-equal (invoke-entry second '(2)) 3)
        (let ((parameters (native-code-parameters (load-native (read-bytes (build-path "state.o"))))))
          (set-car! parameters 'F64)
          (fails (lambda () (invoke-entry first '(1.0))) "scalar type")
          (assert-equal (invoke-entry first '(1)) 33))
        (for-each (lambda (item)
                    (let ((name (car item)) (owned (cdr item)))
                      (close-instance owned) (close-instance owned)
                      (fails (lambda () (invoke-entry owned '(0))) "closed")
                      (assert-equal (effects name) '("1" "2"))
                      (let ((log (read-text (path-join (instance-directory owned) "stderr"))))
                        (assert-that (regexp-search (pcre->regexp "collections=[1-9][0-9]*") log) "collection did not run" log))))
                  (list (cons "first" first) (cons "second" second))))
      (let ((third (instance (linked "state") "third")))
        (assert-equal (invoke-entry third '(2)) 3) (close-instance third)))
    (define (rounded-f32 value)
      (let ((bytes (make-bytevector 4)))
        (bytevector-ieee-single-set! bytes 0 value 'little)
        (bytevector-ieee-single-ref bytes 0 'little)))
    (define (check-scalars)
      (for-each (lambda (case)
                  (let* ((name (car case)) (code (linked name '())) (owned (instantiate code)))
                    (for-each (lambda (value)
                                (let ((actual (invoke-entry owned (list value)))
                                      (expected (if (string=? name "f32") (rounded-f32 value) value)))
                                  (if (and (real? expected) (inexact? expected))
                                      (assert-that (cond ((nan? expected) (nan? actual))
                                                         ((zero? expected) (and (zero? actual) (eqv? (< (/ 1.0 expected) 0) (< (/ 1.0 actual) 0))))
                                                         (else (= expected actual))) name value actual)
                                      (assert-equal actual expected name)))) (cadr case))
                    (for-each (lambda (value) (fails (lambda () (invoke-entry owned (list value))) "")) (caddr case))
                    (if (string=? name "unit-result") (assert-equal (invoke-entry owned '()) 'unit)
                        (fails (lambda () (invoke-entry owned '())) "parameter count"))
                    (close-instance owned)))
                (list (list "i32" '(-2147483648 0 2147483647) '(#t 2147483648 -2147483649 1.0))
                      (list "i64" '(-9223372036854775808 -9007199254740993 0 9007199254740993 9223372036854775807)
                            '(#t 9223372036854775808 -9223372036854775809 1.0))
                      (list "f32" '(0.0 -0.0 1.0000000596046448 1.401298464324817e-45 1e-50 +inf.0 -inf.0 +nan.0) '(1 1e300))
                      (list "f64" '(0.0 -0.0 5e-324 1.1 +inf.0 -inf.0 +nan.0) '(1))
                      (list "bool" '(#f #t) '(0 1))
                      (list "char" (list #\x0 #\A #\😀 (integer->char #x10ffff)) '("" "ab" 55296))
                      (list "unit-result" '() '()))))
    (define (replace-bytes source before after)
      (let ((needle (string->utf8 before)) (replacement (string->utf8 after)))
        (let loop ((at 0))
          (cond ((> (+ at (bytevector-length needle)) (bytevector-length source)) (error "metadata witness missing" before))
                ((equal? (bytevector-copy source at (+ at (bytevector-length needle))) needle)
                 (bytevector-append (bytevector-copy source 0 at) replacement
                                    (bytevector-copy source (+ at (bytevector-length needle)))))
                (else (loop (+ at 1)))))))
    (define (check-rejections)
      (let ((bytes (read-bytes (build-path "state.o"))))
        (fails (lambda () (link-native (list bytes) (providers) (output) (runtime-root))) "loaded native code")
        (fails (lambda () (link-native (load-native bytes) '() (output) (runtime-root))) "missing native provider")
        (fails (lambda () (link-native (load-native bytes)
                                       (list (make-rust-provider "probe" (fixture "lofi-native-loading" "wrong.rs"))) (output) (runtime-root))) "signature")
        (fails (lambda () (instantiate (list (linked "i32" '())))) "explicitly linked")
        (fails (lambda () (invoke-entry '() '(1))) "native instance")
        (fails (lambda () (load-native (replace-bytes bytes "\"parameters\":[\"I32\"]" "\"parameters\":[\"I64\"]"))) "bridge signature disagrees")
        (fails (lambda () (load-native (bytevector-copy bytes 0 40))) "truncated"))
      (for-each (lambda (name)
                  (let ((owned (instantiate (linked name)))) (fails (lambda () (invoke-entry owned '())) "closed"))) '("bad-bool" "bad-char"))
      (let ((owned (instantiate (linked "lowercase" (list (runtime-provider))))))
        (assert-equal (invoke-entry owned '(#\Ω)) #\ω) (close-instance owned)))

    ;; ---- Failed initialization, traps and finalization preserve owned cleanup ----

    (define (check-failure-and-lifetime)
      (fails (lambda () (instance (linked "failed") "failed")) "initialization failed")
      (assert-equal (effects "failed") '("7")) (child-gone "failed") (resource-closed "failed")
      (let* ((code (linked "traps" '())) (first (instantiate code)) (second (instantiate code)))
        (fails (lambda () (invoke-entry first '(0))) "closed")
        (fails (lambda () (invoke-entry first '(1))) "closed")
        (assert-equal (invoke-entry second '(42)) 42) (close-instance second))
      (let* ((code (linked "lifetime")) (owned (instance code "lifetime")))
        (assert-equal (invoke-entry owned '()) 42) (close-instance owned) (child-gone "lifetime") (resource-closed "lifetime")
        (let ((dropped (instance code "dropped"))) (set! dropped #f))
        (gc) (thread-sleep! .2) (gc) (child-gone "dropped") (resource-closed "dropped")))
    (define (check-constructors-and-timeouts)
      (let ((owned (instance (linked "i32") "constructor" '(("SNAIL_TEST_CONSTRUCTOR" . "1")))))
        (assert-equal (invoke-entry owned '(42)) 42) (close-instance owned) (child-gone "constructor"))
      (fails (lambda () (instantiate (linked "i32")
                                     `((timeout . .05) (environment . ,(append '(("SNAIL_TEST_CONSTRUCTOR" . "1") ("SNAIL_TEST_CONSTRUCTOR_HANG" . "1"))
                                                                               (environment "init-timeout")))))) "initialization failed")
      (child-gone "init-timeout")
      (let ((owned (instantiate (linked "hang") '((timeout . .05)))))
        (fails (lambda () (invoke-entry owned '())) "closed")))
    (define (native-loading-lost-host)
      (let ((owned (instance (linked "lifetime") "host-loss-live")))
        ;; The controller treats existence as readiness: publish a closed record.
        (write-json (build-path "host-ready.pending") (read-json (path-join (instance-directory owned) "process.json")))
        (assert-that (rename-file (build-path "host-ready.pending") (build-path "host-ready")) "cannot publish host readiness")
        (thread-sleep! 60) (close-instance owned)))
    (define (run-native-loading)
      (let ((optimizations (optimizer-scope (lambda ()
                                              (checked "build" (chibi (fixture "lofi-native-loading" "build.scm") (output)))
                                              (for-each (lambda (check) (check)) (list check-state check-scalars check-rejections check-failure-and-lifetime check-constructors-and-timeouts))))))
        (assert-that (>= (length optimizations) 2) "native and Wasm optimization evidence missing")
        ;; The compiler appends lofi.entry after its optimizer probe. Compare
        ;; the final artifact, which is the native lowering input, directly.
        (let ((artifact (read-bytes (build-path "state.wasm"))))
          (assert-equal (read-bytes (build-path "native-state/lofi.wasm")) artifact
                        "native lowering input differs from the compiler artifact")
          (assert-equal (read-bytes (build-path "native-state/optimized.wasm")) artifact
                        "native and Wasm mandatory optimized module bytes differ")))
      (checked "host-loss" (list (tool-name "CARGO" "cargo") "run" "--offline" "--quiet" "--manifest-path" (path "tests/Cargo.toml")
                                 "--bin" "native-host-loss" "--" (output) (tool-name "CHIBI" "chibi-scheme") "-I" (path "bootstrap")
                                 "-I" (path "wasm-native/scheme") "-I" (path "tests") "-I" (path "wasm-native/tests")
                                 (path "tests/run.scm") (root) "lofi-native-loading-lost-host" "--output" (output))
               `((environment . ,(native-cargo-environment (path "build/native-runtime")))))
      (complete! "native instance state, exact scalars, rejection and owned process lifetimes" '((passed . #t) (actual_native_execution . #t))))))
