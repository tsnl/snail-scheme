;; Shared assertions keep every compiler and engine invocation reviewable.
(define-library (snail-tests harness)
  (export root runtime-root output artifacts test-environment test-arguments
          path fixture build-path field rows strings assert-that assert-equal
          contains? starts? number-text json-text lines join indexed-for-each
          invoke checked command-output chibi node binaryen-features
          write-source build-guest link-forms runtime-build
          fresh-output initialize-suite! argument-value argument-present? argument-positionals
          freeze-sources! record-tools! record-artifacts! verify-reuse! complete! rust-harness
          finalize-records!
          read-text write-text read-bytes write-bytes read-json write-json file-sha256
          path-join path-directory absolute-path make-build-directory directory-files-recursive
          create-directory* directory-files file-exists? file-regular? delete-file
          option-ref tool-name)
  (import
   (scheme base)
   (scheme cxr)
   (scheme char)
   (scheme file)
   (scheme write)
   (scheme process-context)
   (scheme time)
   (scheme inexact)
   (only (chibi ast) setenv)
   (lofi host json)
   (chibi filesystem)
   (chibi pathname)
   (chibi regexp)
   (srfi 1)
   (only (chibi string) string-contains string-prefix? string-suffix? string-join string-split string-trim-right call-with-output-string)
   (srfi 95)
   (lofi host process)
   (only (lofi compiler tools host-tools) build-host-tool))
  (begin

    ;; ---- Concrete paths, options and structured evidence ----

    (define root (make-parameter #f))
    (define output (make-parameter #f))
    (define artifacts (make-parameter #f))
    (define test-arguments (make-parameter '()))
    (define test-environment (make-parameter '(("BINARYEN_CORES" . "1"))))

    (define (path . parts) (apply path-join (root) parts))
    (define (runtime-root) (path "src/runtime"))
    (define (fixture suite . parts) (apply path "tests" suite parts))
    (define (build-path . parts) (apply path-join (output) parts))
    (define (field value key . default) (option-ref value key (if (null? default) #f (car default))))
    (define (rows value) (if (vector? value) (vector->list value) value))
    (define (strings value) (map (lambda (x) (if (string? x) x (number->string x))) (rows value)))
    (define (assert-that condition . context) (unless condition (apply error "test assertion failed" context)))
    (define (assert-equal actual expected . context)
      (unless (equal? actual expected) (apply error "test values differ" actual expected context)))
    (define (contains? text fragment) (and (string-contains text fragment) #t))
    (define (starts? text prefix) (string-prefix? prefix text))
    (define (json-text value) (call-with-output-string (lambda (port) (json-write value port))))
    (define (join values separator) (string-join values separator))
    (define (lines text) (string-split (string-trim-right text #\newline) #\newline))
    (define (number-text value)
      (cond ((number? value) (number->string value)) ((boolean? value) (if value "1" "0")) (else value)))
    (define (indexed-for-each procedure values)
      (let loop ((values (rows values)) (index 0))
        (unless (null? values) (procedure index (car values)) (loop (cdr values) (+ index 1)))))
    (define (argument-value name default)
      (let ((tail (member name (test-arguments)))) (if tail (cadr tail) default)))
    (define (argument-present? name) (and (member name (test-arguments)) #t))
    (define (argument-positionals)
      (let loop ((arguments (test-arguments)) (result '()))
        (cond ((null? arguments) (reverse result))
              ((member (car arguments) '("--output" "--compiler" "--reuse-artifacts" "--only"
                                         "--library-root" "--target-root" "--runtime" "--reader-root"))
               (assert-that (pair? (cdr arguments)) "test option requires a value" (car arguments))
               (loop (cddr arguments) result))
              ((string=? (car arguments) "--domain") (loop (cdr arguments) result))
              ((starts? (car arguments) "-") (error "unknown test option" (car arguments)))
              (else (loop (cdr arguments) (cons (car arguments) result))))))
    (define (fresh-output suite)
      (make-build-directory (path "build" suite) "attempt-"))
    (define (initialize-suite! repository arguments suite)
      (root (absolute-path repository)) (test-arguments arguments)
      (output (absolute-path (argument-value "--output" (fresh-output suite))))
      (create-directory* (output))
      (let ((supervisor (build-host-tool (root) "snail-process-supervisor")))
        (current-process-supervisor supervisor)
        (test-environment (cons (cons "SNAIL_PROCESS_SUPERVISOR" supervisor) (test-environment)))))

    ;; ---- Bounded commands and complete terminal records ----

    (define (command-evidence record)
      ;; The persistent byte streams are authoritative. Keep large reader
      ;; streams out of the in-memory history and the JSON command journal.
      (filter (lambda (entry) (not (memq (car entry) '(stdout stderr stdout_hex stderr_hex)))) record))
    (define (finalize-records!)
      (write-json (build-path "commands.json") (list->vector (map command-evidence (current-command-records)))))
    (define (command-environment options)
      (let ((overrides (field options 'environment '())))
        (append overrides (filter (lambda (entry) (not (assoc (car entry) overrides))) (test-environment)))))
    (define (capture-command command options environment folder)
      (let ((captured (run-command/capture (map number-text command)
                                           `((directory . ,(field options 'directory (root))) (environment . ,environment)
                                             (log-directory . ,folder) (require-supervisor? . #t) (include-output-hex? . #f)
                                             (input . ,(field options 'input "")) (timeout . ,(field options 'timeout 900))))))
        (append `((environment . ,(map (lambda (entry) (cons (string->symbol (car entry)) (cdr entry))) environment))
                  (stdin_path . ,(path-join (path-directory (field captured 'stdout_path)) "stdin"))) captured)))
    (define (retain-command! label folder record)
      (let ((evidence (command-evidence record)))
        (current-command-records (append (current-command-records) (list evidence)))
        (write-json (path-join folder "record.json") evidence)
        (write-json (build-path (string-append label ".json")) evidence)
        (call-with-port (open-output-file/append (build-path "commands.jsonl"))
          (lambda (port) (json-write evidence port) (newline port)))))
    (define (assert-command-clean! label record)
      (assert-that (not (field record 'timeout #f)) "command timed out" label (field record 'stderr_path))
      (assert-that (field record 'descendants_gone #f) "command cleanup incomplete" label (field record 'stderr_path))
      (assert-that (null? (rows (field record 'unexpected_descendants #())))
                   "command left unexpected descendants" label (field record 'unexpected_descendants)))
    (define (invoke label command . options)
      (let* ((options (if (null? options) '() (car options)))
             (folder (make-build-directory (build-path "commands") (string-append label "-")))
             (record (capture-command command options (command-environment options) folder)))
        (retain-command! label folder record)
        (assert-command-clean! label record)
        record))
    (define (checked label command . options)
      (let* ((options (if (null? options) '() (car options)))
             (record (invoke label command options)) (expected (field options 'status 0)))
        (assert-that (if (eq? expected 'error) (not (zero? (field record 'status)))
                         (= expected (field record 'status))) label expected (field record 'status) (field record 'stderr_path))
        (when (field options 'error)
          (assert-that (contains? (field record 'stderr) (field options 'error))
                       label (field options 'error) (field record 'stderr_path)))
        (when (assq 'stdout options) (assert-equal (field record 'stdout) (field options 'stdout) label))
        record))
    (define (command-output label command . options)
      (field (apply checked label command options) 'stdout))
    (define (chibi source . arguments)
      (append (list (tool-name "CHIBI" "chibi-scheme") "-I" (path "bootstrap")
                    "-I" (path "tests") source) arguments))
    (define (node script . arguments)
      (append (list (tool-name "NODE" "node") "--disable-warning=ExperimentalWarning" "--expose-gc" script) arguments))
    (define binaryen-features
      '("--mvp-features" "--enable-gc" "--enable-reference-types" "--enable-tail-call"
        "--enable-mutable-globals" "--enable-sign-ext" "--enable-bulk-memory" "--enable-nontrapping-float-to-int"))
    (define (write-source name text)
      (let ((target (build-path name))) (create-directory* (path-directory target)) (write-text target text) target))
    (define (build-guest source wasm exports . options)
      (checked "compile" (append (list (path-join (argument-value "--compiler" (root)) "scripts/build-lofi"))
                                 (if (null? options) '() (car options))
                                 (append-map (lambda (name) (list "--export" name)) exports)
                                 (list source wasm))))

    (define (runtime-build)
      (checked "runtime" (list (tool-name "CARGO" "cargo") "rustc" "--crate-type=cdylib" "--quiet" "--offline"
                               "--release" "--target" "wasm32-wasip1"
                               "--manifest-path" (path "src/runtime/Cargo.toml")
                               "--target-dir" (path "build/wasm-runtime"))))
    (define (link-forms wasm)
      (runtime-build)
      (for-each
       (lambda (form)
         (checked (string-append form "-link")
                  (append (list (path-join (argument-value "--compiler" (root)) "scripts/link-lofi-runtime"))
                          (list "--runtime" (path "build/wasm-runtime/wasm32-wasip1/release/snail_runtime.wasm"))
                          (if (string=? form "raw") '("--diagnostic-prune-only") '())
                          (list (if (string=? form "raw") (string-append wasm ".raw.wasm") wasm)
                                (build-path (string-append form ".wasm")))))) '("raw" "optimized")))

    (define (rust-harness . arguments)
      (append (list (tool-name "CARGO" "cargo") "run" "--offline" "--quiet" "--manifest-path"
                    (path "tests/Cargo.toml") "--bin" "snail-test-data" "--") arguments))

    ;; ---- Reproducible sources, tools and compiled identities ----

    (define (snapshot-source source)
      (let* ((relative (path-relative-to source (root))) (target (build-path "sources" relative)))
        (create-directory* (path-directory target))
        (write-bytes target (read-bytes source))
        (cons (string->symbol relative) (file-sha256 target))))
    (define (freeze-sources! suite)
      (let* ((directories (list "src" "bootstrap" "tests/snail-tests"
                                (string-append "tests/" suite)))
             (paths (append-map (lambda (directory) (directory-source-files (path directory))) directories))
             (files (map path '("src/runtime/Cargo.toml" "src/runtime/Cargo.lock" "rust-toolchain.toml" "tests/run.scm"
                                "scripts/build-lofi" "scripts/build-lofi.scm"
                                "scripts/link-lofi-runtime" "scripts/link-lofi-runtime.scm"))))
        (write-json (build-path "source-identities.json")
                    (map snapshot-source (delete-duplicates (append paths files))))))
    (define (tool-identity tool)
      (let* ((name (tool-name (car tool) (cadr tool)))
             (binary (absolute-path (car (lines (command-output (string-append "find-" (car tool)) (list "which" name))))))
             (version (invoke (string-append "tool-" (car tool))
                              (list binary (if (string=? (car tool) "CHIBI") "-V" "--version")))))
        (cons (string->symbol (car tool))
              `((path . ,binary) (sha256 . ,(file-sha256 binary))
                (version . ,(string-append (field version 'stdout) (field version 'stderr)))))))
    (define (record-tools!)
      (let ((tools '(("CHIBI" "chibi-scheme") ("NODE" "node") ("CHEZ" "scheme")
                     ("WASM_AS" "wasm-as") ("WASM_OPT" "wasm-opt") ("WASM_DIS" "wasm-dis")
                     ("WASM_MERGE" "wasm-merge") ("RUSTC" "rustc") ("CARGO" "cargo"))))
        (write-json (build-path "tools.json")
                    (append (map tool-identity tools)
                            `((git_head . ,(command-output "git-head" '("git" "rev-parse" "HEAD")))
                              (git_status . ,(command-output "git-status" '("git" "status" "--porcelain=v1" "--ignore-submodules=all"))))))))
    (define (record-artifacts!)
      (write-json (build-path "artifact-identities.json")
                  (map (lambda (file) (cons (string->symbol (path-relative-to file (artifacts)))
                                            `((bytes . ,(file-size file)) (sha256 . ,(file-sha256 file)))))
                       (filter (lambda (file) (member (path-extension file) '("wasm" "wat")))
                               (directory-files-recursive (artifacts))))))
    (define (verify-reuse!)
      (for-each (lambda (entry)
                  (let ((name (symbol->string (car entry))))
                    (when (or (starts? name "src/") (starts? name "bootstrap/")
                              (member (path-extension name) '("sld" "rs"))
                              (member name '("Cargo.toml" "Cargo.lock")))
                      (assert-equal (file-sha256 (path name)) (cdr entry) "cannot reuse changed compiled source" name))))
                (read-json (path-join (artifacts) "source-identities.json")))
      (write-json (build-path "reused-artifacts.json") `((directory . ,(artifacts)) (compiled_sources_verified . #t))))
    (define (complete! message value)
      (write-json (build-path "validation.json") value)
      (display "PASS ") (display message) (display ": ") (display (output)) (newline))))
