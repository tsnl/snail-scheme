;; Read actual attachment values, before tone mapping. Left: a cutout over a
;; blended blue box and opaque green backing. Center: convex red and blue
;; shells. Right: one packed ORM image with occluded and open halves.
(define-library (gpu-test forward)
  (export forward-material-check)
  (import
   (snail core base)
   (snail shell gpu)
   (snail shell resource)
   (snail shell little-endian)
   (only (snail shell game rigid-body) V3 v3 v+ v- scaled dot cross squared unit-vector)
   (snail shell graphics pod)
   (only (snail shell graphics animation) v4 product-column unit-matrix)
   (snail shell graphics raster)
   (snail shell graphics compositor)
   (snail shell graphics still)
   (snail shell graphics gltf)
   (snail shell graphics forward scene)
   (snail shell graphics forward render)
   (only (snail shell graphics scene)
         SceneNode
         ModelNode
         GroupNode
         scene-geometry
         scene-frame
         render-scene!)
   (snail shell wire)
   (snail shell graphics forward environment)
   (only (snail shell graphics passes) Neutral))
  (begin
    (define (camera (z F32)) (→ Camera3D)
      (camera-3d (new Vec3f (x 0.0) (y 0.0) (z z)) (new Vec3f (x 0.0) (y 0.0) (z 0.0))
                 (Parallel 2.0) 3.0 0.0))
    (define (frame (gpu Gpu) (r Forward) (z F32) (shadows Bool)) (→ Bytes)
      (let ((encoder ((● gpu create-command-encoder))))
        (draw-forward gpu encoder r (camera z) 1.0 shadows)
        ((● gpu submit) (list ((● gpu finish) encoder)))
        (read-linear gpu r)))
    (define (value (bytes Bytes) (x I64) (channel I64)) (→ F64)
      (let ((at (* 4 (+ channel (* 4 (+ (* 16 96) x))))))
        (f32->f64 (bits->f32 (i64->i32 (u32 bytes at))))))
    (define (check (ok Bool) (message String)) (→ Unit)
      (unless ok (panic (string-append "forward pixel check: " message))))
    (define (coverage (f Bytes)) (→ Unit)
      (check (and (> (value f 24 0) 0.95) (< (value f 24 2) 0.07)) "covered cutout writes depth")
      (check (and (> (value f 8 1) 0.46) (> (value f 8 2) 0.46) (< (value f 8 0) 0.07))
             "hole reveals blue over zero-alpha opaque green"))
    ;; Project the same opaque backing and leaf-covered point into the camera
    ;; and cascade zero. A BLEND caster or a solid card produces the wrong Z.
    (define (check-depth (pixels Bytes) (view Camera3D) (w I64) (h I64) (x F32) (z F32)) (→ Unit)
      (let* ((p (product-column (● view view-projection) (v4 x 0.0 z 1.0)))
             (nx (/ (● p x) (● p w))) (ny (/ (● p y) (● p w)))
             (col (f32->i64 (* (+ nx 1.0) (* 0.5 (i64->f32 w)))))
             (row (f32->i64 (* (- 1.0 ny) (* 0.5 (i64->f32 h)))))
             (actual (bits->f32 (i64->i32 (u32 pixels (* 4 (+ col (* w row))))))))
        (check (< (abs (- actual (/ (● p z) (● p w)))) 0.00004)
               "camera or shadow depth disagrees with the alpha-tested silhouette")))
    (define (cutout-depths (gpu Gpu) (r Forward)) (→ Unit)
      (let* ((cam (camera 8.0)) (depth (read-plane gpu (● r target depth) 96 32 4))
             (p (new Plane (texture (● r shadow)) (view (list-ref (● r shadow-layers) 0))))
             (map (read-plane gpu p 1024 1024 4))
             (sun (list-ref (cascade-views cam (● r env sun)) 0)))
        (check-depth depth cam 96 32 -2.48 0.05)
        (check-depth depth cam 96 32 -1.52 1.05)
        (check-depth map sun 1024 1024 -2.48 0.05)
        (check-depth map sun 1024 1024 -1.52 1.05)))
    (define (painter (a Bytes) (b Bytes)) (→ Unit)
      (check (> (- (value a 48 0) (value a 48 2)) 0.20) "near red shell blends over blue")
      (check (> (- (value b 48 2) (value b 48 0)) 0.20) "blue becomes the nearer shell"))
    (define (occlusion (gpu Gpu) (r Forward) (ambient Bytes)) (→ Unit)
      (check (> (- (value ambient 88 0) (value ambient 72 0)) 0.80)
             "red ORM channel modulates ambient")
      (let* ((lit (scene-frame (camera 8.0) 96 32 1 1.0))
             (_ (set! (● lit shadows) #f))
             (_ (set! (● lit lights) (list (new DirectionalLight (direction (v3 0.0 0.0 1.0))
                                                (irradiance (v3 2.0 2.0 2.0))))))
             (_ (render-scene! r (deserialize (serialize lit))))
             (direct (read-linear gpu r)) (dark (- (value direct 72 0) (value ambient 72 0)))
             (open (- (value direct 88 0) (value ambient 88 0))))
        (check (and (> dark 0.40) (< (abs (- dark open)) 0.04)) "AO leaves direct light intact")))
    ;; The output is scaled and swizzled by the compositor. A raw byte copy
    ;; between this RGBA16F source and BGRA8 destination would be invalid.
    (define (composition (gpu Gpu)) (→ Unit)
      (let* ((input (make-plane gpu
                                "test/float"
                                1
                                2
                                (Rgba16Float)
                                (list (TextureBinding) (TextureCopyDst))))
             (output (make-plane gpu
                                 "test/bgra"
                                 3
                                 4
                                 (Bgra8Unorm)
                                 (list (RenderAttachment) (TextureCopySrc))))
             (blit (make-compositor gpu (Bgra8Unorm))) (encoder ((● gpu create-command-encoder)))
             (pixels (map (lambda (n) (i32->u8 (i64->i32 n)))
                          (list 0 60 0 52 0 56 0 60 0 0 0 60 0 0 0 60))))
        ((● gpu write-texture) (whole-texture (● input texture)) 8 1 2 (list->array pixels))
        (composite! gpu blit encoder (● input view) (● output view))
        ((● gpu submit) (list ((● gpu finish) encoder)))
        (let ((read (read-rgba gpu output 3 4)))
          (check (and (<= (abs (- (u8->i32 (array-ref read 0)) 128)) 1)
                      (= (u8->i32 (array-ref read 1)) 64)
                      (= (u8->i32 (array-ref read 2)) 255) (= (u8->i32 (array-ref read 37)) 255))
                 (string-append "scaled float-to-BGRA presentation, got "
                                (string-join
                                 (map (lambda (x) (show (u8->i32 x))) (array->list read))
                                 " "))))
        (release-plane gpu input) (release-plane gpu output) (release-compositor gpu blit)))
    (define (translated (x F32) (y F32) (z F32)) (→ Mat4x4f)
      (new Mat4x4f (x (● unit-matrix x)) (y (● unit-matrix y))
           (z (● unit-matrix z)) (w (v4 x y z 1.0))))
    (define (check-scene-graph (g Gltf)) (→ Unit)
      (let* ((child (ModelNode "box.gltf"))
             (root (GroupNode (translated 4.0 0.0 0.0)
                              (list child (GroupNode (translated 0.0 3.0 0.0) (list child)))))
             (reads (make-array 1 (ann 0 I64)))
             (copies (scene-geometry (deserialize (serialize root))
                                     (lambda (path)
                                       (check (string=? path "box.gltf") "recorded asset path")
                                       (array-set! reads 0 (+ 1 (array-ref reads 0))) g)))
             (a (gltf-bounds g)) (b (gltf-bounds copies)))
        (check
         (and (= (array-ref reads 0) 1) (= (length (● copies placed)) (* 2 (length (● g placed))))
              (= (length (● copies buffers)) (length (● g buffers)))
              (< (abs (- (- (list-ref (● b first) 0) (list-ref (● a first) 0)) 4.0)) 0.001)
              (< (abs (- (- (list-ref (● b second) 1) (list-ref (● a second) 1)) 3.0)) 0.001))
         "recorded group hierarchy composes transforms and shares model buffers")))
    (define (moving-painter (gpu Gpu) (s Scene) (env Environment) (model Gltf)) (→ Unit)
      (let* ((stage (moving-scene gpu s (map (lambda (p) (● p primitive positions count))
                                             (● model placed))))
             (r (make-forward gpu (● stage scene) env 96 32 1 (Neutral)))
             (first (frame gpu r 8.0 #f)))
        (deform-scene! gpu stage (list unit-matrix unit-matrix unit-matrix
                                       (translated 0.0 0.0 -1.6)
                                       (translated 0.0 0.0 0.8)
                                       unit-matrix))
        (painter first (frame gpu r 8.0 #f))
        (release-forward gpu r)
        (release-moving-scene gpu stage)))
    (define (forward-material-check (gpu Gpu) (resources Resources)) (→ String)
      (let* ((model (read-gltf (read-resource resources (link-file "materials.gltf")) ""))
             (s (upload-scene gpu (lambda (_) (Nil)) model)) (env (furnace-environment gpu))
             (_ (set! (● env sun) (v3 0.0 0.0 1.0)))
             (r (make-forward gpu s env 96 32 1 (Neutral)))
             (initial (frame gpu r 8.0 #t))
             (_ (cutout-depths gpu r))
             (reverse (frame gpu r -8.0 #f)))
        (check-scene-graph model)
        (coverage initial)
        (painter initial reverse)
        (occlusion gpu r initial)
        (release-forward gpu r) (moving-painter gpu s env model) (release-environment gpu env)
        (composition gpu)
        "forward: opaque, masked camera and cascade depth, sorted blend, indirect occlusion and float-to-BGRA presentation"))))
