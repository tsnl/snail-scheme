;; Script operands belong to this integration harness, not the compiler library.
(import (scheme base) (scheme process-context) (snail-scheme native)
        (snail-scheme chromium-trace) (only (snail-scheme build-host) same-file?)
        (only (chibi filesystem) create-directory*)
        (only (chibi pathname) path-directory))
(define arguments (cdr (command-line)))
(define output (list-ref arguments 2))
(define trace-file (string-append output ".trace.json"))
(if (or (same-file? (cadr arguments) trace-file) (same-file? output trace-file))
    (error "trace file must not replace build input or output" trace-file))
(create-directory* (path-directory output))
(with-chromium-trace-to trace-file (lambda () (apply build-native arguments)))
