;; Prepare one output independently, then collect and compile its consumer graph.
(import (scheme base) (scheme file) (scheme process-context) (scheme write)
        (snail-lofi source-driver) (snail-lofi compiler) (snail-lofi frontend) (snail-lofi library)
        (snail-scheme strict-primitives) (wasm-native chromium-trace))

(define root (cadr (command-line)))
(define output (car (cddr (command-line))))
(define fixture (string-append root "/tests/lofi-generation"))
(define directories (list (string-append fixture "/lib") (string-append root "/lib")))
(define base (list (cons '(lofi primitive) (make-primitive-library primitive-names))))
(define context (make-generation-context (string-append root "/scripts/run-lofi-generator.mjs")
                                         (string-append fixture "/providers.mjs")))
(define (assert truth message) (unless truth (error message)))
(define (write-compiled name libraries key export)
  (let ((artifact (compile libraries (make-entry key export))))
    (call-with-port (open-binary-output-file (string-append output "/" name ".wasm"))
      (lambda (port) (write-bytevector (artifact-bytes artifact) port)))))

(with-chromium-trace-to
 (string-append output "/prepare.json")
 (lambda ()
   (let* ((prepared (prepare-library '(generated answer) directories base context))
          (seed (cons (cons '(generated answer) prepared) base)))
     (assert (equal? (lofi-library-name prepared) '(descriptive result)) "result name became its lookup key")
     (assert (guard (failure (else (and (error-object? failure)
                                        (string=? (error-object-message failure) "Lofi library not found")
                                        (member '(generated support) (error-object-irritants failure)))))
               (collect-libraries (make-entry '(generated answer) 'value) '() seed context) #f)
             "preparation unexpectedly obtained generated imports")
     (let ((libraries (collect-libraries (make-entry '(consumer app) 'main) directories seed context)))
       (assert (eq? prepared (cdr (assoc '(generated answer) libraries))) "prepared identity changed")
       (for-each (lambda (key) (assert (not (assoc key libraries)) "producer dependency leaked into application map"))
                 '((producer make) (producer services) (generated offset) (lofi compiler-builder)))
       (assert (not (eq? (lofi-library-id prepared) (lofi-library-id (cdr (assoc '(generated support) libraries)))))
               "independently generated values with the same descriptive name merged")
       (write-compiled "application" libraries '(consumer app) 'main)
       (let ((aliases (list (cons '(alias first) prepared) (cons '(alias second) prepared))))
         (assert (eq? (prepare-library '(alias first) '() aliases #f) (prepare-library '(alias second) '() aliases #f))
                 "explicit aliases lost identity")))
     (let ((libraries (collect-libraries (make-entry '(generated hygiene) 'value) directories base
                                         (make-generation-context (string-append root "/scripts/run-lofi-generator.mjs") #f))))
       (write-compiled "hygiene" libraries '(generated hygiene) 'value)))))
