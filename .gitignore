# direnv cache and Nix build outputs
/.direnv/
/result
/result-*

# Local agent worktrees
/.claude/worktrees/

# The npm packages `make fetch` installs
/node_modules/

# Intermediate build files
/build/
/tests/**/build/

# Cargo names its output `target` relative to wherever the build ran, so
# ignore the name anywhere rather than listing each crate and each caller,
# except the target libraries, (snail target NAME).
target/
!/src/snail/target/

# Scratch from a local experiment, which nothing in the tree references.
/wasm-native/

# Khronos's glTF samples, fetched by scripts/fetch-khronos-samples.
/src/khronos/models
/src/khronos/environments
/src/apps/viewer/public/models.html
