# direnv cache and Nix build outputs
/.direnv/
/result
/result-*

# Intermediate build files
/build/
/apps/*/build/
/tests/apps/*/build/

# Cargo names its output `target` relative to wherever the build ran, so
# ignore the name anywhere rather than listing each crate and each caller.
target/

# Scratch from a local experiment, which nothing in the tree references.
/wasm-native/
