(define-library (siegework game)
  (export application-entry)
  (import
   (scheme base)
   (scheme immutable)
   (application reducer)
   (application bridge)
   (browser application)
   (siegework model)
   (siegework codec)
   (only (lofi core) ann -> I32)
   (only (lofi base) string-append i32->i64 unreachable))
  (begin

    ;; ---- Client choices and presentation constants ----

    (define tool-extractor (ann 1 I32))
    (define tool-artillery (ann 2 I32))
    (define last-column (- board-columns 1))
    (define last-row (- board-rows 1))
    (define client-schema-version (ann 1 I32))
    (define client-words (ann 4 I32))

    (define color-background (ann 1055781 I32))
    (define color-grid (ann 2373432 I32))
    (define color-deposit (ann 3244661 I32))
    (define color-economy (ann 5692863 I32))
    (define color-artillery (ann 16036940 I32))
    (define color-barrel (ann 16769709 I32))
    (define color-raider (ann 15750780 I32))
    (define color-beast (ann 13640083 I32))
    (define color-health (ann 16760503 I32))
    (define color-bot (ann 11599863 I32))
    (define color-hub (ann 14871019 I32))
    (define opacity-opaque (ann 255 I32))
    (define selection-opacity (ann 75 I32))

    (define tile-inset (ann 3 I32))
    (define tile-size (- cell-size (* 2 tile-inset)))
    (define barrel-offset-x (ann 2 I32))
    (define barrel-offset-y (ann 4 I32))
    (define barrel-width (ann 25 I32))
    (define barrel-height (ann 8 I32))
    (define beast-size (ann 44 I32))
    (define raider-size (ann 18 I32))
    (define raider-health-scale (ann 60 I32))
    (define enemy-health-gap (ann 5 I32))
    (define enemy-health-height (ann 3 I32))
    (define bot-half-size (ann 7 I32))
    (define bot-size (* 2 bot-half-size))
    (define cargo-bar-offset-y (ann 12 I32))
    (define cargo-units-per-pixel (ann 2 I32))
    (define cargo-bar-height (ann 3 I32))
    (define hub-size (ann 44 I32))
    (define hub-half-size (quotient hub-size 2))
    (define hub-health-width (ann 48 I32))
    (define hub-health-height (ann 4 I32))
    (define hub-health-offset-y (ann 30 I32))
    (define selection-inset (ann 1 I32))
    (define selection-size (- cell-size (* 2 selection-inset)))

    ;; ---- Commands are lexical bindings; all reducers return Transition World ----

    ;; Manifest generation requires literal schema versions in declarations.
    ;; Codec schema words must match these literals.
    (application match-app (state World 1) (initial-world)
                 (advance (state) (no-effects (advance-world state)))
                 (extract (state (x I32) (y I32)) (no-effects (extract-world state x y)))
                 (fortify (state (x I32) (y I32)) (no-effects (fortify-world state x y)))
                 (upgrade (state) (no-effects (upgrade-world state)))
                 (repair (state) (no-effects (repair-world state)))
                 (new-run (state) (no-effects (initial-world))))

    (define match-target (destination match-owner match-app))

    ;; ---- The client has a separate persistent owner ----

    (define-immutable-record Client make-client
      (tool I32 client-tool client-tool-set)
      (x I32 client-x client-x-set)
      (y I32 client-y client-y-set))
    (application client-app (state Client 1) (make-client tool-extractor near-deposit-x near-deposit-y)
                 (move (state (x I32) (y I32))
                       (no-effects (if (and (>= x 0) (< x board-columns) (>= y 0) (< y board-rows))
                                       (make-client (client-tool state) x y) state)))
                 (nudge (state (dx I32) (dy I32))
                        (no-effects (make-client (client-tool state)
                                                 (clamp (+ (client-x state) dx) 0 last-column)
                                                 (clamp (+ (client-y state) dy) 0 last-row))))
                 (choose (state (tool I32))
                         (no-effects (if (and (>= tool tool-extractor) (<= tool tool-artillery))
                                         (client-tool-set state tool) state)))
                 (confirm (state)
                          (transition state (list (enqueue match-target
                                                           (if (= (client-tool state) tool-extractor) (extract (client-x state) (client-y state))
                                                               (fortify (client-x state) (client-y state)))))))
                 (improve (state) (transition state (list (enqueue match-target (upgrade)))))
                 (mend (state) (transition state (list (enqueue match-target (repair)))))
                 (restart (state) (transition state (list (enqueue match-target (new-run))))))
    (define (clamp value low high) (if (< value low) low (if (> value high) high value)))
    (define (encode-client client)
      (vector client-schema-version (client-tool client) (client-x client) (client-y client)))
    (define decode-client
      (ann (lambda (words)
             (when (or (not (= (vector-ref words (i32->i64 0)) client-schema-version))
                       (< (vector-ref words (i32->i64 1)) tool-extractor)
                       (> (vector-ref words (i32->i64 1)) tool-artillery)
                       (< (vector-ref words (i32->i64 2)) 0)
                       (> (vector-ref words (i32->i64 2)) last-column)
                       (< (vector-ref words (i32->i64 3)) 0)
                       (> (vector-ref words (i32->i64 3)) last-row)) (unreachable))
             (make-client (vector-ref words (i32->i64 1))
                          (vector-ref words (i32->i64 2))
                          (vector-ref words (i32->i64 3))))
           (-> (Vector I32) Client)))

    ;; ---- Pure presentation: quads and a status string ----

    (define (rect x y w h color) (quad x y w h color opacity-opaque))
    (define (tile x y color)
      (rect (+ (* x cell-size) tile-inset) (+ (* y cell-size) tile-inset) tile-size tile-size color))
    (define (grid index)
      (if (= index board-columns) (empty-list)
          (cons (rect (* index cell-size) 0 1 board-height color-grid)
                (if (< index board-rows) (cons (rect 0 (* index cell-size) board-width 1 color-grid) (grid (+ index 1)))
                    (grid (+ index 1))))))
    (define (turret-quads turrets)
      (if (null? turrets) (empty-list)
          (let ((turret (car turrets)))
            (cons (tile (turret-x turret) (turret-y turret) color-artillery)
                  (cons (rect (+ (cell-x (turret-x turret)) barrel-offset-x)
                              (- (cell-y (turret-y turret)) barrel-offset-y) barrel-width barrel-height color-barrel)
                        (turret-quads (cdr turrets)))))))
    (define (enemy-quads enemies)
      (if (null? enemies) (empty-list)
          (let* ((enemy (car enemies)) (size (if (= (enemy-boss enemy) 1) beast-size raider-size)))
            (cons (rect (- (enemy-x enemy) (quotient size 2)) (- (enemy-y enemy) (quotient size 2))
                        size size (if (= (enemy-boss enemy) 1) color-beast color-raider))
                  (cons (rect (- (enemy-x enemy) (quotient size 2)) (- (enemy-y enemy) (+ enemy-health-gap (quotient size 2)))
                              (quotient (* size (enemy-hp enemy)) (if (= (enemy-boss enemy) 1) beast-hp raider-health-scale))
                              enemy-health-height color-health)
                        (enemy-quads (cdr enemies)))))))
    (define (economy-quads world)
      (let ((mine (world-mine world)) (bot (world-bot world)))
        (append (list (tile near-deposit-x near-deposit-y color-deposit)
                      (tile far-deposit-x far-deposit-y color-deposit))
                (if (= (mine-level mine) 0) (empty-list)
                    (list (tile (mine-x mine) (mine-y mine) color-economy)
                          (rect (- (bot-x bot) bot-half-size) (- (bot-y bot) bot-half-size) bot-size bot-size color-bot)
                          (rect (- (bot-x bot) bot-half-size) (- (bot-y bot) cargo-bar-offset-y)
                                (quotient (bot-cargo bot) cargo-units-per-pixel) cargo-bar-height color-artillery))))))
    (define (hub-quads world)
      (list (rect (- hub-x hub-half-size) (- hub-y hub-half-size) hub-size hub-size color-hub)
            (rect (- hub-x (quotient hub-health-width 2)) (+ hub-y hub-health-offset-y)
                  (quotient (* (world-hull world) hub-health-width) max-hull) hub-health-height color-economy)))
    (define (selection-quad client)
      (quad (+ (* (client-x client) cell-size) selection-inset)
            (+ (* (client-y client) cell-size) selection-inset) selection-size selection-size
            (if (= (client-tool client) tool-extractor) color-economy color-artillery) selection-opacity))
    (define (view world client)
      (append (list (rect 0 0 board-width board-height color-background))
              (append (grid 0)
                      (append (economy-quads world)
                              (append (hub-quads world)
                                      (append (turret-quads (world-turrets world))
                                              (append (enemy-quads (world-enemies world))
                                                      (list (selection-quad client)))))))))
    (define (status world client)
      (string-append
       (cond ((= (world-outcome world) outcome-lost) "HUB LOST — begin another run")
             ((= (world-outcome world) outcome-repelled) "SIEGE REPELLED — your hub survived")
             ((= (world-outcome world) outcome-exterminated) "THREAT EXTERMINATED — the field is yours")
             ((>= (world-tick world) beast-arrival-tick) "THE SIEGE BEAST HAS ARRIVED")
             ((>= (world-tick world) beast-warning-tick)
              (string-append "WARNING · giant approaching at " (integer-text (quotient beast-arrival-tick ticks-per-second)) "s"))
             (else "BUILD YOUR ECONOMY · FORTIFY THE APPROACH"))
       "\n" (integer-text (world-credits world)) " ore   ·   " (integer-text (world-hull world))
       "% hub   ·   " (integer-text (quotient (world-tick world) ticks-per-second))
       "/" (integer-text (quotient run-end-tick ticks-per-second)) "s   ·   "
       (integer-text (world-kills world)) " threats defeated"
       "   ·   cargo " (integer-text (bot-cargo (world-bot world))) "\n"
       (if (= (client-tool client) tool-extractor)
           (string-append "EXTRACTOR · " (integer-text extractor-cost) " ore · choose a turquoise deposit")
           (string-append "ARTILLERY · " (integer-text artillery-cost) " ore · protect the hub and eastern approach"))
       "   [" (integer-text (client-x client)) ", " (integer-text (client-y client)) "]"))

    ;; ---- App-owned schema codecs compose with the shared scalar driver ----

    (define game
      (program match-app client-app world-words client-words decode-world encode-world
               decode-client encode-client view status))
    (define application-entry (ann (lambda (operation a b c) (run-program game operation a b c))
                                   (-> I32 I32 I32 I32 I32)))))
