(define-library (siegework game)
  (export application-entry)
  (import
   (scheme base)
   (scheme immutable)
   (application reducer)
   (application bridge)
   (application serialization)
   (lofi serialization)
   (browser application)
   (siegework model)
   (siegework guidance)
   (siegework terrain)
   (siegework state)
   (siegework status)
   (siegework view)
   (siegework hud)
   (draw3d)
   (ui browser)
   (only (ui core) rect rect-x rect-y rect-width rect-height ui-at ui-button px)
   (only (lofi core) ann -> I32 deriving)
   (only (lofi base) i64->i32 f64->i64 round unreachable string-append))
  (begin

    ;; ---- The match owns colony orders and one deterministic clock ----

    (application match-app (state World 10) (initial-world)
                 (advance (state) (no-effects (advance-world state)))
                 (extract (state (x I32) (y I32)) (no-effects (extract-world state x y)))
                 (fortify (state (x I32) (y I32)) (no-effects (fortify-world state x y)))
                 (observe (state (x I32) (y I32)) (no-effects (observe-world state x y)))
                 (upgrade (state (x I32) (y I32)) (no-effects (upgrade-world state x y)))
                 (fabricate-worker (state) (no-effects (fabricate-world state)))
                 (set-focus (state (value I32)) (no-effects (focus-world state 0)))
                 (relocate-building (state (from I32) (to I32))
                                    (no-effects (move-world state (index-x from) (index-y from) (index-x to) (index-y to))))
                 (new-run (state) (no-effects (restart-world state)))
                 (pause-colony (state (value I32)) (no-effects (pause-world state value)))
                 (new-run-seed (state (seed I32)) (no-effects (seeded-world state seed)))
                 (cancel-building (state (x I32) (y I32)) (no-effects (cancel-world state x y)))
                 (arm-tower (state (x I32) (y I32)) (no-effects (arm-world state x y)))
                 (build-wall (state (x I32) (y I32)) (no-effects (wall-world state x y))))
    (define match-target (destination match-owner match-app))

    ;; ---- Viewport, cursor and an explicit pending site belong to the client ----

    (define-immutable-record Client make-client
      (cursor-x I32 client-x client-x-set)
      (cursor-y I32 client-y client-y-set)
      (camera-x I32 client-camera-x client-camera-x-set)
      (camera-y I32 client-camera-y client-camera-y-set)
      (width I32 client-width client-width-set)
      (height I32 client-height client-height-set)
      (chooser Bool client-chooser client-chooser-set)
      (target-x I32 client-target-x client-target-x-set)
      (target-y I32 client-target-y client-target-y-set)
      (heading I32 client-heading client-heading-set)
      (turn-from I32 client-turn-from client-turn-from-set)
      (turn-to I32 client-turn-to client-turn-to-set)
      (turn-elapsed I32 client-turn-elapsed client-turn-elapsed-set)
      (scale I32 client-scale client-scale-set)
      (preview I32 client-preview client-preview-set)
      (restart-mode I32 client-restart-mode client-restart-mode-set)
      (homing Bool client-homing client-homing-set)
      (deriving derive-serialize derive-deserialize))
    (define (initial-client)
      (make-client (+ (spawn-x 1) 4) (- (spawn-y 1) 2) (* (spawn-x 1) 1000) (* (spawn-y 1) 1000)
                   960 640 #f -1 -1 0 0 0 300 1000 0 0 #f))
    (define (client-camera state)
      (zoom-camera (client-camera-x state) (client-camera-y state) (client-heading state) (client-scale state)
                   (client-width state) (client-height state)))
    (define (target-x state) (if (client-chooser state) (client-target-x state) (client-x state)))
    (define (target-y state) (if (client-chooser state) (client-target-y state) (client-y state)))
    (define (clamp value low high) (if (< value low) low (if (> value high) high value)))
    (define (point-client state x y)
      (let* ((world (context-world)) (area (world-viewport state))
             (cell (if (and (>= x (rect-x area)) (< x (+ (rect-x area) (rect-width area)))
                            (>= y (rect-y area)) (< y (+ (rect-y area) (rect-height area))))
                       (pick-cell world (client-camera state) (- x (rect-x area)) (- y (rect-y area))
                                  (rect-width area) (rect-height area)) -1)))
        (client-y-set (client-x-set state (if (< cell 0) -1 (index-x cell)))
                      (if (< cell 0) -1 (index-y cell)))))
    (define (viewport-client state width height)
      (if (and (>= width 1) (<= width 8192) (>= height 1) (<= height 8192))
          (client-height-set (client-width-set state width) height) state))
    (define (nudge-client state dx dy)
      (client-y-set (client-x-set state (clamp (+ (client-x state) dx) 0 (- map-width 1)))
                    (clamp (+ (client-y state) dy) 0 (- map-height 1))))
    (define (camera-coordinate value) (i64->i32 (f64->i64 (round value))))
    (define (bound-fraction position delta low high)
      (let ((fraction (cond ((> delta 0.0) (/ (- high position) delta))
                            ((< delta 0.0) (/ (- low position) delta)) (else 1.0))))
        (if (< fraction 1.0) fraction 1.0)))
    ;; Stop at the first bound along this ray; independent X/Y clamping would
    ;; turn a straight screen pan into a diagonal slide along the world edge.
    (define (shift-camera state dx dy)
      (let* ((state (client-homing-set state #f)) (offset (v* (camera-pan (client-camera state) dx dy) (/ (scalar (client-scale state)) 1000.0)))
             (x (scalar (client-camera-x state))) (y (scalar (client-camera-y state)))
             (mx (vec3-x offset)) (my (- 0.0 (vec3-y offset)))
             (fx (bound-fraction x mx -3000.0 (scalar (+ (* map-width 1000) 3000)))) (fy (bound-fraction y my -3000.0 (scalar (+ (* map-height 1000) 3000))))
             (fraction (if (< fx fy) fx fy)))
        (client-camera-y-set (client-camera-x-set state (camera-coordinate (+ x (* mx fraction))))
                             (camera-coordinate (+ y (* my fraction))))))
    (define (clear-choice state)
      (client-homing-set (client-preview-set (client-chooser-set state #f) 0) #f))
    (define (choose-site state)
      (client-preview-set
       (client-target-y-set (client-target-x-set (client-chooser-set state #t) (client-x state)) (client-y state)) 0))
    (define (context-world) (decode-world (read-snapshot 1)))
    (define (send-request state request) (transition state (list (enqueue match-target request))))

    ;; ---- A click resolves against the current Scheme world, never DOM labels ----

    (define (select-site state)
      (let ((state (clear-choice state)))
        (no-effects (if (inside? (client-x state) (client-y state)) (choose-site state) state))))
    (define (selection-open? state)
      (and (= (client-restart-mode state) 0) (client-chooser state)))
    (define (hub-selected? world state)
      (and (selection-open? state) (= (target-x state) (world-hub-x world)) (= (target-y state) (world-hub-y world))))
    (define (commit-choice world state choice)
      (let* ((x (client-target-x state)) (y (client-target-y state))
             (deposit (> (deposit-rate (world-seed world) x y) 0)))
        (cond ((or (not (selection-open? state)) (< choice 1) (> choice 3) (hub-selected? world state)
                   (not (null? (building-at (world-buildings world) x y)))) (no-effects state))
              ((and deposit (= choice 1)) (send-request (clear-choice state) (extract x y)))
              (deposit (no-effects state))
              (else (send-request (clear-choice state)
                                  (cond ((= choice 1) (observe x y)) ((= choice 2) (fortify x y)) (else (build-wall x y))))))))
    (define (wrap-heading angle) (remainder (+ angle 720000) 360000))
    (define (rotate-client state unused direction)
      (let* ((desired (wrap-heading (+ (client-turn-to state) (* (clamp direction -1 1) 90000))))
             (delta (- (remainder (+ (- desired (client-heading state)) 540000) 360000) 180000))
             (delta (if (and (= delta -180000) (> direction 0)) 180000 delta)))
        (client-turn-elapsed-set
         (client-turn-to-set (client-turn-from-set state (client-heading state)) (+ (client-heading state) delta)) 0)))
    (define (animate-client state milliseconds)
      (let* ((elapsed (clamp (+ (client-turn-elapsed state) (clamp milliseconds 0 50)) 0 300))
             (t (/ (scalar elapsed) 300.0)) (ease (* (* t t) (- 3.0 (* 2.0 t))))
             (angle (+ (scalar (client-turn-from state)) (* (scalar (- (client-turn-to state) (client-turn-from state))) ease))))
        (client-heading-set (client-turn-elapsed-set state elapsed) (wrap-heading (camera-coordinate angle)))))
    (define (center-client world state)
      (let* ((site (starter-deposit world))
             (x (if (< site 0) (world-hub-x world) (index-x site)))
             (y (if (< site 0) (world-hub-y world) (index-y site))))
        (make-client x y (* x 1000) (* y 1000) (client-width state) (client-height state) #f -1 -1
                     (client-heading state) (client-turn-from state) (client-turn-to state) (client-turn-elapsed state)
                     (client-scale state) 0 0 #f)))
    (define (travel-client state x y)
      (client-homing-set (client-target-y-set (client-target-x-set
                                               (client-y-set (client-x-set (clear-choice state) x) y) x) y) #t))
    (define (home-client world state)
      (client-chooser-set (travel-client state (world-hub-x world) (world-hub-y world)) #t))
    (define (animate-home state milliseconds)
      (if (not (client-homing state)) state
          (let* ((dx (- (* (client-target-x state) 1000) (client-camera-x state)))
                 (dy (- (* (client-target-y state) 1000) (client-camera-y state)))
                 (fraction (/ (scalar (clamp milliseconds 1 50)) 120.0))
                 (close (and (> dx -10) (< dx 10) (> dy -10) (< dy 10)))
                 (mx (if close dx (camera-coordinate (* (scalar dx) fraction))))
                 (my (if close dy (camera-coordinate (* (scalar dy) fraction)))))
            (client-homing-set (client-camera-y-set (client-camera-x-set state (+ (client-camera-x state) mx))
                                                    (+ (client-camera-y state) my)) (not close)))))
    ;; Zoom uses a reciprocal Padé approximation to exp(delta/1000).
    ;; Bounds keep projection finite; neither zoom action changes the look-at.
    (define (zoom-client state delta)
      (let* ((x (/ (scalar (clamp delta -1000 1000)) 1000.0)) (square (* x x))
             (factor (/ (+ (+ 12.0 (* 6.0 x)) square) (+ (- 12.0 (* 6.0 x)) square))))
        (client-scale-set state (clamp (camera-coordinate (* (scalar (client-scale state)) factor)) 500 32000))))
    (define (request-restart state)
      (if (> (client-restart-mode state) 0) (no-effects state)
          (send-request (client-restart-mode-set (clear-choice state) (if (= (world-paused (context-world)) 1) 2 1))
                        (pause-colony 1))))
    (define (cancel-restart state)
      (let ((next (client-restart-mode-set state 0)))
        (if (= (client-restart-mode state) 1) (send-request next (pause-colony 0)) (no-effects next))))
    (define (confirm-restart state)
      (if (= (client-restart-mode state) 0) (no-effects state)
          (send-request (client-restart-mode-set (clear-choice state) 0) (new-run))))
    (application client-app (state Client 4) (initial-client)
                 (move (state (x I32) (y I32))
                       (no-effects (if (> (client-restart-mode state) 0) state (point-client state x y))))
                 (viewport (state (width I32) (height I32)) (no-effects (viewport-client state width height)))
                 (nudge (state (dx I32) (dy I32)) (no-effects (nudge-client state dx dy)))
                 (confirm (state) (if (> (client-restart-mode state) 0) (confirm-restart state) (select-site state)))
                 (activate (state) (if (> (client-restart-mode state) 0) (cancel-restart state) (select-site state)))
                 (choose (state (choice I32)) (commit-choice (context-world) state choice))
                 (improve (state) (if (selection-open? state) (send-request state (upgrade (target-x state) (target-y state))) (no-effects state)))
                 (restart (state) (request-restart state))
                 (accept-restart (state) (confirm-restart state))
                 (dismiss-restart (state) (cancel-restart state))
                 (preview (state (kind I32)) (no-effects (client-preview-set state (if (selection-open? state) (clamp kind 0 4) 0))))
                 (zoom (state (delta I32)) (no-effects (zoom-client state delta)))
                 (orbit (state) (no-effects (client-scale-set state (if (>= (client-scale state) 4000) 1000 12000))))
                 (pan (state (dx I32) (dy I32)) (no-effects (shift-camera state (* dx 1000) (* dy 1000))))
                 (drift (state (dx I32) (dy I32)) (no-effects (shift-camera state (* (clamp dx -50 50) 9) (* (clamp dy -50 50) 9))))
                 (fabricate (state) (if (hub-selected? (context-world) state) (send-request state (fabricate-worker)) (no-effects state)))
                 (focus (state (value I32)) (send-request (clear-choice state) (set-focus value)))
                 (relocate (state) (no-effects (clear-choice state)))
                 (rotate (state (elapsed I32) (direction I32)) (no-effects (rotate-client state elapsed direction)))
                 (animate (state (milliseconds I32)) (no-effects (animate-home (animate-client state milliseconds) milliseconds)))
                 (home (state) (no-effects (if (> (client-restart-mode state) 0) state (home-client (context-world) state))))
                 (center (state) (no-effects (center-client (context-world) state)))
                 (inspect-attack (state (x I32) (y I32)) (no-effects (if (inside? x y) (travel-client state x y) state)))
                 (suspend (state (value I32))
                          (if (> (client-restart-mode state) 0) (no-effects state)
                              (send-request (clear-choice state) (pause-colony (if (= value -1)
                                                                                   (if (= (world-paused (context-world)) 1) 0 1) value)))))
                 (restart-seed (state (seed I32)) (send-request (clear-choice state) (new-run-seed seed)))
                 (dismiss (state) (if (> (client-restart-mode state) 0) (cancel-restart state) (no-effects (clear-choice state))))
                 (cancel (state)
                         (if (selection-open? state)
                             (send-request (clear-choice state) (cancel-building (target-x state) (target-y state))) (no-effects state)))
                 (arm (state) (if (selection-open? state)
                                  (send-request state (arm-tower (target-x state) (target-y state))) (no-effects state))))

    ;; ---- Client schema and a complete presentation rebuilt from current state ----

    (define (encode-client client) (encode-snapshot 4 client))
    (define (validate-client client)
      (unless (and (>= (client-width client) 1) (<= (client-width client) 8192)
                   (>= (client-height client) 1) (<= (client-height client) 8192)
                   (>= (client-heading client) 0) (< (client-heading client) 360000)
                   (>= (client-turn-from client) 0) (< (client-turn-from client) 360000)
                   (>= (client-turn-to client) -180000) (<= (client-turn-to client) 540000)
                   (>= (client-turn-elapsed client) 0) (<= (client-turn-elapsed client) 300)
                   (>= (client-scale client) 500) (<= (client-scale client) 32000)
                   (>= (client-preview client) 0) (<= (client-preview client) 4)
                   (>= (client-restart-mode client) 0) (<= (client-restart-mode client) 2)
                   (>= (client-camera-x client) -3000) (<= (client-camera-x client) (+ (* map-width 1000) 3000))
                   (>= (client-camera-y client) -3000) (<= (client-camera-y client) (+ (* map-height 1000) 3000))
                   (or (and (= (client-x client) -1) (= (client-y client) -1)) (inside? (client-x client) (client-y client)))
                   (or (not (or (client-chooser client) (client-homing client)))
                       (inside? (client-target-x client) (client-target-y client)))) (unreachable))
      client)
    (define (decode-client words) (validate-client (ann (decode-snapshot words) Client)))
    (define actions
      (hud-actions choose preview suspend (confirm) (improve) (fabricate) (home) (orbit) (dismiss) (cancel) (arm)
                   (restart) (accept-restart) (dismiss-restart)))
    (define (world-viewport client)
      ;; Cards overlay the world; UI layout never changes camera or picking.
      (rect 0 0 (client-width client) (client-height client)))
    (define (client-context client camera)
      (let ((point (cell-screen-position camera (target-x client) (target-y client)
                                         (client-width client) (client-height client))))
        (hud-context (target-x client) (target-y client) (client-chooser client)
                     (client-width client) (client-height client)
                     (projected-point-x point) (projected-point-y point) (client-scale client) (client-restart-mode client))))
    (define (alert-name kind)
      (cond ((= kind 0) "Hub under attack") ((= kind 4) "Workers under attack") (else "Outpost under attack")))
    (define (recent-attacks world alerts count)
      (cond ((or (null? alerts) (= count 3)) (empty-list))
            ((< (- (world-tick world) (alert-tick (car alerts))) 80)
             (cons (car alerts) (recent-attacks world (cdr alerts) (+ count 1))))
            (else (recent-attacks world (cdr alerts) count))))
    (define (toast-width client) (if (< (client-width client) 344) (- (client-width client) 24) 320))
    (define (toast-x client) (- (- (client-width client) 24) (toast-width client)))
    (define (toast-y index) (+ 96 (* index 104)))
    (define (attack-key alert) (+ (* (cell-index (alert-x alert) (alert-y alert)) 8) (alert-kind alert)))
    (define (attack-toasts client alerts index)
      (if (null? alerts) (empty-list)
          (let ((alert (car alerts)))
            (cons (ui-at (toast-x client) (toast-y index)
                         (ui-button (string-append "attack-toast-" (integer-text (attack-key alert)))
                                    (px (toast-width client)) (px 96) (alert-name (alert-kind alert))
                                    "Click to inspect" #t #f (inspect-attack (alert-x alert) (alert-y alert))))
                  (attack-toasts client (cdr alerts) (+ index 1))))))
    (define (attack-insets world previous client alerts index)
      (unless (null? alerts)
        (let* ((alert (car alerts)) (x (alert-x alert)) (y (alert-y alert))
               (camera (zoom-camera (* x 1000) (* y 1000) (client-heading client) 400 112 80)))
          (present-scene-inset! (attack-key alert) (colony-scene world previous camera -1 -1 0)
                                (+ (+ (toast-x client) (toast-width client)) -108)
                                (+ (toast-y index) 20) 112 80)
          (attack-insets world previous client (cdr alerts) (+ index 1)))))
    (define (view world client)
      (let* ((area (world-viewport client)) (camera (client-camera client))
             (context (client-context client camera)) (layout (hud-layout world context))
             (before (decode-world (read-previous-snapshot 1)))
             (previous (if (and (= (world-seed before) (world-seed world))
                                (= (world-run-marker before) (world-run-marker world))) before world))
             (attacks (recent-attacks world (world-alerts world) 0)))
        (when (or (< (client-turn-elapsed client) 300) (client-homing client)) (request-scene-frame!))
        (present-scene-in! (colony-scene world previous camera (target-x client) (target-y client) (client-preview client))
                           (rect-x area) (rect-y area) (rect-width area) (rect-height area))
        (when (= (client-restart-mode client) 0) (attack-insets world previous client attacks 0))
        (present-ui! (destination client-owner client-app)
                     (colony-hud world context actions layout
                                 (attack-toasts client attacks 0)))
        (empty-list)))
    (define (status world client)
      (colony-status world 0 (target-x client) (target-y client) -1 -1))
    (define game (program match-app client-app 0 0 decode-world encode-world decode-client encode-client view status))
    (define application-entry
      (ann (lambda (operation a b c) (run-program game operation a b c)) (-> I32 I32 I32 I32 I32)))))
