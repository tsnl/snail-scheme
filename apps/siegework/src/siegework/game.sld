(define-library (siegework game)
  (export application-entry)
  (import
   (scheme base)
   (scheme immutable)
   (application reducer)
   (application bridge)
   (application serialization)
   (lofi serialization)
   (browser application)
   (siegework model)
   (siegework guidance)
   (siegework terrain)
   (siegework state)
   (siegework status)
   (siegework view)
   (siegework hud)
   (draw3d)
   (ui browser)
   (only (ui core) rect rect-x rect-y rect-width rect-height ui-at ui-button ui-layer ui-label px)
   (only (lofi core) ann -> I32 deriving)
   (only (lofi base) i64->i32 f64->i64 round unreachable string-append))
  (begin

    ;; ---- The match owns colony orders and one deterministic clock ----

    (application match-app (state World 10) (initial-world)
                 (advance (state) (no-effects (advance-world state)))
                 (extract (state (x I32) (y I32)) (no-effects (extract-world state x y)))
                 (fortify (state (x I32) (y I32)) (no-effects (fortify-world state x y)))
                 (observe (state (x I32) (y I32)) (no-effects (observe-world state x y)))
                 (upgrade (state (x I32) (y I32)) (no-effects (upgrade-world state x y)))
                 (fabricate-worker (state) (no-effects (fabricate-world state)))
                 (repair-hub (state) (no-effects (repair-world state)))
                 (build-cell (state (kind I32) (cell I32))
                             (let ((next (place-cell-world state kind cell)))
                               (transition next (list (enqueue (destination client-owner client-app)
                                                               (plan-result cell (if (> (world-next-id next) (world-next-id state)) 1 0)))))))
                 (set-focus (state (value I32)) (no-effects (focus-world state 0)))
                 (relocate-building (state (from I32) (to I32))
                                    (no-effects (move-world state (index-x from) (index-y from) (index-x to) (index-y to))))
                 (new-run (state) (no-effects (restart-world state)))
                 (pause-colony (state (value I32))
                               (let ((next (pause-world state value)))
                                 (transition next (list (enqueue (destination client-owner client-app)
                                                                 (pause-state (world-paused next)))))))
                 (new-run-seed (state (seed I32)) (no-effects (seeded-world state seed)))
                 (cancel-building (state (x I32) (y I32)) (no-effects (cancel-world state x y)))
                 (arm-tower (state (x I32) (y I32)) (no-effects (arm-world state x y)))
                 (build-wall (state (x I32) (y I32)) (no-effects (wall-world state x y))))
    (define match-target (destination match-owner match-app))

    ;; ---- Camera, selection and an unpaid placement plan belong to the client ----

    (define-immutable-record DismissedAttack make-dismissed-attack
      (key I32 dismissed-key dismissed-key-set)
      (until I32 dismissed-until dismissed-until-set)
      (deriving derive-serialize derive-deserialize))
    (define-immutable-record Client make-client
      (cursor-x I32 client-x client-x-set)
      (cursor-y I32 client-y client-y-set)
      (camera-x I32 client-camera-x client-camera-x-set)
      (camera-y I32 client-camera-y client-camera-y-set)
      (width I32 client-width client-width-set)
      (height I32 client-height client-height-set)
      (chooser Bool client-chooser client-chooser-set)
      (target-x I32 client-target-x client-target-x-set)
      (target-y I32 client-target-y client-target-y-set)
      (heading I32 client-heading client-heading-set)
      (turn-from I32 client-turn-from client-turn-from-set)
      (turn-to I32 client-turn-to client-turn-to-set)
      (turn-elapsed I32 client-turn-elapsed client-turn-elapsed-set)
      (scale I32 client-scale client-scale-set)
      (preview I32 client-preview client-preview-set)
      (dialog I32 client-dialog client-dialog-set)
      (dialog-pending I32 client-dialog-pending client-dialog-pending-set)
      (dialog-result I32 client-dialog-result client-dialog-result-set)
      (homing Bool client-homing client-homing-set)
      (brush I32 client-brush client-brush-set)
      (plan (List I32) client-plan client-plan-set)
      (pending (List I32) client-pending client-pending-set)
      (rejected I32 client-rejected client-rejected-set)
      (unconfirmed I32 client-unconfirmed client-unconfirmed-set)
      (resolution I32 client-resolution client-resolution-set)
      (menu I32 client-menu client-menu-set)
      (left-handed Bool client-left-handed client-left-handed-set)
      (dismissed (List DismissedAttack) client-dismissed client-dismissed-set)
      (deriving derive-serialize derive-deserialize))
    (define (initial-client)
      (make-client (+ (spawn-x 1) 4) (- (spawn-y 1) 2) (* (spawn-x 1) 1000) (* (spawn-y 1) 1000)
                   960 640 #f -1 -1 0 0 0 300 1000 0 0 0 0 #f 0 (empty-list) (empty-list) 0 0 0 0 #f (empty-list)))
    (define (client-camera state)
      (zoom-camera (client-camera-x state) (client-camera-y state) (client-heading state) (client-scale state)
                   (client-width state) (client-height state)))
    (define (target-x state) (if (client-chooser state) (client-target-x state) (client-x state)))
    (define (target-y state) (if (client-chooser state) (client-target-y state) (client-y state)))
    (define (clamp value low high) (if (< value low) low (if (> value high) high value)))
    (define (point-client state x y)
      (let* ((world (context-world)) (area (world-viewport state))
             (cell (if (and (>= x (rect-x area)) (< x (+ (rect-x area) (rect-width area)))
                            (>= y (rect-y area)) (< y (+ (rect-y area) (rect-height area))))
                       (if (> (client-brush state) 0)
                           (ground-cell (client-camera state) (- x (rect-x area)) (- y (rect-y area)) (rect-width area) (rect-height area))
                           (pick-cell world (client-camera state) (- x (rect-x area)) (- y (rect-y area))
                                      (rect-width area) (rect-height area))) -1)))
        (client-y-set (client-x-set state (if (< cell 0) -1 (index-x cell)))
                      (if (< cell 0) -1 (index-y cell)))))
    (define (viewport-client state width height)
      (if (and (>= width 1) (<= width 8192) (>= height 1) (<= height 8192))
          (client-height-set (client-width-set state width) height) state))
    (define (nudge-client state dx dy)
      (client-y-set (client-x-set state (clamp (+ (client-x state) dx) 0 (- map-width 1)))
                    (clamp (+ (client-y state) dy) 0 (- map-height 1))))
    (define (camera-coordinate value) (i64->i32 (f64->i64 (round value))))
    (define (bound-fraction position delta low high)
      (let ((fraction (cond ((> delta 0.0) (/ (- high position) delta))
                            ((< delta 0.0) (/ (- low position) delta)) (else 1.0))))
        (if (< fraction 1.0) fraction 1.0)))
    ;; Stop at the first bound along this ray; independent X/Y clamping would
    ;; turn a straight screen pan into a diagonal slide along the world edge.
    (define (shift-camera state dx dy)
      (let* ((state (client-homing-set state #f)) (offset (v* (camera-pan (client-camera state) dx dy) (/ (scalar (client-scale state)) 1000.0)))
             (x (scalar (client-camera-x state))) (y (scalar (client-camera-y state)))
             (mx (vec3-x offset)) (my (- 0.0 (vec3-y offset)))
             (fx (bound-fraction x mx -3000.0 (scalar (+ (* map-width 1000) 3000)))) (fy (bound-fraction y my -3000.0 (scalar (+ (* map-height 1000) 3000))))
             (fraction (if (< fx fy) fx fy)))
        (client-camera-y-set (client-camera-x-set state (camera-coordinate (+ x (* mx fraction))))
                             (camera-coordinate (+ y (* my fraction))))))
    (define (clear-choice state)
      (client-homing-set (client-preview-set (client-chooser-set state #f) 0) #f))
    ;; CSS-pixel drag follows the finger at every display density and zoom.
    ;; Camera pan uses thousandths of the unscaled 18-cell viewport height.
    (define (drag-client state dx dy)
      (let ((factor (/ -18000.0 (scalar (client-height state)))))
        (shift-camera state (camera-coordinate (* factor (scalar (clamp dx -8192 8192))))
                      (camera-coordinate (* factor (scalar (clamp dy -8192 8192)))))))
    (define (choose-site state)
      (client-preview-set
       (client-target-y-set (client-target-x-set (client-chooser-set state #t) (client-x state)) (client-y state)) 0))
    (define (context-world) (decode-world (read-snapshot 1)))
    (define (send-request state request) (transition state (list (enqueue match-target request))))
    ;; Dialog: 0 closed, 1 Pause, 2 confirmation. Pending: 1 pause, 2 resume,
    ;; 3 reset. Result: 0 waiting, 1 committed, 2 replaced by an authoritative
    ;; import. The operation keeps its slot until settlement, even after success.
    (define (effective-dialog world state)
      (cond ((= (client-dialog-pending state) 3) 2)
            ((> (client-dialog state) 0) (client-dialog state))
            ((or (> (client-dialog-pending state) 0) (= (world-paused world) 1)) 1) (else 0)))
    ;; Camera input remains Client-only; imports and committed replies sync pause.
    (define (dialog-open? state) (or (> (client-dialog state) 0) (> (client-dialog-pending state) 0)))

    ;; ---- A click resolves against the current Scheme world, never DOM labels ----

    (define (select-site state)
      (let* ((world (context-world)) (state (clear-choice state))
             (state (if (hub-cell? world (client-x state) (client-y state))
                        (client-y-set (client-x-set state (world-hub-x world)) (world-hub-y world)) state)))
        (no-effects (if (or (hub-cell? world (client-x state) (client-y state))
                            (not (null? (building-at (world-buildings world) (client-x state) (client-y state))))
                            (and (= (client-x state) (world-nest-x world)) (= (client-y state) (world-nest-y world))
                                 (known? world (client-x state) (client-y state))))
                        (choose-site state) state))))
    (define (selection-open? state)
      (and (not (dialog-open? state)) (client-chooser state)))
    (define (hub-selected? world state)
      (and (selection-open? state) (hub-cell? world (target-x state) (target-y state))))
    ;; One unique local plan is in flight at a time. Replies arrive through the
    ;; host FIFO after each World commit; rejected cells remain unpaid ghosts.
    (define (plan-pending? state) (not (null? (client-pending state))))
    (define (contains-cell? cells cell)
      (and (not (null? cells)) (or (= (car cells) cell) (contains-cell? (cdr cells) cell))))
    (define (remove-cell cells cell)
      (if (null? cells) cells
          (if (= (car cells) cell) (cdr cells) (cons (car cells) (remove-cell (cdr cells) cell)))))
    (define (choose-brush state kind)
      (if (or (plan-pending? state) (not (null? (client-plan state))) (< kind 1) (> kind 4)
              (dialog-open? state)) state
              (client-menu-set (client-brush-set (clear-choice state) kind) 0)))
    (define (toggle-plan-cell state)
      (let ((x (client-x state)) (y (client-y state)) (cells (client-plan state)))
        (if (or (plan-pending? state) (not (inside? x y)) (not (known? (context-world) x y))) state
            (let* ((cell (cell-index x y)) (found (contains-cell? cells cell)))
              (client-unconfirmed-set
               (client-rejected-set (client-plan-set state (cond (found (remove-cell cells cell))
                                                                 ((< (list-size cells) maximum-buildings) (append cells (list cell)))
                                                                 (else cells))) 0) 0)))))
    (define (activate-site state)
      (if (> (client-brush state) 0) (no-effects (toggle-plan-cell state)) (select-site state)))
    (define (plan-requests kind cells)
      (if (null? cells) (empty-list)
          (cons (enqueue match-target (build-cell kind (car cells)))
                (cons (enqueue (destination client-owner client-app) (plan-settled (car cells)))
                      (plan-requests kind (cdr cells))))))
    (define (submit-plan state)
      (if (or (plan-pending? state) (= (client-brush state) 0) (null? (client-plan state))
              (dialog-open? state)) (no-effects state)
              (transition (client-unconfirmed-set (client-rejected-set (client-pending-set state (client-plan state)) 0) 0)
                          (plan-requests (client-brush state) (client-plan state)))))
    (define (receive-plan-result state cell accepted)
      (if (or (not (plan-pending? state)) (not (= cell (car (client-pending state))))) state
          (client-resolution-set state (if (= accepted 1) 1 2))))
    ;; A settlement is authored with the original request, not by a failed
    ;; World transaction. The host queues it after any committed reply.
    (define (settle-plan-cell state cell)
      (if (or (not (plan-pending? state)) (not (= cell (car (client-pending state))))) state
          (let* ((resolution (client-resolution state))
                 (next (client-resolution-set (client-pending-set state (cdr (client-pending state))) 0)))
            (cond ((= resolution 1) (client-plan-set next (remove-cell (client-plan state) cell)))
                  ((= resolution 2) (client-rejected-set next (+ 1 (client-rejected state))))
                  (else (client-unconfirmed-set next (+ 1 (client-unconfirmed state))))))))
    (define (cancel-plan state)
      (if (or (plan-pending? state) (dialog-open? state)) state
          (client-menu-set (client-unconfirmed-set (client-rejected-set (client-plan-set (client-brush-set state 0) (empty-list)) 0) 0) 0)))
    (define (toggle-menu state menu)
      (if (or (plan-pending? state) (dialog-open? state)
              (and (= menu 1) (not (null? (client-plan state))))) state
              (client-menu-set state (if (= (client-menu state) menu) 0 menu))))
    (define (wrap-heading angle) (remainder (+ angle 720000) 360000))
    (define (rotate-client state unused direction)
      (let* ((desired (wrap-heading (+ (client-turn-to state) (* (clamp direction -1 1) 90000))))
             (delta (- (remainder (+ (- desired (client-heading state)) 540000) 360000) 180000))
             (delta (if (and (= delta -180000) (> direction 0)) 180000 delta)))
        (client-turn-elapsed-set
         (client-turn-to-set (client-turn-from-set state (client-heading state)) (+ (client-heading state) delta)) 0)))
    (define (animate-client state milliseconds)
      (let* ((elapsed (clamp (+ (client-turn-elapsed state) (clamp milliseconds 0 50)) 0 300))
             (t (/ (scalar elapsed) 300.0)) (ease (* (* t t) (- 3.0 (* 2.0 t))))
             (angle (+ (scalar (client-turn-from state)) (* (scalar (- (client-turn-to state) (client-turn-from state))) ease))))
        (client-heading-set (client-turn-elapsed-set state elapsed) (wrap-heading (camera-coordinate angle)))))
    (define (center-client world state)
      (let* ((site (starter-deposit world))
             (x (if (< site 0) (world-hub-x world) (index-x site)))
             (y (if (< site 0) (world-hub-y world) (index-y site))))
        (make-client x y (* x 1000) (* y 1000) (client-width state) (client-height state) #f -1 -1
                     (client-heading state) (client-turn-from state) (client-turn-to state) (client-turn-elapsed state)
                     (client-scale state) 0 (world-paused world) 0 0 #f 0 (empty-list) (empty-list) 0 0 0 0 (client-left-handed state) (empty-list))))
    (define (reset-client world state)
      (let ((next (if (plan-pending? state) (client-dialog-set state (world-paused world)) (center-client world state)))
            (pending (client-dialog-pending state)))
        ;; An import owns the new presentation, but cannot free an older slot.
        (if (= pending 0) next
            (client-dialog-result-set (client-dialog-pending-set next pending) 2))))
    (define (travel-client state x y)
      (client-homing-set (client-target-y-set (client-target-x-set
                                               (client-y-set (client-x-set (clear-choice state) x) y) x) y) #t))
    (define (home-client world state)
      (client-chooser-set (travel-client state (world-hub-x world) (world-hub-y world)) (= (client-brush state) 0)))
    (define (animate-home state milliseconds)
      (if (not (client-homing state)) state
          (let* ((dx (- (* (client-target-x state) 1000) (client-camera-x state)))
                 (dy (- (* (client-target-y state) 1000) (client-camera-y state)))
                 (fraction (/ (scalar (clamp milliseconds 1 50)) 120.0))
                 (close (and (> dx -10) (< dx 10) (> dy -10) (< dy 10)))
                 (mx (if close dx (camera-coordinate (* (scalar dx) fraction))))
                 (my (if close dy (camera-coordinate (* (scalar dy) fraction)))))
            (client-homing-set (client-camera-y-set (client-camera-x-set state (+ (client-camera-x state) mx))
                                                    (+ (client-camera-y state) my)) (not close)))))
    ;; Zoom uses a reciprocal Padé approximation to exp(delta/1000).
    ;; Bounds keep projection finite without changing the look-at.
    (define (zoom-client state delta)
      (let* ((x (/ (scalar (clamp delta -1000 1000)) 1000.0)) (square (* x x))
             (factor (/ (+ (+ 12.0 (* 6.0 x)) square) (+ (- 12.0 (* 6.0 x)) square))))
        (client-scale-set state (clamp (camera-coordinate (* (scalar (client-scale state)) factor)) 500 32000))))
    (define (begin-dialog-request state dialog pending request)
      (transition (client-dialog-result-set (client-dialog-pending-set (client-dialog-set state dialog) pending) 0)
                  (list (enqueue match-target request)
                        (enqueue (destination client-owner client-app) (dialog-settled pending)))))
    (define (receive-pause-state state value)
      (let ((pending (cond ((= value 1) 1) ((= value 0) 2) (else 0))))
        (cond ((and (> pending 0) (= (client-dialog-pending state) pending) (= (client-dialog-result state) 0))
               (client-dialog-result-set state 1))
              ((and (= value 1) (= (client-dialog-pending state) 0) (= (client-dialog state) 0))
               (client-dialog-set state 1)) (else state))))
    (define (settle-dialog state pending)
      (if (or (= pending 0) (not (= pending (client-dialog-pending state)))) state
          (let* ((result (client-dialog-result state))
                 (next (client-dialog-result-set (client-dialog-pending-set state 0) 0)))
            (cond ((= result 2) next)
                  ((= pending 1) (if (= result 1) next (client-dialog-set next 0)))
                  ((= pending 2) (client-dialog-set next (if (= result 1) 0 1)))
                  (else (client-dialog-set next 2))))))
    (define (resume-colony state)
      (if (and (= (client-dialog state) 1) (= (client-dialog-pending state) 0))
          (begin-dialog-request state 1 2 (pause-colony 0)) (no-effects state)))
    (define (pause-menu-client state)
      (cond ((> (client-dialog-pending state) 0) (no-effects state))
            ((= (client-dialog state) 2) (no-effects (client-dialog-set state 1)))
            ((= (client-dialog state) 1) (resume-colony state))
            (else (begin-dialog-request state 1 1 (pause-colony 1)))))
    (define (request-restart state)
      (if (or (= (client-dialog state) 2) (> (client-dialog-pending state) 0) (plan-pending? state)) (no-effects state)
          (if (= (client-dialog state) 1) (no-effects (client-dialog-set state 2))
              (begin-dialog-request state 2 1 (pause-colony 1)))))
    (define (cancel-restart state)
      (no-effects (if (and (= (client-dialog state) 2) (= (client-dialog-pending state) 0)) (client-dialog-set state 1) state)))
    (define (confirm-restart state)
      (if (or (not (= (client-dialog state) 2)) (> (client-dialog-pending state) 0) (plan-pending? state)) (no-effects state)
          (begin-dialog-request state 2 3 (new-run))))
    (application client-app (state Client 6) (initial-client)
                 (move (state (x I32) (y I32))
                       (no-effects (if (dialog-open? state) state (point-client state x y))))
                 (viewport (state (width I32) (height I32)) (no-effects (viewport-client state width height)))
                 (nudge (state (dx I32) (dy I32)) (no-effects (if (dialog-open? state) state (nudge-client state dx dy))))
                 (confirm (state) (if (dialog-open? state) (no-effects state) (activate-site state)))
                 (accept (state) (cond ((= (client-dialog state) 2) (confirm-restart state))
                                       ((dialog-open? state) (resume-colony state))
                                       ((> (client-brush state) 0) (submit-plan state)) (else (select-site state))))
                 (activate (state) (if (dialog-open? state) (no-effects state) (activate-site state)))
                 (choose (state (kind I32)) (no-effects (choose-brush state kind)))
                 (done-plan (state) (submit-plan state))
                 (plan-result (state (cell I32) (accepted I32)) (no-effects (receive-plan-result state cell accepted)))
                 (plan-settled (state (cell I32)) (no-effects (settle-plan-cell state cell)))
                 (clear-plan (state) (no-effects (cancel-plan state)))
                 (build-menu (state) (no-effects (toggle-menu state 1)))
                 (pause-menu (state) (pause-menu-client state))
                 (resume (state) (resume-colony state))
                 (pause-state (state (value I32)) (no-effects (receive-pause-state state value)))
                 (dialog-settled (state (pending I32)) (no-effects (settle-dialog state pending)))
                 (worker-menu (state) (no-effects (toggle-menu state 3)))
                 (handedness (state) (no-effects (if (and (= (client-dialog state) 1) (= (client-dialog-pending state) 0))
                                                     (client-left-handed-set state (not (client-left-handed state))) state)))
                 (improve (state) (if (selection-open? state) (send-request state (upgrade (target-x state) (target-y state))) (no-effects state)))
                 (restart (state) (request-restart state))
                 (accept-restart (state) (confirm-restart state))
                 (dismiss-restart (state) (cancel-restart state))
                 (preview (state (kind I32)) (no-effects (if (dialog-open? state) state
                                                             (client-preview-set state (if (selection-open? state) (clamp kind 0 4) 0)))))
                 (zoom (state (delta I32)) (no-effects (if (dialog-open? state) state (zoom-client state delta))))
                 (pan (state (dx I32) (dy I32)) (no-effects (if (dialog-open? state) state (shift-camera state (* dx 1000) (* dy 1000)))))
                 (drift (state (dx I32) (dy I32)) (no-effects (if (dialog-open? state) state (shift-camera state (* (clamp dx -50 50) 9) (* (clamp dy -50 50) 9)))))
                 (drag (state (dx I32) (dy I32))
                       (no-effects (if (dialog-open? state) state (drag-client state dx dy))))
                 (fabricate (state) (if (hub-selected? (context-world) state) (send-request state (fabricate-worker)) (no-effects state)))
                 (hire (state) (if (dialog-open? state) (no-effects state) (send-request state (fabricate-worker))))
                 (repair (state) (if (hub-selected? (context-world) state) (send-request state (repair-hub)) (no-effects state)))
                 (focus (state (value I32)) (if (dialog-open? state) (no-effects state) (send-request (clear-choice state) (set-focus value))))
                 (relocate (state) (no-effects (if (dialog-open? state) state (clear-choice state))))
                 (turn (state (direction I32)) (no-effects (if (dialog-open? state) state (rotate-client state 0 direction))))
                 (rotate (state (elapsed I32) (direction I32)) (no-effects (if (dialog-open? state) state (rotate-client state elapsed direction))))
                 (animate (state (milliseconds I32)) (no-effects (animate-home (animate-client state milliseconds) milliseconds)))
                 (home (state) (no-effects (if (dialog-open? state) state (home-client (context-world) state))))
                 (center (state) (no-effects (if (or (plan-pending? state) (dialog-open? state)) state (center-client (context-world) state))))
                 ;; The host uses this after a committed reset or saved-world restore.
                 (reset-presentation (state) (no-effects (reset-client (context-world) state)))
                 (dismiss-attack (state (key I32)) (no-effects (if (dialog-open? state) state (dismiss-attack-client state key))))
                 (inspect-attack (state (x I32) (y I32)) (no-effects (if (and (not (dialog-open? state)) (inside? x y)) (travel-client state x y) state)))
                 (restart-seed (state (seed I32)) (if (or (plan-pending? state) (dialog-open? state)) (no-effects state)
                                                      (begin-dialog-request state 2 3 (new-run-seed seed))))
                 (dismiss (state) (cond ((= (client-dialog state) 2) (cancel-restart state))
                                        ((dialog-open? state) (resume-colony state))
                                        ((> (client-menu state) 0) (no-effects (client-menu-set state 0)))
                                        ((> (client-brush state) 0) (no-effects (cancel-plan state)))
                                        (else (no-effects (clear-choice state)))))
                 (cancel (state)
                         (if (selection-open? state)
                             (send-request (clear-choice state) (cancel-building (target-x state) (target-y state))) (no-effects state)))
                 (arm (state) (if (selection-open? state)
                                  (send-request state (arm-tower (target-x state) (target-y state))) (no-effects state))))

    ;; ---- Client schema and a complete presentation rebuilt from current state ----

    (define (encode-client client) (encode-snapshot 6 client))
    (define (valid-plan? cells seen)
      (or (null? cells)
          (and (>= (car cells) 0) (< (car cells) (* map-width map-height))
               (not (contains-cell? seen (car cells))) (valid-plan? (cdr cells) (cons (car cells) seen)))))
    (define (pending-in-plan? pending plan)
      (or (null? pending) (and (contains-cell? plan (car pending)) (pending-in-plan? (cdr pending) plan))))
    (define (valid-attack-key? key)
      (and (>= key 0) (< key (* (* map-width map-height) 8)) (< (remainder key 8) 6)))
    (define (valid-dismissals? entries seen)
      (or (null? entries)
          (let ((entry (car entries)))
            (and (valid-attack-key? (dismissed-key entry)) (not (contains-cell? seen (dismissed-key entry)))
                 (>= (dismissed-until entry) 0) (<= (dismissed-until entry) (+ run-end-tick attack-alert-ticks))
                 (valid-dismissals? (cdr entries) (cons (dismissed-key entry) seen))))))
    (define (validate-client client)
      (unless (and (>= (client-width client) 1) (<= (client-width client) 8192)
                   (>= (client-height client) 1) (<= (client-height client) 8192)
                   (>= (client-heading client) 0) (< (client-heading client) 360000)
                   (>= (client-turn-from client) 0) (< (client-turn-from client) 360000)
                   (>= (client-turn-to client) -180000) (<= (client-turn-to client) 540000)
                   (>= (client-turn-elapsed client) 0) (<= (client-turn-elapsed client) 300)
                   (>= (client-scale client) 500) (<= (client-scale client) 32000)
                   (>= (client-preview client) 0) (<= (client-preview client) 4)
                   (>= (client-dialog client) 0) (<= (client-dialog client) 2)
                   (>= (client-dialog-pending client) 0) (<= (client-dialog-pending client) 3)
                   (>= (client-dialog-result client) 0) (<= (client-dialog-result client) 2)
                   (or (> (client-dialog-pending client) 0) (= (client-dialog-result client) 0))
                   (>= (client-brush client) 0) (<= (client-brush client) 4)
                   (or (= (client-menu client) 0) (= (client-menu client) 1) (= (client-menu client) 3))
                   (<= (list-size (client-dismissed client)) 4) (valid-dismissals? (client-dismissed client) (empty-list))
                   (>= (client-rejected client) 0) (<= (client-rejected client) maximum-buildings)
                   (>= (client-unconfirmed client) 0) (<= (client-unconfirmed client) maximum-buildings)
                   (>= (client-resolution client) 0) (<= (client-resolution client) 2)
                   (or (plan-pending? client) (= (client-resolution client) 0))
                   (<= (list-size (client-plan client)) maximum-buildings)
                   (<= (list-size (client-pending client)) maximum-buildings)
                   (valid-plan? (client-plan client) (empty-list)) (valid-plan? (client-pending client) (empty-list))
                   (pending-in-plan? (client-pending client) (client-plan client))
                   (or (> (client-brush client) 0) (null? (client-plan client)))
                   (>= (client-camera-x client) -3000) (<= (client-camera-x client) (+ (* map-width 1000) 3000))
                   (>= (client-camera-y client) -3000) (<= (client-camera-y client) (+ (* map-height 1000) 3000))
                   (or (and (= (client-x client) -1) (= (client-y client) -1)) (inside? (client-x client) (client-y client)))
                   (or (not (or (client-chooser client) (client-homing client)))
                       (inside? (client-target-x client) (client-target-y client)))) (unreachable))
      client)
    (define (decode-client words) (validate-client (ann (decode-snapshot words) Client)))
    (define actions
      (hud-actions choose (improve) (hire) (worker-menu) turn (repair) (home) (dismiss) (cancel)
                   (restart) (accept-restart) (dismiss-restart) (build-menu) (pause-menu) (resume) (handedness) (done-plan) (clear-plan)))
    (define (world-viewport client)
      ;; Cards overlay the world; UI layout never changes camera or picking.
      (rect 0 0 (client-width client) (client-height client)))
    (define (client-context world client)
      (hud-context (target-x client) (target-y client) (client-chooser client)
                   (client-width client) (client-height client) (effective-dialog world client) (client-dialog-pending client)
                   (client-brush client) (list-size (client-plan client)) (list-size (client-pending client))
                   (client-rejected client) (client-unconfirmed client) (client-menu client) (client-left-handed client)))
    (define (alert-name kind)
      (cond ((= kind 0) "Hub under attack") ((= kind 4) "Workers under attack") (else "Outpost under attack")))
    (define (attack-capacity world client)
      (hud-notification-capacity (client-context world client)))
    (define (attack-key alert) (+ (* (cell-index (alert-x alert) (alert-y alert)) 8) (alert-kind alert)))
    (define (same-attack-area? left right)
      (let ((a (quotient left 8)) (b (quotient right 8)))
        (within? (index-x a) (index-y a) (index-x b) (index-y b) attack-alert-radius)))
    (define (live-attack? alert tick) (< (- tick (alert-tick alert)) attack-alert-ticks))
    (define (live-attack-key? alerts key tick)
      (and (not (null? alerts))
           (or (and (same-attack-area? (attack-key (car alerts)) key) (live-attack? (car alerts) tick))
               (live-attack-key? (cdr alerts) key tick))))
    (define (attack-muted? dismissed key tick)
      (and (not (null? dismissed))
           (or (and (same-attack-area? (dismissed-key (car dismissed)) key) (< tick (dismissed-until (car dismissed))))
               (attack-muted? (cdr dismissed) key tick))))
    (define (kept-dismissals entries key tick remaining)
      (if (or (null? entries) (= remaining 0)) (empty-list)
          (let ((entry (car entries)))
            (if (or (same-attack-area? (dismissed-key entry) key) (<= (dismissed-until entry) tick))
                (kept-dismissals (cdr entries) key tick remaining)
                (cons entry (kept-dismissals (cdr entries) key tick (- remaining 1)))))))
    ;; Keep the four most recently dismissed areas, matching the alert bound.
    ;; Each stays muted until expiry or eviction; neither needs a sync job.
    (define (dismiss-attack-client state key)
      (let* ((world (context-world)) (tick (world-tick world)))
        (if (not (and (valid-attack-key? key) (live-attack-key? (world-alerts world) key tick))) state
            (client-dismissed-set state
                                  (cons (make-dismissed-attack key (+ tick attack-alert-ticks))
                                        (kept-dismissals (client-dismissed state) key tick 3))))))
    (define (recent-attacks world client alerts count limit)
      (cond ((or (null? alerts) (= count limit)) (empty-list))
            ((and (live-attack? (car alerts) (world-tick world))
                  (not (attack-muted? (client-dismissed client) (attack-key (car alerts)) (world-tick world))))
             (cons (car alerts) (recent-attacks world client (cdr alerts) (+ count 1) limit)))
            (else (recent-attacks world client (cdr alerts) count limit))))
    (define (toast-x world client) (hud-attachment-x (client-context world client)))
    (define (toast-y world client index) (hud-notification-y world (client-context world client) index))
    (define (attack-toasts world client alerts index)
      (if (null? alerts) (empty-list)
          (let* ((alert (car alerts)) (key (integer-text (attack-key alert))))
            (cons (ui-at (toast-x world client) (toast-y world client index)
                         (ui-layer (string-append "attack-toast-" key) (px hud-attachment-width) (px 88)
                                   (list (ui-button (string-append "attack-inspect-" key) (px hud-attachment-width) (px 88) ""
                                                    "Inspect this attack" #t #f (inspect-attack (alert-x alert) (alert-y alert)))
                                         (ui-label (string-append "attack-label-" key) (px hud-attachment-width) (px 20) (alert-name (alert-kind alert)) 4)
                                         (ui-at 112 24 (ui-button (string-append "attack-dismiss-" key) (px hud-control-diameter) (px hud-control-diameter) ""
                                                                  "Dismiss this alert" #t #f (dismiss-attack (attack-key alert)))))))
                  (attack-toasts world client (cdr alerts) (+ index 1))))))
    (define (attack-insets world previous client alerts index)
      (unless (null? alerts)
        (let* ((alert (car alerts)) (x (alert-x alert)) (y (alert-y alert))
               (camera (zoom-camera (* x 1000) (* y 1000) (client-heading client) 400 64 48)))
          (present-scene-inset! (attack-key alert) (colony-scene world previous camera -1 -1 0 (empty-list))
                                (+ (toast-x world client) 20) (+ (toast-y world client index) 40) 64 48)
          (attack-insets world previous client (cdr alerts) (+ index 1)))))
    (define (view world client)
      (let* ((area (world-viewport client)) (camera (client-camera client))
             (context (client-context world client)) (layout (hud-layout world context))
             (before (decode-world (read-previous-snapshot 1)))
             (previous (if (and (= (world-seed before) (world-seed world))
                                (= (world-run-marker before) (world-run-marker world))) before world))
             (attacks (recent-attacks world client (world-alerts world) 0 (attack-capacity world client))))
        (when (or (< (client-turn-elapsed client) 300) (client-homing client)) (request-scene-frame!))
        (present-scene-in! (colony-scene world previous camera (target-x client) (target-y client)
                                         (if (> (client-brush client) 0) (client-brush client) (client-preview client)) (client-plan client))
                           (rect-x area) (rect-y area) (rect-width area) (rect-height area))
        (when (and (= (effective-dialog world client) 0) (= (client-menu client) 0)) (attack-insets world previous client attacks 0))
        (present-ui! (destination client-owner client-app)
                     (colony-hud world context actions layout
                                 (attack-toasts world client attacks 0)))
        (empty-list)))
    (define (status world client)
      (colony-status world 0 (target-x client) (target-y client) -1 -1))
    (define game (program match-app client-app 0 0 decode-world encode-world decode-client encode-client view status))
    (define application-entry
      (ann (lambda (operation a b c) (run-program game operation a b c)) (-> I32 I32 I32 I32 I32)))))
