(define-library (siegework game)
  (export application-entry)
  (import (scheme base)
          (scheme immutable)
          (application reducer)
          (application bridge)
          (browser application)
          (siegework model)
          (siegework terrain)
          (siegework codec)
          (siegework view)
          (only (lofi core) ann -> I32)
          (only (lofi base) i32->i64 unreachable))
  (begin

    ;; ---- The match owns colony orders and one deterministic clock ----

    (application match-app (state World 5) (initial-world)
                 (advance (state) (no-effects (advance-world state)))
                 (extract (state (x I32) (y I32)) (no-effects (extract-world state x y)))
                 (fortify (state (x I32) (y I32)) (no-effects (fortify-world state x y)))
                 (observe (state (x I32) (y I32)) (no-effects (observe-world state x y)))
                 (upgrade (state (x I32) (y I32)) (no-effects (upgrade-world state x y)))
                 (fabricate-worker (state) (no-effects (fabricate-world state)))
                 (prioritize-building (state (x I32) (y I32)) (no-effects (prioritize-world state x y)))
                 (repair (state) (no-effects (repair-world state)))
                 (new-run (state) (no-effects (restart-world state)))
                 (pause-colony (state (value I32)) (no-effects (pause-world state value)))
                 (new-run-seed (state (seed I32)) (no-effects (seeded-world state seed)))
                 (cancel-building (state (x I32) (y I32)) (no-effects (cancel-world state x y)))
                 (arm-tower (state (x I32) (y I32)) (no-effects (arm-world state x y))))
    (define match-target (destination match-owner match-app))

    ;; ---- Camera and cursor belong to each browser, including across reload ----

    (define-immutable-record Client make-client
      (tool I32 client-tool client-tool-set)
      (point-x I32 client-point-x client-point-x-set)
      (point-y I32 client-point-y client-point-y-set)
      (camera-x I32 client-camera-x client-camera-x-set)
      (camera-y I32 client-camera-y client-camera-y-set))
    ;; Camera positions use milli-pixels; the view and hit test share floor-pixel
    ;; projection, including negative offsets in the outside-map margin.
    (define (floor-div value divisor)
      (if (< value 0) (- 0 (quotient (+ (- 0 value) (- divisor 1)) divisor))
          (quotient value divisor)))
    (define (camera-pixel value) (floor-div value 1000))
    (define (client-x state) (floor-div (+ (camera-pixel (client-camera-x state)) (client-point-x state)) 40))
    (define (client-y state) (floor-div (+ (camera-pixel (client-camera-y state)) (client-point-y state)) 40))
    (define (initial-client) (make-client 1 500 260 0 560000))
    (define (clamp value low high) (if (< value low) low (if (> value high) high value)))
    (define (point-client state x y)
      (if (and (>= x 0) (< x 960) (>= y 0) (< y 640))
          (make-client (client-tool state) x y (client-camera-x state) (client-camera-y state)) state))
    (define (reveal-camera camera point extent maximum)
      (clamp camera (clamp (* (- point (- extent 1)) 1000) -120000 maximum)
             (clamp (* point 1000) -120000 maximum)))
    (define (nudge-client state dx dy)
      (let* ((x (cell-x (clamp (+ (client-x state) dx) -3 50)))
             (y (cell-y (clamp (+ (client-y state) dy) -3 38)))
             (cx (reveal-camera (client-camera-x state) x 960 1080000))
             (cy (reveal-camera (client-camera-y state) y 640 920000)))
        (make-client (client-tool state) (- x (camera-pixel cx)) (- y (camera-pixel cy)) cx cy)))
    (define (shift-camera state dx dy)
      (make-client (client-tool state) (client-point-x state) (client-point-y state)
                   (clamp (+ (client-camera-x state) dx) -120000 1080000)
                   (clamp (+ (client-camera-y state) dy) -120000 920000)))
    (define (pan-client state dx dy) (shift-camera state (* dx 40000) (* dy 40000)))
    (define (drift-client state dx dy) (shift-camera state (* (clamp dx -50 50) 360) (* (clamp dy -50 50) 360)))
    (define (place-order state)
      (cond ((= (client-tool state) 1) (extract (client-x state) (client-y state)))
            ((= (client-tool state) 2) (fortify (client-x state) (client-y state)))
            (else (observe (client-x state) (client-y state)))))
    (application client-app (state Client 5) (initial-client)
                 (move (state (x I32) (y I32)) (no-effects (point-client state x y)))
                 (nudge (state (dx I32) (dy I32)) (no-effects (nudge-client state dx dy)))
                 (choose (state (tool I32))
                         (no-effects (if (and (>= tool 1) (<= tool 3)) (client-tool-set state tool) state)))
                 (confirm (state) (transition state (list (enqueue match-target (place-order state)))))
                 (improve (state) (transition state (list (enqueue match-target (upgrade (client-x state) (client-y state))))))
                 (mend (state) (transition state (list (enqueue match-target (repair)))))
                 (restart (state) (transition state (list (enqueue match-target (new-run)))))
                 (pan (state (dx I32) (dy I32)) (no-effects (pan-client state dx dy)))
                 (fabricate (state) (transition state (list (enqueue match-target (fabricate-worker)))))
                 (prioritize (state) (transition state (list (enqueue match-target (prioritize-building (client-x state) (client-y state))))))
                 (home (state) (no-effects (make-client (client-tool state) 340 340 0 560000)))
                 (suspend (state (value I32)) (transition state (list (enqueue match-target (pause-colony value)))))
                 (drift (state (dx I32) (dy I32)) (no-effects (drift-client state dx dy)))
                 (restart-seed (state (seed I32)) (transition state (list (enqueue match-target (new-run-seed seed)))))
                 (cancel (state) (transition state (list (enqueue match-target (cancel-building (client-x state) (client-y state))))))
                 (arm (state) (transition state (list (enqueue match-target (arm-tower (client-x state) (client-y state)))))))

    ;; ---- Client schema and pure presentation ----

    (define (encode-client client)
      (vector 5 (client-tool client) (client-point-x client) (client-point-y client)
              (client-camera-x client) (client-camera-y client)))
    (define (local-word words index) (vector-ref words (i32->i64 index)))
    (define decode-client
      (ann (lambda (words)
             (let ((tool (local-word words 1)) (x (local-word words 2)) (y (local-word words 3))
                   (cx (local-word words 4)) (cy (local-word words 5)))
               (when (or (not (= (local-word words 0) 5)) (< tool 1) (> tool 3)
                         (< cx -120000) (> cx 1080000) (< cy -120000) (> cy 920000)
                         (< x 0) (>= x 960) (< y 0) (>= y 640)) (unreachable))
               (make-client tool x y cx cy)))
           (-> (Vector I32) Client)))
    (define (view world client)
      (colony-view world (client-tool client) (client-x client) (client-y client)
                   (camera-pixel (client-camera-x client)) (camera-pixel (client-camera-y client))))
    (define (status world client)
      (colony-status world (client-tool client) (client-x client) (client-y client)))
    (define game
      (program match-app client-app world-words 6 decode-world encode-world
               decode-client encode-client view status))
    (define application-entry
      (ann (lambda (operation a b c) (run-program game operation a b c))
           (-> I32 I32 I32 I32 I32)))))
