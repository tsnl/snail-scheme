;; Schema 3 adds a persistent manual pause to the bounded colony snapshot.
;; Older schemas require an explicit saved-state conversion;
;; paths contain adjacent terrain cells, never references into a Wasm heap.
(define-library (siegework codec)
  (export encode-world decode-world world-words)
  (import (scheme base)
          (scheme immutable)
          (siegework model)
          (siegework terrain)
          (only (lofi core) ann -> I32)
          (only (lofi base) i32->i64 unreachable))
  (begin

    ;; ---- Fixed scalar layout ----

    (define world-words 6144)
    (define (word words index) (vector-ref words (i32->i64 index)))
    (define (put! words index value) (vector-set! words (i32->i64 index) value))
    (define (bounded? value low high) (and (>= value low) (<= value high)))
    (define (require! valid) (unless valid (unreachable)))
    (define (write-path! words index path)
      (unless (null? path)
        (put! words index (car path))
        (write-path! words (+ index 1) (cdr path))))
    (define (read-path words index count)
      (if (= count 0) (empty-list)
          (let ((cell (word words index)))
            (require! (and (bounded? cell 0 1727) (ground? (index-x cell) (index-y cell))))
            (cons cell (read-path words (+ index 1) (- count 1))))))

    (define (write-buildings! words index values)
      (unless (null? values)
        (let ((value (car values)))
          (put! words (+ index 0) (building-id value))
          (put! words (+ index 1) (building-kind value))
          (put! words (+ index 2) (building-x value))
          (put! words (+ index 3) (building-y value))
          (put! words (+ index 4) (building-level value))
          (put! words (+ index 5) (building-hp value))
          (put! words (+ index 6) (building-stock value))
          (put! words (+ index 7) (building-stage value))
          (put! words (+ index 8) (building-cooldown value))
          (put! words (+ index 9) (building-aim-x value))
          (put! words (+ index 10) (building-aim-y value))
          (write-buildings! words (+ index 12) (cdr values)))))
    (define (read-buildings words index count)
      (if (= count 0) (empty-list)
          (let ((value (make-building
                        (word words (+ index 0))
                        (word words (+ index 1))
                        (word words (+ index 2))
                        (word words (+ index 3))
                        (word words (+ index 4))
                        (word words (+ index 5))
                        (word words (+ index 6))
                        (word words (+ index 7))
                        (word words (+ index 8))
                        (word words (+ index 9))
                        (word words (+ index 10)))))
            (check-building! value)
            (cons value (read-buildings words (+ index 12) (- count 1))))))

    (define (write-bots! words index values)
      (unless (null? values)
        (let ((value (car values)))
          (put! words (+ index 0) (bot-id value))
          (put! words (+ index 1) (bot-x value))
          (put! words (+ index 2) (bot-y value))
          (put! words (+ index 3) (bot-job value))
          (put! words (+ index 4) (bot-target value))
          (put! words (+ index 5) (bot-cargo value))
          (put! words (+ index 6) (bot-timer value))
          (put! words (+ index 7) (list-size (bot-path value)))
          (write-path! words (+ index 8) (bot-path value))
          (write-bots! words (+ index 140) (cdr values)))))
    (define (read-bots words index count)
      (if (= count 0) (empty-list)
          (let ((value (make-bot
                        (word words (+ index 0))
                        (word words (+ index 1))
                        (word words (+ index 2))
                        (word words (+ index 3))
                        (word words (+ index 4))
                        (word words (+ index 5))
                        (word words (+ index 6))
                        (begin (require! (bounded? (word words (+ index 7)) 0 128))
                               (read-path words (+ index 8) (word words (+ index 7)))))))
            (check-bot! value)
            (cons value (read-bots words (+ index 140) (- count 1))))))

    (define (write-enemies! words index values)
      (unless (null? values)
        (let ((value (car values)))
          (put! words (+ index 0) (enemy-id value))
          (put! words (+ index 1) (enemy-x value))
          (put! words (+ index 2) (enemy-y value))
          (put! words (+ index 3) (enemy-hp value))
          (put! words (+ index 4) (enemy-kind value))
          (put! words (+ index 5) (enemy-target value))
          (put! words (+ index 7) (list-size (enemy-path value)))
          (write-path! words (+ index 8) (enemy-path value))
          (write-enemies! words (+ index 140) (cdr values)))))
    (define (read-enemies words index count)
      (if (= count 0) (empty-list)
          (let ((value (make-enemy
                        (word words (+ index 0))
                        (word words (+ index 1))
                        (word words (+ index 2))
                        (word words (+ index 3))
                        (word words (+ index 4))
                        (word words (+ index 5))
                        (begin (require! (bounded? (word words (+ index 7)) 0 128))
                               (read-path words (+ index 8) (word words (+ index 7)))))))
            (check-enemy! value)
            (cons value (read-enemies words (+ index 140) (- count 1))))))

    (define (write-surveys! words index values)
      (unless (null? values)
        (let ((value (car values)))
          (put! words (+ index 0) (survey-x value))
          (put! words (+ index 1) (survey-y value))
          (put! words (+ index 2) (survey-radius value))
          (write-surveys! words (+ index 3) (cdr values)))))
    (define (read-surveys words index count)
      (if (= count 0) (empty-list)
          (let ((value (make-survey
                        (word words (+ index 0))
                        (word words (+ index 1))
                        (word words (+ index 2)))))
            (check-survey! value)
            (cons value (read-surveys words (+ index 3) (- count 1))))))

    ;; ---- Decode establishes bounded gameplay values ----

    (define (check-building! value)
      (require! (and (> (building-id value) 0) (bounded? (building-kind value) 1 3)
                     (ground? (building-x value) (building-y value))
                     (bounded? (building-level value) 1 2)
                     (bounded? (building-hp value) 1 (building-health (building-kind value)))
                     (if (= (building-kind value) 1) (> (deposit-rate (building-x value) (building-y value)) 0)
                         (= (deposit-rate (building-x value) (building-y value)) 0))
                     (or (not (= (building-kind value) 2)) (= (building-level value) 1))
                     (bounded? (building-aim-x value) 0 1919) (bounded? (building-aim-y value) 0 1439)
                     (bounded? (building-stock value) 0 120) (bounded? (building-stage value) 0 2)
                     (bounded? (building-cooldown value) 0 8))))
    (define (check-bot! value)
      (require! (and (> (bot-id value) 0) (bounded? (bot-x value) 0 1919)
                     (bounded? (bot-y value) 0 1439) (bounded? (bot-job value) 0 6)
                     (>= (bot-target value) 0) (bounded? (bot-cargo value) 0 50)
                     (bounded? (bot-timer value) 0 30))))
    (define (check-enemy! value)
      (require! (and (> (enemy-id value) 0) (bounded? (enemy-x value) 0 1919)
                     (bounded? (enemy-y value) 0 1439) (bounded? (enemy-hp value) 1 1800)
                     (bounded? (enemy-kind value) 0 2) (>= (enemy-target value) 0))))
    (define (check-survey! value)
      (require! (and (ground? (survey-x value) (survey-y value))
                     (bounded? (survey-radius value) 4 10))))
    (define (check-header! words)
      (require! (and (= (word words 0) 3) (bounded? (word words 1) 0 4800)
                     (bounded? (word words 2) 0 3) (>= (word words 3) 0)
                     (bounded? (word words 4) 0 300) (>= (word words 5) 0) (> (word words 6) 0)
                     (bounded? (word words 7) 0 32) (bounded? (word words 8) 3 12)
                     (bounded? (word words 9) 0 24) (bounded? (word words 10) 1 64)
                     (>= (word words 11) 0) (bounded? (word words 12) 0 1)
                     (>= (word words 13) 0) (>= (word words 14) 0) (>= (word words 15) 0)
                     (>= (word words 16) 0) (bounded? (word words 17) 0 15)
                     (bounded? (word words 18) 0 1))))

    ;; ---- Cross-record ownership and route evidence ----

    (define (contains-id? ids id)
      (and (not (null? ids)) (or (= (car ids) id) (contains-id? (cdr ids) id))))
    (define (building-ids values)
      (if (null? values) (empty-list) (cons (building-id (car values)) (building-ids (cdr values)))))
    (define (bot-ids values)
      (if (null? values) (empty-list) (cons (bot-id (car values)) (bot-ids (cdr values)))))
    (define (enemy-ids values)
      (if (null? values) (empty-list) (cons (enemy-id (car values)) (enemy-ids (cdr values)))))
    (define (check-identities! ids next)
      (unless (null? ids)
        (require! (and (< (car ids) next) (not (contains-id? (cdr ids) (car ids)))))
        (check-identities! (cdr ids) next)))
    (define (construction-carrier? bot id)
      (and (= (bot-target bot) id) (> (bot-cargo bot) 4)
           (or (= (bot-job bot) 3) (= (bot-job bot) 5))))
    (define (construction-claims bots id)
      (if (null? bots) 0 (+ (if (construction-carrier? (car bots) id) 1 0)
                            (construction-claims (cdr bots) id))))
    (define (remembered-observer? surveys building)
      (and (not (null? surveys))
           (or (and (= (survey-x (car surveys)) (building-x building))
                    (= (survey-y (car surveys)) (building-y building))
                    (>= (survey-radius (car surveys)) (building-radius building)))
               (remembered-observer? (cdr surveys) building))))
    (define (check-buildings! world buildings)
      (unless (null? buildings)
        (let ((building (car buildings)))
          (require! (= (construction-claims (world-bots world) (building-id building))
                       (if (= (building-stage building) 1) 1 0)))
          (require! (null? (building-at (cdr buildings) (building-x building) (building-y building))))
          (require! (or (not (ready? building)) (remembered-observer? (world-surveys world) building))))
        (check-buildings! world (cdr buildings))))
    (define (check-route! path previous surveys known first)
      (unless (null? path)
        (let ((step (car path)))
          (require! (if first (<= (distance (index-x previous) (index-y previous) (index-x step) (index-y step)) 1)
                        (= (distance (index-x previous) (index-y previous) (index-x step) (index-y step)) 1)))
          (require! (or (not known) (surveyed? surveys (index-x step) (index-y step))))
          (check-route! (cdr path) step surveys known #f))))
    (define (last-cell path)
      (if (null? (cdr path)) (car path) (last-cell (cdr path))))
    (define (arrives-at? bot x y)
      (if (null? (bot-path bot)) (and (= (bot-x bot) (cell-x x)) (= (bot-y bot) (cell-y y)))
          (= (last-cell (bot-path bot)) (cell-index x y))))
    (define (check-kit! world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (require! (not (null? found)))
        (let ((building (car found)))
          (require! (and (= (building-stage building) 1)
                         (= (bot-cargo bot) (building-cost (building-kind building)))))
          (when (= (bot-job bot) 3) (require! (arrives-at? bot (building-x building) (building-y building)))))))
    (define (check-outward-target! world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (when (= (bot-target bot) 0) (require! (and (= (bot-job bot) 4) (arrives-at? bot hub-x hub-y))))
        (unless (null? found)
          (let ((building (car found)))
            (require! (and (ready? building) (arrives-at? bot (building-x building) (building-y building))))
            (when (= (bot-job bot) 1) (require! (= (building-kind building) 1)))))))
    (define (check-activity! world bot)
      (let ((job (bot-job bot)) (cargo (bot-cargo bot)))
        (require! (and (< (bot-target bot) (world-next-id world))
                       (if (= job 6) (> (bot-timer bot) 0) (= (bot-timer bot) 0))))
        (cond ((or (= job 0) (= job 6))
               (require! (and (= cargo 0) (= (bot-target bot) 0) (null? (bot-path bot)) (arrives-at? bot hub-x hub-y))))
              ((= job 1) (require! (= cargo 0)) (check-outward-target! world bot))
              ((= job 2) (require! (and (<= cargo 16) (arrives-at? bot hub-x hub-y))))
              ((= job 3) (check-kit! world bot))
              ((= job 4) (require! (= cargo 4)) (check-outward-target! world bot))
              (else (require! (arrives-at? bot hub-x hub-y))
                    (unless (= cargo 4) (check-kit! world bot))))))
    (define (check-workers! world bots)
      (unless (null? bots)
        (let ((bot (car bots)))
          (check-route! (bot-path bot) (cell-index (quotient (bot-x bot) cell-size) (quotient (bot-y bot) cell-size))
                        (world-surveys world) #t #t)
          (check-activity! world bot))
        (check-workers! world (cdr bots))))
    (define (check-enemies! world enemies)
      (unless (null? enemies)
        (let ((enemy (car enemies)))
          (require! (< (enemy-target enemy) (world-next-id world)))
          (check-route! (enemy-path enemy) (cell-index (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size))
                        (world-surveys world) #f #t))
        (check-enemies! world (cdr enemies))))
    (define (building-investment buildings)
      (if (null? buildings) 0
          (+ (building-cost (building-kind (car buildings)))
             (+ (if (= (building-level (car buildings)) 1) 0 (if (= (building-kind (car buildings)) 3) 35 40))
                (building-investment (cdr buildings))))))
    (define (check-world! world)
      (check-identities! (append (building-ids (world-buildings world))
                                 (append (bot-ids (world-bots world)) (enemy-ids (world-enemies world)))) (world-next-id world))
      (require! (= (world-credits world) (- (+ 160 (world-delivered world)) (world-spent world))))
      (require! (>= (world-spent world) (+ (building-investment (world-buildings world)) (* 25 (- (list-size (world-bots world)) 3)))))
      (check-buildings! world (world-buildings world))
      (check-workers! world (world-bots world))
      (check-enemies! world (world-enemies world)))

    ;; ---- One snapshot owns all colony and discovery state ----

    (define (encode-world world)
      (let ((words (make-vector (i32->i64 world-words) 0)))
        (put! words 0 3)
        (put! words 1 (world-tick world))
        (put! words 2 (world-outcome world))
        (put! words 3 (world-credits world))
        (put! words 4 (world-hull world))
        (put! words 5 (world-kills world))
        (put! words 6 (world-next-id world))
        (put! words 7 (list-size (world-buildings world)))
        (put! words 8 (list-size (world-bots world)))
        (put! words 9 (list-size (world-enemies world)))
        (put! words 10 (list-size (world-surveys world)))
        (put! words 11 (world-priority world))
        (put! words 12 (world-repairs world))
        (put! words 13 (world-delivered world))
        (put! words 14 (world-produced world))
        (put! words 15 (world-spent world))
        (put! words 16 (world-lost world))
        (put! words 17 (world-notice world))
        (put! words 18 (world-paused world))
        (write-buildings! words 32 (world-buildings world))
        (write-bots! words 416 (world-bots world))
        (write-enemies! words 2096 (world-enemies world))
        (write-surveys! words 5456 (world-surveys world))
        words))
    (define decode-world
      (ann (lambda (words)
             (check-header! words)
             (let ((world (make-world
                           (word words 1)
                           (word words 2)
                           (word words 3)
                           (word words 4)
                           (word words 5)
                           (word words 6)
                           (read-buildings words 32 (word words 7))
                           (read-bots words 416 (word words 8))
                           (read-enemies words 2096 (word words 9))
                           (read-surveys words 5456 (word words 10))
                           (word words 11)
                           (word words 12)
                           (word words 13)
                           (word words 14)
                           (word words 15)
                           (word words 16)
                           (word words 17)
                           (word words 18))))
               (check-world! world)
               world))
           (-> (Vector I32) World)))))
