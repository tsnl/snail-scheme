;; The app owns schema meaning. The shared runtime owns replacement and storage.
;; Schema 1 is a bounded integer encoding, not a general Scheme serialization ABI.
(define-library (siegework codec)
  (export encode-world decode-world world-words)
  (import (scheme base) (siegework model) (only (lofi core) ann -> I32)
          (only (lofi base) i32->i64 unreachable))
  (begin
    (define world-words 192)
    (define (word words index) (vector-ref words (i32->i64 index)))
    (define (put words index value) (vector-set! words (i32->i64 index) value))
    (define (write-turrets words index values)
      (unless (null? values)
        (let ((value (car values)))
          (put words index (turret-x value)) (put words (+ index 1) (turret-y value))
          (put words (+ index 2) (turret-cooldown value)))
        (write-turrets words (+ index 3) (cdr values))))
    (define (read-turrets words index count)
      (if (= count 0) (empty-list)
          (cons (make-turret (word words index) (word words (+ index 1)) (word words (+ index 2)))
                (read-turrets words (+ index 3) (- count 1)))))
    (define (write-enemies words index values)
      (unless (null? values)
        (let ((value (car values)))
          (put words index (enemy-id value)) (put words (+ index 1) (enemy-x value))
          (put words (+ index 2) (enemy-y value)) (put words (+ index 3) (enemy-hp value))
          (put words (+ index 4) (enemy-boss value)))
        (write-enemies words (+ index 5) (cdr values))))
    (define (read-enemies words index count)
      (if (= count 0) (empty-list)
          (cons (make-enemy (word words index) (word words (+ index 1)) (word words (+ index 2))
                            (word words (+ index 3)) (word words (+ index 4)))
                (read-enemies words (+ index 5) (- count 1)))))
    (define (encode-world world)
      (let ((words (make-vector (i32->i64 world-words) 0))
            (mine (world-mine world)) (bot (world-bot world)))
        (put words 0 1) (put words 1 (world-tick world)) (put words 2 (world-outcome world))
        (put words 3 (world-credits world)) (put words 4 (world-hull world)) (put words 5 (world-kills world))
        (put words 6 (world-next-id world))
        (put words 7 (mine-x mine)) (put words 8 (mine-y mine))
        (put words 9 (mine-level mine)) (put words 10 (mine-stock mine))
        (put words 11 (bot-x bot)) (put words 12 (bot-y bot))
        (put words 13 (bot-cargo bot)) (put words 14 (bot-homeward bot))
        (put words 15 (list-size (world-turrets world))) (put words 16 (list-size (world-enemies world)))
        (write-turrets words 24 (world-turrets world)) (write-enemies words 48 (world-enemies world)) words))
    (define decode-world
      (ann (lambda (words)
             (when (or (not (= (word words 0) 1)) (< (word words 15) 0) (> (word words 15) 8)
                       (< (word words 16) 0) (> (word words 16) 16) (< (word words 1) 0)
                       (> (word words 1) 1200) (< (word words 3) 0)) (unreachable))
             (make-world (word words 1) (word words 2) (word words 3) (word words 4) (word words 5)
                         (make-mine (word words 7) (word words 8) (word words 9) (word words 10))
                         (make-bot (word words 11) (word words 12) (word words 13) (word words 14))
                         (read-turrets words 24 (word words 15)) (read-enemies words 48 (word words 16))
                         (word words 6))) (-> (Vector I32) World)))))
