;; On-demand diagnostic observations of a validated World. Recording retains
;; the exact World; these counters describe it without inventing combat events.
(define-library (siegework recording)
  (export recording-stat)
  (import
   (scheme base)
   (siegework model)
   (siegework terrain)
   (only (lofi core) ann I32)
   (only (lofi base) unreachable))
  (begin

    ;; ---- Economy, construction and the surveyed frontier ----

    (define (count-kind buildings kind)
      (if (null? buildings) (ann 0 I32)
          (+ (if (= (building-kind (car buildings)) kind) 1 0) (count-kind (cdr buildings) kind))))
    (define (count-pending buildings)
      (if (null? buildings) (ann 0 I32)
          (+ (if (= (building-stage (car buildings)) 2) 0 1) (count-pending (cdr buildings)))))
    (define (count-busy bots)
      (if (null? bots) (ann 0 I32)
          (+ (if (or (= (bot-job (car bots)) 0) (= (bot-job (car bots)) 7) (= (bot-job (car bots)) 10)) 0 1)
             (count-busy (cdr bots)))))
    (define (frontier-distance world surveys)
      (if (null? surveys) (ann 0 I32)
          (let* ((survey (car surveys)) (dx (- (survey-x survey) (world-hub-x world)))
                 (dy (- (survey-y survey) (world-hub-y world)))
                 (distance (+ (* dx dx) (* dy dy))) (rest (frontier-distance world (cdr surveys))))
            (if (> distance rest) distance rest))))

    ;; Field positions and projection version are declared in settings.json.
    ;; Exhaustive scalar projection keeps this diagnostic ABI visible together.
    (define (recording-stat world index)
      (cond ((= index -1) 1)
            ((= index 0) (world-tick world))
            ((= index 1) (world-run-marker world))
            ((= index 2) (world-seed world))
            ((= index 3) (world-outcome world))
            ((= index 4) (world-credits world))
            ((= index 5) (world-produced world))
            ((= index 6) (world-delivered world))
            ((= index 7) (world-spent world))
            ((= index 8) (world-lost-ore world))
            ((= index 9) (world-hull world))
            ((= index 10) (world-nest-hp world))
            ((= index 11) (world-kills world))
            ((= index 12) (world-casualties world))
            ((= index 13) (list-size (world-buildings world)))
            ((= index 14) (count-kind (world-buildings world) 1))
            ((= index 15) (count-kind (world-buildings world) 3))
            ((= index 16) (count-kind (world-buildings world) 2))
            ((= index 17) (count-kind (world-buildings world) 4))
            ((= index 18) (count-pending (world-buildings world)))
            ((= index 19) (list-size (world-bots world)))
            ((= index 20) (count-busy (world-bots world)))
            ((= index 21) (list-size (world-enemies world)))
            ((= index 22) (list-size (world-surveys world)))
            ((= index 23) (frontier-distance world (world-surveys world)))
            ((= index 24) (world-last-reveal-tick world))
            ((= index 25) (if (known? world (world-nest-x world) (world-nest-y world)) 1 0))
            ((= index 26) (if (visible? world (world-nest-x world) (world-nest-y world)) 1 0))
            ((= index 27) (world-paused world))
            ((= index 28) (if (world-started world) 1 0))
            (else (unreachable))))))
