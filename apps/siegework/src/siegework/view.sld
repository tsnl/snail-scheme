;; A diorama of the existing flat grid. Heights belong only to illustrations;
;; movement, visibility, mining, construction and combat remain the colony model.
(define-library (siegework view)
  (export colony-scene colony-camera orbit-camera zoom-camera camera-pan ground-cell pick-cell
          ScreenPoint projected-point-x projected-point-y cell-screen-position world-screen-position)
  (import
   (scheme base)
   (scheme immutable)
   (draw3d)
   (only (draw3d math) camera-right camera-up camera-forward)
   (siegework model)
   (siegework terrain)
   (siegework guidance)
   (only (lofi base) floor round sqrt f64->i64 i32->i64 i64->i32)
   (only (lofi core) ann datatype -> I32 F64))
  (begin

    ;; ---- Camera and picking share one world-space convention ----

    (define (whole value) (i64->i32 (f64->i64 value)))
    (define (colony-camera cx cy width height)
      (orbit-camera cx cy 0 width height))
    ;; Quarter-circle polynomial, absolute error below 0.000004. Angles are
    ;; bounded millidegrees, so camera state stays deterministic and serializable.
    (define (quarter-sine angle)
      (let* ((x (* (scalar angle) 0.0000174532925199433)) (square (* x x)))
        (* x (+ 1.0 (* square (+ -0.166666666666667
                                 (* square (+ 0.00833333333333333
                                              (* square (+ -0.000198412698412698
                                                           (* square 0.00000275573192239859)))))))))))
    (define (heading-sine angle)
      (let ((quadrant (quotient angle 90000)) (part (remainder angle 90000)))
        (cond ((= quadrant 0) (quarter-sine part))
              ((= quadrant 1) (quarter-sine (- 90000 part)))
              ((= quadrant 2) (- 0.0 (quarter-sine part)))
              (else (- 0.0 (quarter-sine (- 90000 part)))))))
    (define (orbit-camera cx cy heading width height)
      (zoom-camera cx cy heading 1000 width height))
    (define (zoom-camera cx cy heading scale width height)
      (let* ((target (vec3 (/ (scalar cx) 1000.0) (- 0.0 (/ (scalar cy) 1000.0)) 0.0))
             (sine (heading-sine heading)) (cosine (heading-sine (remainder (+ heading 90000) 360000)))
             (factor (/ (scalar scale) 1000.0))
             (offset (v* (vec3 (+ (* 12.0 cosine) (* 18.0 sine)) (- (* 12.0 sine) (* 18.0 cosine)) 22.0) factor)))
        (orthographic-camera (v+ target offset) target (vec3 0.0 0.0 1.0)
                             (* 18.0 factor) (/ (scalar width) (scalar height)) 0.1 (* 120.0 factor))))
    ;; Move in screen-right/down units, then project parallel to the viewing
    ;; direction onto Z=0. Keeping that projection compensates for camera pitch.
    (define (camera-pan camera dx dy)
      (let ((offset (v+ (v* (camera-right camera) (scalar dx))
                        (v* (camera-up camera) (- 0.0 (scalar dy)))))
            (forward (camera-forward camera)))
        (v- offset (v* forward (/ (vec3-z offset) (vec3-z forward))))))
    ;; A fixed direction in camera space follows every interpolated turn.
    ;; Only scene uniforms change; the retained world geometry is untouched.
    (define (camera-light camera)
      (directional-light
       (v+ (v* (camera-right camera) -0.5)
           (v+ (v* (camera-up camera) 0.6) (v* (camera-forward camera) -1.0))) 0.65))
    (define ScreenPoint
      (datatype ()
        (screen-point
         (x I32 projected-point-x)
         (y I32 projected-point-y))))
    (define (project-row matrix row point)
      (+ (+ (* (vector-ref matrix (i32->i64 row)) (vec3-x point))
            (* (vector-ref matrix (i32->i64 (+ row 4))) (vec3-y point)))
         (+ (* (vector-ref matrix (i32->i64 (+ row 8))) (vec3-z point))
            (vector-ref matrix (i32->i64 (+ row 12))))))
    (define (projected-pixel value extent)
      (i64->i32 (f64->i64 (round (* value (/ (scalar extent) 2.0))))))
    ;; UI anchors use the same matrix and cell center as the rendered cursor.
    (define (world-screen-position camera x y z width height)
      (let* ((matrix (camera-matrix camera)) (point (position x y z))
             (w (project-row matrix 3 point))
             (x (/ (project-row matrix 0 point) w)) (y (/ (project-row matrix 1 point) w)))
        (screen-point (projected-pixel (+ x 1.0) width)
                      (projected-pixel (- 1.0 y) height))))
    (define (cell-screen-position camera x y width height)
      (world-screen-position camera x y 0.08 width height))
    (define (pointer-ray camera px py width height)
      (camera-ray camera (- (/ (* (scalar px) 2.0) (scalar width)) 1.0)
                  (- 1.0 (/ (* (scalar py) 2.0) (scalar height)))))
    (define (ground-ray-cell pointer)
      (let ((hit (ray-ground pointer 0.0)))
        (if (null? hit) -1
            (let ((x (whole (floor (+ (vec3-x (car hit)) 0.5))))
                  (y (whole (floor (+ (- 0.0 (vec3-y (car hit))) 0.5)))))
              (if (inside? x y) (cell-index x y) -1)))))
    (define (ground-cell camera px py width height)
      (ground-ray-cell (pointer-ray camera px py width height)))
    (define (building-bounds world building)
      (let ((center (position (building-x building) (building-y building) 0.0))
            (height (if (not (ready? building)) 0.4
                        (cond ((= (building-kind building) 3) 1.65)
                              ((= (building-kind building) 1) 1.02) (else 1.0)))))
        (bounds (v+ center (vec3 -0.48 -0.48 0.0))
                (v+ center (vec3 0.48 0.48 (+ height (site-lift world (building-x building) (building-y building))))))))
    (define CellHit
      (datatype ()
        (cell-hit
         (cell I32 hit-cell)
         (distance F64 hit-distance))))
    (define (nearer-box pointer box cell nearest)
      (let ((hit (ray-box pointer box)))
        (if (null? hit) nearest
            (let* ((offset (v- (car hit) (ray-origin pointer))) (distance (dot offset offset)))
              (if (< distance (hit-distance nearest)) (cell-hit cell distance) nearest)))))
    (define (nearest-building world pointer buildings nearest)
      (if (null? buildings) nearest
          (let ((building (car buildings)))
            (nearest-building world pointer (cdr buildings)
                              (nearer-box pointer (building-bounds world building)
                                          (cell-index (building-x building) (building-y building)) nearest)))))
    (define (pick-deposit world pointer x y nearest)
      (if (not (and (inside? x y) (known? world x y) (> (deposit-rate (world-seed world) x y) 0))) nearest
          (let ((center (position x y 0.0)))
            (nearer-box pointer (bounds (v+ center (vec3 -0.38 -0.33 0.0))
                                        (v+ center (vec3 0.35 0.27 0.64)))
                        (cell-index x y) nearest))))
    ;; At this fixed camera pitch, a crystal's tip projects less than one cell
    ;; from its ground footprint. Nine cells cover every regional deposit too.
    (define (nearest-deposit world pointer ground dx dy nearest)
      (cond ((or (< ground 0) (> dy 1)) nearest)
            ((> dx 1) (nearest-deposit world pointer ground -1 (+ dy 1) nearest))
            (else (nearest-deposit world pointer ground (+ dx 1) dy
                                   (pick-deposit world pointer (+ (index-x ground) dx) (+ (index-y ground) dy) nearest)))))
    (define (landmark-box x y width depth height)
      (let ((center (position x y 0.0)))
        (bounds (v+ center (vec3 (- 0.0 width) (- 0.0 depth) 0.0))
                (v+ center (vec3 width depth height)))))
    (define (nearest-landmark world pointer nearest)
      (let* ((hx (world-hub-x world)) (hy (world-hub-y world))
             (nx (world-nest-x world)) (ny (world-nest-y world))
             (hub (nearer-box pointer (landmark-box hx hy 1.5 1.5 2.25) (cell-index hx hy) nearest)))
        (if (known? world nx ny)
            (nearer-box pointer (landmark-box nx ny 1.4 1.4 2.8) (cell-index nx ny) hub) hub)))
    ;; The overhead ray approaches Z=0 from above. Every picked box sits on
    ;; that plane, so ground is a fallback; the nearest structure/crystal wins.
    (define (pick-cell world camera px py width height)
      (let* ((pointer (pointer-ray camera px py width height))
             (ground (cell-hit (ground-ray-cell pointer) 1.0e30))
             (building (nearest-building world pointer (world-buildings world) (nearest-landmark world pointer ground))))
        ;; A ground-level deposit remains clickable behind a tall silhouette.
        ;; Roof/crystal-tip clicks still use the nearest illustrated object.
        (cond ((and (>= (hit-cell ground) 0) (hub-cell? world (index-x (hit-cell ground)) (index-y (hit-cell ground))))
               (cell-index (world-hub-x world) (world-hub-y world)))
              ((and (>= (hit-cell ground) 0)
                    (> (deposit-rate (world-seed world) (index-x (hit-cell ground)) (index-y (hit-cell ground))) 0)
                    (known? world (index-x (hit-cell ground)) (index-y (hit-cell ground))))
               (hit-cell ground))
              (else (hit-cell (nearest-deposit world pointer (hit-cell ground) -1 -1 building))))))
    (define (position x y z) (vec3 (scalar x) (- 0.0 (scalar y)) z))
    (define (moving-position x y z)
      (vec3 (- (/ (scalar x) 40.0) 0.5) (- 0.5 (/ (scalar y) 40.0)) z))
    (define (rgb r g b) (+ (+ (* r 65536) (* g 256)) b))
    ;; Deep blue outlines keep the warm roofs and jewel-colored machinery
    ;; distinct against sunny grass. Violet gems contrast with turquoise shields.
    (define steel (material (rgb 28 62 91) 0.0))
    (define cream (material (rgb 255 244 203) 0.0))
    (define brass (material (rgb 255 185 49) 0.05))
    (define cyan (material (rgb 35 242 195) 0.25))
    (define blue (material (rgb 54 126 238) 0.1))
    (define rust (material (rgb 245 99 66) 0.05))
    (define warning (material (rgb 255 78 96) 0.35))
    (define violet (material (rgb 187 109 244) 0.1))
    (define gemstone (material (rgb 119 59 229) 0.35))
    (define gem-light (material (rgb 188 139 255) 0.3))
    (define indigo (material (rgb 68 49 178) 0.25))
    (define lamp (material (rgb 255 244 142) 0.9))
    (define (shape geometry surface x y z w d h)
      (mesh geometry surface (compose (translation (vec3 x y z)) (scaling w d h))))
    (define (block surface x y z w d h) (shape box-geometry surface x y z w d h))
    (define (flat surface x y z w d) (shape plane-geometry surface x y z w d 1.0))
    (define (at-cell x y children) (group (translation (position x y 0.0)) children))

    ;; ---- Surveyed ground, rocks and readable mineral clusters ----

    (define (ground-material world x y)
      (cond ((not (visible? world x y)) (material (rgb 67 144 113) 0.0))
            ((= (remainder (+ (* x 13) (* y 7)) 5) 0) (material (rgb 154 224 74) 0.0))
            ((= (remainder (+ x (* y 3)) 3) 0) (material (rgb 95 190 70) 0.0))
            (else (material (rgb 121 211 78) 0.0))))
    (define (mineral-cluster)
      (list (shape pyramid-geometry gemstone -0.2 0.0 0.32 0.36 0.36 0.64)
            (shape pyramid-geometry gem-light 0.2 0.12 0.22 0.3 0.3 0.44)
            (shape pyramid-geometry indigo 0.08 -0.22 0.16 0.22 0.22 0.32)))
    (define (rock-nodes world x y)
      (let* ((remaining (world-rock-remaining world x y)) (fraction (/ (scalar remaining) (scalar rock-health)))
             (height (* 0.85 fraction)))
        (append (list (shape pyramid-geometry (material (rgb 196 204 179) 0.0)
                             0.0 0.0 (/ height 2.0) 1.0 0.94 height))
                (if (= remaining rock-health) (empty-list)
                    (list (block steel 0.0 -0.27 (* height 0.45) 0.045 0.08 (* height 0.8))
                          (block steel 0.0 0.0 (* height 0.82) 0.6 0.045 0.04))))))
    (define (terrain-cell world x y step)
      (let ((surface (if (and (world-ground? world x y) (not (ground? (world-seed world) x y)))
                         (material (rgb 174 139 95) 0.0) (ground-material world x y)))
            (size (scalar step)))
        (at-cell x y
                 (cons (flat surface 0.0 0.0 0.0 (* 0.985 size) (* 0.985 size))
                       (cond ((water? (world-seed world) x y) (list (flat blue 0.0 0.0 0.012 size size)))
                             ((not (world-ground? world x y))
                              (if (= step 1) (rock-nodes world x y)
                                  (list (flat (material (rgb 196 204 179) 0.0) 0.0 0.0 0.02 size size))))
                             (else (empty-list)))))))
    ;; Quantized frustum bounds keep camera-only motion within a chunk free of
    ;; geometry uploads. Work scales with the visible area, never total map size.
    (define TerrainWindow
      (datatype ()
        (terrain-window
         (left I32 window-left)
         (top I32 window-top)
         (right I32 window-right)
         (bottom I32 window-bottom)
         (step I32 window-step))))
    (define (min a b) (if (< a b) a b))
    (define (max a b) (if (> a b) a b))
    (define min-real (ann (lambda (a b) (if (< a b) a b)) (-> F64 F64 F64)))
    (define max-real (ann (lambda (a b) (if (> a b) a b)) (-> F64 F64 F64)))
    (define (camera-corner camera x y)
      (car (ray-ground (camera-ray camera x y) 0.0)))
    (define (chunk-floor value) (* 8 (whole (floor (/ value 8.0)))))
    (define (real-absolute value) (if (< value 0.0) (- 0.0 value) value))
    (define (terrain-step a b)
      (let ((span (max-real (real-absolute (- (vec3-x a) (vec3-x b)))
                            (real-absolute (- (vec3-y a) (vec3-y b))))))
        (cond ((> span 256.0) 8) ((> span 128.0) 4) ((> span 64.0) 2) (else 1))))
    (define (camera-window camera)
      (let* ((a (camera-corner camera -1.0 -1.0)) (b (camera-corner camera 1.0 -1.0))
             (c (camera-corner camera -1.0 1.0)) (d (camera-corner camera 1.0 1.0)))
        (terrain-window (max 0 (chunk-floor (- (min-real (min-real (vec3-x a) (vec3-x b)) (min-real (vec3-x c) (vec3-x d))) 2.0)))
                        (max 0 (chunk-floor (- (- 0.0 (max-real (max-real (vec3-y a) (vec3-y b)) (max-real (vec3-y c) (vec3-y d)))) 2.0)))
                        (min map-width (+ 8 (chunk-floor (+ (max-real (max-real (vec3-x a) (vec3-x b)) (max-real (vec3-x c) (vec3-x d))) 2.0))))
                        (min map-height (+ 8 (chunk-floor (+ (- 0.0 (min-real (min-real (vec3-y a) (vec3-y b)) (min-real (vec3-y c) (vec3-y d)))) 2.0))))
                        (terrain-step a d))))
    ;; Old observations never fade. The newest circle gets a GPU fragment
    ;; reveal; nearby workers illuminate their small local circle immediately.
    (define (old-coverage? world x y)
      (or (and (not (null? (world-surveys world))) (surveyed? (cdr (world-surveys world)) x y))
          (workers-see? (world-bots world) x y)))
    (define (fog-layer? world x y fresh)
      (and (known? world x y) (if fresh (not (old-coverage? world x y)) (old-coverage? world x y))))
    (define (reveal-id world)
      (i64->i32 (remainder (+ (* (i32->i64 (world-run-marker world)) (i32->i64 2147483647))
                              (+ (* (i32->i64 (world-seed world)) (i32->i64 65537)) (i32->i64 (+ (world-last-reveal-tick world) 100))))
                           (i32->i64 2147483629))))
    (define (revealed-batch world batch)
      (if (null? (world-surveys world)) batch
          (let ((fresh (car (world-surveys world))))
            (reveal-batch batch (reveal-id world) (scalar (survey-x fresh)) (- 0.0 (scalar (survey-y fresh)))
                          (+ 1.0 (scalar (survey-radius fresh))) 0.0
                          (* 100 (max 0 (min 30 (- (world-tick world) (world-last-reveal-tick world))))) 3000))))
    (define (terrain-nodes world window fresh x y)
      (cond ((>= y (window-bottom window)) (empty-list))
            ((>= x (window-right window)) (terrain-nodes world window fresh (window-left window) (+ y (window-step window))))
            ((fog-layer? world x y fresh)
             (cons (terrain-cell world x y (window-step window)) (terrain-nodes world window fresh (+ x (window-step window)) y)))
            (else (terrain-nodes world window fresh (+ x (window-step window)) y))))
    (define (water-glints world window fresh x y)
      (cond ((>= y (window-bottom window)) (empty-list))
            ((>= x (window-right window)) (water-glints world window fresh (window-left window) (+ y (window-step window))))
            ((and (water? (world-seed world) x y) (fog-layer? world x y fresh))
             (cons (at-cell x y (list (flat cyan 0.0 0.0 0.025 0.6 0.035)))
                   (water-glints world window fresh (+ x (window-step window)) y)))
            (else (water-glints world window fresh (+ x (window-step window)) y))))
    (define (mineral-at world window x y glow fresh)
      (if (and (>= x (window-left window)) (< x (window-right window))
               (>= y (window-top window)) (< y (window-bottom window))
               (> (deposit-rate (world-seed world) x y) 0) (fog-layer? world x y fresh) (null? (building-at (world-buildings world) x y)))
          (list (at-cell x y (if glow (list (flat gemstone 0.0 0.0 0.025 0.85 0.85)) (mineral-cluster))))
          (empty-list)))
    (define (regional-minerals world window glow fresh rx ry)
      (cond ((>= ry 9) (empty-list)) ((>= rx 12) (regional-minerals world window glow fresh 0 (+ ry 1)))
            (else (append (mineral-at world window (regional-deposit-x (world-seed world) rx ry)
                                      (regional-deposit-y (world-seed world) rx ry) glow fresh)
                          (regional-minerals world window glow fresh (+ rx 1) ry)))))
    (define (mineral-nodes world window glow fresh)
      (append (append (mineral-at world window (+ (world-hub-x world) 4) (- (world-hub-y world) 2) glow fresh)
                      (mineral-at world window (northern-x (world-seed world)) (northern-y (world-seed world)) glow fresh))
              (append (mineral-at world window (eastern-x (world-seed world)) (eastern-y (world-seed world)) glow fresh)
                      (regional-minerals world window glow fresh 0 0))))
    (define (window-dependencies window)
      (list (window-left window) (window-top window) (window-right window) (window-bottom window) (window-step window)))
    (define (survey-dependencies surveys)
      (if (null? surveys) (empty-list)
          (let ((value (car surveys)))
            (cons (survey-x value) (cons (survey-y value) (cons (survey-radius value)
                                                                (survey-dependencies (cdr surveys))))))))
    (define (observer-dependencies buildings)
      (if (null? buildings) (empty-list)
          (let ((value (car buildings)))
            (cons (building-kind value) (cons (building-x value) (cons (building-y value)
                                                                       (cons (building-level value) (cons (if (ready? value) 1 0)
                                                                                                          (observer-dependencies (cdr buildings))))))))))
    (define (dig-dependencies excavations)
      (if (null? excavations) (empty-list)
          (cons (dig-cell (car excavations)) (cons (dig-remaining (car excavations)) (dig-dependencies (cdr excavations))))))
    (define (vision-dependencies bots)
      (if (null? bots) (empty-list)
          (cons (bot-x (car bots))
                (cons (bot-y (car bots)) (vision-dependencies (cdr bots))))))
    (define (terrain-dependencies world)
      ;; Segment lengths make the concatenated exact data unambiguous.
      (append (list (world-seed world) (list-size (world-bots world)) (list-size (world-breaches world))
                    (list-size (world-excavations world)) (list-size (world-surveys world)) (list-size (world-buildings world)))
              (append (vision-dependencies (world-bots world))
                      (append (world-breaches world)
                              (append (dig-dependencies (world-excavations world))
                                      (append (survey-dependencies (world-surveys world))
                                              (observer-dependencies (world-buildings world))))))))
    (define (hub-nodes world)
      (list (at-cell (world-hub-x world) (world-hub-y world)
                     (list (block steel 0.0 0.0 0.12 3.0 3.0 0.24)
                           (block cream 0.0 0.0 0.77 2.6 2.6 1.3)
                           (block brass 0.0 0.0 1.49 2.9 2.9 0.14)
                           (block lamp 0.0 0.0 1.58 1.35 0.22 0.04)
                           (block lamp 0.0 0.0 1.58 0.22 1.35 0.04)
                           (block steel -1.12 0.95 1.78 0.08 0.08 0.8)
                           (block blue -1.12 0.95 2.19 0.22 0.22 0.12)
                           (block cyan 0.0 -1.31 0.88 1.5 0.04 0.48)
                           (block steel -1.0 -1.32 0.65 0.32 0.05 0.9)
                           (block steel 1.0 -1.32 0.65 0.32 0.05 0.9)))))

    ;; ---- Buildings share primitives but retain distinct silhouettes ----

    ;; Laid tracks are sorted by cell. A deck keeps all connected directions,
    ;; including intersections, open beneath a building rather than hiding rail.
    (define (site-track tracks cell)
      (cond ((null? tracks) 0) ((> (track-cell (car tracks)) cell) 0)
            ((= (track-cell (car tracks)) cell) (car tracks))
            (else (site-track (cdr tracks) cell))))
    (define (site-lift world x y)
      (if (= (site-track (world-tracks world) (cell-index x y)) 0) 0.0 1.0))
    (define (rail-platform track)
      (if (= track 0) (empty-list)
          (let ((x (if (or (track-north? track) (track-south? track)) 0.4 0.3))
                (y (if (or (track-east? track) (track-west? track)) 0.4 0.3)))
            (list (block cream 0.0 0.0 0.94 0.98 0.98 0.12)
                  (block steel (- 0.0 x) (- 0.0 y) 0.45 0.14 0.14 0.9)
                  (block steel x (- 0.0 y) 0.45 0.14 0.14 0.9)
                  (block steel (- 0.0 x) y 0.45 0.14 0.14 0.9)
                  (block steel x y 0.45 0.14 0.14 0.9)))))

    (define (mine-nodes building)
      (list (block steel 0.0 0.0 0.14 0.9 0.9 0.28)
            (block gemstone -0.28 0.0 0.51 0.18 0.65 0.75)
            (block gem-light 0.28 0.0 0.51 0.18 0.65 0.75)
            (block cream 0.0 0.0 0.93 0.85 0.24 0.16)
            (shape pyramid-geometry steel 0.0 0.0 0.44 0.3 0.3 0.64)
            (block brass -0.56 -0.15 0.12 0.2 0.42 0.24)
            (block (if (>= (building-level building) 2) brass steel) 0.56 -0.15 0.12 0.2 0.42 0.24)))
    (define (cannon-nodes building height)
      (let* ((target (moving-position (building-aim-x building) (building-aim-y building) 0.0))
             (direction (v- target (position (building-x building) (building-y building) 0.0)))
             (aim (if (< (dot direction direction) 0.001) (vec3 0.0 1.0 0.0) direction))
             (center (vec3 0.0 0.0 height)))
        (list (group (look-at center (v+ center aim) (vec3 0.0 0.0 1.0))
                     (list (block rust 0.0 -0.1 0.0 0.58 0.5 0.32)
                           (block cream 0.0 0.35 0.09 0.22 0.72 0.22)
                           (block steel 0.0 0.75 0.09 0.15 0.42 0.15)
                           (block brass 0.0 0.97 0.09 0.27 0.12 0.27)
                           (block steel 0.0 1.035 0.09 0.14 0.015 0.14))))))
    (define (artillery-nodes building)
      (append (list (block steel 0.0 0.0 0.1 0.94 0.94 0.2)
                    (block steel -0.36 0.0 0.26 0.18 0.86 0.32)
                    (block steel 0.36 0.0 0.26 0.18 0.86 0.32)
                    (block rust 0.0 0.0 0.3 0.56 0.66 0.3)
                    (block cream 0.0 0.0 0.5 0.68 0.58 0.12)
                    (block (if (>= (building-level building) 2) brass steel) -0.4 -0.26 0.46 0.18 0.26 0.2)
                    (block (if (>= (building-level building) 3) brass steel) 0.4 -0.26 0.46 0.18 0.26 0.2))
              (cannon-nodes building 0.68)))
    (define (tower-nodes building)
      (append (list (block steel 0.0 0.0 0.12 0.9 0.9 0.24)
                    (block blue -0.18 0.0 0.61 0.12 0.12 1.0)
                    (block blue 0.18 0.0 0.61 0.12 0.12 1.0)
                    (block cream 0.0 0.0 1.06 0.7 0.22 0.13)
                    (shape pyramid-geometry blue 0.0 0.0 1.35 0.46 0.46 0.5)
                    (block lamp 0.0 0.0 1.6 0.13 0.13 0.13)
                    (block brass 0.45 -0.15 0.27 0.28 0.46 0.3))
              (append (if (>= (building-level building) 2)
                          (list (block cyan 0.0 0.0 1.06 0.88 0.35 0.08)) (empty-list))
                      (append (if (= (building-level building) 3)
                                  (list (block cream -0.38 0.0 0.64 0.14 0.8 1.05)
                                        (block cream 0.38 0.0 0.64 0.14 0.8 1.05)
                                        (block brass 0.0 0.0 1.18 0.9 0.8 0.15)
                                        (block blue 0.0 -0.42 1.16 0.35 0.04 0.2)) (empty-list))
                              (if (armed? building) (cannon-nodes building 1.1) (empty-list))))))
    (define (wall-at? world x y)
      (let ((found (building-at (world-buildings world) x y)))
        (and (not (null? found)) (= (building-kind (car found)) 4) (ready? (car found)))))
    (define (wall-connects? world x y dx dy)
      (and (wall-at? world (+ x dx) (+ y dy))
           (or (= dx 0) (= dy 0)
               (and (not (wall-at? world (+ x dx) y)) (not (wall-at? world x (+ y dy)))))))
    (define (wall-connected? world x y dx dy)
      (cond ((> dy 1) #f) ((> dx 1) (wall-connected? world x y -1 (+ dy 1)))
            (else (or (and (not (and (= dx 0) (= dy 0))) (wall-connects? world x y dx dy))
                      (wall-connected? world x y (+ dx 1) dy)))))
    (define (wall-link world site dx dy glass)
      (let ((x (building-x site)) (y (building-y site)))
        (if (not (wall-connects? world x y dx dy)) (empty-list)
            (let* ((delta (vec3 (scalar dx) (- 0.0 (scalar dy))
                                (- (site-lift world (+ x dx) (+ y dy)) (site-lift world x y))))
                   (span (sqrt (dot delta delta))))
              (list (group (look-at (vec3 0.0 0.0 0.0) delta (vec3 0.0 0.0 1.0))
                           (if glass (list (block cyan 0.0 (/ span 2.0) 0.43 0.045 span 0.64))
                               (list (block cyan 0.0 (/ span 2.0) 0.79 0.065 span 0.05)
                                     (block steel 0.0 (/ span 2.0) 0.1 0.065 span 0.05)))))))))
    ;; Four forward directions own every connection once. Diagonals bridge
    ;; empty corners; cardinal neighbors suppress unnecessary crossing panels.
    (define (wall-links world site glass)
      (append (append (wall-link world site 1 -1 glass) (wall-link world site 1 0 glass))
              (append (wall-link world site 1 1 glass) (wall-link world site 0 1 glass))))
    (define (wall-frame world site)
      (append (list (block steel 0.0 0.0 0.4 0.13 0.13 0.8)
                    (block lamp 0.0 0.0 0.84 0.2 0.2 0.08))
              (if (wall-connected? world (building-x site) (building-y site) -1 -1) (wall-links world site #f)
                  (list (block cyan 0.0 0.0 0.79 0.84 0.06 0.05)
                        (block cyan 0.0 0.0 0.79 0.06 0.84 0.05)))))
    (define (wall-panels world site)
      (if (wall-connected? world (building-x site) (building-y site) -1 -1) (wall-links world site #t)
          (list (block cyan 0.0 0.0 0.43 0.84 0.045 0.64)
                (block cyan 0.0 0.0 0.43 0.045 0.84 0.64))))
    (define (wall-shields world buildings)
      (if (null? buildings) (empty-list)
          (let ((site (car buildings)) (rest (wall-shields world (cdr buildings))))
            (if (and (= (building-kind site) 4) (ready? site))
                (cons (at-cell (building-x site) (building-y site)
                               (list (group (translation (vec3 0.0 0.0 (site-lift world (building-x site) (building-y site))))
                                            (wall-panels world site)))) rest) rest))))
    (define (building-shape world building)
      (if (ready? building)
          (cond ((= (building-kind building) 1) (mine-nodes building))
                ((= (building-kind building) 3) (tower-nodes building))
                ((= (building-kind building) 4) (wall-frame world building))
                (else (artillery-nodes building)))
          (list (block steel 0.0 0.0 0.06 0.9 0.9 0.12)
                (block brass 0.0 0.0 0.22 0.43 0.43 0.32)
                (block lamp -0.4 -0.4 0.18 0.07 0.07 0.36)
                (block lamp 0.4 0.4 0.18 0.07 0.07 0.36))))
    (define (site-nodes world building)
      (let ((track (site-track (world-tracks world) (cell-index (building-x building) (building-y building)))))
        (append (rail-platform track)
                (list (group (translation (vec3 0.0 0.0 (if (= track 0) 0.0 1.0))) (building-shape world building))))))
    (define (construction-warning)
      (list (block steel 0.0 -0.4 0.48 0.045 0.045 0.8)
            (block brass 0.0 -0.4 0.84 0.46 0.06 0.42)
            (block steel 0.0 -0.44 0.9 0.055 0.035 0.2)
            (block steel 0.0 -0.44 0.73 0.055 0.035 0.055)))
    (define (building-nodes world buildings)
      (if (null? buildings) (empty-list)
          (let ((building (car buildings)))
            (if (and (= (building-kind building) 4) (ready? building)) (building-nodes world (cdr buildings))
                (cons (at-cell (building-x building) (building-y building)
                               (append (site-nodes world building)
                                       (if (construction-hidden? world building) (construction-warning) (empty-list))))
                      (building-nodes world (cdr buildings)))))))
    (define (ready-walls buildings)
      (if (null? buildings) (empty-list)
          (let ((site (car buildings)) (rest (ready-walls (cdr buildings))))
            (if (and (= (building-kind site) 4) (ready? site)) (cons site rest) rest))))
    (define (wall-dependencies world walls)
      (if (null? walls) (empty-list)
          (let* ((site (car walls)) (x (building-x site)) (y (building-y site))
                 (track (site-track (world-tracks world) (cell-index x y))))
            (cons x (cons y (cons track (wall-dependencies world (cdr walls))))))))
    (define (wall-nodes world walls)
      (if (null? walls) (empty-list)
          (let ((site (car walls)))
            (cons (at-cell (building-x site) (building-y site) (site-nodes world site))
                  (wall-nodes world (cdr walls))))))

    ;; ---- Two raised rails, sleepers and loaded shuttles ----

    (define (rail-segment a b surface)
      (let* ((x (/ (+ (scalar (index-x a)) (scalar (index-x b))) 2.0))
             (y (- 0.0 (/ (+ (scalar (index-y a)) (scalar (index-y b))) 2.0)))
             (horizontal (= (index-y a) (index-y b))))
        (group (translation (vec3 x y 0.0))
               (if horizontal
                   (list (block surface 0.0 -0.14 0.08 1.05 0.045 0.07)
                         (block surface 0.0 0.14 0.08 1.05 0.045 0.07)
                         (block steel -0.24 0.0 0.035 0.07 0.43 0.05)
                         (block steel 0.24 0.0 0.035 0.07 0.43 0.05))
                   (list (block surface -0.14 0.0 0.08 0.045 1.05 0.07)
                         (block surface 0.14 0.0 0.08 0.045 1.05 0.07)
                         (block steel 0.0 -0.24 0.035 0.43 0.07 0.05)
                         (block steel 0.0 0.24 0.035 0.43 0.07 0.05))))))
    (define (shuttle-node rail before)
      (moving-group (translation (moving-position (rail-x before) (rail-y before) 0.0))
                    (translation (moving-position (rail-x rail) (rail-y rail) 0.0))
                    (append (list (block steel 0.0 0.0 0.22 0.46 0.38 0.2)
                                  (block cream -0.21 0.0 0.18 0.07 0.46 0.16)
                                  (block cream 0.21 0.0 0.18 0.07 0.46 0.16))
                            (if (> (rail-cargo rail) 0) (list (block brass 0.0 0.0 0.39 0.31 0.27 0.17)) (empty-list)))))
    (define (prior-rail rails source fallback)
      (cond ((null? rails) fallback) ((= (rail-source (car rails)) source) (car rails))
            (else (prior-rail (cdr rails) source fallback))))
    (define (shuttle-nodes rails previous)
      (if (null? rails) (empty-list)
          (cons (shuttle-node (car rails) (prior-rail previous (rail-source (car rails)) (car rails)))
                (shuttle-nodes (cdr rails) previous))))
    ;; Physical rails outlive their station records. Cull before staging exact
    ;; dependencies, and simplify dense/remote geometry over the bounded grid.
    (define (window-tracks tracks window found)
      (if (null? tracks) found
          (let* ((track (car tracks)) (cell (track-cell track)) (x (index-x cell)) (y (index-y cell)))
            (window-tracks (cdr tracks) window
                           (if (and (>= x (window-left window)) (< x (window-right window))
                                    (>= y (window-top window)) (< y (window-bottom window))) (cons track found) found)))))
    (define (sample-tracks tracks stride found)
      (if (null? tracks) found
          (let* ((track (car tracks)) (cell (track-cell track)))
            (sample-tracks (cdr tracks) stride
                           (if (or (= (remainder (index-x cell) stride) 0) (= (remainder (index-y cell) stride) 0))
                               (cons track found) found)))))
    (define (track-stride tracks window)
      (if (or (> (window-step window) 1) (> (list-size tracks) 8192)) (max 4 (window-step window)) 1))
    (define (simple-track track)
      (let* ((cell (track-cell track)) (x (scalar (index-x cell))) (y (- 0.0 (scalar (index-y cell)))))
        (append (if (track-east? track) (list (flat cream (+ x 0.5) y 0.08 1.05 0.09)) (empty-list))
                (if (track-south? track) (list (flat cream x (- y 0.5) 0.08 0.09 1.05)) (empty-list)))))
    (define (track-geometry track detailed stride)
      (let ((cell (track-cell track)))
        (cond ((> stride 1) (list (at-cell (index-x cell) (index-y cell) (list (flat cream 0.0 0.0 0.08 0.9 0.9)))))
              ((not detailed) (simple-track track))
              (else (append (if (track-east? track) (list (rail-segment cell (+ cell 1) cream)) (empty-list))
                            (if (track-south? track) (list (rail-segment cell (+ cell map-width) cream)) (empty-list)))))))
    (define (physical-track-nodes tracks detailed stride found)
      (if (null? tracks) found
          (physical-track-nodes (cdr tracks) detailed stride
                                (cons (group identity-transform (track-geometry (car tracks) detailed stride)) found))))

    ;; ---- Workers, cargo and threats remain visible at colony scale ----

    (define (worker-surface bot)
      (cond ((= (bot-job bot) 7) warning) ((or (= (bot-job bot) 8) (= (bot-job bot) 9)) cyan)
            ((> (bot-cargo bot) 0) brass) (else violet)))
    (define (cargo-destination world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) (empty-list)
            (cond ((= (building-kind (car found)) 3)
                   (list (block blue 0.0 -0.18 0.72 0.09 0.09 0.28)
                         (shape pyramid-geometry blue 0.0 -0.18 0.89 0.22 0.22 0.16)))
                  ((= (building-kind (car found)) 2)
                   (list (block rust 0.0 -0.18 0.68 0.27 0.16 0.12)
                         (block cream 0.0 -0.02 0.73 0.08 0.26 0.08)))
                  ((= (building-kind (car found)) 4) (list (block steel 0.0 -0.18 0.72 0.25 0.16 0.16)))
                  (else (list (block cyan 0.0 -0.18 0.73 0.25 0.1 0.22)))))))
    (define (cargo-nodes world bot)
      (cond ((<= (bot-cargo bot) 0) (empty-list))
            ((ore-cargo? bot)
             (list (block brass 0.0 -0.2 0.37 0.34 0.23 0.16)
                   (shape pyramid-geometry gemstone 0.0 -0.2 0.56 0.24 0.2 0.28)))
            (else (append (list (block cream 0.0 -0.2 0.45 0.38 0.3 0.32)
                                (block steel 0.0 -0.36 0.45 0.08 0.025 0.34))
                          (cargo-destination world bot)))))
    (define (fear-nodes tick bot)
      (if (not (= (bot-job bot) 7)) (empty-list)
          (let ((lift (* (scalar (remainder (+ tick (bot-id bot)) 6)) 0.035)))
            (list (block cyan -0.29 0.03 (+ 0.56 lift) 0.09 0.09 0.12)
                  (shape pyramid-geometry cyan -0.29 0.03 (+ 0.65 lift) 0.08 0.08 0.12)
                  (block cream 0.27 0.02 (- 0.76 lift) 0.075 0.075 0.12)))))
    (define (worker-pose bot offset)
      (let* ((point (v+ (moving-position (bot-x bot) (bot-y bot) 0.0) offset))
             (path (bot-path bot))
             (delta (if (null? path) (vec3 0.0 1.0 0.0)
                        (v- (position (index-x (car path)) (index-y (car path)) 0.0)
                            (moving-position (bot-x bot) (bot-y bot) 0.0)))))
        (look-at point (v+ point (if (< (dot delta delta) 0.0001) (vec3 0.0 1.0 0.0) delta)) (vec3 0.0 0.0 1.0))))
    (define (previous-bot bots id fallback)
      (cond ((null? bots) fallback) ((= (bot-id (car bots)) id) (car bots))
            (else (previous-bot (cdr bots) id fallback))))
    (define (worker-offset world bot)
      (let ((parked (and (= (bot-x bot) (cell-x (world-hub-x world))) (= (bot-y bot) (cell-y (world-hub-y world)))))
            (shake (if (= (bot-job bot) 7) (if (= (remainder (world-tick world) 2) 0) -0.045 0.045) 0.0)))
        (if parked (vec3 (- (* (scalar (remainder (bot-id bot) 5)) 0.36) 0.72) -1.7 0.0) (vec3 shake 0.0 0.0))))
    (define (worker-cart world bot)
      (append (list (block cream 0.0 0.0 0.12 0.42 0.42 0.18)
                    (block steel -0.22 0.0 0.09 0.08 0.4 0.12)
                    (block steel 0.22 0.0 0.09 0.08 0.4 0.12))
              (if (> (bot-cargo bot) 0)
                  (list (group (translation (vec3 0.0 -0.62 -0.15))
                               (append (list (block cream 0.0 0.0 0.24 0.42 0.44 0.17)
                                             (block steel -0.22 0.0 0.17 0.07 0.42 0.12)
                                             (block steel 0.22 0.0 0.17 0.07 0.42 0.12))
                                       (cargo-nodes world bot)))) (empty-list))))
    (define (worker-node world previous bot)
      (let ((before (previous-bot (world-bots previous) (bot-id bot) bot)))
        (moving-group (worker-pose before (worker-offset previous before)) (worker-pose bot (worker-offset world bot))
                      (append (list (block steel 0.0 0.0 0.09 0.33 0.24 0.12)
                                    (block (worker-surface bot) 0.0 0.0 0.2 0.22 0.3 0.2)
                                    (block lamp 0.0 0.12 0.3 0.14 0.09 0.08))
                              (append (if (bot-riding? world bot) (worker-cart world bot) (cargo-nodes world bot))
                                      (fear-nodes (world-tick world) bot))))))
    (define (worker-nodes world previous bots)
      (if (null? bots) (empty-list) (cons (worker-node world previous (car bots)) (worker-nodes world previous (cdr bots)))))
    (define (rank-surface rank)
      (cond ((= rank 0) rust) ((= rank 1) brass) ((= rank 2) blue)
            ((= rank 3) indigo) ((= rank 4) violet) ((= rank 5) cream) (else warning)))
    (define (rank-armor rank)
      (append (if (< rank 1) (empty-list)
                  (list (block steel 0.0 0.0 0.3 0.56 0.42 0.16)))
              (append (if (< rank 2) (empty-list)
                          (list (shape pyramid-geometry cream -0.25 0.12 0.58 0.17 0.18 0.5)
                                (shape pyramid-geometry cream 0.25 0.12 0.58 0.17 0.18 0.5)))
                      (if (< rank 4) (empty-list)
                          (list (block brass 0.0 0.0 0.76 0.52 0.2 0.1)
                                (shape pyramid-geometry warning 0.0 0.0 0.94 0.25 0.2 0.32))))))
    (define (enemy-body enemy)
      (let* ((rank (enemy-rank enemy)) (raider (= (enemy-kind enemy) 1))
             (size (if (= rank 6) 2.8 (+ 0.85 (* 0.2 (scalar rank))))))
        (group (scaling size size size)
               (append (list (block steel 0.0 0.0 0.11 0.5 0.35 0.18)
                             (shape pyramid-geometry (rank-surface rank) 0.0 0.0 (if raider 0.25 0.37)
                                    (if raider 0.65 0.45) 0.45 (if raider 0.25 0.5)))
                       (append (rank-armor rank)
                               (if (enemy-burrower enemy)
                                   (list (shape pyramid-geometry brass 0.0 -0.24 0.21 0.25 0.35 0.24)) (empty-list)))))))
    (define (enemy-dust world enemy)
      (if (world-ground? world (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size))
          (empty-list)
          (let ((phase (* (scalar (remainder (+ (world-tick world) (enemy-id enemy)) 5)) 0.06)))
            (list (block cream -0.3 0.0 (+ 1.4 phase) 0.21 0.21 0.21)
                  (block brass 0.2 0.12 (- 1.7 phase) 0.16 0.16 0.16)))))
    (define (previous-enemy enemies id fallback)
      (cond ((null? enemies) fallback) ((= (enemy-id (car enemies)) id) (car enemies))
            (else (previous-enemy (cdr enemies) id fallback))))
    (define (enemy-nodes world previous enemies)
      (if (null? enemies) (empty-list)
          (let* ((enemy (car enemies)) (before (previous-enemy (world-enemies previous) (enemy-id enemy) enemy)))
            (append (if (visible? world (quotient (enemy-x enemy) 40) (quotient (enemy-y enemy) 40))
                        (list (moving-group (translation (moving-position (enemy-x before) (enemy-y before) 0.0))
                                            (translation (moving-position (enemy-x enemy) (enemy-y enemy) 0.0))
                                            (cons (enemy-body enemy) (enemy-dust world enemy))))
                        (empty-list)) (enemy-nodes world previous (cdr enemies))))))
    (define (excavation-nodes world excavations)
      (if (null? excavations) (empty-list)
          (let* ((dig (car excavations)) (x (index-x (dig-cell dig))) (y (index-y (dig-cell dig)))
                 (phase (* (scalar (remainder (world-tick world) 8)) 0.045)))
            (append (if (known? world x y)
                        (list (at-cell x y (list (block cream -0.35 0.1 (+ 0.4 phase) 0.22 0.22 0.22)
                                                 (block brass 0.2 -0.1 (- 0.8 phase) 0.16 0.16 0.16)
                                                 (block lamp 0.0 -0.2 0.12 0.45 0.08 0.08)))) (empty-list))
                    (excavation-nodes world (cdr excavations))))))
    (define (smoke-puff tick alert index)
      (let* ((phase (remainder (+ tick (* index 7)) 24)) (prior (max 0 (- phase 1)))
             (x (+ (scalar (alert-x alert)) (* (- (scalar index) 1.5) 0.16)))
             (y (- 0.0 (scalar (alert-y alert))))
             (old (compose (translation (vec3 x y (+ 0.3 (* (scalar prior) 0.055))))
                           (scaling (+ 0.12 (* (scalar prior) 0.009)) 0.18 0.18)))
             (now (compose (translation (vec3 x y (+ 0.3 (* (scalar phase) 0.055))))
                           (scaling (+ 0.12 (* (scalar phase) 0.009)) 0.18 0.18))))
        (moving-group old now (list (block (if (= (remainder index 2) 0) cream steel) 0.0 0.0 0.0 1.0 1.0 1.0)))))
    (define (damage-smoke world alerts)
      (if (null? alerts) (empty-list)
          (append (if (and (< (- (world-tick world) (alert-tick (car alerts))) 20)
                           (known? world (alert-x (car alerts)) (alert-y (car alerts))))
                      (list (smoke-puff (world-tick world) (car alerts) 0) (smoke-puff (world-tick world) (car alerts) 1)
                            (smoke-puff (world-tick world) (car alerts) 2) (smoke-puff (world-tick world) (car alerts) 3)) (empty-list))
                  (damage-smoke world (cdr alerts)))))
    ;; Travel takes two display-interpolated simulation intervals, followed by
    ;; one impact flash. Damage and saved aim still belong to the reducer.
    (define (shot-node world building)
      (let* ((start (position (building-x building) (building-y building)
                              (+ (site-lift world (building-x building) (building-y building)) (if (tower? building) 1.25 0.77))))
             (target (moving-position (building-aim-x building) (building-aim-y building) 0.2))
             (direction (v- target start)) (age (- 8 (building-cooldown building))))
        (if (= age 2)
            (group (translation target) (list (block lamp 0.0 0.0 0.0 0.4 0.07 0.07)
                                              (block lamp 0.0 0.0 0.0 0.07 0.4 0.07)))
            (let ((from (v+ start (v* direction (/ (scalar age) 2.0))))
                  (to (v+ start (v* direction (/ (+ (scalar age) 1.0) 2.0)))))
              (moving-group (look-at from (v+ from direction) (vec3 1.0 0.0 0.0))
                            (look-at to (v+ to direction) (vec3 1.0 0.0 0.0))
                            (list (block lamp 0.0 0.0 0.0 0.075 0.35 0.075)))))))
    (define (shot-nodes world buildings)
      (if (null? buildings) (empty-list)
          (let ((building (car buildings)))
            (if (and (ready? building) (armed? building) (>= (building-cooldown building) 6))
                (cons (shot-node world building) (shot-nodes world (cdr buildings))) (shot-nodes world (cdr buildings))))))

    ;; ---- Hover and construction previews are world-space scene data ----

    (define (active-guns buildings)
      (if (null? buildings) (empty-list)
          (let ((site (car buildings)) (rest (active-guns (cdr buildings))))
            (if (and (ready? site) (armed? site)) (cons site rest) rest))))
    (define (gun-covers? gun x y)
      (and (inside? x y) (within? (cell-x x) (cell-y y)
                                  (cell-x (building-x gun)) (cell-y (building-y gun)) artillery-range)))
    (define (covered? guns x y)
      (and (not (null? guns))
           (or (gun-covers? (car guns) x y) (covered? (cdr guns) x y))))
    (define (coverage-edge guns x y dx dy)
      (if (covered? guns (+ x dx) (+ y dy)) (empty-list)
          (list (flat brass (+ (scalar x) (* 0.5 (scalar dx))) (- 0.0 (+ (scalar y) (* 0.5 (scalar dy))))
                      0.07 (if (= dx 0) 1.06 0.06) (if (= dy 0) 1.06 0.06)))))
    (define (coverage-cell guns earlier gun window x y)
      (if (or (< x (window-left window)) (>= x (window-right window))
              (< y (window-top window)) (>= y (window-bottom window))
              (not (gun-covers? gun x y)) (covered? earlier x y)) (empty-list)
              (append (append (coverage-edge guns x y -1 0) (coverage-edge guns x y 1 0))
                      (append (coverage-edge guns x y 0 -1) (coverage-edge guns x y 0 1)))))
    ;; Each covered cell belongs to the first gun that covers it. Only edges
    ;; with an uncovered neighbor survive, so overlap never draws internal seams.
    (define (gun-coverage guns earlier gun window radius dx dy)
      (cond ((> dy radius) (empty-list))
            ((> dx radius) (gun-coverage guns earlier gun window radius (- 0 radius) (+ dy 1)))
            (else (append (coverage-cell guns earlier gun window (+ (building-x gun) dx) (+ (building-y gun) dy))
                          (gun-coverage guns earlier gun window radius (+ dx 1) dy)))))
    (define (coverage-nodes guns remaining earlier window)
      (if (null? remaining) (empty-list)
          (let ((gun (car remaining)) (radius (quotient artillery-range cell-size)))
            (append (gun-coverage guns earlier gun window radius (- 0 radius) (- 0 radius))
                    (coverage-nodes guns (cdr remaining) (cons gun earlier) window)))))
    (define (starter-nodes world)
      (let ((site (starter-deposit world)))
        (if (< site 0) (empty-list)
            (list (at-cell (index-x site) (index-y site)
                           (list (block lamp -0.61 0.0 0.075 0.09 1.3 0.08)
                                 (block lamp 0.61 0.0 0.075 0.09 1.3 0.08)
                                 (block lamp 0.0 -0.61 0.075 1.3 0.09 0.08)
                                 (block lamp 0.0 0.61 0.075 1.3 0.09 0.08)))))))
    (define (boundary-dots count)
      (if (= count 4) (empty-list)
          (let ((at (+ -0.36 (* (scalar count) 0.24))))
            (append (list (block lamp at -0.48 0.07 0.12 0.035 0.025)
                          (block lamp at 0.48 0.07 0.12 0.035 0.025)
                          (block lamp -0.48 at 0.07 0.035 0.12 0.025)
                          (block lamp 0.48 at 0.07 0.035 0.12 0.025))
                    (boundary-dots (+ count 1))))))
    (define (construction-symbol)
      (list (group (transform (vec3 0.7071 0.7071 0.0) (vec3 -0.7071 0.7071 0.0)
                              (vec3 0.0 0.0 1.0) (vec3 0.0 0.0 0.1))
                   (list (flat lamp 0.0 -0.05 0.0 0.075 0.55)
                         (flat lamp 0.0 0.22 0.0 0.3 0.12)
                         (flat lamp 0.0 0.0 0.01 0.55 0.075)
                         (flat lamp -0.22 -0.07 0.01 0.12 0.1)
                         (flat lamp -0.22 0.07 0.01 0.12 0.1)))))
    ;; Illustrations use the requested kind and level as a completed structure.
    ;; record never enters the model or carries construction/cooldown state.
    (define (finished-illustration kind level x y aim-x aim-y armed)
      (make-building 0 kind x y level 1 0 2 0 aim-x aim-y armed 0 -1 -1))
    (define (preview-nodes world x y kind)
      (if (or (not (inside? x y)) (not (known? world x y))) (empty-list)
          (let ((occupied (or (not (null? (building-at (world-buildings world) x y)))
                              (hub-cell? world x y)
                              (and (= x (world-nest-x world)) (= y (world-nest-y world))))))
            (cond ((= kind 0) (list (at-cell x y (append (boundary-dots 0) (if occupied (empty-list) (construction-symbol))))))
                  (occupied (empty-list))
                  (else (let ((site (finished-illustration kind 1 x y (cell-x x) (cell-y y) 0)))
                          (list (at-cell x y (cons (flat cyan 0.0 0.0 0.05 0.98 0.98) (site-nodes world site))))))))))
    (define (plan-nodes world kind cells)
      (if (null? cells) (empty-list)
          (let* ((x (index-x (car cells))) (y (index-y (car cells)))
                 (surface (if (= (placement-reason world kind x y) 0) cyan warning)))
            (append (list (at-cell x y (list (flat surface 0.0 0.0 0.06 0.98 0.98))))
                    (append (preview-nodes world x y kind) (plan-nodes world kind (cdr cells)))))))
    (define (world-base)
      (let ((width (scalar map-width)) (height (scalar map-height)))
        (list (block (material (rgb 31 96 119) 0.7) (- (/ width 2.0) 0.5) (- 0.5 (/ height 2.0)) -0.4 width height 0.7)
              (block cream -0.5 (- 0.5 (/ height 2.0)) 0.02 0.12 height 0.06)
              (block cream (- width 0.5) (- 0.5 (/ height 2.0)) 0.02 0.12 height 0.06)
              (block cream (- (/ width 2.0) 0.5) 0.5 0.02 width 0.12 0.06)
              (block cream (- (/ width 2.0) 0.5) (- 0.5 height) 0.02 width 0.12 0.06))))
    (define (nest-nodes world)
      (let ((x (world-nest-x world)) (y (world-nest-y world)))
        (if (not (known? world x y)) (empty-list)
            (list (at-cell x y
                           (list (block steel 0.0 0.0 0.2 2.8 2.8 0.4)
                                 (shape pyramid-geometry violet 0.0 0.0 1.1 2.5 2.5 2.0)
                                 (shape pyramid-geometry cream -1.0 -1.0 1.4 0.55 0.55 2.8)
                                 (shape pyramid-geometry cream 1.0 1.0 1.4 0.55 0.55 2.8)
                                 (block warning 0.0 -1.24 0.6 1.1 0.08 0.7)))))))
    (define (construction-previews world buildings)
      (if (null? buildings) (empty-list)
          (let ((site (car buildings)))
            (append (if (ready? site) (empty-list)
                        (let ((finished (finished-illustration (building-kind site) (building-level site)
                                                               (building-x site) (building-y site)
                                                               (building-aim-x site) (building-aim-y site) (building-armed site))))
                          (list (at-cell (building-x site) (building-y site) (site-nodes world finished)))))
                    (construction-previews world (cdr buildings))))))
    (define (fog-buildings world buildings fresh)
      (if (null? buildings) (empty-list)
          (let ((site (car buildings)) (rest (fog-buildings world (cdr buildings) fresh)))
            ;; Own orders remain identifiable after a worker leaves unsurveyed
            ;; ground. Their warning is visible without exposing terrain/enemies.
            (if (or (fog-layer? world (building-x site) (building-y site) fresh)
                    (and (not fresh) (not (known? world (building-x site) (building-y site)))))
                (cons site rest) rest))))
    (define (fog-enemies world enemies fresh)
      (if (null? enemies) (empty-list)
          (let ((enemy (car enemies)) (rest (fog-enemies world (cdr enemies) fresh)))
            (if (fog-layer? world (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size) fresh)
                (cons enemy rest) rest))))
    (define (entity-nodes world previous fresh)
      (let ((buildings (fog-buildings world (world-buildings world) fresh)))
        (list (group identity-transform (append (building-nodes world buildings)
                                                (if (fog-layer? world (world-nest-x world) (world-nest-y world) fresh) (nest-nodes world) (empty-list))))
              (group identity-transform (if fresh (empty-list) (shuttle-nodes (world-rails world) (world-rails previous))))
              (group identity-transform (if fresh (empty-list) (worker-nodes world previous (world-bots world))))
              (group identity-transform (enemy-nodes world previous (fog-enemies world (world-enemies world) fresh)))
              (group identity-transform (append (shot-nodes world buildings)
                                                (if fresh (empty-list)
                                                    (append (excavation-nodes world (world-excavations world)) (damage-smoke world (world-alerts world)))))))))
    (define (colony-scene world previous camera x y preview-kind plan)
      (let* ((window (camera-window camera)) (terrain (append (window-dependencies window) (terrain-dependencies world)))
             (guns (active-guns (world-buildings world)))
             (walls (ready-walls (world-buildings world))) (wall-topology (wall-dependencies world walls))
             (visible-tracks (window-tracks (world-tracks world) window (empty-list)))
             (stride (track-stride visible-tracks window)) (tracks (sample-tracks visible-tracks stride (empty-list))))
        ;; All depth-writing ground/structures, including fresh reveals, precede
        ;; translucent previews, water, mineral glows and wall shields.
        (batched-scene camera
                       (list
                        (retained-batch 0 0 (list (world-seed world)) (lambda () (append (world-base) (hub-nodes world))))
                        (retained-batch 1 0 terrain
                                        (lambda () (append (terrain-nodes world window #f (window-left window) (window-top window))
                                                           (mineral-nodes world window #f #f))))
                        (retained-batch 2 0 (cons stride (append (window-dependencies window) tracks))
                                        (lambda () (physical-track-nodes tracks (< (list-size tracks) 128) stride (empty-list))))
                        (retained-batch 13 0 wall-topology (lambda () (wall-nodes world walls)))
                        (motion-batch 3 1 (empty-list) 100 (lambda () (append (starter-nodes world) (entity-nodes world previous #f))))
                        (retained-batch 4 0 (append (window-dependencies window) (observer-dependencies guns))
                                        (lambda () (coverage-nodes guns guns (empty-list) window)))
                        (revealed-batch world (retained-batch 9 0 terrain
                                                              (lambda () (append (terrain-nodes world window #t (window-left window) (window-top window))
                                                                                 (mineral-nodes world window #f #t)))))
                        (revealed-batch world (motion-batch 10 1 (empty-list) 100 (lambda () (entity-nodes world previous #t))))
                        (translucent-batch 5 1 (append (list x y preview-kind) plan) 0.45 #t
                                           (lambda () (append (plan-nodes world preview-kind plan)
                                                              (append (preview-nodes world x y preview-kind) (construction-previews world (world-buildings world))))))
                        (translucent-batch 6 0 terrain 0.25 #t
                                           (lambda () (water-glints world window #f (window-left window) (window-top window))))
                        (translucent-batch 7 0 terrain 0.55 #t (lambda () (mineral-nodes world window #t #f)))
                        (translucent-batch 8 0 wall-topology 0.23 #f (lambda () (wall-shields world walls)))
                        (revealed-batch world (translucent-batch 11 0 terrain 0.25 #t
                                                                 (lambda () (water-glints world window #t (window-left window) (window-top window)))))
                        (revealed-batch world (translucent-batch 12 0 terrain 0.55 #t (lambda () (mineral-nodes world window #t #t)))))
                       (camera-light camera) (vec3 0.5 0.5 0.46) (rgb 28 151 223))))))
