;; One mirrored edge rail projects committed colony values and local plans.
;; All actions are lexical typed requests; labels never carry command identity.
(define-library (siegework hud)
  (export HudContext hud-context hud-x hud-y hud-chooser hud-width hud-height hud-layout
          HudActions hud-actions colony-hud hud-notification-capacity hud-notification-y hud-attachment-x
          hud-control-diameter hud-attachment-width hud-notification-step)
  (import
   (scheme base)
   (scheme immutable)
   (application reducer)
   (browser application)
   (ui core)
   (siegework model)
   (siegework presentation)
   (siegework guidance)
   (siegework terrain)
   (only (lofi core) datatype -> I32)
   (only (lofi base) string-append))
  (begin

    ;; ---- Local presentation context and explicit application requests ----

    (define HudContext
      (datatype ()
        (hud-context
         (x I32 hud-x)
         (y I32 hud-y)
         (chooser Bool hud-chooser)
         (width I32 hud-width)
         (height I32 hud-height)
         (dialog I32 hud-dialog)
         (dialog-pending I32 hud-dialog-pending)
         (brush I32 hud-brush)
         (plan-count I32 hud-plan-count)
         (pending-count I32 hud-pending-count)
         (rejected I32 hud-rejected)
         (unconfirmed I32 hud-unconfirmed)
         (menu I32 hud-menu)
         (left-handed Bool hud-left-handed))))
    (define HudActions
      (datatype (Owner State)
        (hud-actions
         (choose (-> I32 (Request Owner State)) action-choose)
         (improve (Request Owner State) action-improve)
         (fabricate (Request Owner State) action-fabricate)
         (worker-menu (Request Owner State) action-worker-menu)
         (turn (-> I32 (Request Owner State)) action-turn)
         (repair (Request Owner State) action-repair)
         (home (Request Owner State) action-home)
         (dismiss (Request Owner State) action-dismiss)
         (cancel (Request Owner State) action-cancel)
         (restart (Request Owner State) action-restart)
         (accept-restart (Request Owner State) action-accept-restart)
         (dismiss-restart (Request Owner State) action-dismiss-restart)
         (build-menu (Request Owner State) action-build-menu)
         (pause-menu (Request Owner State) action-pause-menu)
         (resume (Request Owner State) action-resume)
         (handedness (Request Owner State) action-handedness)
         (done-plan (Request Owner State) action-done-plan)
         (clear-plan (Request Owner State) action-clear-plan))))
    (define (larger left right) (if (> left right) left right))
    (define (smaller left right) (if (< left right) left right))
    (define (alive? world) (= (world-outcome world) 0))
    (define hud-control-diameter 56)
    (define control-step (+ hud-control-diameter 4))
    (define rail-width (+ (* hud-control-diameter 2) 4))
    (define hud-attachment-width 172)
    (define hud-notification-step 96)
    (define rail-actions-y 144)
    (define onboarding-height 64)
    (define onboarding-y (+ rail-actions-y (quotient (- hud-control-diameter onboarding-height) 2)))
    (define (line key height text tone) (ui-label key (grow 1) (px height) text tone))
    (define (circle key shortcut help enabled selected request)
      (ui-button key (px hud-control-diameter) (px hud-control-diameter) shortcut help enabled selected request))
    (define (priced-circle key shortcut caption help enabled selected request)
      (ui-layer (string-append key "-priced") (px hud-control-diameter) (px hud-control-diameter)
                (list (circle key shortcut help enabled selected request)
                      (ui-at 2 39 (ui-label (string-append key "-caption") (px 52) (px 16) caption 0)))))
    (define (action-button key shortcut caption help enabled request)
      (ui-column (string-append key "-control") (px hud-control-diameter) (px 80) 4
                 (list (circle key shortcut help enabled #f request)
                       (ui-label (string-append key "-caption") (px hud-control-diameter) (px 20) caption 0))))
    (define (priced-help price description)
      (string-append (integer-text price) " ore · " description))
    (define (hud-root-width context) (larger 1 (- (hud-width context) 24)))
    (define (hud-root-height context) (larger 1 (- (hud-height context) 32)))
    (define (rail-columns context) (if (< (hud-root-height context) 320) 3 2))
    (define (hud-rail-width context) (- (* (rail-columns context) control-step) 4))
    (define (hud-rail-x context) (if (hud-left-handed context) 0 (- (hud-root-width context) (hud-rail-width context))))
    (define (hud-attachment-x context)
      (if (hud-left-handed context) (+ (hud-rail-width context) 8) (- (hud-rail-x context) (+ hud-attachment-width 8))))
    (define (hud-notification-capacity context)
      (smaller 3 (larger 0 (quotient (- (hud-root-height context) 168) hud-notification-step))))
    (define (onboarding-visible? world context)
      (and (= (hud-menu context) 0) (= (hud-brush context) 0) (= (hud-dialog context) 0)
           (not (hud-chooser context)) (extractor-start? world)))
    (define (hud-notification-y world context index)
      ;; The reserved context space also fits the hint between the first two alerts.
      (if (and (onboarding-visible? world context) (> index 0))
          (+ (+ onboarding-y onboarding-height) (+ 8 (* (- index 1) hud-notification-step)))
          (* index hud-notification-step)))
    (define (hud-layout world context)
      (rect (hud-attachment-x context) (* (hud-notification-capacity context) hud-notification-step) hud-attachment-width 156))

    ;; ---- Four readouts share the same circles on every viewport ----

    (define (active-workers bots)
      (if (null? bots) 0
          (let ((job (bot-job (car bots))))
            (+ (if (and (> job 0) (not (= job 7)) (not (= job 10))) 1 0)
               (active-workers (cdr bots))))))
    (define (ore-dial world)
      (ui-dial "ore" (px hud-control-diameter) (px hud-control-diameter) ""
               (string-append (integer-text (world-credits world)) " ore available") 1 1 0))
    (define (health-dial world)
      (ui-dial "health" (px hud-control-diameter) (px hud-control-diameter) (integer-text (world-hull world))
               (string-append "Hub health: " (integer-text (world-hull world)) " of 300")
               (world-hull world) 300 (if (< (world-hull world) 100) 4 2)))
    (define (workers-dial world)
      (let ((active (active-workers (world-bots world))) (total (list-size (world-bots world))))
        (ui-dial "workers" (px hud-control-diameter) (px hud-control-diameter) (string-append (integer-text active) "/" (integer-text total))
                 (string-append "Working jobs: " (integer-text active) " of " (integer-text total)
                                " workers; idle, fleeing and hiding excluded; queued: " (integer-text (pending-workers (world-bots world))))
                 active (larger total 1) 2)))
    (define (difficulty-dial value)
      (ui-dial "difficulty" (px hud-control-diameter) (px hud-control-diameter) (integer-text (difficulty-number value))
               (difficulty-help value) (difficulty-elapsed value) (difficulty-span value)
               (cond ((< (difficulty-number value) 3) 2) ((< (difficulty-number value) 6) 3) (else 4))))
    (define (readout key caption dial)
      (ui-layer key (px hud-control-diameter) (px 68)
                (list (ui-at 0 12 dial)
                      (ui-label (string-append key "-label") (px hud-control-diameter) (px 16) caption 0))))
    (define (readouts world)
      (let ((difficulty (project-difficulty (difficulty-window (world-tick world)) (world-tick world))))
        (ui-layer "readouts" (px rail-width) (px 140)
                  (list (readout "ore-readout" (string-append (integer-text (world-credits world)) " ore") (ore-dial world))
                        (ui-at control-step 0 (readout "health-readout" "Health" (health-dial world)))
                        (ui-at 0 72 (readout "worker-readout" "Working" (workers-dial world)))
                        (ui-at control-step 72 (readout "difficulty-readout" "Difficulty" (difficulty-dial difficulty)))))))

    ;; ---- A small action group changes mode; Done and Cancel stay reachable ----

    (define (brush-key kind)
      (cond ((= kind 1) "extractor") ((= kind 2) "artillery") ((= kind 3) "tower") (else "wall")))
    (define (brush-name kind)
      (cond ((= kind 1) "Extractor") ((= kind 2) "Artillery") ((= kind 3) "Tower") (else "Wall")))
    (define (brush-shortcut kind) (cond ((= kind 3) "2") ((= kind 2) "3") (else (integer-text kind))))
    (define (brush-control context actions kind current)
      (priced-circle (if current (string-append "selected-" (brush-key kind)) (brush-key kind))
                     (brush-shortcut kind) (string-append (integer-text (building-cost kind)) " ore")
                     (string-append (brush-name kind) " brush · " (priced-help (building-cost kind) "Select tiles, then Done"))
                     (and (= (hud-pending-count context) 0) (= (hud-plan-count context) 0))
                     (= (hud-brush context) kind) (if current (action-build-menu actions) ((action-choose actions) kind))))
    (define (pause-control actions)
      (circle "pause" "Pause" "Pause and open the game menu · P" #t #f (action-pause-menu actions)))
    (define (plan-controls context actions)
      (list (brush-control context actions (hud-brush context) #t)
            (priced-circle "done-plan" "Enter" (integer-text (hud-plan-count context)) "Done: place every planned tile"
                           (and (> (hud-plan-count context) 0) (= (hud-pending-count context) 0)) #f (action-done-plan actions))
            (circle "clear-plan" "Esc" "Cancel this unpaid plan" (= (hud-pending-count context) 0) #f (action-clear-plan actions))
            (pause-control actions)))
    (define (overview-controls world context actions)
      (list (circle "build-menu" "B" "Choose a construction brush" (alive? world) (= (hud-menu context) 1) (action-build-menu actions))
            (circle "worker-menu" "G" "Open worker actions · G" #t (= (hud-menu context) 3) (action-worker-menu actions))
            (circle "home" "H" "Home: select the hub" #t #f (action-home actions))
            (pause-control actions)))
    (define (place-controls controls index columns mirrored)
      (if (null? controls) (empty-list)
          (let ((column (remainder index columns)))
            (cons (ui-at (* (if mirrored (- (- columns 1) column) column) control-step)
                         (* (quotient index columns) control-step) (car controls))
                  (place-controls (cdr controls) (+ index 1) columns mirrored)))))
    (define (rail world context actions)
      (let* ((controls (if (> (hud-brush context) 0) (plan-controls context actions) (overview-controls world context actions)))
             (height (if (= (rail-columns context) 2) 176 116)) (width (hud-rail-width context)))
        (ui-at (hud-rail-x context) 0
               (ui-layer "rail" (px width) (px (+ rail-actions-y height))
                         (list (ui-at (quotient (- width rail-width) 2) 0 (readouts world))
                               (ui-at 0 rail-actions-y (ui-layer "rail-actions" (px width) (px height)
                                                                 (place-controls (append controls (view-controls context actions)) 0 (rail-columns context) (hud-left-handed context)))))))))
    (define (centered-controls key controls height)
      (ui-layer key (grow 1) (px height)
                (list (ui-at 20 0 (ui-layer (string-append key "-grid") (px rail-width) (px height)
                                            (place-controls controls 0 2 #f))))))
    (define (brush-picker context actions)
      (ui-at (hud-attachment-x context) 0
             (ui-panel "brush-picker" (px hud-attachment-width) (px 156) 8 4
                       (list (line "brush-picker-label" 20 "Choose a brush" 0)
                             (centered-controls "brush-choices"
                                                (list (brush-control context actions 1 #f) (brush-control context actions 3 #f)
                                                      (brush-control context actions 2 #f) (brush-control context actions 4 #f)) rail-width)))))
    (define (view-controls context actions)
      (let ((left (circle "rotate-left" "Q" "Rotate the view left · Q" #t #f ((action-turn actions) -1)))
            (right (circle "rotate-right" "E" "Rotate the view right · E" #t #f ((action-turn actions) 1))))
        (if (hud-left-handed context) (list right left) (list left right))))
    (define (hire-control world actions)
      (priced-circle "worker" "F" (string-append (integer-text worker-cost) " ore")
                     (string-append "New worker · " (priced-help worker-cost (reason-text (fabrication-reason world))))
                     (= (fabrication-reason world) 0) #f (action-fabricate actions)))
    (define (worker-panel world context actions)
      (ui-at (hud-attachment-x context) 0
             (ui-panel "worker-panel" (px hud-attachment-width) (px 96) 8 4
                       (list (line "worker-panel-label" 20 "New worker" 0)
                             (ui-layer "worker-action" (grow 1) (px hud-control-diameter)
                                       (list (ui-at 50 0 (hire-control world actions))))))))
    (define (tile-count count)
      (string-append (integer-text count) (if (= count 1) " tile" " tiles")))
    (define (plan-status context)
      (cond ((> (hud-pending-count context) 0) (string-append "Saving " (tile-count (hud-pending-count context)) "…"))
            ((> (hud-unconfirmed context) 0) (string-append "Unconfirmed: " (integer-text (hud-unconfirmed context)) " · retry Done"))
            ((> (hud-rejected context) 0) (string-append (integer-text (hud-rejected context)) " not placed · adjust plan"))
            (else (string-append (tile-count (hud-plan-count context)) " · "
                                 (integer-text (* (hud-plan-count context) (building-cost (hud-brush context)))) " ore on Done"))))
    (define (plan-panel context)
      (ui-at (hud-attachment-x context) (* (hud-notification-capacity context) hud-notification-step)
             (ui-panel "plan-status" (px hud-attachment-width) (px 64) 8 4
                       (list (line "plan-price" 20 (plan-status context) 0)
                             (line "plan-help" 24 "Tap a tile again to remove it." 0)))))
    (define (onboarding-panel context)
      ;; Keep the arrow inside the gap to the inward-facing Build circle.
      (ui-at (+ (hud-attachment-x context) (if (hud-left-handed context) 6 0)) onboarding-y
             (ui-pointing-panel "onboarding" (px (- hud-attachment-width 6)) (px onboarding-height) 8 0
                                (if (hud-left-handed context) 1 2) (quotient onboarding-height 2)
                                (list (line "onboarding-help" 48 "Build → extractor brush → deposit → Done." 0)))))

    ;; ---- Existing structures keep explicit upgrade and repair actions ----

    (define (selected-building world context)
      (building-at (world-buildings world) (hud-x context) (hud-y context)))
    (define (hub-selected? world context)
      (hub-cell? world (hud-x context) (hud-y context)))
    (define (nest-selected? world context)
      (and (= (hud-x context) (world-nest-x world)) (= (hud-y context) (world-nest-y world))
           (known? world (hud-x context) (hud-y context))))
    (define (deposit? world context)
      (and (inside? (hud-x context) (hud-y context))
           (known? world (hud-x context) (hud-y context))
           (> (deposit-rate (world-seed world) (hud-x context) (hud-y context)) 0)))
    (define (reason-text reason)
      (cond ((= reason 0) "Workers deliver the supplies.")
            ((= reason 1) "Unexplored. Extend your sight first.")
            ((= reason 2) "Rock or water cannot support a building.")
            ((= reason 3) "This cell is occupied or reserved.")
            ((= reason 4) "An extractor needs a gemstone deposit.")
            ((= reason 5) "Use an extractor on this deposit.")
            ((= reason 6) "No safe route or available supplies.")
            ((= reason 7) "Not enough ore available.")
            ((= reason 8) "Colony capacity reached.")
            ((= reason 9) "The colony has finished.")
            ((= reason 27) "No available worker can reach the hub.")
            ((= reason 28) "Keep the railway clear.")
            ((= reason 29) "The hub is already at full health.")
            ((= reason 30) "A worker is already repairing the hub.")
            (else "Select a cell inside the field.")))
    (define (structure-title building)
      (cond ((= (building-kind building) 1) (string-append "Extractor · Lv" (integer-text (building-level building))))
            ((= (building-kind building) 2) (string-append "Artillery · Lv" (integer-text (building-level building))))
            ((= (building-kind building) 4) "Shield wall")
            ((= (building-level building) 3) "Cart station · Lv3")
            ((= (building-level building) 2) "Survey tower · Lv2") (else "Tower · Lv1")))
    (define (context-title world context)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (if (= (world-outcome world) 1) "Colony lost" "Nest destroyed"))
              ((hub-selected? world context) "Colony hub")
              ((nest-selected? world context) "Enemy nest")
              ((not (null? found)) (structure-title (car found)))
              ((deposit? world context) "Gemstone deposit") (else "Build here"))))
    (define (structure-description world building)
      (cond ((construction-hidden? world building)
             "Waiting for worker visibility.")
            ((arming? building) "Upgrade kit in transit. Current services stay active.")
            ((moving? building) "Relocation queued. Current deliveries finish first.")
            ((not (ready? building)) (string-append "Construction: " (integer-text (building-stock building))
                                                    " / " (integer-text (construction-cost building)) " ore delivered."))
            ((= (building-kind building) 1) (string-append (integer-text (building-level building)) " mining slots. One worker per slot."))
            ((= (building-kind building) 2)
             (string-append "Firepower " (integer-text (+ 50 (* 50 (building-level building)))) "%. Defends within six cells."))
            ((and (tower? building) (= (building-level building) 3)) "Sight, freight and five-times-faster worker carts.")
            ((and (tower? building) (= (building-level building) 2)) "Reveals ten cells and collects freight.")
            ((= (building-kind building) 4) "Blocks attackers while workers pass through.")
            (else "Reveals nearby ground and collects freight.")))
    (define (context-description world context)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (if (= (world-outcome world) 1) "The hub was destroyed. Begin a new colony." "Your colony defeated the nest."))
              ((hub-selected? world context)
               (if (pending-repair? (world-bots world)) "A worker is repairing the hub."
                   (string-append "Repair to " (integer-text (repair-percent world)) "% · " (integer-text (repair-cost world)) " ore\n"
                                  (integer-text (world-hull world)) " / 300 health · one worker for 3 seconds")))
              ((nest-selected? world context) (string-append (integer-text (world-nest-hp world)) " / 1500 health. Bring artillery within six cells."))
              ((not (null? found)) (structure-description world (car found)))
              ((deposit? world context) (string-append (integer-text (deposit-rate (world-seed world) (hud-x context) (hud-y context)))
                                                       " ore per second per miner. Build an extractor here."))
              ((= (placement-reason world 3 (hud-x context) (hud-y context)) 0) "Choose a structure. Workers deliver its supplies.")
              (else (reason-text (placement-reason world 3 (hud-x context) (hud-y context)))))))

    (define (pending-work? building) (or (not (ready? building)) (arming? building) (moving? building)))
    (define (has-upgrade? building)
      (and (< (building-level building) 3) (not (= (building-kind building) 4))))
    (define (upgrade-enabled? world building)
      (and (alive? world) (< (list-size (world-surveys world)) maximum-surveys)
           (if (or (tower? building) (= (building-kind building) 2)) (affordable-kit? world (upgrade-cost building))
               (>= (world-credits world) (upgrade-cost building)))))
    (define (upgrade-help world building)
      (priced-help (upgrade-cost building)
                   (if (not (upgrade-enabled? world building)) "Needs available ore and colony capacity."
                       (cond ((= (building-kind building) 1) "Add a mining slot.")
                             ((= (building-kind building) 2)
                              (string-append "Increase firepower to " (integer-text (+ 100 (* 50 (building-level building)))) "%."))
                             ((= (building-level building) 1) "Extend sight to ten cells; keep freight service.")
                             (else "Add fast worker carts; keep sight and freight.")))))
    (define (building-actions world building actions)
      (cond ((pending-work? building)
             (list (action-button "cancel-build" "C" "" "Cancel construction; return reserved materials" (alive? world) (action-cancel actions))))
            ((has-upgrade? building)
             (list (action-button "upgrade" "U" (string-append (integer-text (upgrade-cost building)) " ore")
                                  (string-append "Upgrade " (structure-title building) " · " (upgrade-help world building))
                                  (upgrade-enabled? world building) (action-improve actions))))
            (else (empty-list))))
    (define (context-actions world context actions)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (list (action-button "restart" "" "" "Begin a new colony" #t (action-restart actions))))
              ((hub-selected? world context)
               (list (hire-control world actions)
                     (action-button "repair" "R" (string-append (integer-text (repair-cost world)) " ore")
                                    (string-append "Repair hub to " (integer-text (repair-percent world)) "% · "
                                                   (if (= (repair-reason world) 0) "One worker · 3 seconds" (reason-text (repair-reason world))))
                                    (= (repair-reason world) 0) (action-repair actions))))
              ((not (null? found)) (building-actions world (car found) actions))
              (else (empty-list)))))
    (define (centered-actions key controls)
      (let ((width (+ (* (list-size controls) hud-control-diameter) (* (- (list-size controls) 1) 8))))
        (ui-layer (string-append key "-center") (grow 1) (px 80)
                  (list (ui-at (quotient (- 156 width) 2) 0
                               (ui-row key (px width) (px 80) 8 controls))))))
    (define (context-card world context actions area)
      (ui-at (rect-x area) (rect-y area)
             (ui-panel (if (alive? world) "context" "result") (px hud-attachment-width) (px 156) 8 4
                       (list (ui-layer "context-copy" (grow 1) (px 56)
                                       (list (ui-label "context-title" (px 1) (px 1) (context-title world context) 2)
                                             (line "context-description" 56 (context-description world context) 0)))
                             (centered-actions "context-actions"
                                               (append (context-actions world context actions)
                                                       (if (and (alive? world) (not (hub-selected? world context))) (list (action-button "close-context" "Esc" "" "Close this selection" #t (action-dismiss actions)))
                                                           (empty-list))))))))
    (define (menu-button key label help enabled request)
      (ui-button key (grow 1) (px 48) label help enabled #f request))
    (define (centered-dialog context key height children)
      (ui-at (quotient (- (hud-root-width context) 240) 2) (quotient (- (hud-root-height context) height) 2)
             (ui-panel key (px 240) (px height) 16 8 children)))
    (define (pause-dialog context actions)
      (centered-dialog context "pause-dialog" 228
                       (list (line "pause-title" 28 (if (= (hud-dialog-pending context) 1) "Pausing…" "Paused") 2)
                             (menu-button "resume" (if (= (hud-dialog-pending context) 2) "Resuming…" "Resume · P") "Resume the colony · P or Escape" (= (hud-dialog-pending context) 0) (action-resume actions))
                             (menu-button "restart-menu" "Restart" "Start again after confirmation" (and (= (hud-pending-count context) 0) (= (hud-dialog-pending context) 0)) (action-restart actions))
                             (menu-button "handedness" (if (hud-left-handed context) "Controls: left side" "Controls: right side")
                                          "Move the controls to the other edge" (= (hud-dialog-pending context) 0) (action-handedness actions)))))
    (define (restart-dialog context actions)
      (centered-dialog context "restart-dialog" 224
                       (list (line "restart-title" 24 "Restart colony?" 4)
                             (line "restart-description" 40 "Replace this colony with a new one?" 0)
                             (menu-button "dismiss-restart" "Cancel · Esc" "Return to the paused menu" (= (hud-dialog-pending context) 0) (action-dismiss-restart actions))
                             (menu-button "accept-restart" (if (= (hud-dialog-pending context) 3) "Restarting…" "Restart · Enter") "Start a new colony" (and (= (hud-pending-count context) 0) (= (hud-dialog-pending context) 0)) (action-accept-restart actions)))))
    (define (dialog-overlay context actions)
      (list (ui-button "dialog-backdrop" (grow 1) (grow 1) "" "Close the current menu · Escape" #t #f (action-dismiss actions))
            (if (= (hud-dialog context) 2) (restart-dialog context actions) (pause-dialog context actions))))
    (define (attached-panels world context actions layout alerts)
      (cond ((= (hud-menu context) 1) (list (brush-picker context actions)))
            ((= (hud-menu context) 3) (list (worker-panel world context actions)))
            ((> (hud-brush context) 0) (append (list (plan-panel context)) alerts))
            (else (append (cond ((or (hud-chooser context) (not (alive? world))) (list (context-card world context actions layout)))
                                ((onboarding-visible? world context) (list (onboarding-panel context))) (else (empty-list))) alerts))))
    (define (colony-hud world context actions layout alerts)
      (ui-layer "hud" (grow 1) (grow 1)
                (append (list (rail world context actions))
                        (if (> (hud-dialog context) 0) (dialog-overlay context actions)
                            (attached-panels world context actions layout alerts)))))))
