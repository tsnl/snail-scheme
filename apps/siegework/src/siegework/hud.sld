;; Compact contextual presentation. The model owns prices, eligibility and time;
;; the client supplies lexical requests and the currently inspected ground cell.
(define-library (siegework hud)
  (export HudContext hud-context hud-move-context hud-x hud-y hud-chooser hud-width hud-height
          HudActions hud-actions colony-hud)
  (import
   (scheme base)
   (scheme immutable)
   (application reducer)
   (browser application)
   (ui core)
   (siegework model)
   (siegework terrain)
   (only (lofi core) datatype -> I32)
   (only (lofi base) string-append))
  (begin

    ;; ---- A client context and typed controls, with no UI-owned game state ----

    (define HudContext
      (datatype ()
        (make-context
         (x I32 hud-x)
         (y I32 hud-y)
         (chooser Bool hud-chooser)
         (width I32 hud-width)
         (height I32 hud-height)
         (origin-x I32 hud-origin-x)
         (origin-y I32 hud-origin-y))))
    (define (hud-context x y chooser width height)
      (make-context x y chooser width height -1 -1))
    (define (hud-move-context x y width height origin-x origin-y)
      (make-context x y #f width height origin-x origin-y))
    (define (moving-context? context) (>= (hud-origin-x context) 0))
    (define HudActions
      (datatype (Owner State)
        (hud-actions
         (choose (-> I32 (Request Owner State)) action-choose)
         (focus (-> I32 (Request Owner State)) action-focus)
         (suspend (-> I32 (Request Owner State)) action-suspend)
         (confirm (Request Owner State) action-confirm)
         (improve (Request Owner State) action-improve)
         (fabricate (Request Owner State) action-fabricate)
         (relocate (Request Owner State) action-relocate)
         (home (Request Owner State) action-home)
         (cancel (Request Owner State) action-cancel)
         (arm (Request Owner State) action-arm)
         (restart (Request Owner State) action-restart))))
    (define (line key height text tone) (ui-label key (grow 1) (px height) text tone))
    (define (control key text help enabled selected event)
      (ui-button key (grow 1) (px 46) text help enabled selected event))
    (define (spacer key) (ui-label key (grow 1) (grow 1) "" 0))
    (define (row key height children) (ui-row key (grow 1) (px height) 8 children))
    (define (alive? world) (= (world-outcome world) 0))
    (define (count-job bots job)
      (if (null? bots) 0 (+ (if (= (bot-job (car bots)) job) 1 0) (count-job (cdr bots) job))))
    (define (clock-text tick)
      (let ((seconds (quotient tick 10)))
        (string-append (integer-text (quotient seconds 60)) ":"
                       (if (< (remainder seconds 60) 10) "0" "") (integer-text (remainder seconds 60)))))

    ;; ---- Critical information stays above the world ----

    (define (threat-text world)
      (let ((next (next-attack-tick (world-tick world))))
        (cond ((= (world-outcome world) 1) "COLONY LOST")
              ((> (world-outcome world) 1) "SIEGE SURVIVED")
              ((= (attack-size next) 0) "FINAL WAVE IN PROGRESS")
              (else (string-append "NEXT " (integer-text (quotient (+ (- next (world-tick world)) 9) 10))
                                   "s · " (integer-text (attack-size next))
                                   (if (= (attack-kind next) 2) " heavy" " raiders"))))))
    (define (pause-control world actions)
      (ui-button "pause" (px 96) (px 46) (if (= (world-paused world) 1) "Resume" "Pause")
                 "P / Start" #t (= (world-paused world) 1)
                 ((action-suspend actions) (if (= (world-paused world) 1) 0 1))))
    (define (critical-row world actions)
      (row "critical" 46
           (list (line "ore" 44 (string-append (integer-text (world-credits world)) " ORE") 2)
                 (ui-meter "hub" (grow 1) (px 42)
                           (string-append "HUB " (integer-text (world-hull world)) "/300")
                           (world-hull world) 300 (if (< (world-hull world) 100) 4 0))
                 (line "workers" 44 (string-append (integer-text (list-size (world-bots world))) "/12 WORKERS") 0)
                 (pause-control world actions))))
    (define (mode-row world actions)
      (row "modes" 46
           (list (control "manual" "Manual" "You place structures" #t (= (world-focus world) 0) ((action-focus actions) 0))
                 (control "explore" "Auto · Explore" "Experimental planner" #t (= (world-focus world) 1) ((action-focus actions) 1))
                 (control "defend" "Auto · Defend" "Experimental planner" #t (= (world-focus world) 2) ((action-focus actions) 2)))))
    (define (header world context actions)
      (ui-panel "header" (grow 1) (px 88) 10 4
                (list (critical-row world actions)
                      (line "forecast" 16
                            (string-append (if (= (world-paused world) 1) "PAUSED  ·  " "")
                                           (threat-text world) "  ·  " (clock-text (world-tick world))
                                           "  ·  " (if (= (world-focus world) 0) "MANUAL"
                                                       (if (= (world-focus world) 1) "AUTO EXPLORE" "AUTO DEFEND"))) 1))))

    ;; ---- Prospective actions explain both the cost and the blocking reason ----

    (define (reason-text reason)
      (cond ((= reason 0) "Click to place. Workers collect materials and build.")
            ((= reason 1) "Unobserved ground. Extend a tower first.")
            ((= reason 2) "Rock or water. Choose walkable ground.")
            ((= reason 3) "This cell is occupied or reserved.")
            ((= reason 4) "Extractors need a turquoise deposit.")
            ((= reason 5) "Keep this deposit for an extractor.")
            ((= reason 6) "No surveyed route or available material pickup.")
            ((= reason 7) "Not enough ore available for this order.")
            ((= reason 8) "Colony capacity reached.")
            ((= reason 9) "Colony finished. Start another run.")
            ((= reason 15) "Move the cursor onto the field.")
            ((= reason 24) "Move a completed tower or artillery with no move already pending.")
            ((= reason 25) "Choose nearby ground, one or two walking cells away.")
            (else "Inspect the selected site.")))
    (define (selected-building world context)
      (building-at (world-buildings world) (hud-x context) (hud-y context)))
    (define (pending-move-reason world context)
      (let ((found (building-at (world-buildings world) (hud-origin-x context) (hud-origin-y context))))
        (if (null? found) 24 (move-reason world (car found) (hud-x context) (hud-y context)))))
    (define (deposit? world context)
      (and (inside? (hud-x context) (hud-y context))
           (surveyed? (world-surveys world) (hud-x context) (hud-y context))
           (> (deposit-rate (world-seed world) (hud-x context) (hud-y context)) 0)))
    (define (upgrade-message world building)
      (cond ((not (alive? world)) "Colony finished.")
            ((not (ready? building)) "Under construction. Upgrade after completion.")
            ((= (building-level building) 2) "Maximum level. Both mining slots are installed.")
            ((< (world-credits world) 40) "Upgrade costs 40 delivered ore. Not enough ore at the hub.")
            (else "Click to upgrade · 40 ore · adds a second mining slot.")))
    (define (hover-title world context)
      (let ((found (selected-building world context)))
        (cond ((moving-context? context) "MOVE STRUCTURE · 5 ORE")
              ((hud-chooser context) "SITE SELECTED · CHOOSE A STRUCTURE")
              ((not (null? found))
               (cond ((= (building-kind (car found)) 1) "EXTRACTOR")
                     ((= (building-kind (car found)) 2) "ARTILLERY") (else "OBSERVATION TOWER")))
              ((deposit? world context) "BUILD EXTRACTOR · 40 ORE")
              (else "BUILD ON THIS GROUND"))))
    (define (hover-description world context)
      (let ((found (selected-building world context)))
        (cond ((moving-context? context)
               (if (= (pending-move-reason world context) 0)
                   "Click to queue this move. Deliveries drain before the structure relocates."
                   (reason-text (pending-move-reason world context))))
              ((hud-chooser context) "No build order yet. Choose Tower or Artillery below (1 / 2, X / Y).")
              ((not (null? found))
               (if (= (building-kind (car found)) 1) (upgrade-message world (car found))
                   (if (moving? (car found)) "Move queued. Current deliveries drain before relocation."
                       "Inspect this structure. Actions appear below.")))
              ((deposit? world context) (reason-text (placement-reason world 1 (hud-x context) (hud-y context))))
              ((= (placement-reason world 3 (hud-x context) (hud-y context)) 0)
               "Click to choose: observation tower · 25 ore, or artillery · 50 ore.")
              (else (reason-text (placement-reason world 3 (hud-x context) (hud-y context)))))))
    (define (choice world context actions number kind key title help)
      (let ((reason (placement-reason world kind (hud-x context) (hud-y context))))
        (control key title (if (= reason 0) help (reason-text reason)) (= reason 0) #f ((action-choose actions) number))))
    (define (chooser-controls world context actions)
      (list (row "choices" 46
                 (list (choice world context actions 1 3 "tower" "1 / X · Tower · 25" "Sight and freight depot")
                       (choice world context actions 2 2 "artillery" "2 / Y · Artillery · 50" "Defend visible approaches")))
            (control "cancel-choice" "Cancel" "Escape / controller B" #t #f (action-cancel actions))))
    (define (upgrade-enabled? world building)
      (and (alive? world) (ready? building) (< (building-level building) 2)
           (not (= (building-kind building) 2))
           (>= (world-credits world) (if (tower? building) 35 40))))
    (define (building-controls world building actions)
      (if (or (not (ready? building)) (moving? building))
          (list (control "cancel-build" (if (moving? building) "Cancel move" "Cancel construction")
                         "Return reserved materials" (alive? world) #f (action-cancel actions)))
          (append (list (row "structure-actions" 46 (completed-controls world building actions)))
                  (if (and (tower? building) (not (armed? building)))
                      (list (control "arm-tower" "Add artillery · 50 ore"
                                     (if (< (world-credits world) 50) "Need 50 delivered ore" "T · keep this tower's sight and depot")
                                     (and (alive? world) (>= (world-credits world) 50)) #f (action-arm actions)))
                      (empty-list)))))
    (define (completed-controls world building actions)
      (append (if (= (building-kind building) 2) (empty-list)
                  (list (control "upgrade" (if (tower? building) "Upgrade · 35" "Upgrade · 40")
                                 (if (= (building-level building) 2) "Maximum level" "U · more capacity or sight")
                                 (upgrade-enabled? world building) #f (action-improve actions))))
              (if (= (building-kind building) 1) (empty-list)
                  (list (control "move-structure" "Move · 5 ore"
                                 (if (< (world-credits world) 5) "Need 5 delivered ore" "M · then choose nearby ground")
                                 (and (alive? world) (>= (world-credits world) 5)) #f (action-relocate actions))))))
    (define (context-controls world context actions)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (list (control "restart" "Start a new colony" "N · begin another run" #t #f (action-restart actions))))
              ((moving-context? context)
               (list (control "confirm-move" "Move here · 5 ore" "Enter / controller A"
                              (= (pending-move-reason world context) 0) #f (action-confirm actions))
                     (control "cancel-move" "Cancel move" "Escape / controller B" #t #f (action-cancel actions))))
              ((hud-chooser context) (chooser-controls world context actions))
              ((not (null? found)) (building-controls world (car found) actions))
              (else (list (control "confirm-site" (if (deposit? world context) "Build extractor · 40 ore" "Choose structure")
                                   "Click ground / Enter / controller A"
                                   (= (placement-reason world (if (deposit? world context) 1 3) (hud-x context) (hud-y context)) 0)
                                   #f (action-confirm actions)))))))

    ;; ---- A compact context card and an explicit scrollable support region ----

    (define (worker-summary world)
      (string-append (integer-text (count-job (world-bots world) 8)) " mining  ·  "
                     (integer-text (+ (count-job (world-bots world) 1) (count-job (world-bots world) 2))) " hauling  ·  "
                     (integer-text (count-job (world-bots world) 0)) " idle"))
    (define (support-controls world actions)
      (row "support" 46
           (list (control "worker" "+ Worker · 25" (worker-help world)
                          (and (alive? world) (< (list-size (world-bots world)) 12) (>= (world-credits world) 25)) #f (action-fabricate actions))
                 (control "home" "Find hub" "H · return camera" #t #f (action-home actions)))))
    (define (worker-help world)
      (cond ((>= (list-size (world-bots world)) 12) "Worker limit: 12")
            ((< (world-credits world) 25) "Need 25 delivered ore")
            (else (worker-summary world))))
    (define (order-feedback world)
      (let ((notice (world-notice world)))
        (if (or (= notice 6) (= notice 26))
            (list (line "order-feedback" 36
                        (if (= notice 6) "Last order: no safe route or available material pickup."
                            "Last order: move route changed; 5 ore returned.") 3))
            (empty-list))))
    (define (context-heading world context)
      (append (list (line "context-title" 22 (hover-title world context) 2)
                    (line "context-description" 42 (hover-description world context) 0))
              (order-feedback world)))
    (define (context-card world context actions)
      (ui-panel "context" (px (if (< (hud-width context) 434) (- (hud-width context) 24) 410))
                (px (context-height context)) 12 8
                (append (context-heading world context)
                        (list (ui-scroll "context-actions" (grow 1) (grow 1) 220 8
                                         (append (context-controls world context actions)
                                                 (list (support-controls world actions) (mode-row world actions))))))))
    (define (context-height context)
      (if (< (hud-height context) 448) (- (hud-height context) 144) 304))
    (define (colony-hud world context actions)
      (ui-column "hud" (grow 1) (grow 1) 12
                 (list (header world context actions)
                       (spacer "world-space")
                       (ui-row "bottom" (grow 1) (px (context-height context)) 0
                               (list (spacer "bottom-space") (context-card world context actions))))))))
