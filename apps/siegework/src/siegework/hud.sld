;; One touch-sized interface on every screen. Selection chooses the card's
;; subject; only explicit typed requests can change the colony.
(define-library (siegework hud)
  (export HudContext hud-context hud-x hud-y hud-chooser hud-width hud-height hud-layout
          HudActions hud-actions colony-hud)
  (import
   (scheme base)
   (scheme immutable)
   (application reducer)
   (browser application)
   (ui core)
   (ui callout)
   (siegework model)
   (siegework terrain)
   (only (lofi core) datatype -> I32)
   (only (lofi base) string-append))
  (begin

    ;; ---- A selected cell and lexical application requests ----

    (define HudContext
      (datatype ()
        (hud-context
         (x I32 hud-x)
         (y I32 hud-y)
         (chooser Bool hud-chooser)
         (width I32 hud-width)
         (height I32 hud-height)
         (anchor-x I32 hud-anchor-x)
         (anchor-y I32 hud-anchor-y)
         (scale I32 hud-scale)
         (restart-mode I32 hud-restart-mode))))
    (define HudActions
      (datatype (Owner State)
        (hud-actions
         (choose (-> I32 (Request Owner State)) action-choose)
         (preview (-> I32 (Request Owner State)) action-preview)
         (suspend (-> I32 (Request Owner State)) action-suspend)
         (confirm (Request Owner State) action-confirm)
         (improve (Request Owner State) action-improve)
         (fabricate (Request Owner State) action-fabricate)
         (home (Request Owner State) action-home)
         (orbit (Request Owner State) action-orbit)
         (dismiss (Request Owner State) action-dismiss)
         (cancel (Request Owner State) action-cancel)
         (arm (Request Owner State) action-arm)
         (restart (Request Owner State) action-restart)
         (accept-restart (Request Owner State) action-accept-restart)
         (dismiss-restart (Request Owner State) action-dismiss-restart))))
    (define (larger left right) (if (> left right) left right))
    (define (smaller left right) (if (< left right) left right))
    (define (alive? world) (= (world-outcome world) 0))
    (define (line key height text tone) (ui-label key (grow 1) (px height) text tone))
    (define (action-button key text help enabled request)
      (ui-button key (px 84) (px 84) text help enabled #f request))
    (define (priced-help price description)
      (string-append (integer-text price) " ore · " description))

    ;; ---- Three readouts and three controls occupy the same 332-pixel header ----

    (define (active-workers bots)
      (if (null? bots) 0
          (let ((job (bot-job (car bots))))
            (+ (if (and (> job 0) (not (= job 7)) (not (= job 10))) 1 0)
               (active-workers (cdr bots))))))
    (define (wave-span next)
      (if (<= next 300) 300 (- next (next-attack-tick (- next 301)))))
    (define (ore-dial world)
      (ui-dial "ore" (px 52) (px 52) (integer-text (world-credits world))
               (string-append "Ore " (integer-text (world-credits world)) "; hub health " (integer-text (world-hull world)) " of 300")
               (world-hull world) 300 (if (< (world-hull world) 100) 4 2)))
    (define (workers-dial world)
      (let ((active (active-workers (world-bots world))) (total (list-size (world-bots world))))
        (ui-dial "workers" (px 52) (px 52) (integer-text active)
                 (string-append "Active workers: " (integer-text active) " of " (integer-text total)
                                "; queued: " (integer-text (pending-workers (world-bots world))))
                 active (larger total 1) 2)))
    (define (wave-dial world)
      (let* ((tick (world-tick world)) (tier (threat-tier tick)) (next (next-attack-tick tick)))
        (ui-dial "difficulty" (px 52) (px 52) (integer-text (+ tier 1))
                 (string-append "Difficulty; " (integer-text (list-size (world-enemies world)))
                                " enemies. Ring counts down to the next wave.")
                 (- next tick) (wave-span next) (cond ((< tier 2) 2) ((< tier 5) 3) (else 4)))))
    (define (difficulty-readout world)
      (ui-layer "difficulty-readout" (px 52) (px 52)
                (cons (wave-dial world)
                      (if (null? (world-enemies world)) (empty-list)
                          (list (ui-at 29 0 (ui-label "enemy-count" (px 23) (px 16)
                                                      (integer-text (list-size (world-enemies world))) 4)))))))
    (define (header world actions)
      (ui-layer "header" (px 332) (px 64)
                (list (ui-panel "readouts" (px 180) (px 64) 6 0
                                (list (ui-row "readout-row" (px 168) (px 52) 6
                                              (list (ore-dial world) (workers-dial world) (difficulty-readout world)))))
                      (ui-at 188 10 (ui-button "home" (px 44) (px 44) "H Home" "Select the hub" #t #f (action-home actions)))
                      (ui-at 240 10 (ui-button "pause" (px 44) (px 44)
                                               (if (= (world-paused world) 1) "P Play" "P Pause") "Pause or resume"
                                               #t (= (world-paused world) 1) ((action-suspend actions) -1)))
                      (ui-at 288 10 (ui-button "restart-header" (px 44) (px 44) "N Reset" "Restart colony"
                                               #t #f (action-restart actions))))))

    ;; ---- A selected subject explains the available action ----

    (define (selected-building world context)
      (building-at (world-buildings world) (hud-x context) (hud-y context)))
    (define (hub-selected? world context)
      (and (= (hud-x context) (world-hub-x world)) (= (hud-y context) (world-hub-y world))))
    (define (nest-selected? world context)
      (and (= (hud-x context) (world-nest-x world)) (= (hud-y context) (world-nest-y world))
           (known? world (hud-x context) (hud-y context))))
    (define (deposit? world context)
      (and (inside? (hud-x context) (hud-y context))
           (known? world (hud-x context) (hud-y context))
           (> (deposit-rate (world-seed world) (hud-x context) (hud-y context)) 0)))
    (define (reason-text reason)
      (cond ((= reason 0) "Workers deliver the supplies.")
            ((= reason 1) "Unexplored. Extend your sight first.")
            ((= reason 2) "Rock or water cannot support a building.")
            ((= reason 3) "This cell is occupied or reserved.")
            ((= reason 4) "An extractor needs a gemstone deposit.")
            ((= reason 5) "Use an extractor on this deposit.")
            ((= reason 6) "No safe route or available supplies.")
            ((= reason 7) "Not enough ore available.")
            ((= reason 8) "Colony capacity reached.")
            ((= reason 9) "The colony has finished.")
            ((= reason 27) "No available worker can reach the hub.")
            ((= reason 28) "Keep the railway clear.")
            (else "Select a cell inside the field.")))
    (define (structure-title building)
      (cond ((= (building-kind building) 1) (string-append "Extractor · Lv" (integer-text (building-level building))))
            ((= (building-kind building) 2) "Artillery") ((= (building-kind building) 4) "Shield wall")
            ((= (building-level building) 3) "Cart station · Lv3")
            ((= (building-level building) 2) "Artillery · Lv2") (else "Tower · Lv1")))
    (define (context-title world context)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (if (= (world-outcome world) 1) "Colony lost" "Nest destroyed"))
              ((hub-selected? world context) "Colony hub")
              ((nest-selected? world context) "Enemy nest")
              ((not (null? found)) (structure-title (car found)))
              ((deposit? world context) "Gemstone deposit") (else "Build here"))))
    (define (structure-description world building)
      (cond ((construction-hidden? world building)
             "Waiting for worker visibility.")
            ((arming? building) "Upgrade kit in transit. Current services stay active.")
            ((moving? building) "Relocation queued. Current deliveries finish first.")
            ((not (ready? building)) (string-append "Construction: " (integer-text (building-stock building))
                                                    " / " (integer-text (construction-cost building)) " ore delivered."))
            ((= (building-kind building) 1) (string-append (integer-text (building-level building)) " mining slots. One worker per slot."))
            ((and (tower? building) (= (building-level building) 3)) "Workers travel five times faster along the cart line.")
            ((armed? building) "Defends within six cells. Lv3 becomes a cart station.")
            ((= (building-kind building) 4) "Blocks attackers while workers pass through.")
            (else "Reveals nearby ground and collects freight.")))
    (define (context-description world context)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (if (= (world-outcome world) 1) "The hub was destroyed. Begin a new colony." "Your colony defeated the nest."))
              ((hub-selected? world context) (string-append (integer-text (list-size (world-bots world))) " workers · "
                                                            (integer-text (pending-workers (world-bots world))) " queued. Select again to queue more."))
              ((nest-selected? world context) (string-append (integer-text (world-nest-hp world)) " / 1500 health. Bring artillery within six cells."))
              ((not (null? found)) (structure-description world (car found)))
              ((deposit? world context) (string-append (integer-text (deposit-rate (world-seed world) (hud-x context) (hud-y context)))
                                                       " ore per second per miner. Build an extractor here."))
              ((= (placement-reason world 3 (hud-x context) (hud-y context)) 0) "Choose a structure. Workers deliver its supplies.")
              (else (reason-text (placement-reason world 3 (hud-x context) (hud-y context)))))))

    ;; ---- Explicit actions keep hover previews separate from construction ----

    (define (build-choice world context actions number kind key title)
      (let ((reason (placement-reason world kind (hud-x context) (hud-y context))))
        (ui-hover ((action-preview actions) kind) ((action-preview actions) 0)
                  (action-button key title (priced-help (building-cost kind) (reason-text reason))
                                 (= reason 0) ((action-choose actions) number)))))
    (define (pending-work? building) (or (not (ready? building)) (arming? building) (moving? building)))
    (define (has-upgrade? building)
      (and (< (building-level building) 3) (or (= (building-kind building) 1) (tower? building))))
    (define (upgrade-enabled? world building)
      (and (alive? world) (< (list-size (world-surveys world)) maximum-surveys)
           (if (tower? building) (affordable-kit? world (upgrade-cost building))
               (>= (world-credits world) (upgrade-cost building)))))
    (define (upgrade-help world building)
      (priced-help (upgrade-cost building)
                   (if (not (upgrade-enabled? world building)) "Needs available ore and colony capacity."
                       (cond ((= (building-kind building) 1) "Add a mining slot.")
                             ((= (building-level building) 1) "Add artillery.") (else "Replace artillery with a cart station.")))))
    (define (building-actions world building actions)
      (cond ((pending-work? building)
             (list (action-button "cancel-build" "C Cancel" "Return reserved materials" (alive? world) (action-cancel actions))))
            ((has-upgrade? building)
             (list (action-button "upgrade" "U Upgrade" (upgrade-help world building)
                                  (upgrade-enabled? world building) (action-improve actions))))
            (else (empty-list))))
    (define (context-actions world context actions)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (list (action-button "restart" "N Restart" "Begin a new colony" #t (action-restart actions))))
              ((hub-selected? world context)
               (list (action-button "worker" "F Worker" (priced-help worker-cost (reason-text (fabrication-reason world)))
                                    (= (fabrication-reason world) 0) (action-fabricate actions))))
              ((nest-selected? world context) (empty-list))
              ((not (null? found)) (building-actions world (car found) actions))
              ((deposit? world context) (list (build-choice world context actions 1 1 "extractor" "1 Extractor")))
              (else (list (build-choice world context actions 1 3 "tower" "1 Tower")
                          (build-choice world context actions 2 2 "artillery" "2 Artillery")
                          (build-choice world context actions 3 4 "wall" "3 Wall"))))))
    ;; ---- Cards protect the header without reserving a full-width strip ----

    (define (hud-root-width context) (larger 1 (- (hud-width context) 24)))
    (define (hud-root-height context) (larger 1 (- (hud-height context) 32)))
    (define (orbit-bounds context)
      (rect (- (hud-root-width context) 104) (- (hud-root-height context) 44) 104 44))
    (define (orbit-control context actions)
      (let ((area (orbit-bounds context)))
        (ui-at (rect-x area) (rect-y area)
               (ui-button "orbit" (px 104) (px 44)
                          (if (>= (hud-scale context) 4000) "V · Regular" "V · Orbital")
                          "Switch view; wheel or pinch also zooms" #t (>= (hud-scale context) 4000) (action-orbit actions)))))
    (define (target-bounds world context)
      (let* ((cell (larger 10 (smaller 42 (quotient (* (hud-height context) 1000) (* 18 (hud-scale context))))))
             (tall (or (hub-selected? world context) (not (null? (selected-building world context)))))
             (x (- (hud-anchor-x context) 12)) (y (- (hud-anchor-y context) 12)))
        (rect (- x cell) (- y (* (if tall 3 1) cell)) (* 2 cell) (* (if tall 4 2) cell))))
    (define (hud-layout world context)
      (layout-callout (rect 0 0 (hud-root-width context) (hud-root-height context))
                      (target-bounds world context) (list (rect 0 0 332 64) (orbit-bounds context))
                      292 204 52))
    (define (context-heading world context actions)
      (ui-row "context-heading" (grow 1) (px 44) 8
              (list (line "context-title" 44 (context-title world context) 2)
                    (ui-button "close-context" (px 44) (px 44) "Esc" "Close this selection"
                               #t #f (action-dismiss actions)))))
    (define (context-card world context actions layout)
      (let ((area (callout-rect layout)) (controls (context-actions world context actions)))
        (ui-pointing-panel (if (alive? world) "context" "result")
                           (px 292) (px (rect-height area)) 12 8 (callout-side layout)
                           (callout-offset layout (- (hud-anchor-x context) 12) (- (hud-anchor-y context) 12))
                           (append (list (context-heading world context actions)
                                         (line "context-description" 36 (context-description world context) 0))
                                   (if (null? controls) (empty-list)
                                       (list (ui-row "context-actions" (grow 1) (px 84) 8 controls)))))))
    (define (restart-overlay context actions)
      (list (ui-button "restart-backdrop" (grow 1) (grow 1) "" "Escape cancels restart" #t #f (action-dismiss-restart actions))
            (ui-at (quotient (- (hud-root-width context) 292) 2)
                   (larger 12 (quotient (- (hud-root-height context) 156) 2))
                   (ui-panel "restart-dialog" (px 292) (px 156) 12 8
                             (list (line "restart-title" 26 "Restart colony?" 4)
                                   (line "restart-description" 42 "Replace this colony with a new one? The game is paused." 0)
                                   (ui-row "restart-actions" (grow 1) (px 48) 8
                                           (list (ui-button "dismiss-restart" (grow 1) (grow 1) "Esc Keep" "Return to the colony"
                                                            #t #f (action-dismiss-restart actions))
                                                 (ui-button "accept-restart" (grow 1) (grow 1) "Enter Restart" "Start fresh"
                                                            #t #f (action-accept-restart actions)))))))))
    (define (colony-hud world context actions layout alerts)
      (let ((area (callout-rect layout)))
        (ui-layer "hud" (grow 1) (grow 1)
                  (append (list (header world actions) (orbit-control context actions))
                          (if (> (hud-restart-mode context) 0) (restart-overlay context actions)
                              (append (if (hud-chooser context)
                                          (list (ui-at (rect-x area) (rect-y area) (context-card world context actions layout)))
                                          (empty-list)) alerts))))))))
