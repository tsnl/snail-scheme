;; An edge rail and a selected-site callout project the committed colony.
;; All actions are lexical typed requests; labels never carry command identity.
(define-library (siegework hud)
  (export HudContext hud-context hud-x hud-y hud-chooser hud-width hud-height hud-layout
          HudActions hud-actions colony-hud hud-notification-capacity hud-notification-y hud-attachment-x
          hud-control-diameter hud-attachment-width hud-notification-height hud-notification-step)
  (import
   (scheme base)
   (scheme immutable)
   (application reducer)
   (browser application)
   (ui core)
   (ui callout)
   (siegework model)
   (siegework presentation)
   (siegework guidance)
   (siegework terrain)
   (only (lofi core) datatype -> I32)
   (only (lofi base) string-append))
  (begin

    ;; ---- Local presentation context and explicit application requests ----

    (define HudContext
      (datatype ()
        (hud-context
         (x I32 hud-x)
         (y I32 hud-y)
         (chooser Bool hud-chooser)
         (width I32 hud-width)
         (height I32 hud-height)
         (dialog I32 hud-dialog)
         (dialog-pending I32 hud-dialog-pending)
         (build-pending Bool hud-build-pending)
         (choice-kind I32 hud-choice-kind)
         (failure I32 hud-failure)
         (left-handed Bool hud-left-handed)
         (anchor-x I32 hud-anchor-x)
         (anchor-y I32 hud-anchor-y))))
    (define HudActions
      (datatype (Owner State)
        (hud-actions
         (construct (-> I32 I32 (Request Owner State)) action-construct)
         (preview (-> I32 (Request Owner State)) action-preview)
         (improve (Request Owner State) action-improve)
         (scavenge (Request Owner State) action-scavenge)
         (fabricate (Request Owner State) action-fabricate)
         (turn (-> I32 (Request Owner State)) action-turn)
         (repair (Request Owner State) action-repair)
         (home (Request Owner State) action-home)
         (dismiss (Request Owner State) action-dismiss)
         (cancel (Request Owner State) action-cancel)
         (restart (Request Owner State) action-restart)
         (accept-restart (Request Owner State) action-accept-restart)
         (dismiss-restart (Request Owner State) action-dismiss-restart)
         (resign-menu (Request Owner State) action-resign-menu)
         (accept-resign (Request Owner State) action-accept-resign)
         (dismiss-resign (Request Owner State) action-dismiss-resign)
         (pause-menu (Request Owner State) action-pause-menu)
         (resume (Request Owner State) action-resume)
         (handedness (-> I32 (Request Owner State)) action-handedness))))
    (define (larger left right) (if (> left right) left right))
    (define (smaller left right) (if (< left right) left right))
    (define (alive? world) (= (world-outcome world) 0))

    ;; ---- Edge controls and their attached callouts ----

    (define hud-control-diameter 56)
    (define control-step (+ hud-control-diameter 4))
    (define rail-width (+ (* hud-control-diameter 2) 4))
    (define hud-attachment-width 172)
    (define hud-notification-height 56)
    (define hud-notification-step 64)
    (define rail-actions-y 164)
    (define context-width 140)
    (define (line key height text tone) (ui-label key (grow 1) (px height) text tone))
    (define (circle key shortcut help enabled selected request)
      (ui-button key (px hud-control-diameter) (px hud-control-diameter) shortcut help enabled selected request))
    (define (priced-circle key shortcut caption help enabled selected request)
      (ui-layer (string-append key "-priced") (px hud-control-diameter) (px hud-control-diameter)
                (list (circle key shortcut help enabled selected request)
                      (ui-at 2 39 (ui-label (string-append key "-caption") (px 52) (px 16) caption 0)))))
    (define (action-button key shortcut caption help enabled request)
      (ui-column (string-append key "-control") (px hud-control-diameter) (px 80) 4
                 (list (circle key shortcut help enabled #f request)
                       (ui-label (string-append key "-caption") (px hud-control-diameter) (px 20) caption 0))))
    (define (priced-help price description)
      (string-append (integer-text price) " ore · " description))
    (define (hud-root-width context) (larger 1 (- (hud-width context) 24)))
    (define (hud-root-height context) (larger 1 (- (hud-height context) 32)))
    ;; Home/Pause and Q/E each own one row in every orientation. Mirroring
    ;; the dock cannot split the rotation pair across rows.
    (define (hud-rail-width context) rail-width)
    (define (hud-rail-x context) (if (hud-left-handed context) 0 (- (hud-root-width context) (hud-rail-width context))))
    (define (hud-attachment-x context)
      (if (hud-left-handed context) (+ (hud-rail-width context) 8) (- (hud-rail-x context) (+ hud-attachment-width 8))))
    (define (onboarding-visible? world context)
      (and (= (hud-dialog context) 0)
           (not (hud-chooser context)) (extractor-start? world)))
    (define (construction-context? world context)
      (and (alive? world) (not (hub-selected? world context)) (not (nest-selected? world context))
           (null? (selected-building world context))))
    (define (context-height world context)
      (cond ((onboarding-visible? world context) 168)
            ((hub-selected? world context) (+ (context-copy-height world context) 136))
            ((construction-context? world context) (+ (context-copy-height world context) (if (deposit? world context) 76 136)))
            ((three-structure-controls? world context) 224) (else 164)))
    (define (rail-height context) (+ rail-actions-y 116))
    (define (hud-layout world context)
      ;; Use space below the rail too; a narrow corridor remains a useful fallback
      ;; when the four full-viewport candidates would need to dock over the tile.
      (let* ((target (rect (- (hud-anchor-x context) 22) (- (hud-anchor-y context) 22) 20 20))
             (available (rect 0 0 (hud-root-width context) (hud-root-height context)))
             (rail (rect (hud-rail-x context) 0 (hud-rail-width context) (rail-height context)))
             (placed (layout-callout available target (list rail) context-width (context-height world context) 0))
             (corridor (rect (if (hud-left-handed context) (+ (hud-rail-width context) 8) 0) 0
                             (- (hud-root-width context) (+ (hud-rail-width context) 8)) (hud-root-height context))))
        (if (callout-docked placed)
            (layout-callout corridor target (empty-list) context-width (context-height world context) 0) placed)))
    (define (pointing-side context layout)
      ;; Clamping can move a candidate across its anchor: point from its final side.
      (let ((area (callout-rect layout)) (x (- (hud-anchor-x context) 12)) (y (- (hud-anchor-y context) 12)))
        (cond ((< x (rect-x area)) 1) ((> x (+ (rect-x area) (rect-width area))) 2)
              ((< y (rect-y area)) 3) (else 4))))
    (define (pointing-offset context layout)
      (let* ((area (callout-rect layout)) (horizontal (<= (pointing-side context layout) 2))
             (offset (if horizontal (- (- (hud-anchor-y context) 12) (rect-y area))
                         (- (- (hud-anchor-x context) 12) (rect-x area))))
             (extent (if horizontal (rect-height area) (rect-width area))))
        (larger 16 (smaller offset (- extent 16)))))
    (define (notification-slots world context y remaining)
      (if (or (= remaining 0) (> (+ y hud-notification-height) (hud-root-height context)) (> (hud-dialog context) 0)) (empty-list)
          (let* ((area (callout-rect (hud-layout world context)))
                 (protected (rect (- (rect-x area) 12) (- (rect-y area) 12) (+ (rect-width area) 24) (+ (rect-height area) 24)))
                 (target (rect (- (hud-anchor-x context) 34) (- (hud-anchor-y context) 34) 44 44))
                 (toast (rect (hud-attachment-x context) y hud-attachment-width hud-notification-height))
                 (card-hit (and (or (not (alive? world)) (hud-chooser context) (onboarding-visible? world context)) (rectangles-overlap? toast protected)))
                 (target-hit (and (hud-chooser context) (rectangles-overlap? toast target))))
            (cond (card-hit (notification-slots world context (+ (rect-y protected) (rect-height protected)) remaining))
                  (target-hit (notification-slots world context (+ (rect-y target) (rect-height target)) remaining))
                  (else (cons y (notification-slots world context (+ y hud-notification-step) (- remaining 1))))))))
    (define (hud-notification-capacity world context) (list-size (notification-slots world context 0 3)))
    (define (slot-at slots index)
      (if (null? slots) 0 (if (= index 0) (car slots) (slot-at (cdr slots) (- index 1)))))
    (define (hud-notification-y world context index) (slot-at (notification-slots world context 0 3) index))

    ;; ---- Four readouts share the same circles on every viewport ----

    (define (active-workers bots)
      (if (null? bots) 0
          (let ((job (bot-job (car bots))))
            (+ (if (and (> job 0) (not (= job 7)) (not (= job 10))) 1 0)
               (active-workers (cdr bots))))))
    (define (ore-dial world)
      (ui-dial "ore" (px hud-control-diameter) (px hud-control-diameter) ""
               (string-append (integer-text (world-credits world)) " ore available") 1 1 0))
    (define (health-dial world)
      (ui-dial "health" (px hud-control-diameter) (px hud-control-diameter) (integer-text (world-hull world))
               (string-append "Hub health: " (integer-text (world-hull world)) " of 300")
               (world-hull world) 300 (if (< (world-hull world) 100) 4 2)))
    (define (workers-dial world)
      (let ((active (active-workers (world-bots world))) (total (list-size (world-bots world))))
        (ui-dial "workers" (px hud-control-diameter) (px hud-control-diameter) (string-append (integer-text active) "/" (integer-text total))
                 (string-append "Working jobs: " (integer-text active) " of " (integer-text total)
                                " workers; capacity " (integer-text (worker-capacity world))
                                "; idle and waiting excluded; queued: " (integer-text (pending-workers (world-bots world))))
                 active (larger total 1) 2)))
    (define (difficulty-dial value)
      (ui-dial "difficulty" (px hud-control-diameter) (px hud-control-diameter) (integer-text (difficulty-number value))
               (difficulty-help value) (difficulty-elapsed value) (difficulty-span value)
               (cond ((< (difficulty-number value) 3) 2) ((< (difficulty-number value) 6) 3) (else 4))))
    (define (readout key caption dial)
      (ui-layer key (px hud-control-diameter) (px 68)
                (list (ui-at 0 12 dial)
                      (ui-label (string-append key "-label") (px hud-control-diameter) (px 16) caption 0))))
    (define (readouts world)
      (let ((difficulty (project-difficulty (world-difficulty-window world) (world-tick world))))
        (ui-layer "readouts" (px rail-width) (px 160)
                  (list (readout "ore-readout" (string-append (integer-text (world-credits world)) " ore") (ore-dial world))
                        (ui-at control-step 0 (readout "health-readout" "Health" (health-dial world)))
                        (ui-at 0 72 (readout "worker-readout" "Working" (workers-dial world)))
                        (ui-at control-step 72 (readout "difficulty-readout" "Difficulty" (difficulty-dial difficulty)))
                        (ui-at 0 144 (ui-label "worker-capacity" (px rail-width) (px 16)
                                               (string-append "Capacity " (integer-text (+ (list-size (world-bots world)) (pending-workers (world-bots world))))
                                                              " / " (integer-text (worker-capacity world))) 0))))))

    ;; ---- Persistent view controls and contextual construction ----

    (define (building-key kind)
      (cond ((= kind 1) "extractor") ((= kind 2) "artillery") (else "tower")))
    (define (building-name kind)
      (cond ((= kind 1) "Extractor") ((= kind 2) "Artillery") (else "Tower")))
    (define (construction-control world context actions kind shortcut)
      (let ((reason (placement-reason world kind (hud-x context) (hud-y context))))
        (ui-hover ((action-preview actions) kind) ((action-preview actions) 0)
                  (priced-circle (building-key kind) shortcut (if (= kind 1) "Free" (string-append (integer-text (building-cost kind)) " ore"))
                                 (string-append (building-name kind) " · " (priced-help (building-cost kind) (reason-text reason)))
                                 (and (not (hud-build-pending context)) (not (= reason 38)) (not (= reason 39))) #f
                                 ((action-construct actions) kind (cell-index (hud-x context) (hud-y context)))))))
    (define (pause-control actions)
      (circle "pause" "Pause" "Pause and open the game menu · P" #t #f (action-pause-menu actions)))
    (define (overview-controls world context actions)
      (list (circle "home" "H" "Home: select the hub" (not (hud-build-pending context)) #f (action-home actions))
            (pause-control actions)))
    (define (place-controls controls index columns mirrored)
      (if (null? controls) (empty-list)
          (let ((column (remainder index columns)))
            (cons (ui-at (* (if mirrored (- (- columns 1) column) column) control-step)
                         (* (quotient index columns) control-step) (car controls))
                  (place-controls (cdr controls) (+ index 1) columns mirrored)))))
    (define (rail world context actions)
      (let* ((controls (overview-controls world context actions))
             (width (hud-rail-width context)))
        (ui-at (hud-rail-x context) 0
               (ui-layer "rail" (px width) (px (rail-height context))
                         (list (ui-at (quotient (- width rail-width) 2) 0 (readouts world))
                               (ui-at 0 rail-actions-y (ui-layer "rail-actions" (px width) (px (- (rail-height context) rail-actions-y))
                                                                 (place-controls (append controls (view-controls context actions)) 0 2 (hud-left-handed context)))))))))
    (define (view-controls context actions)
      (let ((left (circle "rotate-left" "Q" "Rotate the view left · Q" #t #f ((action-turn actions) -1)))
            (right (circle "rotate-right" "E" "Rotate the view right · E" #t #f ((action-turn actions) 1))))
        (if (hud-left-handed context) (list right left) (list left right))))
    (define (hire-control world actions)
      (priced-circle "worker" "F" (string-append (integer-text worker-cost) " ore")
                     (string-append "New worker · " (priced-help worker-cost (hiring-help world)))
                     (= (fabrication-reason world) 0) #f (action-fabricate actions)))
    (define (hiring-help world)
      (if (= (fabrication-reason world) 8)
          (if (= (worker-capacity world) maximum-workers) "The colony has reached its 24-worker limit."
              "Worker capacity reached. Upgrade the hub for two more places.")
          (reason-text (fabrication-reason world))))
    (define (hub-upgrade-control world actions)
      (let ((reason (hub-upgrade-reason world)))
        (priced-circle "upgrade" "U"
                       (cond ((= reason 36) "MAX") ((= reason 35) "Working")
                             (else (string-append (integer-text (hub-upgrade-cost world)) " ore")))
                       (string-append "Upgrade hub capacity · " (hub-capacity-description world))
                       (= reason 0) #f (action-improve actions))))
    (define (hub-capacity-description world)
      (let ((capacity (worker-capacity world)) (reason (hub-upgrade-reason world)))
        (cond ((= reason 38) "Build an extractor on a glowing deposit first.\nThen hire and upgrade.")
              ((= capacity maximum-workers) "Capacity 24 · maximum\nHire workers separately.")
              (else (string-append "Capacity " (integer-text capacity) " → " (integer-text (+ capacity 2)) "\n"
                                   (integer-text (hub-upgrade-cost world)) (if (= reason 35) " ore paid\n" " ore · 3s assembly\n")
                                   (cond ((= reason 35) "Worker upgrading hub.")
                                         ((= reason 7) "Not enough hub ore.")
                                         ((= reason 27) "No available worker.")
                                         (else "Hire separately: 25 ore.")))))))
    (define (hub-description world)
      (string-append (hub-capacity-description world) "\n"
                     (if (pending-repair? (world-bots world)) "Repair in progress."
                         (string-append "Hub " (integer-text (world-hull world)) " / 300 health"))))
    (define (onboarding-panel context layout)
      (let ((area (callout-rect layout)))
        (ui-at (rect-x area) (rect-y area)
               (ui-pointing-panel "onboarding" (px context-width) (px 168) 8 0
                                  (pointing-side context layout) (pointing-offset context layout)
                                  (list (line "onboarding-help" 152 (string-append "Select the glowing deposit, then choose Extractor. It is free.\n\n" frontier-hint) 0))))))

    ;; ---- Existing structures keep explicit upgrade and repair actions ----

    (define (selected-building world context)
      (building-at (world-buildings world) (hud-x context) (hud-y context)))
    (define (hub-selected? world context)
      (hub-cell? world (hud-x context) (hud-y context)))
    (define (nest-selected? world context)
      (and (living-nest? world (hud-x context) (hud-y context))
           (known? world (hud-x context) (hud-y context))))
    (define (deposit? world context)
      (and (inside? (hud-x context) (hud-y context))
           (known? world (hud-x context) (hud-y context))
           (> (world-deposit-rate world (hud-x context) (hud-y context)) 0)))
    (define (reason-text reason)
      (cond ((= reason 0) "Workers deliver the supplies.")
            ((= reason 1) "Unexplored. Extend your sight first.")
            ((= reason 2) "Rock or water cannot support a building.")
            ((= reason 3) "This cell is occupied or reserved.")
            ((= reason 4) "An extractor needs a gemstone deposit.")
            ((= reason 5) "Use an extractor on this deposit.")
            ((= reason 6) "Workers can see this tile, but it needs tower coverage for construction.")
            ((= reason 7) "Not enough ore available.")
            ((= reason 8) "Colony capacity reached.")
            ((= reason 9) "The colony has finished.")
            ((= reason 27) "No available worker can reach the hub.")
            ((= reason 28) "Keep the railway clear.")
            ((= reason 29) "The hub is already at full health.")
            ((= reason 30) "A worker is already repairing the hub.")
            ((= reason 32) "No worker route through surveyed ground from the hub. Extend tower coverage along the route.")
            ((= reason 33) "The available ore has no reachable pickup source for this site.")
            ((= reason 34) "Construction was not saved. Nothing was charged. Try again.")
            ((= reason 39) "This deposit is depleted. Explore for another deposit.")
            ((= reason 35) "A worker is already upgrading the hub.")
            ((= reason 36) "Maximum capacity: 24 workers.")
            ((= reason 38) "Build an extractor on a glowing deposit first.")
            ((= reason 40) "Finish construction, upgrades or relocation first. The hub cannot be scavenged.")
            ((= reason 41) "A worker is already scavenging this building.")
            ((= reason 42) "No empty-handed worker has a safe route to this building.")
            ((= reason 43) "Paid supplies are still waiting for pickup here.")
            (else "Select a cell inside the field.")))
    (define (structure-title building)
      (cond ((= (building-kind building) 1) (string-append "Extractor · Lv" (integer-text (building-level building))))
            ((= (building-kind building) 2) (string-append "Artillery · Lv" (integer-text (building-level building))))
            ((= (building-level building) 3) "Express tower · Lv3")
            ((= (building-level building) 2) "Survey tower · Lv2") (else "Tower · Lv1")))
    (define (context-title world context)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (cond ((= (world-outcome world) 1) "Colony lost") ((= (world-outcome world) 4) "Colony resigned") (else "All nests cleared")))
              ((hub-selected? world context) "Colony hub")
              ((nest-selected? world context) "Enemy nest")
              ((not (null? found)) (structure-title (car found)))
              ((deposit? world context) "Gemstone deposit") (else "Build here"))))
    (define (structure-description world building)
      (cond ((scavenge-pending? world (building-id building))
             (string-append "Worker scavenging · +" (integer-text (scavenge-refund building)) " ore after demolition. C: cancel."))
            ((construction-hidden? world building)
             "Waiting for worker visibility.")
            ((arming? building) "Current services stay active during the upgrade.")
            ((moving? building) "Relocation queued. Current deliveries finish first.")
            ((and (= (building-kind building) 1) (not (ready? building))) "Worker building this extractor. No ore required.")
            ((not (ready? building)) (string-append "Construction: " (integer-text (building-stock building))
                                                    " / " (integer-text (construction-cost building)) " ore delivered."))
            ((= (building-kind building) 1)
             (let ((remaining (ore-remaining world (building-x building) (building-y building))))
               (if (= remaining 0) "Depleted. Workers haul the remaining stock, then move on."
                   (string-append (integer-text remaining) " ore left · " (integer-text (building-level building)) " mining slots."))))
            ((= (building-kind building) 2)
             (string-append "Firepower " (integer-text (+ 50 (* 50 (building-level building)))) "%. Defends within six cells."))
            ((and (tower? building) (= (building-level building) 3)) "Sight, freight and cart speed ×4. Links use the slower tower.")
            ((and (tower? building) (= (building-level building) 2)) "Reveals ten cells. Cart speed ×2; links use the slower tower.")
            (else "Sight, freight and worker carts at ten times walking speed.")))
    (define (context-description world context)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (cond ((= (world-outcome world) 1) "The hub was destroyed") ((= (world-outcome world) 4) "You resigned from this colony.") (else "Your colony destroyed all three nests.")))
              ((hub-selected? world context) (hub-description world))
              ((nest-selected? world context)
               (let ((nest (car (nest-at (world-nests world) (hud-x context) (hud-y context)))))
                 (string-append (integer-text (nest-hp nest)) " / 900 health. Clear for rich ore and two fewer difficulty levels.")))
              ((hud-build-pending context) "Saving construction…")
              ((> (hud-failure context) 0) (reason-text (hud-failure context)))
              ((not (null? found)) (structure-description world (car found)))
              ((deposit? world context)
               (let ((remaining (ore-remaining world (hud-x context) (hud-y context))))
                 (if (= remaining 0) "Depleted. Explore for another deposit."
                     (string-append (integer-text remaining) " ore remaining. Build an extractor."))))
              ((= (hud-choice-kind context) 0) "Choose a building for this site.")
              ((= (placement-reason world (hud-choice-kind context) (hud-x context) (hud-y context)) 0)
               "Choose a building for this site.")
              (else (reason-text (placement-reason world (hud-choice-kind context) (hud-x context) (hud-y context)))))))
    (define (context-copy-height world context)
      (cond ((hub-selected? world context) 84)
            ((construction-context? world context)
             (if (or (> (hud-failure context) 0)
                     (and (> (hud-choice-kind context) 0) (> (placement-reason world (hud-choice-kind context) (hud-x context) (hud-y context)) 0))) 84 36))
            (else 64)))

    (define (pending-work? building) (or (not (ready? building)) (arming? building) (moving? building)))
    (define (has-upgrade? building)
      (< (building-level building) 3))
    (define (upgrade-enabled? world building)
      (and (alive? world) (not (scavenge-pending? world (building-id building))) (< (list-size (world-surveys world)) maximum-surveys)
           (or (not (= (building-kind building) 1)) (> (ore-remaining world (building-x building) (building-y building)) 0))
           (if (or (tower? building) (= (building-kind building) 2)) (affordable-kit? world (upgrade-cost building))
               (>= (world-credits world) (upgrade-cost building)))))
    (define (upgrade-help world building)
      (priced-help (upgrade-cost building)
                   (if (not (upgrade-enabled? world building)) "Needs available ore and colony capacity."
                       (cond ((= (building-kind building) 1) "Add a mining slot.")
                             ((= (building-kind building) 2)
                              (string-append "Increase firepower to " (integer-text (+ 100 (* 50 (building-level building)))) "%."))
                             ((= (building-level building) 1) "Double cart speed and extend sight to ten cells.")
                             (else "Double cart speed again. Links use the slower tower.")))))
    (define (scavenge-control world building actions)
      (let ((reason (scavenge-reason world building)))
        (action-button "scavenge" "X" (string-append "+" (integer-text (scavenge-refund building)) " ore")
                       (string-append "Scavenge · " (if (= reason 0)
                                                        "One worker demolishes this building. Recover 20% of completed investment, plus stored ore."
                                                        (reason-text reason)))
                       (= reason 0) (action-scavenge actions))))
    (define (building-actions world building actions)
      (cond ((scavenge-pending? world (building-id building))
             (list (action-button "cancel-build" "C" "" "Cancel scavenging; keep the building" (alive? world) (action-cancel actions))))
            ((pending-work? building)
             (list (action-button "cancel-build" "C" "" (if (= (construction-cost building) 0) "Cancel free construction" "Cancel construction; return reserved materials") (alive? world) (action-cancel actions))))
            (else (append (if (has-upgrade? building)
                              (list (action-button "upgrade" "U" (string-append (integer-text (upgrade-cost building)) " ore")
                                                   (string-append "Upgrade " (structure-title building) " · " (upgrade-help world building))
                                                   (upgrade-enabled? world building) (action-improve actions))) (empty-list))
                          (list (scavenge-control world building actions))))))
    (define (three-structure-controls? world context)
      (let ((found (selected-building world context)))
        (and (alive? world) (not (null? found)) (has-upgrade? (car found))
             (not (pending-work? (car found))) (not (scavenge-pending? world (building-id (car found)))))))
    (define (close-selection context actions)
      (circle "close-context" "Close" "Close selection · Esc" (not (hud-build-pending context)) #f (action-dismiss actions)))
    (define (context-actions world context actions)
      (let ((found (selected-building world context)))
        (cond ((not (alive? world)) (list (action-button "restart" "" "" "Begin a new colony" #t (action-restart actions))))
              ((hub-selected? world context)
               (list (hire-control world actions)
                     (hub-upgrade-control world actions)
                     (priced-circle "repair" "R" (string-append (integer-text (repair-cost world)) " ore")
                                    (string-append "Repair hub to " (integer-text (repair-percent world)) "% · "
                                                   (if (= (repair-reason world) 0) "One worker · 3 seconds" (reason-text (repair-reason world))))
                                    (= (repair-reason world) 0) #f (action-repair actions))
                     (close-selection context actions)))
              ((not (null? found)) (append (building-actions world (car found) actions) (list (close-selection context actions))))
              ((nest-selected? world context) (list (close-selection context actions)))
              ((deposit? world context) (list (construction-control world context actions 1 "1") (close-selection context actions)))
              (else (list (construction-control world context actions 3 "1")
                          (construction-control world context actions 2 "2")
                          (close-selection context actions))))))
    (define (context-controls world context controls)
      (if (or (construction-context? world context) (hub-selected? world context))
          (ui-layer "context-actions" (grow 1) (px (if (deposit? world context) 56 116))
                    (list (ui-at 4 0
                                 (ui-layer (if (hub-selected? world context) "hub-actions" "construction-choices")
                                           (px 116) (px 116) (place-controls controls 0 2 #f)))))
          (if (= (list-size controls) 3)
              (ui-layer "context-actions" (grow 1) (px 140)
                        (list (ui-at 2 0 (car controls)) (ui-at 66 0 (car (cdr controls)))
                              (ui-at 34 84 (car (cdr (cdr controls))))))
              (let ((width (+ (* (list-size controls) hud-control-diameter) (* (- (list-size controls) 1) 8))))
                (ui-layer "context-actions" (grow 1) (px 80)
                          (list (ui-at (quotient (- 124 width) 2) 0 (ui-row "structure-actions" (px width) (px 80) 8 controls))))))))
    (define (context-card world context actions layout)
      (let ((area (callout-rect layout)))
        (ui-at (rect-x area) (rect-y area)
               (ui-pointing-panel (if (alive? world) "context" "result") (px context-width) (px (rect-height area)) 8 4
                                  (pointing-side context layout) (pointing-offset context layout)
                                  (list (ui-layer "context-copy" (grow 1) (px (context-copy-height world context))
                                                  (list (ui-label "context-title" (px 1) (px 1) (context-title world context) 2)
                                                        (line "context-description" (context-copy-height world context) (context-description world context) (if (> (hud-failure context) 0) 4 0))))
                                        (context-controls world context (context-actions world context actions)))))))
    (define (menu-button key label help enabled request)
      (ui-button key (grow 1) (px 48) label help enabled #f request))
    (define (centered-dialog context key height gap children)
      (ui-at (quotient (- (hud-root-width context) 240) 2) (quotient (- (hud-root-height context) height) 2)
             (ui-panel key (px 240) (px height) 16 gap children)))
    (define (handedness-button context actions left)
      (ui-button (if left "left-handed" "right-handed") (grow 1) (px 48)
                 (if left "Left-handed" "Right-handed") (if left "Controls on the left edge" "Controls on the right edge")
                 (= (hud-dialog-pending context) 0) (if left (hud-left-handed context) (not (hud-left-handed context)))
                 ((action-handedness actions) (if left 1 0))))
    (define (pause-dialog world context actions)
      (centered-dialog context "pause-dialog" 276 3
                       (list (line "pause-title" 28 (if (= (hud-dialog-pending context) 1) "Pausing…" "Paused") 2)
                             (menu-button "resume" (if (= (hud-dialog-pending context) 2) "Resuming…" "Resume · P") "Resume the colony · P or Escape" (= (hud-dialog-pending context) 0) (action-resume actions))
                             (ui-row "colony-options" (grow 1) (px 48) 8
                                     (list (menu-button "restart-menu" "Restart" "Start again after confirmation" (and (not (hud-build-pending context)) (= (hud-dialog-pending context) 0)) (action-restart actions))
                                           (menu-button "resign-menu" "Resign" "End this colony after confirmation" (and (alive? world) (not (hud-build-pending context)) (= (hud-dialog-pending context) 0)) (action-resign-menu actions))))
                             (line "frontier-hint" 45 frontier-hint 0)
                             (line "controls-title" 12 "Controls" 0)
                             (ui-row "handedness-options" (grow 1) (px 48) 8
                                     (list (handedness-button context actions #f)
                                           (handedness-button context actions #t))))))
    (define (restart-dialog context actions)
      (centered-dialog context "restart-dialog" 224 8
                       (list (line "restart-title" 24 "Restart colony?" 4)
                             (line "restart-description" 40 "Replace this colony with a new one?" 0)
                             (menu-button "dismiss-restart" "Cancel · Esc" "Return to the paused menu" (= (hud-dialog-pending context) 0) (action-dismiss-restart actions))
                             (menu-button "accept-restart" (if (= (hud-dialog-pending context) 3) "Restarting…" "Restart · Enter") "Start a new colony" (and (not (hud-build-pending context)) (= (hud-dialog-pending context) 0)) (action-accept-restart actions)))))
    (define (resign-dialog context actions)
      (centered-dialog context "resign-dialog" 224 8
                       (list (line "resign-title" 24 "Resign colony?" 4)
                             (line "resign-description" 40 "End this run and reveal the map for inspection?" 0)
                             (menu-button "dismiss-resign" "Cancel · Esc" "Return to the paused menu" (= (hud-dialog-pending context) 0) (action-dismiss-resign actions))
                             (menu-button "accept-resign" (if (= (hud-dialog-pending context) 4) "Resigning…" "Resign · Enter") "End this colony" (= (hud-dialog-pending context) 0) (action-accept-resign actions)))))
    (define (dialog-overlay world context actions)
      (list (ui-button "dialog-backdrop" (grow 1) (grow 1) "" "Close the current menu · Escape" #t #f (action-dismiss actions))
            (cond ((= (hud-dialog context) 2) (restart-dialog context actions))
                  ((= (hud-dialog context) 3) (resign-dialog context actions))
                  (else (pause-dialog world context actions)))))
    (define (attached-panels world context actions layout alerts)
      (append (cond ((or (hud-chooser context) (not (alive? world))) (list (context-card world context actions layout)))
                    ((onboarding-visible? world context) (list (onboarding-panel context layout))) (else (empty-list))) alerts))
    (define (nest-stars world)
      (let ((remaining (living-nests (world-nests world))))
        (cond ((= remaining 3) "☆☆☆") ((= remaining 2) "★☆☆")
              ((= remaining 1) "★★☆") (else "★★★"))))
    (define (colony-hud world context actions layout alerts)
      (ui-layer "hud" (grow 1) (grow 1)
                (append (list (rail world context actions)
                              (ui-at (if (hud-left-handed context) (- (hud-root-width context) 132) 0) 0
                                     (ui-label "nest-objective" (px 132) (px 34) (nest-stars world) 0)))
                        (if (> (hud-dialog context) 0) (dialog-overlay world context actions)
                            (attached-panels world context actions layout alerts)))))))
