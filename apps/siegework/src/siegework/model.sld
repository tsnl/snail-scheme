;; The colony is one immutable authoritative value. Jobs reserve a project before
;; another worker can choose it; ore moves from mine stock to one worker to hub.
(define-library (siegework model)
  (export World make-world initial-world advance-world extract-world observe-world
          fortify-world upgrade-world fabricate-world prioritize-world repair-world pause-world
          world-tick world-outcome world-credits world-hull world-kills world-next-id
          world-buildings world-bots world-enemies world-surveys world-priority
          world-repairs world-delivered world-produced world-spent world-lost world-notice world-paused
          Building make-building building-id building-kind building-x building-y
          building-level building-hp building-stock building-stage building-cooldown
          building-aim-x building-aim-y
          Bot make-bot bot-id bot-x bot-y bot-job bot-target bot-cargo bot-timer bot-path
          Enemy make-enemy enemy-id enemy-x enemy-y enemy-hp enemy-kind enemy-target
          enemy-path
          building-at find-building list-size visible? ready? building-radius
          building-health building-cost placement-reason workers-at mine-backlog
          world-credits-set world-hull-set world-tick-set world-enemies-set
          world-buildings-set world-bots-set world-surveys-set world-produced-set
          building-hp-set building-stock-set building-stage-set
          bot-path-set enemy-path-set)
  (import (scheme base)
          (scheme immutable)
          (siegework terrain)
          (only (lofi core) ann I32))
  (begin

    ;; ---- Colony values ----

    ;; Kind: 1 extractor, 2 artillery, 3 observation tower.
    ;; Stage: 0 paid kit at hub, 1 kit assigned/in transit, 2 operational.
    (define-immutable-record Building make-building
      (id I32 building-id building-id-set)
      (kind I32 building-kind building-kind-set)
      (x I32 building-x building-x-set)
      (y I32 building-y building-y-set)
      (level I32 building-level building-level-set)
      (hp I32 building-hp building-hp-set)
      (stock I32 building-stock building-stock-set)
      (stage I32 building-stage building-stage-set)
      (cooldown I32 building-cooldown building-cooldown-set)
      (aim-x I32 building-aim-x building-aim-x-set)
      (aim-y I32 building-aim-y building-aim-y-set))
    ;; Job: 0 available, 1 collect, 2 deliver ore, 3 deliver building kit,
    ;; 4 deliver repair kit, 5 return interrupted kit, 6 assembling at hub.
    ;; A building kit is already paid for. A repair kit carries four paid ore.
    (define-immutable-record Bot make-bot
      (id I32 bot-id bot-id-set)
      (x I32 bot-x bot-x-set)
      (y I32 bot-y bot-y-set)
      (job I32 bot-job bot-job-set)
      (target I32 bot-target bot-target-set)
      (cargo I32 bot-cargo bot-cargo-set)
      (timer I32 bot-timer bot-timer-set)
      (path (List I32) bot-path bot-path-set))
    ;; Kind: 0 siege minion, 1 outpost raider, 2 final beast.
    (define-immutable-record Enemy make-enemy
      (id I32 enemy-id enemy-id-set)
      (x I32 enemy-x enemy-x-set)
      (y I32 enemy-y enemy-y-set)
      (hp I32 enemy-hp enemy-hp-set)
      (kind I32 enemy-kind enemy-kind-set)
      (target I32 enemy-target enemy-target-set)
      (path (List I32) enemy-path enemy-path-set))
    (define-immutable-record World make-world
      (tick I32 world-tick world-tick-set)
      (outcome I32 world-outcome world-outcome-set)
      (credits I32 world-credits world-credits-set)
      (hull I32 world-hull world-hull-set)
      (kills I32 world-kills world-kills-set)
      (next-id I32 world-next-id world-next-id-set)
      (buildings (List Building) world-buildings world-buildings-set)
      (bots (List Bot) world-bots world-bots-set)
      (enemies (List Enemy) world-enemies world-enemies-set)
      (surveys (List Survey) world-surveys world-surveys-set)
      (priority I32 world-priority world-priority-set)
      (repairs I32 world-repairs world-repairs-set)
      (delivered I32 world-delivered world-delivered-set)
      (produced I32 world-produced world-produced-set)
      (spent I32 world-spent world-spent-set)
      (lost I32 world-lost world-lost-set)
      (notice I32 world-notice world-notice-set)
      (paused I32 world-paused world-paused-set))
    (define (idle-bot id)
      (make-bot id (cell-x hub-x) (cell-y hub-y) 0 0 0 0 (empty-list)))
    (define (initial-world)
      (make-world 0 0 160 300 0 4 (empty-list)
                  (list (idle-bot 1) (idle-bot 2) (idle-bot 3)) (empty-list)
                  (list (make-survey hub-x hub-y 9)) 0 1 0 0 0 0 0 0))
    (define (pause-world world value)
      (if (or (= value 0) (= value 1)) (world-paused-set world value) world))
    (define (list-size xs) (if (null? xs) (ann 0 I32) (+ 1 (list-size (cdr xs)))))
    (define (minimum a b) (if (< a b) a b))
    (define (maximum a b) (if (> a b) a b))
    (define (active? world) (= (world-outcome world) 0))
    (define (ready? building) (and (= (building-stage building) 2) (> (building-hp building) 0)))
    (define (building-cost kind) (cond ((= kind 1) 40) ((= kind 2) 50) (else 25)))
    (define (building-health kind) (cond ((= kind 1) 140) ((= kind 2) 100) (else 90)))
    (define (building-radius building)
      (if (= (building-kind building) 3) (if (= (building-level building) 1) 7 10) 4))
    (define (find-building buildings id)
      (if (null? buildings) (empty-list)
          (if (= (building-id (car buildings)) id) (list (car buildings))
              (find-building (cdr buildings) id))))
    (define (building-at buildings x y)
      (if (null? buildings) (empty-list)
          (if (and (= (building-x (car buildings)) x) (= (building-y (car buildings)) y))
              (list (car buildings)) (building-at (cdr buildings) x y))))
    (define (replace-building buildings value)
      (if (null? buildings) buildings
          (cons (if (= (building-id (car buildings)) (building-id value)) value (car buildings))
                (replace-building (cdr buildings) value))))
    (define (put-building world building)
      (world-buildings-set world (replace-building (world-buildings world) building)))
    (define (replace-bot bots value)
      (if (null? bots) bots
          (cons (if (= (bot-id (car bots)) (bot-id value)) value (car bots))
                (replace-bot (cdr bots) value))))
    (define (put-bot world bot) (world-bots-set world (replace-bot (world-bots world) bot)))
    (define (spend world amount)
      (world-spent-set (world-credits-set world (- (world-credits world) amount))
                       (+ (world-spent world) amount)))

    ;; ---- Observation and legal orders ----

    (define (buildings-see? buildings x y)
      (and (not (null? buildings))
           (or (and (ready? (car buildings))
                    (within? x y (building-x (car buildings)) (building-y (car buildings))
                             (building-radius (car buildings))))
               (buildings-see? (cdr buildings) x y))))
    (define (visible? world x y)
      (and (inside? x y) (or (within? x y hub-x hub-y 9)
                             (buildings-see? (world-buildings world) x y))))
    (define (remember surveys x y radius)
      (if (null? surveys) (list (make-survey x y radius))
          (let ((survey (car surveys)))
            (if (and (= (survey-x survey) x) (= (survey-y survey) y))
                (cons (make-survey x y (maximum radius (survey-radius survey))) (cdr surveys))
                (cons survey (remember (cdr surveys) x y radius))))))
    (define (remember-building world building)
      (world-surveys-set world (remember (world-surveys world) (building-x building)
                                         (building-y building) (building-radius building))))
    ;; Cheap preview reasons; the command also proves a known walking route.
    (define (placement-reason world kind x y)
      (cond ((not (active? world)) 9)
            ((not (inside? x y)) 15)
            ((not (visible? world x y)) 1)
            ((not (ground? x y)) 2)
            ((or (and (= x hub-x) (= y hub-y))
                 (not (null? (building-at (world-buildings world) x y)))) 3)
            ((and (= kind 1) (= (deposit-rate x y) 0)) 4)
            ((and (not (= kind 1)) (> (deposit-rate x y) 0)) 5)
            ((< (world-credits world) (building-cost kind)) 7)
            ((or (>= (list-size (world-buildings world)) 32)
                 (>= (list-size (world-surveys world)) 64)) 8)
            (else 0)))
    (define (queue-building world kind x y)
      (let ((reason (placement-reason world kind x y)))
        (cond ((not (= reason 0)) (world-notice-set world reason))
              ((null? (walking-path hub-x hub-y x y (world-surveys world) #f))
               (world-notice-set world 6))
              (else (accept-building world kind x y)))))
    (define (accept-building world kind x y)
      (let ((building (make-building (world-next-id world) kind x y 1
                                     (building-health kind) 0 0 0 (cell-x x) (cell-y y))))
        (world-notice-set
         (world-next-id-set
          (world-buildings-set (spend world (building-cost kind))
                               (append (world-buildings world) (list building)))
          (+ (world-next-id world) 1)) 10)))
    (define (extract-world world x y) (queue-building world 1 x y))
    (define (fortify-world world x y) (queue-building world 2 x y))
    (define (observe-world world x y) (queue-building world 3 x y))
    (define (upgrade-world world x y)
      (let ((found (building-at (world-buildings world) x y)))
        (if (or (not (active? world)) (null? found)) (world-notice-set world 11)
            (upgrade-building world (car found)))))
    (define (upgrade-building world building)
      (let ((price (if (= (building-kind building) 3) 35 40)))
        (cond ((or (not (ready? building)) (= (building-level building) 2)
                   (= (building-kind building) 2)) (world-notice-set world 11))
              ((< (world-credits world) price) (world-notice-set world 7))
              (else (let ((improved (building-level-set building 2)))
                      (world-notice-set (remember-building (put-building (spend world price) improved)
                                                           improved) 12))))))
    (define (fabricate-world world)
      (cond ((not (active? world)) world)
            ((>= (list-size (world-bots world)) 12) (world-notice-set world 8))
            ((< (world-credits world) 25) (world-notice-set world 7))
            (else (world-notice-set
                   (world-next-id-set
                    (world-bots-set (spend world 25)
                                    (append (world-bots world)
                                            (list (bot-timer-set (bot-job-set (idle-bot (world-next-id world)) 6) 30))))
                    (+ (world-next-id world) 1)) 13))))
    (define (prioritize-world world x y)
      (let ((found (building-at (world-buildings world) x y)))
        (if (null? found) (world-notice-set world 11)
            (world-notice-set (world-priority-set world (building-id (car found))) 14))))
    (define (repair-world world)
      (world-repairs-set world (if (= (world-repairs world) 0) 1 0)))

    ;; ---- Production and purposeful worker assignments ----

    (define (produce-buildings world buildings)
      (if (null? buildings) world
          (let* ((building (car buildings))
                 (amount (if (and (ready? building) (= (building-kind building) 1))
                             (minimum (- 120 (building-stock building))
                                      (* (deposit-rate (building-x building) (building-y building))
                                         (building-level building))) 0)))
            (produce-buildings (world-produced-set
                                (put-building world (building-stock-set building (+ (building-stock building) amount)))
                                (+ (world-produced world) amount)) (cdr buildings)))))
    (define (workers-at bots job target)
      (if (null? bots) 0
          (+ (if (and (= (bot-job (car bots)) job) (= (bot-target (car bots)) target)) 1 0)
             (workers-at (cdr bots) job target))))
    (define (mine-backlog world building)
      (- (building-stock building) (* 16 (workers-at (world-bots world) 1 (building-id building)))))
    (define (preferred-mine? world candidate best)
      (or (null? best) (= (building-id candidate) (world-priority world))
          (and (not (= (building-id (car best)) (world-priority world)))
               (> (mine-backlog world candidate) (mine-backlog world (car best))))))
    ;; A prepared assignment owns a checked route. Only installing it may claim
    ;; a paid kit or spend repair ore; trying an unsafe job has no effect.
    (define-immutable-record Assignment make-assignment
      (job I32 assignment-job assignment-job-set)
      (target I32 assignment-target assignment-target-set)
      (cargo I32 assignment-cargo assignment-cargo-set)
      (path (List I32) assignment-path assignment-path-set))
    (define (has-mine? buildings)
      (and (not (null? buildings))
           (or (and (ready? (car buildings)) (= (building-kind (car buildings)) 1))
               (has-mine? (cdr buildings)))))
    (define (another-hauler? bots id)
      (and (not (null? bots))
           (or (and (not (= (bot-id (car bots)) id)) (<= (bot-job (car bots)) 2))
               (another-hauler? (cdr bots) id))))
    (define (can-spare-worker? world bot)
      (or (not (has-mine? (world-buildings world))) (another-hauler? (world-bots world) (bot-id bot))))
    (define (repairing? bots)
      (and (not (null? bots))
           (or (= (bot-job (car bots)) 4) (repairing? (cdr bots)))))
    (define (repair-available? world)
      (and (= (world-repairs world) 1) (>= (world-credits world) 44)
           (not (repairing? (world-bots world))) (= (remainder (world-tick world) 20) 0)))
    (define (route-from world x y a b)
      (let* ((cx (quotient x cell-size)) (cy (quotient y cell-size))
             (path (walking-path cx cy a b (world-surveys world) #f)))
        (if (and (= x (cell-x cx)) (= y (cell-y cy))) path
            (cons (cell-index cx cy) path))))
    (define (observed-danger? world enemies x y)
      (and (not (null? enemies))
           (or (and (visible? world (quotient (enemy-x (car enemies)) cell-size)
                              (quotient (enemy-y (car enemies)) cell-size))
                    (within? x y (enemy-x (car enemies)) (enemy-y (car enemies)) 110))
               (observed-danger? world (cdr enemies) x y))))
    (define (safe-route? world path)
      (or (null? path)
          (and (not (observed-danger? world (world-enemies world)
                                      (cell-x (index-x (car path))) (cell-y (index-y (car path)))))
               (safe-route? world (cdr path)))))
    (define (prepare-assignment world bot job target cargo x y)
      (let ((path (route-from world (bot-x bot) (bot-y bot) x y)))
        (if (and (or (not (null? path)) (and (= (bot-x bot) (cell-x x)) (= (bot-y bot) (cell-y y))))
                 (safe-route? world path))
            (list (make-assignment job target cargo path)) (empty-list))))
    (define (construction-choice world bot buildings priority)
      (if (null? buildings) (empty-list)
          (let* ((building (car buildings))
                 (choice (if (and (= (building-stage building) 0)
                                  (or (= priority 0) (= (building-id building) priority)))
                             (prepare-assignment world bot 3 (building-id building)
                                                 (building-cost (building-kind building))
                                                 (building-x building) (building-y building)) (empty-list))))
            (if (null? choice) (construction-choice world bot (cdr buildings) priority) choice))))
    (define (choose-construction world bot)
      (let ((preferred (construction-choice world bot (world-buildings world) (world-priority world))))
        (if (null? preferred) (construction-choice world bot (world-buildings world) 0) preferred)))
    (define (hauling-choice world bot buildings best)
      (if (null? buildings) best
          (let* ((building (car buildings))
                 (best-mine (if (null? best) (empty-list)
                                (find-building (world-buildings world) (assignment-target (car best)))))
                 (choice (if (and (ready? building) (= (building-kind building) 1)
                                  (> (mine-backlog world building) 0) (preferred-mine? world building best-mine))
                             (prepare-assignment world bot 1 (building-id building) 0 (building-x building) (building-y building))
                             (empty-list))))
            (hauling-choice world bot (cdr buildings) (if (null? choice) best choice)))))
    (define (building-repair-choice world bot buildings)
      (if (null? buildings) (empty-list)
          (let* ((building (car buildings))
                 (choice (if (and (ready? building)
                                  (<= (+ (building-hp building) 25) (building-health (building-kind building))))
                             (prepare-assignment world bot 4 (building-id building) 4 (building-x building) (building-y building))
                             (empty-list))))
            (if (null? choice) (building-repair-choice world bot (cdr buildings)) choice))))
    (define (choose-repair world bot)
      (if (<= (world-hull world) 275) (prepare-assignment world bot 4 0 4 hub-x hub-y)
          (building-repair-choice world bot (world-buildings world))))
    (define (choose-work world bot)
      (let* ((spare (can-spare-worker? world bot))
             (repair (if (and spare (repair-available? world)) (choose-repair world bot) (empty-list)))
             (project (if spare (choose-construction world bot) (empty-list)))
             (haul (hauling-choice world bot (world-buildings world) (empty-list))))
        (cond ((and (< (world-hull world) 150) (not (null? repair))) repair)
              ((not (null? project)) project)
              ((not (null? haul)) haul)
              (else repair))))
    (define (install-assignment world bot assignment)
      (let* ((job (assignment-job assignment)) (target (assignment-target assignment))
             (world (cond ((= job 3) (put-building world (building-stage-set (car (find-building (world-buildings world) target)) 1)))
                          ((= job 4) (spend world 4)) (else world))))
        (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) job target
                                 (assignment-cargo assignment) 0 (assignment-path assignment)))))
    (define (assign-work world bot)
      (let ((choice (choose-work world bot)))
        (if (null? choice) world (install-assignment world bot (car choice)))))

    ;; ---- Worker travel, interruption and delivery ----

    (define (approach value target speed)
      (if (< value target) (+ value (minimum speed (- target value)))
          (- value (minimum speed (- value target)))))
    (define (walk-bot bot)
      (let* ((next (car (bot-path bot))) (x (cell-x (index-x next))) (y (cell-y (index-y next)))
             (moved (if (= (bot-x bot) x) (bot-y-set bot (approach (bot-y bot) y 8))
                        (bot-x-set bot (approach (bot-x bot) x 8)))))
        (if (and (= (bot-x moved) x) (= (bot-y moved) y))
            (bot-path-set moved (cdr (bot-path moved))) moved)))
    (define (danger? enemies x y)
      (and (not (null? enemies))
           (or (within? x y (enemy-x (car enemies)) (enemy-y (car enemies)) 110)
               (danger? (cdr enemies) x y))))
    (define (return-home world bot job)
      (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) job (bot-target bot) (bot-cargo bot) 0
                               (route-from world (bot-x bot) (bot-y bot) hub-x hub-y))))
    (define (interrupt-bot world bot)
      (return-home world bot (if (or (= (bot-job bot) 3) (= (bot-job bot) 4)) 5 2)))
    (define (collect-ore world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) (return-home world bot 2)
            (let* ((mine (car found)) (cargo (minimum 16 (building-stock mine))))
              (return-home (put-building world (building-stock-set mine (- (building-stock mine) cargo)))
                           (bot-cargo-set bot cargo) 2)))))
    (define (deliver-ore world bot)
      (put-bot (world-delivered-set
                (world-credits-set world (+ (world-credits world) (bot-cargo bot)))
                (+ (world-delivered world) (bot-cargo bot))) (idle-bot (bot-id bot))))
    (define (complete-building world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) (return-home world bot 5)
            (let ((building (building-stage-set (car found) 2)))
              (return-home (remember-building (put-building world building) building)
                           (bot-cargo-set bot 0) 2)))))
    (define (complete-repair world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (cond ((= (bot-target bot) 0)
               (return-home (world-hull-set world (minimum 300 (+ (world-hull world) 25))) (bot-cargo-set bot 0) 2))
              ((null? found) (return-home world bot 5))
              (else (let ((building (car found)))
                      (return-home (put-building world (building-hp-set building
                                                                        (minimum (building-health (building-kind building))
                                                                                 (+ (building-hp building) 25))))
                                   (bot-cargo-set bot 0) 2))))))
    (define (return-kit world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (put-bot (if (or (= (bot-cargo bot) 4) (null? found))
                     (spend world (- 0 (bot-cargo bot)))
                     (put-building world (building-stage-set (car found) 0)))
                 (idle-bot (bot-id bot)))))
    (define (arrive-bot world bot)
      (cond ((= (bot-job bot) 1) (collect-ore world bot))
            ((= (bot-job bot) 2) (deliver-ore world bot))
            ((= (bot-job bot) 3) (complete-building world bot))
            ((= (bot-job bot) 4) (complete-repair world bot))
            ((= (bot-job bot) 5) (return-kit world bot))
            (else world)))
    (define (advance-bot world bot)
      (cond ((= (bot-job bot) 0) (assign-work world bot))
            ((= (bot-job bot) 6)
             (put-bot world (if (> (bot-timer bot) 1) (bot-timer-set bot (- (bot-timer bot) 1))
                                (idle-bot (bot-id bot)))))
            ((and (or (= (bot-job bot) 1) (= (bot-job bot) 3)
                      (and (= (bot-job bot) 4) (not (= (bot-target bot) 0))))
                  (danger? (world-enemies world) (bot-x bot) (bot-y bot))) (interrupt-bot world bot))
            ((not (null? (bot-path bot))) (put-bot world (walk-bot bot)))
            (else (arrive-bot world bot))))
    (define (advance-bots world bots)
      (if (null? bots) world
          (advance-bots (advance-bot world (car bots)) (cdr bots))))

    ;; ---- Announced attacks choose a hub or an exposed outpost ----

    (define (outpost-target buildings best)
      (if (null? buildings) best
          (let ((building (car buildings)))
            (outpost-target (cdr buildings)
                            (if (and (ready? building) (not (= (building-kind building) 2))
                                     (> (distance (building-x building) (building-y building) hub-x hub-y) 9)
                                     (or (null? best) (> (building-x building) (building-x (car best)))))
                                (list building) best)))))
    (define (spawn-enemy world kind lane)
      (let* ((target (if (= kind 1) (outpost-target (world-buildings world) (empty-list)) (empty-list)))
             (tx (if (null? target) hub-x (building-x (car target))))
             (ty (if (null? target) hub-y (building-y (car target))))
             (enemy (make-enemy (world-next-id world) (cell-x 46) (cell-y lane)
                                (if (= kind 2) 1800 (+ 65 (* 15 (quotient (world-tick world) 600)))) kind
                                (if (null? target) 0 (building-id (car target)))
                                (walking-path 46 lane tx ty (world-surveys world) #t))))
        (world-next-id-set (world-enemies-set world (append (world-enemies world) (list enemy)))
                           (+ (world-next-id world) 1))))
    (define (spawn-wave world kind count)
      (if (= count 0) world
          (spawn-wave (spawn-enemy world kind (+ 14 (* 2 (remainder count 3)))) kind (- count 1))))
    (define (spawn-due world)
      (let ((tick (world-tick world)))
        (cond ((= tick 4200) (spawn-wave world 2 1))
              ((= tick 2100) (spawn-wave world 1 4))
              ((and (>= tick 600) (< tick 4200) (= (remainder tick 600) 0))
               (spawn-wave world 0 (+ 2 (quotient tick 1200))))
              (else world))))
    (define (walk-enemy enemy)
      (let* ((next (car (enemy-path enemy))) (x (cell-x (index-x next))) (y (cell-y (index-y next)))
             (speed 5)
             (moved (if (= (enemy-x enemy) x) (enemy-y-set enemy (approach (enemy-y enemy) y speed))
                        (enemy-x-set enemy (approach (enemy-x enemy) x speed)))))
        (if (and (= (enemy-x moved) x) (= (enemy-y moved) y))
            (enemy-path-set moved (cdr (enemy-path moved))) moved)))
    (define (retarget-enemy world enemy)
      (enemy-path-set (enemy-target-set enemy 0)
                      (walking-path (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size)
                                    hub-x hub-y (world-surveys world) #t)))
    (define (march-enemies world enemies)
      (if (null? enemies) enemies
          (let* ((enemy (car enemies))
                 (enemy (if (and (> (enemy-target enemy) 0)
                                 (null? (find-building (world-buildings world) (enemy-target enemy))))
                            (retarget-enemy world enemy) enemy)))
            (cons (if (null? (enemy-path enemy)) enemy (walk-enemy enemy))
                  (march-enemies world (cdr enemies))))))
    (define (enemy-visible? world enemy)
      (visible? world (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size)))
    (define (choose-target world building enemies best)
      (if (null? enemies) best
          (let ((enemy (car enemies)))
            (choose-target world building (cdr enemies)
                           (if (and (> (enemy-hp enemy) 0) (enemy-visible? world enemy)
                                    (within? (enemy-x enemy) (enemy-y enemy)
                                             (cell-x (building-x building)) (cell-y (building-y building)) 320)
                                    (or (null? best) (> (enemy-kind enemy) (enemy-kind (car best)))
                                        (and (= (enemy-kind enemy) (enemy-kind (car best)))
                                             (< (distance (enemy-x enemy) (enemy-y enemy) (cell-x hub-x) (cell-y hub-y))
                                                (distance (enemy-x (car best)) (enemy-y (car best)) (cell-x hub-x) (cell-y hub-y))))))
                               (list enemy) best)))))
    (define (hurt-enemy enemies id amount)
      (if (null? enemies) enemies
          (cons (if (= (enemy-id (car enemies)) id) (enemy-hp-set (car enemies) (- (enemy-hp (car enemies)) amount))
                    (car enemies)) (hurt-enemy (cdr enemies) id amount))))
    (define (fire-building world building)
      ;; Aim records an actual shot, so its tracer cannot bend while cooling down.
      (if (> (building-cooldown building) 0) world
          (let ((target (choose-target world building (world-enemies world) (empty-list))))
            (if (null? target) world
                (let* ((enemy (car target))
                       (aimed (building-aim-y-set (building-aim-x-set building (enemy-x enemy)) (enemy-y enemy))))
                  (world-enemies-set (put-building world (building-cooldown-set aimed 8))
                                     (hurt-enemy (world-enemies world) (enemy-id enemy) 20)))))))
    (define (fire-buildings world buildings)
      (if (null? buildings) world
          (let* ((building (car buildings))
                 (building (building-cooldown-set building (maximum 0 (- (building-cooldown building) 1))))
                 (world (put-building world building)))
            (fire-buildings (if (and (ready? building) (= (building-kind building) 2))
                                (fire-building world building) world) (cdr buildings)))))
    (define (enemy-survivors enemies)
      (if (null? enemies) enemies
          (if (> (enemy-hp (car enemies)) 0) (cons (car enemies) (enemy-survivors (cdr enemies)))
              (enemy-survivors (cdr enemies)))))
    (define (attack-target world enemy)
      (let ((damage (if (= (enemy-kind enemy) 2) 30 7))
            (found (find-building (world-buildings world) (enemy-target enemy))))
        (if (= (enemy-target enemy) 0) (world-hull-set world (maximum 0 (- (world-hull world) damage)))
            (if (null? found) world
                (put-building world (building-hp-set (car found) (maximum 0 (- (building-hp (car found)) damage))))))))
    (define (attack-targets world enemies)
      (if (null? enemies) world
          (attack-targets (if (null? (enemy-path (car enemies))) (attack-target world (car enemies)) world)
                          (cdr enemies))))
    (define (standing-buildings buildings)
      (if (null? buildings) buildings
          (if (> (building-hp (car buildings)) 0) (cons (car buildings) (standing-buildings (cdr buildings)))
              (standing-buildings (cdr buildings)))))
    (define (clear-casualties world)
      (let ((standing (standing-buildings (world-buildings world)))
            (alive (enemy-survivors (world-enemies world))))
        (world-lost-set
         (world-kills-set (world-buildings-set (world-enemies-set world alive) standing)
                          (+ (world-kills world) (- (list-size (world-enemies world)) (list-size alive))))
         (+ (world-lost world) (- (list-size (world-buildings world)) (list-size standing))))))
    (define (fight world)
      (let* ((world (world-enemies-set world (march-enemies world (world-enemies world))))
             (world (clear-casualties (fire-buildings world (world-buildings world)))))
        (clear-casualties (if (= (remainder (world-tick world) 10) 0)
                              (attack-targets world (world-enemies world)) world))))
    (define (finish world)
      (world-outcome-set world
                         (cond ((<= (world-hull world) 0) 1)
                               ((and (>= (world-tick world) 4200) (null? (world-enemies world))) 3)
                               ((>= (world-tick world) 4800) 2)
                               (else 0))))
    (define (advance-world world)
      (if (or (not (active? world)) (= (world-paused world) 1)) world
          (let* ((world (world-tick-set world (+ (world-tick world) 1)))
                 (world (if (= (remainder (world-tick world) 10) 0)
                            (produce-buildings world (world-buildings world)) world)))
            (finish (fight (spawn-due (advance-bots world (world-bots world))))))))))
