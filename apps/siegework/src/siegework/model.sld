;; The colony is one immutable authoritative value. Jobs reserve a project before
;; another worker can choose it; ore moves through workers and depot freight to hub.
(define-library (siegework model)
  (export World make-world initial-world advance-world extract-world observe-world place-cell-world
          ConstructionOutcome construction-world construction-reason place-cell-outcome
          fortify-world automatic-world upgrade-world fabricate-world focus-world move-world pause-world resign-world restart-world seeded-world
          scavenge-world scavenge-reason scavenge-pending? scavenge-worker? scavenge-ticks scavenge-refund completed-investment
          cancel-world arm-world artillery-range artillery-damage final-siege-tick run-end-tick maximum-enemies next-attack-tick next-attack-number attack-countdown-span attack-kind attack-size threat-tier
          DifficultyWindow difficulty-window difficulty-window-for world-difficulty-window world-threat-tick difficulty-tier difficulty-start difficulty-end difficulty-step-ticks simulation-ticks-per-second
          world-tick world-outcome world-credits world-hull world-kills world-next-id world-started
          world-buildings world-bots world-enemies world-surveys world-focus
          world-plan world-local-spent world-delivered world-produced world-spent world-lost world-notice world-paused
          world-seed world-casualties world-lost-ore world-alerts world-run-marker world-rails world-tracks
          world-hub-x world-hub-y world-nests world-nest-hp world-last-reveal-tick world-payload-version
          Nest make-nest nest-id nest-site-x nest-site-y nest-hp nest-at living-nests initial-nests
          Deposit make-deposit deposit-cell deposit-remaining world-deposits world-deposits-set initial-deposits initial-deposits-v1 ore-remaining remaining-ore
          world-deposit-rate living-nest? cleared-nest? world-payload-version-set
          nest-health maximum-buildings maximum-surveys upgrade-cost
          world-breaches world-excavations world-ground? world-rock-remaining rock-health
          Dig make-dig dig-cell dig-remaining enemy-burrower dig-at
          Alert make-alert alert-x alert-y alert-kind alert-tick attack-alert-ticks attack-alert-radius
          Building make-building building-id building-kind building-x building-y
          building-level building-hp building-stock building-stage building-cooldown
          building-aim-x building-aim-y building-armed building-source building-move-x building-move-y moving? tower? armed?
          Bot make-bot bot-id bot-x bot-y bot-job bot-target bot-cargo bot-timer bot-path bot-hp bot-order bot-source bot-flight
          Flight make-flight flight-origin flight-destination flight-progress flight-speed
          Rail make-rail rail-source rail-parent rail-progress rail-returning rail-cargo rail-path
          rail-x rail-y rail-elevation rail-length rail-connectable? bot-riding? bot-height cart-station? rebuild-transport
          flight-height flight-length flight-x flight-y flight-elevation landing-cell
          world-terrain-height clear-zipline? zipline-link?
          track-cell track-east? track-south? track-west? track-north? track-station?
          Enemy make-enemy enemy-id enemy-x enemy-y enemy-hp enemy-max-hp enemy-kind enemy-target enemy-spawn-health
          enemy-path enemy-rank enemy-rank-health enemy-rank-damage maximum-enemy-rank maximum-enemy-health
          building-at find-building list-size visible? known? workers-see? construction-hidden? ready? building-radius
          building-health building-cost placement-reason move-reason workers-at mine-backlog
          world-credits-set world-hull-set world-tick-set world-enemies-set
          world-buildings-set world-bots-set world-surveys-set world-produced-set
          building-hp-set building-stock-set building-stage-set
          world-plan-set world-focus-set safe-site? affordable-kit? local-affordable? count-mines pending-build? pending-move? pending-move-count reserved-stock construction-cache
          bot-path-set enemy-path-set ore-cargo? kit-carrier?
          worker-cost worker-assembly-ticks production-worker? pending-workers fabrication-reason
          base-worker-capacity maximum-workers worker-capacity world-hub-capacity-level
          maximum-hub-capacity-level hub-upgrade-cost hub-capacity-investment hub-upgrade-reason
          hub-upgrade-ticks hub-upgrade-worker? pending-hub-upgrade?
          hub-cell? repair-world repair-reason repair-cost repair-target repair-percent repair-ticks repair-health repair-worker? pending-repair?
          arming? construction-stage construction-cost construction-kit-size uncollected-supplies raw-stock)
  (import
   (scheme base)
   (scheme immutable)
   (lofi serialization)
   (siegework terrain)
   (only (lofi base) unreachable i32->i64)
   (only (lofi core) ann I32 deriving))
  (begin

    ;; ---- Colony values ----

    ;; Kind: 1 extractor, 2 artillery, 3 observation/depot tower.
    ;; Artillery upgrades strengthen its gun; tower upgrades extend sight then
    ;; double cart speed at each level. Every completed tower supplies worker carts.
    ;; Each upgrade retains prior functions until its kit arrives.
    ;; Legacy armed towers keep that gun when upgraded; new towers never add one.
    ;; New artillery needs two kits and stays inert until both arrive. Only old
    ;; saves contain unfinished level-two towers (the former artillery design).
    ;; Stage: 0 paid kit at source awaiting a worker, 1 carried kit, 2 operational,
    ;; 3 paid kit at source reserved for a worker settling cargo or collecting it.
    ;; Stages 4/5/7 mirror 0/1/3 while an operational tower awaits its upgrade kit.
    ;; Unfinished stock is incorporated construction, not loose ore: artillery
    ;; needs two identical 25-ore deliveries. Operational stock remains raw ore.
    (define-immutable-record Building make-building
      (id I32 building-id building-id-set)
      (kind I32 building-kind building-kind-set)
      (x I32 building-x building-x-set)
      (y I32 building-y building-y-set)
      (level I32 building-level building-level-set)
      (hp I32 building-hp building-hp-set)
      (stock I32 building-stock building-stock-set)
      (stage I32 building-stage building-stage-set)
      (cooldown I32 building-cooldown building-cooldown-set)
      (aim-x I32 building-aim-x building-aim-x-set)
      (aim-y I32 building-aim-y building-aim-y-set)
      (armed I32 building-armed building-armed-set)
      (source I32 building-source building-source-set)
      (move-x I32 building-move-x building-move-x-set)
      (move-y I32 building-move-y building-move-y-set)
      (deriving derive-serialize derive-deserialize))
    ;; Job: 0 available, 1 collect, 2 deliver ore, 3 deliver building kit,
    ;; 4 returning to assemble a worker, 5 returning kit, 6 hub assembly,
    ;; 7 blocked return / legacy retreat (timer preserves the prior owned job),
    ;; 8 occupied mining slot, 9 travelling to a slot, 10 legacy blocked work,
    ;; 11 collecting a reserved construction kit. Order retains that reservation
    ;; while unrelated cargo is delivered or physical access is unavailable.
    ;; A building kit is already paid for; returning it refunds exactly that cost.
    ;; Production jobs reserve a future worker ID in target; the paid materials
    ;; stay at the hub while cargo remains ordinary ore. Job 6 with target 0 is
    ;; the sole-colonist recovery exception, never a paid production order.
    ;; Jobs 12/13 return for a paid hub repair / perform that repair. Legacy
    ;; timer 12 retains the repair order; target owns its paid ore amount and
    ;; cargo remains ordinary mined ore. No repair target denotes an entity ID.
    ;; Jobs 14/15 return for a paid hub capacity upgrade / assemble it. Legacy
    ;; timer 14 retains that order. Target owns its price, separate from cargo;
    ;; capacity changes only on completion, and death refunds the unused price.
    ;; Jobs 16/17 travel to a reserved building / dismantle it. Target is its
    ;; identity; no ore changes hands until twenty on-site work ticks finish.
    ;; A committed flight owns movement only. Cargo and paid work remain on Bot;
    ;; its fixed ground endpoints remain meaningful after either tower is lost.
    (define-immutable-record Flight make-flight
      (origin I32 flight-origin flight-origin-set)
      (destination I32 flight-destination flight-destination-set)
      (progress I32 flight-progress flight-progress-set)
      (speed I32 flight-speed flight-speed-set)
      (deriving derive-serialize derive-deserialize))
    (define-immutable-record Bot make-bot
      (id I32 bot-id bot-id-set)
      (x I32 bot-x bot-x-set)
      (y I32 bot-y bot-y-set)
      (job I32 bot-job bot-job-set)
      (target I32 bot-target bot-target-set)
      (cargo I32 bot-cargo bot-cargo-set)
      (timer I32 bot-timer bot-timer-set)
      (path (List I32) bot-path bot-path-set)
      (hp I32 bot-hp bot-hp-set)
      (order I32 bot-order bot-order-set)
      (source I32 bot-source bot-source-set)
      (flight (List Flight) bot-flight bot-flight-set)
      (deriving derive-serialize derive-deserialize))
    ;; One source-owned shuttle follows its current tree edge toward the hub,
    ;; then returns empty. Tree construction proves ancestry, never ID order.
    (define-immutable-record Rail make-rail
      (source I32 rail-source rail-source-set)
      (parent I32 rail-parent rail-parent-set)
      (progress I32 rail-progress rail-progress-set)
      (returning I32 rail-returning rail-returning-set)
      (cargo I32 rail-cargo rail-cargo-set)
      (path (List I32) rail-path rail-path-set)
      (deriving derive-serialize derive-deserialize))
    ;; Behavior and strength are independent. Rank survives wounds and keeps the
    ;; introduced medium, hard, extra-hard, miniboss, elite and boss silhouettes.
    ;; Kind: 0 siege minion, 1 outpost raider, 2 final beast.
    ;; Target 0 attacks the hub opportunistically; a building ID commits to an
    ;; exposed outpost or the last building that wounded this enemy.
    (define-immutable-record Enemy make-enemy
      (id I32 enemy-id enemy-id-set)
      (x I32 enemy-x enemy-x-set)
      (y I32 enemy-y enemy-y-set)
      (hp I32 enemy-hp enemy-hp-set)
      (kind I32 enemy-kind enemy-kind-set)
      (target I32 enemy-target enemy-target-set)
      (path (List I32) enemy-path enemy-path-set)
      (burrower Bool enemy-burrower enemy-burrower-set)
      (rank I32 enemy-rank enemy-rank-set)
      (max-hp I32 enemy-max-hp enemy-max-hp-set)
      (deriving derive-serialize derive-deserialize))
    (define-immutable-record Alert make-alert
      (x I32 alert-x alert-x-set)
      (y I32 alert-y alert-y-set)
      (kind I32 alert-kind alert-kind-set)
      (tick I32 alert-tick alert-tick-set)
      (deriving derive-serialize derive-deserialize))
    ;; Excavations retain unfinished damage; only completed rock becomes a
    ;; permanent breach. Neither list can change water or original ground.
    (define-immutable-record Dig make-dig
      (cell I32 dig-cell dig-cell-set)
      (remaining I32 dig-remaining dig-remaining-set)
      (deriving derive-serialize derive-deserialize))
    ;; These seed-owned sites survive building loss and nest destruction.
    ;; Underground reserves are distinct from mined, transported and lost ore.
    (define-immutable-record Deposit make-deposit
      (cell I32 deposit-cell deposit-cell-set)
      (remaining I32 deposit-remaining deposit-remaining-set)
      (deriving derive-serialize derive-deserialize))
    (define-immutable-record Nest make-nest
      (id I32 nest-id nest-id-set)
      (x I32 nest-site-x nest-site-x-set)
      (y I32 nest-site-y nest-site-y-set)
      (hp I32 nest-hp nest-hp-set)
      (deriving derive-serialize derive-deserialize))
    (define-immutable-record World make-world
      (tick I32 world-tick world-tick-set)
      (outcome I32 world-outcome world-outcome-set)
      (credits I32 world-credits world-credits-set)
      (hull I32 world-hull world-hull-set)
      (kills I32 world-kills world-kills-set)
      (next-id I32 world-next-id world-next-id-set)
      (buildings (List Building) world-buildings world-buildings-set)
      (bots (List Bot) world-bots world-bots-set)
      (enemies (List Enemy) world-enemies world-enemies-set)
      (surveys (List Survey) world-surveys world-surveys-set)
      (focus I32 world-focus world-focus-set)
      (plan I32 world-plan world-plan-set)
      (delivered I32 world-delivered world-delivered-set)
      (produced I32 world-produced world-produced-set)
      (spent I32 world-spent world-spent-set)
      (lost I32 world-lost world-lost-set)
      (notice I32 world-notice world-notice-set)
      (paused I32 world-paused world-paused-set)
      (seed I32 world-seed world-seed-set)
      (casualties I32 world-casualties world-casualties-set)
      (lost-ore I32 world-lost-ore world-lost-ore-set)
      (alerts (List Alert) world-alerts world-alerts-set)
      (run-marker I32 world-run-marker world-run-marker-set)
      (rails (List Rail) world-rails world-rails-set)
      (local-spent I32 world-local-spent world-local-spent-set)
      (nests (List Nest) world-nests world-nests-set)
      (last-reveal-tick I32 world-last-reveal-tick world-last-reveal-tick-set)
      (breaches (List I32) world-breaches world-breaches-set)
      (excavations (List Dig) world-excavations world-excavations-set)
      (started Bool world-started world-started-set)
      (tracks (List I32) world-tracks world-tracks-set)
      (hub-capacity-level I32 world-hub-capacity-level world-hub-capacity-level-set)
      (deposits (List Deposit) world-deposits world-deposits-set)
      (payload-version I32 world-payload-version world-payload-version-set)
      (deriving derive-serialize derive-deserialize))
    (define nest-health 900)
    (define maximum-buildings 256)
    (define maximum-surveys 1024)
    (define (world-hub-x world) (spawn-x (world-seed world)))
    (define (world-hub-y world) (spawn-y (world-seed world)))
    ;; The saved center remains the delivery point. All nine surrounding tiles
    ;; belong to the hub for new orders; existing saves keep their structures.
    (define (hub-cell? world x y)
      (and (>= x (- (world-hub-x world) 1)) (<= x (+ (world-hub-x world) 1))
           (>= y (- (world-hub-y world) 1)) (<= y (+ (world-hub-y world) 1))))
    (define (nest-at nests x y)
      (cond ((null? nests) (empty-list))
            ((and (= (nest-site-x (car nests)) x) (= (nest-site-y (car nests)) y)) (list (car nests)))
            (else (nest-at (cdr nests) x y))))
    (define (living-nests nests)
      (if (null? nests) 0 (+ (if (> (nest-hp (car nests)) 0) 1 0) (living-nests (cdr nests)))))
    (define (nest-hp-total nests)
      (if (null? nests) 0 (+ (nest-hp (car nests)) (nest-hp-total (cdr nests)))))
    (define (world-nest-hp world) (nest-hp-total (world-nests world)))

    ;; ---- One trusted seed layout proves persistent site identities ----

    ;; Enumerate three home deposits, sixteen regional candidates, up to twenty-four
    ;; small frontier deposits and three buried nest reserves, never the full map.
    ;; Only one derived layout is retained per Wasm instance; restored
    ;; records can neither populate this cache nor change its capacities.
    (define-immutable-record SeedLayout make-seed-layout
      (seed I32 layout-seed layout-seed-set)
      (deposits (List Deposit) layout-deposits layout-deposits-set)
      (nests (List Nest) layout-nests layout-nests-set))
    (define layout-cache (vector (ann (empty-list) (List SeedLayout))))
    (define (deposit-site seed x y)
      (make-deposit (cell-index x y) (deposit-capacity seed x y)))
    (define (regional-deposits seed region)
      (if (= region 4) (empty-list)
          (let* ((x (regional-deposit-x seed (remainder region 2) (quotient region 2)))
                 (y (regional-deposit-y seed (remainder region 2) (quotient region 2)))
                 (rest (regional-deposits seed (+ region 1)))
                 (hx (+ (- x (spawn-x seed)) hub-x)) (hy (+ (- y (spawn-y seed)) hub-y)))
            (if (or (= (deposit-rate seed x y) 0) (and (>= hx 0) (< hx 48) (>= hy 0) (< hy 36)))
                rest (cons (deposit-site seed x y) rest)))))
    (define (initial-deposits-v1 seed)
      (cons (deposit-site seed (+ (spawn-x seed) 4) (- (spawn-y seed) 2))
            (cons (deposit-site seed (northern-x seed) (northern-y seed))
                  (cons (deposit-site seed (eastern-x seed) (eastern-y seed)) (regional-deposits seed 0)))))
    (define (front-deposits seed candidate)
      (if (= candidate 24) (empty-list)
          (let* ((front (quotient candidate 8)) (slot (remainder candidate 8))
                 (rest (front-deposits seed (+ candidate 1))))
            (if (front-deposit? seed front slot)
                (cons (deposit-site seed (front-deposit-x seed front slot) (front-deposit-y seed front slot)) rest) rest))))
    (define (nest-deposits seed front)
      (if (= front 3) (empty-list)
          (cons (deposit-site seed (front-x seed front) (front-y seed front)) (nest-deposits seed (+ front 1)))))
    (define (new-deposits seed)
      (append (initial-deposits-v1 seed) (append (front-deposits seed 0) (nest-deposits seed 0))))
    (define (new-nests seed front)
      (if (= front 3) (empty-list)
          (cons (make-nest front (front-x seed front) (front-y seed front) nest-health) (new-nests seed (+ front 1)))))
    (define (seed-layout seed)
      (let ((cached (vector-ref layout-cache (i32->i64 0))))
        (unless (and (not (null? cached)) (= (layout-seed (car cached)) seed))
          (vector-set! layout-cache (i32->i64 0) (list (make-seed-layout seed (new-deposits seed) (new-nests seed 0)))))
        (car (vector-ref layout-cache (i32->i64 0)))))
    (define (initial-deposits seed) (layout-deposits (seed-layout seed)))
    (define (initial-nests seed) (layout-nests (seed-layout seed)))
    (define (deposit-at deposits cell)
      (cond ((null? deposits) (empty-list))
            ((= (deposit-cell (car deposits)) cell) (list (car deposits)))
            (else (deposit-at (cdr deposits) cell))))
    ;; A defeated nest exposes an existing reserve. No combat transition adds
    ;; ore or resets a deposit; the ordinary mining withdrawal owns production.
    (define (living-nest? world x y)
      (let ((found (nest-at (world-nests world) x y)))
        (and (not (null? found)) (> (nest-hp (car found)) 0))))
    (define (cleared-nest? world x y)
      (let ((found (nest-at (world-nests world) x y)))
        (and (not (null? found)) (= (nest-hp (car found)) 0))))
    (define (world-deposit-rate world x y)
      (if (nest-site? (world-seed world) x y)
          (if (cleared-nest? world x y) nest-deposit-rate 0)
          (deposit-rate (world-seed world) x y)))
    (define (ore-remaining world x y)
      (let ((found (deposit-at (world-deposits world) (cell-index x y))))
        (if (or (= (world-deposit-rate world x y) 0) (null? found)) 0 (deposit-remaining (car found)))))
    (define (remaining-ore deposits)
      (if (null? deposits) 0 (+ (deposit-remaining (car deposits)) (remaining-ore (cdr deposits)))))
    (define (withdraw-deposit deposits cell amount)
      (if (null? deposits) deposits
          (cons (if (= (deposit-cell (car deposits)) cell)
                    (deposit-remaining-set (car deposits) (- (deposit-remaining (car deposits)) amount)) (car deposits))
                (withdraw-deposit (cdr deposits) cell amount))))
    (define (idle-bot seed id)
      (make-bot id (cell-x (spawn-x seed)) (cell-y (spawn-y seed)) 0 0 0 0 (empty-list) 14 0 0 (empty-list)))
    (define (new-world seed marker)
      (make-world 0 0 160 300 0 4 (empty-list)
                  (list (idle-bot seed 1) (idle-bot seed 2) (idle-bot seed 3)) (empty-list)
                  (list (make-survey (spawn-x seed) (spawn-y seed) 9))
                  0 0 0 0 0 0 0 0 seed 0 0 (empty-list) marker (empty-list) 0 (initial-nests seed) -100
                  (empty-list) (empty-list) #f (empty-list) 0 (initial-deposits seed) 1))
    (define (initial-world) (new-world 1 0))
    (define (next-run-marker world)
      (if (= (world-run-marker world) 2147483647) 0 (+ (world-run-marker world) 1)))
    (define (restart-world world) (new-world (next-map-seed (world-seed world)) (next-run-marker world)))
    (define (seeded-world world seed)
      (if (and (>= seed 1) (<= seed 65535)) (new-world seed (next-run-marker world)) (world-notice-set world 16)))
    (define (pause-world world value)
      (if (and (active? world) (or (= value 0) (= value 1))) (world-paused-set world value) world))
    (define (resign-world world)
      (if (active? world) (world-outcome-set world 4) world))
    (define (list-size xs) (if (null? xs) (ann 0 I32) (+ 1 (list-size (cdr xs)))))
    (define (minimum a b) (if (< a b) a b))
    (define (maximum a b) (if (> a b) a b))
    (define (active? world) (= (world-outcome world) 0))
    (define (arming? building) (>= (building-stage building) 4))
    (define (ready? building)
      (and (or (= (building-stage building) 2) (arming? building)) (> (building-hp building) 0)))
    (define (tower? building) (= (building-kind building) 3))
    (define (armed? building) (or (= (building-kind building) 2) (= (building-armed building) 1)))
    (define (building-cost kind) (cond ((= kind 1) 0) ((= kind 2) 50) (else 25)))
    (define (construction-stage building)
      (if (arming? building) (- (building-stage building) 4) (building-stage building)))
    (define (construction-stage-set building stage)
      (building-stage-set building (+ stage (if (arming? building) 4 0))))
    (define (construction-cost building)
      (cond ((arming? building) 25) ((tower? building) (* 25 (building-level building)))
            (else (building-cost (building-kind building)))))
    (define (construction-kit-size building)
      (if (= (building-kind building) 1) 0 25))
    (define (uncollected-supplies building)
      (- (- (construction-cost building) (if (or (= (building-stage building) 2) (arming? building)) 0 (building-stock building)))
         (if (= (construction-stage building) 1) (construction-kit-size building) 0)))
    (define (raw-stock building)
      (if (or (= (building-stage building) 2) (arming? building)) (building-stock building) 0))
    (define (building-health kind) (cond ((= kind 1) 140) ((= kind 2) 100) (else 90)))
    (define (building-radius building)
      (if (tower? building) (if (= (building-level building) 1) 7 10) 4))
    (define (find-building buildings id)
      (if (null? buildings) (empty-list)
          (if (= (building-id (car buildings)) id) (list (car buildings))
              (find-building (cdr buildings) id))))
    (define (building-at buildings x y)
      (if (null? buildings) (empty-list)
          (if (and (= (building-x (car buildings)) x) (= (building-y (car buildings)) y))
              (list (car buildings)) (building-at (cdr buildings) x y))))
    (define (replace-building buildings value)
      (if (null? buildings) buildings
          (cons (if (= (building-id (car buildings)) (building-id value)) value (car buildings))
                (replace-building (cdr buildings) value))))
    (define (put-building world building)
      (world-buildings-set world (replace-building (world-buildings world) building)))
    (define (replace-bot bots value)
      (if (null? bots) bots
          (cons (if (= (bot-id (car bots)) (bot-id value)) value (car bots))
                (replace-bot (cdr bots) value))))
    (define (put-bot world bot) (world-bots-set world (replace-bot (world-bots world) bot)))
    (define (spend world amount)
      (world-spent-set (world-credits-set world (- (world-credits world) amount))
                       (+ (world-spent world) amount)))
    ;; Spending covers remaining buildings, refundable paid work and local kits.
    ;; Removing the refunded commitment leaves enough spent to back every local
    ;; claim. Reclassify only excess historical local spending, including bank
    ;; refunds after an earlier Scavenge reduced total investment.
    ;; The raw ledger and delivered + local-spent remain unchanged by this step.
    (define (refund-spending world refund)
      (let* ((world (spend world (- 0 refund)))
             (excess (maximum 0 (- (world-local-spent world) (world-spent world)))))
        (world-delivered-set (world-local-spent-set world (- (world-local-spent world) excess))
                             (+ (world-delivered world) excess))))

    ;; ---- Observation and legal orders ----

    (define (buildings-see? buildings x y)
      (and (not (null? buildings))
           (or (and (ready? (car buildings))
                    (within? x y (building-x (car buildings)) (building-y (car buildings))
                             (building-radius (car buildings))))
               (buildings-see? (cdr buildings) x y))))
    ;; Defeat and resignation expose the frozen world for inspection. Knowledge
    ;; follows the outcome without changing surveys or advancing simulation.
    (define (visible? world x y)
      (and (inside? x y) (or (= (world-outcome world) 1) (= (world-outcome world) 4) (within? x y (world-hub-x world) (world-hub-y world) 9)
                             (buildings-see? (world-buildings world) x y)
                             (workers-see? (world-bots world) x y))))
    ;; A passing worker reveals nearby terrain immediately, without claiming
    ;; permanent survey coverage or changing any saved route's proof.
    (define (workers-see? bots x y)
      (and (not (null? bots))
           (or (within? (cell-x x) (cell-y y) (bot-x (car bots)) (bot-y (car bots)) (* 2 cell-size))
               (workers-see? (cdr bots) x y))))
    (define (known? world x y)
      (and (inside? x y) (or (= (world-outcome world) 1) (= (world-outcome world) 4) (cleared-nest? world x y)
                             (surveyed? (world-surveys world) x y)
                             (workers-see? (world-bots world) x y))))
    (define (construction-hidden? world building)
      (and (not (= (building-stage building) 2)) (not (visible? world (building-x building) (building-y building)))))
    (define (remembered-radius surveys x y)
      (if (null? surveys) 0
          (let ((survey (car surveys)))
            (maximum (if (and (= (survey-x survey) x) (= (survey-y survey) y)) (survey-radius survey) 0)
                     (remembered-radius (cdr surveys) x y)))))
    (define (remember-building world building)
      (let ((x (building-x building)) (y (building-y building)) (radius (building-radius building)))
        (if (>= (remembered-radius (world-surveys world) x y) radius) world
            (world-last-reveal-tick-set
             (world-surveys-set world (cons (make-survey x y radius) (world-surveys world))) (world-tick world)))))
    ;; Cheap preview reasons; the command also proves a known walking route.
    ;; The first explicit extractor order starts the clock. Its construction is
    ;; free; other purchases remain gated until that order is accepted.
    (define (placement-reason world kind x y)
      (cond ((not (active? world)) 9)
            ((and (not (world-started world)) (not (= kind 1))) 38)
            ((not (inside? x y)) 15)
            ((not (visible? world x y)) 1)
            ((not (surveyed? (world-surveys world) x y)) 6)
            ((not (world-ground? world x y)) 2)
            ((or (hub-cell? world x y)
                 (living-nest? world x y)
                 (not (null? (building-at (world-buildings world) x y)))
                 (reserved-move-cell? (world-buildings world) x y)) 3)
            ((and (= kind 1) (= (world-deposit-rate world x y) 0)) 4)
            ((and (= kind 1) (= (ore-remaining world x y) 0)) 39)
            ((and (not (= kind 1)) (> (world-deposit-rate world x y) 0)) 5)
            ((not (affordable-kit? world (building-cost kind))) 7)
            ((or (>= (list-size (world-buildings world)) maximum-buildings)
                 (>= (list-size (world-surveys world)) maximum-surveys)) 8)
            (else 0)))
    ;; Command replies carry the decision made by this transition. World keeps
    ;; its existing notice vocabulary; a later tick cannot overwrite the reply.
    (define-immutable-record ConstructionOutcome make-construction-outcome
      (world World construction-world construction-world-set)
      (reason I32 construction-reason construction-reason-set))
    (define (reject-construction world reason)
      (make-construction-outcome (world-notice-set world (if (and (> reason 31) (< reason 35)) 6 reason)) reason))
    (define (queue-building world kind x y reserve)
      (construction-world (queue-building-outcome world kind x y reserve)))
    (define (queue-building-outcome world kind x y reserve)
      (let ((reason (placement-reason world kind x y)))
        (cond ((not (= reason 0)) (reject-construction world reason))
              ((null? (walking-open-path (world-seed world) (world-breaches world) (world-hub-x world) (world-hub-y world) x y (world-surveys world) #f))
               (reject-construction world 32))
              (else (accept-building-outcome world kind x y reserve)))))
    (define (accept-building-outcome world kind x y reserve)
      (let* ((building (make-building (world-next-id world) kind x y 1
                                      (building-health kind) 0 0 0 (cell-x x) (cell-y y) 0 -1 -1 -1))
             (choice (choose-builder world building (world-bots world) (empty-list) reserve))
             (source (if (null? choice) (waiting-source world building reserve) (builder-source (car choice)))))
        (if (< source 0) (reject-construction world 33)
            (let* ((building (building-source-set building source))
                   (world (world-started-set (pay-kit world source (building-cost kind)) #t))
                   (world (world-next-id-set
                           (world-buildings-set world
                                                (append (world-buildings world) (list building)))
                           (+ (world-next-id world) 1))))
              (make-construction-outcome
               (world-notice-set (if (null? choice) world (reserve-builder world building (car choice))) 10) 0)))))
    (define (automatic-world world kind x y) (queue-building world kind x y 40))
    (define (extract-world world x y) (queue-building world 1 x y 0))
    (define (fortify-world world x y) (queue-building world 2 x y 0))
    (define (observe-world world x y) (queue-building world 3 x y 0))
    ;; Construction requests use absolute map cells. Validate the kind and whole index
    ;; before converting coordinates, then use the ordinary paid placement path.
    (define (place-cell-world world kind cell)
      (construction-world (place-cell-outcome world kind cell)))
    (define (map-cell? cell) (and (>= cell 0) (< cell (* map-width map-height))))
    (define (place-cell-outcome world kind cell)
      (cond ((or (< kind 1) (> kind 3)) (make-construction-outcome world 15))
            ((not (map-cell? cell)) (reject-construction world 15))
            (else (queue-building-outcome world kind (index-x cell) (index-y cell) 0))))

    (define (upgrade-world world x y)
      (cond ((not (world-started world)) (world-notice-set world 38))
            ((hub-cell? world x y) (upgrade-hub-world world))
            (else (let ((found (building-at (world-buildings world) x y)))
                    (if (or (not (active? world)) (null? found)) (world-notice-set world 11)
                        (upgrade-building world (car found)))))))
    (define (upgrade-cost building)
      (cond ((or (tower? building) (= (building-kind building) 2)) 25)
            ((= (building-level building) 1) 40) (else 160)))
    (define (upgrade-building world building)
      (let ((price (upgrade-cost building)))
        (cond ((scavenge-pending? world (building-id building)) (world-notice-set world 41))
              ((or (not (ready? building)) (>= (building-level building) 3) (arming? building) (moving? building))
               (world-notice-set world 11))
              ((and (= (building-kind building) 1) (= (ore-remaining world (building-x building) (building-y building)) 0))
               (world-notice-set world 39))
              ((>= (list-size (world-surveys world)) maximum-surveys) (world-notice-set world 8))
              ((or (tower? building) (= (building-kind building) 2))
               (if (affordable-kit? world price) (queue-upgrade world building) (world-notice-set world 7)))
              ((< (world-credits world) price) (world-notice-set world 7))
              (else (let ((improved (building-hp-set (building-level-set building (+ (building-level building) 1))
                                                     (building-health (building-kind building)))))
                      (world-notice-set (remember-building (put-building (spend world price) improved)
                                                           improved) 12))))))
    ;; ---- Paid worker assembly ----

    (define worker-cost 25)
    (define worker-assembly-ticks 30)
    (define (production-worker? bot)
      (or (= (bot-job bot) 4)
          (and (= (bot-job bot) 6) (> (bot-target bot) 0))
          (and (= (bot-job bot) 7) (= (bot-timer bot) 4))))
    (define (pending-workers bots)
      (if (null? bots) 0 (+ (if (production-worker? (car bots)) 1 0) (pending-workers (cdr bots)))))
    (define base-worker-capacity 12)
    (define maximum-hub-capacity-level 6)
    (define maximum-workers 24)
    (define (worker-capacity world)
      (+ base-worker-capacity (* 2 (world-hub-capacity-level world))))
    (define (assembler-eligible? world bot)
      (and (null? (bot-flight bot)) (= (bot-order bot) 0)
           (or (<= (bot-job bot) 2) (= (bot-job bot) 8) (= (bot-job bot) 9) (= (bot-job bot) 10))))
    (define (prepare-assembler world bot)
      (if (not (assembler-eligible? world bot)) (empty-list)
          (let ((path (route-from world bot (world-hub-x world) (world-hub-y world))))
            (if (reachable? bot (world-hub-x world) (world-hub-y world) path)
                (list (make-builder-choice bot 0 (travel-ticks world bot path) path)) (empty-list)))))
    (define (choose-assembler world bots best)
      (if (null? bots) best
          (choose-assembler world (cdr bots) (best-builder (prepare-assembler world (car bots)) best))))
    (define (fabrication-reason world)
      (cond ((not (active? world)) 9)
            ((not (world-started world)) 38)
            ((>= (+ (list-size (world-bots world)) (pending-workers (world-bots world))) (worker-capacity world)) 8)
            ((< (world-credits world) worker-cost) 7)
            ((null? (choose-assembler world (world-bots world) (empty-list))) 27)
            (else 0)))
    (define (start-assembly world bot)
      (put-bot (credit-delivery world (bot-cargo bot))
               (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 6 (bot-target bot) 0
                         worker-assembly-ticks (empty-list) 14 0 0 (bot-flight bot))))
    (define (accept-fabrication world choice)
      (let* ((bot (builder-worker choice)) (id (world-next-id world))
             (returning (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 4 id (bot-cargo bot) 0
                                  (builder-pickup choice) (bot-hp bot) 0 0 (bot-flight bot)))
             (paid (world-next-id-set (spend world worker-cost) (+ id 1))))
        (world-notice-set (if (at-hub? world bot) (start-assembly paid returning) (put-bot paid returning)) 13)))
    (define (fabricate-world world)
      (let ((reason (fabrication-reason world)))
        (if (= reason 0) (accept-fabrication world (car (choose-assembler world (world-bots world) (empty-list))))
            (world-notice-set world reason))))

    ;; ---- Explicit paid hub repair ----

    ;; Paid material stays at the hub until one worker finishes this order.
    ;; Traveling workers retain ordinary ore; death refunds the unused payment.
    (define repair-ticks 30)
    (define repair-health 2)
    (define (repair-cost world)
      (minimum (world-credits world) (quotient (+ (- 300 (world-hull world)) 1) repair-health)))
    ;; This quote assumes no further damage while the assigned worker travels
    ;; and works. Completion restores the purchased health to the then-current hull.
    (define (repair-target world)
      (minimum 300 (+ (world-hull world) (* repair-health (repair-cost world)))))
    (define (repair-percent world) (quotient (* 100 (repair-target world)) 300))
    (define (repair-worker? bot)
      (or (= (bot-job bot) 12) (= (bot-job bot) 13)
          (and (= (bot-job bot) 7) (= (bot-timer bot) 12))))
    (define (pending-repair? bots)
      (and (not (null? bots)) (or (repair-worker? (car bots)) (pending-repair? (cdr bots)))))
    (define (repair-reason world)
      (cond ((not (active? world)) 9)
            ((not (world-started world)) 38)
            ((>= (world-hull world) 300) 29)
            ((pending-repair? (world-bots world)) 30)
            ((= (world-credits world) 0) 7)
            ((null? (choose-assembler world (world-bots world) (empty-list))) 27)
            (else 0)))
    (define (start-repair world bot)
      (put-bot (credit-delivery world (bot-cargo bot))
               (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 13 (bot-target bot) 0
                         repair-ticks (empty-list) (bot-hp bot) 0 0 (bot-flight bot))))
    (define (accept-repair world choice)
      (let* ((bot (builder-worker choice)) (paid-ore (repair-cost world))
             (returning (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 12 paid-ore (bot-cargo bot) 0
                                  (builder-pickup choice) (bot-hp bot) 0 0 (bot-flight bot)))
             (paid (spend world paid-ore)))
        (world-notice-set (if (at-hub? world bot) (start-repair paid returning) (put-bot paid returning)) 31)))
    (define (repair-world world)
      (let ((reason (repair-reason world)))
        (if (= reason 0) (accept-repair world (car (choose-assembler world (world-bots world) (empty-list))))
            (world-notice-set world reason))))
    (define (repair-hub world bot)
      (if (> (bot-timer bot) 1) (put-bot world (bot-timer-set bot (- (bot-timer bot) 1)))
          (finish-work (world-hull-set world (minimum 300 (+ (world-hull world) (* repair-health (bot-target bot))))) bot)))

    ;; ---- Paid hub capacity expansion ----

    ;; The completed tier is independent of the hub's fixed transport grade.
    ;; One worker owns the paid order; no duplicate pending queue is saved.
    (define hub-upgrade-ticks 30)
    (define (hub-level-cost level) (if (= level 0) 100 (* 2 (hub-level-cost (- level 1)))))
    (define (hub-upgrade-cost world) (hub-level-cost (world-hub-capacity-level world)))
    (define (hub-capacity-investment world) (- (hub-upgrade-cost world) 100))
    (define (hub-upgrade-worker? bot)
      (or (= (bot-job bot) 14) (= (bot-job bot) 15)
          (and (= (bot-job bot) 7) (= (bot-timer bot) 14))))
    (define (pending-hub-upgrade? bots)
      (and (not (null? bots)) (or (hub-upgrade-worker? (car bots)) (pending-hub-upgrade? (cdr bots)))))
    (define (hub-upgrade-reason world)
      (cond ((not (active? world)) 9)
            ((not (world-started world)) 38)
            ((= (world-hub-capacity-level world) maximum-hub-capacity-level) 36)
            ((pending-hub-upgrade? (world-bots world)) 35)
            ((< (world-credits world) (hub-upgrade-cost world)) 7)
            ((null? (choose-assembler world (world-bots world) (empty-list))) 27)
            (else 0)))
    (define (start-hub-upgrade world bot)
      (put-bot (credit-delivery world (bot-cargo bot))
               (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 15 (bot-target bot) 0
                         hub-upgrade-ticks (empty-list) (bot-hp bot) 0 0 (bot-flight bot))))
    (define (accept-hub-upgrade world choice)
      (let* ((bot (builder-worker choice)) (price (hub-upgrade-cost world))
             (returning (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 14 price (bot-cargo bot) 0
                                  (builder-pickup choice) (bot-hp bot) 0 0 (bot-flight bot)))
             (paid (spend world price)))
        (world-notice-set (if (at-hub? world bot) (start-hub-upgrade paid returning) (put-bot paid returning)) 37)))
    (define (upgrade-hub-world world)
      (let ((reason (hub-upgrade-reason world)))
        (if (= reason 0) (accept-hub-upgrade world (car (choose-assembler world (world-bots world) (empty-list))))
            (world-notice-set world reason))))
    (define (assemble-hub-upgrade world bot)
      (if (> (bot-timer bot) 1) (put-bot world (bot-timer-set bot (- (bot-timer bot) 1)))
          (finish-work (world-notice-set
                        (world-hull-set (world-hub-capacity-level-set world (+ (world-hub-capacity-level world) 1)) 300) 12) bot)))

    ;; Focus: 0 manual purchases, 1 explore, 2 defend. Plans are derived
    ;; status codes; they never own ore, workers or a hidden construction queue.
    (define (focus-world world value)
      (if (and (>= value 0) (<= value 2))
          (world-plan-set (world-focus-set world value) 0) world))

    ;; ---- Cancellation and immediate construction commitments ----

    (define (arm-world world x y)
      ;; Retained command identity for old clients; conversions are no longer
      ;; offered because towers and artillery now have separate upgrade trees.
      (world-notice-set world 11))
    (define (queue-upgrade world building)
      (let* ((project (building-source-set (building-stage-set building 4) -1))
             (choice (choose-builder world project (world-bots world) (empty-list) 0))
             (source (if (null? choice) (waiting-source world project 0) (builder-source (car choice)))))
        (if (< source 0) (world-notice-set world 6)
            (let* ((paid (pay-kit world source 25))
                   (current (car (find-building (world-buildings paid) (building-id building))))
                   (project (building-source-set (building-stage-set current 4) source))
                   (paid (put-building paid project)))
              (world-notice-set (if (null? choice) paid (reserve-builder paid project (car choice))) 20)))))
    (define (cancel-world world x y)
      (let ((found (building-at (world-buildings world) x y)))
        (cond ((not (active? world)) (world-notice-set world 9))
              ((and (not (null? found)) (scavenge-pending? world (building-id (car found))))
               (world-notice-set (cancel-scavenge world (world-bots world) (building-id (car found))) 46))
              ((and (not (null? found)) (moving? (car found)))
               (world-notice-set (put-building (refund-spending world 5) (clear-move (car found))) 23))
              ((or (null? found) (= (building-stage (car found)) 2)) (world-notice-set world 19))
              (else (cancel-building world (car found))))))
    (define (release-order bot)
      (let ((free (bot-order-set bot 0)))
        (cond ((or (= (bot-job bot) 11) (= (bot-job bot) 10)) (clear-job free))
              ((and (= (bot-job bot) 7) (= (bot-timer bot) 11)) (bot-timer-set free 2))
              (else free))))
    (define (cancel-worker world bot id)
      (let* ((bot (if (= (bot-order bot) id) (release-order bot) bot))
             (world (put-bot world bot)))
        (if (and (= (bot-target bot) id) (kit-carrier? bot))
            (if (= (bot-cargo bot) 0) (put-bot world (clear-job bot))
                (return-home world (bot-target-set bot 0) 5)) world)))
    (define (cancel-workers world bots id)
      (if (null? bots) world
          (cancel-workers (cancel-worker world (car bots) id) (cdr bots) id)))
    (define (abandon-project world building)
      (if (arming? building)
          (put-building world (building-source-set (building-stage-set building 2) 0))
          (world-rails-set (world-buildings-set world (remove-building (world-buildings world) (building-id building)))
                           (remove-rail (world-rails world) (building-id building)))))
    (define (cancel-building world building)
      (let* ((id (building-id building)) (carried (= (construction-stage building) 1))
             (world (refund-reserved-kit world building))
             (world (cancel-workers world (world-bots world) id))
             (world (abandon-project world (car (find-building (world-buildings world) id))))
             (world (world-focus-set world 0)))
        (world-notice-set world (if carried 18 17))))
    ;; ---- Exclusive construction materials and completion estimates ----

    ;; Source 0 is paid hub ore; a positive ID is local raw ore packed into a
    ;; kit. Reserving removes that ore from the loose buffer immediately. The
    ;; local-spent ledger keeps locally consumed ore out of both hub currency
    ;; and raw stock totals; no purchase can spend both balances for one kit.
    (define (local-supply? world source amount)
      (and (ready? source) (not (moving? source)) (not (scavenge-pending? world (building-id source))) (or (= (building-kind source) 1) (connected-depot? world (building-id source)))
           (>= (building-stock source) amount)))
    (define (local-affordable? world buildings amount)
      (and (not (null? buildings))
           (or (local-supply? world (car buildings) amount) (local-affordable? world (cdr buildings) amount))))
    (define (affordable-kit? world amount)
      (or (>= (world-credits world) amount) (local-affordable? world (world-buildings world) amount)))
    (define (pay-kit world source amount)
      (if (= source 0) (spend world amount)
          (let ((site (car (find-building (world-buildings world) source))))
            (world-local-spent-set
             (world-spent-set (put-building world (building-stock-set site (- (building-stock site) amount)))
                              (+ (world-spent world) amount))
             (+ (world-local-spent world) amount)))))
    (define (refund-reserved-kit world building)
      (let ((source (building-source building)) (amount (uncollected-supplies building)))
        (if (= amount 0) world (if (= source 0) (refund-spending world amount)
                                   (let ((site (car (find-building (world-buildings world) source))))
                                     (world-local-spent-set
                                      (world-spent-set (put-building world (building-stock-set site (+ (building-stock site) amount)))
                                                       (- (world-spent world) amount))
                                      (- (world-local-spent world) amount)))))))
    (define (source-position world source bot)
      (if (= source 0) (idle-bot (world-seed world) (bot-id bot))
          (let ((site (car (find-building (world-buildings world) source))))
            (bot-y-set (bot-x-set (bot-flight-set (clear-job bot) (empty-list)) (cell-x (building-x site))) (cell-y (building-y site))))))
    (define (source-path world bot source)
      (let ((position (source-position world source bot)))
        (route-from world bot (quotient (bot-x position) cell-size) (quotient (bot-y position) cell-size))))
    (define (source-reachable? world bot source path)
      (let ((position (source-position world source bot)))
        (reachable? bot (quotient (bot-x position) cell-size) (quotient (bot-y position) cell-size) path)))
    (define-immutable-record BuilderChoice make-builder-choice
      (worker Bot builder-worker builder-worker-set)
      (source I32 builder-source builder-source-set)
      (ticks I32 builder-ticks builder-ticks-set)
      (pickup (List I32) builder-pickup builder-pickup-set))
    ;; Walking costs 40 work units per pixel; each flight includes four lift /
    ;; landing ticks. The same endpoint rule chooses movement in A* and execution.
    (define (path-work fast x y path)
      (if (null? path) 0
          (let* ((cell (car path)) (a (cell-x (index-x cell))) (b (cell-y (index-y cell)))
                 (here (cell-index (quotient x cell-size) (quotient y cell-size)))
                 (work (if (and (= x (cell-x (index-x here))) (= y (cell-y (index-y here))) (rail-step? fast here cell))
                           (* 320 (flight-duration here cell (quotient 320 (cart-step-cost fast here cell))))
                           (* 40 (distance x y a b)))))
            (+ work (path-work fast a b (cdr path))))))
    (define (remaining-flight-work bot)
      (if (null? (bot-flight bot)) 0
          (let ((flight (car (bot-flight bot))))
            (* 320 (quotient (+ (- (flight-length flight) (flight-progress flight)) (- (flight-speed flight) 1))
                             (flight-speed flight))))))
    (define (travel-ticks world bot path)
      (let* ((cell (landing-cell bot)) (flying (not (null? (bot-flight bot))))
             (work (path-work (fast-rails world (world-rails world))
                              (if flying (cell-x (index-x cell)) (bot-x bot))
                              (if flying (cell-y (index-y cell)) (bot-y bot)) path)))
        (+ 1 (quotient (+ (+ work (remaining-flight-work bot)) 319) 320))))
    (define (committed-builders bots)
      (if (null? bots) 0
          (+ (if (or (> (bot-order (car bots)) 0) (kit-carrier? (car bots))
                     (production-worker? (car bots)) (repair-worker? (car bots))
                     (hub-upgrade-worker? (car bots))) 1 0)
             (committed-builders (cdr bots)))))
    (define (builder-eligible? world bot)
      (and (null? (bot-flight bot)) (= (bot-order bot) 0)
           (< (committed-builders (world-bots world)) (maximum 1 (- (list-size (world-bots world)) 2)))
           (or (<= (bot-job bot) 2) (= (bot-job bot) 8) (= (bot-job bot) 9) (= (bot-job bot) 10))
           (or (not (= (bot-job bot) 2)) (= (bot-target bot) 0) (accepting-depot? world (bot-target bot)))))
    (define (prepare-builder-source world bot building source)
      (let* ((loaded (and (= (bot-job bot) 2) (> (bot-cargo bot) 0)))
             (delivery (if loaded (source-path world bot (bot-target bot)) (empty-list)))
             (origin (if loaded (source-position world (bot-target bot) bot) bot))
             (pickup (source-path world origin source))
             (supply (source-position world source bot))
             (site (route-from world supply (building-x building) (building-y building))))
        (if (and (or (not loaded) (source-reachable? world bot (bot-target bot) delivery))
                 (source-reachable? world origin source pickup)
                 (reachable? supply (building-x building) (building-y building) site))
            (list (make-builder-choice (if loaded (bot-path-set bot delivery) bot) source (+ (if loaded (travel-ticks world bot delivery) 0)
                                                                                             (+ (travel-ticks world origin pickup) (travel-ticks world supply site))) pickup))
            (empty-list))))
    (define (nearer-builder? candidate best)
      (or (null? best) (< (builder-ticks candidate) (builder-ticks (car best)))
          (and (= (builder-ticks candidate) (builder-ticks (car best)))
               (or (< (bot-id (builder-worker candidate)) (bot-id (builder-worker (car best))))
                   (and (= (bot-id (builder-worker candidate)) (bot-id (builder-worker (car best))))
                        (< (builder-source candidate) (builder-source (car best))))))))
    (define (best-builder candidate best)
      (if (and (not (null? candidate)) (nearer-builder? (car candidate) best)) candidate best))
    (define (choose-supply world bot building sources best)
      (if (null? sources) best
          (let ((source (car sources)))
            (choose-supply world bot building (cdr sources)
                           (if (local-supply? world source (construction-cost building))
                               (best-builder (prepare-builder-source world bot building (building-id source)) best) best)))))
    ;; A free extractor needs a worker, not a hub kit. Existing raw cargo must
    ;; reach its chosen depot before that worker travels directly to the site.
    (define (prepare-free-builder world bot building)
      (let* ((loaded (and (= (bot-job bot) 2) (> (bot-cargo bot) 0)))
             (delivery (if loaded (source-path world bot (bot-target bot)) (empty-list)))
             (origin (if loaded (source-position world (bot-target bot) bot) bot))
             (path (route-from world origin (building-x building) (building-y building))))
        (if (and (or (not loaded) (source-reachable? world bot (bot-target bot) delivery))
                 (reachable? origin (building-x building) (building-y building) path))
            (list (make-builder-choice (if loaded (bot-path-set bot delivery) bot) 0
                                       (+ (if loaded (travel-ticks world bot delivery) 0) (travel-ticks world origin path)) path))
            (empty-list))))
    (define (prepare-builder world bot building reserve)
      (cond ((or (not (null? (bot-flight bot))) (construction-hidden? world building)) (empty-list))
            ((and (= (bot-job bot) 3) (= (bot-cargo bot) 25)) (prepare-carrier world bot building reserve))
            ((not (builder-eligible? world bot)) (empty-list))
            ((= (construction-cost building) 0) (prepare-free-builder world bot building))
            ((>= (building-source building) 0) (prepare-builder-source world bot building (building-source building)))
            (else (choose-supply world bot building (world-buildings world)
                                 (if (>= (world-credits world) (+ reserve (construction-cost building)))
                                     (prepare-builder-source world bot building 0) (empty-list))))))
    (define (transferable-supply? world bot building reserve)
      (let ((source (bot-source bot)))
        (and (= (construction-kit-size building) 25) (not (= (bot-target bot) (building-id building)))
             (if (>= (building-source building) 0) (= source (building-source building))
                 (if (= source 0) (>= (world-credits world) (+ reserve (construction-cost building)))
                     (local-affordable-source? world source (construction-cost building)))))))
    (define (local-affordable-source? world source amount)
      (let ((found (find-building (world-buildings world) source)))
        (and (not (null? found)) (local-supply? world (car found) amount))))
    (define (prepare-carrier world bot building reserve)
      (if (not (transferable-supply? world bot building reserve)) (empty-list)
          (let ((path (route-from world bot (building-x building) (building-y building))))
            (if (and (reachable? bot (building-x building) (building-y building) path)
                     (< (travel-ticks world bot path) (travel-ticks world bot (bot-path bot))))
                (list (make-builder-choice bot (bot-source bot) (travel-ticks world bot path) path)) (empty-list)))))
    (define (choose-builder world building bots best reserve)
      (if (null? bots) best
          (choose-builder world building (cdr bots) (best-builder (prepare-builder world (car bots) building reserve) best) reserve)))
    (define (waiting-local-source world building sources)
      (if (null? sources) -1
          (let ((source (car sources)))
            (if (and (local-supply? world source (construction-cost building))
                     (not (null? (prepare-builder-source world (source-position world (building-id source) (idle-bot (world-seed world) 0))
                                                         building (building-id source)))))
                (building-id source) (waiting-local-source world building (cdr sources))))))
    (define (waiting-source world building reserve)
      (if (or (= (construction-cost building) 0) (>= (world-credits world) (+ reserve (construction-cost building)))) 0
          (waiting-local-source world building (world-buildings world))))
    (define (reserve-builder world building choice)
      (if (and (= (construction-cost building) 0) (= (bot-cargo (builder-worker choice)) 0))
          (pickup-order (put-building (put-bot world (bot-order-set (builder-worker choice) (building-id building)))
                                      (construction-stage-set building 3))
                        (bot-order-set (builder-worker choice) (building-id building)))
          (reserve-paid-builder world building choice)))
    (define (reserve-paid-builder world building choice)
      (if (= (bot-job (builder-worker choice)) 3) (redirect-carrier world building choice)
          (let* ((bot (builder-worker choice)) (ordered (bot-order-set bot (building-id building)))
                 (settling (and (= (bot-job bot) 2) (> (bot-cargo bot) 0)))
                 (next (if settling ordered
                           (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 11 (building-source building) 0 0
                                     (builder-pickup choice) (bot-hp bot) (building-id building) 0 (bot-flight bot)))))
            (put-bot (put-building world (construction-stage-set building 3)) next))))
    (define (redirect-carrier world building choice)
      ;; Same-source reservations exchange one generic kit. The physical cargo
      ;; stays on its worker; the old project again owns that quantity at source.
      (let* ((bot (builder-worker choice)) (old (car (find-building (world-buildings world) (bot-target bot))))
             (world (put-building world (construction-stage-set old 0)))
             (world (put-building world (construction-stage-set building 1))))
        (put-bot world (bot-path-set (bot-target-set bot (building-id building)) (builder-pickup choice)))))
    (define (preempt-building world building)
      (let ((choice (choose-builder world building (world-bots world) (empty-list) 0)))
        (if (null? choice) world (reserve-builder world building (car choice)))))
    ;; Oldest open orders commit first. Each chooses the smallest complete ETA,
    ;; with stable worker/source IDs breaking ties. Existing ownership never churns.
    ;; At least two workers remain for the economy when the population permits it.
    (define (dispatch-buildings world buildings)
      (if (null? buildings) world
          (let ((current (find-building (world-buildings world) (building-id (car buildings)))))
            (dispatch-buildings (if (and (not (null? current)) (= (construction-stage (car current)) 0))
                                    (preempt-building world (car current)) world) (cdr buildings)))))
    (define (pending-build? buildings)
      (and (not (null? buildings)) (or (not (= (building-stage (car buildings)) 2)) (pending-build? (cdr buildings)))))
    (define (count-mines buildings)
      (if (null? buildings) 0
          (+ (if (= (building-kind (car buildings)) 1) 1 0) (count-mines (cdr buildings)))))
    (define (safe-site? world x y)
      (let ((bot (idle-bot (world-seed world) 0))) (reachable? bot x y (route-from world bot x y))))

    ;; ---- Reserved track geometry in the serialized world ----

    ;; The renderer uses current Rail paths. The old sorted cell bitmasks own
    ;; no resources and are cleared whenever the transport tree is rebuilt.
    (define (track-cell track) (quotient track 32))
    (define (track-flag? track flag) (= (remainder (quotient track flag) 2) 1))
    (define (track-east? track) (track-flag? track 1))
    (define (track-south? track) (track-flag? track 2))
    (define (track-west? track) (track-flag? track 4))
    (define (track-north? track) (track-flag? track 8))
    (define (track-station? track) (track-flag? track 16))

    ;; ---- Current upstream tree and source-owned depot freight ----

    (define (find-rail rails source)
      (if (null? rails) (empty-list)
          (if (= (rail-source (car rails)) source) (list (car rails)) (find-rail (cdr rails) source))))
    (define (remove-rail rails source)
      (if (null? rails) rails
          (if (= (rail-source (car rails)) source) (cdr rails)
              (cons (car rails) (remove-rail (cdr rails) source)))))
    (define (replace-rail rails value)
      (if (null? rails) rails
          (cons (if (= (rail-source (car rails)) (rail-source value)) value (car rails))
                (replace-rail (cdr rails) value))))
    (define (put-rail world rail) (world-rails-set world (replace-rail (world-rails world) rail)))
    (define (connected-depot? world id)
      (if (= id 0) #t
          (let ((site (find-building (world-buildings world) id)) (rail (find-rail (world-rails world) id)))
            (and (not (null? site)) (ready? (car site)) (tower? (car site)) (not (null? rail))
                 (connected-depot? world (rail-parent (car rail)))))))
    (define (cart-station? world id)
      (if (= id 0) #t
          (let ((site (find-building (world-buildings world) id)))
            (and (not (null? site)) (tower? (car site)) (ready? (car site))
                 (not (moving? (car site)))))))
    (define (station-level world id)
      (if (= id 0) 3 (building-level (car (find-building (world-buildings world) id)))))
    (define (rail-level world rail)
      (minimum (station-level world (rail-source rail)) (station-level world (rail-parent rail))))
    (define (rail-travel-cost world rail)
      (let ((level (rail-level world rail))) (cond ((= level 1) 4) ((= level 2) 2) (else 1))))
    (define (last-transport-cell path)
      (if (null? (cdr path)) (car path) (last-transport-cell (cdr path))))
    (define (fast-rails world rails)
      (if (null? rails) (empty-list)
          (let* ((rail (car rails)) (path (rail-path rail)) (rest (fast-rails world (cdr rails))))
            (if (and (= (list-size path) 2) (cart-station? world (rail-source rail)) (cart-station? world (rail-parent rail)))
                (cons (make-cart-edge (car path) (last-transport-cell path) (rail-travel-cost world rail)) rest) rest))))
    (define (same-integers? a b)
      (if (null? a) (null? b)
          (and (not (null? b)) (= (car a) (car b)) (same-integers? (cdr a) (cdr b)))))

    ;; Heights use thousandths of a cell in simulation and the same values in
    ;; the mesh. Every touched terrain column must be strictly below the cable.
    ;; The conservative peak test includes both cells at exact diagonal corners.
    ;; Today's intact rock peaks are 850; the 900 plane clears them all. Range
    ;; still limits connectivity, and future taller terrain would obstruct it.
    (define flight-height 900)
    (define (world-terrain-height world x y)
      (quotient (* 850 (world-rock-remaining world x y)) rock-health))
    (define (zipline-cell? world x y height)
      (and (inside? x y) (< (world-terrain-height world x y) height)))
    (define (zipline-cells? world x y tx ty sx sy nx ny dx dy height)
      (and (zipline-cell? world x y height)
           (or (and (= x tx) (= y ty))
               (cond ((or (= dx 0) (and (> dy 0) (< (* ny dx) (* nx dy))))
                      (zipline-cells? world x (+ y sy) tx ty sx sy nx (+ ny 2) dx dy height))
                     ((or (= dy 0) (< (* nx dy) (* ny dx)))
                      (zipline-cells? world (+ x sx) y tx ty sx sy (+ nx 2) ny dx dy height))
                     (else (and (zipline-cell? world (+ x sx) y height)
                                (zipline-cell? world x (+ y sy) height)
                                (zipline-cells? world (+ x sx) (+ y sy) tx ty sx sy
                                                (+ nx 2) (+ ny 2) dx dy height)))))))
    (define (clear-zipline? world a b height)
      (let ((x (index-x a)) (y (index-y a)) (tx (index-x b)) (ty (index-y b)))
        (zipline-cells? world x y tx ty (if (< x tx) 1 -1) (if (< y ty) 1 -1) 1 1
                        (distance tx 0 x 0) (distance ty 0 y 0) height)))
    (define (station-radius site)
      (if (= (building-id site) 0) 9 (building-radius site)))
    (define (zipline-link? world source parent)
      (let ((radius (maximum (station-radius source) (station-radius parent))))
        (and (<= (transport-distance source parent) (* radius radius))
             (clear-zipline? world (cell-index (building-x source) (building-y source))
                             (cell-index (building-x parent) (building-y parent)) flight-height))))
    (define (transport-station world id)
      (if (= id 0) (make-building 0 3 (world-hub-x world) (world-hub-y world) 3 1 0 2 0 0 0 0 0 -1 -1)
          (car (find-building (world-buildings world) id))))
    (define (rail-connectable? world rail)
      (zipline-link? world (transport-station world (rail-source rail)) (transport-station world (rail-parent rail))))

    ;; Dense Prim uses squared Euclidean cell distance, not routed terrain cost.
    ;; Its strict (cost, lower endpoint ID, higher endpoint ID) ordering makes
    ;; equal-cost trees stable regardless of building/list insertion order.
    (define-immutable-record TransportChoice make-transport-choice
      (source Building transport-source transport-source-set)
      (parent Building transport-parent transport-parent-set)
      (cost I32 transport-cost transport-cost-set))
    (define (transport-distance source parent)
      (let ((x (- (building-x source) (building-x parent))) (y (- (building-y source) (building-y parent))))
        (+ (* x x) (* y y))))
    (define (transport-choice world source parent)
      (make-transport-choice source parent
                             (if (zipline-link? world source parent) (transport-distance source parent) 2147483647)))
    (define (transport-lower choice) (minimum (building-id (transport-source choice)) (building-id (transport-parent choice))))
    (define (transport-upper choice) (maximum (building-id (transport-source choice)) (building-id (transport-parent choice))))
    (define (transport-before? a b)
      (or (< (transport-cost a) (transport-cost b))
          (and (= (transport-cost a) (transport-cost b))
               (or (< (transport-lower a) (transport-lower b))
                   (and (= (transport-lower a) (transport-lower b)) (< (transport-upper a) (transport-upper b)))))))
    (define (transport-frontier world buildings hub)
      (if (null? buildings) (empty-list)
          (let ((site (car buildings)) (rest (transport-frontier world (cdr buildings) hub)))
            (if (and (tower? site) (ready? site))
                (cons (transport-choice world site hub) rest) rest))))
    (define (cheapest-transport choices best)
      (if (null? choices) best
          (cheapest-transport (cdr choices) (if (transport-before? (car choices) best) (car choices) best))))
    (define (relax-transport world choice parent)
      (let ((candidate (transport-choice world (transport-source choice) parent)))
        (if (transport-before? candidate choice) candidate choice)))
    (define (join-transport world choices parent)
      (if (null? choices) (empty-list)
          (if (= (building-id (transport-source (car choices))) (building-id parent)) (join-transport world (cdr choices) parent)
              (cons (relax-transport world (car choices) parent) (join-transport world (cdr choices) parent)))))
    (define (insert-transport rails rail)
      (if (or (null? rails) (< (rail-source rail) (rail-source (car rails)))) (cons rail rails)
          (cons (car rails) (insert-transport (cdr rails) rail))))
    ;; Adding one previously unjoined tower proves rooted, acyclic ancestry.
    ;; Range rejects distant pairs before the bounded (at most ten-cell) LOS walk.
    (define (span-transport world choices rails)
      (if (null? choices) rails
          (let* ((choice (cheapest-transport (cdr choices) (car choices)))
                 (source (transport-source choice)) (parent (transport-parent choice)))
            (if (= (transport-cost choice) 2147483647) rails
                (span-transport world (join-transport world choices source)
                                (insert-transport rails (make-rail (building-id source) (building-id parent) 0 0 0
                                                                   (list (cell-index (building-x source) (building-y source))
                                                                         (cell-index (building-x parent) (building-y parent))))))))))
    (define (transport-tree world)
      (let ((hub (transport-station world 0)))
        (span-transport world (transport-frontier world (world-buildings world) hub) (empty-list))))
    ;; Lift and lower each consume two captured-speed ticks. Explicit progress
    ;; keeps vertical-only motion serializable; no position guesses a phase.
    (define (flight-length flight)
      (+ (segment-length (flight-origin flight) (flight-destination flight)) (* 4 (flight-speed flight))))
    (define (aerial-coordinate a b progress ramp horizontal)
      (let* ((length (segment-length a b)) (travel (minimum length (maximum 0 (- progress ramp))))
             (start (cell-x (if horizontal (index-x a) (index-y a))))
             (end (cell-x (if horizontal (index-x b) (index-y b)))))
        (+ start (quotient (* (- end start) travel) length))))
    (define (aerial-height length progress ramp)
      (quotient (* flight-height (minimum ramp (minimum progress (- length progress)))) ramp))
    (define (flight-x flight)
      (aerial-coordinate (flight-origin flight) (flight-destination flight) (flight-progress flight) (* 2 (flight-speed flight)) #t))
    (define (flight-y flight)
      (aerial-coordinate (flight-origin flight) (flight-destination flight) (flight-progress flight) (* 2 (flight-speed flight)) #f))
    (define (flight-elevation flight)
      (aerial-height (flight-length flight) (flight-progress flight) (* 2 (flight-speed flight))))
    (define (bot-height bot)
      (if (null? (bot-flight bot)) 0 (flight-elevation (car (bot-flight bot)))))
    (define (landing-cell bot)
      (if (null? (bot-flight bot)) (cell-index (quotient (bot-x bot) cell-size) (quotient (bot-y bot) cell-size))
          (flight-destination (car (bot-flight bot)))))
    (define (rail-length rail)
      (if (= (list-size (rail-path rail)) 2)
          (+ 128 (segment-length (car (rail-path rail)) (car (cdr (rail-path rail)))))
          (* cell-size (- (list-size (rail-path rail)) 1))))
    (define (rail-coordinate path progress horizontal)
      (let ((here (car path)))
        (if (or (null? (cdr path)) (= progress 0))
            (cell-x (if horizontal (index-x here) (index-y here)))
            (if (>= progress cell-size) (rail-coordinate (cdr path) (- progress cell-size) horizontal)
                (let ((a (if horizontal (index-x here) (index-y here)))
                      (b (if horizontal (index-x (car (cdr path))) (index-y (car (cdr path))))))
                  (+ (cell-x a) (* (- b a) progress)))))))
    (define (shuttle-coordinate rail horizontal)
      (let ((path (rail-path rail)))
        (if (= (list-size path) 2) (aerial-coordinate (car path) (car (cdr path)) (rail-progress rail) 64 horizontal)
            (rail-coordinate path (rail-progress rail) horizontal))))
    (define (rail-x rail) (shuttle-coordinate rail #t))
    (define (rail-y rail) (shuttle-coordinate rail #f))
    (define (rail-elevation rail)
      (if (= (list-size (rail-path rail)) 2) (aerial-height (rail-length rail) (rail-progress rail) 64) 0))
    (define (same-transport-edge? a b)
      (and (= (rail-parent a) (rail-parent b)) (same-integers? (rail-path a) (rail-path b))))
    ;; Freight belongs to its source until delivery. Rerouting returns it once
    ;; to that source; destruction of the source loses its stock and cargo.
    ;; This explicit reset needs no detached-cart save variant or stale edge.
    (define (recover-transport-cargo world rail)
      (let ((source (find-building (world-buildings world) (rail-source rail))))
        (if (null? source) (world-lost-ore-set world (+ (world-lost-ore world) (rail-cargo rail)))
            (put-building world (building-stock-set (car source) (+ (building-stock (car source)) (rail-cargo rail)))))))
    (define (settle-transport world previous current)
      (if (null? previous) (world-rails-set (world-tracks-set world (empty-list)) current)
          (let* ((old (car previous)) (found (find-rail current (rail-source old))))
            (if (and (not (null? found)) (same-transport-edge? old (car found)))
                (settle-transport world (cdr previous) (replace-rail current old))
                (settle-transport (recover-transport-cargo world old) (cdr previous) current)))))
    (define (rebuild-transport world)
      (settle-transport world (world-rails world) (transport-tree world)))
    (define (credit-delivery world amount)
      (world-delivered-set (world-credits-set world (+ (world-credits world) amount)) (+ (world-delivered world) amount)))
    (define (unload-rail world rail)
      (let* ((parent (find-building (world-buildings world) (rail-parent rail)))
             (world (if (= (rail-parent rail) 0) (credit-delivery world (rail-cargo rail))
                        (put-building world (building-stock-set (car parent) (+ (building-stock (car parent)) (rail-cargo rail)))))))
        (put-rail world (rail-returning-set (rail-cargo-set rail 0) 1))))
    (define (move-rail world rail)
      (cond ((= (rail-returning rail) 1)
             (let ((moved (rail-progress-set rail (maximum 0 (- (rail-progress rail) (quotient 128 (rail-travel-cost world rail)))))))
               (put-rail world (if (= (rail-progress moved) 0) (rail-returning-set moved 0) moved))))
            ((> (rail-cargo rail) 0)
             (let ((moved (rail-progress-set rail (minimum (rail-length rail) (+ (rail-progress rail) (quotient 128 (rail-travel-cost world rail)))))))
               (if (= (rail-progress moved) (rail-length moved)) (unload-rail world moved) (put-rail world moved))))
            (else world)))
    (define (move-rails world rails)
      (if (null? rails) world (move-rails (move-rail world (car rails)) (cdr rails))))
    (define (load-rail world rail)
      (let ((source (car (find-building (world-buildings world) (rail-source rail)))))
        (if (and (ready? source) (connected-depot? world (rail-source rail))
                 (or (= (rail-parent rail) 0) (accepting-depot? world (rail-parent rail))) (= (rail-progress rail) 0)
                 (= (rail-returning rail) 0) (= (rail-cargo rail) 0) (> (building-stock source) 0))
            (let ((amount (minimum 32 (building-stock source))))
              (put-rail (put-building world (building-stock-set source (- (building-stock source) amount)))
                        (rail-cargo-set rail amount))) world)))
    (define (load-rails world rails)
      (if (null? rails) world (load-rails (load-rail world (car rails)) (cdr rails))))
    ;; New loads never move in the same tick, even if upstream unloading fed them.
    (define (advance-rails world)
      (let ((world (move-rails world (world-rails world)))) (load-rails world (world-rails world))))

    ;; ---- Worker demolition recovers completed investment once ----

    (define scavenge-ticks 20)
    (define (completed-investment building)
      (+ (building-cost (building-kind building))
         (cond ((or (tower? building) (= (building-kind building) 2)) (* 25 (- (building-level building) 1)))
               ((= (building-level building) 1) 0) ((= (building-level building) 2) 40) (else 200))))
    (define (scavenge-refund building) (quotient (completed-investment building) 5))
    (define (scavenge-worker? bot) (or (= (bot-job bot) 16) (= (bot-job bot) 17)))
    (define (scavenge-claims bots id)
      (and (not (null? bots))
           (or (and (scavenge-worker? (car bots)) (= (bot-target (car bots)) id))
               (scavenge-claims (cdr bots) id))))
    (define (scavenge-pending? world id) (scavenge-claims (world-bots world) id))
    (define (prepare-scavenger world bot building)
      (if (not (and (assembler-eligible? world bot) (= (bot-cargo bot) 0))) (empty-list)
          (let ((path (route-from world bot (building-x building) (building-y building))))
            (if (reachable? bot (building-x building) (building-y building) path)
                (list (make-builder-choice bot 0 (travel-ticks world bot path) path)) (empty-list)))))
    (define (choose-scavenger world building bots best)
      (if (null? bots) best
          (choose-scavenger world building (cdr bots)
                            (best-builder (prepare-scavenger world (car bots) building) best))))
    (define (scavenge-reason world building)
      (cond ((not (active? world)) 9)
            ((not (world-started world)) 38)
            ((scavenge-pending? world (building-id building)) 41)
            ((or (not (ready? building)) (arming? building) (moving? building)) 40)
            ((> (reserved-stock (world-buildings world) (building-id building)) 0) 43)
            ((null? (choose-scavenger world building (world-bots world) (empty-list))) 42)
            (else 0)))
    (define (scavenge-world world x y)
      (let ((found (building-at (world-buildings world) x y)))
        (if (null? found) (world-notice-set world 40)
            (let* ((building (car found)) (reason (scavenge-reason world building)))
              (if (not (= reason 0)) (world-notice-set world reason)
                  (let* ((choice (car (choose-scavenger world building (world-bots world) (empty-list))))
                         (bot (builder-worker choice)))
                    (world-notice-set (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 16 (building-id building)
                                                               0 0 (builder-pickup choice) (bot-hp bot) 0 0 (empty-list))) 44)))))))
    (define (cancel-scavenge world bots id)
      (if (null? bots) world
          (let ((bot (car bots)))
            (cancel-scavenge (if (and (scavenge-worker? bot) (= (bot-target bot) id))
                                 (put-bot world (clear-job bot)) world) (cdr bots) id))))
    (define (recover-scavenged-stock world building)
      (let* ((id (building-id building)) (found (find-rail (world-rails world) id))
             (cargo (if (null? found) 0 (rail-cargo (car found))))
             (world (credit-delivery world (+ (raw-stock building) cargo))))
        ;; Remove the source-owned shuttle before rebuilding; its cargo has
        ;; already been recovered. Other sources keep their ordinary reroute rule.
        (world-rails-set (world-buildings-set world (remove-building (world-buildings world) id))
                         (remove-rail (world-rails world) id))))
    (define (complete-scavenge world bot building)
      (let* ((world (recover-scavenged-stock world building))
             (world (refund-spending world (scavenge-refund building)))
             (world (put-bot world (clear-job bot))))
        (world-notice-set (rebuild-transport world) 45)))
    (define (dismantle-building world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (cond ((null? found) (put-bot world (clear-job bot)))
              ((> (bot-timer bot) 1) (put-bot world (bot-timer-set bot (- (bot-timer bot) 1))))
              (else (complete-scavenge world bot (car found))))))

    ;; ---- Short relocations drain existing ownership before moving ----

    (define (moving? building) (>= (building-move-x building) 0))
    (define (pending-move? buildings)
      (and (not (null? buildings)) (or (moving? (car buildings)) (pending-move? (cdr buildings)))))
    (define (pending-move-count buildings)
      (if (null? buildings) 0
          (+ (if (moving? (car buildings)) 1 0) (pending-move-count (cdr buildings)))))
    (define (clear-move building) (building-move-y-set (building-move-x-set building -1) -1))
    (define (accepting-depot? world id)
      (let ((found (find-building (world-buildings world) id)))
        (and (not (null? found)) (not (moving? (car found))) (connected-depot? world id))))
    (define (reserved-stock buildings source)
      (if (null? buildings) 0
          (+ (if (and (= (building-source (car buildings)) source) (not (= (building-stage (car buildings)) 2)))
                 (uncollected-supplies (car buildings)) 0)
             (reserved-stock (cdr buildings) source))))
    (define (incident-rail? rail id) (or (= (rail-source rail) id) (= (rail-parent rail) id)))
    (define (incident-empty? rails id)
      (or (null? rails) (and (or (not (incident-rail? (car rails) id)) (= (rail-cargo (car rails)) 0))
                             (incident-empty? (cdr rails) id))))
    ;; A moving parent drains existing child arrivals, then moves even if the
    ;; child still has loose stock. Waiting for that blocked stock would deadlock
    ;; a chain of moving towers; only this site's incident cargo must be empty.
    (define (move-drained? world building)
      (and (= (workers-at (world-bots world) 2 (building-id building)) 0)
           (= (building-stock building) 0) (= (reserved-stock (world-buildings world) (building-id building)) 0)
           (incident-empty? (world-rails world) (building-id building))))
    (define (move-position building x y)
      (clear-move (building-y-set (building-x-set building x) y)))
    (define (move-candidate world building x y)
      (let* ((world (put-building world (move-position building x y)))
             (candidate (rebuild-transport world)))
        (if (or (not (tower? building)) (connected-depot? candidate (building-id building)))
            (list candidate) (empty-list))))
    (define (move-reason world building x y)
      (cond ((not (world-started world)) 38)
            ((scavenge-pending? world (building-id building)) 41)
            ((or (not (active? world)) (not (ready? building)) (arming? building)
                 (= (building-kind building) 1) (moving? building)) 24)
            ((or (= (distance x y (building-x building) (building-y building)) 0)
                 (> (distance x y (building-x building) (building-y building)) 2)) 25)
            ((not (visible? world x y)) 1)
            ((not (world-ground? world x y)) 2)
            ((or (hub-cell? world x y)
                 (living-nest? world x y)
                 (not (null? (building-at (world-buildings world) x y)))
                 (reserved-move-cell? (world-buildings world) x y)) 3)
            ((> (world-deposit-rate world x y) 0) 5)
            ((< (world-credits world) 5) 7)
            ((>= (+ (list-size (world-surveys world)) (pending-move-count (world-buildings world))) maximum-surveys) 8)
            ((or (not (safe-site? world x y)) (null? (move-candidate world building x y))) 6)
            (else 0)))
    (define (reserved-move-cell? buildings x y)
      (and (not (null? buildings))
           (or (and (= (building-move-x (car buildings)) x) (= (building-move-y (car buildings)) y))
               (reserved-move-cell? (cdr buildings) x y))))
    (define (move-world world x y a b)
      (let ((found (building-at (world-buildings world) x y)))
        (if (null? found) (world-notice-set world 24)
            (let* ((building (car found)) (reason (move-reason world building a b)))
              (if (not (= reason 0)) (world-notice-set world reason)
                  (world-notice-set (put-building (spend world 5)
                                                  (building-move-y-set (building-move-x-set building a) b)) 21))))))
    (define (advance-move world building)
      (if (not (and (moving? building) (move-drained? world building))) world
          (let ((candidate (if (hub-cell? world (building-move-x building) (building-move-y building)) (empty-list)
                               (move-candidate world building (building-move-x building) (building-move-y building)))))
            (if (null? candidate) (world-notice-set (put-building (refund-spending world 5) (clear-move building)) 26)
                (let* ((world (car candidate)) (moved (car (find-building (world-buildings world) (building-id building)))))
                  (world-notice-set (remember-building world moved) 22))))))
    (define (advance-moves world buildings)
      (if (null? buildings) world
          (advance-moves (advance-move world (car buildings)) (cdr buildings))))

    ;; ---- Occupied mining slots and physical task assignments ----

    (define (workers-at bots job target)
      (if (null? bots) 0
          (+ (if (and (= (bot-job (car bots)) job) (= (bot-target (car bots)) target)) 1 0)
             (workers-at (cdr bots) job target))))
    (define (mining-amount world building)
      (if (not (and (ready? building) (= (building-kind building) 1))) 0
          (let* ((x (building-x building)) (y (building-y building))
                 (room (- (- 120 (reserved-stock (world-buildings world) (building-id building))) (building-stock building)))
                 (yield (* (world-deposit-rate world x y) (workers-at (world-bots world) 8 (building-id building)))))
            (minimum (ore-remaining world x y) (minimum (maximum 0 room) yield)))))
    ;; All occupied slots share one atomic withdrawal. Clipping the aggregate
    ;; prevents two miners from claiming the last units, even on an upgrade tick.
    (define (produce-building world building)
      (let ((amount (mining-amount world building)))
        (if (= amount 0) world
            (world-produced-set
             (world-deposits-set (put-building world (building-stock-set building (+ (building-stock building) amount)))
                                 (withdraw-deposit (world-deposits world) (cell-index (building-x building) (building-y building)) amount))
             (+ (world-produced world) amount)))))
    (define (produce-buildings world buildings)
      (if (null? buildings) world (produce-buildings (produce-building world (car buildings)) (cdr buildings))))
    ;; One productive mine keeps a construction cache once initial income has
    ;; arrived. This is loose, spendable material, not a paid reservation. The
    ;; other buffers and all tower freight continue normal hauling; a low hub
    ;; balance releases the cache so rebuilding the workforce remains possible.
    (define (best-cache world buildings best)
      (if (null? buildings) best
          (let ((site (car buildings)))
            (best-cache world (cdr buildings)
                        (if (and (ready? site) (= (building-kind site) 1)
                                 (> (ore-remaining world (building-x site) (building-y site)) 0)
                                 (or (null? best) (> (world-deposit-rate world (building-x site) (building-y site))
                                                     (world-deposit-rate world (building-x (car best)) (building-y (car best))))))
                            (list site) best)))))
    (define (construction-cache world)
      (let ((mine (best-cache world (world-buildings world) (empty-list))))
        (if (or (null? mine) (< (list-size (world-bots world)) 3)
                (< (world-delivered world) 16) (< (world-credits world) 40)) 0
                (building-id (car mine)))))
    (define (haulable-stock world mine)
      (maximum 0 (- (building-stock mine) (if (= (building-id mine) (construction-cache world)) 50 0))))
    (define (mine-backlog world building)
      (- (haulable-stock world building) (* 16 (workers-at (world-bots world) 1 (building-id building)))))
    (define (hauler? bot) (or (<= (bot-job bot) 2) (= (bot-job bot) 10)))
    (define (another-hauler? bots id)
      (and (not (null? bots))
           (or (and (not (= (bot-id (car bots)) id)) (hauler? (car bots)))
               (another-hauler? (cdr bots) id))))
    (define (has-miner? bots)
      (and (not (null? bots))
           (or (= (bot-job (car bots)) 8) (= (bot-job (car bots)) 9) (has-miner? (cdr bots)))))
    (define (can-staff? world bot)
      (or (not (has-miner? (world-bots world))) (another-hauler? (world-bots world) (bot-id bot))))
    (define (at-hub? world bot)
      (and (= (bot-x bot) (cell-x (world-hub-x world))) (= (bot-y bot) (cell-y (world-hub-y world)))))
    (define (sheltered? world bot) (and (null? (bot-flight bot)) (> (world-hull world) 0) (at-hub? world bot)))
    ;; Terrain, visibility and current links determine worker routes. Enemies
    ;; do not block work; empty means already there or physically unreachable.
    (define (route-from world bot a b)
      (let* ((start (landing-cell bot)) (x (index-x start)) (y (index-y start))
             (path (cart-path (world-seed world) (world-breaches world) (fast-rails world (world-rails world)) x y a b (world-surveys world)
                              (empty-list))))
        (if (and (null? path) (not (and (= x a) (= y b)))) path
            (if (or (not (null? (bot-flight bot)))
                    (and (= (bot-x bot) (cell-x x)) (= (bot-y bot) (cell-y y)))) path
                    (cons (cell-index x y) path)))))
    (define (at-cell? bot x y)
      (and (= (bot-x bot) (cell-x x)) (= (bot-y bot) (cell-y y))))
    (define (reachable? bot x y path)
      (or (not (null? path))
          (if (null? (bot-flight bot)) (at-cell? bot x y) (= (landing-cell bot) (cell-index x y)))))
    ;; Once construction has claimed workers, remaining workers choose reachable
    ;; mining and collection work. Incoming assignments reserve slots and loads.
    (define-immutable-record Assignment make-assignment
      (job I32 assignment-job assignment-job-set)
      (target I32 assignment-target assignment-target-set)
      (cargo I32 assignment-cargo assignment-cargo-set)
      (distance I32 assignment-distance assignment-distance-set)
      (path (List I32) assignment-path assignment-path-set))
    (define (prepare-assignment world bot job target x y)
      (let ((path (route-from world bot x y)))
        (if (reachable? bot x y path)
            (list (make-assignment job target 0 (travel-ticks world bot path) path)) (empty-list))))
    (define (choose-nearer candidate best)
      (if (and (not (null? candidate))
               (or (null? best) (< (assignment-distance (car candidate)) (assignment-distance (car best))))) candidate best))
    (define (mine-choice world bot mine)
      (let* ((id (building-id mine))
             (slots (+ (workers-at (world-bots world) 8 id) (workers-at (world-bots world) 9 id)))
             (available (and (> (ore-remaining world (building-x mine) (building-y mine)) 0)
                             (< slots (building-level mine)) (can-staff? world bot))))
        (cond ((and available (< (building-stock mine) 16))
               (prepare-assignment world bot 9 id (building-x mine) (building-y mine)))
              ((> (mine-backlog world mine) 0)
               (prepare-assignment world bot 1 id (building-x mine) (building-y mine)))
              ((and available (< (building-stock mine) 120))
               (prepare-assignment world bot 9 id (building-x mine) (building-y mine)))
              (else (empty-list)))))
    (define (choose-work world bot buildings best)
      (if (null? buildings) best
          (let ((mine (car buildings)))
            (choose-work world bot (cdr buildings)
                         (if (and (ready? mine) (= (building-kind mine) 1))
                             (choose-nearer (mine-choice world bot mine) best) best)))))
    (define (install-assignment world bot assignment)
      (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) (assignment-job assignment)
                               (assignment-target assignment) 0 0 (assignment-path assignment) (bot-hp bot) 0 0 (bot-flight bot))))
    (define (pickup-order world bot)
      (let ((found (find-building (world-buildings world) (bot-order bot))))
        (cond ((null? found) (put-bot world (release-order bot)))
              ((construction-hidden? world (car found)) (suspend-construction world (car found) bot))
              (else (let* ((building (car found))
                           (path (route-from world bot (building-x building) (building-y building))))
                      (if (not (reachable? bot (building-x building) (building-y building) path))
                          (put-bot world (bot-job-set (clear-job bot) 10))
                          (put-bot (put-building world (construction-stage-set building 1))
                                   (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 3 (building-id building)
                                             (construction-kit-size building) 0 path (bot-hp bot) 0 (building-source building) (bot-flight bot)))))))))
    ;; An unseen site retains its paid supplies, but releases an unladen worker
    ;; for useful work. A carrier already on the remembered route brings vision
    ;; with it and can finish once its own circle reaches the site.
    (define (suspend-construction world building bot)
      (put-bot (put-building world (construction-stage-set building 0)) (release-order bot)))
    (define (reserved-work world bot)
      (let* ((building (car (find-building (world-buildings world) (bot-order bot))))
             (source (building-source building)) (path (source-path world bot source)))
        (cond ((construction-hidden? world building) (suspend-construction world building bot))
              ((= (construction-cost building) 0) (pickup-order world bot))
              ((not (source-reachable? world bot source path))
               (put-bot world (bot-job-set (clear-job bot) 10)))
              (else (if (null? path) (pickup-order world bot)
                        (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 11 source 0 0 path
                                                 (bot-hp bot) (bot-order bot) 0 (bot-flight bot))))))))
    (define (assign-work world bot)
      (if (> (bot-order bot) 0) (reserved-work world bot)
          (let ((choice (choose-work world bot (world-buildings world) (empty-list))))
            (if (null? choice)
                (put-bot world (bot-job-set bot 0))
                (install-assignment world bot (car choice))))))

    ;; ---- Worker travel and physical delivery ----

    (define (approach value target speed)
      (if (< value target) (+ value (minimum speed (- target value)))
          (- value (minimum speed (- value target)))))
    (define (bot-riding? world bot) (not (null? (bot-flight bot))))
    (define (advance-flight bot)
      (let* ((old (car (bot-flight bot)))
             (flight (flight-progress-set old (minimum (flight-length old) (+ (flight-progress old) (flight-speed old)))))
             (moved (bot-y-set (bot-x-set bot (flight-x flight)) (flight-y flight))))
        (bot-flight-set moved (if (= (flight-progress flight) (flight-length flight)) (empty-list) (list flight)))))
    (define (board-flight bot fast next)
      (let* ((origin (landing-cell bot)) (speed (quotient 320 (cart-step-cost fast origin next)))
             (flight (make-flight origin next 0 speed)))
        (advance-flight (bot-flight-set (bot-path-set bot (cdr (bot-path bot))) (list flight)))))
    (define (ground-step bot next)
      (let* ((x (cell-x (index-x next))) (y (cell-y (index-y next)))
             (moved (if (= (bot-x bot) x) (bot-y-set bot (approach (bot-y bot) y 8))
                        (bot-x-set bot (approach (bot-x bot) x 8)))))
        (if (at-cell? moved (index-x next) (index-y next)) (bot-path-set moved (cdr (bot-path bot))) moved)))
    ;; A saved waypoint is a plan, never permission to fly. A lost next link
    ;; replans to the same final goal; failure preserves owned cargo while waiting for physical access.
    (define (replan-bot world bot)
      (let* ((goal (last-transport-cell (bot-path bot)))
             (path (route-from world bot (index-x goal) (index-y goal))))
        (if (reachable? bot (index-x goal) (index-y goal) path)
            (put-bot world (bot-path-set bot path)) (interrupt-bot world bot))))
    ;; Four staggered five-tick windows reconsider walking plans after new links
    ;; or upgrades. A cell takes five walking ticks, so every grounded traveler
    ;; gets a chance within twenty ticks. Flights and blocked returns keep their routes.
    (define (route-refresh-due? world bot)
      (let ((cell (landing-cell bot)))
        (and (not (= (bot-job bot) 7))
             (= (remainder (+ (quotient (world-tick world) 5) (bot-id bot)) 4) 0)
             (at-cell? bot (index-x cell) (index-y cell)))))
    (define (refresh-walking-route world bot fast)
      (if (or (null? fast) (not (route-refresh-due? world bot))) bot
          (let* ((goal (last-transport-cell (bot-path bot)))
                 (path (route-from world bot (index-x goal) (index-y goal))))
            (if (and (not (null? path))
                     (< (path-work fast (bot-x bot) (bot-y bot) path)
                        (path-work fast (bot-x bot) (bot-y bot) (bot-path bot))))
                (bot-path-set bot path) bot))))
    (define (walk-bot world bot)
      (let* ((fast (fast-rails world (world-rails world))) (bot (refresh-walking-route world bot fast))
             (next (car (bot-path bot))) (here (landing-cell bot)))
        (cond ((and (at-cell? bot (index-x here) (index-y here)) (rail-step? fast here next))
               (put-bot world (board-flight bot fast next)))
              ((and (<= (distance (index-x here) (index-y here) (index-x next) (index-y next)) 1)
                    (world-ground? world (index-x next) (index-y next)))
               (put-bot world (ground-step bot next)))
              (else (replan-bot world bot)))))
    (define (clear-job bot)
      (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 0 0 0 0 (empty-list) (bot-hp bot) (bot-order bot) 0 (bot-flight bot)))
    (define (return-home world bot job)
      (let* ((path (route-from world bot (world-hub-x world) (world-hub-y world)))
             (returning (reachable? bot (world-hub-x world) (world-hub-y world) path)))
        ;; Preserve the owned job while physical access is unavailable.
        (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot)
                                 (if returning job 7)
                                 (if (= job 2) 0 (bot-target bot)) (bot-cargo bot)
                                 (if returning 0 job) path (bot-hp bot) (bot-order bot) (bot-source bot) (bot-flight bot)))))
    ;; Legacy retreats discard their escape waypoints and resume owned work.
    ;; A captured flight finishes first; its landing cell is still authoritative.
    (define (resume-return world bot)
      (cond ((= (bot-timer bot) 11) (reserved-work world (bot-path-set bot (empty-list))))
            ((sheltered? world bot) (arrive-bot world (bot-job-set (bot-timer-set bot 0) (bot-timer bot))))
            ((= (bot-timer bot) 2) (return-ore world (bot-path-set bot (empty-list))))
            (else (return-home world bot (bot-timer bot)))))
    (define (interrupt-bot world bot)
      (let ((job (if (or (= (bot-job bot) 3) (= (bot-job bot) 5)) 5
                     (if (or (= (bot-job bot) 4) (= (bot-job bot) 12) (= (bot-job bot) 14)) (bot-job bot)
                         (if (= (bot-job bot) 11) 11 (if (= (bot-job bot) 7) (bot-timer bot) 2))))))
        (resume-return world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 7 (bot-target bot)
                                       (bot-cargo bot) job (empty-list) (bot-hp bot) (bot-order bot) (bot-source bot) (bot-flight bot)))))
    (define (drop-choice world bot id x y best)
      (let ((path (route-from world bot x y)))
        (if (and (reachable? bot x y path)
                 (or (null? best) (< (travel-ticks world bot path) (assignment-distance (car best)))))
            (list (make-assignment 2 id (bot-cargo bot) (travel-ticks world bot path) path)) best)))
    (define (choose-depot world bot buildings best)
      (if (null? buildings) best
          (let ((building (car buildings)))
            (choose-depot world bot (cdr buildings)
                          (if (accepting-depot? world (building-id building))
                              (drop-choice world bot (building-id building) (building-x building) (building-y building) best) best)))))
    (define (return-ore world bot)
      (let ((choice (choose-depot world bot (world-buildings world) (drop-choice world bot 0 (world-hub-x world) (world-hub-y world) (empty-list)))))
        (if (null? choice) (return-home world (bot-target-set bot 0) 2)
            (let ((destination (car choice)))
              (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 2 (assignment-target destination)
                                       (bot-cargo bot) 0 (assignment-path destination) (bot-hp bot) (bot-order bot) 0 (bot-flight bot)))))))
    (define (collect-ore world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) (put-bot world (clear-job bot))
            (let* ((mine (car found)) (cargo (minimum 16 (haulable-stock world mine))))
              (return-ore (put-building world (building-stock-set mine (- (building-stock mine) cargo)))
                          (bot-cargo-set bot cargo))))))
    (define (deliver-ore world bot)
      (if (at-hub? world bot) (finish-work (credit-delivery world (bot-cargo bot)) (bot-hp-set bot 14))
          (let ((found (find-building (world-buildings world) (bot-target bot))))
            (if (or (null? found) (not (accepting-depot? world (bot-target bot)))) (return-ore world bot)
                (finish-work (put-building world (building-stock-set (car found) (+ (building-stock (car found)) (bot-cargo bot)))) bot)))))
    (define (finish-work world bot)
      (let ((free (clear-job bot))) (assign-work (put-bot world free) free)))
    (define (incorporate-kit site cargo complete)
      (if (arming? site)
          (building-level-set site (+ (building-level site) 1))
          (building-armed-set (building-stock-set site (if complete 0 (+ (building-stock site) cargo)))
                              (if (and complete (tower? site) (= (building-level site) 2)) 1 0))))
    (define (complete-building world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) (put-bot world (clear-job bot))
            (let* ((site (car found)) (complete (or (arming? site) (= (+ (building-stock site) (bot-cargo bot)) (construction-cost site))))
                   (site (incorporate-kit site (bot-cargo bot) complete))
                   (site (if (and complete (arming? site)) (building-hp-set site (building-health (building-kind site))) site))
                   (site (if complete (building-source-set (building-stage-set site 2) 0) (construction-stage-set site 0)))
                   (world (put-building world site)))
              (finish-work (if complete (remember-building world site) world) bot)))))
    (define (hub-kit world bot)
      ;; A local paid kit returned to hub becomes hub-backed without adding
      ;; spendable ore. Its original local consumption becomes a real delivery.
      (if (= (bot-source bot) 0) world
          (world-delivered-set (world-local-spent-set world (- (world-local-spent world) (bot-cargo bot)))
                               (+ (world-delivered world) (bot-cargo bot)))))
    (define (return-kit world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (and (not (null? found)) (> (building-source (car found)) 0) (> (uncollected-supplies (car found)) 0))
            (return-local-kit world bot (car found))
            (let ((world (hub-kit world bot)))
              (finish-work (if (null? found) (refund-spending world (bot-cargo bot))
                               (put-building world (building-source-set (construction-stage-set (car found) 0) 0)))
                           (bot-hp-set bot 14))))))
    (define (return-local-kit world bot building)
      ;; A two-kit local project still owns its other kit at that source. Keep
      ;; their provenance together by physically returning this kit there too.
      (let* ((source (building-source building)) (path (source-path world bot source)))
        (cond ((not (source-reachable? world bot source path)) (put-bot world (bot-path-set bot (empty-list))))
              ((null? path) (finish-work (put-building world (construction-stage-set building 0)) bot))
              (else (put-bot world (bot-path-set bot path))))))
    (define (arrive-bot world bot)
      (cond ((= (bot-job bot) 1) (collect-ore world bot))
            ((= (bot-job bot) 2) (deliver-ore world bot))
            ((= (bot-job bot) 3) (complete-building world bot))
            ((= (bot-job bot) 4) (start-assembly world bot))
            ((= (bot-job bot) 5) (return-kit world bot))
            ((= (bot-job bot) 9) (put-bot world (bot-job-set bot 8)))
            ((= (bot-job bot) 11) (reserved-work world bot))
            ((= (bot-job bot) 12) (start-repair world bot))
            ((= (bot-job bot) 14) (start-hub-upgrade world bot))
            ((= (bot-job bot) 16) (put-bot world (bot-timer-set (bot-job-set bot 17) scavenge-ticks)))
            (else world)))
    (define (mine-bot world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) (put-bot world (clear-job bot))
            (let ((site (car found)))
              (cond ((= (ore-remaining world (building-x site) (building-y site)) 0)
                     (if (> (haulable-stock world site) 0) (collect-ore world bot) (finish-work world bot)))
                    ((and (>= (haulable-stock world site) 16) (not (another-hauler? (world-bots world) (bot-id bot))))
                     (collect-ore world bot))
                    (else world))))))
    (define (outward-missing? world bot)
      (and (or (= (bot-job bot) 1) (= (bot-job bot) 8) (= (bot-job bot) 9))
           (let ((found (find-building (world-buildings world) (bot-target bot))))
             (or (null? found)
                 (and (= (bot-job bot) 9) (= (ore-remaining world (building-x (car found)) (building-y (car found))) 0))))))
    (define (complete-worker world bot)
      (let ((world (world-bots-set world (append (world-bots world) (list (idle-bot (world-seed world) (bot-target bot)))))))
        (finish-work world (clear-job bot))))
    (define (assemble-worker world bot)
      (cond ((> (bot-timer bot) 1) (put-bot world (bot-timer-set bot (- (bot-timer bot) 1))))
            ((= (bot-target bot) 0) (finish-work world (clear-job bot)))
            (else (complete-worker world bot))))
    (define (advance-bot world bot)
      (let ((bot (if (sheltered? world bot) (bot-hp-set bot 14) bot)))
        (cond ((not (null? (bot-flight bot))) (put-bot world (advance-flight bot)))
              ((= (bot-job bot) 6) (assemble-worker world bot))
              ((= (bot-job bot) 13) (repair-hub world bot))
              ((= (bot-job bot) 15) (assemble-hub-upgrade world bot))
              ((= (bot-job bot) 7) (resume-return world bot))
              ((and (scavenge-worker? bot) (null? (find-building (world-buildings world) (bot-target bot))))
               (world-notice-set (put-bot world (clear-job bot)) 46))
              ((= (bot-job bot) 17) (dismantle-building world bot))
              ((outward-missing? world bot) (put-bot world (clear-job bot)))
              ((and (= (bot-job bot) 2) (> (bot-target bot) 0)
                    (not (accepting-depot? world (bot-target bot)))) (return-ore world bot))
              ((or (= (bot-job bot) 0) (= (bot-job bot) 10)) (assign-work world bot))
              ((= (bot-job bot) 8) (mine-bot world bot))
              ((not (null? (bot-path bot))) (walk-bot world bot))
              (else (arrive-bot world bot)))))
    (define (advance-bots world bots)
      (if (null? bots) world (advance-bots (advance-bot world (car bots)) (cdr bots))))

    ;; ---- Independent fronts send escalating attacks until destroyed ----

    ;; A ten-minute expedition gets forty-five seconds to build before waves
    ;; every thirty seconds. Ranks rise every ninety seconds; the first boss
    ;; pressures the approach at nine minutes. Destroying all three nests wins.
    (define simulation-ticks-per-second 10)
    (define wave-interval (* 30 simulation-ticks-per-second))
    (define first-wave-tick (+ wave-interval (quotient wave-interval 2)))
    (define difficulty-step-ticks (* 3 wave-interval))
    (define first-raid-tick (+ first-wave-tick difficulty-step-ticks))
    (define raid-interval difficulty-step-ticks)
    (define final-siege-tick (* 6 difficulty-step-ticks))
    ;; This serialization bound is over six years of continuous simulation.
    ;; It never declares a timed victory; only destroying the nest wins.
    (define run-end-tick 2147480000)
    (define maximum-enemies 128)
    ;; This computed domain interval is the only source of difficulty timing.
    ;; Zero end means the final tier, with no further increase scheduled.
    (define-immutable-record DifficultyWindow make-difficulty-window
      (tier I32 difficulty-tier difficulty-tier-set)
      (start I32 difficulty-start difficulty-start-set)
      (end I32 difficulty-end difficulty-end-set))
    (define (difficulty-window-for tick interval)
      (unless (and (>= tick 0) (<= tick run-end-tick) (> interval 0)
                   (<= interval (quotient run-end-tick 41)))
        (unreachable))
      (let ((tier (minimum 40 (quotient tick interval))))
        (make-difficulty-window tier (* tier interval) (if (= tier 40) 0 (* (+ tier 1) interval)))))
    (define (difficulty-window tick) (difficulty-window-for tick difficulty-step-ticks))
    ;; Every cleared front subtracts two 90-second strength tiers. The saved
    ;; nest health is the receipt; loading or firing again cannot award it twice.
    ;; Cap the uncredited clock first so even a clear at the final tier matters.
    ;; Existing enemies keep their spawn rank/max health; wave cadence stays real.
    (define (nest-threat-credit world)
      (* (* 2 difficulty-step-ticks) (- 3 (living-nests (world-nests world)))))
    (define (world-threat-tick world)
      (maximum 0 (- (minimum (world-tick world) (* 40 difficulty-step-ticks)) (nest-threat-credit world))))
    (define (world-difficulty-window world)
      (let* ((credit (nest-threat-credit world)) (window (difficulty-window (world-threat-tick world)))
             (start (if (= (difficulty-tier window) 0) 0 (+ credit (difficulty-start window))))
             (end (if (>= (world-tick world) (* 40 difficulty-step-ticks)) 0 (+ credit (difficulty-end window)))))
        (make-difficulty-window (difficulty-tier window) start end)))
    (define (threat-tier tick) (difficulty-tier (difficulty-window tick)))
    (define (maximum-enemy-rank tick) (minimum 6 (threat-tier tick)))
    (define maximum-enemy-health 2310)
    (define (enemy-rank-health rank)
      (cond ((= rank 0) 65) ((= rank 1) 90) ((= rank 2) 125) ((= rank 3) 180)
            ((= rank 4) 300) ((= rank 5) 500) (else 1800)))
    (define (enemy-rank-damage rank)
      (cond ((= rank 0) 7) ((= rank 1) 8) ((= rank 2) 10) ((= rank 3) 12)
            ((= rank 4) 16) ((= rank 5) 20) (else 30)))
    (define (heavy-wave? tick) (and (>= tick final-siege-tick) (= (remainder tick final-siege-tick) 0)))
    (define (raid-wave? tick) (and (>= tick first-raid-tick) (= (remainder (- tick first-raid-tick) raid-interval) 0)))
    (define (regular-wave? tick)
      (and (>= tick first-wave-tick)
           (= (remainder (- tick first-wave-tick) wave-interval) 0)))
    (define (attack-kind tick)
      (cond ((heavy-wave? tick) 2) ((raid-wave? tick) 1) (else 0)))
    (define (attack-size tick)
      (cond ((heavy-wave? tick) (+ 9 (minimum 17 (quotient (- tick final-siege-tick) final-siege-tick))))
            ((raid-wave? tick) (+ 7 (minimum 19 (quotient (- tick first-raid-tick) raid-interval))))
            ((regular-wave? tick) (+ 6 (minimum 20 (quotient (- tick first-wave-tick) (* 3 difficulty-step-ticks))))) (else 0)))
    (define (attack-at-or-after tick)
      (if (> (attack-size tick) 0) tick
          (attack-at-or-after (+ tick (quotient wave-interval 2)))))
    (define (next-attack-tick tick)
      (let ((half-wave (quotient wave-interval 2)))
        (attack-at-or-after (* half-wave (+ 1 (quotient tick half-wave))))))
    ;; Raids replace regular waves; bosses fall halfway between them. These
    ;; disjoint schedules give constant-time numbering and countdown spans,
    ;; even near the six-year save bound. Tick zero starts the opening span.
    (define (regular-attack-count tick)
      (if (< tick first-wave-tick) 0 (+ 1 (quotient (- tick first-wave-tick) wave-interval))))
    (define (next-attack-number tick)
      (+ 1 (+ (regular-attack-count tick) (quotient tick final-siege-tick))))
    (define (attack-countdown-span tick)
      (let* ((count (regular-attack-count tick))
             (regular (if (= count 0) 0 (+ first-wave-tick (* (- count 1) wave-interval))))
             (heavy (* (quotient tick final-siege-tick) final-siege-tick)))
        (- (next-attack-tick tick) (maximum regular heavy))))
    (define (outpost-distance world site)
      (distance (building-x site) (building-y site) (world-hub-x world) (world-hub-y world)))
    (define (nest-distance nest site)
      (distance (building-x site) (building-y site) (nest-site-x nest) (nest-site-y nest)))
    ;; Each raid chooses the nearest exposed operation on its own approach,
    ;; and attacks the hub if no operation is closer. Separate fronts therefore
    ;; cannot all chase one remote tendril merely because it is far from home.
    (define (exposed-outpost? world nest site best)
      (and (ready? site) (or (= (building-kind site) 1) (and (tower? site) (not (armed? site)))) (> (outpost-distance world site) 9)
           (< (nest-distance nest site) (distance (nest-site-x nest) (nest-site-y nest) (world-hub-x world) (world-hub-y world)))
           (or (null? best) (< (nest-distance nest site) (nest-distance nest (car best)))
               (and (= (nest-distance nest site) (nest-distance nest (car best)))
                    (< (building-id site) (building-id (car best)))))))
    (define (outpost-target world nest buildings best)
      (if (null? buildings) best
          (outpost-target world nest (cdr buildings)
                          (if (exposed-outpost? world nest (car buildings) best) (list (car buildings)) best))))
    ;; Nest lanes touching rock breed lighter, faster raiders. The terrain
    ;; sample lies beyond the nest clearing so neighboring geology matters.
    (define (lane-kind world nest kind lane)
      (let ((x (+ (nest-site-x nest) (if (= (remainder lane 3) 0) -12 12)))
            (y (+ (nest-site-y nest) (- (remainder lane 5) 2))))
        (if (and (= kind 0) (not (ground? (world-seed world) x y))
                 (not (water? (world-seed world) x y))) 1 kind)))
    (define (enemy-spawn-health tick kind rank)
      (let ((health (+ (enemy-rank-health rank) (* 15 (maximum 0 (- (threat-tier tick) 6))))))
        (if (= kind 1) (quotient (* 4 health) 5) health)))
    (define (burrower-id? world id)
      (= (remainder (+ (remainder (world-seed world) 10) (remainder id 10)) 10) 0))
    (define (spawn-enemy world nest kind lane rank)
      (let* ((kind (lane-kind world nest kind lane))
             (target (if (= kind 1) (outpost-target world nest (world-buildings world) (empty-list)) (empty-list)))
             (x (+ (nest-site-x nest) (- (remainder lane 3) 1))) (y (+ (nest-site-y nest) 2))
             (health (enemy-spawn-health (world-threat-tick world) kind rank))
             (enemy (make-enemy (world-next-id world) (cell-x x) (cell-y y)
                                health kind
                                (if (null? target) 0 (building-id (car target))) (empty-list)
                                (burrower-id? world (world-next-id world)) rank
                                health)))
        (world-next-id-set (world-enemies-set world (append (world-enemies world) (list (route-enemy world enemy))))
                           (+ (world-next-id world) 1))))
    ;; Introduce one strongest enemy, a familiar previous rank, then mixed
    ;; escorts. Easy enemies remain present even after the six rank unlocks.
    (define (wave-rank rank index)
      (cond ((= index 0) rank) ((or (= rank 0) (= (remainder index 3) 2)) 0)
            ((= index 1) (- rank 1)) (else (remainder index rank))))
    (define (front-nest nests front)
      (if (= (nest-id (car nests)) front) (car nests) (front-nest (cdr nests) front)))
    ;; Allocate roles by the original global index before skipping a dead front.
    ;; A cleared front removes its own share, including its rotating strongest
    ;; slot; survivors never inherit extra enemies or a replacement boss.
    (define (spawn-wave world kind count total rank shift)
      (if (or (= count 0) (>= (list-size (world-enemies world)) maximum-enemies)) world
          (let* ((index (- total count)) (behavior (if (and (= kind 2) (> index 0)) 0 kind))
                 (nest (front-nest (world-nests world) (remainder (+ index shift) 3)))
                 (world (if (= (nest-hp nest) 0) world
                            (spawn-enemy world nest behavior (+ 14 (* 2 (remainder count 3))) (wave-rank rank index)))))
            (spawn-wave world kind (- count 1) total rank shift))))
    (define (spawn-due world)
      (let* ((tick (world-tick world)) (count (attack-size tick)))
        (spawn-wave world (attack-kind tick) count count
                    (minimum (if (heavy-wave? tick) 6 5) (maximum-enemy-rank (world-threat-tick world)))
                    (remainder (- (next-attack-number (- tick 1)) 1) 3))))
    ;; ---- Excavation and enemy routes ----

    (define rock-health 80)
    (define (world-ground? world x y)
      (open-ground? (world-seed world) (world-breaches world) x y))
    (define (dig-at excavations cell)
      (if (null? excavations) (empty-list)
          (if (= (dig-cell (car excavations)) cell) (list (car excavations))
              (dig-at (cdr excavations) cell))))
    (define (world-rock-remaining world x y)
      (if (or (world-ground? world x y) (water? (world-seed world) x y)) 0
          (let ((found (dig-at (world-excavations world) (cell-index x y))))
            (if (null? found) rock-health (dig-remaining (car found))))))
    (define (dig-cells excavations)
      (if (null? excavations) (empty-list)
          (cons (dig-cell (car excavations)) (dig-cells (cdr excavations)))))
    (define (remove-dig excavations cell)
      (if (null? excavations) excavations
          (if (= (dig-cell (car excavations)) cell) (cdr excavations)
              (cons (car excavations) (remove-dig (cdr excavations) cell)))))
    (define (chip-rock world cell amount)
      (let* ((remaining (- (world-rock-remaining world (index-x cell) (index-y cell)) amount))
             (others (remove-dig (world-excavations world) cell)))
        (if (<= remaining 0)
            (world-breaches-set (world-excavations-set world others) (cons cell (world-breaches world)))
            (world-excavations-set world (cons (make-dig cell remaining) others)))))
    (define (digging-cell world enemy)
      (if (or (null? (enemy-path enemy)) (encounter? world enemy)) -1
          (let ((cell (car (enemy-path enemy))))
            (if (and (not (world-ground? world (index-x cell) (index-y cell)))
                     (not (water? (world-seed world) (index-x cell) (index-y cell)))
                     (or (enemy-burrower enemy) (not (null? (dig-at (world-excavations world) cell))))) cell -1))))
    (define (digging-count world enemies cell)
      (if (null? enemies) 0
          (+ (if (= (digging-cell world (car enemies)) cell) 1 0)
             (digging-count world (cdr enemies) cell))))
    (define (seen-cell? cells cell)
      (and (not (null? cells)) (or (= (car cells) cell) (seen-cell? (cdr cells) cell))))
    ;; One enemy chips one point per tick; cooperation is capped at two.
    ;; Even a crowd must spend four seconds opening one intact rock tile.
    (define (excavate-enemies world enemies seen)
      (if (null? enemies) world
          (let ((cell (digging-cell world (car enemies))))
            (if (or (< cell 0) (seen-cell? seen cell)) (excavate-enemies world (cdr enemies) seen)
                (excavate-enemies (chip-rock world cell (minimum 2 (digging-count world (world-enemies world) cell)))
                                  (cdr enemies) (cons cell seen))))))
    (define (enemy-path-cost world enemy path)
      (if (null? path) 0
          (+ (+ (if (= (enemy-kind enemy) 1) 6 8) (world-rock-remaining world (index-x (car path)) (index-y (car path))))
             (enemy-path-cost world enemy (cdr path)))))
    (define (faster-enemy-path world enemy current candidate)
      (if (and (not (null? candidate))
               (or (null? current) (< (enemy-path-cost world enemy candidate) (enemy-path-cost world enemy current)))) candidate current))
    (define (enemy-route world enemy x y)
      (let* ((a (quotient (enemy-x enemy) cell-size)) (b (quotient (enemy-y enemy) cell-size))
             (opened (append (world-breaches world) (dig-cells (world-excavations world))))
             (walk (walking-open-path (world-seed world) (world-breaches world) a b x y (empty-list) #t))
             (join (if (null? (world-excavations world)) walk
                       (walking-open-path (world-seed world) opened a b x y (empty-list) #t)))
             (tunnel (if (enemy-burrower enemy) (tunneling-path (world-seed world) a b x y) (empty-list))))
        (faster-enemy-path world enemy (faster-enemy-path world enemy walk join) tunnel)))
    (define (route-enemy world enemy)
      (let ((target (find-building (world-buildings world) (enemy-target enemy))))
        (enemy-path-set enemy (enemy-route world enemy
                                           (if (null? target) (world-hub-x world) (building-x (car target)))
                                           (if (null? target) (world-hub-y world) (building-y (car target)))))))
    (define (path-ends-at? path cell)
      (and (not (null? path))
           (if (null? (cdr path)) (= (car path) cell) (path-ends-at? (cdr path) cell))))
    (define (enemy-route-stale? world enemy)
      (let ((target (enemy-target-building world enemy)))
        (and (not (null? target))
             (if (null? (enemy-path enemy)) (null? (near-building enemy target))
                 (not (path-ends-at? (enemy-path enemy)
                                     (cell-index (building-x (car target)) (building-y (car target)))))))))
    ;; A relocated attacker keeps its ID but changes the route's destination.
    ;; Check that destination on the same bounded cadence as terrain shortcuts;
    ;; repeated shots from a stationary attacker keep valid detours intact.
    (define (refresh-enemy-route world enemy)
      (if (not (= (remainder (+ (world-tick world) (enemy-id enemy)) 20) 0)) enemy
          (cond ((enemy-route-stale? world enemy) (route-enemy world enemy))
                ((and (< (digging-cell world enemy) 0)
                      (or (not (null? (world-breaches world))) (not (null? (world-excavations world)))))
                 (enemy-path-set enemy (faster-enemy-path world enemy (enemy-path enemy)
                                                          (enemy-path (route-enemy world enemy)))))
                (else enemy))))

    ;; ---- Crowds spread into neighboring walking lanes ----

    ;; Pressure uses the same unmoved population for every enemy. IDs break an
    ;; exact overlap; no random state or additional saved fields are needed.
    (define (neighbor-pressure enemy other horizontal)
      (let ((gap (distance (enemy-x enemy) (enemy-y enemy) (enemy-x other) (enemy-y other)))
            (side (if horizontal (- (enemy-y enemy) (enemy-y other)) (- (enemy-x enemy) (enemy-x other)))))
        (if (or (= (enemy-id enemy) (enemy-id other)) (<= (enemy-hp other) 0) (>= gap 120)) 0
            (* (- 120 gap) (if (or (> side 0) (and (= side 0) (> (enemy-id enemy) (enemy-id other)))) 1 -1)))))
    (define (crowd-pressure enemy enemies horizontal pressure)
      (if (null? enemies) pressure
          (crowd-pressure enemy (cdr enemies) horizontal
                          (+ pressure (neighbor-pressure enemy (car enemies) horizontal)))))
    (define (enemy-lane-cell? world cell side)
      (let ((next (+ cell side)))
        (and (= (distance (index-x cell) (index-y cell) (index-x next) (index-y next)) 1)
             (world-ground? world (index-x cell) (index-y cell))
             (world-ground? world (index-x next) (index-y next)))))
    ;; Require nine straight steps, replace the first eight with a parallel
    ;; lane, then reconnect. Its eight-step straight prefix cannot accept a
    ;; nested detour, so even fast enemies finish the lane before spreading
    ;; again. Every edge stays adjacent; blocked lanes fail as a whole.
    (define (parallel-enemy-path world path previous step side remaining)
      (cond ((= remaining 0)
             (if (and (not (null? path)) (= (car path) (+ previous step))) (cons previous path) (empty-list)))
            ((or (null? path) (not (= (car path) (+ previous step)))
                 (not (enemy-lane-cell? world (car path) side))) (empty-list))
            (else (let ((tail (parallel-enemy-path world (cdr path) (car path) step side (- remaining 1))))
                    (if (null? tail) tail (cons (+ (car path) side) tail))))))
    (define (spread-enemy-route world enemy cell step pressure)
      (let ((side (* (if (or (= step 1) (= step -1)) map-width 1) (if (> pressure 0) 1 -1))))
        (if (or (= step 0) (and (<= pressure 40) (>= pressure -40))
                (> (list-size (enemy-path enemy)) 1022) (not (enemy-lane-cell? world cell side))) enemy
                (let ((path (parallel-enemy-path world (enemy-path enemy) cell step side 8)))
                  (if (null? path) enemy (enemy-path-set enemy (cons (+ cell side) path)))))))
    ;; Stagger the bounded neighbor scans across eight-tick windows. All lane
    ;; decisions happen at cell centers; a lone enemy keeps its exact path.
    (define (spread-enemy world enemy)
      (if (and (= (remainder (enemy-x enemy) cell-size) 20)
               (= (remainder (enemy-y enemy) cell-size) 20)
               (= (remainder (+ (quotient (world-tick world) 8) (remainder (enemy-id enemy) 4)) 4) 0))
          (let* ((cell (cell-index (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size)))
                 (step (- (car (enemy-path enemy)) cell)))
            (spread-enemy-route world enemy cell step
                                (crowd-pressure enemy (world-enemies world) (or (= step 1) (= step -1)) 0)))
          enemy))
    (define (walk-enemy world enemy)
      (let* ((next (car (enemy-path enemy))) (x (cell-x (index-x next))) (y (cell-y (index-y next)))
             (speed (if (= (enemy-kind enemy) 1) 7 5))
             (moved (if (= (enemy-x enemy) x) (enemy-y-set enemy (approach (enemy-y enemy) y speed))
                        (enemy-x-set enemy (approach (enemy-x enemy) x speed)))))
        (if (not (world-ground? world (index-x next) (index-y next))) enemy
            (if (and (= (enemy-x moved) x) (= (enemy-y moved) y))
                (enemy-path-set moved (cdr (enemy-path moved))) moved))))
    (define (march-enemies world enemies)
      (if (null? enemies) enemies
          (let* ((enemy (car enemies))
                 (enemy (if (and (> (enemy-target enemy) 0)
                                 (null? (find-building (world-buildings world) (enemy-target enemy))))
                            (route-enemy world (enemy-target-set enemy 0)) (refresh-enemy-route world enemy))))
            (cons (if (or (null? (enemy-path enemy)) (encounter? world enemy)) enemy
                      (walk-enemy world (spread-enemy world enemy)))
                  (march-enemies world (cdr enemies))))))
    (define (enemy-visible? world enemy)
      (visible? world (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size)))
    (define artillery-range (* 6 cell-size))
    (define (root-step square guess)
      (let ((next (quotient (+ guess (quotient square guess)) 2)))
        (if (>= next guess) guess (root-step square next))))
    (define (artillery-damage x y a b)
      (let* ((dx (- x a)) (dy (- y b)) (square (+ (* dx dx) (* dy dy)))
             (length (if (= square 0) 0 (root-step square square))))
        (if (> length artillery-range) 0
            (+ 6 (quotient (* 18 (- artillery-range length)) artillery-range)))))
    (define (building-shot-damage building x y)
      (let ((damage (artillery-damage (cell-x (building-x building)) (cell-y (building-y building)) x y)))
        (if (= (building-kind building) 2) (quotient (* damage (+ (building-level building) 1)) 2) damage)))
    (define (choose-target world building enemies best)
      (if (null? enemies) best
          (let ((enemy (car enemies)))
            (choose-target world building (cdr enemies)
                           (if (and (> (enemy-hp enemy) 0) (enemy-visible? world enemy)
                                    (within? (enemy-x enemy) (enemy-y enemy)
                                             (cell-x (building-x building)) (cell-y (building-y building)) artillery-range)
                                    (clear-open-shot? (world-seed world) (world-breaches world) (cell-x (building-x building)) (cell-y (building-y building))
                                                      (enemy-x enemy) (enemy-y enemy))
                                    (or (null? best) (> (enemy-kind enemy) (enemy-kind (car best)))
                                        (and (= (enemy-kind enemy) (enemy-kind (car best)))
                                             (< (distance (enemy-x enemy) (enemy-y enemy) (cell-x (world-hub-x world)) (cell-y (world-hub-y world)))
                                                (distance (enemy-x (car best)) (enemy-y (car best)) (cell-x (world-hub-x world)) (cell-y (world-hub-y world)))))))
                               (list enemy) best)))))
    (define (retaliate-enemy world enemy attacker amount)
      (let ((wounded (enemy-hp-set enemy (- (enemy-hp enemy) amount))))
        (if (or (<= (enemy-hp wounded) 0) (= (enemy-target wounded) attacker)) wounded
            (route-enemy world (enemy-target-set wounded attacker)))))
    (define (hurt-enemy world enemies id attacker amount)
      (if (null? enemies) enemies
          (cons (if (= (enemy-id (car enemies)) id) (retaliate-enemy world (car enemies) attacker amount)
                    (car enemies)) (hurt-enemy world (cdr enemies) id attacker amount))))
    (define (fire-building world building)
      ;; Aim records an actual shot, so its tracer cannot bend while cooling down.
      (if (> (building-cooldown building) 0) world
          (let ((target (choose-target world building (world-enemies world) (empty-list))))
            (if (null? target) (fire-nest world building)
                (let* ((enemy (car target))
                       (aimed (building-aim-y-set (building-aim-x-set building (enemy-x enemy)) (enemy-y enemy))))
                  (world-enemies-set (put-building world (building-cooldown-set aimed 8))
                                     (hurt-enemy world (world-enemies world) (enemy-id enemy) (building-id building)
                                                 (building-shot-damage building (enemy-x enemy) (enemy-y enemy)))))))))
    (define (nest-in-range? world building nest)
      (let ((x (cell-x (nest-site-x nest))) (y (cell-y (nest-site-y nest)))
            (a (cell-x (building-x building))) (b (cell-y (building-y building))))
        (and (> (nest-hp nest) 0) (visible? world (nest-site-x nest) (nest-site-y nest))
             (within? x y a b artillery-range) (clear-open-shot? (world-seed world) (world-breaches world) a b x y))))
    (define (choose-nest world building nests)
      (cond ((null? nests) (empty-list))
            ((nest-in-range? world building (car nests)) (list (car nests)))
            (else (choose-nest world building (cdr nests)))))
    (define (hurt-nest nests id damage)
      (if (null? nests) nests
          (cons (if (= (nest-id (car nests)) id) (nest-hp-set (car nests) (maximum 0 (- (nest-hp (car nests)) damage))) (car nests))
                (hurt-nest (cdr nests) id damage))))
    (define (fire-nest world building)
      (let ((found (choose-nest world building (world-nests world))))
        (if (null? found) world
            (let* ((nest (car found)) (x (cell-x (nest-site-x nest))) (y (cell-y (nest-site-y nest)))
                   (aimed (building-aim-y-set (building-aim-x-set building x) y)))
              (world-nests-set (put-building world (building-cooldown-set aimed 8))
                               (hurt-nest (world-nests world) (nest-id nest) (building-shot-damage building x y)))))))
    (define (fire-buildings world buildings)
      (if (null? buildings) world
          (let* ((building (car buildings))
                 (building (building-cooldown-set building (maximum 0 (- (building-cooldown building) 1))))
                 (world (put-building world building)))
            (fire-buildings (if (and (ready? building) (armed? building))
                                (fire-building world building) world) (cdr buildings)))))
    (define (enemy-survivors enemies)
      (if (null? enemies) enemies
          (if (> (enemy-hp (car enemies)) 0) (cons (car enemies) (enemy-survivors (cdr enemies)))
              (enemy-survivors (cdr enemies)))))
    ;; ---- Encounters respect a committed attacker's priority ----

    ;; The nine hub tile centers form a square; their outer attack boundary
    ;; keeps the same rounded 45-pixel reach as the former single-cell hub.
    (define (near-hub? world enemy)
      (let ((x (cell-x (world-hub-x world))) (y (cell-y (world-hub-y world))))
        (within? (enemy-x enemy) (enemy-y enemy)
                 (minimum (+ x cell-size) (maximum (- x cell-size) (enemy-x enemy)))
                 (minimum (+ y cell-size) (maximum (- y cell-size) (enemy-y enemy))) 45)))
    (define (enemy-target-building world enemy)
      (let ((target (find-building (world-buildings world) (enemy-target enemy))))
        (if (and (not (null? target)) (ready? (car target))) target (empty-list))))
    (define (near-building enemy buildings)
      (if (null? buildings) (empty-list)
          (let ((building (car buildings)))
            (if (and (ready? building)
                     (within? (enemy-x enemy) (enemy-y enemy)
                              (cell-x (building-x building)) (cell-y (building-y building)) 56))
                (list building) (near-building enemy (cdr buildings))))))
    (define (encounter? world enemy)
      (let ((target (enemy-target-building world enemy)))
        (if (null? target)
            (or (near-hub? world enemy)
                (not (null? (near-building enemy (world-buildings world)))))
            (not (null? (near-building enemy target))))))
    (define attack-alert-ticks 80)
    (define attack-alert-radius 4)
    (define (retained-alerts alerts x y tick remaining)
      (if (or (= remaining 0) (null? alerts)) (empty-list)
          (let ((alert (car alerts)))
            (if (or (> (- tick (alert-tick alert)) attack-alert-ticks) (within? x y (alert-x alert) (alert-y alert) attack-alert-radius))
                (retained-alerts (cdr alerts) x y tick remaining)
                (cons alert (retained-alerts (cdr alerts) x y tick (- remaining 1)))))))
    (define (record-attack world x y kind)
      (world-alerts-set world (cons (make-alert x y kind (world-tick world))
                                    (retained-alerts (world-alerts world) x y (world-tick world) 3))))
    (define (attack-target world enemy)
      (let* ((damage (enemy-rank-damage (enemy-rank enemy)))
             (target (enemy-target-building world enemy))
             (site (near-building enemy (if (null? target) (world-buildings world) target))))
        (cond ((not (null? target)) (if (null? site) world (damage-building world (car site) damage)))
              ((and (near-hub? world enemy) (> (world-hull world) 0))
               (record-attack (world-hull-set world (maximum 0 (- (world-hull world) damage))) (world-hub-x world) (world-hub-y world) 0))
              ((not (null? site))
               (damage-building world (car site) damage))
              (else world))))
    (define (damage-building world building damage)
      (record-attack (put-building world (building-hp-set building (maximum 0 (- (building-hp building) damage))))
                     (building-x building) (building-y building) (building-kind building)))
    ;; Tick cadence belongs to the attacker, not a freshly selected target.
    ;; Switching between structures cannot reset or accelerate hits.
    (define (attack-targets world enemies)
      (if (null? enemies) world
          (attack-targets (attack-target world (car enemies)) (cdr enemies))))
    (define (remove-building buildings id)
      (if (null? buildings) buildings
          (if (= (building-id (car buildings)) id) (cdr buildings)
              (cons (car buildings) (remove-building (cdr buildings) id)))))
    (define (ore-cargo? bot)
      (or (= (bot-job bot) 2) (= (bot-job bot) 4) (= (bot-job bot) 12) (= (bot-job bot) 14)
          (and (= (bot-job bot) 7)
               (or (= (bot-timer bot) 2) (= (bot-timer bot) 4) (= (bot-timer bot) 12) (= (bot-timer bot) 14)))))
    ;; Construction ownership follows the job and target, even when a free
    ;; extractor needs no material. The decoder proves each exact cargo amount.
    (define (kit-carrier? bot)
      (or (= (bot-job bot) 3) (= (bot-job bot) 5)
          (and (= (bot-job bot) 7) (= (bot-timer bot) 5))))
    (define (settle-dead-worker world bot)
      (let* ((found (find-building (world-buildings world) (bot-order bot)))
             (world (if (null? found) world (put-building world (construction-stage-set (car found) 0))))
             (world (world-casualties-set world (+ (world-casualties world) 1)))
             ;; Cancelled hub work leaves its unconsumed materials at the hub.
             (world (cond ((production-worker? bot) (refund-spending world worker-cost))
                          ((or (repair-worker? bot) (hub-upgrade-worker? bot)) (refund-spending world (bot-target bot)))
                          (else world))))
        (cond ((ore-cargo? bot) (world-lost-ore-set world (+ (world-lost-ore world) (bot-cargo bot))))
              ((kit-carrier? bot)
               (lose-carried-kit world bot))
              (else world))))
    (define (lose-carried-kit world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) world
            (let ((world (refund-reserved-kit world (car found))))
              (abandon-project world (car (find-building (world-buildings world) (bot-target bot))))))))
    (define (settle-workers world bots alive)
      (if (null? bots) (world-bots-set world (reverse alive))
          (if (> (bot-hp (car bots)) 0) (settle-workers world (cdr bots) (cons (car bots) alive))
              (settle-workers (settle-dead-worker world (car bots)) (cdr bots) alive))))
    (define (cancel-destroyed-upgrades world buildings)
      (if (null? buildings) world
          (let* ((site (car buildings)) (lost (and (<= (building-hp site) 0) (arming? site)))
                 (world (if (and lost (not (= (building-source site) (building-id site))))
                            (refund-reserved-kit world site) world))
                 (world (if lost (cancel-workers world (world-bots world) (building-id site)) world)))
            (cancel-destroyed-upgrades world (cdr buildings)))))
    (define (settle-buildings world buildings standing)
      (if (null? buildings) (world-buildings-set world (reverse standing))
          (let ((building (car buildings)))
            (if (> (building-hp building) 0) (settle-buildings world (cdr buildings) (cons building standing))
                (settle-buildings
                 (world-lost-set (world-lost-ore-set world (+ (world-lost-ore world) (raw-stock building)))
                                 (+ (world-lost world) 1)) (cdr buildings) standing)))))
    (define (settle-supplies world buildings)
      (if (null? buildings) world
          (let* ((building (car buildings)) (source (building-source building))
                 (lost (and (> source 0) (not (= (building-stage building) 2)) (> (uncollected-supplies building) 0)
                            (null? (find-building (world-buildings world) source)))))
            (settle-supplies
             (if lost (abandon-project (cancel-workers world (world-bots world) (building-id building)) building) world)
             (cdr buildings)))))
    (define (emergency-worker world)
      ;; Only total worker loss activates the hub's 60-tick recovery safeguard.
      ;; This single inert worker cannot build, mine or reserve a paid order.
      (if (and (> (world-hull world) 0) (null? (world-bots world)))
          (world-next-id-set
           (world-bots-set world (list (bot-timer-set (bot-job-set (idle-bot (world-seed world) (world-next-id world)) 6) 60)))
           (+ (world-next-id world) 1)) world))
    (define (clear-casualties world)
      (let* ((alive (enemy-survivors (world-enemies world)))
             (world (world-kills-set (world-enemies-set world alive)
                                     (+ (world-kills world) (- (list-size (world-enemies world)) (list-size alive)))))
             (world (settle-workers world (world-bots world) (empty-list)))
             (world (cancel-destroyed-upgrades world (world-buildings world))))
        (let ((world (settle-buildings world (world-buildings world) (empty-list))))
          (emergency-worker (settle-supplies world (world-buildings world))))))
    (define (fight world)
      (let* ((world (excavate-enemies world (world-enemies world) (empty-list)))
             (world (world-enemies-set world (march-enemies world (world-enemies world))))
             (world (clear-casualties (fire-buildings world (world-buildings world)))))
        (clear-casualties (if (= (remainder (world-tick world) 10) 0)
                              (attack-targets world (world-enemies world)) world))))
    (define (finish world)
      (world-outcome-set world
                         (cond ((<= (world-nest-hp world) 0) 3)
                               ((<= (world-hull world) 0) 1)
                               (else 0))))
    ;; Production and worker arrivals precede combat in this tick. A completed
    ;; kit is consumed before damage; casualty settlement sees only remaining
    ;; owned cargo. Pausing leaves this entire simulation-time boundary untouched.
    (define (advance-world world)
      (if (or (not (world-started world)) (not (active? world)) (= (world-paused world) 1)) world
          (let* ((world (rebuild-transport (world-tick-set world (minimum run-end-tick (+ (world-tick world) 1)))))
                 (world (if (= (remainder (world-tick world) 10) 0)
                            (produce-buildings world (world-buildings world)) world))
                 (world (advance-rails world))
                 (world (advance-moves world (world-buildings world)))
                 (world (dispatch-buildings world (world-buildings world))))
            (finish (rebuild-transport (fight (spawn-due (advance-bots world (world-bots world)))))))))))
