                                         (workers-at (world-bots world) 8 (building-id building)))) 0)))
            (produce-buildings (world-produced-set
                                (put-building world (building-stock-set building (+ (building-stock building) amount)))
                                (+ (world-produced world) amount)) (cdr buildings)))))
    ;; One productive mine keeps a construction cache once initial income has
    ;; arrived. This is loose, spendable material, not a paid reservation. The
    ;; other buffers and all tower freight continue normal hauling; a low hub
    ;; balance releases the cache so rebuilding the workforce remains possible.
    (define (best-cache buildings best seed)
      (if (null? buildings) best
          (let ((site (car buildings)))
            (best-cache (cdr buildings)
                        (if (and (ready? site) (= (building-kind site) 1)
                                 (or (null? best) (> (deposit-rate seed (building-x site) (building-y site))
                                                     (deposit-rate seed (building-x (car best)) (building-y (car best))))))
                            (list site) best) seed))))
    (define (construction-cache world)
      (let ((mine (best-cache (world-buildings world) (empty-list) (world-seed world))))
        (if (or (null? mine) (< (list-size (world-bots world)) 3)
                (< (world-delivered world) 16) (< (world-credits world) 40)) 0
                (building-id (car mine)))))
    (define (haulable-stock world mine)
      (maximum 0 (- (building-stock mine) (if (= (building-id mine) (construction-cache world)) 50 0))))
    (define (mine-backlog world building)
      (- (haulable-stock world building) (* 16 (workers-at (world-bots world) 1 (building-id building)))))
    (define (hauler? bot) (or (<= (bot-job bot) 2) (= (bot-job bot) 10)))
    (define (another-hauler? bots id)
      (and (not (null? bots))
           (or (and (not (= (bot-id (car bots)) id)) (hauler? (car bots)))
               (another-hauler? (cdr bots) id))))
    (define (has-miner? bots)
      (and (not (null? bots))
           (or (= (bot-job (car bots)) 8) (= (bot-job (car bots)) 9) (has-miner? (cdr bots)))))
    (define (can-staff? world bot)
      (or (not (has-miner? (world-bots world))) (another-hauler? (world-bots world) (bot-id bot))))
    (define (at-hub? world bot)
      (and (= (bot-x bot) (cell-x (world-hub-x world))) (= (bot-y bot) (cell-y (world-hub-y world)))))
    (define (sheltered? world bot) (and (> (world-hull world) 0) (at-hub? world bot)))
    ;; Routes avoid observed threats and threats close enough for this worker to
    ;; sense. Empty means either already there or unreachable; callers prove which.
    (define (worker-hazards world bot enemies radius)
      (if (null? enemies) (empty-list)
          (let* ((enemy (car enemies)) (x (quotient (enemy-x enemy) cell-size))
                 (y (quotient (enemy-y enemy) cell-size))
                 (rest (worker-hazards world bot (cdr enemies) radius)))
            (if (or (visible? world x y) (within? (bot-x bot) (bot-y bot) (enemy-x enemy) (enemy-y enemy) 160))
                (cons (make-survey x y radius) rest) rest))))
    (define (route-from world bot a b safe)
      (let* ((x (quotient (bot-x bot) cell-size)) (y (quotient (bot-y bot) cell-size))
             (path (cart-path (world-seed world) (world-breaches world) (fast-rails world (world-rails world)) x y a b (world-surveys world)
                              (if safe (worker-hazards world bot (world-enemies world) 3) (empty-list)))))
        (if (and (null? path) (not (and (= x a) (= y b)))) path
            (if (and (= (bot-x bot) (cell-x x)) (= (bot-y bot) (cell-y y))) path
                (cons (cell-index x y) path)))))
    (define (at-cell? bot x y)
      (and (= (bot-x bot) (cell-x x)) (= (bot-y bot) (cell-y y))))
    (define (reachable? bot x y path) (or (not (null? path)) (at-cell? bot x y)))
    ;; Once construction has claimed workers, remaining workers choose reachable
    ;; mining and collection work. Incoming assignments reserve slots and loads.
    (define-immutable-record Assignment make-assignment
      (job I32 assignment-job assignment-job-set)
      (target I32 assignment-target assignment-target-set)
      (cargo I32 assignment-cargo assignment-cargo-set)
      (distance I32 assignment-distance assignment-distance-set)
      (path (List I32) assignment-path assignment-path-set))
    (define (prepare-assignment world bot job target x y safe)
      (let ((path (route-from world bot x y safe)))
        (if (reachable? bot x y path)
            (list (make-assignment job target 0 (travel-ticks world bot path) path)) (empty-list))))
    (define (choose-nearer candidate best)
      (if (and (not (null? candidate))
               (or (null? best) (< (assignment-distance (car candidate)) (assignment-distance (car best))))) candidate best))
    (define (mine-choice world bot mine safe)
      (let* ((id (building-id mine))
             (slots (+ (workers-at (world-bots world) 8 id) (workers-at (world-bots world) 9 id))))
        (cond ((and (< slots (building-level mine)) (< (building-stock mine) 16) (can-staff? world bot))
               (prepare-assignment world bot 9 id (building-x mine) (building-y mine) safe))
              ((> (mine-backlog world mine) 0)
               (prepare-assignment world bot 1 id (building-x mine) (building-y mine) safe))
              ((and (< slots (building-level mine)) (< (building-stock mine) 120) (can-staff? world bot))
               (prepare-assignment world bot 9 id (building-x mine) (building-y mine) safe))
              (else (empty-list)))))
    (define (choose-work world bot buildings safe best)
      (if (null? buildings) best
          (let ((mine (car buildings)))
            (choose-work world bot (cdr buildings) safe
                         (if (and (ready? mine) (= (building-kind mine) 1))
                             (choose-nearer (mine-choice world bot mine safe) best) best)))))
    (define (install-assignment world bot assignment)
      (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) (assignment-job assignment)
                               (assignment-target assignment) 0 0 (assignment-path assignment) (bot-hp bot) 0 0)))
    (define (pickup-order world bot)
      (let ((found (find-building (world-buildings world) (bot-order bot))))
        (cond ((null? found) (put-bot world (release-order bot)))
              ((construction-hidden? world (car found)) (suspend-construction world (car found) bot))
              (else (let* ((building (car found))
                           (path (route-from world bot (building-x building) (building-y building) #t)))
                      (if (not (reachable? bot (building-x building) (building-y building) path))
                          (put-bot world (bot-job-set (clear-job bot) 10))
                          (put-bot (put-building world (construction-stage-set building 1))
                                   (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 3 (building-id building)
                                             (construction-kit-size building) 0 path (bot-hp bot) 0 (building-source building)))))))))
    ;; An unseen site retains its paid supplies, but releases an unladen worker
    ;; for useful work. A carrier already on the remembered route brings vision
    ;; with it and can finish once its own circle reaches the site.
    (define (suspend-construction world building bot)
      (put-bot (put-building world (construction-stage-set building 0)) (release-order bot)))
    (define (reserved-work world bot)
      (let* ((building (car (find-building (world-buildings world) (bot-order bot))))
             (source (building-source building)) (path (source-path world bot source)))
        (cond ((construction-hidden? world building) (suspend-construction world building bot))
              ((not (source-reachable? world bot source path))
               (put-bot world (bot-job-set (clear-job bot) 10)))
              (else (if (null? path) (pickup-order world bot)
                        (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 11 source 0 0 path
                                                 (bot-hp bot) (bot-order bot) 0)))))))
    (define (assign-work world bot)
      (if (> (bot-order bot) 0) (reserved-work world bot)
          (let ((choice (choose-work world bot (world-buildings world) #t (empty-list))))
            (if (null? choice)
                (put-bot world (bot-job-set bot (if (null? (choose-work world bot (world-buildings world) #f (empty-list))) 0 10)))
                (install-assignment world bot (car choice))))))

    ;; ---- Worker travel, escape and physical delivery ----

    (define (approach value target speed)
      (if (< value target) (+ value (minimum speed (- target value)))
          (- value (minimum speed (- value target)))))
    ;; Reconstruct the current adjacent segment from the next center, including
    ;; workers interrupted between centers. No vehicle owns a second cargo copy.
    (define (step-speed fast x y next)
      (let* ((a (index-x next)) (b (index-y next))
             (previous (if (not (= x (cell-x a)))
                           (cell-index (+ a (if (< x (cell-x a)) -1 1)) b)
                           (cell-index a (+ b (if (< y (cell-y b)) -1 1))))))
        (if (and (> (distance x y (cell-x a) (cell-y b)) 0)
                 (<= (distance x y (cell-x a) (cell-y b)) cell-size)
                 (< (cart-step-cost fast previous next) 40))
            (quotient 320 (cart-step-cost fast previous next)) 8)))
    (define (bot-riding? world bot)
      (and (not (null? (bot-path bot)))
           (> (step-speed (fast-rails world (world-rails world)) (bot-x bot) (bot-y bot) (car (bot-path bot))) 8)))
    ;; One atomic movement consumes a bounded time budget across corners. It
    ;; never processes a second job or unloads cargo; arrival remains next tick.
    (define (walk-route bot fast budget)
      (if (or (= budget 0) (null? (bot-path bot))) bot
          (let* ((next (car (bot-path bot))) (x (cell-x (index-x next))) (y (cell-y (index-y next)))
                 (cost (quotient 320 (step-speed fast (bot-x bot) (bot-y bot) next)))
                 (length (distance (bot-x bot) (bot-y bot) x y))
                 (amount (minimum length (quotient budget cost)))
                 (moved (if (= (bot-x bot) x) (bot-y-set bot (approach (bot-y bot) y amount))
                            (bot-x-set bot (approach (bot-x bot) x amount)))))
            (if (= amount length) (walk-route (bot-path-set moved (cdr (bot-path moved))) fast (- budget (* amount cost))) moved))))
    (define (walk-bot world bot)
      (walk-route bot (fast-rails world (world-rails world)) 320))
    (define (danger? enemies x y)
      (and (not (null? enemies))
           (or (within? x y (enemy-x (car enemies)) (enemy-y (car enemies)) 130)
               (danger? (cdr enemies) x y))))
    (define (clear-job bot)
      (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 0 0 0 0 (empty-list) (bot-hp bot) (bot-order bot) 0))
    (define (return-home world bot job)
      (let* ((path (route-from world bot (world-hub-x world) (world-hub-y world) #t))
             (returning (and (reachable? bot (world-hub-x world) (world-hub-y world) path) (not (= job 11)))))
        ;; An uncollected reservation stays in retreat until hub arrival; job
        ;; 11 always means travel to the actual paid source, which may be local.
        (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot)
                                 (if returning job 7)
                                 (if (= job 2) 0 (bot-target bot)) (bot-cargo bot)
                                 (if returning 0 job) path (bot-hp bot) (bot-order bot) (bot-source bot)))))
    (define (escape-bot world bot)
      (let* ((x (quotient (bot-x bot) cell-size)) (y (quotient (bot-y bot) cell-size))
             (path (cart-escape-path (world-seed world) (world-breaches world) (fast-rails world (world-rails world)) x y (world-surveys world)
                                     (worker-hazards world bot (world-enemies world) 4))))
        (put-bot world (bot-path-set bot path))))
    (define (flee-bot world bot)
      (cond ((sheltered? world bot) (arrive-bot world (bot-job-set (bot-timer-set bot 0) (bot-timer bot))))
            ((not (null? (bot-path bot))) (put-bot world (walk-bot world bot)))
            ((danger? (world-enemies world) (bot-x bot) (bot-y bot)) (escape-bot world bot))
            (else (return-home world bot (bot-timer bot)))))
    (define (interrupt-bot world bot)
      (let ((job (if (or (= (bot-job bot) 3) (= (bot-job bot) 5)) 5
                     (if (or (= (bot-job bot) 4) (= (bot-job bot) 12)) (bot-job bot)
                         (if (= (bot-job bot) 11) 11 (if (= (bot-job bot) 7) (bot-timer bot) 2))))))
        (flee-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 7 (bot-target bot)
                                  (bot-cargo bot) job (empty-list) (bot-hp bot) (bot-order bot) (bot-source bot)))))
    (define (drop-choice world bot id x y best)
      (let ((path (route-from world bot x y #t)))
        (if (and (reachable? bot x y path)
                 (or (null? best) (< (travel-ticks world bot path) (assignment-distance (car best)))))
            (list (make-assignment 2 id (bot-cargo bot) (travel-ticks world bot path) path)) best)))
    (define (choose-depot world bot buildings best)
      (if (null? buildings) best
          (let ((building (car buildings)))
            (choose-depot world bot (cdr buildings)
                          (if (accepting-depot? world (building-id building))
                              (drop-choice world bot (building-id building) (building-x building) (building-y building) best) best)))))
    (define (return-ore world bot)
      (let ((choice (choose-depot world bot (world-buildings world) (drop-choice world bot 0 (world-hub-x world) (world-hub-y world) (empty-list)))))
        (if (null? choice) (return-home world (bot-target-set bot 0) 2)
            (let ((destination (car choice)))
              (put-bot world (make-bot (bot-id bot) (bot-x bot) (bot-y bot) 2 (assignment-target destination)
                                       (bot-cargo bot) 0 (assignment-path destination) (bot-hp bot) (bot-order bot) 0))))))
    (define (collect-ore world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) (put-bot world (clear-job bot))
            (let* ((mine (car found)) (cargo (minimum 16 (haulable-stock world mine))))
              (return-ore (put-building world (building-stock-set mine (- (building-stock mine) cargo)))
                          (bot-cargo-set bot cargo))))))
    (define (deliver-ore world bot)
      (if (at-hub? world bot) (finish-work (credit-delivery world (bot-cargo bot)) (bot-hp-set bot 14))
          (let ((found (find-building (world-buildings world) (bot-target bot))))
            (if (or (null? found) (not (accepting-depot? world (bot-target bot)))) (return-ore world bot)
                (finish-work (put-building world (building-stock-set (car found) (+ (building-stock (car found)) (bot-cargo bot)))) bot)))))
    (define (finish-work world bot)
      (let ((free (clear-job bot))) (assign-work (put-bot world free) free)))
    (define (incorporate-kit site cargo complete)
      (if (arming? site)
          (building-level-set site (+ (building-level site) 1))
          (building-armed-set (building-stock-set site (if complete 0 (+ (building-stock site) cargo)))
                              (if (and complete (tower? site) (= (building-level site) 2)) 1 0))))
    (define (complete-building world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) (put-bot world (clear-job bot))
            (let* ((site (car found)) (complete (or (arming? site) (= (+ (building-stock site) (bot-cargo bot)) (construction-cost site))))
                   (site (incorporate-kit site (bot-cargo bot) complete))
                   (site (if complete (building-source-set (building-stage-set site 2) 0) (construction-stage-set site 0)))
                   (world (put-building world site)))
              (finish-work (if complete (remember-building world site) world) bot)))))
    (define (hub-kit world bot)
      ;; A local paid kit returned to hub becomes hub-backed without adding
      ;; spendable ore. Its original local consumption becomes a real delivery.
      (if (= (bot-source bot) 0) world
          (world-delivered-set (world-local-spent-set world (- (world-local-spent world) (bot-cargo bot)))
                               (+ (world-delivered world) (bot-cargo bot)))))
    (define (return-kit world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (and (not (null? found)) (> (building-source (car found)) 0) (> (uncollected-supplies (car found)) 0))
            (return-local-kit world bot (car found))
            (let ((world (hub-kit world bot)))
              (finish-work (if (null? found) (spend world (- 0 (bot-cargo bot)))
                               (put-building world (building-source-set (construction-stage-set (car found) 0) 0)))
                           (bot-hp-set bot 14))))))
    (define (return-local-kit world bot building)
      ;; A two-kit local project still owns its other kit at that source. Keep
      ;; their provenance together by physically returning this kit there too.
      (let* ((source (building-source building)) (path (source-path world bot source)))
        (cond ((not (source-reachable? world bot source path)) (put-bot world (bot-path-set bot (empty-list))))
              ((null? path) (finish-work (put-building world (construction-stage-set building 0)) bot))
              (else (put-bot world (bot-path-set bot path))))))
    (define (arrive-bot world bot)
      (cond ((= (bot-job bot) 1) (collect-ore world bot))
            ((= (bot-job bot) 2) (deliver-ore world bot))
            ((= (bot-job bot) 3) (complete-building world bot))
            ((= (bot-job bot) 4) (start-assembly world bot))
            ((= (bot-job bot) 5) (return-kit world bot))
            ((= (bot-job bot) 9) (put-bot world (bot-job-set bot 8)))
            ((= (bot-job bot) 11) (reserved-work world bot))
            ((= (bot-job bot) 12) (start-repair world bot))
            (else world)))
    (define (mine-bot world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) (put-bot world (clear-job bot))
            (if (and (>= (haulable-stock world (car found)) 16)
                     (not (another-hauler? (world-bots world) (bot-id bot))))
                (collect-ore world bot) world))))
    (define (outward-missing? world bot)
      (and (or (= (bot-job bot) 1) (= (bot-job bot) 8) (= (bot-job bot) 9))
           (null? (find-building (world-buildings world) (bot-target bot)))))
    (define (complete-worker world bot)
      (let ((world (world-bots-set world (append (world-bots world) (list (idle-bot (world-seed world) (bot-target bot)))))))
        (finish-work world (clear-job bot))))
    (define (assemble-worker world bot)
      (cond ((> (bot-timer bot) 1) (put-bot world (bot-timer-set bot (- (bot-timer bot) 1))))
            ((= (bot-target bot) 0) (finish-work world (clear-job bot)))
            (else (complete-worker world bot))))
    (define (advance-bot world bot)
      (let ((bot (if (sheltered? world bot) (bot-hp-set bot 14) bot)))
        (cond ((= (bot-job bot) 6) (assemble-worker world bot))
              ((= (bot-job bot) 13) (repair-hub world bot))
              ((= (bot-job bot) 7) (flee-bot world bot))
              ((and (not (sheltered? world bot)) (danger? (world-enemies world) (bot-x bot) (bot-y bot)))
               (interrupt-bot world bot))
              ((outward-missing? world bot) (put-bot world (clear-job bot)))
              ((and (= (bot-job bot) 2) (> (bot-target bot) 0)
                    (not (accepting-depot? world (bot-target bot)))) (return-ore world bot))
              ((or (= (bot-job bot) 0) (= (bot-job bot) 10)) (assign-work world bot))
              ((= (bot-job bot) 8) (mine-bot world bot))
              ((not (null? (bot-path bot))) (put-bot world (walk-bot world bot)))
              (else (arrive-bot world bot)))))
    (define (advance-bots world bots)
      (if (null? bots) world (advance-bots (advance-bot world (car bots)) (cdr bots))))

    ;; ---- The nest sends escalating attacks until destroyed ----

    ;; The opening allows ninety seconds of exploration. Ordinary waves then
    ;; arrive once a minute; new strength ranks take three minutes each.
    (define first-wave-tick 900)
    (define wave-interval 600)
    (define first-raid-tick 2700)
    (define raid-interval 1800)
    (define final-siege-tick 10800)
    ;; This serialization bound is over six years of continuous simulation.
    ;; It never declares a timed victory; only destroying the nest wins.
    (define run-end-tick 2147480000)
    (define maximum-enemies 128)
    (define simulation-ticks-per-second 10)
    (define difficulty-step-ticks 1800)
    ;; This computed domain interval is the only source of difficulty timing.
    ;; Zero end means the final tier, with no further increase scheduled.
    (define-immutable-record DifficultyWindow make-difficulty-window
      (tier I32 difficulty-tier difficulty-tier-set)
      (start I32 difficulty-start difficulty-start-set)
      (end I32 difficulty-end difficulty-end-set))
    (define (difficulty-window-for tick interval)
      (unless (and (>= tick 0) (<= tick run-end-tick) (> interval 0)
                   (<= interval (quotient run-end-tick 41)))
        (unreachable))
      (let ((tier (minimum 40 (quotient tick interval))))
        (make-difficulty-window tier (* tier interval) (if (= tier 40) 0 (* (+ tier 1) interval)))))
    (define (difficulty-window tick) (difficulty-window-for tick difficulty-step-ticks))
    (define (threat-tier tick) (difficulty-tier (difficulty-window tick)))
    (define (maximum-enemy-rank tick) (minimum 6 (threat-tier tick)))
    (define maximum-enemy-health 2310)
    (define (enemy-rank-health rank)
      (cond ((= rank 0) 65) ((= rank 1) 90) ((= rank 2) 125) ((= rank 3) 180)
            ((= rank 4) 300) ((= rank 5) 500) (else 1800)))
    (define (enemy-rank-damage rank)
      (cond ((= rank 0) 7) ((= rank 1) 8) ((= rank 2) 10) ((= rank 3) 12)
            ((= rank 4) 16) ((= rank 5) 20) (else 30)))
    (define (heavy-wave? tick) (and (>= tick final-siege-tick) (= (remainder tick final-siege-tick) 0)))
    (define (raid-wave? tick) (and (>= tick first-raid-tick) (= (remainder (- tick first-raid-tick) raid-interval) 0)))
    (define (regular-wave? tick)
      (and (>= tick first-wave-tick)
           (= (remainder (- tick first-wave-tick) wave-interval) 0)))
    (define (attack-kind tick)
      (cond ((heavy-wave? tick) 2) ((raid-wave? tick) 1) (else 0)))
    (define (attack-size tick)
      (cond ((heavy-wave? tick) (+ 7 (minimum 17 (quotient (- tick final-siege-tick) final-siege-tick))))
            ((raid-wave? tick) (+ 5 (minimum 19 (quotient (- tick first-raid-tick) raid-interval))))
            ((regular-wave? tick) (+ 4 (minimum 20 (quotient (- tick first-wave-tick) 2700)))) (else 0)))
    (define (attack-at-or-after tick)
      (if (> (attack-size tick) 0) tick
          (attack-at-or-after (+ tick 150))))
    (define (next-attack-tick tick)
      (attack-at-or-after (* 150 (+ 1 (quotient tick 150)))))
    ;; Raids replace regular waves; bosses fall halfway between them. These
    ;; disjoint schedules give constant-time numbering and countdown spans,
    ;; even near the six-year save bound. Tick zero starts the opening span.
    (define (regular-attack-count tick)
      (if (< tick first-wave-tick) 0 (+ 1 (quotient (- tick first-wave-tick) wave-interval))))
    (define (next-attack-number tick)
      (+ 1 (+ (regular-attack-count tick) (quotient tick final-siege-tick))))
    (define (attack-countdown-span tick)
      (let* ((count (regular-attack-count tick))
             (regular (if (= count 0) 0 (+ first-wave-tick (* (- count 1) wave-interval))))
             (heavy (* (quotient tick final-siege-tick) final-siege-tick)))
        (- (next-attack-tick tick) (maximum regular heavy))))
    (define (outpost-distance world site)
      (distance (building-x site) (building-y site) (world-hub-x world) (world-hub-y world)))
    (define (exposed-outpost? world site best)
      (and (ready? site) (or (= (building-kind site) 1) (and (tower? site) (not (armed? site)))) (> (outpost-distance world site) 9)
           (or (null? best) (> (outpost-distance world site) (outpost-distance world (car best)))
               (and (= (outpost-distance world site) (outpost-distance world (car best)))
                    (< (distance (building-x site) (building-y site) (world-nest-x world) (world-nest-y world))
                       (distance (building-x (car best)) (building-y (car best)) (world-nest-x world) (world-nest-y world)))))))
    (define (outpost-target world buildings best)
      (if (null? buildings) best
          (outpost-target world (cdr buildings)
                          (if (exposed-outpost? world (car buildings) best) (list (car buildings)) best))))
    ;; Nest lanes touching rock breed lighter, faster raiders. The terrain
    ;; sample lies beyond the nest clearing so neighboring geology matters.
    (define (lane-kind world kind lane)
      (let ((x (+ (world-nest-x world) (if (= (remainder lane 3) 0) -12 12)))
            (y (+ (world-nest-y world) (- (remainder lane 5) 2))))
        (if (and (= kind 0) (not (ground? (world-seed world) x y))
                 (not (water? (world-seed world) x y))) 1 kind)))
    (define (enemy-health world kind rank)
      (let ((health (+ (enemy-rank-health rank) (* 15 (maximum 0 (- (threat-tier (world-tick world)) 6))))))
        (if (= kind 1) (quotient (* 4 health) 5) health)))
    (define (burrower-id? world id)
      (= (remainder (+ (remainder (world-seed world) 10) (remainder id 10)) 10) 0))
    (define (spawn-enemy world kind lane rank)
      (let* ((kind (lane-kind world kind lane))
             (target (if (= kind 1) (outpost-target world (world-buildings world) (empty-list)) (empty-list)))
             (x (+ (world-nest-x world) (- (remainder lane 3) 1))) (y (+ (world-nest-y world) 2))
             (enemy (make-enemy (world-next-id world) (cell-x x) (cell-y y)
                                (enemy-health world kind rank) kind
                                (if (null? target) 0 (building-id (car target))) (empty-list)
                                (burrower-id? world (world-next-id world)) rank)))
        (world-next-id-set (world-enemies-set world (append (world-enemies world) (list (route-enemy world enemy))))
                           (+ (world-next-id world) 1))))
    ;; Introduce one strongest enemy, a familiar previous rank, then mixed
    ;; escorts. Easy enemies remain present even after the six rank unlocks.
    (define (wave-rank rank index)
      (cond ((= index 0) rank) ((or (= rank 0) (= (remainder index 3) 2)) 0)
            ((= index 1) (- rank 1)) (else (remainder index rank))))
    (define (spawn-wave world kind count total rank)
      (if (or (= count 0) (>= (list-size (world-enemies world)) maximum-enemies)) world
          (let* ((index (- total count)) (behavior (if (and (= kind 2) (> index 0)) 0 kind))
                 (world (spawn-enemy world behavior (+ 14 (* 2 (remainder count 3))) (wave-rank rank index))))
            (spawn-wave world kind (- count 1) total rank))))
    (define (spawn-due world)
      (let* ((tick (world-tick world)) (count (attack-size tick)))
        (spawn-wave world (attack-kind tick) count count
                    (if (heavy-wave? tick) 6 (minimum 5 (maximum-enemy-rank tick))))))
    ;; ---- Excavation and enemy routes ----

    (define rock-health 80)
    (define (world-ground? world x y)
      (open-ground? (world-seed world) (world-breaches world) x y))
    (define (dig-at excavations cell)
      (if (null? excavations) (empty-list)
          (if (= (dig-cell (car excavations)) cell) (list (car excavations))
              (dig-at (cdr excavations) cell))))
    (define (world-rock-remaining world x y)
      (if (or (world-ground? world x y) (water? (world-seed world) x y)) 0
          (let ((found (dig-at (world-excavations world) (cell-index x y))))
            (if (null? found) rock-health (dig-remaining (car found))))))
    (define (dig-cells excavations)
      (if (null? excavations) (empty-list)
          (cons (dig-cell (car excavations)) (dig-cells (cdr excavations)))))
    (define (remove-dig excavations cell)
      (if (null? excavations) excavations
          (if (= (dig-cell (car excavations)) cell) (cdr excavations)
              (cons (car excavations) (remove-dig (cdr excavations) cell)))))
    (define (chip-rock world cell amount)
      (let* ((remaining (- (world-rock-remaining world (index-x cell) (index-y cell)) amount))
             (others (remove-dig (world-excavations world) cell)))
        (if (<= remaining 0)
            (world-breaches-set (world-excavations-set world others) (cons cell (world-breaches world)))
            (world-excavations-set world (cons (make-dig cell remaining) others)))))
    (define (digging-cell world enemy)
      (if (or (null? (enemy-path enemy)) (encounter? world enemy)) -1
          (let ((cell (car (enemy-path enemy))))
            (if (and (not (world-ground? world (index-x cell) (index-y cell)))
                     (not (water? (world-seed world) (index-x cell) (index-y cell)))
                     (or (enemy-burrower enemy) (not (null? (dig-at (world-excavations world) cell))))) cell -1))))
    (define (digging-count world enemies cell)
      (if (null? enemies) 0
          (+ (if (= (digging-cell world (car enemies)) cell) 1 0)
             (digging-count world (cdr enemies) cell))))
    (define (seen-cell? cells cell)
      (and (not (null? cells)) (or (= (car cells) cell) (seen-cell? (cdr cells) cell))))
    ;; One enemy chips one point per tick; cooperation is capped at two.
    ;; Even a crowd must spend four seconds opening one intact rock tile.
    (define (excavate-enemies world enemies seen)
      (if (null? enemies) world
          (let ((cell (digging-cell world (car enemies))))
            (if (or (< cell 0) (seen-cell? seen cell)) (excavate-enemies world (cdr enemies) seen)
                (excavate-enemies (chip-rock world cell (minimum 2 (digging-count world (world-enemies world) cell)))
                                  (cdr enemies) (cons cell seen))))))
    (define (enemy-path-cost world enemy path)
      (if (null? path) 0
          (+ (+ (if (= (enemy-kind enemy) 1) 6 8) (world-rock-remaining world (index-x (car path)) (index-y (car path))))
             (enemy-path-cost world enemy (cdr path)))))
    (define (faster-enemy-path world enemy current candidate)
      (if (and (not (null? candidate))
               (or (null? current) (< (enemy-path-cost world enemy candidate) (enemy-path-cost world enemy current)))) candidate current))
    (define (enemy-route world enemy x y)
      (let* ((a (quotient (enemy-x enemy) cell-size)) (b (quotient (enemy-y enemy) cell-size))
             (opened (append (world-breaches world) (dig-cells (world-excavations world))))
             (walk (walking-open-path (world-seed world) (world-breaches world) a b x y (empty-list) #t))
             (join (if (null? (world-excavations world)) walk
                       (walking-open-path (world-seed world) opened a b x y (empty-list) #t)))
             (tunnel (if (enemy-burrower enemy) (tunneling-path (world-seed world) a b x y) (empty-list))))
        (faster-enemy-path world enemy (faster-enemy-path world enemy walk join) tunnel)))
    (define (route-enemy world enemy)
      (let ((target (find-building (world-buildings world) (enemy-target enemy))))
        (enemy-path-set enemy (enemy-route world enemy
                                           (if (null? target) (world-hub-x world) (building-x (car target)))
                                           (if (null? target) (world-hub-y world) (building-y (car target)))))))
    (define (path-ends-at? path cell)
      (and (not (null? path))
           (if (null? (cdr path)) (= (car path) cell) (path-ends-at? (cdr path) cell))))
    (define (enemy-route-stale? world enemy)
      (let ((target (enemy-target-building world enemy)))
        (and (not (null? target))
             (if (null? (enemy-path enemy)) (null? (near-building enemy target))
                 (not (path-ends-at? (enemy-path enemy)
                                     (cell-index (building-x (car target)) (building-y (car target)))))))))
    ;; A relocated attacker keeps its ID but changes the route's destination.
    ;; Check that destination on the same bounded cadence as terrain shortcuts;
    ;; repeated shots from a stationary attacker keep valid detours intact.
    (define (refresh-enemy-route world enemy)
      (if (not (= (remainder (+ (world-tick world) (enemy-id enemy)) 20) 0)) enemy
          (cond ((enemy-route-stale? world enemy) (route-enemy world enemy))
                ((and (< (digging-cell world enemy) 0)
                      (or (not (null? (world-breaches world))) (not (null? (world-excavations world)))))
                 (enemy-path-set enemy (faster-enemy-path world enemy (enemy-path enemy)
                                                          (enemy-path (route-enemy world enemy)))))
                (else enemy))))

    ;; ---- Crowds spread into neighboring walking lanes ----

    ;; Pressure uses the same unmoved population for every enemy. IDs break an
    ;; exact overlap; no random state or additional saved fields are needed.
    (define (neighbor-pressure enemy other horizontal)
      (let ((gap (distance (enemy-x enemy) (enemy-y enemy) (enemy-x other) (enemy-y other)))
            (side (if horizontal (- (enemy-y enemy) (enemy-y other)) (- (enemy-x enemy) (enemy-x other)))))
        (if (or (= (enemy-id enemy) (enemy-id other)) (<= (enemy-hp other) 0) (>= gap 120)) 0
            (* (- 120 gap) (if (or (> side 0) (and (= side 0) (> (enemy-id enemy) (enemy-id other)))) 1 -1)))))
    (define (crowd-pressure enemy enemies horizontal pressure)
      (if (null? enemies) pressure
          (crowd-pressure enemy (cdr enemies) horizontal
                          (+ pressure (neighbor-pressure enemy (car enemies) horizontal)))))
    (define (enemy-lane-cell? world cell side)
      (let* ((next (+ cell side))
             (sites (building-at (world-buildings world) (index-x next) (index-y next))))
        (and (= (distance (index-x cell) (index-y cell) (index-x next) (index-y next)) 1)
             (world-ground? world (index-x cell) (index-y cell))
             (world-ground? world (index-x next) (index-y next))
             (or (null? sites) (not (and (= (building-kind (car sites)) 4) (ready? (car sites))))))))
    ;; Require nine straight steps, replace the first eight with a parallel
    ;; lane, then reconnect. Its eight-step straight prefix cannot accept a
    ;; nested detour, so even fast enemies finish the lane before spreading
    ;; again. Every edge stays adjacent; blocked lanes fail as a whole.
    (define (parallel-enemy-path world path previous step side remaining)
      (cond ((= remaining 0)
             (if (and (not (null? path)) (= (car path) (+ previous step))) (cons previous path) (empty-list)))
            ((or (null? path) (not (= (car path) (+ previous step)))
                 (not (enemy-lane-cell? world (car path) side))) (empty-list))
            (else (let ((tail (parallel-enemy-path world (cdr path) (car path) step side (- remaining 1))))
                    (if (null? tail) tail (cons (+ (car path) side) tail))))))
    (define (spread-enemy-route world enemy cell step pressure)
      (let ((side (* (if (or (= step 1) (= step -1)) map-width 1) (if (> pressure 0) 1 -1))))
        (if (or (= step 0) (and (<= pressure 40) (>= pressure -40))
                (> (list-size (enemy-path enemy)) 1022) (not (enemy-lane-cell? world cell side))) enemy
                (let ((path (parallel-enemy-path world (enemy-path enemy) cell step side 8)))
                  (if (null? path) enemy (enemy-path-set enemy (cons (+ cell side) path)))))))
    ;; Stagger the bounded neighbor scans across eight-tick windows. All lane
    ;; decisions happen at cell centers; a lone enemy keeps its exact path.
    (define (spread-enemy world enemy)
      (if (and (= (remainder (enemy-x enemy) cell-size) 20)
               (= (remainder (enemy-y enemy) cell-size) 20)
               (= (remainder (+ (quotient (world-tick world) 8) (remainder (enemy-id enemy) 4)) 4) 0))
          (let* ((cell (cell-index (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size)))
                 (step (- (car (enemy-path enemy)) cell)))
            (spread-enemy-route world enemy cell step
                                (crowd-pressure enemy (world-enemies world) (or (= step 1) (= step -1)) 0)))
          enemy))
    (define (walk-enemy world enemy)
      (let* ((next (car (enemy-path enemy))) (x (cell-x (index-x next))) (y (cell-y (index-y next)))
             (speed (if (= (enemy-kind enemy) 1) 7 5))
             (moved (if (= (enemy-x enemy) x) (enemy-y-set enemy (approach (enemy-y enemy) y speed))
                        (enemy-x-set enemy (approach (enemy-x enemy) x speed)))))
        (if (not (world-ground? world (index-x next) (index-y next))) enemy
            (if (and (= (enemy-x moved) x) (= (enemy-y moved) y))
                (enemy-path-set moved (cdr (enemy-path moved))) moved))))
    (define (march-enemies world enemies)
      (if (null? enemies) enemies
          (let* ((enemy (car enemies))
                 (enemy (if (and (> (enemy-target enemy) 0)
                                 (null? (find-building (world-buildings world) (enemy-target enemy))))
                            (route-enemy world (enemy-target-set enemy 0)) (refresh-enemy-route world enemy))))
            (cons (if (or (null? (enemy-path enemy)) (encounter? world enemy)) enemy
                      (walk-enemy world (spread-enemy world enemy)))
                  (march-enemies world (cdr enemies))))))
    (define (enemy-visible? world enemy)
      (visible? world (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size)))
    (define artillery-range (* 6 cell-size))
    (define (root-step square guess)
      (let ((next (quotient (+ guess (quotient square guess)) 2)))
        (if (>= next guess) guess (root-step square next))))
    (define (artillery-damage x y a b)
      (let* ((dx (- x a)) (dy (- y b)) (square (+ (* dx dx) (* dy dy)))
             (length (if (= square 0) 0 (root-step square square))))
        (if (> length artillery-range) 0
            (+ 6 (quotient (* 18 (- artillery-range length)) artillery-range)))))
    (define (building-shot-damage building x y)
      (let ((damage (artillery-damage (cell-x (building-x building)) (cell-y (building-y building)) x y)))
        (if (= (building-kind building) 2) (quotient (* damage (+ (building-level building) 1)) 2) damage)))
    (define (choose-target world building enemies best)
      (if (null? enemies) best
          (let ((enemy (car enemies)))
            (choose-target world building (cdr enemies)
                           (if (and (> (enemy-hp enemy) 0) (enemy-visible? world enemy)
                                    (within? (enemy-x enemy) (enemy-y enemy)
                                             (cell-x (building-x building)) (cell-y (building-y building)) artillery-range)
                                    (clear-open-shot? (world-seed world) (world-breaches world) (cell-x (building-x building)) (cell-y (building-y building))
                                                      (enemy-x enemy) (enemy-y enemy))
                                    (or (null? best) (> (enemy-kind enemy) (enemy-kind (car best)))
                                        (and (= (enemy-kind enemy) (enemy-kind (car best)))
                                             (< (distance (enemy-x enemy) (enemy-y enemy) (cell-x (world-hub-x world)) (cell-y (world-hub-y world)))
                                                (distance (enemy-x (car best)) (enemy-y (car best)) (cell-x (world-hub-x world)) (cell-y (world-hub-y world)))))))
                               (list enemy) best)))))
    (define (retaliate-enemy world enemy attacker amount)
      (let ((wounded (enemy-hp-set enemy (- (enemy-hp enemy) amount))))
        (if (or (<= (enemy-hp wounded) 0) (= (enemy-target wounded) attacker)) wounded
            (route-enemy world (enemy-target-set wounded attacker)))))
    (define (hurt-enemy world enemies id attacker amount)
      (if (null? enemies) enemies
          (cons (if (= (enemy-id (car enemies)) id) (retaliate-enemy world (car enemies) attacker amount)
                    (car enemies)) (hurt-enemy world (cdr enemies) id attacker amount))))
    (define (fire-building world building)
      ;; Aim records an actual shot, so its tracer cannot bend while cooling down.
      (if (> (building-cooldown building) 0) world
          (let ((target (choose-target world building (world-enemies world) (empty-list))))
            (if (null? target) (fire-nest world building)
                (let* ((enemy (car target))
                       (aimed (building-aim-y-set (building-aim-x-set building (enemy-x enemy)) (enemy-y enemy))))
                  (world-enemies-set (put-building world (building-cooldown-set aimed 8))
                                     (hurt-enemy world (world-enemies world) (enemy-id enemy) (building-id building)
                                                 (building-shot-damage building (enemy-x enemy) (enemy-y enemy)))))))))
    (define (nest-in-range? world building)
      (let ((x (cell-x (world-nest-x world))) (y (cell-y (world-nest-y world)))
            (a (cell-x (building-x building))) (b (cell-y (building-y building))))
        (and (> (world-nest-hp world) 0) (visible? world (world-nest-x world) (world-nest-y world))
             (within? x y a b artillery-range) (clear-open-shot? (world-seed world) (world-breaches world) a b x y))))
    (define (fire-nest world building)
      (if (not (nest-in-range? world building)) world
          (let* ((x (cell-x (world-nest-x world))) (y (cell-y (world-nest-y world)))
                 (aimed (building-aim-y-set (building-aim-x-set building x) y))
                 (damage (building-shot-damage building x y)))
            (world-nest-hp-set (put-building world (building-cooldown-set aimed 8))
                               (maximum 0 (- (world-nest-hp world) damage))))))
    (define (fire-buildings world buildings)
      (if (null? buildings) world
          (let* ((building (car buildings))
                 (building (building-cooldown-set building (maximum 0 (- (building-cooldown building) 1))))
                 (world (put-building world building)))
            (fire-buildings (if (and (ready? building) (armed? building))
                                (fire-building world building) world) (cdr buildings)))))
    (define (enemy-survivors enemies)
      (if (null? enemies) enemies
          (if (> (enemy-hp (car enemies)) 0) (cons (car enemies) (enemy-survivors (cdr enemies)))
              (enemy-survivors (cdr enemies)))))
    ;; ---- Encounters respect walls and a committed attacker's priority ----

    ;; The nine hub tile centers form a square; their outer attack boundary
    ;; keeps the same rounded 45-pixel reach as the former single-cell hub.
    (define (near-hub? world enemy)
      (let ((x (cell-x (world-hub-x world))) (y (cell-y (world-hub-y world))))
        (within? (enemy-x enemy) (enemy-y enemy)
                 (minimum (+ x cell-size) (maximum (- x cell-size) (enemy-x enemy)))
                 (minimum (+ y cell-size) (maximum (- y cell-size) (enemy-y enemy))) 45)))
    (define (enemy-target-building world enemy)
      (let ((target (find-building (world-buildings world) (enemy-target enemy))))
        (if (and (not (null? target)) (ready? (car target))) target (empty-list))))
    (define (near-worker world enemy bots)
      (if (null? bots) (empty-list)
          (let ((bot (car bots)))
            (if (and (> (bot-hp bot) 0) (not (sheltered? world bot))
                     (within? (enemy-x enemy) (enemy-y enemy) (bot-x bot) (bot-y bot) 56))
                (list bot) (near-worker world enemy (cdr bots))))))
    (define (near-building enemy buildings)
      (if (null? buildings) (empty-list)
          (let ((building (car buildings)))
            (if (and (ready? building)
                     (within? (enemy-x enemy) (enemy-y enemy)
                              (cell-x (building-x building)) (cell-y (building-y building)) 56))
                (list building) (near-building enemy (cdr buildings))))))
    (define (near-wall enemy buildings)
      (if (null? buildings) (empty-list)
          (let ((site (car buildings)))
            (if (and (= (building-kind site) 4) (ready? site)
                     (within? (enemy-x enemy) (enemy-y enemy) (cell-x (building-x site)) (cell-y (building-y site)) 56))
                (list site) (near-wall enemy (cdr buildings))))))
    (define (encounter? world enemy)
      (let ((target (enemy-target-building world enemy)))
        (or (not (null? (near-wall enemy (world-buildings world))))
            (if (null? target)
                (or (near-hub? world enemy) (not (null? (near-worker world enemy (world-bots world))))
                    (not (null? (near-building enemy (world-buildings world)))))
                (not (null? (near-building enemy target)))))))
    (define attack-alert-ticks 80)
    (define attack-alert-radius 4)
    (define (retained-alerts alerts x y tick remaining)
      (if (or (= remaining 0) (null? alerts)) (empty-list)
          (let ((alert (car alerts)))
            (if (or (> (- tick (alert-tick alert)) attack-alert-ticks) (within? x y (alert-x alert) (alert-y alert) attack-alert-radius))
                (retained-alerts (cdr alerts) x y tick remaining)
                (cons alert (retained-alerts (cdr alerts) x y tick (- remaining 1)))))))
    (define (record-attack world x y kind)
      (world-alerts-set world (cons (make-alert x y kind (world-tick world))
                                    (retained-alerts (world-alerts world) x y (world-tick world) 3))))
    (define (attack-target world enemy)
      (let* ((damage (enemy-rank-damage (enemy-rank enemy)))
             (wall (near-wall enemy (world-buildings world)))
             (target (enemy-target-building world enemy))
             (worker (near-worker world enemy (world-bots world)))
             (site (near-building enemy (if (null? target) (world-buildings world) target))))
        (cond ((not (null? wall)) (damage-building world (car wall) damage))
              ((not (null? target)) (if (null? site) world (damage-building world (car site) damage)))
              ((and (near-hub? world enemy) (> (world-hull world) 0))
               (record-attack (world-hull-set world (maximum 0 (- (world-hull world) damage))) (world-hub-x world) (world-hub-y world) 0))
              ((not (null? worker))
               (let ((bot (car worker)))
                 (record-attack (put-bot world (bot-hp-set bot (maximum 0 (- (bot-hp bot) damage))))
                                (quotient (bot-x bot) cell-size) (quotient (bot-y bot) cell-size) 4)))
              ((not (null? site))
               (damage-building world (car site) damage))
              (else world))))
    (define (damage-building world building damage)
      (record-attack (put-building world (building-hp-set building (maximum 0 (- (building-hp building) damage))))
                     (building-x building) (building-y building) (if (= (building-kind building) 4) 5 (building-kind building))))
    ;; Tick cadence belongs to the attacker, not a freshly selected target.
    ;; Switching between workers and buildings cannot reset or accelerate hits.
    (define (attack-targets world enemies)
      (if (null? enemies) world
          (attack-targets (attack-target world (car enemies)) (cdr enemies))))
    (define (remove-building buildings id)
      (if (null? buildings) buildings
          (if (= (building-id (car buildings)) id) (cdr buildings)
              (cons (car buildings) (remove-building (cdr buildings) id)))))
    (define (ore-cargo? bot)
      (or (= (bot-job bot) 2) (= (bot-job bot) 4) (= (bot-job bot) 12)
          (and (= (bot-job bot) 7)
               (or (= (bot-timer bot) 2) (= (bot-timer bot) 4) (= (bot-timer bot) 12)))))
    (define (kit-carrier? bot)
      (and (> (bot-cargo bot) 4)
           (or (= (bot-job bot) 3) (= (bot-job bot) 5)
               (and (= (bot-job bot) 7) (= (bot-timer bot) 5)))))
    (define (settle-dead-worker world bot)
      (let* ((found (find-building (world-buildings world) (bot-order bot)))
             (world (if (null? found) world (put-building world (construction-stage-set (car found) 0))))
             (world (world-casualties-set world (+ (world-casualties world) 1)))
             ;; Cancelled hub work leaves its unconsumed materials at the hub.
             (world (cond ((production-worker? bot) (spend world (- 0 worker-cost)))
                          ((repair-worker? bot) (spend world (- 0 (bot-target bot)))) (else world))))
        (cond ((ore-cargo? bot) (world-lost-ore-set world (+ (world-lost-ore world) (bot-cargo bot))))
              ((kit-carrier? bot)
               (lose-carried-kit world bot))
              (else world))))
    (define (lose-carried-kit world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (if (null? found) world
            (let ((world (refund-reserved-kit world (car found))))
              (abandon-project world (car (find-building (world-buildings world) (bot-target bot))))))))
    (define (settle-workers world bots alive)
      (if (null? bots) (world-bots-set world (reverse alive))
          (if (> (bot-hp (car bots)) 0) (settle-workers world (cdr bots) (cons (car bots) alive))
              (settle-workers (settle-dead-worker world (car bots)) (cdr bots) alive))))
    (define (cancel-destroyed-upgrades world buildings)
      (if (null? buildings) world
          (let* ((site (car buildings)) (lost (and (<= (building-hp site) 0) (arming? site)))
                 (world (if (and lost (not (= (building-source site) (building-id site))))
                            (refund-reserved-kit world site) world))
                 (world (if lost (cancel-workers world (world-bots world) (building-id site)) world)))
            (cancel-destroyed-upgrades world (cdr buildings)))))
    (define (settle-buildings world buildings standing)
      (if (null? buildings) (world-buildings-set world (reverse standing))
          (let ((building (car buildings)))
            (if (> (building-hp building) 0) (settle-buildings world (cdr buildings) (cons building standing))
                (settle-buildings
                 (world-lost-set (world-lost-ore-set world (+ (world-lost-ore world) (raw-stock building)))
                                 (+ (world-lost world) 1)) (cdr buildings) standing)))))
    (define (settle-supplies world buildings)
      (if (null? buildings) world
          (let* ((building (car buildings)) (source (building-source building))
                 (lost (and (> source 0) (not (= (building-stage building) 2)) (> (uncollected-supplies building) 0)
                            (null? (find-building (world-buildings world) source)))))
            (settle-supplies
             (if lost (abandon-project (cancel-workers world (world-bots world) (building-id building)) building) world)
             (cdr buildings)))))
    (define (emergency-worker world)
      ;; Only total worker loss activates the hub's 60-tick recovery safeguard.
      ;; This single inert worker cannot build, mine or reserve a paid order.
      (if (and (> (world-hull world) 0) (null? (world-bots world)))
          (world-next-id-set
           (world-bots-set world (list (bot-timer-set (bot-job-set (idle-bot (world-seed world) (world-next-id world)) 6) 60)))
           (+ (world-next-id world) 1)) world))
    (define (clear-casualties world)
      (let* ((alive (enemy-survivors (world-enemies world)))
             (world (world-kills-set (world-enemies-set world alive)
                                     (+ (world-kills world) (- (list-size (world-enemies world)) (list-size alive)))))
             (world (settle-workers world (world-bots world) (empty-list)))
             (world (cancel-destroyed-upgrades world (world-buildings world))))
        (let ((world (settle-buildings world (world-buildings world) (empty-list))))
          (emergency-worker (settle-supplies world (world-buildings world))))))
    (define (fight world)
      (let* ((world (excavate-enemies world (world-enemies world) (empty-list)))
             (world (world-enemies-set world (march-enemies world (world-enemies world))))
             (world (clear-casualties (fire-buildings world (world-buildings world)))))
        (clear-casualties (if (= (remainder (world-tick world) 10) 0)
                              (attack-targets world (world-enemies world)) world))))
    (define (finish world)
      (world-outcome-set world
                         (cond ((<= (world-nest-hp world) 0) 3)
                               ((<= (world-hull world) 0) 1)
                               (else 0))))
    ;; Production and worker arrivals precede combat in this tick. A completed
    ;; kit is consumed before damage; casualty settlement sees only remaining
    ;; owned cargo. Pausing leaves this entire simulation-time boundary untouched.
    (define (advance-world world)
      (if (or (not (world-started world)) (not (active? world)) (= (world-paused world) 1)) world
          (let* ((world (rebuild-transport (world-tick-set world (minimum run-end-tick (+ (world-tick world) 1)))))
                 (world (if (= (remainder (world-tick world) 10) 0)
                            (produce-buildings world (world-buildings world)) world))
                 (world (advance-rails world))
                 (world (advance-moves world (world-buildings world)))
                 (world (dispatch-buildings world (world-buildings world))))
            (finish (rebuild-transport (fight (spawn-due (advance-bots world (world-bots world)))))))))))
