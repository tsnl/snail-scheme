;; Derived transport constructs typed values; the colony then establishes bounded
;; geography, physical ownership and conservation before the runtime may commit.
(define-library (siegework state)
  (export encode-world decode-world validate-world)
  (import
   (scheme base)
   (scheme immutable)
   (application serialization)
   (siegework model)
   (siegework terrain)
   (only (lofi core) ann -> I32 I64)
   (only (lofi base) i32->i64 i64->i32 unreachable))
  (begin

    ;; ---- Bounded colony values ----

    (define (bounded? value low high) (and (>= value low) (<= value high)))
    (define (require! valid) (unless valid (unreachable)))
    (define (check-building! value world)
      (require! (and (> (building-id value) 0) (bounded? (building-kind value) 1 3)
                     (world-ground? world (building-x value) (building-y value))
                     (bounded? (building-level value) 1 3)
                     (bounded? (building-hp value) 1 (building-health (building-kind value)))
                     (if (= (building-kind value) 1) (> (deposit-rate (world-seed world) (building-x value) (building-y value)) 0)
                         (= (deposit-rate (world-seed world) (building-x value) (building-y value)) 0))
                     (bounded? (building-aim-x value) 0 (- (* map-width cell-size) 1)) (bounded? (building-aim-y value) 0 (- (* map-height cell-size) 1))
                     (>= (building-stock value) 0)
                     (if (ready? value)
                         (if (= (building-kind value) 1) (<= (building-stock value) 120)
                             (or (tower? value) (= (building-stock value) 0)))
                         (or (= (building-stock value) 0) (and (= (construction-cost value) 50) (= (building-stock value) 25))))
                     (or (ready? value) (not (tower? value)) (< (building-level value) 3))
                     (or (ready? value) (not (= (building-kind value) 2)) (= (building-level value) 1))
                     (or (bounded? (building-stage value) 0 3)
                         (and (or (tower? value) (= (building-kind value) 2))
                              (or (= (building-stage value) 4) (= (building-stage value) 5) (= (building-stage value) 7))))
                     (bounded? (building-armed value) 0 1)
                     (or (not (arming? value)) (and (< (building-level value) 3) (not (moving? value))))
                     (or (= (building-armed value) 0)
                         (and (tower? value) (ready? value) (> (building-level value) 1)))
                     (bounded? (building-cooldown value) 0 8) (>= (building-source value) 0)
                     (if (moving? value)
                         (and (ready? value) (not (= (building-kind value) 1))
                              (world-ground? world (building-move-x value) (building-move-y value))
                              (bounded? (distance (building-x value) (building-y value) (building-move-x value) (building-move-y value)) 1 2))
                         (and (= (building-move-x value) -1) (= (building-move-y value) -1))))))
    (define (check-bot! value)
      (require! (and (> (bot-id value) 0) (bounded? (bot-x value) 0 (- (* map-width cell-size) 1))
                     (bounded? (bot-y value) 0 (- (* map-height cell-size) 1)) (bounded? (bot-job value) 0 15)
                     (>= (bot-target value) 0) (bounded? (bot-cargo value) 0 50)
                     (bounded? (bot-timer value) 0 60) (bounded? (bot-hp value) 1 14)
                     (>= (bot-order value) 0) (>= (bot-source value) 0))))
    (define (check-enemy! value)
      (require! (and (> (enemy-id value) 0) (bounded? (enemy-x value) 0 (- (* map-width cell-size) 1))
                     (bounded? (enemy-y value) 0 (- (* map-height cell-size) 1)) (bounded? (enemy-hp value) 1 maximum-enemy-health)
                     (bounded? (enemy-kind value) 0 2) (bounded? (enemy-rank value) 0 6) (>= (enemy-target value) 0))))
    (define (check-survey! value world)
      (require! (and (world-ground? world (survey-x value) (survey-y value))
                     (bounded? (survey-radius value) 4 10))))
    (define (check-world-fields! world)
      (require! (and (bounded? (world-tick world) 0 run-end-tick) (bounded? (world-outcome world) 0 3)
                     (or (world-started world)
                         (and (= (world-tick world) 0) (= (world-spent world) 0)
                              (null? (world-buildings world)) (null? (world-enemies world))))
                     (not (= (world-outcome world) 2))
                     (bounded? (world-last-reveal-tick world) -100 (world-tick world))
                     (or (= (world-last-reveal-tick world) -100) (>= (world-last-reveal-tick world) 0))
                     (>= (world-credits world) 0) (bounded? (world-hull world) 0 300)
                     (>= (world-kills world) 0) (> (world-next-id world) 0) (bounded? (world-focus world) 0 2)
                     (bounded? (world-plan world) 0 9) (>= (world-delivered world) 0)
                     (bounded? (world-local-spent world) 0 (world-spent world)) (>= (world-produced world) 0) (>= (world-spent world) 0) (>= (world-lost world) 0)
                     (bounded? (world-notice world) 0 39) (bounded? (world-paused world) 0 1)
                     (bounded? (world-hub-capacity-level world) 0 maximum-hub-capacity-level)
                     (bounded? (world-seed world) 1 65535) (>= (world-casualties world) 0)
                     (>= (world-lost-ore world) 0) (>= (world-run-marker world) 0))))
    (define (check-outcome! world)
      (cond
       ((= (world-outcome world) 0) (require! (and (> (world-hull world) 0) (> (world-nest-hp world) 0))))
       ((= (world-outcome world) 1) (require! (and (= (world-hull world) 0) (> (world-nest-hp world) 0))))
       ((= (world-outcome world) 3) (require! (= (world-nest-hp world) 0)))
       (else (require! #f))))
    ;; Capacity only rises. Every living worker and paid recruit owns one of
    ;; the completed hub tier's places; pending upgrades grant none yet.
    (define (check-world-counts! world)
      (require! (and (<= (list-size (world-buildings world)) maximum-buildings)
                     (<= (+ (list-size (world-bots world)) (pending-workers (world-bots world))) (worker-capacity world))
                     (<= (list-size (world-enemies world)) maximum-enemies) (bounded? (list-size (world-surveys world)) 1 maximum-surveys)
                     (<= (list-size (world-alerts world)) 4) (<= (list-size (world-rails world)) maximum-buildings))))
    (define (check-surveys! world surveys)
      (unless (null? surveys)
        (check-survey! (car surveys) world)
        (check-surveys! world (cdr surveys))))
    (define (check-alerts! world alerts)
      (unless (null? alerts)
        (let ((alert (car alerts)))
          (require! (and (inside? (alert-x alert) (alert-y alert)) (bounded? (alert-kind alert) 0 4)
                         (bounded? (alert-tick alert) 0 (world-tick world)))))
        (check-alerts! world (cdr alerts))))

    ;; ---- Cross-record ownership and route evidence ----

    (define (contains-id? ids id)
      (and (not (null? ids)) (or (= (car ids) id) (contains-id? (cdr ids) id))))
    (define (building-ids values)
      (if (null? values) (empty-list) (cons (building-id (car values)) (building-ids (cdr values)))))
    (define (bot-ids values)
      (if (null? values) (empty-list) (cons (bot-id (car values)) (bot-ids (cdr values)))))
    (define (production-ids bots)
      (if (null? bots) (empty-list)
          (let ((rest (production-ids (cdr bots))))
            (if (production-worker? (car bots)) (cons (bot-target (car bots)) rest) rest))))
    (define (enemy-ids values)
      (if (null? values) (empty-list) (cons (enemy-id (car values)) (enemy-ids (cdr values)))))
    (define (check-identities! ids next)
      (unless (null? ids)
        (require! (and (< (car ids) next) (not (contains-id? (cdr ids) (car ids)))))
        (check-identities! (cdr ids) next)))
    (define (construction-carrier? bot id)
      (and (= (bot-target bot) id) (> (bot-cargo bot) 4)
           (or (= (bot-job bot) 3) (= (bot-job bot) 5)
               (and (= (bot-job bot) 7) (= (bot-timer bot) 5)))))
    (define (construction-claims bots id)
      (if (null? bots) 0 (+ (if (construction-carrier? (car bots) id) 1 0)
                            (construction-claims (cdr bots) id))))
    (define (reservation-claims bots id)
      (if (null? bots) 0 (+ (if (= (bot-order (car bots)) id) 1 0)
                            (reservation-claims (cdr bots) id))))
    (define (remembered-observer? surveys building)
      (and (not (null? surveys))
           (or (and (= (survey-x (car surveys)) (building-x building))
                    (= (survey-y (car surveys)) (building-y building))
                    (>= (survey-radius (car surveys)) (building-radius building)))
               (remembered-observer? (cdr surveys) building))))
    (define (unique-move? buildings x y)
      (or (null? buildings)
          (and (not (and (= (building-move-x (car buildings)) x) (= (building-move-y (car buildings)) y)))
               (unique-move? (cdr buildings) x y))))
    (define (local-project-cost buildings)
      (if (null? buildings) 0
          (+ (if (> (building-source (car buildings)) 0) (construction-cost (car buildings)) 0)
             (local-project-cost (cdr buildings)))))
    (define (local-refund-cost bots)
      (if (null? bots) 0
          (+ (if (and (> (bot-source (car bots)) 0) (= (bot-target (car bots)) 0)) (bot-cargo (car bots)) 0)
             (local-refund-cost (cdr bots)))))
    (define (check-building-supply! world building)
      (require! (and (< (building-source building) (world-next-id world))
                     (or (not (= (building-stage building) 2)) (= (building-source building) 0))))
      (when (and (> (building-source building) 0)
                 (> (uncollected-supplies building) 0))
        (let ((source (find-building (world-buildings world) (building-source building))))
          (require! (and (not (null? source)) (ready? (car source))
                         (or (= (building-kind (car source)) 1) (tower? (car source)))))))
      (when (= (building-kind building) 1)
        (require! (<= (+ (building-stock building) (reserved-stock (world-buildings world) (building-id building))) 120))))
    (define (check-relocation! world building later)
      ;; Old saves may contain a destination beside the former one-tile hub.
      ;; Decoding preserves it; advancing the move refunds that obsolete order.
      (when (moving? building)
        (let ((x (building-move-x building)) (y (building-move-y building)))
          (require! (and (surveyed? (world-surveys world) x y)
                         (not (and (= x (world-hub-x world)) (= y (world-hub-y world))))
                         (= (deposit-rate (world-seed world) x y) 0)
                         (unique-move? later x y) (null? (building-at (world-buildings world) x y)))))))
    (define (check-buildings! world buildings)
      (unless (null? buildings)
        (let ((building (car buildings)))
          (check-building! building world)
          (check-building-supply! world building)
          (check-relocation! world building (cdr buildings))
          (require! (= (construction-claims (world-bots world) (building-id building))
                       (if (= (construction-stage building) 1) 1 0)))
          (require! (= (reservation-claims (world-bots world) (building-id building))
                       (if (= (construction-stage building) 3) 1 0)))
          (require! (or (null? (cdr buildings)) (< (building-id building) (building-id (car (cdr buildings))))))
          (require! (null? (building-at (cdr buildings) (building-x building) (building-y building))))
          (require! (or (not (ready? building))
                        (remembered-observer? (world-surveys world) building)))
          (require! (<= (+ (workers-at (world-bots world) 8 (building-id building))
                           (workers-at (world-bots world) 9 (building-id building))) (building-level building))))
        (check-buildings! world (cdr buildings))))
    (define (check-route! world path previous surveys known first)
      (unless (null? path)
        (let ((step (car path)))
          (require! (and (bounded? step 0 (- (* map-width map-height) 1)) (world-ground? world (index-x step) (index-y step))))
          (require! (if first (<= (distance (index-x previous) (index-y previous) (index-x step) (index-y step)) 1)
                        (= (distance (index-x previous) (index-y previous) (index-x step) (index-y step)) 1)))
          (require! (or (not known) (surveyed? surveys (index-x step) (index-y step))))
          (check-route! world (cdr path) step surveys known #f))))
    (define (last-cell path)
      (if (null? (cdr path)) (car path) (last-cell (cdr path))))
    (define (arrives-at? bot x y)
      (if (null? (bot-path bot)) (and (= (bot-x bot) (cell-x x)) (= (bot-y bot) (cell-y y)))
          (= (last-cell (bot-path bot)) (cell-index x y))))
    (define (check-kit! world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (require! (not (null? found)))
        (let ((building (car found)))
          (require! (and (= (construction-stage building) 1)
                         (= (bot-cargo bot) (construction-kit-size building))
                         (= (bot-source bot) (building-source building))))
          (when (= (bot-job bot) 3) (require! (arrives-at? bot (building-x building) (building-y building)))))))
    (define (check-outward-target! world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (when (= (bot-target bot) 0) (require! (and (= (bot-job bot) 4) (arrives-at? bot (world-hub-x world) (world-hub-y world)))))
        (unless (null? found)
          (let ((building (car found)))
            (require! (and (ready? building) (arrives-at? bot (building-x building) (building-y building))))
            (when (or (= (bot-job bot) 1) (= (bot-job bot) 8) (= (bot-job bot) 9))
              (require! (= (building-kind building) 1)))))))
    (define (check-deposit! world bot)
      (require! (<= (bot-cargo bot) 16))
      (if (= (bot-target bot) 0) (require! (arrives-at? bot (world-hub-x world) (world-hub-y world)))
          (let ((found (find-building (world-buildings world) (bot-target bot))))
            ;; A destroyed destination is rerouted on the worker's next tick.
            (unless (null? found)
              (require! (and (ready? (car found)) (tower? (car found))
                             (arrives-at? bot (building-x (car found)) (building-y (car found)))))))))
    (define (check-returned-kit! world bot)
      (if (= (bot-target bot) 0)
          (require! (or (= (bot-cargo bot) 25) (= (bot-cargo bot) 40)))
          (check-kit! world bot)))
    (define (returned-kit-destination? world bot)
      (or (arrives-at? bot (world-hub-x world) (world-hub-y world))
          (let ((source (find-building (world-buildings world) (bot-source bot)))
                (project (find-building (world-buildings world) (bot-target bot))))
            (and (not (null? source)) (not (null? project)) (> (uncollected-supplies (car project)) 0)
                 (arrives-at? bot (building-x (car source)) (building-y (car source)))))))
    (define (check-reservation! world bot)
      (when (> (bot-order bot) 0)
        (let ((found (find-building (world-buildings world) (bot-order bot))) (job (bot-job bot)))
          (require! (and (not (null? found)) (= (construction-stage (car found)) 3)
                         (or (= job 0) (= job 2) (= job 5) (= job 7) (= job 10) (= job 11)))))))
    (define (check-production! world bot)
      (require! (and (= (bot-order bot) 0) (= (bot-source bot) 0) (<= (bot-cargo bot) 16)))
      (if (production-worker? bot) (require! (> (bot-target bot) 0))
          (require! (and (= (list-size (world-bots world)) 1) (> (world-casualties world) 0))))
      (when (= (bot-job bot) 4) (require! (arrives-at? bot (world-hub-x world) (world-hub-y world))))
      (when (= (bot-job bot) 6)
        (require! (and (= (bot-cargo bot) 0) (null? (bot-path bot)) (arrives-at? bot (world-hub-x world) (world-hub-y world))
                       (<= (bot-timer bot) (if (= (bot-target bot) 0) 60 worker-assembly-ticks))))))
    (define (check-repair! world bot)
      (require! (and (bounded? (bot-target bot) 1 150) (= (bot-order bot) 0)
                     (= (bot-source bot) 0) (<= (bot-cargo bot) 16)))
      (when (= (bot-job bot) 12)
        (require! (arrives-at? bot (world-hub-x world) (world-hub-y world))))
      (when (= (bot-job bot) 13)
        (require! (and (= (bot-cargo bot) 0) (null? (bot-path bot))
                       (arrives-at? bot (world-hub-x world) (world-hub-y world))
                       (<= (bot-timer bot) repair-ticks)))))
    (define (check-hub-upgrade! world bot)
      (require! (and (< (world-hub-capacity-level world) maximum-hub-capacity-level)
                     (= (bot-target bot) (hub-upgrade-cost world)) (= (bot-order bot) 0)
                     (= (bot-source bot) 0) (<= (bot-cargo bot) 16)))
      (when (= (bot-job bot) 14)
        (require! (arrives-at? bot (world-hub-x world) (world-hub-y world))))
      (when (= (bot-job bot) 15)
        (require! (and (= (bot-cargo bot) 0) (null? (bot-path bot))
                       (arrives-at? bot (world-hub-x world) (world-hub-y world))
                       (<= (bot-timer bot) hub-upgrade-ticks)))))
    (define (check-activity! world bot)
      (let ((job (bot-job bot)) (cargo (bot-cargo bot)) (timer (bot-timer bot)))
        (require! (and (or (repair-worker? bot) (hub-upgrade-worker? bot) (< (bot-target bot) (world-next-id world)))
                       (cond ((or (= job 6) (= job 13) (= job 15)) (> timer 0))
                             ((= job 7) (or (= timer 2) (= timer 4) (= timer 5) (= timer 11) (= timer 12) (= timer 14)))
                             (else (= timer 0)))))
        (cond ((or (= job 0) (= job 10))
               (require! (and (= cargo 0) (= (bot-target bot) 0) (null? (bot-path bot)))))
              ((or (= job 4) (= job 6)) (check-production! world bot))
              ((or (= job 12) (= job 13)) (check-repair! world bot))
              ((or (= job 14) (= job 15)) (check-hub-upgrade! world bot))
              ((or (= job 1) (= job 8) (= job 9))
               (require! (= cargo 0)) (check-outward-target! world bot)
               (when (= job 8) (require! (null? (bot-path bot)))))
              ((= job 2) (check-deposit! world bot))
              ((= job 3) (check-kit! world bot))
              ((= job 5) (require! (returned-kit-destination? world bot)) (check-returned-kit! world bot))
              ((= job 11)
               (require! (and (= cargo 0) (> (bot-order bot) 0)))
               (let* ((building (car (find-building (world-buildings world) (bot-order bot))))
                      (source (find-building (world-buildings world) (building-source building))))
                 (require! (= (bot-target bot) (building-source building)))
                 (require! (arrives-at? bot (if (null? source) (world-hub-x world) (building-x (car source)))
                                        (if (null? source) (world-hub-y world) (building-y (car source)))))))
              ((= timer 11) (require! (and (= cargo 0) (> (bot-order bot) 0))))
              ((= timer 12) (check-repair! world bot))
              ((= timer 14) (check-hub-upgrade! world bot))
              ((= timer 4) (check-production! world bot))
              ((= timer 2) (require! (<= cargo 16)))
              (else (check-returned-kit! world bot)))
        (check-reservation! world bot)))
    (define (check-workers! world bots)
      (unless (null? bots)
        (let ((bot (car bots)))
          (check-bot! bot)
          (when (repair-worker? bot) (require! (not (pending-repair? (cdr bots)))))
          (when (hub-upgrade-worker? bot) (require! (not (pending-hub-upgrade? (cdr bots)))))
          (require! (and (< (bot-source bot) (world-next-id world))
                         (or (kit-carrier? bot) (= (bot-source bot) 0))))
          (require! (<= (list-size (bot-path bot)) 1024))
          (check-route! world (bot-path bot) (cell-index (quotient (bot-x bot) cell-size) (quotient (bot-y bot) cell-size))
                        (world-surveys world) #t #t)
          (require! (and (world-ground? world (quotient (bot-x bot) cell-size) (quotient (bot-y bot) cell-size))
                         (surveyed? (world-surveys world) (quotient (bot-x bot) cell-size) (quotient (bot-y bot) cell-size))))
          (check-activity! world bot))
        (check-workers! world (cdr bots))))
    (define (check-enemy-route! world path previous first burrower)
      (unless (null? path)
        (let ((step (car path)))
          (require! (bounded? step 0 (- (* map-width map-height) 1)))
          (require! (not (water? (world-seed world) (index-x step) (index-y step))))
          (require! (or burrower (world-ground? world (index-x step) (index-y step))
                        (not (null? (dig-at (world-excavations world) step)))))
          (require! (if first (<= (distance (index-x previous) (index-y previous) (index-x step) (index-y step)) 1)
                        (= (distance (index-x previous) (index-y previous) (index-x step) (index-y step)) 1)))
          (check-enemy-route! world (cdr path) step #f burrower))))
    (define (check-enemies! world enemies)
      (unless (null? enemies)
        (let ((enemy (car enemies)))
          (check-enemy! enemy)
          (require! (<= (list-size (enemy-path enemy)) 1024))
          (require! (< (enemy-target enemy) (world-next-id world)))
          (require! (world-ground? world (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size)))
          (check-enemy-route! world (enemy-path enemy)
                              (cell-index (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size))
                              #t (enemy-burrower enemy)))
        (check-enemies! world (cdr enemies))))
    (define (rail-sources rails)
      (if (null? rails) (empty-list) (cons (rail-source (car rails)) (rail-sources (cdr rails)))))
    (define (saved-rail rails source)
      (cond ((null? rails) (empty-list)) ((= (rail-source (car rails)) source) (list (car rails)))
            (else (saved-rail (cdr rails) source))))
    (define (rooted-rail? rails parent remaining)
      (or (= parent 0)
          (and (> remaining 0)
               (let ((found (saved-rail rails parent)))
                 (and (not (null? found)) (rooted-rail? rails (rail-parent (car found)) (- remaining 1)))))))
    (define (check-rail-parent! world rail)
      (require! (and (bounded? (rail-parent rail) 0 (- (world-next-id world) 1))
                     (not (= (rail-parent rail) (rail-source rail)))
                     (rooted-rail? (world-rails world) (rail-parent rail) (list-size (world-rails world)))))
      (if (= (rail-parent rail) 0) (require! (= (last-cell (rail-path rail)) (cell-index (world-hub-x world) (world-hub-y world))))
          (let ((found (find-building (world-buildings world) (rail-parent rail))))
            (require! (and (not (null? found)) (tower? (car found)) (ready? (car found))))
            (require! (= (last-cell (rail-path rail)) (cell-index (building-x (car found)) (building-y (car found))))))))
    (define (check-rail! world rail)
      (require! (bounded? (list-size (rail-path rail)) 2 1025))
      (let ((source (find-building (world-buildings world) (rail-source rail)))
            (length (* cell-size (- (list-size (rail-path rail)) 1))))
        (require! (and (not (null? source)) (tower? (car source))
                       (= (car (rail-path rail)) (cell-index (building-x (car source)) (building-y (car source))))))
        (require! (and (bounded? (rail-progress rail) 0 length) (bounded? (rail-returning rail) 0 1)
                       (bounded? (rail-cargo rail) 0 32)))
        (if (= (rail-returning rail) 1) (require! (and (= (rail-cargo rail) 0) (> (rail-progress rail) 0)))
            (require! (if (= (rail-cargo rail) 0) (= (rail-progress rail) 0) (< (rail-progress rail) length))))
        (unless (ready? (car source))
          (require! (and (= (rail-progress rail) 0) (= (rail-returning rail) 0) (= (rail-cargo rail) 0)))))
      (check-rail-parent! world rail)
      (check-route! world (rail-path rail) (car (rail-path rail)) (world-surveys world) #t #t))
    (define (check-rails! world rails)
      (unless (null? rails)
        (check-rail! world (car rails)) (check-rails! world (cdr rails))))

    ;; Reserved track geometry is checked on input, but never drawn.
    ;; A simulation tick clears this resource-free compatibility field.
    ;; Two ordered passes prove links without quadratic neighbor searches or a
    ;; full-map scratch allocation. No track entry participates in ore totals.
    (define (check-tracks! world tracks previous)
      (unless (null? tracks)
        (let* ((track (car tracks)) (cell (track-cell track)) (x (index-x cell)) (y (index-y cell)))
          (require! (and (bounded? track 0 (- (* (* map-width map-height) 32) 1)) (> cell previous)
                         (> (remainder track 16) 0) (world-ground? world x y) (surveyed? (world-surveys world) x y)
                         (or (not (track-east? track)) (< x (- map-width 1)))
                         (or (not (track-west? track)) (> x 0))
                         (or (not (track-south? track)) (< y (- map-height 1)))
                         (or (not (track-north? track)) (> y 0))))
          (check-tracks! world (cdr tracks) cell))))
    (define (check-horizontal-tracks! tracks previous)
      (if (null? tracks) (require! (or (< previous 0) (not (track-east? previous))))
          (let ((track (car tracks)))
            (if (and (>= previous 0) (= (track-cell track) (+ (track-cell previous) 1)))
                (require! (if (track-west? track) (track-east? previous) (not (track-east? previous))))
                (require! (and (not (track-west? track)) (or (< previous 0) (not (track-east? previous))))))
            (check-horizontal-tracks! (cdr tracks) track))))
    (define (check-vertical-tracks! upper lower)
      (cond ((and (null? upper) (null? lower)) #t)
            ((or (null? lower) (and (not (null? upper)) (< (+ (track-cell (car upper)) map-width) (track-cell (car lower)))))
             (require! (not (track-south? (car upper)))) (check-vertical-tracks! (cdr upper) lower))
            ((or (null? upper) (< (track-cell (car lower)) (+ (track-cell (car upper)) map-width)))
             (require! (not (track-north? (car lower)))) (check-vertical-tracks! upper (cdr lower)))
            (else (require! (if (track-south? (car upper)) (track-north? (car lower)) (not (track-north? (car lower)))))
                  (check-vertical-tracks! (cdr upper) (cdr lower)))))
    (define (building-investment buildings)
      (if (null? buildings) 0
          (+ (building-cost (building-kind (car buildings)))
             (+ (upgrade-investment (car buildings))
                (+ (if (arming? (car buildings)) 25 0)
                   (building-investment (cdr buildings)))))))
    (define (upgrade-investment building)
      (cond ((= (building-level building) 1) 0)
            ((or (tower? building) (= (building-kind building) 2)) (* 25 (- (building-level building) 1)))
            ((= (building-level building) 2) 40) (else 200)))
    (define (stock-total buildings)
      (if (null? buildings) 0 (+ (raw-stock (car buildings)) (stock-total (cdr buildings)))))
    (define (cargo-total bots)
      (if (null? bots) 0
          (+ (if (ore-cargo? (car bots)) (bot-cargo (car bots)) 0) (cargo-total (cdr bots)))))
    (define (freight-total rails)
      (if (null? rails) 0 (+ (rail-cargo (car rails)) (freight-total (cdr rails)))))
    (define (worker-investment bots)
      (* worker-cost (+ (pending-workers bots) (if (> (list-size bots) 3) (- (list-size bots) 3) 0))))
    (define (repair-investment bots)
      (if (null? bots) 0
          (+ (if (repair-worker? (car bots)) (bot-target (car bots)) 0) (repair-investment (cdr bots)))))
    (define (hub-upgrade-investment bots)
      (if (null? bots) 0
          (+ (if (hub-upgrade-worker? (car bots)) (bot-target (car bots)) 0) (hub-upgrade-investment (cdr bots)))))
    ;; Sparse edits refer only to original rock. Excavations and breaches are
    ;; disjoint, and each cell appears once; unfinished damage survives retreat.
    (define (original-rock? world cell)
      (and (bounded? cell 0 (- (* map-width map-height) 1))
           (not (ground? (world-seed world) (index-x cell) (index-y cell)))
           (not (water? (world-seed world) (index-x cell) (index-y cell)))))
    (define (check-breaches! world cells seen)
      (unless (null? cells)
        (let ((cell (car cells)))
          (require! (and (original-rock? world cell) (not (contains-id? seen cell))))
          (check-breaches! world (cdr cells) (cons cell seen)))))
    (define (check-excavations! world excavations seen)
      (unless (null? excavations)
        (let* ((dig (car excavations)) (cell (dig-cell dig)))
          (require! (and (original-rock? world cell) (not (contains-id? seen cell))
                         (bounded? (dig-remaining dig) 1 (- rock-health 1))
                         (not (world-ground? world (index-x cell) (index-y cell)))))
          (check-excavations! world (cdr excavations) (cons cell seen)))))
    ;; Zip against the trusted bounded layout: exact order proves uniqueness,
    ;; completeness and seed identity without allocating a map on every decode.
    (define (check-deposits! deposits expected)
      (if (null? expected) (require! (null? deposits))
          (begin
            (require! (not (null? deposits)))
            (require! (and (= (deposit-cell (car deposits)) (deposit-cell (car expected)))
                           (bounded? (deposit-remaining (car deposits)) 0 (deposit-remaining (car expected)))))
            (check-deposits! (cdr deposits) (cdr expected)))))
    (define (check-nests! nests expected)
      (if (null? expected) (require! (null? nests))
          (begin
            (require! (not (null? nests)))
            (let ((nest (car nests)) (site (car expected)))
              (require! (and (= (nest-id nest) (nest-id site)) (= (nest-site-x nest) (nest-site-x site))
                             (= (nest-site-y nest) (nest-site-y site)) (bounded? (nest-hp nest) 0 nest-health))))
            (check-nests! (cdr nests) (cdr expected)))))
    (define (check-resources! world)
      (let ((expected (initial-deposits (world-seed world))))
        (check-deposits! (world-deposits world) expected)
        (require! (= (world-produced world) (- (remaining-ore expected) (remaining-ore (world-deposits world))))))
      (check-nests! (world-nests world) (initial-nests (world-seed world))))
    (define (check-world! world)
      (check-world-fields! world)
      (check-resources! world)
      (check-outcome! world)
      (check-world-counts! world)
      (require! (<= (list-size (world-tracks world)) (* map-width map-height)))
      (check-tracks! world (world-tracks world) -1)
      (check-horizontal-tracks! (world-tracks world) -1)
      (check-vertical-tracks! (world-tracks world) (world-tracks world))
      (require! (<= (+ (list-size (world-breaches world)) (list-size (world-excavations world))) (* map-width map-height)))
      (check-breaches! world (world-breaches world) (empty-list))
      (check-excavations! world (world-excavations world) (empty-list))
      (check-surveys! world (world-surveys world))
      (check-alerts! world (world-alerts world))
      (check-identities! (append (building-ids (world-buildings world))
                                 (append (bot-ids (world-bots world))
                                         (append (production-ids (world-bots world)) (enemy-ids (world-enemies world)))))
                         (world-next-id world))
      (require! (= (world-credits world) (- (+ 160 (+ (world-delivered world) (world-local-spent world))) (world-spent world))))
      (require! (>= (world-spent world) (+ (+ (building-investment (world-buildings world))
                                              (* 5 (pending-move-count (world-buildings world))))
                                           (+ (worker-investment (world-bots world))
                                              (+ (repair-investment (world-bots world))
                                                 (+ (hub-capacity-investment world) (hub-upgrade-investment (world-bots world))))))))
      (require! (or (= (world-hull world) 0) (> (list-size (world-bots world)) 0)))
      (require! (= (world-produced world) (+ (world-delivered world)
                                             (+ (+ (world-lost-ore world) (world-local-spent world)) (+ (stock-total (world-buildings world))
                                                                                                        (+ (cargo-total (world-bots world))
                                                                                                           (freight-total (world-rails world))))))))
      (require! (>= (world-local-spent world) (+ (local-project-cost (world-buildings world))
                                                 (local-refund-cost (world-bots world)))))
      (check-buildings! world (world-buildings world))
      (check-workers! world (world-bots world))
      (check-enemies! world (world-enemies world))
      (check-identities! (rail-sources (world-rails world)) (world-next-id world))
      (check-rails! world (world-rails world)))


    ;; ---- A visible restart marker surrounds the derived world payload ----

    ;; Schema 12 owns an explicit hub capacity tier and has no house buildings.
    ;; Its separate application identity leaves earlier colony records untouched.
    ;; The host reads the restart marker; decoding checks it against the World.
    (define (copy-payload! destination source destination-start source-start count)
      (let loop ((index 0))
        (when (< index count)
          (vector-set! destination (i32->i64 (+ destination-start index))
                       (vector-ref source (i32->i64 (+ source-start index))))
          (loop (+ index 1)))))
    (define (encode-world world)
      (let* ((payload (encode-snapshot 12 world))
             (count (vector-length payload))
             (words (make-vector (+ count (ann 1 I64)) 0)))
        (vector-set! words (ann 0 I64) 12)
        (vector-set! words (ann 1 I64) (world-run-marker world))
        (copy-payload! words payload 2 1 (- (i64->i32 count) 1))
        words))
    (define (world-payload words)
      (let ((count (vector-length words)))
        (require! (and (>= count (ann 3 I64)) (= (vector-ref words (ann 0 I64)) 12)))
        (let ((payload (make-vector (- count (ann 1 I64)) 0)))
          (vector-set! payload (ann 0 I64) 12)
          (copy-payload! payload words 1 2 (- (i64->i32 count) 2))
          payload)))
    (define (validate-world world) (check-world! world) world)
    (define (decode-world words)
      (let ((world (ann (decode-snapshot (world-payload words)) World)))
        (require! (= (vector-ref words (ann 1 I64)) (world-run-marker world)))
        (validate-world world)))))
