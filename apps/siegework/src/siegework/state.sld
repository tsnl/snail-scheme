;; Derived transport constructs typed values; the colony then establishes bounded
;; geography, physical ownership and conservation before the runtime may commit.
(define-library (siegework state)
  (export encode-world decode-world validate-world)
  (import
   (scheme base)
   (scheme immutable)
   (application serialization)
   (siegework model)
   (siegework terrain)
   (only (lofi core) ann -> I32 I64)
   (only (lofi base) i32->i64 i64->i32 unreachable))
  (begin

    ;; ---- Bounded colony values ----

    (define (bounded? value low high) (and (>= value low) (<= value high)))
    (define (require! valid) (unless valid (unreachable)))
    (define (check-building! value seed)
      (require! (and (> (building-id value) 0) (bounded? (building-kind value) 1 3)
                     (ground? seed (building-x value) (building-y value))
                     (bounded? (building-level value) 1 2)
                     (bounded? (building-hp value) 1 (building-health (building-kind value)))
                     (if (= (building-kind value) 1) (> (deposit-rate seed (building-x value) (building-y value)) 0)
                         (= (deposit-rate seed (building-x value) (building-y value)) 0))
                     (or (not (= (building-kind value) 2)) (= (building-level value) 1))
                     (bounded? (building-aim-x value) 0 1919) (bounded? (building-aim-y value) 0 1439)
                     (>= (building-stock value) 0)
                     (if (= (building-kind value) 1) (<= (building-stock value) 120)
                         (or (tower? value) (= (building-stock value) 0)))
                     (bounded? (building-stage value) 0 3) (bounded? (building-armed value) 0 1)
                     (or (= (building-armed value) 0) (and (tower? value) (ready? value)))
                     (bounded? (building-cooldown value) 0 8))))
    (define (check-bot! value)
      (require! (and (> (bot-id value) 0) (bounded? (bot-x value) 0 1919)
                     (bounded? (bot-y value) 0 1439) (bounded? (bot-job value) 0 11)
                     (>= (bot-target value) 0) (bounded? (bot-cargo value) 0 50)
                     (bounded? (bot-timer value) 0 60) (bounded? (bot-hp value) 1 14)
                     (>= (bot-order value) 0))))
    (define (check-enemy! value)
      (require! (and (> (enemy-id value) 0) (bounded? (enemy-x value) 0 1919)
                     (bounded? (enemy-y value) 0 1439) (bounded? (enemy-hp value) 1 1800)
                     (bounded? (enemy-kind value) 0 2) (>= (enemy-target value) 0))))
    (define (check-survey! value seed)
      (require! (and (ground? seed (survey-x value) (survey-y value))
                     (bounded? (survey-radius value) 4 10))))
    (define (check-world-fields! world)
      (require! (and (bounded? (world-tick world) 0 4800) (bounded? (world-outcome world) 0 3)
                     (>= (world-credits world) 0) (bounded? (world-hull world) 0 300)
                     (>= (world-kills world) 0) (> (world-next-id world) 0) (>= (world-priority world) 0)
                     (bounded? (world-repairs world) 0 1) (>= (world-delivered world) 0)
                     (>= (world-produced world) 0) (>= (world-spent world) 0) (>= (world-lost world) 0)
                     (bounded? (world-notice world) 0 20) (bounded? (world-paused world) 0 1)
                     (bounded? (world-seed world) 1 65535) (>= (world-casualties world) 0)
                     (>= (world-lost-ore world) 0) (>= (world-run-marker world) 0))))
    (define (check-world-counts! world)
      (require! (and (<= (list-size (world-buildings world)) 32) (<= (list-size (world-bots world)) 12)
                     (<= (list-size (world-enemies world)) 24) (bounded? (list-size (world-surveys world)) 1 64)
                     (<= (list-size (world-alerts world)) 4) (<= (list-size (world-rails world)) 32))))
    (define (check-surveys! world surveys)
      (unless (null? surveys)
        (check-survey! (car surveys) (world-seed world))
        (check-surveys! world (cdr surveys))))
    (define (check-alerts! world alerts)
      (unless (null? alerts)
        (let ((alert (car alerts)))
          (require! (and (inside? (alert-x alert) (alert-y alert)) (bounded? (alert-kind alert) 0 4)
                         (bounded? (alert-tick alert) 0 (world-tick world)))))
        (check-alerts! world (cdr alerts))))

    ;; ---- Cross-record ownership and route evidence ----

    (define (contains-id? ids id)
      (and (not (null? ids)) (or (= (car ids) id) (contains-id? (cdr ids) id))))
    (define (building-ids values)
      (if (null? values) (empty-list) (cons (building-id (car values)) (building-ids (cdr values)))))
    (define (bot-ids values)
      (if (null? values) (empty-list) (cons (bot-id (car values)) (bot-ids (cdr values)))))
    (define (enemy-ids values)
      (if (null? values) (empty-list) (cons (enemy-id (car values)) (enemy-ids (cdr values)))))
    (define (check-identities! ids next)
      (unless (null? ids)
        (require! (and (< (car ids) next) (not (contains-id? (cdr ids) (car ids)))))
        (check-identities! (cdr ids) next)))
    (define (construction-carrier? bot id)
      (and (= (bot-target bot) id) (> (bot-cargo bot) 4)
           (or (= (bot-job bot) 3) (= (bot-job bot) 5)
               (and (= (bot-job bot) 7) (= (bot-timer bot) 5)))))
    (define (construction-claims bots id)
      (if (null? bots) 0 (+ (if (construction-carrier? (car bots) id) 1 0)
                            (construction-claims (cdr bots) id))))
    (define (reservation-claims bots id)
      (if (null? bots) 0 (+ (if (= (bot-order (car bots)) id) 1 0)
                            (reservation-claims (cdr bots) id))))
    (define (remembered-observer? surveys building)
      (and (not (null? surveys))
           (or (and (= (survey-x (car surveys)) (building-x building))
                    (= (survey-y (car surveys)) (building-y building))
                    (>= (survey-radius (car surveys)) (building-radius building)))
               (remembered-observer? (cdr surveys) building))))
    (define (check-buildings! world buildings)
      (unless (null? buildings)
        (let ((building (car buildings)))
          (check-building! building (world-seed world))
          (require! (= (construction-claims (world-bots world) (building-id building))
                       (if (= (building-stage building) 1) 1 0)))
          (require! (= (reservation-claims (world-bots world) (building-id building))
                       (if (= (building-stage building) 3) 1 0)))
          (require! (or (null? (cdr buildings)) (< (building-id building) (building-id (car (cdr buildings))))))
          (require! (null? (building-at (cdr buildings) (building-x building) (building-y building))))
          (require! (or (not (ready? building)) (remembered-observer? (world-surveys world) building)))
          (require! (<= (+ (workers-at (world-bots world) 8 (building-id building))
                           (workers-at (world-bots world) 9 (building-id building))) (building-level building))))
        (check-buildings! world (cdr buildings))))
    (define (check-route! seed path previous surveys known first)
      (unless (null? path)
        (let ((step (car path)))
          (require! (and (bounded? step 0 1727) (ground? seed (index-x step) (index-y step))))
          (require! (if first (<= (distance (index-x previous) (index-y previous) (index-x step) (index-y step)) 1)
                        (= (distance (index-x previous) (index-y previous) (index-x step) (index-y step)) 1)))
          (require! (or (not known) (surveyed? surveys (index-x step) (index-y step))))
          (check-route! seed (cdr path) step surveys known #f))))
    (define (last-cell path)
      (if (null? (cdr path)) (car path) (last-cell (cdr path))))
    (define (arrives-at? bot x y)
      (if (null? (bot-path bot)) (and (= (bot-x bot) (cell-x x)) (= (bot-y bot) (cell-y y)))
          (= (last-cell (bot-path bot)) (cell-index x y))))
    (define (check-kit! world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (require! (not (null? found)))
        (let ((building (car found)))
          (require! (and (= (building-stage building) 1)
                         (= (bot-cargo bot) (building-cost (building-kind building)))))
          (when (= (bot-job bot) 3) (require! (arrives-at? bot (building-x building) (building-y building)))))))
    (define (check-outward-target! world bot)
      (let ((found (find-building (world-buildings world) (bot-target bot))))
        (when (= (bot-target bot) 0) (require! (and (= (bot-job bot) 4) (arrives-at? bot hub-x hub-y))))
        (unless (null? found)
          (let ((building (car found)))
            (require! (and (ready? building) (arrives-at? bot (building-x building) (building-y building))))
            (when (or (= (bot-job bot) 1) (= (bot-job bot) 8) (= (bot-job bot) 9))
              (require! (= (building-kind building) 1)))))))
    (define (check-deposit! world bot)
      (require! (<= (bot-cargo bot) 16))
      (if (= (bot-target bot) 0) (require! (arrives-at? bot hub-x hub-y))
          (let ((found (find-building (world-buildings world) (bot-target bot))))
            ;; A destroyed destination is rerouted on the worker's next tick.
            (unless (null? found)
              (require! (and (ready? (car found)) (tower? (car found))
                             (arrives-at? bot (building-x (car found)) (building-y (car found)))))))))
    (define (check-returned-kit! world bot)
      (if (= (bot-target bot) 0)
          (require! (or (= (bot-cargo bot) 4) (= (bot-cargo bot) 25)
                        (= (bot-cargo bot) 40) (= (bot-cargo bot) 50)))
          (unless (= (bot-cargo bot) 4) (check-kit! world bot))))
    (define (check-reservation! world bot)
      (when (> (bot-order bot) 0)
        (let ((found (find-building (world-buildings world) (bot-order bot))) (job (bot-job bot)))
          (require! (and (not (null? found)) (= (building-stage (car found)) 3)
                         (or (= job 0) (= job 2) (= job 5) (= job 7) (= job 10) (= job 11)))))))
    (define (check-activity! world bot)
      (let ((job (bot-job bot)) (cargo (bot-cargo bot)) (timer (bot-timer bot)))
        (require! (and (< (bot-target bot) (world-next-id world))
                       (cond ((= job 6) (> timer 0))
                             ((= job 7) (or (= timer 2) (= timer 5) (= timer 11))) (else (= timer 0)))))
        (cond ((or (= job 0) (= job 10))
               (require! (and (= cargo 0) (= (bot-target bot) 0) (null? (bot-path bot)))))
              ((= job 6) (require! (and (= cargo 0) (= (bot-target bot) 0) (null? (bot-path bot)) (arrives-at? bot hub-x hub-y))))
              ((or (= job 1) (= job 8) (= job 9))
               (require! (= cargo 0)) (check-outward-target! world bot)
               (when (= job 8) (require! (null? (bot-path bot)))))
              ((= job 2) (check-deposit! world bot))
              ((= job 3) (check-kit! world bot))
              ((= job 4) (require! (= cargo 4)) (check-outward-target! world bot))
              ((= job 5) (require! (arrives-at? bot hub-x hub-y)) (check-returned-kit! world bot))
              ((= job 11) (require! (and (= cargo 0) (= (bot-target bot) 0) (> (bot-order bot) 0)
                                         (arrives-at? bot hub-x hub-y))))
              ((= timer 11) (require! (and (= cargo 0) (= (bot-target bot) 0) (> (bot-order bot) 0))))
              ((= timer 2) (require! (<= cargo 16)))
              (else (check-returned-kit! world bot)))
        (check-reservation! world bot)))
    (define (check-workers! world bots)
      (unless (null? bots)
        (let ((bot (car bots)))
          (check-bot! bot)
          (require! (<= (list-size (bot-path bot)) 128))
          (check-route! (world-seed world) (bot-path bot) (cell-index (quotient (bot-x bot) cell-size) (quotient (bot-y bot) cell-size))
                        (world-surveys world) #t #t)
          (require! (and (ground? (world-seed world) (quotient (bot-x bot) cell-size) (quotient (bot-y bot) cell-size))
                         (surveyed? (world-surveys world) (quotient (bot-x bot) cell-size) (quotient (bot-y bot) cell-size))))
          (check-activity! world bot))
        (check-workers! world (cdr bots))))
    (define (check-enemies! world enemies)
      (unless (null? enemies)
        (let ((enemy (car enemies)))
          (check-enemy! enemy)
          (require! (<= (list-size (enemy-path enemy)) 128))
          (require! (< (enemy-target enemy) (world-next-id world)))
          (check-route! (world-seed world) (enemy-path enemy) (cell-index (quotient (enemy-x enemy) cell-size) (quotient (enemy-y enemy) cell-size))
                        (world-surveys world) #f #t))
        (check-enemies! world (cdr enemies))))
    (define (rail-sources rails)
      (if (null? rails) (empty-list) (cons (rail-source (car rails)) (rail-sources (cdr rails)))))
    (define (check-rail-parent! world rail)
      (require! (bounded? (rail-parent rail) 0 (- (rail-source rail) 1)))
      (if (= (rail-parent rail) 0) (require! (= (last-cell (rail-path rail)) (cell-index hub-x hub-y)))
          (let ((found (find-building (world-buildings world) (rail-parent rail))))
            (require! (and (not (null? found)) (tower? (car found)) (ready? (car found))))
            (require! (= (last-cell (rail-path rail)) (cell-index (building-x (car found)) (building-y (car found))))))))
    (define (check-rail! world rail)
      (require! (bounded? (list-size (rail-path rail)) 2 129))
      (let ((source (find-building (world-buildings world) (rail-source rail)))
            (length (* cell-size (- (list-size (rail-path rail)) 1))))
        (require! (and (not (null? source)) (tower? (car source))
                       (= (car (rail-path rail)) (cell-index (building-x (car source)) (building-y (car source))))))
        (require! (and (bounded? (rail-progress rail) 0 length) (bounded? (rail-returning rail) 0 1)
                       (bounded? (rail-cargo rail) 0 32)))
        (if (= (rail-returning rail) 1) (require! (and (= (rail-cargo rail) 0) (> (rail-progress rail) 0)))
            (require! (if (= (rail-cargo rail) 0) (= (rail-progress rail) 0) (< (rail-progress rail) length))))
        (unless (ready? (car source))
          (require! (and (= (rail-progress rail) 0) (= (rail-returning rail) 0) (= (rail-cargo rail) 0)))))
      (check-rail-parent! world rail)
      (check-route! (world-seed world) (rail-path rail) (car (rail-path rail)) (world-surveys world) #t #t))
    (define (check-rails! world rails)
      (unless (null? rails)
        (check-rail! world (car rails)) (check-rails! world (cdr rails))))
    (define (building-investment buildings)
      (if (null? buildings) 0
          (+ (building-cost (building-kind (car buildings)))
             (+ (if (= (building-level (car buildings)) 1) 0 (if (= (building-kind (car buildings)) 3) 35 40))
                (+ (* 50 (building-armed (car buildings))) (building-investment (cdr buildings)))))))
    (define (stock-total buildings)
      (if (null? buildings) 0 (+ (building-stock (car buildings)) (stock-total (cdr buildings)))))
    (define (cargo-total bots)
      (if (null? bots) 0
          (+ (if (ore-cargo? (car bots)) (bot-cargo (car bots)) 0) (cargo-total (cdr bots)))))
    (define (freight-total rails)
      (if (null? rails) 0 (+ (rail-cargo (car rails)) (freight-total (cdr rails)))))
    (define (check-world! world)
      (check-world-fields! world)
      (check-world-counts! world)
      (check-surveys! world (world-surveys world))
      (check-alerts! world (world-alerts world))
      (check-identities! (append (building-ids (world-buildings world))
                                 (append (bot-ids (world-bots world)) (enemy-ids (world-enemies world)))) (world-next-id world))
      (require! (= (world-credits world) (- (+ 160 (world-delivered world)) (world-spent world))))
      (require! (>= (world-spent world) (+ (building-investment (world-buildings world)) (* 25 (if (> (list-size (world-bots world)) 3) (- (list-size (world-bots world)) 3) 0)))))
      (require! (or (= (world-hull world) 0) (> (list-size (world-bots world)) 0)))
      (require! (= (world-produced world) (+ (world-delivered world)
                                             (+ (world-lost-ore world) (+ (stock-total (world-buildings world))
                                                                          (+ (cargo-total (world-bots world))
                                                                             (freight-total (world-rails world))))))))
      (check-buildings! world (world-buildings world))
      (check-workers! world (world-bots world))
      (check-enemies! world (world-enemies world))
      (check-identities! (rail-sources (world-rails world)) (world-next-id world))
      (check-rails! world (world-rails world)))


    ;; ---- A visible restart marker surrounds the derived world payload ----

    ;; Schema 6 rejects the older fixed-layout schemas. The host reads only this
    ;; marker; decoding checks that it agrees with the typed World it accompanies.
    (define (copy-payload! destination source destination-start source-start count)
      (let loop ((index 0))
        (when (< index count)
          (vector-set! destination (i32->i64 (+ destination-start index))
                       (vector-ref source (i32->i64 (+ source-start index))))
          (loop (+ index 1)))))
    (define (encode-world world)
      (let* ((payload (encode-snapshot 6 world))
             (count (vector-length payload))
             (words (make-vector (+ count (ann 1 I64)) 0)))
        (vector-set! words (ann 0 I64) 6)
        (vector-set! words (ann 1 I64) (world-run-marker world))
        (copy-payload! words payload 2 1 (- (i64->i32 count) 1))
        words))
    (define (world-payload words)
      (let ((count (vector-length words)))
        (require! (and (>= count (ann 3 I64)) (= (vector-ref words (ann 0 I64)) 6)))
        (let ((payload (make-vector (- count (ann 1 I64)) 0)))
          (vector-set! payload (ann 0 I64) 6)
          (copy-payload! payload words 1 2 (- (i64->i32 count) 2))
          payload)))
    (define (validate-world world) (check-world! world) world)
    (define (decode-world words)
      (let ((world (ann (decode-snapshot (world-payload words)) World)))
        (require! (= (vector-ref words (ann 1 I64)) (world-run-marker world)))
        (validate-world world)))))
