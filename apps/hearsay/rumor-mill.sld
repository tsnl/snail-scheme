;; Plays the rumor mill at a terminal:
;;   ./lofi run -I apps/hearsay/src apps/hearsay/rumor-mill.sld [SCENARIO]
;; SCENARIO is a number from the menu; without one, the menu asks.
(import
 (lofi base)
 (lofi io)
 (hearsay mill))

(: ask-scenario (-> (Option I64) ! console))
(define (ask-scenario)
  (for-each (lambda (index) (write-line (string-append (show (+ index 1)) ". " (mill-scenario-name index))))
            (iota mill-scenario-count))
  (write-string "Scenario? ")
  (match (read-line)
    ((Some line) (scenario-number line))
    ((None) (None))))

(: scenario-number (-> String (Option I64)))
(define (scenario-number text)
  (match (string->i64 text)
    ((Some number) (if (and (>= number 1) (<= number mill-scenario-count)) (Some (- number 1)) (None)))
    ((None) (None))))

(: play (-> Mill Unit ! console))
(define (play mill)
  (write-line "")
  (write-line (mill-board mill))
  (unless (mill-over? mill)
    (write-string "> ")
    (match (read-line)
      ((Some line)
       (unless (string=? line "quit")
         (let ((result (mill-command mill line)))
           (write-line (Pair-second result))
           (play (Pair-first result)))))
      ((None) (unit)))))

(match (match (command-line)
         ((Cons program (Cons argument _)) (scenario-number argument))
         (_ (ask-scenario)))
  ((Some scenario)
   (let ((mill (new-mill scenario)))
     (write-line (mill-intro mill))
     (play mill)))
  ((None) (write-line "No such scenario.")))
