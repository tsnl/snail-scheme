;; Time complete six-car shifts on the published city. Loading the map,
;; populating each shift, rendering, and writing the report are outside the clock.
(import
 (snail core base)
 (snail core io)
 (snail shell resource)
 (snail shell game atlas)
 (snail shell game roads)
 (snail shell game vehicle)
 (apps last-mile assets)
 (apps last-mile game))

(define (sample (g Area) (r Roads) (clock Clock)) (→ I64)
  (let ((w (new-world)) (c (neutral-driver)) (now (● clock monotonic-nanoseconds)))
    (populate! g r w)
    (ensure-cars! g r w)
    (unless (= (length (● w cars)) 6) (panic "benchmark needs the full fleet"))
    (let ((start (now)))
      (let loop ((tick 0))
        (when (< tick 240)
          (let ((phase (modulo tick 120)))
            (step! g r w (new Order (driving c)
                              (buttons (cond ((< phase 40) 1) ((< phase 60) 32)
                                             ((< phase 85) 6) (else 32)))
                              (interact #f))))
          (loop (+ tick 1))))
      (- (now) start))))

(define (main (out OutputPort) (resources Resources) (clock Clock)) (→ Unit)
  (let* ((atlas (read-atlas (read-resources resources city-bands)))
         (r (read-roads (read-resource resources streets-model)))
         (g (open-area atlas (● (new-world) game cab position))))
    ;; Let V8 tier up the larger solver before taking steady-state samples.
    (for-each (lambda (_) (sample g r clock) (unit)) (iota 12))
    (for-each (lambda (_) (write-line out (show (sample g r clock)))) (iota 9))))
