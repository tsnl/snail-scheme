;; Exact integers use private WasmGC limbs. Published arrays are immutable;
;; arithmetic owns fresh scratch storage until a canonical value is returned.
(define-library (sfir integer)
  (export Integer IntegerDivision IntegerRoot
          integer-from-i64 integer->i64 integer-from-string integer->string
          integer-from-string/radix integer-fits-i64?
          integer-from-f64 integer-truncate-f64 integer->f64 integer-ratio->f64
          integer-bit-length integer-gcd integer-floor-quotient integer-modulo
          integer-zero? integer-negative? integer-abs integer-negate
          integer-compare integer=? integer<? integer<=? integer>? integer>=?
          integer-add integer-subtract integer-multiply
          integer-divide division-quotient division-remainder
          integer-quotient integer-remainder integer-expt integer-power
          integer-sqrt integer-sqrt/remainder root-value root-remainder
          + - * = < <= > >= quotient remainder
          test-integer)
  (import (sfir base))

  ;; ---- Canonical magnitude and private ownership ----

  ;; A limb is in [0, 2^30). I32 stores it without a sign bit; I64 holds
  ;; products, sums and carries. Zero alone has no limbs and no negative sign.
  ;; No constructor or limb accessor is exported. Sharing in abs/negate is
  ;; safe because every published array is readonly to all library operations.
  (begin
    (def radix
         1073741824)
    (def limb-bits
         30)
    (def Integer (datatype ()
                           (integer (negative Bool integer-negative?) (limbs (Vector I32) integer-limbs))))
    (def IntegerDivision (datatype ()
                                   (division (quotient Integer division-quotient) (remainder Integer division-remainder))))
    (def IntegerRoot (datatype ()
                               (root (value Integer root-value) (remainder Integer root-remainder))))
    (def zero
         (integer #f (ann (empty-vector) (Vector I32))))

    (def limb (-> (Vector I32) I64 I64)
         (lambda (digits index) (i32->i64 (vector-ref digits index))))

    (def put-limb! (-> (Vector I32) I64 I64 Unit)
         (lambda (digits index value) (vector-set! digits index (i64->i32 value))))

    (def fresh-limbs (-> I64 (Vector I32))
         (lambda (count) (make-vector count (ann 0 I32))))

    (def significant-length (-> (Vector I32) I64)
         (lambda (digits)
           (begin
             (def loop
                  (lambda (count)
                    (if (if (= count 0) #t (not (= (limb digits (- count 1)) 0))) count (loop (- count 1)))))
             (loop (vector-length digits)))))

    (def trimmed-limbs (-> (Vector I32) (Vector I32))
         (lambda (digits)
           (begin (let count (significant-length digits))
                  (if (= count (vector-length digits))
                      digits
                      (begin (let result (fresh-limbs count))
                             (begin
                               (vector-copy! result 0 digits 0 count) result))))))

    (def publish (-> Bool (Vector I32) Integer)
         (lambda (negative digits)
           (begin (let digits (trimmed-limbs digits))
                  (if (= (vector-length digits) 0) zero (integer negative digits)))))

    (def integer-zero? (-> Integer Bool)
         (lambda (value) (= (vector-length (integer-limbs value)) 0)))

    (def integer-abs (-> Integer Integer)
         (lambda (value)
           (if (integer-negative? value) (integer #f (integer-limbs value)) value)))

    (def integer-negate (-> Integer Integer)
         (lambda (value)
           (if (integer-zero? value)
               value
               (integer (not (integer-negative? value)) (integer-limbs value)))))

    ;; ---- Exact signed machine-integer conversion ----

    ;; Keeping the source nonpositive avoids negating I64_MIN. Each remainder
    ;; lies in (-radix, 0], so negating one limb is always representable.

    (def machine-limb-count (-> I64 I64)
         (lambda (value)
           (begin
             (def loop
                  (lambda (value count)
                    (if (= value 0) count (loop (quotient value radix) (+ count 1)))))
             (loop value 0))))

    (def integer-from-i64 (-> I64 Integer)
         (lambda (value)
           (begin (let negative (< value 0))
                  (begin (let value (if (> value 0) (- 0 value) value))
                         (begin (let digits (fresh-limbs (machine-limb-count value)))
                                (begin
                                  (def loop
                                       (lambda (value index)
                                         (if (= value 0)
                                             (publish negative digits)
                                             (begin (put-limb! digits index (- 0 (remainder value radix)))
                                                    (loop (quotient value radix) (+ index 1))))))
                                  (loop value 0)))))))

    (def integer->i64 (-> Integer I64)
         (lambda (value)
           (begin (let digits (integer-limbs value))
                  (begin (let negative (integer-negative? value))
                         (begin (let limit (if negative -9223372036854775808 -9223372036854775807))
                                (begin
                                  (def loop
                                       (lambda (count result)
                                         (if (= count 0)
                                             (if negative result (- 0 result))
                                             (begin (let digit (limb digits (- count 1)))
                                                    ;; quotient on this negative numerator is its mathematical ceiling.
                                                    (if (< result (quotient (+ limit digit) radix))
                                                        (unreachable)
                                                        (loop (- count 1) (- (* result radix) digit)))))))
                                  (loop (vector-length digits) 0)))))))

    ;; ---- Magnitude order and signed comparison ----

    (def magnitude-compare (-> (Vector I32) (Vector I32) I64)
         (lambda (left right)
           (begin (let sfir-migration-let-1 (vector-length left)) (let sfir-migration-let-2 (vector-length right))
                  (let a sfir-migration-let-1)
                  (let b sfir-migration-let-2)
                  (if (< a b)
                      -1
                      (if (> a b)
                          1
                          (begin
                            (def loop
                                 (lambda (count)
                                   (if (= count 0)
                                       0
                                       (begin (let sfir-migration-let-3 (limb left (- count 1))) (let sfir-migration-let-4 (limb right (- count 1)))
                                              (let a sfir-migration-let-3)
                                              (let b sfir-migration-let-4)
                                              (if (< a b) -1 (if (> a b) 1 (loop (- count 1))))))))
                            (loop a)))))))

    (def integer-compare (-> Integer Integer I64)
         (lambda (left right)
           (if (not (= (if (integer-negative? left) 1 0) (if (integer-negative? right) 1 0)))
               (if (integer-negative? left) -1 1)
               (begin (let order (magnitude-compare (integer-limbs left) (integer-limbs right)))
                      (if (integer-negative? left) (- 0 order) order)))))

    (def integer=? (-> Integer Integer Bool)
         (lambda (left right) (= (integer-compare left right) 0)))

    (def integer<? (-> Integer Integer Bool)
         (lambda (left right) (< (integer-compare left right) 0)))

    (def integer<=? (-> Integer Integer Bool)
         (lambda (left right) (<= (integer-compare left right) 0)))

    (def integer>? (-> Integer Integer Bool)
         (lambda (left right) (> (integer-compare left right) 0)))

    (def integer>=? (-> Integer Integer Bool)
         (lambda (left right) (>= (integer-compare left right) 0)))

    ;; ---- Addition and subtraction expose carry and borrow ----

    (def limb-or-zero (-> (Vector I32) I64 I64)
         (lambda (digits index)
           (if (< index (vector-length digits)) (limb digits index) 0)))

    (def magnitude-add (-> (Vector I32) (Vector I32) (Vector I32))
         (lambda (left right)
           (begin (let count (if (> (vector-length left) (vector-length right))
                                 (vector-length left)
                                 (vector-length right)))
                  (begin (let result (fresh-limbs (+ count 1)))
                         (begin
                           (def loop
                                (lambda (index carry)
                                  (if (= index count)
                                      (begin (put-limb! result count carry) result)
                                      (begin (let sum (+ (+ (limb-or-zero left index) (limb-or-zero right index)) carry))
                                             (begin
                                               (put-limb! result index (remainder sum radix))
                                               (loop (+ index 1) (quotient sum radix)))))))
                           (loop 0 0))))))
    ;; left >= right is established by the signed operation before entry.

    (def magnitude-subtract (-> (Vector I32) (Vector I32) (Vector I32))
         (lambda (left right)
           (begin (let count (vector-length left))
                  (begin (let result (fresh-limbs count))
                         (begin
                           (def loop
                                (lambda (index borrow)
                                  (if (= index count)
                                      result
                                      (begin (let difference (- (- (limb left index) (limb-or-zero right index)) borrow))
                                             (begin
                                               (put-limb! result index (if (< difference 0) (+ difference radix) difference))
                                               (loop (+ index 1) (if (< difference 0) 1 0)))))))
                           (loop 0 0))))))

    (def signed-difference (-> Bool (Vector I32) (Vector I32) Integer)
         (lambda (negative left right)
           (if (< (magnitude-compare left right) 0)
               (publish (not negative) (magnitude-subtract right left))
               (publish negative (magnitude-subtract left right)))))

    (def integer-add (-> Integer Integer Integer)
         (lambda (left right)
           (begin (let sfir-migration-let-5 (integer-limbs left)) (let sfir-migration-let-6 (integer-limbs right))
                  (let a sfir-migration-let-5)
                  (let b sfir-migration-let-6)
                  (if (if (integer-negative? left) (integer-negative? right) (not (integer-negative? right)))
                      (publish (integer-negative? left) (magnitude-add a b))
                      (signed-difference (integer-negative? left) a b)))))

    (def integer-subtract (-> Integer Integer Integer)
         (lambda (left right) (integer-add left (integer-negate right))))

    ;; ---- Schoolbook products with bounded I64 accumulation ----

    ;; (B-1)^2 + (B-1) + (B-1) = B^2-1 < 2^60. Therefore each
    ;; multiply/add/carry transition is exact before division by B. A row's
    ;; final carry goes into a previously untouched output position.

    (def multiply-row! (-> (Vector I32) (Vector I32) I64 I64 Unit)
         (lambda (result right offset factor)
           (begin (let count (vector-length right))
                  (begin
                    (def loop
                         (lambda (index carry)
                           (if (= index count)
                               (put-limb! result (+ offset count) carry)
                               (begin (let at (+ offset index))
                                      (begin (let product (+ (+ (* factor (limb right index)) (limb result at)) carry))
                                             (begin
                                               (put-limb! result at (remainder product radix))
                                               (loop (+ index 1) (quotient product radix))))))))
                    (loop 0 0)))))

    (def magnitude-multiply (-> (Vector I32) (Vector I32) (Vector I32))
         (lambda (left right)
           (begin (let result (fresh-limbs (+ (vector-length left) (vector-length right))))
                  (begin
                    (def loop
                         (lambda (index)
                           (if (= index (vector-length left))
                               result
                               (begin (multiply-row! result right index (limb left index))
                                      (loop (+ index 1))))))
                    (loop 0)))))

    (def integer-multiply (-> Integer Integer Integer)
         (lambda (left right)
           (if (if (integer-zero? left) #t (integer-zero? right))
               zero
               (publish (if (integer-negative? left) (not (integer-negative? right)) (integer-negative? right))
                        (magnitude-multiply (integer-limbs left) (integer-limbs right))))))
    ;; factor is positive and below B. Keeping one extra limb is sufficient.

    (def magnitude-scale (-> (Vector I32) I64 (Vector I32))
         (lambda (digits factor)
           (begin (let count (vector-length digits))
                  (begin (let result (fresh-limbs (+ count 1)))
                         (begin
                           (def loop
                                (lambda (index carry)
                                  (if (= index count)
                                      (begin (put-limb! result count carry) result)
                                      (begin (let product (+ (* (limb digits index) factor) carry))
                                             (begin
                                               (put-limb! result index (remainder product radix))
                                               (loop (+ index 1) (quotient product radix)))))))
                           (loop 0 0))))))

    ;; ---- Single-limb division ----

    ;; A private quotient buffer may alias its source: traversal is high to low,
    ;; and each old limb is consumed before its slot is overwritten. The caller
    ;; never passes a published limb array as target. Return the scalar remainder.

    (def divide-small! (-> (Vector I32) (Vector I32) I64 I64)
         (lambda (target source divisor)
           (begin
             (def loop
                  (lambda (count carry)
                    (if (= count 0)
                        carry
                        (begin (let value (+ (* carry radix) (limb source (- count 1))))
                               (begin
                                 (put-limb! target (- count 1) (quotient value divisor))
                                 (loop (- count 1) (remainder value divisor)))))))
             (loop (vector-length source) 0))))

    ;; ---- Normalized long division ----

    ;; Knuth's normalization makes the highest divisor limb >= B/2.
    ;; The two-high-limb estimate is never low and at most two high. Checking
    ;; the next limb reduces that error to at most one; full subtraction decides
    ;; the last correction. Every numerator/product is below B^2 = 2^60.

    (def estimate-digit (-> (Vector I32) (Vector I32) I64 I64)
         (lambda (dividend divisor offset)
           (begin (let count (vector-length divisor))
                  (begin (let high (limb divisor (- count 1)))
                         (begin (let numerator (+ (* (limb dividend (+ offset count)) radix)
                                                  (limb dividend (- (+ offset count) 1))))
                                (begin (let trial (quotient numerator high))
                                       (begin (let trial (if (>= trial radix) (- radix 1) trial))
                                              (begin
                                                (def correct
                                                     (lambda (trial residue)
                                                       (if (if (< residue radix)
                                                               (> (* trial (limb divisor (- count 2)))
                                                                  (+ (* residue radix) (limb dividend (- (+ offset count) 2))))
                                                               #f)
                                                           (correct (- trial 1) (+ residue high))
                                                           trial)))
                                                (correct trial (- numerator (* trial high)))))))))))
    ;; Trial, divisor digit and incoming carry are in [0, B-1]. Thus
    ;; product <= B*(B-1) < 2^60: masking and logical shifting split it exactly.
    ;; If its high word is B-1, product must be B*(B-1), so its low word is
    ;; zero and subtraction cannot borrow. Otherwise high+borrow <= B-1 too.
    ;; The low difference lies in (-B, B); adding B restores one limb.

    (def subtract-product! (-> (Vector I32) (Vector I32) I64 I64 Bool)
         (lambda (dividend divisor offset trial)
           (begin (let count (vector-length divisor))
                  (begin
                    (def loop
                         (lambda (index carry)
                           (if (= index count)
                               (begin (let high (- (limb dividend (+ offset count)) carry))
                                      (begin
                                        (if (if (< high -1) #t (> high 0))
                                            (begin (unreachable)
                                                   (unit))
                                            (unit))
                                        (put-limb! dividend (+ offset count) (if (< high 0) (+ high radix) high))
                                        (< high 0)))
                               (begin (let product (+ (* trial (limb divisor index)) carry))
                                      (begin (let difference (- (limb dividend (+ offset index))
                                                                (i64-bitwise-and product (- radix 1))))
                                             (begin
                                               (put-limb! dividend (+ offset index) (if (< difference 0) (+ difference radix) difference))
                                               (loop (+ index 1) (+ (i64-shift-right/logical product limb-bits)
                                                                    (if (< difference 0) 1 0)))))))))
                    (loop 0 0)))))

    (def add-back! (-> (Vector I32) (Vector I32) I64 Unit)
         (lambda (dividend divisor offset)
           (begin (let count (vector-length divisor))
                  (begin
                    (def loop
                         (lambda (index carry)
                           (if (= index count)
                               (put-limb! dividend (+ offset count)
                                          (remainder (+ (limb dividend (+ offset count)) carry) radix))
                               (begin (let sum (+ (+ (limb dividend (+ offset index)) (limb divisor index)) carry))
                                      (begin
                                        (put-limb! dividend (+ offset index) (remainder sum radix))
                                        (loop (+ index 1) (quotient sum radix)))))))
                    (loop 0 0)))))

    (def divide-position! (-> (Vector I32) (Vector I32) I64 I64)
         (lambda (dividend divisor offset)
           (begin (let trial (estimate-digit dividend divisor offset))
                  (if (subtract-product! dividend divisor offset trial)
                      (begin (add-back! dividend divisor offset) (- trial 1))
                      trial))))

    (def divide-normalized! (-> (Vector I32) (Vector I32) (Vector I32) Unit)
         (lambda (quotient-digits dividend divisor)
           (begin
             (def loop
                  (lambda (count)
                    (if (= count 0)
                        (unit)
                        (begin
                          (put-limb! quotient-digits (- count 1) (divide-position! dividend divisor (- count 1)))
                          (loop (- count 1))
                          (unit)))))
             (loop (vector-length quotient-digits)))))

    (def long-division (-> (Vector I32) (Vector I32) IntegerDivision)
         (lambda (left right)
           (begin (let count (vector-length right))
                  (begin (let scale (quotient radix (+ (limb right (- count 1)) 1)))
                         (begin (let dividend (magnitude-scale left scale))
                                (begin (let divisor (trimmed-limbs (magnitude-scale right scale)))
                                       (begin (let answer (fresh-limbs (+ (- (vector-length left) count) 1)))
                                              (begin (let residue (fresh-limbs count))
                                                     (begin
                                                       (divide-normalized! answer dividend divisor)
                                                       (vector-copy! residue 0 dividend 0 count)
                                                       (if (= (divide-small! residue residue scale) 0)
                                                           (unit)
                                                           (begin (unreachable)
                                                                  (unit)))
                                                       (division (publish #f answer) (publish #f residue)))))))))))

    (def divide-magnitudes (-> Integer Integer IntegerDivision)
         (lambda (left right)
           (begin (let sfir-migration-let-7 (integer-limbs left)) (let sfir-migration-let-8 (integer-limbs right))
                  (let a sfir-migration-let-7)
                  (let b sfir-migration-let-8)
                  (if (< (magnitude-compare a b) 0)
                      (division zero (integer-abs left))
                      (if (= (vector-length b) 1)
                          (begin (let answer (fresh-limbs (vector-length a)))
                                 (begin (let residue (divide-small! answer a (limb b 0)))
                                        (division (publish #f answer) (integer-from-i64 residue))))
                          (long-division a b))))))

    (def integer-divide (-> Integer Integer IntegerDivision)
         (lambda (left right)
           (if (integer-zero? right)
               (unreachable)
               (begin (let result (divide-magnitudes left right))
                      (begin (let q (division-quotient result))
                             (begin (let r (division-remainder result))
                                    (division (if (if (integer-negative? left) (not (integer-negative? right)) (integer-negative? right))
                                                  (integer-negate q)
                                                  q)
                                              (if (integer-negative? left) (integer-negate r) r))))))))

    (def integer-quotient (-> Integer Integer Integer)
         (lambda (left right) (division-quotient (integer-divide left right))))

    (def integer-remainder (-> Integer Integer Integer)
         (lambda (left right) (division-remainder (integer-divide left right))))

    ;; ---- Decimal text with independent mutable strings ----

    ;; Nine decimal digits fit in a limb. Grouped conversion does one linear
    ;; magnitude pass per chunk, rather than one per character. ASCII signs and
    ;; digits only are accepted; empty input, whitespace and prefixes trap.

    (def decimal-chunk (-> String I64 I64 I64)
         (lambda (text start end)
           (begin
             (def loop
                  (lambda (index value)
                    (if (= index end)
                        value
                        (begin (let digit (- (char->integer (string-ref text index)) 48))
                               (if (if (< digit 0) #t (> digit 9))
                                   (unreachable)
                                   (loop (+ index 1) (+ (* value 10) digit)))))))
             (loop start 0))))

    (def machine-power (-> I64 I64 I64)
         (lambda (base exponent)
           (begin
             (def loop
                  (lambda (left value)
                    (if (= left 0) value (loop (- left 1) (* value base)))))
             (loop exponent 1))))

    (def parse-decimal (-> String I64 Bool Integer)
         (lambda (text start negative)
           (begin (let count (string-length text))
                  (if (= start count)
                      (unreachable)
                      (begin
                        (def loop
                             (lambda (at value)
                               (if (= at count)
                                   (if negative (integer-negate value) value)
                                   (begin (let width (if (> (- count at) 9) 9 (- count at)))
                                          (begin (let scaled (publish #f (magnitude-scale (integer-limbs value) (machine-power 10 width))))
                                                 (begin (let chunk (integer-from-i64 (decimal-chunk text at (+ at width))))
                                                        (loop (+ at width) (integer-add scaled chunk))))))))
                        (loop start zero))))))

    (def integer-from-string (-> String Integer)
         (lambda (text)
           (if (= (string-length text) 0)
               (unreachable)
               (begin (let first (string-ref text 0))
                      (begin (let negative (char=? first #\-))
                             (begin (let signed (if negative #t (char=? first #\+)))
                                    (parse-decimal text (if signed 1 0) negative)))))))

    (def radix-digit (-> Char I64 I64)
         (lambda (character base)
           (begin (let code (char->integer character))
                  (begin (let digit (if (if (>= code 48) (<= code 57) #f)
                                        (- code 48)
                                        (if (if (>= code 65) (<= code 90) #f)
                                            (- code 55)
                                            (if (if (>= code 97) (<= code 122) #f) (- code 87) -1))))
                         (if (if (< digit 0) #t (>= digit base)) (unreachable) digit)))))

    (def parse-radix-digits (-> String I64 Bool I64 Integer)
         (lambda (text start negative base)
           (if (= start (string-length text))
               (unreachable)
               (begin
                 (def loop
                      (lambda (at value)
                        (if (= at (string-length text))
                            (if negative (integer-negate value) value)
                            (loop (+ at 1) (integer-add (publish #f (magnitude-scale (integer-limbs value) base))
                                                        (integer-from-i64 (radix-digit (string-ref text at) base)))))))
                 (loop start zero)))))

    (def integer-from-string/radix (-> String I64 Integer)
         (lambda (text base)
           (if (if (< base 2) #t (if (> base 36) #t (= (string-length text) 0)))
               (unreachable)
               (if (= base 10)
                   (integer-from-string text)
                   (begin (let first (string-ref text 0))
                          (begin (let negative (char=? first #\-))
                                 (begin (let start (if (if negative #t (char=? first #\+)) 1 0))
                                        (parse-radix-digits text start negative base))))))))

    (def decimal-chunks (-> (Vector I32) (List I64))
         (lambda (digits)
           (begin
             (def loop
                  (lambda (digits chunks)
                    (if (= (vector-length digits) 0)
                        chunks
                        (begin (let chunk (divide-small! digits digits 1000000000))
                               (loop (trimmed-limbs digits) (cons chunk chunks))))))
             (loop (vector-copy digits) (empty-list )))))

    (def decimal-width (-> I64 I64)
         (lambda (value)
           (begin
             (def loop
                  (lambda (value count)
                    (if (< value 10) count (loop (quotient value 10) (+ count 1)))))
             (loop value 1))))

    (def chunk-count (-> (List I64) I64)
         (lambda (chunks)
           (begin
             (def loop
                  (lambda (tail count)
                    (if (null? tail) count (loop (cdr tail) (+ count 1)))))
             (loop chunks 0))))

    (def write-chunk! (-> String I64 I64 I64 Unit)
         (lambda (text end value width)
           (begin
             (def loop
                  (lambda (at left value)
                    (if (= left 0)
                        (unit)
                        (begin
                          (string-set! text (- at 1) (integer->char (+ 48 (remainder value 10))))
                          (loop (- at 1) (- left 1) (quotient value 10))
                          (unit)))))
             (loop end width value))))

    (def write-chunks! (-> String I64 (List I64) I64 Unit)
         (lambda (text at chunks width)
           (if (null? chunks)
               (unit)
               (begin
                 (write-chunk! text (+ at width) (car chunks) width)
                 (write-chunks! text (+ at width) (cdr chunks) 9)
                 (unit)))))

    (def integer->string (-> Integer String)
         (lambda (value)
           (if (integer-zero? value)
               (string #\0)
               (begin (let chunks (decimal-chunks (integer-limbs value)))
                      (begin (let width (decimal-width (car chunks)))
                             (begin (let sign (if (integer-negative? value) 1 0))
                                    (begin (let text (make-string (+ (+ sign width) (* 9 (- (chunk-count chunks) 1)))))
                                           (begin
                                             (if (integer-negative? value)
                                                 (begin (string-set! text 0 #\-)
                                                        (unit))
                                                 (unit))
                                             (write-chunks! text sign chunks width) text))))))))

    ;; ---- Nonnegative exponentiation and floor square root ----

    (def half (-> Integer Integer)
         (lambda (value)
           (begin (let digits (integer-limbs value))
                  (begin (let result (fresh-limbs (vector-length digits)))
                         (begin
                           (divide-small! result digits 2) (publish #f result))))))

    (def integer-expt (-> Integer Integer Integer)
         (lambda (base exponent)
           (if (integer-negative? exponent)
               (unreachable)
               (begin
                 (def loop
                      (lambda (power left result)
                        (if (integer-zero? left)
                            result
                            (begin (let sfir-migration-let-9 (if (= (remainder (limb (integer-limbs left) 0) 2) 0)
                                                                 result
                                                                 (integer-multiply result power)))
                                   (let sfir-migration-let-10 (half left))
                                   (let result sfir-migration-let-9)
                                   (let left sfir-migration-let-10)
                                   (if (integer-zero? left) result (loop (integer-multiply power power) left result))))))
                 (loop base exponent (integer-from-i64 1))))))

    (def integer-power (-> Integer I64 Integer)
         (lambda (base exponent) (integer-expt base (integer-from-i64 exponent))))

    (def leading-bits (-> I64 I64)
         (lambda (value)
           (begin
             (def loop
                  (lambda (value count)
                    (if (= value 0) count (loop (quotient value 2) (+ count 1)))))
             (loop value 0))))

    (def sqrt-upper-bound (-> Integer Integer)
         (lambda (value)
           (begin (let digits (integer-limbs value))
                  (begin (let count (vector-length digits))
                         (begin (let bits (+ (* (- count 1) limb-bits) (leading-bits (limb digits (- count 1)))))
                                (begin (let exponent (quotient (+ bits 1) 2))
                                       (begin (let at (quotient exponent limb-bits))
                                              (begin (let result (fresh-limbs (+ at 1)))
                                                     (begin
                                                       (put-limb! result at (machine-power 2 (remainder exponent limb-bits)))
                                                       (publish #f result))))))))))

    (def integer-sqrt (-> Integer Integer)
         (lambda (value)
           (if (integer-negative? value)
               (unreachable)
               (if (integer-zero? value)
                   value
                   (begin
                     (def loop
                          (lambda (estimate)
                            (begin (let next (half (integer-add estimate (integer-quotient value estimate))))
                                   ;; Starting above the root makes every accepted estimate decrease.
                                   ;; At floor(sqrt(n)), the next estimate can be larger (n=3).
                                   (if (integer>=? next estimate) estimate (loop next)))))
                     (loop (sqrt-upper-bound value)))))))

    (def integer-sqrt/remainder (-> Integer IntegerRoot)
         (lambda (value)
           (begin (let root-value (integer-sqrt value))
                  (root root-value (integer-subtract value (integer-multiply root-value root-value))))))

    ;; ---- Exact conversion from finite binary64 integers ----

    ;; Division by the power-of-two limb radix is exact. Once the quotient is
    ;; truncated, cancellation recovers an integer digit smaller than the radix.
    ;; Negative zero maps to the unique exact zero. Fractional/nonfinite inputs
    ;; are rejected; the separately named truncating conversion is explicit.

    (def finite-f64? (-> F64 Bool)
         (lambda (value)
           (if (= value value) (if (< value (/ 1.0 0.0)) (> value (/ -1.0 0.0)) #f) #f)))

    (def float-limb-count (-> F64 I64)
         (lambda (value)
           (begin
             (def loop
                  (lambda (value count)
                    (if (= value 0.0) count (loop (truncate (/ value (i64->f64 radix))) (+ count 1)))))
             (loop value 0))))

    (def integer-from-f64 (-> F64 Integer)
         (lambda (value)
           (if (not (if (finite-f64? value) (= value (truncate value)) #f))
               (unreachable)
               (begin (let negative (< value 0.0))
                      (begin (let value (if negative (- 0.0 value) value))
                             (begin (let digits (fresh-limbs (float-limb-count value)))
                                    (begin (let base (i64->f64 radix))
                                           (begin
                                             (def loop
                                                  (lambda (value at)
                                                    (if (= value 0.0)
                                                        (publish negative digits)
                                                        (begin (let next (truncate (/ value base)))
                                                               (begin
                                                                 (put-limb! digits at (f64->i64 (- value (* next base))))
                                                                 (loop next (+ at 1)))))))
                                             (loop value 0)))))))))

    (def integer-truncate-f64 (-> F64 Integer)
         (lambda (value) (integer-from-f64 (truncate value))))

    ;; ---- One nearest-even rounding from an exact ratio to binary64 ----

    ;; Choose the final binary64 spacing before dividing. The quotient retains
    ;; at most 53 bits; its exact remainder decides rounding once, including
    ;; halfway cases, subnormals, signed underflow and overflow to infinity.

    (def integer-bit-length (-> Integer I64)
         (lambda (value)
           (begin (let digits (integer-limbs value))
                  (begin (let count (vector-length digits))
                         (if (= count 0) 0 (+ (* (- count 1) limb-bits) (leading-bits (limb digits (- count 1)))))))))

    (def binary-power (-> I64 Integer)
         (lambda (exponent) (integer-power (integer-from-i64 2) exponent)))

    (def binary64-power (-> I64 F64)
         (lambda (exponent)
           (begin (let sfir-migration-let-11 (if (< exponent 0) 0.5 2.0))
                  (let sfir-migration-let-12 (if (< exponent 0) (- 0 exponent) exponent))
                  (let factor sfir-migration-let-11)
                  (let count sfir-migration-let-12)
                  (begin
                    (def loop
                         (lambda (left value)
                           (if (= left 0) value (loop (- left 1) (* value factor)))))
                    (loop count 1.0)))))

    (def ratio-below-power? (-> Integer Integer I64 Bool)
         (lambda (numerator denominator exponent)
           (if (< exponent 0)
               (integer<? (integer-multiply numerator (binary-power (- 0 exponent))) denominator)
               (integer<? numerator (integer-multiply denominator (binary-power exponent))))))

    (def rounded-ratio (-> Integer Integer I64)
         (lambda (numerator denominator)
           (begin (let answer (integer-divide numerator denominator))
                  (begin (let whole (integer->i64 (division-quotient answer)))
                         (begin (let twice (integer-add (division-remainder answer) (division-remainder answer)))
                                (begin (let order (integer-compare twice denominator))
                                       (if (if (> order 0) #t (if (= order 0) (= (remainder whole 2) 1) #f)) (+ whole 1) whole)))))))

    (def scaled-ratio (-> Integer Integer I64 F64)
         (lambda (numerator denominator spacing)
           (begin (let whole (if (< spacing 0)
                                 (rounded-ratio (integer-multiply numerator (binary-power (- 0 spacing))) denominator)
                                 (rounded-ratio numerator (integer-multiply denominator (binary-power spacing)))))
                  (* (i64->f64 whole) (binary64-power spacing)))))

    (def positive-ratio->f64 (-> Integer Integer F64)
         (lambda (numerator denominator)
           (begin (let estimate (- (integer-bit-length numerator) (integer-bit-length denominator)))
                  (if (> estimate 1024)
                      (/ 1.0 0.0)
                      (if (< estimate -1075)
                          0.0
                          (begin (let exponent (if (ratio-below-power? numerator denominator estimate) (- estimate 1) estimate))
                                 (if (> exponent 1023)
                                     (/ 1.0 0.0)
                                     (scaled-ratio numerator denominator
                                                   (if (< exponent -1022) -1074 (- exponent 52))))))))))

    (def integer-ratio->f64 (-> Integer Integer F64)
         (lambda (numerator denominator)
           (if (integer-zero? denominator)
               (unreachable)
               (if (integer-zero? numerator)
                   0.0
                   (begin (let value (positive-ratio->f64 (integer-abs numerator) (integer-abs denominator)))
                          (if (if (integer-negative? numerator)
                                  (not (integer-negative? denominator))
                                  (integer-negative? denominator))
                              (* -1.0 value)
                              value))))))

    (def integer->f64 (-> Integer F64)
         (lambda (value) (integer-ratio->f64 value (integer-from-i64 1))))

    (def integer-fits-i64? (-> Integer Bool)
         (lambda (value)
           (if (integer>=? value (integer-from-i64 -9223372036854775808))
               (integer<=? value (integer-from-i64 9223372036854775807))
               #f)))

    ;; ---- Euclidean reduction and floor division ----

    (def integer-gcd (-> Integer Integer Integer)
         (lambda (left right)
           (begin
             (def loop
                  (lambda (left right)
                    (if (integer-zero? right) left (loop right (integer-remainder left right)))))
             (loop (integer-abs left) (integer-abs right)))))

    (def integer-floor-quotient (-> Integer Integer Integer)
         (lambda (left right)
           (begin (let answer (integer-divide left right))
                  (if (if (not (integer-zero? (division-remainder answer)))
                          (if (integer-negative? left) (not (integer-negative? right)) (integer-negative? right))
                          #f)
                      (integer-subtract (division-quotient answer) (integer-from-i64 1))
                      (division-quotient answer)))))

    (def integer-modulo (-> Integer Integer Integer)
         (lambda (left right)
           (integer-subtract left (integer-multiply right (integer-floor-quotient left right)))))

    ;; ---- Ordinary static numeric methods ----

    (define-overload + (-> Integer Integer Integer) integer-add)
    (define-overload - (-> Integer Integer Integer) integer-subtract)
    (define-overload - (-> Integer Integer) integer-negate)
    (define-overload * (-> Integer Integer Integer) integer-multiply)
    (define-overload = (-> Integer Integer Bool) integer=?)
    (define-overload < (-> Integer Integer Bool) integer<?)
    (define-overload <= (-> Integer Integer Bool) integer<=?)
    (define-overload > (-> Integer Integer Bool) integer>?)
    (define-overload >= (-> Integer Integer Bool) integer>=?)
    (define-overload quotient (-> Integer Integer Integer) integer-quotient)
    (define-overload remainder (-> Integer Integer Integer) integer-remainder)

    ;; ---- Tests ----

    ;; Test entry points are ordinary SFIR exports; no feature expansion is required.

    ;; The runner also instantiates this same arithmetic at radix 4. Its
    ;; exhaustive oracle uses bounded machine arithmetic, independently of
    ;; quotient estimation and correction. No test exposes mutable limbs.
    (def test-product-carry
         (lambda ()
           ;; (B-1)*B^2 - (B-1)*(B^2-1) = B-1. The first digit borrows;
           ;; the next product reaches B*(B-1), where another borrow is impossible.
           (begin (let sfir-migration-let-13 (fresh-limbs 3)) (let sfir-migration-let-14 (fresh-limbs 2))
                  (let dividend sfir-migration-let-13)
                  (let divisor sfir-migration-let-14)
                  (begin
                    (put-limb! dividend 2 (- radix 1))
                    (put-limb! divisor 0 (- radix 1))
                    (put-limb! divisor 1 (- radix 1))
                    (if (if (not (subtract-product! dividend divisor 0 (- radix 1)))
                            (if (= (limb dividend 0) (- radix 1))
                                (if (= (limb dividend 1) 0) (= (limb dividend 2) 0) #f)
                                #f)
                            #f)
                        (unit)
                        (begin
                          (unreachable)
                          (unit)))))))
    (def test-integer
         (lambda ()
           (begin
             (test-product-carry)
             (begin
               (def numerator
                    (lambda (a)
                      (if (= a 1024)
                          42
                          (begin
                            (begin
                              (def denominator
                                   (lambda (b)
                                     (if (= b 64)
                                         (unit)
                                         (begin
                                           (begin (let left (integer-from-i64 a))
                                                  (begin (let right (integer-from-i64 b))
                                                         (begin (let answer (integer-divide left right))
                                                                (if (if (= (integer->i64 (division-quotient answer)) (quotient a b))
                                                                        (if (= (integer->i64 (division-remainder answer)) (remainder a b))
                                                                            (if (= (integer->i64 (integer-add left right)) (+ a b))
                                                                                (if (= (integer->i64 (integer-subtract left right)) (- a b))
                                                                                    (= (integer->i64 (integer-multiply left right)) (* a b))
                                                                                    #f)
                                                                                #f)
                                                                            #f)
                                                                        #f)
                                                                    (unit)
                                                                    (begin
                                                                      (unreachable)
                                                                      (unit))))))
                                           (denominator (+ b 1))
                                           (unit)))))
                              (denominator 1))
                            (numerator (+ a 1))))))
               (numerator 0)))))))
