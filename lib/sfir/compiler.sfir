;; Explicit compiler and Wasm execution services for ordinary SFIR programs.
;; Every fallible operation returns a value. One host scope owns all handles.
(define-library (sfir compiler)
  (export CompilerResult compiler-success compiler-failure LibraryMap Entry entry
          Target wasm-target Artifact Code Providers provider-set Instance ScalarValue
          scalar-i32 scalar-i64 scalar-f32 scalar-f64 scalar-bool scalar-char scalar-unit
          parse-library empty-library-map library-map-primitives library-map-parse library-map-insert
          library-map-alias compile load instantiate invoke-entry close-instance write-artifact)
  (import (only (sfir primitive) null? car cdr string-length string-ref make-string string-set!
                i64-eq i64-add i32-eq unit)
          (only (sfir compiler-builder) SfirLibrary library-token checked-library))
  (begin

    ;; ---- Nominal resources and ordinary success or failure values ----

    (def CompilerResult (datatype (T) (compiler-success (value T)) (compiler-failure (message String))))
    (def LibraryMap (datatype () (wrap-map (token I64 map-token))))
    (def Artifact (datatype () (wrap-artifact (token I64 artifact-token))))
    (def Code (datatype () (wrap-code (token I64 code-token))))
    (def Instance (datatype () (wrap-instance (token I64 instance-token))))
    (def Entry (datatype () (entry (library (List String) entry-library) (export String entry-export))))
    (def Target (datatype () (wasm-target)))
    (def Providers (datatype () (provider-set (name String provider-set-name))))
    (def ScalarValue (datatype ()
                               (scalar-i32 (value I32)) (scalar-i64 (value I64))
                               (scalar-f32 (value F32)) (scalar-f64 (value F64))
                               (scalar-bool (value Bool)) (scalar-char (value Char)) (scalar-unit)))

    ;; ---- Scalar-only transport into the explicitly supplied service ----

    (define-extern raw-text-empty "sfir.compiler" "text-empty" (-> I64))
    (define-extern raw-text-character "sfir.compiler" "text-character" (-> I64 Char I64))
    (define-extern raw-list-empty "sfir.compiler" "list-empty" (-> I64))
    (define-extern raw-list-text "sfir.compiler" "list-text" (-> I64 I64 I64))
    (define-extern raw-list-scalar "sfir.compiler" "list-scalar" (-> I64 I64 I64))
    (define-extern raw-result-ok "sfir.compiler" "result-ok" (-> I64 Bool))
    (define-extern raw-result-value "sfir.compiler" "result-value" (-> I64 I64))
    (define-extern raw-error-length "sfir.compiler" "error-length" (-> I64 I64))
    (define-extern raw-error-character "sfir.compiler" "error-character" (-> I64 I64 Char))
    (define-extern raw-parse-library "sfir.compiler" "parse-library" (-> I64 I64 I64))
    (define-extern raw-library-value "sfir.compiler" "library-value" (-> I64 I64))
    (define-extern raw-map-empty "sfir.compiler" "map-empty" (-> I64))
    (define-extern raw-map-primitives "sfir.compiler" "map-primitives" (-> I64 I64))
    (define-extern raw-map-source "sfir.compiler" "map-source" (-> I64 I64 I64 I64 I64))
    (define-extern raw-map-built "sfir.compiler" "map-built" (-> I64 I64 I64 I64))
    (define-extern raw-map-alias "sfir.compiler" "map-alias" (-> I64 I64 I64 I64))
    (define-extern raw-compile "sfir.compiler" "compile" (-> I64 I64 I64 I64))
    (define-extern raw-load "sfir.compiler" "load" (-> I64 I64))
    (define-extern raw-instantiate "sfir.compiler" "instantiate" (-> I64 I64 I64))
    (define-extern raw-invoke "sfir.compiler" "invoke" (-> I64 I64 I64))
    (define-extern raw-close-instance "sfir.compiler" "close-instance" (-> I64 I64))
    (define-extern raw-write-artifact "sfir.compiler" "write-artifact" (-> I64 I64 I64))
    (define-extern raw-scalar-kind "sfir.compiler" "scalar-kind" (-> I64 I32))
    (define-extern raw-scalar-Unit "sfir.compiler" "scalar-Unit" (-> I64))
    (define-extern raw-scalar-I32 "sfir.compiler" "scalar-I32" (-> I32 I64))
    (define-extern raw-value-I32 "sfir.compiler" "value-I32" (-> I64 I32))
    (define-extern raw-scalar-I64 "sfir.compiler" "scalar-I64" (-> I64 I64))
    (define-extern raw-value-I64 "sfir.compiler" "value-I64" (-> I64 I64))
    (define-extern raw-scalar-F32 "sfir.compiler" "scalar-F32" (-> F32 I64))
    (define-extern raw-value-F32 "sfir.compiler" "value-F32" (-> I64 F32))
    (define-extern raw-scalar-F64 "sfir.compiler" "scalar-F64" (-> F64 I64))
    (define-extern raw-value-F64 "sfir.compiler" "value-F64" (-> I64 F64))
    (define-extern raw-scalar-Bool "sfir.compiler" "scalar-Bool" (-> Bool I64))
    (define-extern raw-value-Bool "sfir.compiler" "value-Bool" (-> I64 Bool))
    (define-extern raw-scalar-Char "sfir.compiler" "scalar-Char" (-> Char I64))
    (define-extern raw-value-Char "sfir.compiler" "value-Char" (-> I64 Char))

    ;; ---- Copy text and lists across the boundary before each operation ----

    (def encode-text-from (-> String I64 I64 I64)
         (lambda (text index token)
           (if (i64-eq index (string-length text)) token
               (encode-text-from text (i64-add index (ann 1 I64))
                                 (raw-text-character token (string-ref text index))))))
    (def encode-text (-> String I64)
         (lambda (text) (encode-text-from text (ann 0 I64) (raw-text-empty))))
    (def encode-key (-> (List String) I64)
         (lambda (names)
           (if (null? names) (raw-list-empty)
               (raw-list-text (encode-text (car names)) (encode-key (cdr names))))))
    (def fill-error-text (-> I64 String I64 String)
         (lambda (token text index)
           (if (i64-eq index (string-length text)) text
               (begin (string-set! text index (raw-error-character token index))
                      (fill-error-text token text (i64-add index (ann 1 I64)))))))
    (def error-text (-> I64 String)
         (lambda (token)
           (fill-error-text token (make-string (raw-error-length token) #\null) (ann 0 I64))))

    ;; ---- Parsing returns ordinary syntax, before resolution or checking ----

    (def parse-library (-> String String (CompilerResult SfirLibrary))
         (lambda (source text)
           (begin (let result (raw-parse-library (encode-text source) (encode-text text)))
                  (if (raw-result-ok result)
                      (compiler-success (checked-library (raw-library-value (raw-result-value result))))
                      (compiler-failure (error-text result))))))

    ;; ---- Map operations preserve aliases and never discover source ----

    (def empty-library-map (-> (CompilerResult LibraryMap))
         (lambda ()
           (begin (let result (raw-map-empty))
                  (if (raw-result-ok result)
                      (compiler-success (wrap-map (raw-result-value result)))
                      (compiler-failure (error-text result))))))
    (def library-map-primitives (-> LibraryMap (CompilerResult LibraryMap))
         (lambda (libraries)
           (begin (let result (raw-map-primitives (map-token libraries)))
                  (if (raw-result-ok result)
                      (compiler-success (wrap-map (raw-result-value result)))
                      (compiler-failure (error-text result))))))
    (def library-map-parse (-> LibraryMap (List String) String String (CompilerResult LibraryMap))
         (lambda (libraries key source text)
           (begin (let result (raw-map-source (map-token libraries) (encode-key key)
                                              (encode-text source) (encode-text text)))
                  (if (raw-result-ok result)
                      (compiler-success (wrap-map (raw-result-value result)))
                      (compiler-failure (error-text result))))))
    (def library-map-insert (-> LibraryMap (List String) SfirLibrary (CompilerResult LibraryMap))
         (lambda (libraries key value)
           (begin (let result (raw-map-built (map-token libraries) (encode-key key) (library-token value)))
                  (if (raw-result-ok result)
                      (compiler-success (wrap-map (raw-result-value result)))
                      (compiler-failure (error-text result))))))
    (def library-map-alias (-> LibraryMap (List String) (List String) (CompilerResult LibraryMap))
         (lambda (libraries from to)
           (begin (let result (raw-map-alias (map-token libraries) (encode-key from) (encode-key to)))
                  (if (raw-result-ok result)
                      (compiler-success (wrap-map (raw-result-value result)))
                      (compiler-failure (error-text result))))))

    ;; ---- Wasm artifacts, separate provider linkage and runtime lifetimes ----

    (def compile (-> LibraryMap Entry Target (CompilerResult Artifact))
         (lambda (libraries selected target)
           (match target
             ((wasm-target)
              (begin (let result (raw-compile (map-token libraries) (encode-key (entry-library selected))
                                              (encode-text (entry-export selected))))
                     (if (raw-result-ok result)
                         (compiler-success (wrap-artifact (raw-result-value result)))
                         (compiler-failure (error-text result))))))))
    (def load (-> Artifact (CompilerResult Code))
         (lambda (artifact)
           (begin (let result (raw-load (artifact-token artifact)))
                  (if (raw-result-ok result)
                      (compiler-success (wrap-code (raw-result-value result)))
                      (compiler-failure (error-text result))))))
    (def instantiate (-> Code Providers (CompilerResult Instance))
         (lambda (code providers)
           (begin (let result (raw-instantiate (code-token code) (encode-text (provider-set-name providers))))
                  (if (raw-result-ok result)
                      (compiler-success (wrap-instance (raw-result-value result)))
                      (compiler-failure (error-text result))))))
    (def close-instance (-> Instance (CompilerResult Unit))
         (lambda (runtime)
           (begin (let result (raw-close-instance (instance-token runtime)))
                  (if (raw-result-ok result) (compiler-success (unit))
                      (compiler-failure (error-text result))))))
    (def write-artifact (-> Artifact String (CompilerResult Unit))
         (lambda (artifact path)
           (begin (let result (raw-write-artifact (artifact-token artifact) (encode-text path)))
                  (if (raw-result-ok result) (compiler-success (unit))
                      (compiler-failure (error-text result))))))

    ;; ---- Tagged scalars retain semantic types even when physical types coincide ----

    (def encode-scalar (-> ScalarValue I64)
         (lambda (value)
           (match value
             ((scalar-i32 x) (raw-scalar-I32 x)) ((scalar-i64 x) (raw-scalar-I64 x))
             ((scalar-f32 x) (raw-scalar-F32 x)) ((scalar-f64 x) (raw-scalar-F64 x))
             ((scalar-bool x) (raw-scalar-Bool x)) ((scalar-char x) (raw-scalar-Char x))
             ((scalar-unit) (raw-scalar-Unit)))))
    (def encode-values (-> (List ScalarValue) I64)
         (lambda (values)
           (if (null? values) (raw-list-empty)
               (raw-list-scalar (encode-scalar (car values)) (encode-values (cdr values))))))
    (def decode-scalar (-> I64 ScalarValue)
         (lambda (token)
           (begin (let kind (raw-scalar-kind token))
                  (if (i32-eq kind 0) (scalar-i32 (raw-value-I32 token))
                      (if (i32-eq kind 1) (scalar-i64 (raw-value-I64 token))
                          (if (i32-eq kind 2) (scalar-f32 (raw-value-F32 token))
                              (if (i32-eq kind 3) (scalar-f64 (raw-value-F64 token))
                                  (if (i32-eq kind 4) (scalar-bool (raw-value-Bool token))
                                      (if (i32-eq kind 5) (scalar-char (raw-value-Char token))
                                          (scalar-unit))))))))))
    (def invoke-entry (-> Instance (List ScalarValue) (CompilerResult ScalarValue))
         (lambda (runtime arguments)
           (begin (let result (raw-invoke (instance-token runtime) (encode-values arguments)))
                  (if (raw-result-ok result)
                      (compiler-success (decode-scalar (raw-result-value result)))
                      (compiler-failure (error-text result))))))
    ))
