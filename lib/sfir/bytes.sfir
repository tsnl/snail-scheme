;; Packed storage stays in WasmGC. Library loops translate bytes and Unicode
;; scalars without exposing a native pointer or crossing a foreign boundary.
(define-library (sfir bytes)
  (export make-bytevector bytevector bytevector-length
          bytevector-u8-ref bytevector-u8-set! bytevector-eq?
          bytevector-copy bytevector-copy! bytevector-append
          utf8->string string->utf8)
  (import (sfir base)
          (rename (only (sfir primitive)
                        make-bytevector bytevector-length bytevector-u8-ref
                        bytevector-u8-set! bytevector-eq? bytevector-copy!)
                  (make-bytevector make-filled-bytevector)
                  (bytevector-copy! copy-bytes!)))

  ;; ---- Fresh mutable bytes and bounded ranges ----

  (begin
    (define-overload make-bytevector (-> I64 I64 Bytevector) make-filled-bytevector)
    (define-overload make-bytevector (-> I64 Bytevector)
      (lambda (count) (make-filled-bytevector count (ann 0 I64))))
    (def bytevector
         (lambda bytes
           (begin (let result (make-bytevector (byte-count bytes)))
                  (begin
                    (def loop
                         (lambda (remaining index)
                           (if (null? remaining)
                               result
                               (begin
                                 (bytevector-u8-set! result index (car remaining))
                                 (loop (cdr remaining) (+ index (ann 1 I64)))))))
                    (loop bytes (ann 0 I64))))))
    (def byte-count
         (lambda (bytes)
           (begin
             (def loop
                  (lambda (remaining count)
                    (if (null? remaining)
                        count
                        (if (= count (ann 4294967295 I64)) (unreachable) (loop (cdr remaining) (+ count (ann 1 I64)))))))
             (loop bytes (ann 0 I64)))))
    (def check-range
         (lambda (length start end)
           (if (if (< start (ann 0 I64)) #t (if (< end start) #t (> end length)))
               (begin (unreachable)
                      (unit))
               (unit))))

    ;; Every copy allocates its own mutable owner, even for empty or readonly
    ;; input. The primitive checks both complete ranges before its first store.
    (define-overload bytevector-copy! (-> Bytevector I64 Bytevector I64 I64 Unit) copy-bytes!)
    (define-overload bytevector-copy! (-> Bytevector I64 Bytevector I64 Unit)
      (lambda (target at source start)
        (copy-bytes! target at source start (bytevector-length source))))
    (define-overload bytevector-copy! (-> Bytevector I64 Bytevector Unit)
      (lambda (target at source) (copy-bytes! target at source (ann 0 I64) (bytevector-length source))))
    (define-overload bytevector-copy (-> Bytevector I64 I64 Bytevector)
      (lambda (source start end)
        (begin
          (check-range (bytevector-length source) start end)
          (begin (let result (make-bytevector (- end start)))
                 (begin
                   (copy-bytes! result (ann 0 I64) source start end)
                   result)))))
    (define-overload bytevector-copy (-> Bytevector I64 Bytevector)
      (lambda (source start) (bytevector-copy source start (bytevector-length source))))
    (define-overload bytevector-copy (-> Bytevector Bytevector)
      (lambda (source) (bytevector-copy source (ann 0 I64) (bytevector-length source))))
    (def bytevector-append
         (lambda sources
           (begin (let result (make-bytevector (appended-length sources)))
                  (begin
                    (def loop
                         (lambda (remaining at)
                           (if (null? remaining)
                               result
                               (begin (let length (bytevector-length (car remaining)))
                                      (begin
                                        (copy-bytes! result at (car remaining) (ann 0 I64) length)
                                        (loop (cdr remaining) (+ at length)))))))
                    (loop sources (ann 0 I64))))))
    (def appended-length
         (lambda (sources)
           ;; Check every prefix; the next addition is at most twice U32_MAX.
           (begin
             (def loop
                  (lambda (remaining count)
                    (if (> count (ann 4294967295 I64))
                        (unreachable)
                        (if (null? remaining)
                            count
                            (loop (cdr remaining) (+ count (bytevector-length (car remaining))))))))
             (loop sources (ann 0 I64)))))

    ;; ---- Strict UTF-8 decoding ----

    ;; No callbacks or mutation intervene between validation/counting and fill.
    ;; Helpers return scalars; decoding one character allocates no product value.
    ;; Both passes inspect only the selected byte range, including empty slices.
    (def leading-width
         (lambda (byte)
           (if (< byte (ann 128 I64))
               (ann 1 I64)
               (if (if (>= byte (ann 194 I64)) (< byte (ann 224 I64)) #f)
                   (ann 2 I64)
                   (if (if (>= byte (ann 224 I64)) (< byte (ann 240 I64)) #f)
                       (ann 3 I64)
                       (if (if (>= byte (ann 240 I64)) (< byte (ann 245 I64)) #f) (ann 4 I64) (unreachable)))))))
    (def leading-prefix
         (lambda (width)
           (if (= width (ann 1 I64)) (ann 0 I64) (if (= width (ann 2 I64)) (ann 192 I64) (if (= width (ann 3 I64)) (ann 224 I64) (ann 240 I64))))))
    (def minimum-scalar
         (lambda (width)
           (if (= width (ann 1 I64)) (ann 0 I64) (if (= width (ann 2 I64)) (ann 128 I64) (if (= width (ann 3 I64)) (ann 2048 I64) (ann 65536 I64))))))
    (def utf8-width
         (lambda (source index end)
           (begin (let width (leading-width (bytevector-u8-ref source index)))
                  (if (> width (- end index)) (unreachable) width))))
    (def continuation-payload
         (lambda (source index)
           (begin (let byte (bytevector-u8-ref source index))
                  (if (if (< byte (ann 128 I64)) #t (> byte (ann 191 I64))) (unreachable) (- byte (ann 128 I64))))))
    (def utf8-character
         (lambda (source index width)
           (begin
             (def loop
                  (lambda (offset scalar)
                    (if (= offset width)
                        (if (< scalar (minimum-scalar width)) (unreachable) (integer->char scalar))
                        (loop (+ offset (ann 1 I64)) (+ (* scalar (ann 64 I64)) (continuation-payload source (+ index offset)))))))
             (loop (ann 1 I64) (- (bytevector-u8-ref source index) (leading-prefix width))))))
    (def decoded-length
         (lambda (source start end)
           (begin
             (def loop
                  (lambda (index count)
                    (if (= index end)
                        count
                        (begin (let width (utf8-width source index end))
                               (begin
                                 (utf8-character source index width)
                                 (loop (+ index width) (+ count (ann 1 I64))))))))
             (loop start (ann 0 I64)))))
    (def decode-into!
         (lambda (target source start end)
           (begin
             (def loop
                  (lambda (index at)
                    (if (= index end)
                        (unit)
                        (begin
                          (begin (let width (utf8-width source index end))
                                 (begin
                                   (string-set! target at (utf8-character source index width))
                                   (loop (+ index width) (+ at (ann 1 I64)))))
                          (unit)))))
             (loop start (ann 0 I64)))))
    (define-overload utf8->string (-> Bytevector I64 I64 String)
      (lambda (source start end)
        (begin
          (check-range (bytevector-length source) start end)
          (begin (let result (make-string (decoded-length source start end)))
                 (begin
                   (decode-into! result source start end)
                   result)))))
    (define-overload utf8->string (-> Bytevector I64 String)
      (lambda (source start) (utf8->string source start (bytevector-length source))))
    (define-overload utf8->string (-> Bytevector String)
      (lambda (source) (utf8->string source (ann 0 I64) (bytevector-length source))))

    ;; ---- UTF-8 encoding from Unicode scalars ----

    ;; String indices count scalars. Count bytes before allocating the exact
    ;; result; all additions are bounded before the next character is visited.
    (def scalar-width
         (lambda (scalar)
           (if (< scalar (ann 128 I64)) (ann 1 I64) (if (< scalar (ann 2048 I64)) (ann 2 I64) (if (< scalar (ann 65536 I64)) (ann 3 I64) (ann 4 I64))))))
    (def encoded-length
         (lambda (source start end)
           (begin
             (def loop
                  (lambda (index count)
                    (if (> count (ann 4294967295 I64))
                        (unreachable)
                        (if (= index end)
                            count
                            (loop (+ index (ann 1 I64)) (+ count (scalar-width (char->integer (string-ref source index)))))))))
             (loop start (ann 0 I64)))))
    (def encode-character!
         (lambda (target at scalar width)
           (begin
             (def loop
                  (lambda (remaining payload)
                    (if (= remaining (ann 1 I64))
                        (bytevector-u8-set! target at (+ (leading-prefix width) payload))
                        (begin
                          (bytevector-u8-set! target (+ at (- remaining (ann 1 I64))) (+ (ann 128 I64) (remainder payload (ann 64 I64))))
                          (loop (- remaining (ann 1 I64)) (quotient payload (ann 64 I64)))))))
             (loop width scalar))))
    (def encode-into!
         (lambda (target source start end)
           (begin
             (def loop
                  (lambda (index at)
                    (if (= index end)
                        (unit)
                        (begin
                          (begin (let scalar (char->integer (string-ref source index)))
                                 (begin (let width (scalar-width scalar))
                                        (begin
                                          (encode-character! target at scalar width)
                                          (loop (+ index (ann 1 I64)) (+ at width)))))
                          (unit)))))
             (loop start (ann 0 I64)))))
    (define-overload string->utf8 (-> String I64 I64 Bytevector)
      (lambda (source start end)
        (begin
          (check-range (string-length source) start end)
          (begin (let result (make-bytevector (encoded-length source start end)))
                 (begin
                   (encode-into! result source start end)
                   result)))))
    (define-overload string->utf8 (-> String I64 Bytevector)
      (lambda (source start) (string->utf8 source start (string-length source))))
    (define-overload string->utf8 (-> String Bytevector)
      (lambda (source) (string->utf8 source (ann 0 I64) (string-length source))))))
