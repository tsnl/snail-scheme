;; Strings and bytevectors own packed UTF-8/byte storage in WasmGC. Conversions
;; preserve bytes without exposing native pointers or crossing a foreign boundary.
(define-library (sfir bytes)
  (export make-bytevector bytevector bytevector-length
          bytevector-u8-ref bytevector-u8-set! bytevector-eq?
          bytevector-copy bytevector-copy! bytevector-append
          utf8->string string->utf8)
  (import (sfir base)
          (rename (only (sfir primitive)
                        make-bytevector bytevector-length bytevector-u8-ref
                        bytevector-u8-set! bytevector-eq? bytevector-copy!
                        utf8->string string->utf8)
                  (make-bytevector make-filled-bytevector)
                  (bytevector-copy! copy-bytes!)
                  (utf8->string decode-utf8) (string->utf8 encode-utf8)))

  ;; ---- Fresh mutable bytes and bounded ranges ----

  (begin
    (define-overload make-bytevector (-> I64 I64 Bytevector) make-filled-bytevector)
    (define-overload make-bytevector (-> I64 Bytevector)
      (lambda (count) (make-filled-bytevector count (ann 0 I64))))
    (def bytevector
         (lambda bytes
           (begin (let result (make-bytevector (byte-count bytes)))
                  (begin
                    (def loop
                         (lambda (remaining index)
                           (if (null? remaining)
                               result
                               (begin
                                 (bytevector-u8-set! result index (car remaining))
                                 (loop (cdr remaining) (+ index (ann 1 I64)))))))
                    (loop bytes (ann 0 I64))))))
    (def byte-count
         (lambda (bytes)
           (begin
             (def loop
                  (lambda (remaining count)
                    (if (null? remaining)
                        count
                        (if (= count (ann 4294967295 I64)) (unreachable) (loop (cdr remaining) (+ count (ann 1 I64)))))))
             (loop bytes (ann 0 I64)))))
    (def check-range
         (lambda (length start end)
           (if (if (< start (ann 0 I64)) #t (if (< end start) #t (> end length)))
               (begin (unreachable)
                      (unit))
               (unit))))

    ;; Every copy allocates its own mutable owner, even for empty or readonly
    ;; input. The primitive checks both complete ranges before its first store.
    (define-overload bytevector-copy! (-> Bytevector I64 Bytevector I64 I64 Unit) copy-bytes!)
    (define-overload bytevector-copy! (-> Bytevector I64 Bytevector I64 Unit)
      (lambda (target at source start)
        (copy-bytes! target at source start (bytevector-length source))))
    (define-overload bytevector-copy! (-> Bytevector I64 Bytevector Unit)
      (lambda (target at source) (copy-bytes! target at source (ann 0 I64) (bytevector-length source))))
    (define-overload bytevector-copy (-> Bytevector I64 I64 Bytevector)
      (lambda (source start end)
        (begin
          (check-range (bytevector-length source) start end)
          (begin (let result (make-bytevector (- end start)))
                 (begin
                   (copy-bytes! result (ann 0 I64) source start end)
                   result)))))
    (define-overload bytevector-copy (-> Bytevector I64 Bytevector)
      (lambda (source start) (bytevector-copy source start (bytevector-length source))))
    (define-overload bytevector-copy (-> Bytevector Bytevector)
      (lambda (source) (bytevector-copy source (ann 0 I64) (bytevector-length source))))
    (def bytevector-append
         (lambda sources
           (begin (let result (make-bytevector (appended-length sources)))
                  (begin
                    (def loop
                         (lambda (remaining at)
                           (if (null? remaining)
                               result
                               (begin (let length (bytevector-length (car remaining)))
                                      (begin
                                        (copy-bytes! result at (car remaining) (ann 0 I64) length)
                                        (loop (cdr remaining) (+ at length)))))))
                    (loop sources (ann 0 I64))))))
    (def appended-length
         (lambda (sources)
           ;; Check every prefix; the next addition is at most twice U32_MAX.
           (begin
             (def loop
                  (lambda (remaining count)
                    (if (> count (ann 4294967295 I64))
                        (unreachable)
                        (if (null? remaining)
                            count
                            (loop (cdr remaining) (+ count (bytevector-length (car remaining))))))))
             (loop sources (ann 0 I64)))))

    ;; ---- Owned UTF-8 conversions ----

    ;; Strings already store UTF-8. The primitive decoder validates and counts
    ;; once, then copies bytes; encoding copies a scalar-indexed byte span.
    ;; Each result owns fresh mutable storage.
    (define-overload utf8->string (-> Bytevector I64 I64 String) decode-utf8)
    (define-overload utf8->string (-> Bytevector I64 String)
      (lambda (source start) (decode-utf8 source start (bytevector-length source))))
    (define-overload utf8->string (-> Bytevector String)
      (lambda (source) (decode-utf8 source (ann 0 I64) (bytevector-length source))))
    (define-overload string->utf8 (-> String I64 I64 Bytevector) encode-utf8)
    (define-overload string->utf8 (-> String I64 Bytevector)
      (lambda (source start) (encode-utf8 source start (string-length source))))
    (define-overload string->utf8 (-> String Bytevector)
      (lambda (source) (encode-utf8 source (ann 0 I64) (string-length source))))))
