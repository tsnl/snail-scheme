;; Constructive library syntax. Values wrap immutable host nodes belonging to
;; one explicit builder invocation; no constructor reads or compiles source.
(define-library (sfir compiler-builder)
  (export Name SourceSpan ScopeId BindingId BindingReference TypeSyntax Expression
          Declaration ImportRename ImportSelection Import Export SfirLibrary
          builder-name source-span library-scope nested-scope binding
          local-reference import-reference reference-expression function-type
          type-i32 type-i64 type-f32 type-f64 type-bool type-char type-unit
          literal-i32 literal-i64 literal-f32 literal-f64 literal-bool literal-char
          lambda-expression application-expression conditional-expression definition
          all-imports only-imports import-rename rename-imports library-import
          library-export sfir-library library-token)
  (import (only (sfir primitive) null? car cdr string-length string-ref i64-eq i64-add))
  (begin

    ;; ---- Nominal handles keep the constructor categories distinct ----

    (def Name (datatype () (wrap-name (token I64 name-token))))
    (def SourceSpan (datatype () (wrap-span (token I64 span-token))))
    (def ScopeId (datatype () (wrap-scope (token I64 scope-token))))
    (def BindingId (datatype () (wrap-binding (token I64 binding-token))))
    (def BindingReference (datatype () (wrap-reference (token I64 reference-token))))
    (def TypeSyntax (datatype () (wrap-type (token I64 type-token))))
    (def Expression (datatype () (wrap-expression (token I64 expression-token))))
    (def Declaration (datatype () (wrap-declaration (token I64 declaration-token))))
    (def ImportRename (datatype () (wrap-rename (token I64 rename-token))))
    (def ImportSelection (datatype () (wrap-selection (token I64 selection-token))))
    (def Import (datatype () (wrap-import (token I64 import-token))))
    (def Export (datatype () (wrap-export (token I64 export-token))))
    (def SfirLibrary (datatype () (wrap-library (token I64 library-token))))

    ;; ---- Only scalar tokens and values cross the provider boundary ----

    (define-extern raw-name-empty "sfir.builder" "name-empty" (-> I64))
    (define-extern raw-name-character "sfir.builder" "name-character" (-> I64 Char I64))
    (define-extern raw-span "sfir.builder" "span" (-> I64 I32 I32 I64))
    (define-extern raw-root-scope "sfir.builder" "root-scope" (-> I64))
    (define-extern raw-child-scope "sfir.builder" "child-scope" (-> I64 I64))
    (define-extern raw-binding "sfir.builder" "binding" (-> I64 I64 I64 I64))
    (define-extern raw-nil "sfir.builder" "nil" (-> I64))
    (define-extern raw-cons "sfir.builder" "cons" (-> I64 I64 I64))
    (define-extern raw-scalar-type "sfir.builder" "scalar-type" (-> I32 I64))
    (define-extern raw-function-type "sfir.builder" "function-type" (-> I64 I64 I64))
    (define-extern raw-local-reference "sfir.builder" "local-reference" (-> I64 I64 I64))
    (define-extern raw-import-reference "sfir.builder" "import-reference" (-> I64 I64 I64 I64))
    (define-extern raw-reference "sfir.builder" "reference" (-> I64 I64))
    (define-extern raw-literal-I32 "sfir.builder" "literal-I32" (-> I32 I64 I64))
    (define-extern raw-literal-I64 "sfir.builder" "literal-I64" (-> I64 I64 I64))
    (define-extern raw-literal-F32 "sfir.builder" "literal-F32" (-> F32 I64 I64))
    (define-extern raw-literal-F64 "sfir.builder" "literal-F64" (-> F64 I64 I64))
    (define-extern raw-literal-Bool "sfir.builder" "literal-Bool" (-> Bool I64 I64))
    (define-extern raw-literal-Char "sfir.builder" "literal-Char" (-> Char I64 I64))
    (define-extern raw-lambda "sfir.builder" "lambda" (-> I64 I64 I64 I64 I64))
    (define-extern raw-application "sfir.builder" "application" (-> I64 I64 I64 I64))
    (define-extern raw-conditional "sfir.builder" "conditional" (-> I64 I64 I64 I64 I64))
    (define-extern raw-definition "sfir.builder" "definition" (-> I64 I64 I64 I64 I64))
    (define-extern raw-all "sfir.builder" "all" (-> I64))
    (define-extern raw-only "sfir.builder" "only" (-> I64 I64 I64))
    (define-extern raw-rename-pair "sfir.builder" "rename-pair" (-> I64 I64 I64))
    (define-extern raw-rename "sfir.builder" "rename" (-> I64 I64 I64))
    (define-extern raw-import "sfir.builder" "import" (-> I64 I64 I64 I64 I64))
    (define-extern raw-export "sfir.builder" "export" (-> I64 I64 I64))
    (define-extern raw-library "sfir.builder" "library" (-> I64 I64 I64 I64 I64 I64 I64))

    ;; ---- Ordinary lists are copied into immutable sequence nodes ----

    (def encode-names (-> (List Name) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (name-token (car items)) (encode-names (cdr items))))))
    (def encode-bindings (-> (List BindingId) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (binding-token (car items)) (encode-bindings (cdr items))))))
    (def encode-types (-> (List TypeSyntax) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (type-token (car items)) (encode-types (cdr items))))))
    (def encode-expressions (-> (List Expression) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (expression-token (car items)) (encode-expressions (cdr items))))))
    (def encode-declarations (-> (List Declaration) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (declaration-token (car items)) (encode-declarations (cdr items))))))
    (def encode-renames (-> (List ImportRename) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (rename-token (car items)) (encode-renames (cdr items))))))
    (def encode-imports (-> (List Import) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (import-token (car items)) (encode-imports (cdr items))))))
    (def encode-exports (-> (List Export) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (export-token (car items)) (encode-exports (cdr items))))))

    ;; ---- Names, locations, scopes and explicit binding identities ----

    (def builder-name (-> String Name)
         (lambda (text)
           (begin
             (def loop (-> I64 I64 I64)
                  (lambda (index token)
                    (if (i64-eq index (string-length text)) token
                        (loop (i64-add index (ann 1 I64))
                              (raw-name-character token (string-ref text index))))))
             (wrap-name (loop (ann 0 I64) (raw-name-empty))))))
    (def source-span (-> Name I32 I32 SourceSpan)
         (lambda (source line column) (wrap-span (raw-span (name-token source) line column))))
    (def library-scope (-> ScopeId)
         (lambda () (wrap-scope (raw-root-scope))))
    (def nested-scope (-> ScopeId ScopeId)
         (lambda (parent) (wrap-scope (raw-child-scope (scope-token parent)))))
    (def binding (-> ScopeId Name SourceSpan BindingId)
         (lambda (scope name span) (wrap-binding (raw-binding (scope-token scope) (name-token name) (span-token span)))))
    (def local-reference (-> BindingId SourceSpan BindingReference)
         (lambda (binding span) (wrap-reference (raw-local-reference (binding-token binding) (span-token span)))))
    (def import-reference (-> ScopeId Name SourceSpan BindingReference)
         (lambda (scope name span) (wrap-reference (raw-import-reference (scope-token scope) (name-token name) (span-token span)))))

    ;; ---- Declared types and expression syntax ----

    (def type-i32 (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 0 I32)))))
    (def type-i64 (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 1 I32)))))
    (def type-f32 (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 2 I32)))))
    (def type-f64 (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 3 I32)))))
    (def type-bool (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 4 I32)))))
    (def type-char (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 5 I32)))))
    (def type-unit (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 6 I32)))))
    (def function-type (-> (List TypeSyntax) TypeSyntax TypeSyntax)
         (lambda (parameters result) (wrap-type (raw-function-type (encode-types parameters) (type-token result)))))
    (def reference-expression (-> BindingReference Expression)
         (lambda (reference) (wrap-expression (raw-reference (reference-token reference)))))
    (def literal-i32 (-> I32 SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-I32 value (span-token span)))))
    (def literal-i64 (-> I64 SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-I64 value (span-token span)))))
    (def literal-f32 (-> F32 SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-F32 value (span-token span)))))
    (def literal-f64 (-> F64 SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-F64 value (span-token span)))))
    (def literal-bool (-> Bool SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-Bool value (span-token span)))))
    (def literal-char (-> Char SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-Char value (span-token span)))))
    (def lambda-expression (-> ScopeId (List BindingId) Expression SourceSpan Expression)
         (lambda (scope parameters body span)
           (wrap-expression (raw-lambda (scope-token scope) (encode-bindings parameters)
                                        (expression-token body) (span-token span)))))
    (def application-expression (-> Expression (List Expression) SourceSpan Expression)
         (lambda (operator arguments span)
           (wrap-expression (raw-application (expression-token operator) (encode-expressions arguments)
                                             (span-token span)))))
    (def conditional-expression (-> Expression Expression Expression SourceSpan Expression)
         (lambda (test yes no span)
           (wrap-expression (raw-conditional (expression-token test) (expression-token yes)
                                             (expression-token no) (span-token span)))))
    (def definition (-> BindingId TypeSyntax Expression SourceSpan Declaration)
         (lambda (binding type value span)
           (wrap-declaration (raw-definition (binding-token binding) (type-token type)
                                             (expression-token value) (span-token span)))))

    ;; ---- Imports stay descriptive until the result is compiled ----

    (def all-imports (-> ImportSelection)
         (lambda () (wrap-selection (raw-all))))
    (def only-imports (-> ImportSelection (List Name) ImportSelection)
         (lambda (from names) (wrap-selection (raw-only (selection-token from) (encode-names names)))))
    (def import-rename (-> Name Name ImportRename)
         (lambda (from to) (wrap-rename (raw-rename-pair (name-token from) (name-token to)))))
    (def rename-imports (-> ImportSelection (List ImportRename) ImportSelection)
         (lambda (from renames) (wrap-selection (raw-rename (selection-token from) (encode-renames renames)))))
    (def library-import (-> (List Name) ImportSelection ScopeId SourceSpan Import)
         (lambda (key selection scope span)
           (wrap-import (raw-import (encode-names key) (selection-token selection)
                                    (scope-token scope) (span-token span)))))
    (def library-export (-> Name BindingReference Export)
         (lambda (name reference) (wrap-export (raw-export (name-token name) (reference-token reference)))))
    (def sfir-library (-> (List Name) ScopeId (List Import) (List Export) (List Declaration) SourceSpan SfirLibrary)
         (lambda (key scope imports exports declarations span)
           (wrap-library (raw-library (encode-names key) (scope-token scope) (encode-imports imports)
                                      (encode-exports exports) (encode-declarations declarations) (span-token span)))))))
