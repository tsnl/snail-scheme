;; Scheme resolves each occurrence to two world transforms. Immutable colored
;; models cross the boundary only while absent from the host's live mesh table.
;; GPU mesh and instance buffers belong to the browser renderer alone.
(define-library (draw3d renderer)
  (export present-scene! present-scene-in! present-scene-inset! request-scene-frame!)
  (import
   (scheme base)
   (draw3d math)
   (draw3d scene)
   (only (lofi base) f32->bits f64->f32 f32->f64 i32->i64 unreachable)
   (only (lofi core) define-extern -> I32 match))
  (begin

    ;; ---- A copied scalar frame; no managed references escape Wasm ----

    (define-extern stage-uniform "snail.scene" "uniform" (-> I32 I32 Unit))
    (define-extern stage-batch "snail.scene" "batch" (-> I32 I32 Unit))
    (define-extern stage-opacity "snail.scene" "opacity" (-> I32 I32 Unit))
    (define-extern stage-motion "snail.scene" "motion" (-> I32 Unit))
    (define-extern stage-motion-clock "snail.scene" "motion-clock" (-> I32 Unit))
    (define-extern stage-reveal "snail.scene" "reveal" (-> I32 I32 I32 I32 I32 I32 I32 Unit))
    (define-extern request-scene-frame! "snail.scene" "request-frame" (-> Unit))
    (define-extern stage-dependency "snail.scene" "dependency" (-> I32 Unit))
    (define-extern reuse-batch? "snail.scene" "reuse" (-> I32))
    (define-extern stage-vertex "snail.scene" "vertex" (-> I32 I32 I32 I32 I32 I32 I32 I32 Unit))
    (define-extern stage-prototype "snail.scene" "prototype" (-> I32 I32 I32 I32))
    (define-extern stage-instance "snail.scene" "instance" (-> I32 I32 I32 I32 I32 I32 I32 I32 I32 I32 I32 I32 Unit))
    (define-extern stage-normal "snail.scene" "normal" (-> I32 I32 I32 I32 I32 I32 I32 I32 I32 Unit))
    (define-extern stage-before "snail.scene" "before" (-> I32 I32 I32 I32 I32 I32 I32 I32 I32 I32 I32 I32 Unit))
    (define-extern stage-unordered "snail.scene" "unordered" (-> Unit))
    (define-extern stage-triangle "snail.scene" "triangle" (-> I32 I32 I32 Unit))
    (define-extern stage-background "snail.scene" "background" (-> I32 Unit))
    (define-extern stage-viewport "snail.scene" "viewport" (-> I32 I32 I32 I32 Unit))
    (define-extern begin-inset "snail.scene" "begin-inset" (-> I32 I32 I32 I32 I32 Unit))
    (define-extern end-inset "snail.scene" "end-inset" (-> Unit))
    (define (float-bits value) (f32->bits (f64->f32 value)))
    (define (uniform! offset value) (stage-uniform offset (float-bits value)))
    (define (uniform-vector! offset value)
      (uniform! offset (vec3-x value)) (uniform! (+ offset 1) (vec3-y value))
      (uniform! (+ offset 2) (vec3-z value)))
    (define (scene-uniforms! value)
      (let ((matrix (camera-matrix (scene-camera value))) (light (scene-light value)))
        (let loop ((index 0))
          (when (< index 16) (uniform! index (vector-ref matrix (i32->i64 index))) (loop (+ index 1))))
        (uniform-vector! 16 (light-direction light)) (uniform! 19 (light-intensity light))
        (uniform-vector! 20 (scene-ambient value)) (uniform! 23 1.0)
        (uniform! 24 1.0) (uniform! 25 0.0) (uniform! 26 0.0) (uniform! 27 0.0)
        (uniform! 28 0.0) (uniform! 29 0.0) (uniform! 30 0.0) (uniform! 31 -1.0)
        (stage-background (scene-background value))))

    ;; ---- Fixed local mesh data, transferred once per live prototype ----

    (define (vertex! value surface)
      (let ((point (vertex-position value)) (normal (vertex-normal value)))
        (stage-vertex (float-bits (vec3-x point)) (float-bits (vec3-y point)) (float-bits (vec3-z point))
                      (float-bits (vec3-x normal)) (float-bits (vec3-y normal)) (float-bits (vec3-z normal))
                      (material-rgb surface) (float-bits (material-emission surface)))))
    (define (geometry! value surface)
      (when (= (stage-prototype (geometry-identity value) (material-rgb surface) (float-bits (material-emission surface))) 0)
        (let loop ((index 0))
          (when (< index (geometry-vertex-count value))
            (vertex! (geometry-vertex value index) surface) (loop (+ index 1))))
        (let loop ((index 0))
          (when (< index (geometry-index-count value))
            (stage-triangle (geometry-index value index) (geometry-index value (+ index 1)) (geometry-index value (+ index 2)))
            (loop (+ index 3))))))
    (define (model! value)
      (when (= (stage-prototype (model-identity value) -1 0) 0)
        (let loop ((index 0))
          (when (< index (model-vertex-count value))
            (let ((point (model-vertex value index))) (vertex! (painted-vertex point) (painted-material point)))
            (loop (+ index 1))))
        (let loop ((index 0))
          (when (< index (model-index-count value))
            (stage-triangle (model-index value index) (model-index value (+ index 1)) (model-index value (+ index 2)))
            (loop (+ index 3))))))

    ;; ---- Instances retain endpoint transforms and current normal evidence ----

    (define (instance-transform! frame)
      (let ((x (transform-x frame)) (y (transform-y frame)) (z (transform-z frame)) (p (transform-origin frame)))
        (stage-instance (float-bits (vec3-x x)) (float-bits (vec3-x y)) (float-bits (vec3-x z)) (float-bits (vec3-x p))
                        (float-bits (vec3-y x)) (float-bits (vec3-y y)) (float-bits (vec3-y z)) (float-bits (vec3-y p))
                        (float-bits (vec3-z x)) (float-bits (vec3-z y)) (float-bits (vec3-z z)) (float-bits (vec3-z p)))))
    (define (previous-transform! frame)
      (let ((x (transform-x frame)) (y (transform-y frame)) (z (transform-z frame)) (p (transform-origin frame)))
        (stage-before (float-bits (vec3-x x)) (float-bits (vec3-x y)) (float-bits (vec3-x z)) (float-bits (vec3-x p))
                      (float-bits (vec3-y x)) (float-bits (vec3-y y)) (float-bits (vec3-y z)) (float-bits (vec3-y p))
                      (float-bits (vec3-z x)) (float-bits (vec3-z y)) (float-bits (vec3-z z)) (float-bits (vec3-z p)))))
    (define (absolute-value value) (if (< value 0.0) (- 0.0 value) value))
    (define (maximum-magnitude a b)
      (if (> (absolute-value a) (absolute-value b)) (absolute-value a) (absolute-value b)))
    (define (vector-magnitude value)
      (maximum-magnitude (vec3-x value) (maximum-magnitude (vec3-y value) (vec3-z value))))
    (define (normal-bits value)
      (let ((copied (f64->f32 value)))
        (when (and (not (= value 0.0)) (= (f32->f64 copied) 0.0)) (unreachable))
        (f32->bits copied)))
    ;; One common positive scale preserves inverse-transpose directions while
    ;; keeping coefficients bounded. Reflection still follows determinant sign.
    ;; Nonzero coefficients must survive F32 copying; GPU normals normalize
    ;; before raster interpolation, never across the motion interval.
    (define (instance-normal! frame)
      (let* ((x (transform-x frame)) (y (transform-y frame)) (z (transform-z frame))
             (cx (cross y z)) (cy (cross z x)) (cz (cross x y))
             (peak (maximum-magnitude (vector-magnitude cx) (maximum-magnitude (vector-magnitude cy) (vector-magnitude cz))))
             (scale (/ (if (< (dot x cx) 0.0) -1.0 1.0) peak))
             (nx (v* cx scale)) (ny (v* cy scale)) (nz (v* cz scale)))
        (stage-normal (normal-bits (vec3-x nx)) (normal-bits (vec3-x ny)) (normal-bits (vec3-x nz))
                      (normal-bits (vec3-y nx)) (normal-bits (vec3-y ny)) (normal-bits (vec3-y nz))
                      (normal-bits (vec3-z nx)) (normal-bits (vec3-z ny)) (normal-bits (vec3-z nz)))))
    (define (instance! frame previous moving)
      (instance-transform! frame) (instance-normal! frame)
      (when moving (previous-transform! previous)))
    ;; Both complete hierarchies act on current local geometry. Ordinary groups
    ;; retain their local transform at both endpoints; moving groups supply two.
    (define (previous-frame parent local moving)
      (if moving (compose parent local) identity-transform))
    (define (node! node parent previous moving)
      (match node
        ((mesh geometry surface local)
         (begin (geometry! geometry surface)
                (instance! (compose parent local) (previous-frame previous local moving) moving)))
        ((model-instance value local)
         (begin (model! value)
                (instance! (compose parent local) (previous-frame previous local moving) moving)))
        ((group local children)
         (nodes! children (compose parent local) (previous-frame previous local moving) moving))
        ((moving-group before current children)
         (nodes! children (compose parent current) (previous-frame previous before moving) moving))))
    (define (nodes! values parent previous moving)
      (unless (null? values)
        (node! (car values) parent previous moving)
        (nodes! (cdr values) parent previous moving)))
    (define (dependencies! values)
      (unless (null? values)
        (stage-dependency (car values)) (dependencies! (cdr values))))
    (define (reveal! value)
      (match value
        ((no-reveal) (unit))
        ((radial-reveal identity x y radius edge elapsed duration)
         (stage-reveal identity (float-bits x) (float-bits y) (float-bits radius)
                       (float-bits edge) elapsed duration))))
    (define (batch! value)
      (stage-batch (batch-key value) (batch-state-mask value))
      (stage-opacity (float-bits (batch-opacity value)) (if (batch-pulse value) (+ (batch-phase value) 1) 0))
      (stage-motion (batch-duration value))
      (when (> (batch-clock-owner value) 0) (stage-motion-clock (batch-clock-owner value)))
      (when (batch-unordered value) (stage-unordered))
      (reveal! (batch-reveal value))
      (dependencies! (batch-dependencies value))
      (when (= (reuse-batch?) 0)
        (nodes! ((batch-nodes value)) identity-transform identity-transform (> (batch-duration value) 0))))
    (define (batches! values)
      (unless (null? values) (batch! (car values)) (batches! (cdr values))))
    (define (present-scene! value)
      (scene-uniforms! value)
      (batches! (scene-batches value)) (unit))
    (define (present-scene-in! value x y width height)
      (stage-viewport x y width height)
      (present-scene! value))
    (define (present-scene-inset! key value x y width height)
      (begin-inset key x y width height)
      (present-scene! value)
      (end-inset))))
