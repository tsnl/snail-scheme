;; The material texture covers the fixed survey. Each dirty four-metre tile
;; is a separate compute job; a mark keeps the same texels across camera cuts.
(define-library (apps iygtw road-film)
  (export RoadFilm road-film paint-road!)
  (import
   (snail core base)
   (snail shell math)
   (snail shell gpu)
   (snail shell game physics)
   (snail shell game terrain)
   (snail shell graphics pod)
   (only (snail shell graphics animation) v4)
   (snail shell graphics kernel)
   (snail shell graphics trace scene)
   (apps iygtw soil)
   (apps iygtw soil-shader))
  (begin
    (record RoadFilm
      ((west F64)
       (north F64)
       (cols I64)
       (rows I64)
       (last I64)
       (occupied (List I64))
       (buffer GpuBuffer)
       (kernel GpuComputePipeline)
       (group GpuBindGroup)))
    (record Stamp
      ((bounds Vec4f)
       (effect Vec4f)))
    (define word (→ (Shape Vec4f)) (shape))
    (define (floats (a F64) (b F64) (c F64) (d F64)) (→ Vec4f)
      (v4 (f64->f32 a) (f64->f32 b) (f64->f32 c) (f64->f32 d)))
    ;; Seed each road tile once with its underlying damp earth. Later uploads
    ;; revisit just occupied tiles, including one final pass when a rut expires.
    (define (road-tiles (ground Terrain) (surfaces Bytes) (cols I64) (rows I64)) (→ (List I64))
      (let ((road (make-array (* cols rows) #f)))
        (let loop ((i 0))
          (when (< i (array-length surfaces))
            (let ((kind (u8->i32 (array-ref surfaces i))))
              (when (or (= kind 1) (= kind 2))
                (let ((x (quotient (modulo i (● ground cols)) 4))
                      (z (quotient (quotient i (● ground cols)) 4)))
                  (array-set! road (+ x (* z cols)) #t))))
            (loop (+ i 1))))
        (filter (lambda (i) (array-ref road i)) (iota (array-length road)))))
    (define (road-film (gpu Gpu) (scene Scene) (ground Terrain) (surfaces Bytes)) (→ RoadFilm)
      (let* ((cols (quotient (+ 3 (● ground cols)) 4)) (rows (quotient (+ 3 (● ground rows)) 4))
             (west (i64->f64 (● ground west))) (north (i64->f64 (● ground north)))
             (frame (floats west north (/ 0.25 (i64->f64 cols)) (/ 0.25 (i64->f64 rows))))
             (plane (configure-ground-layer! gpu
                                             scene
                                             (i64->i32 (* 64 cols))
                                             (i64->i32 (* 64 rows))
                                             frame))
             (data (storage-buffer gpu "road/stamps" 1048576 (list (CopyDst))))
             (module ((● gpu create-shader-module)
                      (new ShaderModuleDescriptor (label "road/film") (code mud-shader))))
             (kernel (compute-kernel gpu module "road" "paint"))
             (group (kernel-group gpu
                                  kernel
                                  0
                                  "road/film"
                                  (list (BufferEntry 0 data 0 0) (TextureEntry 1 (● plane view))))))
        ((● gpu destroy) (ModuleObject module))
        (new RoadFilm (west west) (north north) (cols cols) (rows rows) (last -100)
             (occupied (road-tiles ground surfaces cols rows))
             (buffer data)
             (kernel kernel)
             (group group))))
    (define (bin (n F64) (origin F64) (count I64)) (→ I64)
      (max 0 (min (- count 1) (f64->i64 (floor (* 0.25 (- n origin)))))))
    (define (mark! (m RoadFilm)
                   (tiles (Array (List Stamp)))
                   (x0 F64)
                   (z0 F64)
                   (x1 F64)
                   (z1 F64)
                   (s Stamp))
      (→ Unit)
      (let rows ((z (bin z0 (● m north) (● m rows))))
        (when (<= z (bin z1 (● m north) (● m rows)))
          (let cols ((x (bin x0 (● m west) (● m cols))))
            (when (<= x (bin x1 (● m west) (● m cols)))
              (let ((i (+ x (* z (● m cols))))) (array-set! tiles i (Cons s (array-ref tiles i))))
              (cols (+ x 1))))
          (rows (+ z 1)))))
    (define (tiles-of (m RoadFilm) (basins (List Basin)) (s Soil)) (→ (Array (List Stamp)))
      (let ((tiles (make-array (* (● m cols) (● m rows)) (ann (Nil) (List Stamp))))
            (tick (● s tick)))
        (for-each (lambda (r)
                    (let ((a (● r a)) (b (● r b)))
                      (mark! m tiles (- (min (● a x) (● b x)) 0.17) (- (min (● a z) (● b z)) 0.17)
                             (+ (max (● a x) (● b x)) 0.17) (+ (max (● a z) (● b z)) 0.17)
                             (new Stamp (bounds (floats (● a x) (● a z) (● b x) (● b z)))
                                  (effect (floats (● r load)
                                                  (* 0.02 (i64->f64 (- tick (● r born))))
                                                  0.0
                                                  0.0))))))
                  (● s ruts))
        (for-each (lambda (item)
                    (let* ((i (● item first))
                           (b (● item second))
                           (p (● b at))
                           (x (● p x))
                           (z (● p z))
                           (rx (● b rx))
                           (rz (● b rz))
                           (w (find (lambda (w) (= (● w index) i)) (● s wakes)))
                           (age
                            (match w ((Some a) (* 0.02 (i64->f64 (- tick (● a tick))))) (_ 100.0)))
                           (hit (match w ((Some a) (● a at)) (_ p))))
                      (mark! m
                             tiles
                             (- x (* 1.3 rx))
                             (- z (* 1.3 rz))
                             (+ x (* 1.3 rx))
                             (+ z (* 1.3 rz))
                             (new Stamp (bounds (floats x z rx rz))
                                  (effect (floats (negate (pool-level w tick))
                                                  age
                                                  (● hit x)
                                                  (● hit z)))))))
                  (zip (iota (length basins)) basins))
        tiles))
    (define (paint-road! (gpu Gpu) (m RoadFilm) (basins (List Basin)) (s Soil)) (→ Unit)
      (when (or (< (● s tick) (● m last)) (>= (- (● s tick) (● m last)) 6))
        (let* ((tiles (tiles-of m basins s))
               (active
                (filter (lambda (i) (not (null? (array-ref tiles i)))) (iota (array-length tiles))))
               (jobs
                (append active (filter (lambda (i) (null? (array-ref tiles i))) (● m occupied))))
               (count (length jobs)))
          (set! (● m last) (● s tick)) (set! (● m occupied) active)
          (unless (null? jobs)
            (let loop ((rest jobs)
                       (index (+ 1 count))
                       (headers (ann (Nil) (List Vec4f)))
                       (data (ann (Nil) (List Vec4f))))
              (match rest
                ((Cons i tail)
                 (let* ((cell (array-ref tiles i)) (n (length cell))
                        (header
                         (floats (i64->f64 (modulo i (● m cols))) (i64->f64 (quotient i (● m cols)))
                                 (i64->f64 index) (i64->f64 n))))
                   (loop tail (+ index (* 2 n)) (Cons header headers)
                         (fold-left (lambda (out v) (Cons (● v effect) (Cons (● v bounds) out)))
                                    data
                                    cell))))
                ((Nil)
                 (let* ((words (Cons (floats (● m west) (● m north) 0.0 0.0)
                                     (append (reverse headers) (reverse data))))
                        (encoder ((● gpu create-command-encoder)))
                        (pass ((● gpu begin-compute-pass) encoder)))
                   ((● gpu write-buffer) (● m buffer) 0 (pack word words))
                   ((● gpu set-compute-pipeline) pass (● m kernel))
                   ((● gpu set-compute-bind-group) pass 0 (● m group))
                   ((● gpu dispatch-workgroups) pass 8 8 (i64->i32 count))
                   ((● gpu end-compute-pass) pass)
                   ((● gpu submit) (list ((● gpu finish) encoder)))))))))))))
