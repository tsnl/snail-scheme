;; A single world and light environment serve the landscape, cyclist and dog.
(define-library (apps iygtw render)
  (export Renderer make-renderer draw! reset-camera! view-bearing light-name quality-name)
  (import
   (snail core base)
   (snail shell math)
   (only (snail shell gpu) Gpu view-of ViewObject)
   (snail shell game physics)
   (snail shell game terrain)
   (snail shell game locomotion)
   (only (snail shell game vehicle) signed-speed)
   (snail shell game chase)
   (only (snail shell game rigid-body)
         V3
         v3
         v+
         v-
         scaled
         cross
         unit-vector
         rotated
         between-rotations)
   (snail shell graphics gltf)
   (snail shell graphics gltf animation)
   (snail shell graphics animation)
   (only (snail shell graphics pod) Vec2f Vec3f Vec4f Mat4x4f)
   (only (snail shell graphics raster) camera-3d PinholeRange Camera3D Camera3D-scene-time-set)
   (only (snail shell graphics bvh) ray-size)
   (snail shell graphics environment)
   (snail shell graphics trace scene)
   (snail shell graphics trace photography)
   (snail shell graphics trace render)
   (only (snail shell graphics passes) Photographic)
   (apps iygtw ride)
   (apps iygtw soil)
   (apps iygtw rider)
   (apps iygtw road-film))
  (begin

    ;; ---- Posed actors ----

    (record Actors
      ((rider Rig)
       (dog Rig)
       (pedal Clip)
       (climb Clip)
       (reach Clip)
       (standing-reach Clip)
       (arms (List I64))
       (rest Clip)
       (brace Clip)
       (tumble Clip)
       (walk-back Clip)
       (idle Clip)
       (walk Clip)
       (run Clip)
       (step-left Clip)
       (step-right Clip)
       (human (List I64))
       (bracing-bones (List I64))
       (walking-bones (List I64))
       (left-leg (List I64))
       (roll Clip)
       (steer Clip)
       (trot Clip)
       (wheels (List I64))
       (fork (List I64))))
    (define (actors (rider Rigged) (dog Rigged)) (→ Actors)
      (let* ((r (● rider rig))
             (bones (lambda ((names (List String))) (→ (List I64))
                      (concatenate (map (lambda (name) (named-branch r name)) names))))
             (arms (bones (list "LUpperArm" "LForearm" "LHand" "RUpperArm" "RForearm" "RHand")))
             (trunk (named-branch r "Body")) (left (bones (list "LThigh" "LShin" "LFoot")))
             (walking (append trunk (append left (bones (list "RThigh" "RShin" "RFoot"))))))
        (new Actors (rider r) (dog (● dog rig))
             (pedal (named-clip rider "Pedal")) (climb (named-clip rider "Climb"))
             (reach (named-clip rider "Reach")) (standing-reach (named-clip rider "Standing reach"))
             (arms arms) (bracing-bones (append trunk arms)) (walking-bones walking)
             (human (append walking arms)) (left-leg left)
             (rest (named-clip rider "Rest")) (brace (named-clip rider "Brace"))
             (tumble (named-clip rider "Tumble")) (walk-back (named-clip rider "Walk back"))
             (idle (named-clip rider "Idle"))
             (walk (named-clip rider "Walk"))
             (run (named-clip rider "Run"))
             (step-left (named-clip rider "Step left")) (step-right (named-clip rider "Step right"))
             (roll (named-clip rider "Roll"))
             (steer (named-clip rider "Steer")) (trot (named-clip dog "Trot"))
             (wheels (append (named-branch r "WheelBack") (named-branch r "WheelFront")))
             (fork (named-branch r "Fork")))))
    (define (column (v V3) (w F32)) (→ Vec4f)
      (v4 (f64->f32 (● v x)) (f64->f32 (● v y)) (f64->f32 (● v z)) w))
    ;; Local -Z points towards the front wheel. Pitch comes from both contact
    ;; patches, and banking rotates around that pitched frame.
    (define (mount (g Terrain) (b Body) (lean F64) (span F64) (front-depth F64) (rear-depth F64))
      (→ Mat4x4f)
      (let* ((p (● b position)) (f (forward (● b heading)))
             (ahead (unit-vector (v3 (● f x)
                                     (+ (ground-slope g p f span)
                                        (/ (- rear-depth front-depth) span))
                                     (● f z))))
             (right (v3 (negate (● f z)) 0.0 (● f x))) (up (cross right ahead))
             (c (cos lean)) (s (sin lean)))
        (new Mat4x4f (x (column (v+ (scaled right c) (scaled up (negate s))) 0.0))
             (y (column (v+ (scaled up c) (scaled right s)) 0.0))
             (z (column (scaled ahead -1.0) 0.0))
             (w (column
                 (v3 (● p x)
                     (+ (- (ground-height g p) (* 0.5 (+ front-depth rear-depth))) (* 0.14 (* s s)))
                     (● p z))
                 1.0)))))
    (define (phase-pose (rig Rig) (clip Clip) (phase F64)) (→ (Array Transform))
      (sample-pose rig clip (* (- phase (floor phase)) (● clip duration))))
    (define (torso-frame (a Fall) (b Fall) (t F64)) (→ Mat4x4f)
      (let* ((from (● a torso center)) (to (● b torso center))
             (p (v+ from (scaled (v- to from) t)))
             (q (between-rotations (● a torso orientation) (● b torso orientation) t)))
        (new Mat4x4f (x (column (rotated q (v3 1.0 0.0 0.0)) 0.0))
             (y (column (rotated q (v3 0.0 1.0 0.0)) 0.0))
             (z (column (rotated q (v3 0.0 0.0 1.0)) 0.0))
             (w (column (v- p (rotated q rider-center)) 1.0)))))
    ;; The rider and bicycle share one skin. Only the human joints change
    ;; frames when a foot touches down beside the bicycle or the rider falls.
    (define (split-palette (a Actors) (pose (Array Transform)) (bike Mat4x4f)
                           (person (Array Transform)) (frame Mat4x4f)) (→ (List Mat4x4f))
                           (let* ((rig (● a rider))
                                  (world (posed-nodes rig pose bike))
                                  (other (posed-nodes rig person frame)))
                             (for-each (lambda (i) (array-set! world i (array-ref other i)))
                                       (● a human))
                             (skin-palette rig world)))
    (define (transfer-frame (g Terrain) (b Body) (parked XZ) (bike Mat4x4f) (amount F64))
      (→ Mat4x4f)
      ;; Unbank the rider as their weight leaves the saddle. The parked bicycle
      ;; keeps its pitch, lean and tyre depth throughout the transfer.
      (let* ((p (● b position)) (f (forward (● b heading))) (seated (- 1.0 amount))
             (up (unit-vector (v3 (* seated (f32->f64 (● bike y x)))
                                  (+ amount (* seated (f32->f64 (● bike y y))))
                                  (* seated (f32->f64 (● bike y z))))))
             (right (unit-vector (cross (v3 (● f x) 0.0 (● f z)) up)))
             (height (+ (ground-height g p)
                        (* seated (- (f32->f64 (● bike w y)) (ground-height g parked))))))
        (new Mat4x4f (x (column right 0.0)) (y (column up 0.0)) (z (column (cross right up) 0.0))
             (w (column (v3 (● p x) height (● p z)) 1.0)))))
    (define (foot-pose (a Actors) (w Walker) (old Walker) (clock F64) (t F64)) (→ (Array Transform))
      (let* ((r (● a rider)) (speed (mix (pace (● old body)) (pace (● w body)) t))
             (phase (mix (● old phase) (● w phase) t))
             (stride (blend-poses (phase-pose r (● a walk) phase) (phase-pose r (● a run) phase)
                                  (f64->f32 (running-weight speed)))))
        (blend-poses (phase-pose r (● a idle) clock) stride (f64->f32 (min 1.0 (/ speed 0.75))))))
    (define (parked-palette (a Actors) (g Terrain) (pose (Array Transform)) (bike Mat4x4f)
                            (before Ride) (now Ride) (w Walker) (t F64)) (→ (List Mat4x4f))
                            (let* ((old (match (walker-of (● before travel)) ((Some p) p) (_ w)))
                                   (amount (mix (foot-fraction (● before travel))
                                                (foot-fraction (● now travel))
                                                t))
                                   (p (between-bodies (player-body before) (player-body now) t))
                                   (time (* 0.006
                                            (mix (i64->f64 (● before soil tick))
                                                 (i64->f64 (● now soil tick))
                                                 t)))
                                   (gait (foot-pose a w old time t))
                                   (side (transition-side (● now bike) (● w body position)))
                                   (mid (if (< side 0.0) (● a step-left) (● a step-right)))
                                   (rider (if (>= amount 1.0) gait
                                              (blend-poses (blend-poses pose gait (f64->f32 amount))
                                                           (sample-pose (● a rider) mid 0.0)
                                                           (f64->f32
                                                            (* 4.0 (* amount (- 1.0 amount))))))))
                              (split-palette a
                                             pose
                                             bike
                                             rider
                                             (transfer-frame g
                                                             p
                                                             (● now bike position)
                                                             bike
                                                             amount))))
    (define (rider-palette (a Actors) (g Terrain) (pose (Array Transform)) (mount Mat4x4f)
                           (before Ride) (now Ride) (t F64)) (→ (List Mat4x4f))
                           (let ((rig (● a rider)))
                             (match (● now rider fall)
                               ((Some f)
                                (let* ((prev (match (● before rider fall) ((Some v) v) (_ f)))
                                       (tuck (mix (● prev tuck) (● f tuck) t))
                                       (limbs (sample-pose rig
                                                           (● a tumble)
                                                           (* tuck (● a tumble duration)))))
                                  (split-palette a pose mount limbs (torso-frame prev f t))))
                               (_ (match (walker-of (● now travel))
                                    ((Some w) (parked-palette a g pose mount before now w t))
                                    (_ (joint-palette rig pose mount)))))))
    (define (palette (a Actors) (g Terrain) (before Ride) (now Ride) (t F64)) (→ (List Mat4x4f))
      (let* ((r (● a rider)) (d (● a dog)) (steer (mix (● before steer) (● now steer) t))
             (b (between-bodies (● before bike) (● now bike) t))
             (rest (max 0.0
                        (- 1.0
                           (min 1.0
                                (abs (mix (signed-speed (● before bike))
                                          (signed-speed (● now bike))
                                          t))))))
             (phase (mix (● before crank) (● now crank) t))
             (effort (f64->f32 (mix (● before standing) (● now standing) t)))
             (riding (blend-poses (phase-pose r (● a pedal) phase)
                                  (phase-pose r (● a climb) phase) effort))
             (lock (max 0.0 (min 1.0 (- 0.5 (/ steer 1.20)))))
             (hands (blend-poses (sample-pose r (● a reach) (* lock (● a reach duration)))
                                 (sample-pose r
                                              (● a standing-reach)
                                              (* lock (● a standing-reach duration)))
                                 effort))
             (rider
              (blend-branch (blend-branch riding hands 1.0 (● a arms))
                            (sample-pose r (● a rest) 0.0)
                            (f64->f32 rest)
                            (● a left-leg)))
             (walking (max 0.0 (min 1.0 (* -3.5 (signed-speed b)))))
             (backward (blend-branch rider (phase-pose r (● a walk-back)
                                                       (* -1.6
                                                          (mix (● before wheel) (● now wheel) t)))
                                     (f64->f32 walking)
                                     (● a walking-bones)))
             (braced
              (blend-branch backward (sample-pose r (● a brace) (* lock (● a brace duration)))
                            (f64->f32 (mix (● before rider brace) (● now rider brace) t))
                            (● a bracing-bones)))
             (bars (sample-pose r
                                (● a steer)
                                (* (● a steer duration)
                                   (max 0.0 (min 1.0 (- 0.5 (/ steer 1.18)))))))
             (wheels (phase-pose r (● a roll) (mix (● before wheel) (● now wheel) t)))
             (pose (blend-branch (blend-branch braced bars 1.0 (● a fork)) wheels 1.0 (● a wheels)))
             (trot (phase-pose d (● a trot) (mix (● before stride) (● now stride) t))))
        (append
         (rider-palette a g
                        pose
                        (mount g b (- (mix (● before lean) (● now lean) t) (* 0.12 rest)) 1.08
                               (rut-depth (● now soil) (wheel-at b 0.54))
                               (rut-depth (● now soil) (wheel-at b -0.54)))
                        before now t)
         (joint-palette d
                        trot
                        (mount g (between-bodies (● before dog) (● now dog) t) 0.0 0.45 0.0 0.0)))))

    ;; ---- Sky and camera ----

    (define (light-name (id I64)) (→ String)
      (case id ((0) "Morning") ((1) "High sun") ((2) "Golden hour") (else "Moonrise")))
    (define (point (x F64) (y F64) (z F64)) (→ Vec3f)
      (new Vec3f (x (f64->f32 x)) (y (f64->f32 y)) (z (f64->f32 z))))
    (define (atmosphere (id I64)) (→ Atmosphere)
      (new Atmosphere (sun (case id ((0) (point -0.67 0.41 -0.62)) ((1) (point 0.18 0.93 -0.32))
                                 ((2) (point -0.79 0.19 -0.58)) (else (point -0.72 -0.49 -0.48))))
           (wind (new Vec2f (x 0.17) (y 0.42)))
           (cover (case id ((0) 0.14) ((1) 0.44) ((2) 0.23) (else 0.28)))))
    (define (quality-name (id I64)) (→ String)
      (case id ((0) "240p") ((1) "360p") ((2) "540p") ((3) "720p") ((4) "900p") (else "1080p")))
    (define (size-at (width I32) (height I32) (id I64) (limit F64)) (→ (Pair I32 I32))
      (let* ((w (i32->f64 (max 1 width))) (h (i32->f64 (max 1 height)))
             (lines
              (case id ((0) 240.0) ((1) 360.0) ((2) 540.0) ((3) 720.0) ((4) 900.0) (else 1080.0)))
             (s (min (min 1.0 (sqrt (/ limit (* w h))))
                     (min (/ (* lines (/ 16.0 9.0)) w) (/ lines h)))))
        (new Pair (first (max 1 (f64->i32 (* w s)))) (second (max 1 (f64->i32 (* h s)))))))
    (record Renderer
      ((ground Terrain)
       (basins (List Basin))
       (film RoadFilm)
       (actors Actors)
       (stage MovingScene)
       (sky SkyLight)
       (light I64)
       (tracer Tracer)
       (limit F64)
       (chase (Option Chase))))
    (define (reset-camera! (r Renderer)) (→ Unit)
      (set! (● r chase) (None)) (set! (● r tracer) (discard-trace-history (● r tracer))))
    (define (view-bearing (r Renderer) (bike-heading F64) (yaw F64)) (→ F64)
      (+ yaw (match (● r chase) ((Some c) (● c heading)) (_ bike-heading))))
    (define (camera! (r Renderer)
                     (b Body)
                     (look-height F64)
                     (base-heading F64)
                     (walking F64)
                     (yaw F64)
                     (pitch F64)
                     (boom F64)
                     (dt F64)
                     (aspect F64))
      (→ Camera3D)
      (let* ((g (● r ground)) (p (● b position)) (v (● b velocity))
             (target
              (v3 (+ (● p x) (* 0.14 (● v x))) (ground-height g p) (+ (● p z) (* 0.14 (● v z)))))
             (rig (follow (● r chase) target base-heading dt boom))
             (center (xz (● rig focus x) (● rig focus z))) (y (● rig focus y))
             (ahead (forward (+ (● rig heading) yaw)))
             (back (xz (negate (● ahead x)) (negate (● ahead z))))
             (limit (max 0.32
                         (- (trace-distance center
                                            back
                                            (+ boom 0.32)
                                            (nearby-solids g center (+ boom 0.32)))
                            0.32)))
             (d (min limit (mix (● rig boom) (* boom (cos pitch)) (- 1.0 (exp (* -7.0 dt))))))
             (eye (offset center back d)) (at (offset center ahead (mix 1.35 0.22 walking))))
        (set! (● r chase) (Some (Chase-boom-set rig d)))
        (camera-3d (point (● eye x)
                          (max (+ 0.32 (ground-height g eye)) (+ (+ y 1.33) (* boom (sin pitch))))
                          (● eye z))
                   (point (● at x) (+ y look-height) (● at z))
                   (PinholeRange 0.91 0.12 1800.0)
                   aspect
                   1.0)))

    ;; The boom shortens beside walls. Focus on the rider in view space using
    ;; the camera that actually cleared the obstacle.
    (define (rider-focus (g Terrain) (b Body) (look-height F64) (c Camera3D)) (→ F32)
      (let ((p (● b position)) (eye (● c eye)) (f (● c forward)))
        (max 0.5 (+ (+ (* (- (f64->f32 (● p x)) (● eye x)) (● f x))
                       (* (- (f64->f32 (+ (ground-height g p) look-height)) (● eye y)) (● f y)))
                    (* (- (f64->f32 (● p z)) (● eye z)) (● f z))))))

    ;; ---- Ray-traced presentation ----

    (define (make-renderer (gpu Gpu)
                           (valley Valley)
                           (village Bytes)
                           (bike Bytes)
                           (pet Bytes)
                           (s Ride))
      (→ Renderer)
      (let* ((ground (● valley ground))
             (info ((● gpu request-device)))
             (canvas ((● gpu current-texture)))
             (read (lambda ((paths (List String))) (→ (List Bytes))
                     (unless (null? paths) (panic "village glTF must be self-contained")) (Nil)))
             (rider (read-rigged-gltf bike "./" read)) (dog (read-rigged-gltf pet "./" read))
             (a (actors rider dog))
             (all
              (append-gltf (append-gltf (read-gltf village "./") (● rider model)) (● dog model)))
             (stage (skin-scene gpu
                                (upload-scene gpu read all 512)
                                (list (● rider binding) (● dog binding))))
             (film (road-film gpu (● stage scene) ground (● valley surfaces)))
             (sky (make-atmosphere-light gpu (atmosphere (● s light)) 256))
             (limit (i64->f64 (quotient (i32->i64 (● info storage-binding-size)) ray-size)))
             (size (size-at (● canvas width) (● canvas height) (● s quality) limit)))
        (deform-scene! gpu stage (palette a ground s s 1.0))
        (paint-road! gpu film (● valley basins) (● s soil))
        (new Renderer
          (ground ground)
          (basins (● valley basins))
          (film film)
          (actors a)
          (stage stage)
          (sky sky)
          (light (● s light))
          (limit limit) (chase (None))
          (tracer
           (make-tracer gpu (● stage scene) (● sky environment) (● info format)
                        (● size first) (● size second) 512 (Photographic))))))
    (define (draw! (r Renderer) (gpu Gpu) (before Ride) (s Ride) (t F64) (time F64)
                   (yaw F64) (pitch F64) (boom F64) (elapsed I32)) (→ Unit)
                   ((● gpu work-done))
                   (paint-road! gpu (● r film) (● r basins) (● s soil))
                   (unless (= (● r light) (● s light))
                     (update-atmosphere! gpu (● r sky) (atmosphere (● s light)))
                     (set! (● r light) (● s light)))
                   (let* ((canvas ((● gpu current-texture)))
                          (w (● canvas width))
                          (h (● canvas height))
                          (size (size-at w h (● s quality) (● r limit))) (lines (● size second))
                          (output (new TraceSettings (display-width (min w (* 2 (● size first))))
                                       (display-height (min h (* 2 lines)))))
                          (b (between-bodies (● before bike) (● s bike) t))
                          (on-foot
                           (mix (foot-fraction (● before travel)) (foot-fraction (● s travel)) t))
                          (subject (match (● s rider fall)
                                     ((Some f)
                                      (let* ((old (match (● before rider fall) ((Some v) v) (_ f)))
                                             (q (● old torso center)) (p (● f torso center))
                                             (at
                                              (xz (mix (● q x) (● p x) t) (mix (● q z) (● p z) t))))
                                        (new Pair (first (body at (● b heading)))
                                             (second (max 0.32
                                                          (- (mix (● q y) (● p y) t)
                                                             (ground-height (● r ground) at)))))))
                                     (_ (new Pair
                                          (first
                                           (between-bodies (player-body before) (player-body s) t))
                                          (second (mix 1.29 1.03 on-foot))))))
                          (cut (match (● r chase) ((None) #t) (_ #f)))
                          (cam (camera! r
                                        (● subject first) (● subject second) (● b heading) on-foot
                                        yaw
                                        pitch
                                        (* boom (mix 1.0 0.82 on-foot))
                                        (* 0.001 (i32->f64 elapsed))
                                        (/ (i32->f64 w) (i32->f64 (max h 1)))))
                          (moving (or cut
                                      (and (> on-foot 0.0)
                                           (not (= (● before soil tick) (● s soil tick))))
                                      (not (= (● before rider brace) (● s rider brace)))
                                      (match (● s rider fall) ((Some f) (< (● f rest) 32)) (_ #f))
                                      (> (distance (● b velocity) (xz 0.0 0.0)) 0.001)
                                      (> (distance (● s dog velocity) (xz 0.0 0.0)) 0.001)
                                      (not (= (● before lean) (● s lean)))
                                      (not (= (● before crank) (● s crank)))
                                      (not (= (● before standing) (● s standing)))
                                      (not (= (● before steer) (● s steer)))))
                          (view (view-of gpu (● canvas texture) 1)))
                     (deform-scene! gpu (● r stage) (palette (● r actors) (● r ground) before s t))
                     (when moving (refit-tracer! gpu (● r tracer)))
                     (set! (● r tracer)
                           (draw-traced-samples gpu
                                                (with-photography gpu
                                                                  (resize-tracer gpu
                                                                                 (● r tracer)
                                                                                 (● size first)
                                                                                 lines)
                                                                  (new LensSettings
                                                                    (focus (rider-focus (● r ground)
                                                                                        (● subject
                                                                                           first)
                                                                                        (● subject
                                                                                           second)
                                                                                        cam))
                                                                    (aperture 0.021)
                                                                    (density (case (● s light)
                                                                               ((0) 0.0038)
                                                                               ((1) 0.0014)
                                                                               ((2) 0.0055)
                                                                               (else 0.0048)))
                                                                    (level 5.3)
                                                                    (falloff 0.095)
                                                                    (range 230.0)
                                                                    (anisotropy 0.48)
                                                                    (exposure 1.0)))
                                                view (Camera3D-scene-time-set cam (f64->f32 time))
                                                (/ 1.0 (i32->f32 lines))
                                                (if (= (● s light) 3) 145.0 1.16)
                                                (● s bounces) moving output (● s samples)))
                     ((● gpu destroy) (ViewObject view))))))
