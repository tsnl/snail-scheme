;; A rider can absorb a loss of wheel speed through their arms. Once that
;; travel is exhausted, the bicycle and the rider carry separate momentum.
(define-library (apps iygtw rider)
  (export Rider Fall mounted-rider rider-response advance-fall fallen? can-remount? rider-center)
  (import
   (snail core base)
   (snail shell math)
   (snail shell wire)
   (snail shell game physics)
   (snail shell game terrain)
   (snail shell game vehicle)
   (snail shell game rigid-body))
  (begin
    (record Fall
      ((torso RigidBody)
       (ticks I64)
       (rest I64)
       (tuck F64)) (deriving Serialize Deserialize))
    (record Rider
      ((brace F64)
       (rate F64)
       (fall (Option Fall))) (deriving Serialize Deserialize))
    (define (mounted-rider) (→ Rider) (new Rider (brace 0.0) (rate 0.0) (fall (None))))
    (define (fallen? (r Rider)) (→ Bool) (match (● r fall) ((Some _) #t) (_ #f)))
    (define (can-remount? (r Rider)) (→ Bool)
      (match (● r fall) ((Some f) (>= (● f rest) 12)) (_ #f)))
    ;; COM in the Roadster rig's Y-up, -Z-forward frame.
    (define rider-center (→ V3) (v3 0.0 1.22 0.035))
    (define (release-rider (g Terrain) (b Body) (lost XZ)) (→ Fall)
      (let* ((p (● b position)) (v (● b velocity)) (yaw (● b heading))
             (q (around-y (negate yaw))) (right (rotated q (v3 1.0 0.0 0.0)))
             (center (v+ (v3 (● p x) (ground-height g p) (● p z)) (rotated q rider-center)))
             (torso (box-body 54.0 (v3 0.46 1.10 0.41) center q))
             (impact (v3 (● lost x) 0.0 (● lost z)))
             (launch (v3 (● v x) (+ 0.35 (* 0.10 (sqrt (squared impact)))) (● v z))))
        (apply-impulse! torso center (scaled launch 54.0))
        (apply-torque-impulse! torso
                               (v+
                                (scaled right (* -3.1 (dot impact (rotated q (v3 0.0 0.0 -1.0)))))
                                (scaled (rotated q (v3 0.0 0.0 1.0)) (* -2.8 (dot impact right)))))
        (new Fall (torso torso) (ticks 0) (rest 0) (tuck 0.0))))
    (define (rider-response (g Terrain) (r Rider) (b Body) (hit BicycleContact) (braking Bool))
      (→ Rider)
      (let* ((lost (● hit lost)) (forward-axis (forward (● b heading)))
             (closing (+ (* (● lost x) (● forward-axis x)) (* (● lost z) (● forward-axis z))))
             (shock (distance lost (xz 0.0 0.0)))
             (decel (if braking (max 0.0 (- (signed-speed b) (signed-speed (● hit bike)))) 0.0))
             (impulse (+ (* 2.6 (max 0.0 closing)) (* 0.85 decel)))
             (rate (+ (● r rate) (- impulse (* 0.02 (+ (* 47.0 (● r brace)) (* 8.2 (● r rate)))))))
             (brace (max 0.0 (min 1.0 (+ (● r brace) (* rate 0.02))))))
        (if (and (> shock 4.9) (> (+ (* 0.65 shock) (* 0.35 (max 0.0 closing))) 4.85))
            (Rider-fall-set r (Some (release-rider g b lost)))
            (new Rider (brace (if (< (+ brace (abs rate)) 0.001) 0.0 brace))
                 (rate (if (or (= brace 0.0) (and (= brace 1.0) (> rate 0.0))) 0.0 rate))
                 (fall (None))))))
    (define shape (→ (List Ball))
      (list (ball (v3 0.0 -0.18 0.15) 0.22) (ball (v3 -0.16 0.21 -0.03) 0.16)
            (ball (v3 0.16 0.21 -0.03) 0.16) (ball (v3 0.0 0.45 -0.09) 0.18)
            (ball (v3 -0.13 -0.54 -0.04) 0.16) (ball (v3 0.13 -0.50 0.07) 0.16)))
    (define (ground-contact (g Terrain) (body RigidBody) (fixed RigidBody) (s Ball))
      (→ (Option Contact))
      (let* ((c (● s center)) (p (xz (● c x) (● c z)))
             (n (v3 (negate (ground-slope g p (xz 1.0 0.0) 0.4)) 1.0
                    (negate (ground-slope g p (xz 0.0 1.0) 0.4)))))
        (plane-contact body fixed s (v3 (● c x) (ground-height g p) (● c z)) n 0.76 0.01)))
    (define (wall-contact (body RigidBody) (fixed RigidBody) (s Ball) (column SolidColumn))
      (→ (Option Contact))
      (let* ((wall (● column base)) (top (● column top)) (c (● s center)) (x (● c x)) (z (● c z))
             (px (max (● wall west) (min (● wall east) x)))
             (pz (max (● wall north) (min (● wall south) z)))
             (py (min (● c y) top))
             (n (v3 (- x px) (- (● c y) py) (- z pz)))
             (d (sqrt (squared n))))
        (cond ((>= d (● s radius)) (None))
              ((> d 0.00001) (plane-contact body fixed s (v3 px py pz) n 0.50 0.01))
              (else
               (let* ((dx (min (- x (● wall west)) (- (● wall east) x)))
                      (dz (min (- z (● wall north)) (- (● wall south) z)))
                      (dy (- top (● c y)))
                      (side (cond ((< dy (min dx dz)) (v3 0.0 1.0 0.0))
                                  ((< dx dz)
                                   (v3 (if (< (- x (● wall west)) (- (● wall east) x)) -1.0 1.0)
                                       0.0
                                       0.0))
                                  (else (v3 0.0
                                            0.0
                                            (if (< (- z (● wall north)) (- (● wall south) z))
                                                -1.0
                                                1.0))))))
                 (plane-contact body
                                fixed
                                s
                                (v+ c (scaled side (min dy (min dx dz))))
                                side
                                0.50
                                0.01))))))
    (define (contacts (hit (Fn A → (Option Contact))) (xs (List A))) (→ (List Contact)) (∀ (A))
      (fold-right (lambda (x rest) (match (hit x) ((Some c) (Cons c rest)) (_ rest))) (Nil) xs))
    (define (fall-step! (g Terrain) (body RigidBody) (walls (List SolidColumn))) (→ Bool)
      (accelerate! body (v3 0.0 -9.81 0.0) 0.01)
      (integrate! body 0.01)
      (let* ((fixed (fixed-body)) (balls (world-balls body shape))
             (grounds (contacts (lambda (s) (ground-contact g body fixed s)) balls))
             (sides (concatenate
                     (map (lambda (s) (contacts (lambda (w) (wall-contact body fixed s w)) walls))
                          balls))))
        (solve-contacts! (append grounds sides) 5)
        (or (not (null? grounds)) (any? (lambda (hit) (> (● hit normal y) 0.55)) sides))))
    (define (advance-fall (g Terrain) (r Rider)) (→ Rider)
      (match (● r fall)
        ((None) r)
        ((Some f)
         (if (>= (● f rest) 32) r
             (let* ((b (copy-rigid (● f torso))) (c (● b center))
                    (walls (nearby-columns g (xz (● c x) (● c z)) 1.4))
                    (first (fall-step! g b walls)) (second (fall-step! g b walls))
                    (grounded (or first second)) (turn (sqrt (squared (spin b))))
                    (still (and grounded (< turn 0.65) (< (squared (velocity b)) 0.16)))
                    (target (min 1.0 (+ (if grounded 0.55 0.10) (* 0.12 turn)))))
               (when grounded (set! (● b angular) (scaled (● b angular) 0.955)))
               (Rider-fall-set r (Some (new Fall (torso b) (ticks (+ 1 (● f ticks)))
                                            (rest (if still (+ 1 (● f rest)) 0))
                                            (tuck (+ (● f tuck)
                                                     (* 0.15 (- target (● f tuck)))))))))))))))
