;; ---- Input and fixed ticks ----

(record Controls
  ((keys (List I32))
   (paused Bool)
   (captured Bool)
   (yaw F64)
   (pitch F64)
   (zoom F64)
   (pacer FramePacer)
   (before Ride)
   (carry I64)
   (seconds F64)))
(define (controls (r Ride)) (→ Controls)
  (new Controls (keys (Nil)) (paused #f) (captured #f) (yaw 0.0) (pitch 0.14) (zoom 5.2)
       (pacer (frame-pacer 30)) (before r) (carry 0) (seconds 0.0)))
(define (held? (c Controls) (a I32) (b I32)) (→ Bool)
  (or (member? a (● c keys)) (member? b (● c keys))))
(define (recenter! (c Controls) (r Renderer)) (→ Unit)
  (set! (● c yaw) 0.0) (set! (● c pitch) 0.14) (set! (● c zoom) 5.2) (reset-camera! r))
(define (action! (d Dom) (h Hud) (v Valley) (r Renderer) (c Controls) (s Ride) (key I32)) (→ Ride)
  (case key
    ((108) (Ride-light-set s (modulo (+ (● s light) 1) 4)))
    ((113) (Ride-quality-set s (modulo (+ (● s quality) 1) 6)))
    ((98) (bell! d h) s)
    ((112 27)
     (set! (● c paused) (not (● c paused)))
     (set! (● c keys) (Nil))
     (set! (● c before) s)
     (set! (● c carry) 0)
     s)
    ((99) (recenter! c r) s)
    ((114) (let ((new (reset-ride v s)))
             (set! (● c keys) (Nil))
             (set! (● c paused) #f)
             (recenter! c r)
             (set! (● c before) new)
             (set! (● c carry) 0)
             new))
    (else s)))
(define (input! (d Dom) (h Hud) (v Valley) (r Renderer) (c Controls) (s Ride) (input Input))
  (→ Ride)
  (match input
    ((KeyDown k _)
     (if (or (member? k (● c keys)) (and (● c paused) (not (member? k (list 112 27 114))))) s
         (begin
           (set! (● c keys) (Cons k (● c keys)))
           (start-sound! d h)
           (action! d h v r c s k))))
    ((KeyUp k) (set! (● c keys) (filter (lambda (held) (not (= k held))) (● c keys))) s)
    ((PointerLock captured)
     (when (and (● c captured) (not captured))
       (set! (● c paused) #t) (set! (● c keys) (Nil)) (set! (● c before) s) (set! (● c carry) 0))
     (set! (● c captured) captured) (when captured (start-sound! d h)) s)
    ((PointerDelta dx dy) (set! (● c yaw) (+ (● c yaw) (* 0.0035 (i32->f64 dx))))
     (set! (● c pitch) (max -0.14 (min 1.04 (+ (● c pitch) (* 0.003 (i32->f64 dy)))))) s)
    ((Wheel pixels)
     (set! (● c zoom) (max 2.6 (min 8.8 (+ (● c zoom) (* 0.009 (i32->f64 pixels))))))
     s)
    (_ s)))
(define (advance! (v Valley) (c Controls) (s Ride) (ms I32)) (→ Ride)
  (if (● c paused) s
      (let ((turn (- (if (held? c 100 2) 1.0 0.0) (if (held? c 97 1) 1.0 0.0)))
            (pedal (held? c 119 3)) (back (held? c 115 4)) (brake (member? 32 (● c keys))))
        (let loop ((s s) (carry (+ (● c carry) (min 200 (i32->i64 ms)))))
          (if (< carry 20) (begin (set! (● c carry) carry) s)
              (begin (set! (● c before) s) (set! (● c seconds) (+ (● c seconds) 0.02))
                     (loop (step-ride v s turn pedal back brake) (- carry 20))))))))
(define (play (events Events) (gpu Gpu) (d Dom) (h Hud) (v Valley) (r Renderer)
              (initial Ride) (save (Fn Ride → Unit))) (→ Unit)
              (let ((c (controls initial)))
                (let loop ((s initial) (since 200))
                  (match (next-event events)
                    ((FrameEvent ms)
                     (let* ((next (advance! v c s ms)) (due (>= (+ since ms) 120)))
                       (match (pace-frame! (● c pacer) ms)
                         ((Some elapsed)
                          (draw! r gpu (● c before) next (/ (i64->f64 (● c carry)) 20.0)
                                 (● c seconds) (● c yaw) (● c pitch) (● c zoom) elapsed))
                         (_ (unit)))
                       (when due (show! d h v next (● c paused))
                             (coast! d
                                     h
                                     (abs (signed-speed (● next bike)))
                                     (and (not (● c paused)) (not (held? c 119 3)))))
                       ((● events report-ready)) (loop next (if due 0 (+ since ms)))))
                    ((InputEvent e) (loop (input! d h v r c s e) 200))
                    ((HudEvent id)
                     (let ((next (action! d h v r c (select-setting d h s id) (action-key h id))))
                       (save next)
                       (loop next 200)))
                    ((Hidden) (set! (● c keys) (Nil)) (coast! d h 0.0 #f) (save s) (loop s 200))
                    ((SaveRequested) (save s) (loop s since)) (_ (loop s since))))))

;; ---- One-time village download ----

(define (open-valley (events Events) (gpu Gpu) (dom Dom) (storage PageStorage) (out OutputPort)
                     (files (Table Bytes))) (→ Unit)
                     (let* ((file (lambda ((name String)) (→ Bytes) (match (table-ref files name)
                                                                      ((Some b) b)
                                                                      (_
                                                                       (panic
                                                                        (string-append
                                                                         "Missing village file "
                                                                         name))))))
                            (v (read-valley (file "ground.bin")
                                            (file "surfaces.bin")
                                            (file "waymarks.bin")))
                            (h (make-hud dom (file "freewheel.wav") (file "bell.wav"))))
                       (run-page events
                                 storage
                                 (lambda () (start-ride v))
                                 (lambda (s) (serialize s))
                                 (lambda (b) (restore-ride v b))
                                 (lambda (s save)
                                   (match (attempt-reading
                                           (lambda () (make-renderer gpu (● v ground)
                                                                     (file "willowbank.glb")
                                                                     (file "roadster.glb")
                                                                     (file "moss.glb")
                                                                     s)))
                                     ((Ok r) (play events gpu dom h v r s save))
                                     ((Err why) (write-line out why) (panic why)))))))
(define (main (events Events) (gpu Gpu) (dom Dom) (fetch Fetch) (store StaticResources)
              (storage PageStorage) (out OutputPort)) (→ Unit)
              (let* ((url "resources.json") (progress (loading-screen dom))
                     (result (match (fetch-catalog fetch url) ((Err why) (Err why))
                                    ((Ok catalog) (acquire-files store url catalog progress)))))
                (match result
                  ((Ok files) (open-valley events gpu dom storage out files))
                  ((Err why) ((● dom set-attribute) ((● dom document-root)) "data-load-error" why)
                   ((● events report-ready))))))
