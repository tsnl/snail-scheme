(import
 (snail core base)
 (snail shell math)
 (snail shell resource)
 (snail shell dom)
 (only (snail shell app) next-event FrameEvent HudEvent)
 (only (snail shell page) Events)
 (snail shell game biped)
 (only (snail shell game terrain) Terrain)
 (apps iygtw walking reference)
 (apps iygtw walk))

;; ---- The motion study ----

(define (element (d Dom) (parent Node) (tag String) (class String)) (→ Node)
  (let ((n ((● d create-element) tag)))
    ((● d set-attribute) n "class" class)
    ((● d insert-node) parent n (None)) n))
(define (caption (d Dom) (parent Node) (tag String) (class String) (s String)) (→ Node)
  (let ((n (element d parent tag class))) ((● d set-text) n s) n))
(define (selector (d Dom) (parent Node) (title String) (values (List String))) (→ Node)
  (let* ((label (element d parent "label" "field")) (text (caption d label "span" "" title))
         (select (element d label "select" "")))
    (for-each (lambda (s) (caption d select "option" "" s) (unit)) values) select))
(define (meter (d Dom) (parent Node) (name String)) (→ Node)
  (let ((m (element d parent "div" "meter")))
    (caption d m "dt" "" name) (caption d m "dd" "" "—")))

(record Study
  ((stage Node)
   (floor Node)
   (bones (Array Node))
   (route Node)
   (pace Node)
   (speed Node)
   (distance Node)
   (status Node)
   (restart Listener)))
(define (open-study (d Dom)) (→ Study)
  (let* ((root ((● d document-root))) (bar (element d root "div" "toolbar"))
         (route (selector d bar "Course" (list "Lantern Row" "Mill Bridge" "High Meadow")))
         (pace (selector d bar "Target speed" (list "1.0 m/s" "0.8 m/s" "1.2 m/s")))
         (retry (caption d bar "button" "restart" "Restart walk"))
         (stage (element d root "div" "stage")) (floor (element d stage "div" "floor"))
         (bones (list->array (map (lambda (s) (element d stage "div" (string-append "bone " s)))
                                  (list "upper far"
                                        "forearm far"
                                        "thigh far"
                                        "shin far"
                                        "shoe far"
                                        "trunk"
                                        "head"
                                        "thigh" "shin" "shoe" "upper" "forearm"))))
         (meters (element d root "dl" "meters")))
    ((● d set-attribute) stage "role" "img")
    ((● d set-attribute)
     stage
     "aria-label"
     "Side view of the walking skeleton on the selected terrain")
    (new Study (stage stage) (floor floor) (bones bones) (route route) (pace pace)
         (speed (meter d meters "Measured speed")) (distance (meter d meters "Distance"))
         (status (meter d meters "Trial")) (restart ((● d listen) retry "click" (Nil) (Allow))))))

;; Coordinates in metres, drawn with the same scale in both directions.
(define (coordinate (x F64)) (→ String) (f64->string (/ (round (* x 10000.0)) 10000.0)))
(define (draw-human! (d Dom) (s Study) (pose (Array F64)) (camera F64) (ground F64)) (→ Unit)
  (define (bone (i I64) (x F64) (y F64) (angle F64)) (→ Unit)
    ((● d set-attribute) (array-ref (● s bones) i) "style"
     (string-append "--x:" (coordinate (- x camera)) ";--y:" (coordinate (- y ground))
                    ";--r:" (coordinate (negate angle)) "rad")))
  (define (leg (i I64) (link I64) (side F64)) (→ Unit)
    (bone i (+ (link-x link) side) (link-height link) (link-pitch link))
    (bone (+ i 1) (+ (link-x (+ link 1)) side) (link-height (+ link 1)) (link-pitch (+ link 1)))
    (let* ((foot (+ link 2)) (q (link-pitch foot)))
      (bone (+ i 2) (+ side (- (link-x foot) (* 0.065 (cos q))))
            (- (link-height foot) (+ (* 0.065 (sin q)) 0.025)) (+ (* 0.5 pi) q))))
  (let* ((q (link-pitch 0)) (x (link-x 0)) (y (link-height 0))
         (sx (- x (* 0.47 (sin q)))) (sy (+ y (* 0.47 (cos q)))))
    (define (arm (i I64) (k I64) (side F64)) (→ Unit)
      (let ((a (+ q (array-ref pose k))))
        (bone i (+ sx side) sy a)
        (bone (+ i 1) (+ (+ sx side) (* 0.275 (sin a))) (- sy (* 0.275 (cos a)))
              (+ a (array-ref pose (+ k 1))))))
    (leg 2 4 -0.065) (leg 7 1 0.065)
    (bone 5 sx sy q) (bone 6 (- x (* 0.75 (sin q))) (+ y (* 0.75 (cos q))) q)
    (arm 0 10 -0.085) (arm 10 8 0.085)))

(define (draw-ground! (d Dom) (s Study) (g (Array F64)) (x F64) (base F64)) (→ Unit)
  (define (point (i I64)) (→ String)
    (string-append "calc(50% + " (coordinate (- (course-x i) x)) " * var(--m)) "
                   "calc(75% - " (coordinate (- (array-ref g i) base)) " * var(--m))"))
  ((● d set-attribute) (● s floor) "style"
   (string-append "clip-path:polygon(0 100%,0 75%,"
                  (string-join (map point (iota (array-length g))) ",")
                  ",100% 75%,100% 100%);--shift:" (coordinate (negate x)))))

(define (speed-command (value String)) (→ F64)
  (cond ((string=? value "0.8 m/s") 0.8) ((string=? value "1.2 m/s") 1.2) (else 1.0)))
(define (read-course (terrain Terrain) (value String)) (→ (Array F64))
  (cond ((string=? value "Mill Bridge") (course terrain mill-bridge))
        ((string=? value "High Meadow") (course terrain high-meadow))
        (else (course terrain lantern-row))))

(define (advance! (clip Stride) (ground (Array F64)) (w (Array F64))
                  (command F64) (phase F64) (debt I64)) (→ (Pair F64 I64))
                  (cond
                   ((or (fallen? ground) (> (link-x 0) 19.0)) (new Pair (first phase) (second 0)))
                   ((< debt 1000) (new Pair (first phase) (second debt)))
                   (else (let ((p (next-phase clip phase command)))
                           (step-walk! w (reference-pose clip p) command ground)
                           (advance! clip ground w command p (- debt 1000))))))

(define (show-walk! (d Dom) (s Study) (g (Array F64)) (pose (Array F64))) (→ Unit)
  (let* ((x (link-x 0)) (floor (course-height g x)))
    (draw-human! d s pose x floor)
    (draw-ground! d s g x floor)
    ((● d set-text)
     (● s speed)
     (string-append (f64->string (/ (round (* 100.0 (forward-speed))) 100.0)) " m/s"))
    ((● d set-text) (● s distance) (string-append (f64->string (/ (round (* 10.0 x)) 10.0)) " m"))
    ((● d set-text)
     (● s status)
     (cond ((fallen? g) "Fell") ((> x 19.0) "Finished") (else "Walking")))))

(define (play (events Events) (d Dom) (s Study) (clip Stride) (terrain Terrain)
              (w (Array F64))) (→ Unit)
              (define (value (n Node)) (→ String) ((● d string-property) n "value"))
              (let restart ((name (value (● s route))))
                (let ((g (read-course terrain name)))
                  (reset-walk! g clip 0.0)
                  (show-walk! d s g (reference-pose clip 0.0))
                  ((● events report-ready))
                  (let loop ((phase 0.0) (carry 0))
                    (match (next-event events)
                      ((HudEvent id)
                       (if (= id (● s restart id))
                           (restart (value (● s route)))
                           (loop phase carry)))
                      ((FrameEvent ms)
                       (if (string=? name (value (● s route)))
                           (let ((next (advance! clip g w (speed-command (value (● s pace))) phase
                                                 (+ carry (* 30 (min 100 (i32->i64 ms)))))))
                             (unless (= phase (● next first))
                               (show-walk! d s g (reference-pose clip (● next first))))
                             (loop (● next first) (● next second)))
                           (restart (value (● s route)))))
                      (_ (loop phase carry)))))))

(define (main (events Events) (d Dom) (resources Resources)) (→ Unit)
  (play events d (open-study d) (read-stride resources) (walking-ground resources)
        (trained-policy resources)))
