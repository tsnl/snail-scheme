(var (@group 0) (@binding 1) (field (texture_storage_2d rgba8unorm write)))
(fn soil_hash ((p vec2f)) (-> f32)
    (let q (fract (* (vec3f (get p xyx)) 0.1031)))
    (let h (+ q (dot q (+ (get q yzx) 33.33))))
    (return (fract (* (+ (get h x) (get h y)) (get h z)))))
(fn soil_noise ((p vec2f)) (-> f32)
