(define-library (apps iygtw hud)
  (export Hud make-hud show! loading-screen select-setting action-key start-sound! bell! coast!)
  (import
   (snail core base)
   (snail shell dom)
   (snail shell static-resource)
   (snail shell base64)
   (snail shell game vehicle)
   (apps iygtw ride)
   (apps iygtw render))
  (begin
    (define (element (d Dom) (parent Node) (tag String) (class String) (text String)) (→ Node)
      (let ((n ((● d create-element) tag)))
        ((● d set-attribute) n "class" class)
        (unless (string=? text "") ((● d set-text) n text))
        ((● d insert-node) parent n (None)) n))
    (define (mib (bytes I64)) (→ String)
      (let ((n (quotient (* bytes 10) 1048576)))
        (string-append (show (quotient n 10)) "." (show (remainder n 10)))))
    (define (loading-screen (d Dom)) (→ (Fn StaticProgress → Unit))
      (let* ((box (element d ((● d document-root)) "div" "download" ""))
             (bar (element d box "progress" "download-bar" ""))
             (detail (element d box "span" "download-size" "")))
        ((● d set-attribute) bar "aria-label" "Village download")
        (lambda (s)
          (let ((done (+ (● s downloaded) (● s cached))) (total (● s total)))
            ((● d set-attribute) bar "max" (show (max 1 total)))
            ((● d set-attribute) bar "value" (show done))
            ((● d set-text) detail (string-append (mib done) " / " (mib total) " MiB"
                                                  (if (> (● s cached) 0)
                                                      (string-append " · "
                                                                     (mib (● s cached))
                                                                     " cached")
                                                      "")
                                                  (if (= done total)
                                                      " · Preparing the valley"
                                                      "")))))))
    (record Hud
      ((place Node)
       (surface Node)
       (speed Node)
       (light Node)
       (quality Node)
       (pause Node)
       (menu Node)
       (resume Node)
       (resolution Node)
       (samples Node)
       (depth Node)
       (selects (List Listener))
       (first-tab Listener)
       (last-tab Listener)
       (reset Node)
       (open Bool)
       (actions (List (Pair Listener I32)))
       (hub-url String)
       (bell-url String)
       (hub (Option Node))
       (bell (Option Node))))
    (define (choice (d Dom) (parent Node) (id String) (label String) (options (List String)))
      (→ Node)
      (let* ((row (element d parent "label" "setting" "")) (caption (element d row "span" "" label))
             (field (element d row "select" id "")))
        (for-each (lambda (value) (element d field "option" "" value) (unit)) options)
        field))
    (define (key-listener (d Dom) (n Node) (key String) (mods I32)) (→ Listener)
      ((● d listen)
       n
       "keydown"
       (list (Key))
       (Chords (list (new Chord (key key) (modifiers mods))))))
    (define (make-hud (d Dom) (hub Bytes) (bell Bytes)) (→ Hud)
      (let* ((root ((● d document-root))) (view (element d root "section" "waymark" ""))
             (name (element d view "h1" "place" "")) (details (element d view "div" "readings" ""))
             (surface (element d details "span" "surface" ""))
             (speed (element d details "span" "speed" ""))
             (buttons (element d root "nav" "options" ""))
             (light (element d buttons "button" "light" ""))
             (quality (element d buttons "button" "quality" ""))
             (pause (element d buttons "button" "pause" "Pause"))
             (menu (element d root "section" "pause-screen" ""))
             (panel (element d menu "div" "pause-panel" ""))
             (title (element d panel "h2" "" "Ride paused"))
             (settings (element d panel "fieldset" "" ""))
             (legend (element d settings "legend" "" "Rendering"))
             (resolution (choice d settings "resolution" "Resolution" (map quality-name (iota 6))))
             (samples (choice d settings "samples" "Samples per pixel" (list "1" "2" "4")))
             (depth (choice d
                            settings
                            "bounces"
                            "Ray bounces"
                            (map (lambda (i) (show (+ i 1))) (iota 8))))
             (actions (element d panel "div" "pause-actions" ""))
             (resume (element d actions "button" "resume" "Resume ride"))
             (reset (element d actions "button" "reset" "Reset to Lantern Row")))
        ((● d set-flag-property) menu "hidden" #t)
        ((● d set-attribute) menu "role" "dialog")
        ((● d set-attribute) menu "aria-modal" "true")
        ((● d set-attribute) menu "aria-label" "Ride paused")
        ((● d set-attribute) pause "aria-haspopup" "dialog")
        ((● d set-attribute) buttons "aria-label" "Ride settings")
        ((● d set-attribute) quality "title" "Change fixed rendering quality (Q)")
        ((● d set-attribute) light "title" "Change time of day (L)")
        (new Hud
          (place name)
          (surface surface)
          (speed speed)
          (light light)
          (quality quality)
          (pause pause) (menu menu) (resume resume) (reset reset) (open #f)
          (first-tab (key-listener d resolution "Tab" shift-key))
          (last-tab (key-listener d reset "Tab" 0))
          (resolution resolution) (samples samples) (depth depth)
          (selects (map (lambda (n) ((● d listen) n "change" (Nil) (Allow)))
                        (list resolution samples depth)))
          (actions
           (append
            (map (lambda (p) (new Pair (first ((● d listen) (● p first) "click" (Nil) (Allow)))
                                  (second (● p second))))
                 (zip (list light quality pause resume reset) (list 108 113 112 112 114)))
            (map (lambda (field)
                   (new Pair (first ((● d listen) field "keydown" (list (Key))
                                     (Chords (list (new Chord (key "Escape") (modifiers 0))
                                                   (new Chord (key "p") (modifiers 0))))))
                        (second 112))) (list resolution samples depth))))
          (hub-url (data-url "audio/wav" hub)) (bell-url (data-url "audio/wav" bell))
          (hub (None)) (bell (None)))))
    (define (action-key (h Hud) (id I32)) (→ I32)
      (match (find (lambda (p) (= (● p first id) id)) (● h actions))
        ((Some p) (● p second)) (_ 0)))
    (define (selected (d Dom) (field Node)) (→ I64)
      (f64->i64 ((● d number-property) field "selectedIndex")))
    (define (select-setting (d Dom) (h Hud) (s Ride) (id I32)) (→ Ride)
      (let ((listeners (● h selects)))
        (cond
         ((= id (● h first-tab id)) ((● d focus-node) (● h reset)) s)
         ((= id (● h last-tab id)) ((● d focus-node) (● h resolution)) s)
         ((= id (● (list-ref listeners 0) id)) (Ride-quality-set s (selected d (● h resolution))))
         ((= id (● (list-ref listeners 1) id))
          (Ride-samples-set s (list-ref (list 1 2 4) (selected d (● h samples)))))
         ((= id (● (list-ref listeners 2) id)) (Ride-bounces-set s (+ 1 (selected d (● h depth)))))
         (else s))))
    (define (show-menu! (d Dom) (h Hud) (s Ride) (paused Bool)) (→ Unit)
      (when (if paused (not (● h open)) (● h open))
        (set! (● h open) paused)
        ((● d set-flag-property) (● h menu) "hidden" (not paused))
        (when paused
          (let ((select (lambda (n i) ((● d set-number-property) n "selectedIndex" (i64->f64 i)))))
            (select (● h resolution) (● s quality))
            (select (● h samples) (case (● s samples) ((1) 0) ((2) 1) (else 2)))
            (select (● h depth) (- (● s bounces) 1))))
        ((● d focus-node) (if paused (● h resume) (● h pause)))))
    (define (show! (d Dom) (h Hud) (v Valley) (s Ride) (paused Bool)) (→ Unit)
      (let ((p (● s bike position)) (speed (abs (signed-speed (● s bike)))) (write (● d set-text)))
        (write (● h place) (place-at v p)) (write (● h surface) (surface-name (surface-at v p)))
        (write (● h speed) (string-append (show (f64->i64 (round (* speed 3.6)))) " km/h"))
        (write (● h light) (light-name (● s light)))
        (write (● h quality) (quality-name (● s quality)))
        (show-menu! d h s paused)
        (write (● h pause) (if paused "Resume" "Pause"))
        ((● d set-attribute) (● h speed) "data-metres" (show (f64->i64 (● s metres))))))
    ;; Use standard audio elements. A rider's first input starts the freewheel;
    ;; its playback rate follows wheel speed and the ratchet is silent under load.
    (define (sound (d Dom) (url String) (looping Bool) (volume F64)) (→ Node)
      (let ((n ((● d create-element) "audio")))
        ((● d set-string-property) n "src" url) ((● d set-flag-property) n "loop" looping)
        ((● d set-number-property) n "volume" volume) ((● d set-flag-property) n "autoplay" #t)
        ((● d insert-node) ((● d document-root)) n (None)) n))
    (define (start-sound! (d Dom) (h Hud)) (→ Unit)
      (match (● h hub) ((None) (set! (● h hub) (Some (sound d (● h hub-url) #t 0.0)))) (_ (unit))))
    (define (bell! (d Dom) (h Hud)) (→ Unit)
      (match (● h bell) ((Some n) ((● d remove-node) n)) (_ (unit)))
      (set! (● h bell) (Some (sound d (● h bell-url) #f 0.32))))
    (define (coast! (d Dom) (h Hud) (speed F64) (free Bool)) (→ Unit)
      (match (● h hub)
        ((Some n) ((● d set-number-property) n "playbackRate" (max 0.4 (min 2.6 (/ speed 4.0))))
         ((● d set-number-property) n "volume" (if free (min 0.22 (* speed 0.04)) 0.0)))
        (_ (unit))))))
