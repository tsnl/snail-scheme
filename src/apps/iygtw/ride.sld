;; All distances are metres. Blender supplies the road, its grade and the
;; collision spans; the bicycle is free to cross the verge or take any lane.
(define-library (apps iygtw ride)
  (export Valley read-valley start-ride Ride step-ride surface-at place-at
          surface-name
          Ride-light-set
          Ride-samples-set
          reset-ride remount-ride Valley-basins-set
          Travel Astride Slowing OnFoot GettingOff GettingOn step-player use-bicycle
          walker-of foot-fraction transition-side nearby-bicycle? player-body
          mix
          pedal-speed)
  (import
   (snail core base)
   (snail shell math)
   (snail shell wire)
   (snail shell little-endian)
   (only (snail shell utf8) utf8->string)
   (snail shell game physics)
   (snail shell game terrain)
   (snail shell game locomotion)
   (snail shell game vehicle)
   (apps iygtw soil)
   (apps iygtw rider))
  (begin

    ;; ---- The survey ----

    (record Place
      ((name String)
       (at XZ)
       (radius F64)))
    (record Valley
      ((ground Terrain)
       (surfaces Bytes)
       (places (List Place))
       (basins (List Basin))))
    (define (places (b Bytes) (i I64)) (→ (List Place))
      (if (= i (array-length b)) (Nil)
          (begin
            (when (> (+ i 8) (array-length b)) (panic "truncated village waymark"))
            (let ((end (+ (+ i 8) (u16 b (+ i 6)))))
              (when (> end (array-length b)) (panic "truncated waymark name"))
              (let ((name (match (utf8->string (subarray b (+ i 8) end))
                            ((Ok s) s) (_ (panic "invalid waymark name")))))
                (Cons (new Place (name name)
                           (at (xz (i64->f64 (i16 b i)) (i64->f64 (i16 b (+ i 2)))))
                           (radius (i64->f64 (u16 b (+ i 4)))))
                      (places b end)))))))
    (define (read-valley (ground Bytes) (surfaces Bytes) (marks Bytes)) (→ Valley)
      (let ((g (read-terrain ground)) (p (places marks 0)))
        (unless (and (not (null? p)) (= (● g cell) 1)
                     (= (array-length surfaces) (* (● g cols) (● g rows))))
          (panic "village ground and surface map disagree"))
        (new Valley (ground g) (surfaces surfaces) (places p) (basins (Nil)))))
    (define (surface-at (v Valley) (p XZ)) (→ I32)
      (let* ((g (● v ground))
             (x (max 0 (min (- (● g cols) 1) (- (f64->i64 (floor (● p x))) (● g west)))))
             (z (max 0 (min (- (● g rows) 1) (- (f64->i64 (floor (● p z))) (● g north))))))
        (u8->i32 (array-ref (● v surfaces) (+ x (* z (● g cols)))))))
    (define (surface-name (s I32)) (→ String)
      (case s ((1) "Paved lane") ((2) "Dirt track") ((3) "Bridge") (else "Meadow")))
    (define (place-at (v Valley) (p XZ)) (→ String)
      (let loop ((rest (● v places)) (best 1.0) (name "Field Road"))
        (match rest
          ((Nil) name)
          ((Cons h tail) (let ((d (/ (distance p (● h at)) (max 1.0 (● h radius)))))
                           (if (< d best) (loop tail d (● h name)) (loop tail best name)))))))

    ;; ---- Bicycle and companion ----

    ;; The bicycle stays in world space throughout a transfer. Both transition
    ;; endpoints are known before the first frame, including which side is clear.
    (enum Travel (Astride) (Slowing) (OnFoot ((walker Walker)))
          (GettingOff ((walker Walker) (ticks I64)))
          (GettingOn ((walker Walker) (ticks I64)))
          (deriving Serialize Deserialize))
    (record Ride
      ((bike Body)
       (dog Body)
       (steer F64)
       (lean F64)
       (crank F64)
       (wheel F64)
       (stride F64)
       (metres F64)
       (light I64)
       (samples I32)
       (standing F64)
       (soil Soil)
       (rider Rider)
       (travel Travel))
      (deriving Serialize Deserialize))
    (define roadster (→ CarDimensions)
      (new CarDimensions (wheelbase 1.08) (width 0.52) (length 1.76)))
    (define (start-ride (v Valley)) (→ Ride)
      (let ((p (● (list-ref (● v places) 0) at)))
        (new Ride (bike (body p 0.0)) (dog (body (offset p (xz 1.0 0.0) 1.15) 0.0))
             (steer 0.0) (lean 0.0) (crank 0.0) (wheel 0.0) (stride 0.0)
             (metres 0.0)
             (light 0)
             (samples 1)
             (standing 0.0)
             (soil (fresh-soil))
             (rider (mounted-rider)) (travel (Astride)))))

    (define (reset-ride (v Valley) (s Ride)) (→ Ride)
      (let ((r (Ride-soil-set (start-ride v) (clear-wheel-contact (● s soil)))))
        (Ride-samples-set (Ride-light-set r (● s light)) (● s samples))))

    (define (remount-ride (v Valley) (s Ride)) (→ Ride)
      (if (not (can-remount? (● s rider))) s
          (let* ((b (● s bike)) (p (● b position)) (yaw (● b heading))
                 (walls (nearby-solids (● v ground) p 3.0))
                 (where (find (lambda (q)
                                (and (clear? (offset q (forward yaw) 0.54) 0.28 walls)
                                     (clear? (offset q (forward yaw) -0.54) 0.28 walls)))
                              (map (lambda (back) (offset p (forward yaw) back))
                                   (list 0.0 -0.35 -0.75 0.35 0.75 -1.2 1.2))))
                 (at (match where ((Some q) q) (_ p))))
            (Ride-soil-set (Ride-rider-set (Ride-lean-set (Ride-bike-set s (body at yaw)) 0.0)
                                           (mounted-rider)) (clear-wheel-contact (● s soil))))))

    (define (mix (a F64) (b F64) (t F64)) (→ F64) (+ a (* (- b a) t)))
    (define (toward (a F64) (b F64) (amount F64)) (→ F64)
      (+ a (max (negate amount) (min amount (- b a)))))
    ;; At low speed or on a steep grade, the rider can put body weight into
    ;; the downstroke. The same load raises the pelvis in the animated pose.
    (define (standing-effort (speed F64) (grade F64) (driving Bool)) (→ F64)
      (if driving
          (max 0.0 (min 1.0 (max (- 1.0 (/ speed 3.6)) (/ (- grade 0.025) 0.085))))
          0.0))

    (define (rolling-resistance (kind I32)) (→ F64)
      (case kind ((0) 0.85) ((2) 0.39) (else 0.145)))
    (define (pedal-speed (speed F64) (grade F64) (surface I32) (pedal Bool) (back Bool)
                         (brake Bool) (dt F64)) (→ F64)
                         (wheel-speed speed grade (rolling-resistance surface) pedal back brake dt))
    (define (forward-speed (speed F64) (grade F64) (rolling F64) (pedal Bool) (dt F64)) (→ F64)
      (let* ((push (+ 3.4 (* 0.50 (standing-effort speed grade pedal))))
             (drive (if pedal (/ push (+ 1.0 (* 0.21 speed))) 0.0))
             (accel (- (- drive (* 8.7 grade)) (* 0.016 (* speed speed)))))
        (if (and (not pedal) (< speed 0.08)) 0.0
            (max 0.0 (min 15.0 (toward (+ speed (* dt accel)) 0.0 (* dt rolling)))))))
    (define (wheel-speed (speed F64) (grade F64) (rolling F64) (pedal Bool) (back Bool)
                         (brake Bool) (dt F64)) (→ F64)
                         (cond (brake (toward speed 0.0 (* dt 6.0)))
                               ((and back (not pedal))
                                (if (> speed 0.0) (toward speed 0.0 (* dt 5.2))
                                    (toward speed -1.65 (* dt 2.3))))
                               ((< speed 0.0) (toward speed 0.0 (* dt (if pedal 3.1 1.9))))
                               (else (forward-speed speed grade rolling pedal dt))))
    (define (companion (g Terrain) (old Body) (bike Body) (dt F64)) (→ Body)
      (let* ((p (● old position)) (b (● bike position)) (yaw (● bike heading))
             (goal (offset (offset b (forward (+ yaw (* pi 0.5))) 1.10)
                           (forward yaw) (if (> (signed-speed bike) 5.0) -0.8 0.36)))
             (d (distance p goal)) (heading (heading-to p goal))
             (speed (min 15.0 (max 0.0 (* 2.5 (- d 0.20))))))
        (if (> (distance p b) 15.0) (body b yaw)
            (travel p (offset (xz 0.0 0.0) (forward heading) speed)
                    (if (> speed 0.24) heading (● old heading)) 0.18
                    (nearby-solids g p 1.3) dt))))
    ;; Wheel angle and body bank come from the same turn radius. A digital
    ;; reversal takes time to pass through straight ahead, even at full lock.
    (define (settle (old F64) (target F64) (amount F64)) (→ F64)
      (if (< (abs (- old target)) 0.0001) target (mix old target amount)))
    (define (steering-angle (old F64) (turn F64) (speed F64)) (→ F64)
      (settle old (atan2 (* turn 0.68) (+ 1.0 (* 0.105 (* speed speed)))) 0.061))

    ;; The Snail fixed tick is 20 ms; steering remains useful at walking pace.
    ;; The two animation clocks follow the crank and the road independently.
    (define (ride-wheels (v Valley) (r Ride) (turn F64) (pedal Bool) (back Bool) (brake Bool))
      (→ Ride)
      (let* ((dt 0.02) (g (● v ground)) (b (● r bike)) (p (● b position)) (s (signed-speed b))
             (grade (ground-slope g p (forward (● b heading)) 1.08))
             (mounted (not (fallen? (● r rider))))
             (wet (wetness (● v basins) (● r soil) p))
             (kind (surface-at v p))
             (packed (if (= kind 2) (rut-depth (● r soil) (wheel-at b 0.54)) 0.0))
             (drag (+ (rolling-resistance kind) (- (* 0.65 wet) (* 3.5 packed))))
             (next (wheel-speed s grade drag (and mounted pedal) (and mounted back)
                                (or brake (not mounted)) dt))
             (steer (steering-angle (● r steer) turn s))
             (hit (bicycle-contact b roadster steer next (nearby-solids g p 2.5) dt))
             (bike (● hit bike))
             (rider (if mounted (rider-response g (● r rider) b hit (or back brake))
                        (advance-fall g (● r rider))))
             (soil (press-wheels (● v basins) (● r soil) b bike
                                 (lambda (q) (let ((kind (surface-at v q)))
                                               (or (= kind 2)
                                                   (and (= kind 1)
                                                        (> (wetness (● v basins) (● r soil) q)
                                                           0.02)))))
                                 (if brake 1.30 (if pedal 1.0 0.82)) mounted))
             (length (distance p (● bike position)))
             (dog (companion g (● r dog) bike dt))
             (lean (atan2 (* (* s s) (tan steer)) (* 9.81 1.08)))
             (driving (and mounted pedal (not brake) (>= (signed-speed bike) 0.0)))
             (rollout (max 2.35 (min 7.0 (+ 1.7 (* 0.72 (abs s)))))))
        (new Ride (bike bike) (dog dog) (steer steer) (travel (● r travel))
             (lean (settle (● r lean) (if (fallen? rider) -1.31 (max -0.54 (min 0.54 lean))) 0.065))
             (soil soil) (rider rider)
             (crank (+ (● r crank)
                       (if driving (/ length rollout) 0.0)))
             (wheel (+ (● r wheel)
                       (/ (* (if (< (signed-speed bike) 0.0) -1.0 1.0) length)
                          (* (* 2.0 pi) 0.355))))
             (stride
              (+ (● r stride) (/ (min 0.30 (distance (● r dog position) (● dog position))) 0.85)))
             (metres (+ (● r metres) length)) (light (● r light)) (samples (● r samples))
             (standing (settle (● r standing) (standing-effort (abs s) grade driving) 0.065)))))

    ;; ---- Parking and walking ----

    (define transfer-ticks (→ I64) 26)
    (define (walker-of (mode Travel)) (→ (Option Walker))
      (match mode
        ((OnFoot w) (Some w))
        ((GettingOff w _) (Some w))
        ((GettingOn w _) (Some w))
        (_ (None))))
    (define (foot-fraction (mode Travel)) (→ F64)
      (let ((t (match mode ((GettingOff _ n) (/ (i64->f64 n) (i64->f64 transfer-ticks)))
                      ((GettingOn _ n) (- 1.0 (/ (i64->f64 n) (i64->f64 transfer-ticks))))
                      ((OnFoot _) 1.0) (_ 0.0))))
        (* (* t t) (- 3.0 (* 2.0 t)))))
    (define (player-body (s Ride)) (→ Body)
      (match (● s travel)
        ((OnFoot w) (● w body))
        ((GettingOff w _) (between-bodies (● s bike) (● w body) (foot-fraction (● s travel))))
        ((GettingOn w _) (between-bodies (● s bike) (● w body) (foot-fraction (● s travel))))
        (_ (● s bike))))
    (define (transition-side (b Body) (p XZ)) (→ F64)
      (let* ((at (● b position)) (right (forward (+ (● b heading) (* 0.5 pi))))
             (x (- (● p x) (● at x))) (z (- (● p z) (● at z))))
        (if (< (+ (* x (● right x)) (* z (● right z))) 0.0) -1.0 1.0)))
    (define (reachable? (g Terrain) (p XZ) (q XZ) (walls (List Footprint))) (→ Bool)
      (and (clear? q 0.25 walls) (clear-path? p q 0.25 walls)
           (< (abs (- (ground-height g p) (ground-height g q))) 0.52)))
    (define (dismount (v Valley) (s Ride)) (→ Ride)
      (let* ((b (● s bike))
             (p (● b position))
             (yaw (● b heading))
             (right (forward (+ yaw (* 0.5 pi))))
             (g (● v ground)) (walls (nearby-solids g p 2.25))
             (side (find (lambda (q) (reachable? g p q walls))
                         (map (lambda (d) (offset p right d)) (list -0.83 0.83)))))
        (match side
          ((Some q) (Ride-travel-set (Ride-bike-set s (body p yaw)) (GettingOff (walker q yaw) 0)))
          (_ (Ride-travel-set s (Astride))))))
    (define (nearby-bicycle? (v Valley) (s Ride) (w Walker)) (→ Bool)
      (let* ((p (● w body position)) (q (● s bike position)) (g (● v ground)))
        (and (< (distance p q) 1.55) (reachable? g p q (nearby-solids g p 2.0)))))
    (define (use-bicycle (v Valley) (s Ride)) (→ Ride)
      (match (● s travel)
        ((OnFoot w) (if (nearby-bicycle? v s w)
                        (Ride-travel-set s
                                         (GettingOn (new Walker
                                                      (body (body (● w body position)
                                                                  (● w body heading)))
                                                      (phase (● w phase)))
                                                    0))
                        s))
        ((Slowing) (Ride-travel-set s (Astride)))
        ((Astride) (cond ((fallen? (● s rider)) (remount-ride v s))
                         ((> (pace (● s bike)) 0.72) (Ride-travel-set s (Slowing)))
                         (else (dismount v s))))
        (_ s)))
    (define (parked-walls (g Terrain) (b Body) (p XZ)) (→ (List Footprint))
      (let ((walls (nearby-solids g p 1.2)))
        (if (> (distance p (● b position)) 2.0) walls
            (append (map (lambda (axle) (let ((q (wheel-at b axle)))
                                          (footprint (● q x) (● q z) 0.34 0.34)))
                         (list -0.52 0.0 0.52))
                    walls))))
    (define (on-foot-tick (v Valley) (s Ride) (mode Travel) (metres F64)) (→ Ride)
      (let* ((next (Ride-travel-set s mode))
             (dog (companion (● v ground) (● s dog) (player-body next) 0.02))
             (soil (rest-ground (● s soil))))
        (set! (● next dog) dog)
        (set! (● next soil) soil)
        (set! (● next metres) (+ (● s metres) metres))
        (set! (● next stride)
              (+ (● s stride) (/ (min 0.30 (distance (● s dog position) (● dog position))) 0.85)))
        (set! (● next standing) (settle (● s standing) 0.0 0.12))
        (set! (● next lean) (settle (● s lean) 0.0 0.12))
        next))
    (define (step-player (v Valley)
                         (s Ride)
                         (side F64)
                         (pedal Bool)
                         (back Bool)
                         (brake Bool)
                         (run Bool)
                         (bearing F64))
      (→ Ride)
      (match (● s travel)
        ((OnFoot w) (let* ((g (● v ground)) (p (● w body position))
                           (ahead (- (if pedal 1.0 0.0) (if back 1.0 0.0)))
                           (next (step-walker g
                                              w
                                              side
                                              ahead
                                              run
                                              bearing
                                              (parked-walls g (● s bike) p)
                                              0.02)))
                      (on-foot-tick v s (OnFoot next) (distance p (● next body position)))))
        ((GettingOff w n)
         (on-foot-tick v s (if (>= (+ n 1) transfer-ticks) (OnFoot w) (GettingOff w (+ n 1))) 0.0))
        ((GettingOn w n)
         (on-foot-tick v s (if (>= (+ n 1) transfer-ticks) (Astride) (GettingOn w (+ n 1))) 0.0))
        ((Slowing) (let ((next (ride-wheels v s side #f #f #t)))
                     (cond ((fallen? (● next rider)) (Ride-travel-set next (Astride)))
                           ((<= (pace (● next bike)) 0.72) (dismount v next)) (else next))))
        (_ (ride-wheels v s side pedal back brake))))
    (define (step-ride (v Valley) (s Ride) (turn F64) (pedal Bool) (back Bool) (brake Bool))
      (→ Ride)
      (step-player v s turn pedal back brake #f (● s bike heading)))))
