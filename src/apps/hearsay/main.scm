;; Hearsay: the page's scene, the prototypes' shell drawn with the cast's
;; art.
(import
 (snail core base)
 (only (snail shell fetch) Fetch)
 (only (snail shell files) FilePicker)
 (snail shell graphics renderer page)
 (snail shell app)
 (snail shell wire)
 (apps hearsay shell)
 (apps hearsay drawing)
 (apps hearsay art)
 (only (snail shell gpu) Gpu)
 (only (snail shell dom) Dom)
 (only (snail shell page) Events)
 (only (snail shell page) PageStorage)
 (only (snail core io) Clock))

(define (main (fetch Fetch)
              (picker FilePicker)
              (gpu Gpu)
              (dom Dom)
              (events Events)
              (storage PageStorage)
              (clock Clock))
  (→ Unit)
  (run-scene dom events storage (new SceneHandler
                                  (initialize new-shell)
                                  (update update-shell)
                                  (start (lambda ()
                                           (configured-drawing
                                            (page-renderer-config fetch picker))))
                                  (draw (lambda (shell drawing)
                                          (draw-shell gpu clock shell drawing art)))
                                  (hud shell-hud)
                                  (image-url drawing-url)
                                  (save (lambda (shell) (serialize (shell-save shell))))
                                  (restore
                                   (lambda (bytes) (shell-restore (deserialize bytes))))))
  (unit))
