;; An isolated white sphere sees unit radiance in every direction. The same
;; glTF material, BRDF, lights and environment lookup run in Willowbank.
(import
 (snail core base)
 (snail core io)
 (snail shell dom)
 (snail shell gpu)
 (snail shell resource)
 (only (snail shell page) Events)
 (snail shell little-endian)
 (snail shell png)
 (only (snail shell math) expt)
 (snail shell graphics pod)
 (snail shell graphics raster)
 (snail shell graphics forward environment)
 (snail shell graphics gltf)
 (snail shell graphics forward scene)
 (snail shell graphics scene)
 (prefix (snail shell graphics renderer) api:)
 (snail shell graphics renderer page)
 (only (snail shell fetch) Fetch)
 (only (snail shell files) FilePicker)
 (only (snail shell graphics passes) Photographic)
 (only (snail shell graphics still) read-linear))

;; ---- The furnace ----

(define side (→ I32) 192)
(define camera (→ Camera3D)
  (camera-3d (new Vec3f (x 0.0) (y 0.0) (z 3.4)) (new Vec3f (x 0.0) (y 0.0) (z 0.0))
             (PinholeRange 0.8 0.05 100.0) 1.0 1.0))
(define (probe (r api:Renderer) (model Gltf) (metal F64) (rough F64)) (→ api:ModelHandle)
  (let ((material (list-ref (● model materials) 0)))
    (set! (● material metallic) metal)
    (set! (● material roughness) rough)
    (api:create-model! r model (lambda (_) (Nil)) (None) (None) (Nil) 0)))

;; ---- Linear measurements and display ----

(define (channel (film Bytes) (offset I64)) (→ F64)
  (let ((word (u32 film offset)))
    (when (= (i64-and word 2139095040) 2139095040) (panic "Non-finite furnace radiance"))
    (f32->f64 (bits->f32 (i64->i32 word)))))

;; Measure each channel independently so a tint cannot cancel in the mean.
(define (patch-mean (film Bytes) (corner I64) (component I64)) (→ F64)
  (let ((w (i32->i64 side)))
    (/ (fold-left (lambda (sum i)
                    (let ((p (+ (* w (+ corner (quotient i 16))) (+ corner (remainder i 16)))))
                      (+ sum (channel film (+ (* 16 p) component)))))
                  0.0 (iota 256))
       256.0)))

(define (byte (value F64)) (→ U8)
  (i32->u8 (f64->i32 (round (max 0.0 (min 255.0 value))))))
(define (display-channel (light F64)) (→ U8)
  (let ((v (* 0.5 light)))
    (byte (* 255.0 (if (<= v 0.0031308) (* 12.92 v) (- (* 1.055 (expt v (/ 1.0 2.4))) 0.055))))))
(define (write-rgb! (pixels Bytes) (i I64) (r U8) (g U8) (b U8)) (→ Unit)
  (array-set! pixels i r)
  (array-set! pixels (+ i 1) g)
  (array-set! pixels (+ i 2) b))

;; Both views come from the same unclipped film. White is zero signed error.
;; The blue and orange ends of the scale are reached at -1 and +1.
(define (previews (film Bytes)) (→ (Pair String String))
  (let* ((count (* (i32->i64 side) (i32->i64 side)))
         (image (make-array (* 4 count) (i32->u8 255)))
         (error (make-array (* 4 count) (i32->u8 255))))
    (let loop ((p 0))
      (when (< p count)
        (let* ((offset (* 16 p)) (red (channel film offset)) (green (channel film (+ offset 4)))
               (blue (channel film (+ offset 8))) (v (/ (+ red (+ green blue)) 3.0)) (i (* p 4))
               (d (min 1.0 (abs (- v 1.0)))))
          (write-rgb! image i (display-channel red) (display-channel green) (display-channel blue))
          (write-rgb! error i (byte (- 255.0 (* d (if (< v 1.0) 222.0 47.0))))
                      (byte (- 255.0 (* d (if (< v 1.0) 161.0 175.0))))
                      (byte (- 255.0 (* d (if (< v 1.0) 91.0 224.0)))))
          (loop (+ p 1)))))
    (new Pair (first (png-data-url (rgba->png side side image)))
         (second (png-data-url (rgba->png side side error))))))

;; ---- Instrument panel ----

(define (element (d Dom) (parent Node) (tag String) (text String)) (→ Node)
  (let ((node ((● d create-element) tag)))
    (unless (string=? text "") ((● d set-text) node text))
    ((● d insert-node) parent node (None))
    node))
(define (selector (d Dom) (parent Node) (title String) (choices (List String))) (→ Node)
  (let* ((label (element d parent "label" title)) (select (element d label "select" "")))
    (for-each (lambda (choice) (element d select "option" choice) (unit)) choices)
    select))
(define (plate (d Dom) (parent Node) (name String) (caption String)) (→ Node)
  (let* ((figure (element d parent "figure" "")) (frame (element d figure "div" ""))
         (img (element d frame "img" "")))
    ((● d set-attribute) img "alt" name)
    ((● d set-attribute) img "width" (show side))
    ((● d set-attribute) img "height" (show side))
    (let ((label (element d figure "figcaption" "")))
      (element d label "strong" name)
      (element d label "span" caption))
    img))
(define (meter (d Dom) (row Node) (name String) (id String)) (→ Node)
  (let ((cell (element d row "div" "")))
    (element d cell "dt" name)
    (let ((reading (element d cell "dd" "—")))
      ((● d set-attribute) reading "id" id) reading)))

(record Panel
  ((material Node)
   (roughness Node)
   (samples Node)
   (button Node)
   (status Node)
   (image Node)
   (difference Node)
   (surface Node)
   (sky Node)
   (duration Node)))
(define (panel (d Dom)) (→ Panel)
  (let* ((root ((● d document-root))) (controls (element d root "section" ""))
         (material (selector d controls "Material" (list "White metal" "White dielectric")))
         (rough (selector d controls "Roughness (%)" (list "100" "50" "10")))
         (samples (selector d controls "MSAA samples" (list "1" "4")))
         (button (element d controls "button" "Run test"))
         (status (element d root "p" "Preparing the renderer…"))
         (row (element d root "dl" "")) (plates (element d root "article" "")))
    ((● d set-attribute) status "role" "status")
    ((● d set-flag-property) button "disabled" #t)
    (new Panel
      (material material)
      (roughness rough)
      (samples samples)
      (button button)
      (status status)
      (image (plate d plates "Linear radiance" "Displayed at half exposure in sRGB"))
      (difference (plate d
                         plates
                         "Difference from unit light"
                         "Blue is loss · white is zero · orange is gain"))
      (surface (meter d row "Surface center" "surface"))
      (sky (meter d row "Environment" "environment"))
      (duration (meter d row "Render + readback" "duration")))))

(define (thousandths (n F64)) (→ String)
  (let* ((k (f64->i64 (round (* (abs n) 1000.0)))) (suffix (show (+ 1000 (remainder k 1000)))))
    (string-append (if (< n 0.0) "-" "") (show (quotient k 1000)) "." (substring suffix 1 4))))
(define (read-meter! (d Dom) (node Node) (film Bytes) (corner I64)) (→ Unit)
  (let* ((rgb (map (lambda (c) (patch-mean film corner c)) (list 0 4 8)))
         (channels (string-append "RGB " (string-join (map thousandths rgb) " / "))))
    ((● d set-text) node (thousandths (/ (fold-left + 0.0 rgb) 3.0)))
    ((● d set-attribute) node "data-rgb" channels)
    ((● d set-attribute) node "aria-label" channels)))
(define (measure! (d Dom) (p Panel) (gpu Gpu) (clock Clock) (r api:Renderer) (samples I32)) (→ Unit)
  ((● gpu work-done))
  (let* ((now (● clock monotonic-nanoseconds)) (start (now))
         (frame (SceneFrame-shadows-set (scene-frame camera side side samples 1.0) #f))
         (film (begin (api:render! r frame) (read-linear gpu (api:renderer-forward r))))
         (ms (quotient (- (now) start) 1000000)) (images (previews film)))
    ((● d set-attribute) (● p image) "src" (● images first))
    ((● d set-attribute) (● p difference) "src" (● images second))
    (read-meter! d (● p surface) film (- (quotient (i32->i64 side) 2) 8))
    (read-meter! d (● p sky) film 8)
    ((● d set-text) (● p duration) (string-append (show ms) " ms"))))

(define (number-choice (d Dom) (control Node)) (→ I64)
  (match (string->i64 ((● d string-property) control "value"))
    ((Some n) n) (_ (panic "Invalid furnace setting"))))
(define (run! (d Dom) (p Panel) (gpu Gpu) (clock Clock) (model Gltf) (r api:Renderer)) (→ Unit)
  (let* ((material ((● d string-property) (● p material) "value"))
         (rough (number-choice d (● p roughness))) (samples (number-choice d (● p samples)))
         (metal (if (string=? material "White metal") 1.0 0.0)))
    ((● d set-flag-property) (● p button) "disabled" #t)
    ((● d set-text) (● p status) "Rendering the furnace…")
    (let ((model (probe r model metal (/ (i64->f64 rough) 100.0))))
      (api:use-model! r model)
      (measure! d p gpu clock r (i64->i32 samples))
      (api:delete-model! r model))
    ((● d set-text)
     (● p status)
     (string-append material " · " (show rough) "% roughness · " (show samples) "× MSAA"))
    ((● d set-flag-property) (● p button) "disabled" #f)))

(define (main (gpu Gpu)
              (d Dom)
              (events Events)
              (clock Clock)
              (resources Resources)
              (fetch Fetch)
              (picker FilePicker))
  (→ Unit)
  (let ((p (panel d)))
    ((● gpu request-device))
    (let* ((model (read-gltf (read-resource resources (link-file "sphere.glb")) ""))
           (r (api:make-renderer gpu (page-renderer-config fetch picker))))
      (api:set-sky! r (furnace-environment gpu) (Photographic))
      ((● d listen) (● p button) "click" (Nil) (Allow))
      (run! d p gpu clock model r)
      ((● events report-ready))
      (let loop ()
        (match ((● d next-event))
          ((Fired _ _) (run! d p gpu clock model r) (loop))
          ((Closed) (api:release-renderer! r))
          (_ (loop)))))))
