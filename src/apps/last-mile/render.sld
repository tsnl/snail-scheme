;; A single tracer sees the same street geometry and moving poses as the driver.
(define-library (apps last-mile render)
  (export Renderer make-renderer draw! render-resolution sky-at)
  (import
   (snail core base)
   (snail shell math)
   (snail shell app)
   (only (snail shell gpu) Gpu view-of ViewObject)
   (only (snail shell graphics pod) Vec4f Vec3f Mat4x4f)
   (only (snail shell graphics animation) posed-nodes skin-palette rigid-binding named-branch)
   (snail shell graphics gltf animation)
   (snail shell graphics gltf)
   (only (snail shell graphics raster) camera-3d Pinhole Camera3D Camera3D-scene-time-set)
   (only (snail shell graphics bvh) ray-size)
   (snail shell graphics trace scene)
   (snail shell graphics trace render)
   (snail shell graphics environment)
   (snail shell game physics)
   (snail shell game atlas)
   (snail shell game roads)
   (snail shell game traffic)
   (snail shell game vehicle)
   (snail shell game boarding)
   (snail shell game humanoid)
   (snail shell game pedestrian)
   (apps last-mile city)
   (apps last-mile game))
  (begin
    (record Renderer
      ((ground Area)
       (roads Roads)
       (read (Fn (List String) → (List Bytes)))
       (taxi Gltf)
       (sedan-model Gltf)
       (people Rigged)
       (actor Humanoid)
       (horizon Gltf)
       (stage MovingScene)
       (sector I64)
       (sky SkyLight)
       (minute I64)
       (tracer Tracer)
       (palette (List Mat4x4f))
       (time F64)
       (pixel-limit F64)
       (budget I32)
       (streak-frames I32)
       (eye XZ)))
    (define (rgba (x F32) (y F32) (z F32) (w F32)) (→ Vec4f) (new Vec4f (x x) (y y) (z z) (w w)))
    (define (color (x F64) (y F64) (z F64) (w F64))
      (→ Vec4f)
      (rgba (f64->f32 x) (f64->f32 y) (f64->f32 z) (f64->f32 w)))
    ;; An equinox sun at SF's latitude in the rotated street frame. Twilight
    ;; blends continuously into a readable blue night and a weaker moon.
    (define (sky-at (minute I64)) (→ Sky)
      (let* ((angle (* (/ (- (i64->f64 minute) 360.0) 720.0) pi))
             (s (sin angle)) (east (cos angle)) (alt (* 0.79 s))
             (toward (if (< alt -0.08) -1.0 1.0))
             (day (max 0.0 (min 1.0 (/ (+ alt 0.11) 0.41))))
             (warm (* day (- 1.0 (min 1.0 (* 1.8 (max 0.0 alt))))))
             (light (if (< alt -0.08) 0.16 (* 8.0 (max 0.0 (min 1.0 (* 6.0 alt)))))))
        (new Sky (sun (color (* toward (- (* 0.9876 east) (* 0.0964 s))) (* toward alt)
                             (* toward (+ (* 0.1573 east) (* 0.6047 s))) 0.9992))
             (sun-light
              (color light (* light (- 0.91 (* 0.31 warm))) (* light (- 0.83 (* 0.47 warm))) 0.0))
             (zenith
              (color (+ 0.038 (* day 0.24)) (+ 0.060 (* day 0.40)) (+ 0.11 (* day 0.66)) 1.0))
             (horizon (color (+ (+ 0.095 (* day 0.77)) (* warm 0.22))
                             (+ 0.13 (* day 0.69))
                             (+ 0.20 (* day 0.51))
                             1.0))
             (ground
              (color (+ 0.040 (* day 0.17)) (+ 0.048 (* day 0.15)) (+ 0.067 (* day 0.10)) 1.0)))))
    (define (column (x F64) (y F64) (z F64) (scale F64)) (→ Vec4f)
      (rgba (f64->f32 (* x scale)) (f64->f32 (* y scale)) (f64->f32 (* z scale)) 0.0))

    ;; Local +z is the model's nose. Sample front/back and side-to-side at
    ;; the wheels, then build an orthonormal frame on their contact plane.
    (define (mount (g Area) (b Body) (lean F64) (sx F64) (sy F64) (sz F64)) (→ Mat4x4f)
      (let* ((p (● b position)) (f (forward (● b heading))) (fx (● f x)) (fz (● f z))
             (l (xz fz (- 0.0 fx)))
             (rise (if (= lean 0.0) 0.0 (* lean (area-slope g p f 2.376))))
             (bank (if (= lean 0.0) 0.0 (* lean (area-slope g p l 1.6))))
             (nz (/ 1.0 (sqrt (+ 1.0 (* rise rise)))))
             (ny (/ 1.0 (sqrt (+ (+ 1.0 (* rise rise)) (* bank bank)))))
             (ux (* ny (- 0.0 (+ (* rise fx) (* bank (● l x))))))
             (uz (* ny (- 0.0 (+ (* rise fz) (* bank (● l z))))))
             (height (area-height g p)))
        (new Mat4x4f
          (x (column (* nz (- (* ny fz) (* uz rise))) (* nz (- (* uz fx) (* ux fz)))
                     (* nz (- (* ux rise) (* ny fx))) sx))
          (y (column ux ny uz sy)) (z (column fx rise fz (* nz sz)))
          (w (rgba (f64->f32 (● p x)) (f64->f32 height) (f64->f32 (● p z)) 1.0)))))


    (define (crew (model Rigged)) (→ Humanoid)
      (new Humanoid
        (rig (● model rig))
        (idle (named-clip model "idle"))
        (walk (named-clip model "walk"))
        (brace (named-clip model "shoot"))
        (drive (named-clip model "racingIdle"))
        (upper-body (named-branch (● model rig) "Spine"))))
    (define (display-body (a Body) (b Body) (t F64)) (→ Body)
      (if (> (distance (● a position) (● b position)) 18.0) b (between-bodies a b t)))
    (define (bones (g Area) (h Humanoid) (a Body) (b Body) (ga Gait) (gb Gait) (t F64) (clock F64))
      (→ (List Mat4x4f))
      (let ((gait (between-gaits ga gb t)))
        (skin-palette (● h rig) (posed-nodes (● h rig) (humanoid-pose h gait clock 0.0)
                                             (mount g
                                                    (display-body a b t)
                                                    (● gait seat)
                                                    0.47
                                                    0.47
                                                    0.47)))))
    (define (world-palette (g Area) (r Roads) (h Humanoid) (a Game) (w Game) (t F64) (clock F64))
      (→ (List Mat4x4f))
      (let ((cars (map (lambda (p)
                         (mount g
                                (display-body (motor-body r (● p first))
                                              (motor-body r (● p second))
                                              t)
                                1.0
                                1.25
                                1.4
                                1.8))
                       (zip (● a traffic) (● w traffic))))
            (walkers (map-indexed (lambda (i p) (let ((u (● p first)) (v (● p second)))
                                                  (bones g
                                                         h
                                                         (● u body)
                                                         (● v body)
                                                         (● u gait)
                                                         (● v gait)
                                                         t
                                                         (+ clock (* (i64->f64 i) 0.37)))))
                                  (zip (● a residents) (● w residents)))))
        (concatenate
         (list (Cons (mount g (display-body (● a cab) (● w cab) t) 1.0 1.25 1.4 1.8) cars)
               (bones g h (driver-body a) (driver-body w) (● a gait) (● w gait) t clock)
               (bones g
                      h
                      (passenger-body a)
                      (passenger-body w)
                      (● a passenger-gait)
                      (● w passenger-gait)
                      t
                      (+ clock 0.28))
               (concatenate walkers)))))
    (define (vertex-count (g Gltf)) (→ I64)
      (fold-left (lambda (n p) (+ n (● p primitive positions count))) 0 (● g placed)))
    ;; The static prefix has no skin binding. Cars use one rigid joint each,
    ;; and the repeated people use the joints of their shared model.
    (define (build-stage (gpu Gpu) (read (Fn (List String) → (List Bytes))) (g Area)
                         (horizon Gltf) (taxi Gltf) (car Gltf) (people Rigged) (w Game))
      (→ MovingScene)
      (let* ((land (append-gltf horizon (city-model g)))
             (cab (append-gltf land taxi))
             (cars (append-gltf cab car))
             (all (append-gltf cars (● people model)))
             (traffic-parts (list-drop (● cars placed) (length (● cab placed))))
             (person (list-drop (● all placed) (length (● cars placed))))
             (actors (iota (+ 2 (length (● w residents)))))
             (placed (append (● cab placed)
                             (append (concatenate (map (lambda (_) traffic-parts) (● w traffic)))
                                     (concatenate (map (lambda (_) person) actors)))))
             (bindings (Cons (rigid-binding (vertex-count taxi))
                             (append
                              (map (lambda (_) (rigid-binding (vertex-count car))) (● w traffic))
                              (map (lambda (_) (● people binding)) actors)))))
        (skin-scene gpu (upload-scene gpu read (Gltf-placed-set all placed) 128) bindings)))
    ;; A queued ray is the largest storage binding needed per pixel. Fit
    ;; the actual canvas aspect to the device limit before allocating targets.
    (define (size-at (width I32) (height I32) (budget I32) (limit F64)) (→ (Pair I32 I32))
      (let* ((w (i32->f64 (max 1 width))) (h (i32->f64 (max 1 height))) (lines (i32->f64 budget))
             (scale (min (min 1.0 (sqrt (/ limit (* w h))))
                         (min (/ (* lines (/ 16.0 9.0)) w) (/ lines h)))))
        (new Pair (first (max 1 (f64->i32 (* scale w))))
             (second (max 1 (f64->i32 (* scale h)))))))

    (define (make-renderer (gpu Gpu) (read (Fn (List String) → (List Bytes))) (models (List Bytes))
                           (g Area) (roads Roads) (w Game)) (→ Renderer)
                           (let* ((info ((● gpu request-device))) (format (● info format))
                                  (limit
                                   (i64->f64 (quotient (i32->i64 (● info storage-binding-size))
                                                       ray-size)))
                                  (taxi (read-gltf (list-ref models 0) "./"))
                                  (car (read-gltf (list-ref models 1) "./"))
                                  (people (read-rigged-gltf (list-ref models 2) "./" read))
                                  (horizon (read-gltf (list-ref models 3) "./"))
                                  (actor (crew people))
                                  (stage (build-stage gpu read g horizon taxi car people w))
                                  (light (make-sky-light gpu (sky-at (clock-minute w)) 256))
                                  (canvas ((● gpu current-texture)))
                                  (size (size-at (● canvas width) (● canvas height) 720 limit))
                                  (palette (world-palette g roads actor w w 1.0 0.0)))
                             (deform-scene! gpu stage palette)
                             (new Renderer
                               (ground g)
                               (roads roads)
                               (read read)
                               (taxi taxi)
                               (sedan-model car)
                               (people people)
                               (actor actor)
                               (horizon horizon)
                               (stage stage)
                               (sector (● g center))
                               (sky light)
                               (minute (clock-minute w))
                               (palette palette)
                               (time -1.0)
                               (pixel-limit limit) (budget 720)
                               (streak-frames 0)
                               (eye (offset (● (carrier w) position)
                                            (forward (● (carrier w) heading))
                                            -7.0))
                               (tracer (make-moving-tracer gpu
                                                           (● stage scene)
                                                           (● light environment)
                                                           format
                                                           (● size first)
                                                           (● size second)
                                                           128)))))
    (define (refresh! (r Renderer) (gpu Gpu) (w Game)) (→ Unit)
      (when (not (= (● r sector) (● r ground center)))
        (let* ((old (● r stage))
               (s (build-stage gpu
                               (● r read)
                               (● r ground)
                               (● r horizon)
                               (● r taxi)
                               (● r sedan-model)
                               (● r people)
                               w)))
          (set! (● r tracer) (retrace gpu (● r tracer) (● s scene) (● r sky environment)))
          (set! (● r stage) s) (set! (● r sector) (● r ground center)) (set! (● r time) -1.0)
          (release-moving-scene gpu old)))
      (unless (= (clock-minute w) (● r minute))
        (update-sky! gpu (● r sky) (sky-at (clock-minute w))) (set! (● r minute) (clock-minute w))))
    ;; Clip the boom around the focus, and lift the eye over the measured
    ;; slope. Mouse orbit and the car use the same interpolated focus.
    (define (camera! (r Renderer) (b Body) (seated Bool) (yaw F64) (pitch F64)
                     (elapsed I32) (aspect F64)) (→ Camera3D)
                     (let* ((p (● b position)) (g (● r ground))
                            (ahead (forward (+ (● b heading) yaw)))
                            (back (offset (xz 0.0 0.0) ahead -1.0))
                            (walls (area-solids g p 12.0)) (length (if seated 8.3 5.6))
                            (d (min (* length (cos pitch))
                                    (max 0.65 (- (trace-distance p back 10.0 walls) 0.45))))
                            (wanted (offset p back d))
                            (old (● r eye))
                            (a (min 1.0 (* 0.018 (i32->f64 elapsed))))
                            (eye (xz (+ (● old x) (* a (- (● wanted x) (● old x))))
                                     (+ (● old z) (* a (- (● wanted z) (● old z))))))
                            (at (offset p ahead 2.0)) (h (area-height g p)))
                       (set! (● r eye)
                             (if (and (< (distance eye p) 12.0) (clear-path? p eye 0.18 walls))
                                 eye
                                 wanted))
                       (camera-3d
                        (new Vec3f (x (f64->f32 (● r eye x)))
                             (y (f64->f32 (max (+ 0.45 (area-height g (● r eye)))
                                               (+ (+ h 1.5) (* length (sin pitch))))))
                             (z (f64->f32 (● r eye z))))
                        (new Vec3f
                          (x (f64->f32 (● at x)))
                          (y (f64->f32 (+ h 1.38)))
                          (z (f64->f32 (● at z))))
                        (Pinhole 1.0) aspect 1.0)))

    ;; Adjust only after a run of slow or fast frames so resizing does not
    ;; repeatedly throw away the filter's history near a threshold.
    (define (render-resolution (r Renderer) (sharp Bool)) (→ String)
      (let ((target (● r tracer targets)))
        (string-append (if sharp "High " "Auto ")
                       (show (● target width))
                       "×"
                       (show (● target height)))))
    ;; Sustained frame pressure changes resolution a tier at a time. A
    ;; single scene rebuild shouldn't make an entire block look soft.
    (define (budget! (r Renderer) (ms I32)) (→ I32)
      (let ((n (cond ((> ms 45) (- (min 0 (● r streak-frames)) 1))
                     ((and (> ms 0) (< ms 24)) (+ (max 0 (● r streak-frames)) 1))
                     (else 0))))
        (cond ((<= n -12)
               (set! (● r budget) (max 480 (- (● r budget) 120)))
               (set! (● r streak-frames) 0))
              ((>= n 75)
               (set! (● r budget) (min 1080 (+ (● r budget) 120)))
               (set! (● r streak-frames) 0))
              (else (set! (● r streak-frames) n)))
        (● r budget)))
    (define (draw! (r Renderer)
                   (gpu Gpu)
                   (before Game)
                   (w Game)
                   (t F64)
                   (yaw F64)
                   (pitch F64)
                   (elapsed I32) (sharp Bool))
      (→ Unit)
      (refresh! r gpu w)
      (let* ((canvas ((● gpu current-texture))) (width (● canvas width)) (height (● canvas height))
             (size (size-at width height (if sharp 1080 (budget! r elapsed)) (● r pixel-limit)))
             (time (+ (i64->f64 (● w tick)) t))
             (changed (not (= (● r time) time)))
             (focus (display-body (carrier before) (carrier w) t))
             (camera (camera! r focus (aboard? (● w driver)) yaw pitch elapsed
                              (/ (i32->f64 width) (i32->f64 (max 1 height))))))
        (when changed
          (set! (● r palette)
                (world-palette (● r ground) (● r roads) (● r actor)
                               before w t (* (* 0.001 (i64->f64 tick-ms)) (max 0.0 (- time 1.0)))))
          (set! (● r time) time))
        (deform-scene! gpu (● r stage) (● r palette))
        (when changed (refit-tracer! gpu (● r tracer)))
        (let ((view (view-of gpu (● canvas texture) 1)))
          (set! (● r tracer)
                (draw-moving-traced gpu
                                    (resize-tracer gpu (● r tracer) (● size first) (● size second))
                                    view
                                    (Camera3D-scene-time-set camera (f64->f32 (* time 0.05)))
                                    (/ 1.0 (i32->f32 (● size second)))
                                    1.3
                                    2
                                    changed))
          ((● gpu destroy) (ViewObject view))
          ((● gpu work-done)))))))
