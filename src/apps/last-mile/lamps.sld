;; The two models face +Z. These rectangles are the painted lens faces
;; in body-node space after its glTF translation, measured in metres.
(define-library (apps last-mile lamps)
  (export lit-car parked-car brake-model brake-mount car-lights)
  (import
   (snail core base)
   (snail shell app)
   (snail shell game scenery)
   (snail shell graphics pod)
   (snail shell graphics gltf)
   (only (snail shell graphics animation) product-column v4)
   (snail shell graphics forward lights))
  (begin
    (record Sockets
      ((front F32)
       (height F32)
       (rear F32)))
    (define (sockets (taxi Bool)) (→ Sockets)
      (if taxi (new Sockets (front 1.25) (height 0.75) (rear -1.35))
          (new Sockets (front 1.15) (height 0.65) (rear -1.25))))
    (define sides (→ (List F32)) (list -0.4125 0.4125))
    (define (lenses (z F32) (y F32) (color I32) (glow F32)) (→ (List Item))
      (map (lambda (x)
             (Item-glow-set (item (Box) (new Vec3 (x x) (y (- y 0.05)) (z z))
                                  (new Vec3 (x 0.275) (y 0.10) (z 0.002)) 0.0 color) glow))
           sides))
    (define (lit-car (model Gltf) (taxi Bool)) (→ Gltf)
      (let ((s (sockets taxi)))
        (with-shapes model (append (lenses (+ (● s front) 0.002) (● s height) (rgb 255 241 203) 1.6)
                                   (lenses (- (● s rear) 0.002) 0.65 (rgb 146 22 16) 0.5)))))
    (define (parked-car (model Gltf) (taxi Bool) (brake Bool)) (→ Gltf)
      (let ((lit (lit-car model taxi)))
        (if brake
            (with-shapes lit (lenses (- (● (sockets taxi) rear) 0.005) 0.65 (rgb 255 25 12) 3.8))
            lit)))
    (define (brake-model (empty Gltf)) (→ Gltf)
      (with-shapes empty (lenses 0.0 0.65 (rgb 255 25 12) 3.8)))
    (define (brake-mount (m Mat4x4f) (taxi Bool) (on Bool)) (→ Mat4x4f)
      (let ((z (+ (● (sockets taxi) rear) (if on -0.005 0.04))))
        (Mat4x4f-w-set m (product-column m (v4 0.0 0.0 z 1.0)))))
    (define (lamp-point (m Mat4x4f) (x F32) (y F32) (z F32)) (→ Vec3f)
      (let ((p (product-column m (v4 x y z 1.0))))
        (new Vec3f (x (● p x)) (y (● p y)) (z (● p z)))))
    (define (car-lights (m Mat4x4f) (taxi Bool) (brake Bool)) (→ (List Punctual))
      (let* ((s (sockets taxi)) (dir (product-column m (v4 0.0 -0.10 1.0 0.0)))
             (aim (new Vec3f (x (● dir x)) (y (● dir y)) (z (● dir z))))
             (white (new Vec3f (x 78.0) (y 70.0) (z 54.0)))
             (red (new Vec3f (x (if brake 4.2 0.24)) (y 0.022) (z 0.012))))
        ;; Place each source just outside its lens, including the bright brake overlay.
        (concatenate (map (lambda (x)
                            (list (spot-light (lamp-point m x (● s height) (+ (● s front) 0.012))
                                              white 52.0 aim 0.84)
                                  (point-light (lamp-point m x 0.65 (- (● s rear) 0.015)) red 7.0)))
                          sides))))))
