;; Dispatch, meter and navigation are projections of the current shift.
(define-library (apps last-mile hud)
  (export loading-screen Hud make-hud show! answer! reset-route! Menu ChooseStand ChooseReply
          MenuAction Pause Resume SaveShift LoadShift Recover Restart SetGraphics SetSensitivity)
  (import
   (snail core base)
   (snail shell dom)
   (snail shell static-resource)
   (prefix (snail shell ui) ui:)
   (snail shell game physics)
   (snail shell game atlas)
   (snail shell game roads)
   (snail shell game boarding)
   (snail shell game dialogue)
   (apps last-mile lines)
   (apps last-mile game)
   (apps last-mile district)
   (apps last-mile gps))
  (begin
    (enum MenuAction (Pause) (Resume) (SaveShift) (LoadShift) (Recover) (Restart)
          (SetGraphics ((settings Graphics))) (SetSensitivity ((level I64))))
    (enum HudAction
      (Menu ((action MenuAction)))
      (ChooseStand ((index I64)))
      (ChooseReply ((from Cursor) (index I64))))
    (record Hud
      ((view (ui:Root HudAction))
       (map-image String)
       (stations (List (ui:Html HudAction)))
       (gps Gps)
       (chart-center I64)
       (chart String)
       (placement String)
       (revision I64)
       (ink String)
       (wide Bool)
       (paused Bool)
       (save-status String)))
    (define (label (tag String) (class String) (text String)) (→ (ui:Html M)) (∀ (M))
      (ui:Element tag (list (ui:Attr "class" class)) (list (ui:Text text))))
    (define (panel (tag String) (class String) (children (List (ui:Html M))))
      (→ (ui:Html M))
      (∀ (M))
      (ui:Element tag (list (ui:Attr "class" class)) children))

    ;; ---- Opening the city ----

    (define (mib (bytes I64)) (→ String)
      (let ((tenths (quotient (* bytes 10) 1048576)))
        (string-append (show (quotient tenths 10)) "." (show (remainder tenths 10)))))

    (define (cached-size (bytes I64)) (→ String)
      (cond ((< bytes 1024) (string-append (show bytes) " B"))
            ((< bytes 104858) (string-append (show (quotient bytes 1024)) " KiB"))
            (else (string-append (mib bytes) " MiB"))))

    (define (download-view (s StaticProgress)) (→ (ui:Html Unit))
      (let* ((net (● s downloaded)) (local (● s cached)) (total (● s total)) (done (+ net local))
             (title (cond ((and (> total 0) (= done total)) "Preparing the streets…")
                          ((> net 0) "Downloading San Francisco")
                          ((> local 0) "Opening cached city files")
                          (else "Checking city files…")))
             (detail (string-append (mib done)
                                    " / "
                                    (mib total)
                                    " MiB · "
                                    (show (quotient (* done 100) (max 1 total)))
                                    "%"
                                    (if (> local 0)
                                        (string-append " · " (cached-size local) " cached")
                                        ""))))
        (panel "section" "city-loading"
               (list (ui:Element "p"
                                 (list (ui:Attr "class" "loading-title") (ui:Attr "role" "status"))
                                 (list (ui:Text title)))
                     (ui:Element "progress"
                                 (list (ui:Attr "class" "city-progress")
                                       (ui:Attr "aria-label" "San Francisco city files")
                                       (ui:Attr "max" (show (max 1 total)))
                                       (ui:Attr "value" (show done)))
                                 (Nil))
                     (label "p" "loading-bytes" detail)))))
    (define (loading-screen (d Dom)) (→ (Fn StaticProgress → Unit))
      (let ((root (ui:render-root d ((● d document-root)))))
        (define (show (s StaticProgress)) (→ Unit) (ui:render! root (list (download-view s))))
        (show (new StaticProgress (downloaded 0) (cached 0) (total 0))) show))

    ;; ---- Pause menu ----

    (define (menu-button (class String)
                         (text String)
                         (action MenuAction)
                         (attributes (List (ui:Attribute HudAction))))
      (→ (ui:Html HudAction))
      (ui:Element "button"
                  (append (list (ui:Attr "class" class)
                                (ui:On "click" (Nil) (Allow) (lambda (_) (Menu action))))
                          attributes)
                  (list (ui:Text text))))
    (define (menu-select (title String)
                         (id String)
                         (choices (List String))
                         (selected String)
                         (change (Fn String → MenuAction)))
      (→ (List (ui:Html HudAction)))
      (list (ui:Element "label"
                        (list (ui:Attr "class" "setting-label") (ui:Attr "for" id))
                        (list (ui:Text title)))
            (ui:Element "select" (list (ui:Attr "class" "setting") (ui:Attr "id" id)
                                       (ui:On "change"
                                              (list (Value))
                                              (Allow)
                                              (lambda (event) (Menu (change (● event value))))))
                        (map (lambda (value)
                               (ui:Element "option"
                                           (list
                                            (ui:FlagProperty "selected" (string=? value selected)))
                                           (list (ui:Text value))))
                             choices))))
    (define (menu-card (s Shift) (status String)) (→ (ui:Html HudAction))
      (let* ((g (● s graphics))
             (dialog (list (ui:Attr "class" "pause-card") (ui:Attr "role" "dialog")
                           (ui:Attr "aria-modal" "true") (ui:Attr "aria-labelledby" "pause-title")))
             (title (ui:Element "h2"
                                (list (ui:Attr "class" "pause-title") (ui:Attr "id" "pause-title"))
                                (list (ui:Text "Shift paused"))))
             (samples (menu-select "Raster samples (MSAA)"
                                   "msaa"
                                   (list "1" "4")
                                   (if (= (● g samples) 4) "4" "1")
                                   (lambda (v)
                                     (SetGraphics
                                      (Graphics-samples-set g (if (string=? v "4") 4 1))))))
             (look (menu-select "Mouse sensitivity"
                                "mouse-sensitivity"
                                (list "Low" "Medium" "High")
                                (sensitivity-name (● s sensitivity))
                                (lambda (v)
                                  (SetSensitivity (cond ((string=? v "Low") 0)
                                                        ((string=? v "High") 2)
                                                        (else 1))))))
             (actions (list (menu-button "resume-game"
                                         "Resume driving"
                                         (Resume)
                                         (list (ui:Attr "id" "cab-resume")))
                            (panel "div" "save-actions"
                                   (list (menu-button "save-game" "Save game" (SaveShift) (Nil))
                                         (menu-button "load-game" "Load game" (LoadShift) (Nil))))
                            (ui:Element "p"
                                        (list (ui:Attr "class" "save-status")
                                              (ui:Attr "role" "status"))
                                        (list (ui:Text status)))
                            (menu-button "recover-cab" "Recover cab" (Recover) (Nil))
                            (menu-button "restart-game" "Restart game" (Restart) (Nil)))))
        (ui:Element "section" dialog (Cons title (concatenate (list samples look actions))))))
    (define (pause-menu (s Shift) (paused Bool) (status String)) (→ (List (ui:Html HudAction)))
      (list (menu-button "pause-toggle" "Pause" (Pause) (list (ui:FlagProperty "hidden" paused)))
            (ui:Element "div"
                        (list (ui:Attr "class" "pause-scrim")
                              (ui:FlagProperty "hidden" (not paused)))
                        (list (menu-card s status)))))

    ;; ---- Instruments ----

    (define (stand-marker (a Atlas) (i I64)) (→ (ui:Html HudAction))
      (let ((s (stand (pickup-index i))))
        (ui:Element "button"
                    (list (ui:Keyed (show i))
                          (ui:Attr "class" "stand-dot")
                          (ui:Attr "style" (map-pin a (● s stop)))
                          (ui:Attr "title" (● s name)) (ui:Attr "aria-label" (● s name))
                          (ui:On "click" (Nil) (Allow) (lambda (_) (ChooseStand i)))) (Nil))))
    (define (make-hud (d Dom) (a Atlas) (map-image String)) (→ Hud)
      (new Hud (view (ui:render-root d ((● d document-root)))) (map-image map-image)
           (stations (map (lambda (i) (stand-marker a i)) (iota 16)))
           (gps (new-gps))
           (chart-center -1)
           (chart "")
           (placement "")
           (revision -1)
           (ink "")
           (wide #f)
           (paused #f)
           (save-status "")))
    (define (two (n I64)) (→ String) (if (< n 10) (string-append "0" (show n)) (show n)))
    (define (money (n I64))
      (→ String)
      (string-append "$" (show (quotient n 100)) "." (two (modulo n 100))))
    (define (clock-text (n I64)) (→ String)
      (let ((h (quotient n 60)))
        (string-append (show (+ 1 (modulo (+ h 11) 12)))
                       ":"
                       (two (modulo n 60))
                       (if (< h 12) " AM" " PM"))))
    (define (brief (w Game)) (→ (List String))
      (let ((who (rider-name (● w dispatch))))
        (match (● w fare)
          ((Waiting) (list "HAIL · PICKUP" (string-append "Pick up " who) (match (● w passenger)
                                                                            ((AtDoor _)
                                                                             "Hold the brake and leave the passenger door clear.")
                                                                            ((Entering _ _)
                                                                             "Passenger boarding. Hold the brake.")
                                                                            (_ (string-append
                                                                                (● (current-pickup
                                                                                    w)
                                                                                   name)
                                                                                "  ·  Stop at the gold marker.")))))
          ((Hired) (list "METER RUNNING" (● (current-drop w) name)
                         (match (● w passenger)
                           ((Leaving _) "Hold the brake while your passenger steps out.")
                           (_ (string-append who
                                             "  ·  Drop off on "
                                             (● (current-drop w) street)
                                             ".")))))
          ((Paid _ cash)
           (list "FARE COMPLETE"
                 (string-append (money cash) " paid")
                 (string-append who " has arrived."))))))
    (define (reply-button (c Cursor) (i I64) (label String)) (→ (ui:Html HudAction))
      (ui:Element "button"
                  (list (ui:Keyed (string-append (● c page) "/" (show (● c line)) "/" (show i)))
                        (ui:On "click" (Nil) (Allow) (lambda (_) (ChooseReply c i))))
                  (list (ui:Text label))))
    (define (reply-buttons (book Dialogue) (c Cursor)) (→ (List (ui:Html HudAction)))
      (let ((options (replies book c)))
        (if (null? options) (list (reply-button c -1 "T  ·  Continue"))
            (map-indexed (lambda (i reply) (reply-button c i
                                                         (if (< i 9)
                                                             (string-append (show (+ 1 i))
                                                                            "  ·  "
                                                                            (● reply text))
                                                             (● reply text))))
                         options))))
    (define (answer! (w Game) (from Cursor) (index I64)) (→ Unit)
      (match (● w talk)
        ((Some now)
         (when (and (string=? (● from page) (● now page)) (= (● from line) (● now line)))
           (speak! w index)))
        (_ (unit))))
    (define (dispatch-card (w Game) (paused Bool)) (→ (ui:Html HudAction))
      (let ((lines (brief w)) (at (● w talk)))
        (panel "section" "dispatch"
               (list (label "div" "stage" (if paused "SHIFT PAUSED" (list-ref lines 0)))
                     (label "h2" "" (list-ref lines 1))
                     (label "p" "message" (list-ref lines 2))
                     (label "p" "speech" (match at ((None) "") ((Some c) (spoken conversation c))))
                     (panel "div"
                            "answers"
                            (match at ((None) (Nil)) ((Some c) (reply-buttons conversation c))))))))
    (define (dashboard (w Game) (resolution String)) (→ (ui:Html HudAction))
      (let* ((v (distance (● (carrier w) velocity) (xz 0.0 0.0)))
             (mode (if (aboard? (● w driver))
                       (string-append (show (f64->i64 (round (* 2.23694 v)))) " MPH")
                       "ON FOOT"))
             (meter (match (● w fare) ((Waiting) 0) ((Hired) (fare-cents w)) ((Paid _ c) c)))
             (total (string-append (show (● w rides))
                                   (if (= (● w rides) 1) " fare" " fares")
                                   "  ·  "
                                   (money (● w bank))
                                   " this shift")))
        (panel "aside" "dash" (list (label "span" "eyebrow" "TAXIMETER") (label "div" "mode" mode)
                                    (label "strong" "meter" (money meter))
                                    (label "div" "total" total)
                                    (label "div" "quality" resolution)))))
    (define (mast (g Area) (w Game)) (→ (ui:Html HudAction))
      (panel "header"
             "mast"
             (list (label "span" "eyebrow" "SAN FRANCISCO") (label "h1" "" "Last Mile Taxi")
                   (label "time" "time" (clock-text (clock-minute w)))
                   (label "div" "near" (nearest-sign g (● (carrier w) position))))))

    ;; ---- Navigation ----

    ;; The loaded cab can be on another road at the same tick with the same fare.
    (define (reset-route! (h Hud)) (→ Unit)
      (set! (● h gps) (new-gps))
      (set! (● h revision) -1))
    (define (update-chart! (h Hud) (g Area) (roads Roads) (w Game) (wide Bool)) (→ Unit)
      (let ((gps (● h gps)) (moved (not (= (● h chart-center) (● g center)))))
        (navigate! gps roads (● (carrier w) position) (objective w) (● w tick))
        (when moved
          (set! (● h chart) (chart-source g))
          (set! (● h placement) (chart-placement g))
          (set! (● h chart-center) (● g center)))
        (when (or moved
                  (not (= (● h revision) (● gps revision)))
                  (if wide (not (● h wide)) (● h wide)))
          (set! (● h ink) (route-ink g roads gps wide))
          (set! (● h revision) (● gps revision))
          (set! (● h wide) wide))))
    (define (styled (tag String)
                    (class String)
                    (style String)
                    (children (List (ui:Html HudAction))))
      (→ (ui:Html HudAction))
      (ui:Element tag (list (ui:Attr "class" class) (ui:Attr "style" style)) children))
    (define (map-layers (h Hud) (a Atlas) (w Game) (wide Bool) (choice I64)) (→ (ui:Html HudAction))
      (let* ((p (● (carrier w) position)) (target (objective w))
             (goal
              (match (● target kind) ((OffDuty) "display:none") (_ (map-pin a (● target point)))))
             (selected (if (and wide (match (● w fare) ((Waiting) #t) (_ #f)))
                           (map-pin a (● (stand (pickup-index choice)) stop))
                           "display:none")))
        (styled "div" "map-sheet" (map-window a p wide)
                (list (ui:Element "img"
                                  (list (ui:Attr "class" "geography")
                                        (ui:Attr "src" (● h map-image))
                                        (ui:Attr "alt" "San Francisco street map"))
                                  (Nil))
                      (ui:Element "img"
                                  (list (ui:Attr "class" "local-chart")
                                        (ui:Attr "src" (● h chart))
                                        (ui:Attr "style" (● h placement)))
                                  (Nil))
                      (panel "div" "stations" (● h stations))
                      (styled "i" "selected-stand" selected (Nil))
                      (styled "div" "route" (● h ink) (Nil))
                      (styled "i"
                              "you"
                              (string-append (map-pin a p)
                                             ";--heading:"
                                             (show (● (carrier w) heading))
                                             "rad")
                              (Nil))
                      (styled "i" "goal" goal (Nil))))))
    (define (picker-hint (w Game) (wide Bool) (choice I64)) (→ String)
      (if wide (match (● w fare)
                 ((Waiting)
                  (string-append "[ / ] or click  "
                                 (● (stand (pickup-index choice)) name)
                                 "   ·   Enter to start here"))
                 (_ "Finish this fare to change cab stands.")) ""))
    (define (radar (h Hud) (g Area) (roads Roads) (w Game) (wide Bool) (choice I64))
      (→ (ui:Html HudAction))
      (let* ((a (● g atlas)) (p (● (carrier w) position)) (gps (● h gps))
             (aspect
              (if wide (string-append "aspect-ratio:" (show (● a cols)) "/" (show (● a rows))) "")))
        (panel "aside" (if wide "radar wide" "radar")
               (list (styled "div" "map" aspect (list (map-layers h a w wide choice)))
                     (label "span"
                            "range"
                            (string-append (show (f64->i64 (round (gps-distance gps roads p))))
                                           " m"))
                     (label "div" "turn" (guidance gps roads p))
                     (label "div" "picker" (picker-hint w wide choice))))))
    (define (show! (d Dom)
                   (h Hud)
                   (g Area)
                   (roads Roads)
                   (s Shift)
                   (paused Bool)
                   (wide Bool)
                   (choice I64)
                   (resolution String))
      (→ Unit)
      (let ((w (● s game)))
        (update-chart! h g roads w wide)
        (ui:render! (● h view)
                    (Cons (ui:Element "div"
                                      (list (ui:Attr "class" "instruments")
                                            (ui:Attr "id" "cab-instruments")
                                            (ui:Attr "tabindex" "-1")
                                            (ui:FlagProperty "inert" paused))
                                      (list (mast g w)
                                            (dispatch-card w paused)
                                            (dashboard w resolution)
                                            (radar h g roads w wide choice)))
                          (pause-menu s paused (● h save-status))))
        (when (if paused (not (● h paused)) (● h paused))
          (unless paused (set! (● h save-status) ""))
          (set! (● h paused) paused)
          (match ((● d element-by-id) (if paused "cab-resume" "cab-instruments"))
            ((Some node) ((● d focus-node) node)) (_ (unit))))))))
