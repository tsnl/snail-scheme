;; Dispatch, meter and navigation are projections of the current shift.
(define-library (apps last-mile hud)
  (export loading-screen Hud make-hud show! click-reply! clicked-stand show-menu! menu-action
          MenuAction Pause Resume Recover Restart SetGraphics SetSensitivity)
  (import
   (snail core base)
   (only (snail core table) table-ref)
   (snail shell dom)
   (snail shell static-resource)
   (prefix (snail shell ui) ui:)
   (snail shell game physics)
   (snail shell game atlas)
   (snail shell game roads)
   (snail shell game boarding)
   (snail shell game dialogue)
   (apps last-mile lines)
   (apps last-mile game)
   (apps last-mile district)
   (apps last-mile gps))
  (begin
    (record Hud
      ((menu PauseMenu)
       (stage Node)
       (title Node)
       (message Node)
       (book Dialogue)
       (shown (List (ui:Shown (Pair Cursor I64))))
       (speech Node)
       (answers Node)
       (mode Node)
       (range Node)
       (meter Node)
       (total Node)
       (time Node)
       (near Node)
       (quality Node)
       (radar Node)
       (map-node Node)
       (sheet Node)
       (markers (List (ui:Shown I64)))
       (choice-node Node)
       (chart Node)
       (chart-center I64)
       (ink Node)
       (you Node)
       (goal Node)
       (turn Node)
       (picker Node)
       (gps Gps)
       (revision I64)
       (wide Bool)))
    (define (element (d Dom) (parent Node) (tag String) (class String) (text String)) (→ Node)
      (let ((n ((● d create-element) tag)))
        ((● d set-attribute) n "class" class)
        (unless (string=? text "") ((● d set-text) n text))
        ((● d insert-node) parent n (None)) n))


    ;; ---- Opening the city ----

    (define (mib (bytes I64)) (→ String)
      (let ((tenths (quotient (* bytes 10) 1048576)))
        (string-append (show (quotient tenths 10)) "." (show (remainder tenths 10)))))

    (define (cached-size (bytes I64)) (→ String)
      (cond ((< bytes 1024) (string-append (show bytes) " B"))
            ((< bytes 104858) (string-append (show (quotient bytes 1024)) " KiB"))
            (else (string-append (mib bytes) " MiB"))))

    (define (loading-screen (d Dom)) (→ (Fn StaticProgress → Unit))
      (let* ((panel (element d ((● d document-root)) "section" "city-loading" ""))
             (title (element d panel "p" "loading-title" "Opening San Francisco…"))
             (bar (element d panel "progress" "city-progress" ""))
             (detail (element d panel "p" "loading-bytes" "")))
        ((● d set-attribute) title "role" "status")
        ((● d set-attribute) bar "aria-label" "San Francisco city files")
        (lambda (state)
          (let* ((net (● state downloaded)) (local (● state cached)) (total (● state total))
                 (done (+ net local)))
            ((● d set-attribute) bar "max" (show (max 1 total)))
            ((● d set-attribute) bar "value" (show done))
            ((● d set-text) title (cond ((= done total) "Preparing the streets…")
                                        ((> net 0) "Downloading San Francisco")
                                        ((> local 0) "Opening cached city files")
                                        (else "Checking city files…")))
            ((● d set-text) detail
             (string-append (mib done) " / " (mib total) " MiB · "
                            (show (quotient (* done 100) (max 1 total))) "%"
                            (if (> local 0)
                                (string-append " · " (cached-size local) " cached")
                                "")))))))

    ;; ---- Pause menu ----

    (enum MenuAction
      (Pause)
      (Resume)
      (Recover)
      (Restart)
      (SetGraphics ((settings Graphics)))
      (SetSensitivity ((level I64))))
    (record PauseMenu
      ((screen Node)
       (panel Node)
       (toggle Node)
       (resume Node)
       (quality Node)
       (resolution Node)
       (bounces Node)
       (samples Node)
       (look Node)
       (actions (List (Pair Listener MenuAction)))
       (quality-change Listener)
       (resolution-change Listener)
       (bounces-change Listener)
       (look-change Listener)
       (open Bool)))
    (define (menu-select (d Dom) (parent Node) (title String) (id String) (choices (List String)))
      (→ Node)
      (let* ((label (element d parent "label" "setting-label" title))
             (select (element d parent "select" "setting" "")))
        ((● d set-attribute) label "for" id) ((● d set-attribute) select "id" id)
        (for-each (lambda (s) (element d select "option" "" s) (unit)) choices) select))
    (define (resolution-name (lines I32)) (→ String) (string-append (show lines) "p"))
    (define (quality-presets) (→ (List (Pair String Graphics)))
      (let ((named (lambda ((name String) (settings Graphics)) (→ (Pair String Graphics))
                     (new Pair (first name) (second settings)))))
        (list (named "Minimum" (preset-graphics 240))
              (named "Low" (preset-graphics 360))
              (named "480p · 2 paths" (preset-graphics 480))
              (named "Balanced" (preset-graphics 720))
              (named "High" (preset-graphics 1080))
              (named "Ultra" (Graphics-bounces-set (preset-graphics 1080) 4)))))
    (define (active-preset (g Graphics)) (→ String)
      (match (find (lambda (p) (let ((v (● p second)))
                                 (and (= (● v resolution) (● g resolution))
                                      (= (● v bounces) (● g bounces))
                                      (= (● v samples) (● g samples)))))
                   (quality-presets))
        ((Some p) (● p first)) (_ "Custom")))
    (define (make-menu (d Dom) (root Node) (screen Node)) (→ PauseMenu)
      (let* ((toggle (element d root "button" "pause-toggle" "Pause"))
             (panel (element d root "div" "pause-scrim" ""))
             (card (element d panel "section" "pause-card" ""))
             (title (element d card "h2" "pause-title" "Shift paused"))
             (quality (menu-select d card "Quality preset" "graphics-preset"
                                   (map (lambda (p) (● p first)) (quality-presets))))
             (custom (element d quality "option" "" "Custom"))
             (samples (element d card "small" "sampling-note" ""))
             (resolution (menu-select d card "Render resolution" "render-resolution"
                                      (map resolution-name (render-resolutions))))
             (bounces (menu-select d card "Ray bounces" "ray-bounces" (map show (bounce-counts))))
             (look (menu-select d
                                card
                                "Mouse sensitivity"
                                "mouse-sensitivity"
                                (list "Low" "Medium" "High")))
             (resume (element d card "button" "resume-game" "Resume driving"))
             (recover (element d card "button" "recover-cab" "Recover cab"))
             (restart (element d card "button" "restart-game" "Restart game"))
             (listen (● d listen)))
        ((● d set-flag-property) custom "disabled" #t)
        ((● d set-attribute) samples "id" "sampling-note")
        ((● d set-attribute) quality "aria-describedby" "sampling-note")
        ((● d set-attribute) screen "tabindex" "-1")
        ((● d set-attribute) title "id" "pause-title") ((● d set-attribute) card "role" "dialog")
        ((● d set-attribute) card "aria-modal" "true")
        ((● d set-attribute) card "aria-labelledby" "pause-title")
        ((● d set-flag-property) panel "hidden" #t)
        (new PauseMenu
          (screen screen)
          (panel panel)
          (toggle toggle)
          (resume resume)
          (quality quality)
          (resolution resolution)
          (bounces bounces)
          (samples samples)
          (look look)
          (actions (map (lambda (p)
                          (new Pair
                            (first (listen (● p first) "click" (Nil) (Allow)))
                            (second (● p second))))
                        (zip (list toggle resume recover restart)
                             (list (Pause) (Resume) (Recover) (Restart)))))
          (quality-change (listen quality "change" (list (Value)) (Allow)))
          (resolution-change (listen resolution "change" (list (Value)) (Allow)))
          (bounces-change (listen bounces "change" (list (Value)) (Allow)))
          (look-change (listen look "change" (list (Value)) (Allow)))
          (open #f))))
    (define (menu-action (h Hud) (id I32) (value String) (settings Graphics))
      (→ (Option MenuAction))
      (let ((m (● h menu)))
        (cond ((= id (● m quality-change id))
               (match (assoc-ref (quality-presets) value)
                 ((Some preset) (Some (SetGraphics preset))) (_ (None))))
              ((= id (● m resolution-change id))
               (match (find (lambda (n) (string=? value (resolution-name n))) (render-resolutions))
                 ((Some n) (Some (SetGraphics (Graphics-resolution-set settings n)))) (_ (None))))
              ((= id (● m bounces-change id))
               (match (find (lambda (n) (string=? value (show n))) (bounce-counts))
                 ((Some n) (Some (SetGraphics (Graphics-bounces-set settings n)))) (_ (None))))
              ((= id (● m look-change id))
               (Some (SetSensitivity (cond ((string=? value "Low") 0) ((string=? value "High") 2)
                                           (else 1)))))
              (else (match (find (lambda (p) (= (● p first id) id)) (● m actions))
                      ((Some p) (Some (● p second))) (_ (None)))))))
    (define (show-menu! (d Dom) (h Hud) (s Shift) (paused Bool)) (→ Unit)
      (let ((m (● h menu)) (flag (● d set-flag-property)))
        (unless (if paused (● m open) (not (● m open)))
          (flag (● m screen) "inert" paused)
          (flag (● m toggle) "hidden" paused)
          (flag (● m panel) "hidden" (not paused))
          ((● d focus-node) (if paused (● m resume) (● m screen))) (set! (● m open) paused))
        (when paused
          (let ((set (● d set-string-property)) (g (● s graphics)))
            (set (● m quality) "value" (active-preset g))
            (set (● m resolution) "value" (resolution-name (● g resolution)))
            (set (● m bounces) "value" (show (● g bounces)))
            ((● d set-text) (● m samples)
             (if (= (● g samples) 1) "1 light path per pixel" "2 light paths per pixel"))
            (set (● m look) "value" (sensitivity-name (● s sensitivity)))))))
    (define (stand-marker (a Atlas) (i I64)) (→ (ui:Html I64))
      (let ((s (stand (pickup-index i))))
        (ui:Element "button"
                    (list (ui:Attr "class" "stand-dot") (ui:Attr "style" (map-pin a (● s stop)))
                          (ui:Attr "title" (● s name)) (ui:Attr "aria-label" (● s name))
                          (ui:On "click" (Nil) (Allow) (lambda (_) i))) (Nil))))
    (define (clicked-stand (h Hud) (listener I32)) (→ (Option I64))
      (match (table-ref (ui:listener-table (● h markers)) (show listener))
        ((Some message) (Some (message no-event))) (_ (None))))
    (define (make-hud (d Dom) (a Atlas) (map-image String)) (→ Hud)
      (let* ((overlay ((● d document-root))) (root (element d overlay "div" "instruments" ""))
             (mast (element d root "header" "mast" ""))
             (card (element d root "section" "dispatch" ""))
             (dash (element d root "aside" "dash" ""))
             (radar (element d root "aside" "radar" "")) (map-node (element d radar "div" "map" ""))
             (sheet (element d map-node "div" "map-sheet" ""))
             (image (element d sheet "img" "geography" "")))
        ((● d set-attribute) image "src" map-image)
        ((● d set-attribute) image "alt" "San Francisco street map")
        (element d mast "span" "eyebrow" "SAN FRANCISCO") (element d mast "h1" "" "Last Mile Taxi")
        (element d dash "span" "eyebrow" "TAXIMETER")
        (new Hud
          (menu (make-menu d overlay root))
          (stage (element d card "div" "stage" ""))
          (title (element d card "h2" "" ""))
          (message (element d card "p" "message" ""))
          (speech (element d card "p" "speech" ""))
          (answers (element d card "div" "answers" ""))
          (book conversation)
          (shown (Nil))
          (mode (element d dash "div" "mode" ""))
          (meter (element d dash "strong" "meter" ""))
          (total (element d dash "div" "total" ""))
          (time (element d mast "time" "time" ""))
          (near (element d mast "div" "near" "")) (quality (element d dash "div" "quality" ""))
          (radar radar) (map-node map-node) (sheet sheet)
          (chart (element d sheet "img" "local-chart" "")) (chart-center -1)
          (markers (ui:patch-children d
                                      (element d sheet "div" "stations" "")
                                      (Nil)
                                      (map (lambda (i) (stand-marker a i)) (iota 16))))
          (choice-node (element d sheet "i" "selected-stand" ""))
          (ink (element d sheet "div" "route" ""))
          (you (element d sheet "i" "you" ""))
          (goal (element d sheet "i" "goal" "")) (range (element d radar "span" "range" ""))
          (turn (element d radar "div" "turn" "")) (picker (element d radar "div" "picker" ""))
          (gps (new-gps)) (revision -1) (wide #f))))
    (define (two (n I64)) (→ String) (if (< n 10) (string-append "0" (show n)) (show n)))
    (define (money (n I64))
      (→ String)
      (string-append "$" (show (quotient n 100)) "." (two (modulo n 100))))
    (define (clock-text (n I64)) (→ String)
      (let ((h (quotient n 60)))
        (string-append (show (+ 1 (modulo (+ h 11) 12)))
                       ":"
                       (two (modulo n 60))
                       (if (< h 12) " AM" " PM"))))
    (define (brief (w Game)) (→ (List String))
      (let ((who (rider-name (● w dispatch))))
        (match (● w fare)
          ((Waiting) (list "HAIL · PICKUP" (string-append "Pick up " who) (match (● w passenger)
                                                                            ((AtDoor _)
                                                                             "Hold the brake and leave the passenger door clear.")
                                                                            ((Entering _ _)
                                                                             "Passenger boarding. Hold the brake.")
                                                                            (_ (string-append
                                                                                (● (current-pickup
                                                                                    w)
                                                                                   name)
                                                                                "  ·  Stop at the gold marker.")))))
          ((Hired) (list "METER RUNNING" (● (current-drop w) name)
                         (match (● w passenger)
                           ((Leaving _) "Hold the brake while your passenger steps out.")
                           (_ (string-append who
                                             "  ·  Drop off on "
                                             (● (current-drop w) street)
                                             ".")))))
          ((Paid _ cash)
           (list "FARE COMPLETE"
                 (string-append (money cash) " paid")
                 (string-append who " has arrived."))))))
    (define (reply-button (c Cursor) (i I64) (label String)) (→ (ui:Html (Pair Cursor I64)))
      (ui:Element "button"
                  (list (ui:Keyed (string-append (● c page) "/" (show (● c line)) "/" (show i)))
                        (ui:On "click" (Nil) (Allow) (lambda (_) (new Pair (first c) (second i)))))
                  (list (ui:Text label))))
    (define (reply-buttons (book Dialogue) (c Cursor)) (→ (List (ui:Html (Pair Cursor I64))))
      (let ((options (replies book c)))
        (if (null? options) (list (reply-button c -1 "T  ·  Continue"))
            (map-indexed (lambda (i reply) (reply-button c i
                                                         (if (< i 9)
                                                             (string-append (show (+ 1 i))
                                                                            "  ·  "
                                                                            (● reply text))
                                                             (● reply text))))
                         options))))
    (define (show-dialogue! (d Dom) (h Hud) (at (Option Cursor))) (→ Unit)
      (let ((book (● h book)))
        ((● d set-text) (● h speech) (match at ((None) "") ((Some c) (spoken book c))))
        (set! (● h shown) (ui:patch-children d (● h answers) (● h shown)
                                             (match at
                                               ((None) (Nil))
                                               ((Some c) (reply-buttons book c)))))))
    (define (click-reply! (h Hud) (w Game) (listener I32)) (→ Unit)
      (match (table-ref (ui:listener-table (● h shown)) (show listener))
        ((Some message)
         (match (new Pair (first (message no-event)) (second (● w talk)))
           ((Pair (Pair from i) (Some now))
            (when (and (string=? (● from page) (● now page)) (= (● from line) (● now line)))
              (speak! w i)))
           (_ (unit)))) (_ (unit))))

    (define (show-map! (d Dom) (h Hud) (g Area) (roads Roads) (w Game) (wide Bool) (choice I64))
      (→ Unit)
      (let* ((a (● g atlas))
             (p (● (carrier w) position))
             (gps (● h gps))
             (target (objective w))
             (attr (● d set-attribute))
             (tell (● d set-text)))
        (navigate! gps roads p target (● w tick))
        (when (or (not (= (● h chart-center) (● g center)))
                  (not (= (● h revision) (● gps revision)))
                  (if wide (not (● h wide)) (● h wide)))
          (attr (● h map-node)
                "style"
                (if wide
                    (string-append "aspect-ratio:" (show (● a cols)) "/" (show (● a rows)))
                    ""))
          (attr (● h ink) "style" (route-ink g roads gps wide))
          (attr (● h radar) "class" (if wide "radar wide" "radar"))
          (unless (= (● h chart-center) (● g center))
            (attr (● h chart) "src" (chart-source g)) (attr (● h chart) "style" (chart-placement g))
            (set! (● h chart-center) (● g center)))
          (set! (● h revision) (● gps revision)) (set! (● h wide) wide))
        (attr (● h sheet) "style" (map-window a p wide))
        (attr (● h you)
              "style"
              (string-append (map-pin a p) ";--heading:" (show (● (carrier w) heading)) "rad"))
        (attr (● h goal)
              "style"
              (if (match (● target kind) ((OffDuty) #t) (_ #f))
                  "display:none"
                  (map-pin a (● target point))))
        (attr (● h choice-node) "style" (if (and wide (match (● w fare) ((Waiting) #t) (_ #f)))
                                            (map-pin a (● (stand (pickup-index choice)) stop))
                                            "display:none"))
        (tell (● h range) (string-append (show (f64->i64 (round (gps-distance gps roads p)))) " m"))
        (tell (● h turn) (guidance gps roads p))
        (tell (● h picker)
              (if wide
                  (match (● w fare)
                    ((Waiting)
                     (string-append "[ / ] or click  "
                                    (● (stand (pickup-index choice)) name)
                                    "   ·   Enter to start here"))
                    (_ "Finish this fare to change cab stands.")) ""))))
    (define (show! (d Dom)
                   (h Hud)
                   (g Area)
                   (roads Roads)
                   (w Game)
                   (paused Bool)
                   (wide Bool)
                   (choice I64) (resolution String))
      (→ Unit)
      (let* ((b (carrier w))
             (lines (brief w))
             (tell (● d set-text))
             (speed (distance (● b velocity) (xz 0.0 0.0))))
        (show-map! d h g roads w wide choice) (show-dialogue! d h (● w talk))
        (tell (● h stage) (if paused "SHIFT PAUSED" (list-ref lines 0)))
        (tell (● h title) (list-ref lines 1))
        (tell (● h message) (list-ref lines 2))
        (tell (● h mode)
              (if (aboard? (● w driver))
                  (string-append (show (f64->i64 (round (* 2.23694 speed)))) " MPH")
                  "ON FOOT"))
        (tell (● h meter)
              (money (match (● w fare) ((Waiting) 0) ((Hired) (fare-cents w)) ((Paid _ c) c))))
        (tell (● h total)
              (string-append (show (● w rides))
                             (if (= (● w rides) 1) " fare" " fares")
                             "  ·  "
                             (money (● w bank))
                             " this shift"))
        (tell (● h quality) resolution)
        (tell (● h time) (clock-text (clock-minute w)))
        (tell (● h near) (nearest-sign g (● b position)))))))
