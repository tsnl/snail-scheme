;; The cab, its riders and the meter share one fixed-step shift. Settling a
;; fare and recording its receipt is a single transition in the saved game.
(define-library (apps last-mile game)
  (export Fare
          Waiting
          Hired
          Paid
          Game Shift ensure-cars! recover-cab! restart-shift sensitivity-name
          Order
          snapshot
          new-world
          step!
          tick-ms
          carrier
          driver-body
          passenger-body
          turn-driver!
          objective
          sedan
          save-game
          restore-game
          speak!
          clock-minute
          shift-time!
          fare-cents
          populate!
          start-stand!
          current-pickup
          current-drop)
  (import
   (snail core base)
   (only (snail core forms) case-id)
   (snail shell wire)
   (snail shell math)
   (snail shell game physics)
   (snail shell game atlas)
   (snail shell game roads)
   (snail shell game traffic)
   (snail shell game vehicle)
   (snail shell game rigid-body)
   (snail shell game chassis)
   (snail shell game humanoid)
   (snail shell game pedestrian)
   (snail shell game boarding)
   (snail shell game dialogue)
   (apps last-mile lines)
   (apps last-mile district))
  (begin
    (enum Fare (Waiting) (Hired) (Paid ((until I64) (cents I64))) (deriving Serialize Deserialize))
    (record Game
      ((tick I64)
       (clock-offset I64)
       (dispatch I64)
       (rides I64)
       (bank I64)
       (metres F64)
       (fare Fare)
       (driver Rider)
       (gait Gait)
       (passenger Rider)
       (passenger-gait Gait)
       (talk (Option Cursor))
       (cab Body)
       (residents (List Pedestrian))
       (traffic (List Motor)))
      (deriving Serialize Deserialize))
    ;; Game is also the wire schema of the original 2D shift. Its cab is the
    ;; street-map projection used by riders, the meter and the GPS.
    (record Shift
      ((game Game)
       (cars (List RigidBody))
       (resolution I32)
       (sensitivity I64))
      (deriving Serialize Deserialize))
    (define (shift-from (w Game)) (→ Shift)
      (new Shift (game w) (cars (Nil)) (resolution 720) (sensitivity 1)))
    (define (sensitivity-name (choice I64)) (→ String)
      (case choice ((0) "Low") ((2) "High") (else "Medium")))
    (record Order
      ((buttons I64)
       (interact Bool)
       (driving DriverControls)))
    (define tick-ms (→ I64) 50)
    (define dt (→ F64) 0.05)
    (define sedan
      (→ CarDimensions)
      (new CarDimensions (wheelbase 2.376) (width 1.875) (length 4.6)))
    (define (current-pickup (w Game)) (→ Stand) (stand (pickup-index (● w dispatch))))
    (define (current-drop (w Game)) (→ Stand) (stand (drop-index (● w dispatch))))
    (define (waiting-rider (s Stand)) (→ Rider) (Ground (body (● s curb) (- (● s heading) 1.5))))
    (define (at-rank (s Stand))
      (→ Body)
      (body (offset (● s stop) (forward (● s heading)) -10.0) (● s heading)))
    (define (initial-game) (→ Game)
      (let ((s (stand 0)))
        (new Game (tick 0) (clock-offset 1040) (dispatch 0) (rides 0) (bank 0) (metres 0.0)
             (fare (Waiting))
             (driver (Aboard))
             (gait (Gait-seat-set resting 1.0))
             (passenger (waiting-rider s))
             (passenger-gait resting)
             (talk (None)) (cab (at-rank s)) (residents (Nil)) (traffic (Nil)))))
    (define (new-world) (→ Shift) (shift-from (initial-game)))
    (define (restart-shift (old Shift)) (→ Shift)
      (new Shift
        (game (initial-game))
        (cars (Nil))
        (resolution (● old resolution))
        (sensitivity (● old sensitivity))))
    (define (save-game (s Shift)) (→ Bytes) (serialize s))
    (define (restore-game (data Bytes)) (→ Shift)
      (let ((kind (decode (new Decoder (bytes data) (position 0)))))
        (if (= kind (case-id Game)) (shift-from (deserialize data)) (deserialize data))))
    (define (clock-minute (w Game))
      (→ I64)
      (modulo (+ (● w clock-offset) (quotient (● w tick) 20)) 1440))
    (define (shift-time! (w Game))
      (→ Unit)
      (set! (● w clock-offset) (modulo (+ (● w clock-offset) 360) 1440)))
    (define (fare-cents (w Game)) (→ I64) (+ 400 (* 50 (quotient (f64->i64 (● w metres)) 160))))
    (define (snapshot-game (w Game)) (→ Game)
      (Game-residents-set w (map (lambda (p) (new Pedestrian (body (● p body)) (gait (● p gait))
                                                  (intent (● p intent))
                                                  (next (● p next))
                                                  (after (● p after))))
                                 (● w residents))))
    (define (snapshot (s Shift)) (→ Shift)
      (Shift-cars-set (Shift-game-set s (snapshot-game (● s game))) (map copy-rigid (● s cars))))
    (define (driver-body (w Game)) (→ Body) (rider-body (● w driver) (● w cab) sedan (DriverDoor)))
    (define (passenger-body (w Game))
      (→ Body)
      (rider-body (● w passenger) (● w cab) sedan (PassengerDoor)))
    (define (carrier (w Game)) (→ Body) (if (aboard? (● w driver)) (● w cab) (driver-body w)))
    (define (objective (w Game)) (→ XZ)
      (if (not (aboard? (● w driver))) (● w cab position)
          (match (● w fare) ((Waiting) (● (current-pickup w) stop)) (_ (● (current-drop w) stop)))))
    (define (on-foot-walls (g Area) (w Game) (p XZ) (reach F64)) (→ (List Footprint))
      (Cons (parked-footprint (● w cab) sedan) (area-solids g p reach)))
    (define (populate! (g Area) (r Roads) (s Shift)) (→ Unit)
      (let* ((w (● s game)) (p (● (carrier w) position)))
        (set! (● w traffic) (map (lambda (i) (seed-motor r p i)) (iota 5)))
        (set! (● w residents) (map (lambda (i) (sidewalk-walker g r p (+ i 5))) (iota 6)))
        (set! (● s cars) (take (● s cars) (min 1 (length (● s cars))))) (ensure-cars! g r s)))
    (define (offer! (w Game) (dispatch I64)) (→ Unit)
      (set! (● w dispatch) dispatch) (set! (● w metres) 0.0) (set! (● w fare) (Waiting))
      (set! (● w passenger) (waiting-rider (current-pickup w))) (set! (● w passenger-gait) resting)
      (set! (● w talk) (None)))
    (define (start-stand! (w Game) (dispatch I64)) (→ Bool)
      (match (● w fare) ((Waiting) (if (stopped? (● w cab)) (begin (offer! w dispatch)
                                                                   (set! (● w cab)
                                                                         (at-rank
                                                                          (current-pickup w)))
                                                                   (set! (● w driver) (Aboard))
                                                                   (set! (● w traffic) (Nil))
                                                                   (set! (● w residents) (Nil))
                                                                   #t)
                                       #f))
             (_ #f)))
    (define (speak! (w Game) (reply I64)) (→ Unit)
      (match (● w talk)
        ((Some at)
         (set! (● w talk)
               (if (< reply 0)
                   (continue-dialogue conversation at)
                   (answer-dialogue conversation at reply))))
        (_ (unit))))

    ;; ---- Streets and controls ----

    (define (button? (bits I64) (bit I64)) (→ Bool) (not (= (i64-and bits bit) 0)))
    (define (axis (bits I64) (positive I64) (negative I64)) (→ F64)
      (- (if (button? bits positive) 1.0 0.0) (if (button? bits negative) 1.0 0.0)))

    (define (steering (bits I64)) (→ F64)
      (max -1.0 (min 1.0 (+ (axis bits 8 4) (axis bits 256 128)))))

    (define (car-walls (g Area) (w Game)) (→ (List Footprint))
      (let* ((at (● w cab position)) (feet (map (lambda (p) (● p body position)) (● w residents)))
             (people
              (if (aboard? (● w passenger)) feet (Cons (● (passenger-body w) position) feet))))
        (fold-left (lambda (out p) (if (and (< (distance at p) 8.0) (> (distance at p) 1.4))
                                       (Cons (footprint (● p x) (● p z) 0.46 0.46) out) out))
                   (area-solids g at 6.0) people)))
    (define (use-door (r Rider) (car Body) (solids (List Footprint))) (→ Rider)
      (match r ((Ground _) (approach-door r car 4.2)) ((AtDoor b) (Ground b))
             (_ (leave-seat r car sedan (DriverDoor) solids))))
    (define (turn-driver! (w Game) (angle F64)) (→ Unit)
      (match (● w driver)
        ((Ground b) (set! (● w driver) (Ground (Body-heading-set b (+ (● b heading) angle)))))
        (_ (unit))))

    ;; With mouse look, A/D sidestep along the view's right axis. Arrow
    ;; keys still turn. A keyboard alone keeps the original turning controls.
    (define (walk-driver (g Area) (w Game) (b Body) (bits I64)) (→ Body)
      (let* ((side (axis bits 8 4)) (up (axis bits 1 2)) (mouse (button? bits 64))
             (yaw (+ (● b heading) (* 0.13 (if mouse (axis bits 256 128) (steering bits)))))
             (strafe (if mouse side 0.0))
             (scale (/ 5.5 (max 1.0 (sqrt (+ (* up up) (* strafe strafe))))))
             (v (offset (offset (xz 0.0 0.0) (forward yaw) (* scale up))
                        (xz (cos yaw) (sin yaw)) (* scale strafe))))
        (travel (● b position) v yaw 0.36 (on-foot-walls g w (● b position) 3.0) dt)))

    (define (move-driver! (g Area) (w Game) (order Order)) (→ Unit)
      (let* ((bits (● order buttons)) (use (● order interact)) (car (● w cab)) (r (● w driver))
             (solids (area-solids g (● car position) 8.0))
             (requested (if use (use-door r car solids) r)))
        (match requested
          ((Ground b) (set! (● w driver) (Ground (walk-driver g w b bits))))
          ((Aboard) (unit))
          (_ (set! (● w driver)
                   (advance-rider requested (● w cab) sedan (DriverDoor) solids dt))))))
    (define (parked-at? (w Game) (at XZ) (radius F64)) (→ Bool)
      (and (stopped? (● w cab)) (< (distance (● w cab position) at) radius)))
    (define (passenger! (g Area) (w Game)) (→ Unit)
      (let* ((car (● w cab)) (r (● w passenger)) (walls (area-solids g (● car position) 9.0))
             (request (match (● w fare)
                        ((Waiting)
                         (if (and (aboard? (● w driver))
                                  (parked-at? w (● (current-pickup w) stop) 5.5))
                             (approach-door r car 8.0) r))
                        ((Hired)
                         (if
                          (and (aboard? (● w driver)) (parked-at? w (● (current-drop w) stop) 5.5))
                          (leave-seat r car sedan (PassengerDoor) walls) r)) (_ r))))
        (set! (● w passenger) (advance-rider request car sedan (PassengerDoor) walls dt))))
    (define (settle! (w Game)) (→ Unit)
      (let ((cash (fare-cents w)))
        (set! (● w bank) (+ (● w bank) cash)) (set! (● w rides) (+ 1 (● w rides)))
        (set! (● w fare) (Paid (+ (● w tick) 80) cash)) (set! (● w talk) (None))))
    (define (meter! (w Game) (moved F64)) (→ Unit)
      (match (● w fare)
        ((Waiting) (when (aboard? (● w passenger)) (set! (● w fare) (Hired))
                         (when (= (modulo (● w dispatch) 16) 0)
                           (set! (● w talk) (open-dialogue conversation)))))
        ((Hired) (set! (● w metres) (+ (● w metres) moved))
         (match (● w passenger) ((Ground _) (settle! w)) (_ (unit))))
        ((Paid until _) (when (>= (● w tick) until) (offer! w (+ 1 (● w dispatch)))))))
    (define (rider-gait (r Rider) (g Gait) (before XZ) (after Body)) (→ Gait)
      (Gait-seat-set (animate g (if (or (crossing? r) (aboard? r)) (Riding) (Striding))
                              (distance before (● after position)) dt) (seat-weight r)))
    (define (spawn-motor (g Area) (roads Roads) (motor Motor)) (→ RigidBody)
      (let* ((b (motor-body roads motor))
             (moving
              (Body-velocity-set b (offset (xz 0.0 0.0) (forward (● b heading)) (● motor speed)))))
        (road-chassis g sedan moving 1420.0)))
    (define (ensure-cars! (g Area) (roads Roads) (s Shift)) (→ Unit)
      (let ((w (● s game)) (cars (● s cars)))
        (unless (= (length cars) (+ 1 (length (● w traffic))))
          (set! (● s cars)
                (Cons (match cars ((Cons cab _) cab) (_ (road-chassis g sedan (● w cab) 1520.0)))
                      (map (lambda (m) (spawn-motor g roads m)) (● w traffic)))))))
    ;; A route chooses a look-ahead point. The tyres steer back from the
    ;; car's physical location after a collision.
    (define (traffic-drive (roads Roads) (m Motor) (b Body)) (→ Drive)
      (let* ((a (node-at roads (● m from))) (z (node-at roads (● m to)))
             (along
              (* (edge-distance roads (● m from) (● m to)) (edge-fraction (● b position) a z)))
             (goal (follow-edge roads (● m from) (● m to) (+ along 5.0) 1.7))
             (angle (- (heading-to (● b position) (● goal position)) (● b heading)))
             (speed (signed-speed b)) (target (min (● m speed) (if (< (cos angle) 0.6) 3.0 9.0))))
        (drive (max 0.0 (min 1.0 (* 0.6 (- target speed))))
               (max -0.55 (min 0.55 (atan2 (sin angle) (cos angle)))) (> speed (+ target 0.5)))))
    (define (traffic-route (roads Roads) (m Motor) (b Body) (obstacles (List XZ))) (→ Motor)
      (let* ((a (node-at roads (● m from))) (z (node-at roads (● m to)))
             (length (edge-distance roads (● m from) (● m to)))
             (at (* length (edge-fraction (● b position) a z)))
             (metres (if (< (distance (● b position) z) 3.2) length at)))
        (advance-motor roads (Motor-metres-set m metres) obstacles dt)))
    (define (cab-drive (w Game) (order Order)) (→ Drive)
      (let ((bits (● order buttons)) (c (● order driving)))
        (if (and (aboard? (● w driver)) (not (crossing? (● w passenger))))
            (begin (adjust-driver! c (steering bits) (axis bits 1 2) dt)
                   (drive (● c pedal) (● c wheel) (button? bits 32)))
            (drive 0.0 0.0 #t))))
    (define (local-motor (g Area) (roads Roads) (w Game) (m Motor) (c RigidBody)
                         (nearby (List XZ)) (i I64)) (→ (Pair Motor RigidBody))
                         (let ((at (● w cab position)) (b (chassis-body c)))
                           (if (or (> (distance at (● b position)) 190.0) (= (● m from) (● m to)))
                               (let ((spawn (seed-motor roads at (+ i (modulo (● w tick) 17)))))
                                 (new Pair (first spawn) (second (spawn-motor g roads spawn))))
                               (new Pair (first (traffic-route roads m b nearby)) (second c)))))
    (define (move-cars! (g Area) (roads Roads) (s Shift) (order Order)) (→ Unit)
      (ensure-cars! g roads s)
      (let* ((w (● s game)) (cab (list-ref (● s cars) 0)) (others (list-drop (● s cars) 1))
             (positions (map (lambda (c) (● (chassis-body c) position)) others))
             (people (map (lambda (p) (● p body position)) (● w residents)))
             (traffic (map-indexed (lambda (i pair)
                                     (local-motor g roads w (● pair first) (● pair second)
                                                  (Cons (● w cab position)
                                                        (append people
                                                                (append (take positions i)
                                                                        (list-drop positions
                                                                                   (+ i 1)))))
                                                  i))
                                   (zip (● w traffic) others)))
             (npc-steps (map (lambda (p)
                               (let* ((c (● p second)) (b (chassis-body c)))
                                 (car-step g
                                           c
                                           (traffic-drive roads (● p first) b)
                                           (area-solids g (● b position) 6.0))))
                             traffic)))
        (step-cars! sedan (Cons (car-step g cab (cab-drive w order) (car-walls g w)) npc-steps) dt)
        (set! (● w traffic) (map (lambda (p) (● p first)) traffic))
        (set! (● s cars) (Cons cab (map (lambda (p) (● p second)) traffic)))
        (set! (● w cab) (chassis-body cab))))
    (define (street-life! (g Area) (roads Roads) (w Game)) (→ Unit)
      (let* ((b (● w cab)) (at (● b position)))
        (set! (● w residents) (map-indexed (lambda (i r)
                                             (let ((p (● r body position)))
                                               (if (> (distance at p) 160.0)
                                                   (sidewalk-walker g
                                                                    roads
                                                                    at
                                                                    (+ i (modulo (● w tick) 19)))
                                                   (begin
                                                     (advance-pedestrian! r
                                                                          (if (and
                                                                               (> (abs (signed-speed
                                                                                        b))
                                                                                  2.0)
                                                                               (< (distance at p)
                                                                                  5.0))
                                                                              (Some at)
                                                                              (None))
                                                                          (on-foot-walls g w p 3.0)
                                                                          dt)
                                                     r))))
                                           (● w residents)))))
    ;; Search directed lanes, including the middle of a long one-way block.
    ;; The slightly inset ends keep a recovered cab clear of the intersection.
    (define (recovery-lane (r Roads) (at XZ) (i I64) (j I64) (limit F64)) (→ (Option Body))
      (let* ((a (node-at r i)) (b (node-at r j)) (x (● at x)) (z (● at z)) (reach (+ limit 1.7)))
        (if (or (< (+ x reach) (min (● a x) (● b x))) (> (- x reach) (max (● a x) (● b x)))
                (< (+ z reach) (min (● a z) (● b z))) (> (- z reach) (max (● a z) (● b z)))) (None)
                (let* ((len (distance a b)) (inset (min 3.0 (* 0.5 len)))
                       (d (max inset (min (- len inset) (* len (edge-fraction at a b)))))
                       (pose (follow-edge r i j d 1.7)))
                  (if (and (> len 2.0) (< (distance at (● pose position)) limit))
                      (Some pose)
                      (None))))))
    (define (clear-lane? (g Area) (p XZ) (traffic (List XZ))) (→ Bool)
      (let* ((id (sector-id (● g atlas) p))
             (local (if (any? (lambda (s) (= (● s id) id)) (● g sectors))
                        g (open-area (● g atlas) p)))
             (radius (* 0.5
                        (sqrt (+ (* (● sedan width) (● sedan width))
                                 (* (● sedan length) (● sedan length)))))))
        (and (not (null? (● local sectors))) (clear? p radius (area-solids local p 5.0))
             (every? (lambda (other) (> (distance p other) 5.2)) traffic))))
    (define (recovery-site (g Area) (r Roads) (at XZ) (traffic (List XZ))) (→ (Option Body))
      (let ((start (nearest-road r at)) (count (array-length (● r points))))
        (let node ((n 0) (best (None)) (limit 1e30))
          (if (= n count) best
              (let ((i (modulo (+ start n) count)))
                (let edge ((to (exits r i)) (best best) (limit limit))
                  (match to
                    ((Nil) (node (+ n 1) best limit))
                    ((Cons j rest)
                     (match (recovery-lane r at i j limit)
                       ((Some pose) (if (clear-lane? g (● pose position) traffic)
                                        (edge rest (Some pose) (distance at (● pose position)))
                                        (edge rest best limit)))
                       (_ (edge rest best limit)))))))))))
    (define (recover-cab! (g Area) (r Roads) (s Shift)) (→ Bool)
      (ensure-cars! g r s)
      (let* ((w (● s game)) (others (list-drop (● s cars) 1))
             (obstacles (append (map (lambda (c) (● (chassis-body c) position)) others)
                                (map (lambda (p) (● p body position)) (● w residents)))))
        (match (recovery-site g r (● w cab position) obstacles)
          ((None) #f)
          ((Some pose)
           (focus-area! g (● pose position))
           (set! (● s cars) (Cons (road-chassis g sedan pose 1520.0) others))
           (set! (● w cab) pose)
           (set! (● w driver) (Aboard)) (set! (● w gait) (Gait-seat-set resting 1.0))
           (match (● w fare) ((Waiting) (set! (● w passenger) (waiting-rider (current-pickup w))))
                  ((Hired) (set! (● w passenger) (Aboard))) (_ (unit))) #t))))
    (define (step! (g Area) (roads Roads) (s Shift) (order Order)) (→ Unit)
      (let* ((w (● s game)) (cab (● w cab position))
             (p (● (driver-body w) position))
             (q (● (passenger-body w) position)))
        (set! (● w tick) (+ 1 (● w tick)))
        (move-driver! g w order)
        (move-cars! g roads s order)
        (passenger! g w) (meter! w (distance cab (● w cab position)))
        (set! (● w gait) (rider-gait (● w driver) (● w gait) p (driver-body w)))
        (set! (● w passenger-gait)
              (rider-gait (● w passenger) (● w passenger-gait) q (passenger-body w)))
        (street-life! g roads w)))))
