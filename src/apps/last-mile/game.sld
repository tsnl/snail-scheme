;; A neighborhood film crew has one take left. Everything that determines
;; the next tick, including pedestrian intent, fits in one save value.
(define-library (apps last-mile game)
  (export Beat PictureCar MeetRosa FindMark OnCue ToCuttingRoom HandOff Finished Shot Game Order
          quiet
          new-world
          step!
          tick-ms
          carrier
          driver-body
          rosa-body
          objective
          gate-up?
          blocked-door?
          button?
          sedan
          save-game restore-game speak!)
  (import
   (snail core base)
   (snail shell wire)
   (only (snail shell utf8) string->utf8)
   (snail shell math)
   (snail shell game physics)
   (snail shell game vehicle)
   (snail shell game humanoid)
   (snail shell game pedestrian)
   (snail shell game boarding)
   (snail shell game dialogue)
   (snail shell game quest)
   (apps last-mile lines)
   (apps last-mile district))
  (begin
    ;; The original browser save. Preserve its wire identities for migration.
    (record Shot
      ((start XZ)
       (end XZ)
       (until I64))
      (deriving Serialize Deserialize))
    (enum Mission (Pickup) (Action) (ToEditor) (Wrapped) (deriving Serialize Deserialize))
    (enum Seat (OnFoot ((body Body))) (Driving) (deriving Serialize Deserialize))
    (record World
      ((tick I64)
       (mission Mission)
       (seat Seat)
       (gait Gait)
       (cooldown I64)
       (cab Body)
       (residents (List Pedestrian))
       (shot (Option Shot)))
      (deriving Serialize Deserialize))
    (enum Beat (PictureCar) (MeetRosa) (FindMark) (OnCue) (ToCuttingRoom) (HandOff) (Finished)
          (deriving Serialize Deserialize))
    (enum TakeEvent
      (DriverReady)
      (PassengerReady)
      (ParkedOnMark)
      (Painted)
      (ReachedEditor)
      (ReelDelivered))
    (define-quest (advance-take Beat TakeEvent)
      ((PictureCar) (DriverReady) (MeetRosa))
      ((MeetRosa) (PassengerReady) (FindMark))
      ((FindMark) (ParkedOnMark) (OnCue))
      ((OnCue) (Painted) (ToCuttingRoom))
      ((ToCuttingRoom) (ReachedEditor) (HandOff))
      ((HandOff) (ReelDelivered) (Finished)))
    (record Game
      ((tick I64)
       (mission Beat)
       (driver Rider)
       (gait Gait)
       (rosa Rider)
       (rosa-gait Gait)
       (talk (Option Cursor))
       (cooldown I64)
       (cab Body)
       (residents (List Pedestrian))
       (shot (Option Shot)))
      (deriving Serialize Deserialize))
    (record Order
      ((buttons I64)
       (interact Bool)))

    (define tick-ms (→ I64) 50)
    (define dt (→ F64) (/ (i64->f64 tick-ms) 1000.0))
    (define quiet (→ Order) (new Order (buttons 0) (interact #f)))
    (define sedan
      (→ CarDimensions)
      (new CarDimensions (wheelbase 2.376) (width 1.875) (length 4.6)))

    (define (new-world) (→ Game)
      (new Game (tick 0) (mission (PictureCar)) (driver (Ground (body (xz -2.2 18.4) 0.28)))
           (gait resting) (rosa (Ground (body pickup-curb -1.5))) (rosa-gait resting) (talk (None))
           (cooldown 0) (cab (body parking 0.0))
           (residents (list (pedestrian (xz -3.1 14.0) (xz -3.1 -8.0))
                            (pedestrian (xz 17.0 -30.0) (xz 25.0 -30.0)))) (shot (None))))

    (define (driver-body (w Game)) (→ Body) (rider-body (● w driver) (● w cab) sedan (DriverDoor)))
    (define (rosa-body (w Game)) (→ Body) (rider-body (● w rosa) (● w cab) sedan (PassengerDoor)))
    (define (carrier (w Game)) (→ Body) (if (aboard? (● w driver)) (● w cab) (driver-body w)))
    (define (objective (w Game)) (→ XZ)
      (match (● w mission) ((PictureCar) (● w cab position)) ((MeetRosa) (● (rosa-body w) position))
             ((FindMark) shoot-mark)
             ((OnCue) target)
             ((ToCuttingRoom) editor-stop)
             (_ delivery-point)))
    (define (gate-up? (w Game)) (→ Bool)
      (match (● w mission) ((ToCuttingRoom) #f) ((HandOff) #f) ((Finished) #f) (_ #t)))
    (define (street (w Game)) (→ (List Footprint)) (if (gate-up? w) (Cons gate walls) walls))
    (define (blocked-door? (w Game) (door Door)) (→ Bool)
      (not (door-clear? (● w cab) sedan door (street w))))
    (define (on-foot-walls (w Game))
      (→ (List Footprint))
      (Cons (parked-footprint (● w cab) sedan) (street w)))

    ;; ---- Save editions ----

    (define (migrate (old World)) (→ Game)
      (let* ((beat (match (● old mission) ((Pickup) (PictureCar)) ((Action) (MeetRosa))
                          ((ToEditor) (ToCuttingRoom)) ((Wrapped) (Finished))))
             (r
              (match beat ((ToCuttingRoom) (Aboard)) ((Finished) (Ground (body delivery-point 0.0)))
                     (_ (Ground (body pickup-curb -1.5))))))
        (new Game (tick (● old tick)) (mission beat)
             (driver (match (● old seat) ((Driving) (Aboard)) ((OnFoot b) (Ground b))))
             (gait (● old gait)) (rosa r) (rosa-gait resting) (talk (None))
             (cooldown (● old cooldown))
             (cab (● old cab))
             (residents (● old residents))
             (shot (● old shot)))))
    (define (save-game (w Game)) (→ Bytes)
      (let ((data (serialize w)) (tag (string->utf8 "LM2\n")))
        (array-generate (+ 4 (array-length data))
                        (lambda (i) (if (< i 4) (array-ref tag i) (array-ref data (- i 4)))))))
    (define (restore-game (data Bytes)) (→ Game)
      (let ((tag (string->utf8 "LM2\n")))
        (if (and (>= (array-length data) 4)
                 (every? (lambda (i) (= (array-ref data i) (array-ref tag i))) (iota 4)))
            (deserialize
             (array-generate (- (array-length data) 4) (lambda (i) (array-ref data (+ 4 i)))))
            (migrate (deserialize data)))))

    ;; ---- Streets and controls ----

    (define (button? (bits I64) (bit I64)) (→ Bool) (not (= (i64-and bits bit) 0)))
    (define (axis (bits I64) (positive I64) (negative I64)) (→ F64)
      (- (if (button? bits positive) 1.0 0.0) (if (button? bits negative) 1.0 0.0)))

    (define (pedals (speed F64) (throttle F64)) (→ F64)
      (cond ((> throttle 0.0) (min 17.0 (+ speed (* dt (if (< speed 0.0) 9.0 4.2)))))
            ((< throttle 0.0) (max -4.0 (- speed (* dt (if (> speed 0.0) 9.0 2.5)))))
            ((> speed 0.0) (max 0.0 (- speed (* dt 1.8))))
            (else (min 0.0 (+ speed (* dt 1.8))))))

    (define (car-walls (w Game)) (→ (List Footprint))
      (match (● w rosa)
        ((Ground b) (Cons (footprint (● b position x) (● b position z) 0.48 0.48) (street w)))
        ((AtDoor b) (Cons (footprint (● b position x) (● b position z) 0.48 0.48) (street w)))
        (_ (street w))))
    (define (drive! (w Game) (bits I64)) (→ Unit)
      (let* ((b (● w cab)) (speed (signed-speed b))
             (steer (* (axis bits 8 4) (/ 0.54 (+ 1.0 (* 0.065 (abs speed)))))))
        (if (crossing? (● w rosa)) (set! (● w cab) (body (● b position) (● b heading)))
            (let ((next-speed (if (button? bits 32)
                                  (- speed (max -0.55 (min 0.55 speed)))
                                  (pedals speed (axis bits 1 2)))))
              (set! (● w cab) (bicycle-step b sedan steer next-speed (car-walls w) dt))))))
    (define (use-door (r Rider) (car Body) (solids (List Footprint))) (→ Rider)
      (match r ((Ground _) (approach-door r car 4.2)) ((AtDoor b) (Ground b))
             (_ (leave-seat r car sedan (DriverDoor) solids))))
    (define (move-driver! (w Game) (bits I64) (use Bool)) (→ Unit)
      (let* ((car (● w cab)) (r (● w driver)) (requested (if use (use-door r car (street w)) r)))
        (match requested
          ((Ground b) (set! (● w driver) (Ground (walk b (+ (● b heading) (* 0.13 (axis bits 8 4)))
                                                       (* 5.5 (axis bits 1 2))
                                                       (on-foot-walls w)
                                                       dt))))
          ((Aboard) (drive! w bits))
          (_ (set! (● w cab) (body (● car position) (● car heading)))
             (set! (● w driver)
                   (advance-rider requested (● w cab) sedan (DriverDoor) (street w) dt))))))
    (define (parked-at? (w Game) (at XZ) (radius F64)) (→ Bool)
      (and (stopped? (● w cab)) (< (distance (● w cab position) at) radius)))
    (define (move-rosa! (w Game)) (→ Unit)
      (let* ((car (● w cab)) (r (● w rosa)) (solids (street w))
             (request (match (● w mission)
                        ((MeetRosa) (if (aboard? (● w driver)) (approach-door r car 5.5) r))
                        ((HandOff) (if (parked-at? w editor-stop 3.5)
                                       (leave-seat r car sedan (PassengerDoor) solids) r)) (_ r)))
             (next (advance-rider request car sedan (PassengerDoor) solids dt)))
        (set! (● w rosa)
              (match (new Pair (first (● w mission)) (second next))
                ((Pair (HandOff) (Ground b))
                 (Ground (walk-around-car b delivery-point car sedan solids dt)))
                (_ next)))))
    (define (speak! (w Game) (reply I64)) (→ Unit)
      (match (● w talk)
        ((Some at) (set! (● w talk) (if (< reply 0) (continue-dialogue conversation at)
                                        (answer-dialogue conversation at reply))))
        (_ (unit))))

    ;; ---- Paint marker ----

    (define (fire! (w Game)) (→ Bool)
      (let* ((b (carrier w)) (p (● b position)) (axis (forward (● b heading)))
             (range (trace-distance p
                                    axis
                                    22.0
                                    (if (aboard? (● w driver)) (street w) (on-foot-walls w))))
             (dx (- (● target x) (● p x))) (dz (- (● target z) (● p z)))
             (along (+ (* dx (● axis x)) (* dz (● axis z))))
             (hit (and
                   (> along 0.0) (<= along range)
                   (< (abs (- (* dx (● axis z)) (* dz (● axis x)))) 0.85))))
        (set! (● w shot)
              (Some (new Shot
                      (start p)
                      (end (offset p axis (if hit along range)))
                      (until (+ (● w tick) 3)))))
        (set! (● w cooldown) 8)
        hit))

    (define (walkers! (w Game)) (→ Unit)
      (let ((solids (on-foot-walls w)))
        (for-each (lambda (r)
                    (let ((noise (match (● w shot)
                                   ((Some s)
                                    (if (< (distance (● r body position) (● s start)) 11.0)
                                        (Some (● s start))
                                        (None)))
                                   (_ (None)))))
                      (advance-pedestrian! r noise solids dt))) (● w residents))))

    ;; ---- The take ----

    (define (observe! (w Game) (hit Bool)) (→ Unit)
      (let* ((driver (aboard? (● w driver))) (passenger (aboard? (● w rosa)))
             (events (concatenate (list (if driver (list (DriverReady)) (Nil))
                                        (if (and driver passenger) (list (PassengerReady)) (Nil))
                                        (if (and driver
                                                 passenger
                                                 (parked-at? w shoot-mark 2.1)
                                                 (> (sin (● w cab heading)) 0.80))
                                            (list (ParkedOnMark)) (Nil))
                                        (if hit (list (Painted)) (Nil))
                                        (if (and driver passenger (parked-at? w editor-stop 3.5))
                                            (list (ReachedEditor))
                                            (Nil))
                                        (match (● w rosa)
                                          ((Ground b)
                                           (if (< (distance (● b position) delivery-point) 0.16)
                                               (list (ReelDelivered)) (Nil))) (_ (Nil))))))
             (next (advance-take (● w mission) events)))
        (match (new Pair (first (● w mission)) (second next))
          ((Pair (MeetRosa) (FindMark)) (set! (● w talk) (open-dialogue conversation)))
          ((Pair (FindMark) (OnCue)) (set! (● w talk) (None))) (_ (unit)))
        (set! (● w mission) next)))
    (define (rider-gait (r Rider) (g Gait) (before XZ) (after Body) (aim Bool)) (→ Gait)
      (let* ((activity
              (cond ((or (crossing? r) (aboard? r)) (Riding)) (aim (Bracing)) (else (Striding))))
             (next (animate g activity (distance before (● after position)) dt)))
        (Gait-seat-set next (seat-weight r))))
    (define (step! (w Game) (order Order)) (→ Unit)
      (let ((p (● (driver-body w) position))
            (q (● (rosa-body w) position))
            (bits (● order buttons)))
        (set! (● w tick) (+ 1 (● w tick)))
        (set! (● w cooldown) (max 0 (- (● w cooldown) 1)))
        (match (● w shot)
          ((Some s) (when (<= (● s until) (● w tick)) (set! (● w shot) (None))))
          (_ (unit)))
        (move-driver! w bits (● order interact))
        (move-rosa! w)
        (observe! w
                  (and (button? bits 16)
                       (= (● w cooldown) 0)
                       (not (crossing? (● w driver)))
                       (fire! w)))
        (set! (● w gait)
              (rider-gait (● w driver) (● w gait) p (driver-body w) (> (● w cooldown) 1)))
        (set! (● w rosa-gait) (rider-gait (● w rosa) (● w rosa-gait) q (rosa-body w) #f))
        (walkers! w)))))
