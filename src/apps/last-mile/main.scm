 (apps last-mile render))

;; ---- Input between simulation ticks ----

(record Controls
  ((keys (List I32))
   (driving DriverControls)
   (wide Bool)
   (choice I64)
   (use Bool)
   (paused Bool)
   (redraw Bool)
   (locked Bool)
   (yaw F64)
   (pitch F64)
   (before Shift)
   (carry I64)))

(define (controls (w Shift)) (→ Controls)
  (new Controls
    (keys (Nil))
    (driving (neutral-driver))
    (wide #f) (choice (modulo (● w game dispatch) 16))
    (use #f)
    (paused #f)
    (redraw #t)
    (locked #f)
    (yaw 0.0)
    (pitch 0.28)
    (before (snapshot w))
    (carry 0)))

(define (key-bit (key I32)) (→ I64)
  (case key
    ((119 3) 1)
    ((115 4) 2)
    ((97) 4)
    ((100) 8)
    ((1) 128)
    ((2) 256)
    ((32) 32)
    ((98) 32)
    (else 0)))

(define (held (c Controls)) (→ I64)
  (fold-left (lambda (mask key) (i64-or mask (key-bit key)))
             (if (● c locked) 64 0)
             (● c keys)))

(define (pause! (c Controls) (yes Bool)) (→ Unit)
  (set! (● c paused) yes) (set! (● c keys) (Nil)) (set! (● c use) #f)
  (set! (● c driving) (neutral-driver)))

(define (key-down! (c Controls) (s Shift) (key I32)) (→ Unit)
  (let ((w (● s game)))
    (unless (member? key (● c keys))
      (set! (● c keys) (Cons key (● c keys)))
      (cond ((or (= key 112) (= key 27)) (pause! c (not (● c paused))))
            ((● c paused) (unit))
            (else (case key
                    ((99) (set! (● c yaw) 0.0) (set! (● c pitch) 0.28))
                    ((101) (set! (● c use) #t))
                    ((116) (speak! w -1))
                    ((49 50 51 52 53 54 55 56 57) (speak! w (- (i32->i64 key) 49)))
                    ((109)
                     (set! (● c wide) (not (● c wide)))
                     (set! (● c choice) (modulo (● w dispatch) 16)))
                    ((91 93)
                     (when (● c wide)
                       (set! (● c choice) (modulo (+ (● c choice) (if (= key 93) 1 15)) 16))))
                    ((13) (when (and (● c wide) (start-stand! w (● c choice)))
                            (set! (● s cars) (Nil))
                            (set! (● c wide) #f)
                            (set! (● c carry) 0)
                            (set! (● c yaw) 0.0)))
                    ((108) (shift-time! w))
                    (else (unit))))))))

(define (input! (c Controls) (s Shift) (input Input)) (→ Unit)
  (match input
    ((Resize _ _) (set! (● c redraw) #t))
    ((KeyDown key _) (key-down! c s key))
    ((KeyUp key) (set! (● c keys) (filter (lambda (k) (not (= k key))) (● c keys))))
    ((PointerLock captured) (set! (● c locked) captured)
     (unless captured (set! (● c keys) (Nil)) (set! (● c use) #f)))
    ((PointerDelta dx dy)
     (unless (● c paused)
       (let* ((gain (case (● s sensitivity) ((0) 0.55) ((2) 1.65) (else 1.0)))
              (turn (* gain (* 0.0035 (i32->f64 dx)))))
         (if (aboard? (● s game driver))
             (set! (● c yaw) (+ (● c yaw) turn))
             (turn-driver! (● s game) turn))
         (set! (● c pitch)
               (max -0.32 (min 1.16 (+ (● c pitch) (* gain (* 0.003 (i32->f64 dy))))))))))
    (_ (unit))))

(define (elapsed! (g Area) (roads Roads) (c Controls) (s Shift) (ms I32)) (→ Unit)
  (unless (● c paused)
    (let loop ((carry (+ (● c carry) (min 250 (i32->i64 ms)))))
      (if (< carry tick-ms) (set! (● c carry) carry)
          (begin (when (< carry (* 2 tick-ms)) (set! (● c before) (snapshot s)))
                 (step! g
                        roads
                        s
                        (new Order (driving (● c driving)) (buttons (held c)) (interact (● c use))))
                 (unless (aboard? (● s game driver)) (set! (● c yaw) 0.0))
                 (focus-area! g (● (carrier (● s game)) position))
                 (set! (● c use) #f) (loop (- carry tick-ms)))))))

(define (return-to-road! (g Area) (roads Roads) (renderer Renderer) (c Controls) (s Shift)) (→ Unit)
  (focus-area! g (● (carrier (● s game)) position))
  (when (null? (● s game traffic)) (populate! g roads s))
  (ensure-cars! g roads s) (reset-view! renderer) (pause! c #f)
  (set! (● c before) (snapshot s)) (set! (● c carry) 0) (set! (● c wide) #f)
  (set! (● c choice) (modulo (● s game dispatch) 16)) (set! (● c yaw) 0.0) (set! (● c pitch) 0.28))

(define (menu! (action MenuAction) (d Dom) (g Area) (r Roads) (renderer Renderer)
               (c Controls) (s Shift) (save (Fn Shift → Unit))) (→ Shift)
               (match action
                 ((Pause) (pause! c #t) s)
                 (_ (if (not (● c paused)) s
                        (match action
                          ((Resume) (pause! c #f) s)
                          ((SetResolution lines)
                           (set! (● s resolution) lines)
                           (set! (● c redraw) #t)
                           (save s)
                           s)
                          ((SetSensitivity level) (set! (● s sensitivity) level) (save s) s)
                          ((Recover)
                           (when (recover-cab! g r s) (return-to-road! g r renderer c s) (save s))
                           s)
                          ((Restart)
                           (if ((● d confirm)
                                "Restart the game? Your current fare, earnings and shift progress will be cleared.")
                               (let ((fresh (restart-shift s)))
                                 (return-to-road! g r renderer c fresh)
                                 (save fresh)
                                 fresh)
                               s))
                          (_ s))))))

;; ---- Page and save ----

(define (play (events Events) (gpu Gpu) (dom Dom) (renderer Renderer) (hud Hud)
              (g Area) (roads Roads) (world Shift) (save (Fn Shift → Unit))) (→ Unit)
              (let ((c (controls world)))
                (let loop ((s world) (since 100))
                  (let ((w (● s game)))
                    (match (next-event events)
                      ((FrameEvent ms)
                       (when (null? (● w traffic))
                         (focus-area! g (● (carrier w) position))
                         (populate! g roads s)
                         (set! (● c before) (snapshot s)) (reset-view! renderer))
                       (elapsed! g roads c s ms)
                       (let ((due (>= (+ since ms) 100)))
                         (when due (show! dom hud g roads w (● c paused) (● c wide) (● c choice)
                                          (render-resolution renderer (● s resolution))))
                         ;; The pause menu keeps the last presented street on screen. Resize
                         ;; and quality changes request a fresh trace at the chosen dimensions.
                         (when (or (not (● c paused)) (● c redraw))
                           (draw! renderer
                                  gpu
                                  (● c before)
                                  s
                                  (/ (i64->f64 (● c carry)) (i64->f64 tick-ms))
                                  (● c yaw) (● c pitch) ms)
                           (set! (● c redraw) #f))
                         ((● events report-ready)) (loop s (if due 0 (+ since ms)))))
                      ((InputEvent event)
                       (let ((paused (● c paused)))
                         (input! c s event)
                         (when (if paused (not (● c paused)) (● c paused))
                           (show-menu! dom hud s (● c paused))))
                       (loop s 100))
                      ((HudEvent listener)
                       (match (menu-action dom hud listener)
                         ((Some action) (let ((next (menu! action dom g roads renderer c s save)))
                                          (show-menu! dom hud next (● c paused)) (loop next 100)))
                         (_ (unless (● c paused)
                              (match (clicked-stand hud listener)
                                ((Some i) (when (● c wide) (set! (● c choice) i)))
                                (_ (click-reply! hud w listener)))) (loop s 100))))
                      ((Hidden) (save s) (pause! c (● c paused)) (loop s 100))
                      ((SaveRequested) (save s) (loop s since)) (_ (loop s since)))))))

(define (main (events Events)
              (gpu Gpu)
              (dom Dom)
              (resources Resources)
              (storage PageStorage)
              (out OutputPort))
  (→ Unit)
  (let* ((files (read-resources resources
                                (append city-bands
                                        (list streets-model
                                              map-image
                                              taxi-model
                                              other-model
                                              people-model
                                              horizon-model))))
         (atlas (read-atlas (take files 6))) (roads (read-roads (list-ref files 6)))
         (hud (make-hud dom atlas (png-data-url (list-ref files 7)))) (models (list-drop files 8)))
    (run-page events storage new-world save-game restore-game
              (lambda (w save)
                (let ((g (open-area atlas (● (carrier (● w game)) position))))
                  (when (or (null? (● w game residents)) (null? (● w game traffic)))
                    (populate! g roads w))
                  (ensure-cars! g roads w)
                  (match (attempt-reading (lambda ()
                                            (make-renderer gpu
                                                           (lambda (paths)
                                                             (art-reader resources paths))
                                                           models
                                                           g
                                                           w)))
                    ((Ok renderer) (play events gpu dom renderer hud g roads w save))
                    ((Err why) (write-line out why) (panic why))))))))
