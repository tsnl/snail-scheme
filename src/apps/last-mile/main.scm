;; ---- Input between simulation ticks ----

(record Controls
  ((keys (List I32))
   (driving DriverControls)
   (wide Bool)
   (choice I64)
   (use Bool)
   (paused Bool)
   (redraw Bool)
   (locked Bool)
   (yaw F64)
   (pitch F64)
   (before Shift)
   (carry I64)))

(define (controls (w Shift)) (→ Controls)
  (new Controls
    (keys (Nil))
    (driving (neutral-driver))
    (wide #f) (choice (modulo (● w game dispatch) 16))
    (use #f)
    (paused #f)
    (redraw #t)
    (locked #f)
    (yaw 0.0)
    (pitch 0.28)
    (before (snapshot w))
    (carry 0)))

(define (key-bit (key I32)) (→ I64)
  (case key
    ((119 3) 1)
    ((115 4) 2)
    ((97) 4)
    ((100) 8)
    ((1) 128)
    ((2) 256)
    ((32) 32)
    ((98) 32)
    (else 0)))

(define (held (c Controls)) (→ I64)
  (fold-left (lambda (mask key) (i64-or mask (key-bit key)))
             (if (● c locked) 64 0)
             (● c keys)))

(define (pause! (c Controls) (yes Bool)) (→ Unit)
  (set! (● c paused) yes) (set! (● c keys) (Nil)) (set! (● c use) #f)
  (set! (● c driving) (neutral-driver)))

(define (key-down! (c Controls) (s Shift) (key I32)) (→ Unit)
  (let ((w (● s game)))
    (unless (member? key (● c keys))
      (set! (● c keys) (Cons key (● c keys)))
      (cond ((or (= key 112) (= key 27)) (pause! c (not (● c paused))))
            ((● c paused) (unit))
            (else (case key
                    ((99) (set! (● c yaw) 0.0) (set! (● c pitch) 0.28))
                    ((101) (set! (● c use) #t))
                    ((109)
                     (set! (● c wide) (not (● c wide)))
                     (set! (● c choice) (modulo (● w dispatch) 16)))
                    ((91 93)
                     (when (● c wide)
                       (set! (● c choice) (modulo (+ (● c choice) (if (= key 93) 1 15)) 16))))
                    ((13) (when (and (● c wide) (start-stand! w (● c choice)))
                            (set! (● s cars) (Nil))
                            (set! (● c wide) #f)
                            (set! (● c carry) 0)
                            (set! (● c yaw) 0.0)))
                    ((108) (shift-time! w))
                    (else (unit))))))))

(define (input! (c Controls) (s Shift) (input Input)) (→ Unit)
  (match input
    ((Resize _ _) (set! (● c redraw) #t))
    ((KeyDown key _) (key-down! c s key))
    ((KeyUp key) (set! (● c keys) (filter (lambda (k) (not (= k key))) (● c keys))))
    ((PointerLock captured) (set! (● c locked) captured)
     (unless captured (set! (● c keys) (Nil)) (set! (● c use) #f)))
    ((PointerDelta dx dy)
     (unless (● c paused)
       (let* ((gain (case (● s sensitivity) ((0) 0.55) ((2) 1.65) (else 1.0)))
              (turn (* gain (* 0.0035 (i32->f64 dx)))))
         (if (aboard? (● s game driver))
             (set! (● c yaw) (+ (● c yaw) turn))
             (turn-driver! (● s game) turn))
         (set! (● c pitch)
               (max -0.32 (min 1.16 (+ (● c pitch) (* gain (* 0.003 (i32->f64 dy))))))))))
    (_ (unit))))

(define (elapsed! (g Area) (roads Roads) (c Controls) (s Shift) (ms I32)) (→ Unit)
  (unless (● c paused)
    (let loop ((carry (+ (● c carry) (min 250 (i32->i64 ms)))))
      (if (< carry tick-ms) (set! (● c carry) carry)
          (begin (when (< carry (* 2 tick-ms)) (set! (● c before) (snapshot s)))
                 (step! g
                        roads
                        s
                        (new Order (driving (● c driving)) (buttons (held c)) (interact (● c use))))
                 (unless (aboard? (● s game driver)) (set! (● c yaw) 0.0))
                 (focus-area! g (● (carrier (● s game)) position))
                 (set! (● c use) #f) (loop (- carry tick-ms)))))))

(define (return-to-road! (g Area) (roads Roads) (renderer Renderer) (c Controls) (s Shift)) (→ Unit)
  (focus-area! g (● (carrier (● s game)) position))
  (if (or (null? (● s game residents)) (null? (● s game traffic)))
      (populate! g roads s) (ensure-cars! g roads s))
  (reset-view! renderer) (pause! c #f)
  (set! (● c redraw) #t)
  (set! (● c before) (snapshot s)) (set! (● c carry) 0) (set! (● c wide) #f)
  (set! (● c choice) (modulo (● s game dispatch) 16)) (set! (● c yaw) 0.0) (set! (● c pitch) 0.28))

(define (menu! (action MenuAction) (d Dom) (hud Hud) (g Area) (r Roads) (renderer Renderer)
               (c Controls) (s Shift) (storage PageStorage)) (→ Shift)
               (match action
                 ((Pause) (pause! c #t) s)
                 (_ (if (not (● c paused)) s
                        (match action
                          ((Resume) (pause! c #f) s)
                          ((SaveShift)
                           (set! (● hud save-status)
                                 (if ((● storage store-save) (save-game s))
                                     "Shift saved."
                                     "Could not save this shift."))
                           s)
                          ((LoadShift)
                           (match (read-saved storage read-shift)
                             ((Err why) (set! (● hud save-status) why) s)
                             ((Ok loaded)
                              (reset-route! hud)
                              (return-to-road! g r renderer c loaded)
                              loaded)))
                          ((SetGraphics settings)
                           (set! (● s graphics) settings)
                           (set! (● c redraw) #t)
                           s)
                          ((SetSensitivity level) (set! (● s sensitivity) level) s)
                          ((Recover)
                           (when (recover-cab! g r s) (return-to-road! g r renderer c s))
                           s)
                          ((Restart)
                           (if ((● d confirm)
                                "Start a new shift? Unsaved progress will be lost.")
                               (let ((fresh (restart-shift s)))
                                 (return-to-road! g r renderer c fresh)
                                 fresh)
                               s))
                          (_ s))))))

;; ---- Page and save ----

(define (play (events Events) (gpu Gpu) (dom Dom) (renderer Renderer) (hud Hud)
              (g Area) (roads Roads) (world Shift) (storage PageStorage)) (→ Unit)
              (let ((c (controls world)))
                (let loop ((s world) (since 100))
                  (let ((w (● s game)))
                    (match (next-event events)
                      ((FrameEvent ms)
                       (when (null? (● w residents))
                         (focus-area! g (● (carrier w) position))
                         (populate! g roads s)
                         (set! (● c before) (snapshot s)) (reset-view! renderer))
                       (elapsed! g roads c s ms)
                       (let ((due (>= (+ since ms) 100)))
                         (when due (show! dom hud g roads s (● c paused) (● c wide) (● c choice)
                                          (render-resolution renderer)))
                         ;; The pause menu keeps the last presented street on screen. Resize
                         ;; and MSAA changes request a fresh native-resolution frame.
                         (match (display-frame! (● hud display) ms (● c paused) (● c redraw))
                           ((Some elapsed)
                            (draw! renderer gpu (● c before) s
                                   (/ (i64->f64 (● c carry)) (i64->f64 tick-ms))
                                   (● c yaw) (● c pitch) elapsed)
                            (unless (● c paused) (presented! (● hud display)))
                            (set! (● c redraw) #f)
                            ((● gpu work-done)))
                           (_ (unit)))
                         ((● events report-ready)) (loop s (if due 0 (+ since ms)))))
                      ((InputEvent event) (input! c s event)
                       (loop s (match event ((KeyDown _ _) 100) (_ since))))
                      ((HudEvent listener)
                       (match (root-message (● hud view) listener (fired-event events))
                         ((Some (AdjustDisplay change))
                          (when (● c paused) (change-display! (● hud display) change)) (loop s 100))
                         ((Some (Menu action))
                          (loop (menu! action dom hud g roads renderer c s storage) 100))
                         ((Some (ChooseStand i))
                          (when (and (not (● c paused)) (● c wide)) (set! (● c choice) i))
                          (loop s 100))
                         (_ (loop s since))))
                      ((Hidden)
                       (interrupt-display! (● hud display))
                       (pause! c (● c paused))
                       (loop s 100))
                      (_ (loop s since)))))))

(define (city-files (fetch Fetch) (store StaticResources) (loading Loading))
  (→ (Result (Table Bytes) String))
  (let ((url "resources.json"))
    (match (fetch-catalog fetch url)
      ((Err why) (Err why))
      ((Ok catalog) (acquire-files store url catalog (lambda (s) (show-download! loading s)))))))

(define (city-file (files (Table Bytes)) (path String)) (→ Bytes)
  (let ((name (if (and (>= (string-length path) 2) (string=? (substring path 0 2) "./"))
                  (substring path 2 (string-length path)) path)))
    (match (table-ref files name)
      ((Some bytes) bytes)
      ((None) (panic (string-append "city catalog is missing " name))))))

(define (drive-city (config RendererConfig) (clock Clock)
                    (events Events)
                    (gpu Gpu)
                    (dom Dom)
                    (storage PageStorage)
                    (out OutputPort) (loading Loading) (files (Table Bytes)))
  (→ Unit)
  (let* ((bands (map (lambda (i) (string-append "sf-" (show i) ".bin")) (iota 6)))
         (assets (fold-left table-remove files bands))
         (file (lambda (name) (city-file assets name)))
         (renderer (api:make-renderer gpu config)) (streets (empty-streets))
         (atlas (load-streets! streets renderer (map (lambda (name) (city-file files name)) bands)
                               (lambda (done total)
                                 (when (= (modulo done 16) 0)
                                   (show-preparation! loading done total)
                                   ((● gpu work-done))))))
         (_ (show-preparation! loading 1 1))
         (roads (read-roads (file "streets.nav")))
         (hud (make-hud dom clock storage atlas (png-data-url (file "sf-map.png"))))
         (models (map file (list "taxi.glb" "sedan.glb" "crew.glb" "horizon.glb")))
         (w (new-world)) (g (open-area atlas (● (carrier (● w game)) position))))
    (populate! g roads w)
    (match (attempt-reading
            (lambda ()
              (make-renderer gpu renderer (lambda (paths) (map file paths)) models streets g w)))
      ((Ok renderer) (play events gpu dom renderer hud g roads w storage))
      ((Err why) (write-line out why) (panic why)))))

(define (main (clock Clock) (events Events) (gpu Gpu) (dom Dom) (fetch Fetch) (picker FilePicker)
              (store StaticResources) (storage PageStorage) (out OutputPort))
  (→ Unit)
  (let ((loading (loading-screen dom)))
    (match (city-files fetch store loading)
      ((Ok files)
       (drive-city (page-renderer-config fetch picker)
                   clock
                   events
                   gpu
                   dom
                   storage
                   out
                   loading
                   files))
      ((Err why)
       ((● dom set-attribute) ((● dom document-root)) "data-load-error" why)
       ((● events report-ready))))))
