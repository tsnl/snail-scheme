;; Explicit numeric boundaries retain exact values and IEEE binary64 state.
;; Ordinary static overloads select these concrete Number/Scalar operations.
(define-library (snail number)
  (export Scalar exact-scalar rational-scalar inexact-scalar
          scalar-from-rational scalar->rational scalar->f64 scalar-exact? scalar-zero? scalar-equivalent?
          Number exact-number rational-number inexact-number complex-number
          number-from-integer number-from-rational number-from-scalar number-rectangular number-polar
          number->integer number->rational number->f64 number->string i64->string f64->string
          number-exact number-inexact number-truncate number-real-part number-imag-part
          number-numerator number-denominator number-exact? number-real? number-rational?
          number-integer? number-exact-integer? number-zero? number-negative? number-abs number-negate
          number-add number-subtract number-multiply number-divide
          number=? number<? number<=? number>? number>=? number-equivalent?
          + - * / = < <= > >= truncate)
  (import (snail strict) (snail integer) (snail rational) (snail math))
  (begin

    ;; ---- Concrete numeric values and canonical exact packing ----

    (define-data Scalar
      (exact-scalar (value I64)) (rational-scalar (value Rational)) (inexact-scalar (value F64)))
    (define-data Number
      (exact-number (value I64)) (rational-number (value Rational)) (inexact-number (value F64))
      (complex-number (real Scalar) (imaginary Scalar)))
    (: scalar-from-rational (-> Rational Scalar))
    (define (scalar-from-rational value)
      (if (and (rational-integer? value) (integer-fits-i64? (rational-numerator value)))
          (exact-scalar (integer->i64 (rational-numerator value))) (rational-scalar value)))
    (: number-from-scalar (-> Scalar Number))
    (define (number-from-scalar value)
      (match value ((exact-scalar value) (exact-number value))
             ((rational-scalar value) (rational-number value)) ((inexact-scalar value) (inexact-number value))))
    (: number-from-rational (-> Rational Number))
    (define (number-from-rational value) (number-from-scalar (scalar-from-rational value)))
    (: number-from-integer (-> Integer Number))
    (define (number-from-integer value) (number-from-rational (rational-from-integer value)))
    (: scalar-exact? (-> Scalar Bool))
    (define (scalar-exact? value)
      (match value ((exact-scalar value) #t) ((rational-scalar value) #t) ((inexact-scalar value) #f)))
    (: scalar-zero? (-> Scalar Bool))
    (define (scalar-zero? value)
      (match value ((exact-scalar value) (= value 0))
             ((rational-scalar value) (rational-zero? value)) ((inexact-scalar value) (= value 0.0))))
    (: scalar->f64 (-> Scalar F64))
    (define (scalar->f64 value)
      (match value ((exact-scalar value) (i64->f64 value))
             ((rational-scalar value) (rational->f64 value)) ((inexact-scalar value) value)))
    (: scalar->rational (-> Scalar Rational))
    (define (scalar->rational value)
      (match value ((exact-scalar value) (rational-from-integer (integer-from-i64 value)))
             ((rational-scalar value) value) ((inexact-scalar value) (rational-from-f64 value))))

    ;; Collapse an exact imaginary zero before promoting a surviving mixed
    ;; pair. An inexact imaginary zero preserves complex shape and its sign.
    (: number-rectangular (-> Scalar Scalar Number))
    (define (number-rectangular real imaginary)
      (if (and (scalar-exact? imaginary) (scalar-zero? imaginary)) (number-from-scalar real)
          (if (and (scalar-exact? real) (scalar-exact? imaginary)) (complex-number real imaginary)
              (complex-number (inexact-scalar (scalar->f64 real)) (inexact-scalar (scalar->f64 imaginary))))))
    (: number-polar (-> Scalar Scalar Number))
    (define (number-polar radius angle)
      (if (and (scalar-exact? radius) (scalar-zero? radius)) (exact-number 0)
          (if (and (scalar-exact? angle) (scalar-zero? angle)) (number-from-scalar radius)
              (let ((radius (scalar->f64 radius)) (angle (scalar->f64 angle)))
                (complex-number (inexact-scalar (* radius (cos angle)))
                                (inexact-scalar (* radius (sin angle))))))))

    ;; ---- Real/imaginary projections keep exact zero for scalar input ----

    (: real-component (-> Number Scalar))
    (define (real-component value)
      (match value ((exact-number value) (exact-scalar value))
             ((rational-number value) (rational-scalar value)) ((inexact-number value) (inexact-scalar value))
             ((complex-number real imaginary) real)))
    (: imaginary-component (-> Number Scalar))
    (define (imaginary-component value)
      (match value ((exact-number value) (exact-scalar 0)) ((rational-number value) (exact-scalar 0))
             ((inexact-number value) (exact-scalar 0)) ((complex-number real imaginary) imaginary)))
    (: complex-representation? (-> Number Bool))
    (define (complex-representation? value)
      (match value ((exact-number value) #f) ((rational-number value) #f)
             ((inexact-number value) #f) ((complex-number real imaginary) #t)))
    (: real-value (-> Number Scalar))
    (define (real-value value)
      (if (scalar-zero? (imaginary-component value)) (real-component value) (unreachable)))
    (: number-real-part (-> Number Number))
    (define (number-real-part value) (number-from-scalar (real-component value)))
    (: number-imag-part (-> Number Number))
    (define (number-imag-part value) (number-from-scalar (imaginary-component value)))
    (: number->f64 (-> Number F64))
    (define (number->f64 value) (scalar->f64 (real-value value)))
    (: number->rational (-> Number Rational))
    (define (number->rational value) (scalar->rational (real-value value)))
    (: number->integer (-> Number Integer))
    (define (number->integer value)
      (let ((value (real-value value)))
        (if (not (scalar-exact? value)) (unreachable)
            (let ((value (scalar->rational value)))
              (if (rational-integer? value) (rational-numerator value) (unreachable))))))

    ;; ---- Exactness, numeric domains and explicit conversions ----

    (: finite-real? (-> F64 Bool))
    (define (finite-real? value)
      (and (= value value) (< value (/ 1.0 0.0)) (> value (/ -1.0 0.0))))
    (: scalar-finite? (-> Scalar Bool))
    (define (scalar-finite? value)
      (match value ((exact-scalar value) #t) ((rational-scalar value) #t)
             ((inexact-scalar value) (finite-real? value))))
    (: scalar-integer? (-> Scalar Bool))
    (define (scalar-integer? value)
      (match value ((exact-scalar value) #t) ((rational-scalar value) (rational-integer? value))
             ((inexact-scalar value) (and (finite-real? value) (= value (truncate value))))))
    (: number-real? (-> Number Bool))
    (define (number-real? value) (scalar-zero? (imaginary-component value)))
    (: number-exact? (-> Number Bool))
    (define (number-exact? value)
      (and (scalar-exact? (real-component value)) (scalar-exact? (imaginary-component value))))
    (: number-rational? (-> Number Bool))
    (define (number-rational? value) (and (number-real? value) (scalar-finite? (real-component value))))
    (: number-integer? (-> Number Bool))
    (define (number-integer? value) (and (number-real? value) (scalar-integer? (real-component value))))
    (: number-exact-integer? (-> Number Bool))
    (define (number-exact-integer? value) (and (number-exact? value) (number-integer? value)))
    (: number-zero? (-> Number Bool))
    (define (number-zero? value)
      (and (scalar-zero? (real-component value)) (scalar-zero? (imaginary-component value))))
    (: number-exact (-> Number Number))
    (define (number-exact value)
      (number-rectangular (scalar-from-rational (scalar->rational (real-component value)))
                          (scalar-from-rational (scalar->rational (imaginary-component value)))))
    (: number-inexact (-> Number Number))
    (define (number-inexact value)
      (if (complex-representation? value)
          (complex-number (inexact-scalar (scalar->f64 (real-component value)))
                          (inexact-scalar (scalar->f64 (imaginary-component value))))
          (inexact-number (number->f64 value))))
    (: number-truncate (-> Number Number))
    (define (number-truncate value)
      (match (real-value value) ((exact-scalar value) (exact-number value))
             ((rational-scalar value) (number-from-integer (rational-truncate value)))
             ((inexact-scalar value) (inexact-number (truncate value)))))
    (: number-numerator (-> Number Number))
    (define (number-numerator value)
      (let ((scalar (real-value value)))
        (if (and (not (scalar-exact? scalar)) (scalar-zero? scalar)) (number-from-scalar scalar)
            (let ((numerator (rational-numerator (scalar->rational scalar))))
              (if (scalar-exact? scalar) (number-from-integer numerator) (inexact-number (integer->f64 numerator)))))))
    (: number-denominator (-> Number Number))
    (define (number-denominator value)
      (let* ((scalar (real-value value)) (denominator (rational-denominator (scalar->rational scalar))))
        (if (scalar-exact? scalar) (number-from-integer denominator) (inexact-number (integer->f64 denominator)))))

    ;; ---- Scalar arithmetic promotes only at an inexact boundary ----

    (: scalar-add (-> Scalar Scalar Scalar))
    (define (scalar-add left right)
      (if (and (scalar-exact? left) (scalar-exact? right))
          (scalar-from-rational (rational-add (scalar->rational left) (scalar->rational right)))
          (inexact-scalar (+ (scalar->f64 left) (scalar->f64 right)))))
    (: scalar-negate (-> Scalar Scalar))
    (define (scalar-negate value)
      (match value ((exact-scalar value) (scalar-from-rational (rational-negate (scalar->rational (exact-scalar value)))))
             ((rational-scalar value) (scalar-from-rational (rational-negate value)))
             ((inexact-scalar value) (inexact-scalar (* -1.0 value)))))
    (: scalar-subtract (-> Scalar Scalar Scalar))
    (define (scalar-subtract left right)
      (if (and (scalar-exact? left) (scalar-exact? right))
          (scalar-from-rational (rational-subtract (scalar->rational left) (scalar->rational right)))
          (inexact-scalar (- (scalar->f64 left) (scalar->f64 right)))))
    (: scalar-multiply (-> Scalar Scalar Scalar))
    (define (scalar-multiply left right)
      (if (and (scalar-exact? left) (scalar-exact? right))
          (scalar-from-rational (rational-multiply (scalar->rational left) (scalar->rational right)))
          (inexact-scalar (* (scalar->f64 left) (scalar->f64 right)))))
    (: scalar-divide (-> Scalar Scalar Scalar))
    (define (scalar-divide left right)
      (if (and (scalar-exact? left) (scalar-exact? right))
          (scalar-from-rational (rational-divide (scalar->rational left) (scalar->rational right)))
          (inexact-scalar (/ (scalar->f64 left) (scalar->f64 right)))))
    (: number-add (-> Number Number Number))
    (define (number-add left right)
      (number-rectangular (scalar-add (real-component left) (real-component right))
                          (scalar-add (imaginary-component left) (imaginary-component right))))
    (: number-negate (-> Number Number))
    (define (number-negate value)
      (number-rectangular (scalar-negate (real-component value)) (scalar-negate (imaginary-component value))))
    (: number-subtract (-> Number Number Number))
    (define (number-subtract left right)
      (number-rectangular (scalar-subtract (real-component left) (real-component right))
                          (scalar-subtract (imaginary-component left) (imaginary-component right))))
    (: number-multiply (-> Number Number Number))
    (define (number-multiply left right)
      (let ((a (real-component left)) (b (imaginary-component left))
            (c (real-component right)) (d (imaginary-component right)))
        (if (not (or (complex-representation? left) (complex-representation? right)))
            (number-from-scalar (scalar-multiply a c))
            (number-rectangular (scalar-subtract (scalar-multiply a c) (scalar-multiply b d))
                                (scalar-add (scalar-multiply a d) (scalar-multiply b c))))))
    (: number-divide (-> Number Number Number))
    (define (number-divide left right)
      (let ((a (real-component left)) (b (imaginary-component left))
            (c (real-component right)) (d (imaginary-component right)))
        (if (not (or (complex-representation? left) (complex-representation? right)))
            (number-from-scalar (scalar-divide a c))
            (let ((divisor (scalar-add (scalar-multiply c c) (scalar-multiply d d))))
              (number-rectangular
               (scalar-divide (scalar-add (scalar-multiply a c) (scalar-multiply b d)) divisor)
               (scalar-divide (scalar-subtract (scalar-multiply b c) (scalar-multiply a d)) divisor))))))

    ;; ---- Exact comparisons never round an operand to make it equal ----

    ;; Order is -1, 0, 1, or 2 for unordered NaN. Finite mixed comparisons
    ;; compare the exact dyadic float value against the exact rational operand.
    (: scalar-nan? (-> Scalar Bool))
    (define (scalar-nan? value)
      (match value ((exact-scalar value) #f) ((rational-scalar value) #f)
             ((inexact-scalar value) (not (= value value)))))
    (: scalar-order (-> Scalar Scalar I64))
    (define (scalar-order left right)
      (if (or (scalar-nan? left) (scalar-nan? right)) 2
          (if (and (scalar-finite? left) (scalar-finite? right))
              (rational-compare (scalar->rational left) (scalar->rational right))
              (let ((a (scalar->f64 left)) (b (scalar->f64 right)))
                (if (< a b) -1 (if (> a b) 1
                                   (if (scalar-finite? left) (if (< b 0.0) 1 -1)
                                       (if (scalar-finite? right) (if (< a 0.0) -1 1) 0))))))))
    (: number=? (-> Number Number Bool))
    (define (number=? left right)
      (and (= (scalar-order (real-component left) (real-component right)) 0)
           (= (scalar-order (imaginary-component left) (imaginary-component right)) 0)))
    (: number<? (-> Number Number Bool))
    (define (number<? left right) (= (scalar-order (real-value left) (real-value right)) -1))
    (: number>? (-> Number Number Bool))
    (define (number>? left right) (= (scalar-order (real-value left) (real-value right)) 1))
    (: number<=? (-> Number Number Bool))
    (define (number<=? left right)
      (let ((order (scalar-order (real-value left) (real-value right)))) (or (= order -1) (= order 0))))
    (: number>=? (-> Number Number Bool))
    (define (number>=? left right)
      (let ((order (scalar-order (real-value left) (real-value right)))) (or (= order 1) (= order 0))))
    (: number-negative? (-> Number Bool))
    (define (number-negative? value) (number<? value (exact-number 0)))
    (: number-abs (-> Number Number))
    (define (number-abs value)
      (number-from-scalar
       (match (real-value value) ((exact-scalar value) (scalar-from-rational (rational-abs (scalar->rational (exact-scalar value)))))
              ((rational-scalar value) (scalar-from-rational (rational-abs value)))
              ((inexact-scalar value) (inexact-scalar (if (<= value 0.0) (- 0.0 value) value))))))

    ;; Equivalence retains exactness, complex shape and binary64 zero signs.
    (define-extern real-equivalent "snail.library" "snail:datum/real-equivalent" (-> F64 F64 I32))
    (: scalar-equivalent? (-> Scalar Scalar Bool))
    (define (scalar-equivalent? left right)
      (match left
        ((exact-scalar value)
         (match right ((exact-scalar other) (= value other)) ((inexact-scalar other) #f)
                ((rational-scalar other) (rational=? (scalar->rational left) other))))
        ((rational-scalar value) (and (scalar-exact? right) (rational=? value (scalar->rational right))))
        ((inexact-scalar value)
         (match right ((exact-scalar other) #f) ((rational-scalar other) #f)
                ((inexact-scalar other) (i32-eq (real-equivalent value other) (ann 1 I32)))))))
    (: number-equivalent? (-> Number Number Bool))
    (define (number-equivalent? left right)
      ;; Existing I64/F64 leaves compare directly. Arbitrary exact components
      ;; use normalized fractions; no numeric projection allocates a wrapper.
      (match left
        ((exact-number value)
         (match right ((exact-number other) (= value other)) ((inexact-number other) #f)
                ((complex-number real imaginary) #f)
                ((rational-number other) (rational=? (rational-from-integer (integer-from-i64 value)) other))))
        ((rational-number value)
         (and (not (complex-representation? right)) (number-exact? right) (rational=? value (number->rational right))))
        ((inexact-number value)
         (match right ((exact-number other) #f) ((rational-number other) #f) ((complex-number real imaginary) #f)
                ((inexact-number other) (i32-eq (real-equivalent value other) (ann 1 I32)))))
        ((complex-number real imaginary)
         (match right ((exact-number other) #f) ((rational-number other) #f) ((inexact-number other) #f)
                ((complex-number other-real other-imaginary)
                 (and (scalar-equivalent? real other-real) (scalar-equivalent? imaginary other-imaginary)))))))

    ;; ---- Canonical decimal formatting and scalar-only Rust text handles ----

    ;; Work with a nonpositive magnitude so the minimum I64 needs no positive
    ;; counterpart. Each remainder lies in [-9,0]; negating that digit is safe.
    (: decimal-digits (-> I64 I64))
    (define (decimal-digits value)
      (let loop ((value value) (count 1))
        (if (> value -10) count (loop (quotient value 10) (+ count 1)))))
    (: i64->string (-> I64 String))
    (define (i64->string value)
      (let* ((negative (< value 0)) (magnitude (if negative value (- 0 value)))
             (count (+ (decimal-digits magnitude) (if negative 1 0)))
             (text (make-string count)))
        (when negative (string-set! text 0 #\-))
        (let loop ((remaining magnitude) (index (- count 1)))
          (string-set! text index (integer->char (- 48 (remainder remaining 10))))
          (if (> remaining -10) text (loop (quotient remaining 10) (- index 1))))))

    (define-extern real-text "snail.library" "snail:datum/real-text" (-> F64 I32))
    (define-extern text-length "snail.library" "snail:datum/token-text-length" (-> I32 I32))
    (define-extern text-character "snail.library" "snail:datum/token-text-character" (-> I32 I32 Char))
    (define-extern text-close "snail.library" "snail:datum/token-close" (-> I32 Unit))
    (: f64->string (-> F64 String))
    (define (f64->string value)
      (let* ((handle (real-text value)) (count (i32->i64 (text-length handle))) (result (make-string count)))
        ;; No callback runs while the Rust text handle is owned. Trap cleanup
        ;; releases it; the ordinary path copies every scalar then closes once.
        (let loop ((at 0))
          (if (= at count) (begin (text-close handle) result)
              (begin (string-set! result at (text-character handle (i64->i32 at))) (loop (+ at 1)))))))
    (: scalar->string (-> Scalar String))
    (define (scalar->string value)
      (match value ((exact-scalar value) (i64->string value))
             ((rational-scalar value) (rational->string value)) ((inexact-scalar value) (f64->string value))))
    (: number->string (-> Number String))
    (define (number->string value)
      (let ((real (scalar->string (real-component value))))
        (if (not (complex-representation? value)) real
            (let* ((imaginary (scalar->string (imaginary-component value))) (first (string-ref imaginary 0)))
              (string-append real (if (or (char=? first #\+) (char=? first #\-)) "" "+") imaginary "i")))))

    ;; ---- Static operator families ----

    (define-overload + (-> Number Number Number) number-add)
    (define-overload - (-> Number Number Number) number-subtract)
    (define-overload - (-> Number Number) number-negate)
    (define-overload * (-> Number Number Number) number-multiply)
    (define-overload / (-> Number Number Number) number-divide)
    (define-overload = (-> Number Number Bool) number=?)
    (define-overload < (-> Number Number Bool) number<?)
    (define-overload <= (-> Number Number Bool) number<=?)
    (define-overload > (-> Number Number Bool) number>?)
    (define-overload >= (-> Number Number Bool) number>=?)
    (define-overload truncate (-> Number Number) number-truncate))

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-number)
    (begin
      (define (test-number)
        (let* ((minimum (exact-number -9223372036854775808))
               (positive (number-divide minimum (exact-number -1)))
               (third (number-from-rational (make-rational (integer-from-i64 1) (integer-from-i64 3)))))
          (unless (and (string=? (number->string positive) "9223372036854775808")
                       (number=? (number-negate minimum) positive)
                       (number>? third (inexact-number (/ 1.0 3.0)))
                       (number-exact? (number-add third third))
                       (not (number-equivalent? (inexact-number 0.0) (inexact-number (* -1.0 0.0)))))
            (unreachable))
          42))))))
