;; Incremental typed datum input. Rust owns UTF-8 decoding and port lookahead;
;; Scheme owns tokens, syntax, mutable pair fields and every returned datum.
(define-library (snail read)
  (export ReadResult read read-end read-value read-error read-end?
          read-value-datum read-error-message read-value!)
  (import (snail strict) (snail io) (snail datum) (snail bytes))
  (begin

    ;; Exhaustive source dispatch uses a private Boolean conditional macro.
    (define-syntax cond
      (syntax-rules (else)
        ((_ (else body ...)) (begin body ...))
        ((_ (test body ...) rest ...) (if test (begin body ...) (cond rest ...)))))

    ;; ---- A datum, normal EOF and malformed input are distinct results ----

    (define-data ReadResult (read-end)
      (read-value (datum Datum read-value-datum))
      (read-error (message String read-error-message)))
    (define-data Token (value-token (datum Datum)) (end-token) (close-token) (dot-token)
      (open-token (kind I64)) (prefix-token (name String)) (error-token (message String)))
    (define-data TextResult (text-value (text String)) (text-error (message String)))
    (define-data Escape (escaped-character (value Char)) (escaped-gap) (escape-error (message String)))
    (: read-end? (-> ReadResult Bool))
    (define (read-end? result)
      (match result ((read-end) #t) ((read-value value) #f) ((read-error message) #f)))
    (: read-value! (-> ReadResult Datum))
    (define (read-value! result)
      (match result ((read-value value) value)
             ((read-end) (datum-fail "read: expected a datum, received end of file"))
             ((read-error message) (datum-fail (string-append "read: " message)))))
    (: read (-> InputPort ReadResult))
    (define (read port) (token-datum port (next-token port)))

    ;; ---- Port lookahead survives every reader invocation ----

    (define-extern raw-whitespace "snail.library" "snail:datum/whitespace" (-> Char I32))
    (: character-code (-> CharacterResult I64))
    (define (character-code result)
      (match result ((character-end) -1) ((character-value value) (char->integer value))))
    (: peek-code (-> InputPort I64))
    (define (peek-code port) (character-code (peek-char port)))
    (: take-code (-> InputPort I64))
    (define (take-code port) (character-code (read-char port)))
    (: code=? (-> I64 Char Bool))
    (define (code=? code character) (= code (char->integer character)))
    (: take-if (-> InputPort Char Bool))
    (define (take-if port character)
      (if (code=? (peek-code port) character) (begin (read-char port) #t) #f))
    (: whitespace? (-> I64 Bool))
    (define (whitespace? code)
      (and (>= code 0) (i32-eq (raw-whitespace (integer->char code)) (ann 1 I32))))
    (: delimiter? (-> I64 Bool))
    (define (delimiter? code)
      (or (< code 0) (whitespace? code)
          (let ((delimiters "()\";|'`,[]{}"))
            (let loop ((index 0))
              (and (< index (string-length delimiters))
                   (or (code=? code (string-ref delimiters index)) (loop (+ index 1))))))))

    ;; ---- A geometrically growing Unicode token buffer ----

    (define-data Buffer (buffer (text (Ref String) buffer-text) (count (Ref I64) buffer-count)))
    (: new-buffer (-> Buffer))
    (define (new-buffer) (buffer (ref (make-string 32)) (ref 0)))
    (: append-character! (-> Buffer Char Unit))
    (define (append-character! buffer character)
      (let ((count (ref-get (buffer-count buffer))))
        (when (= count (string-length (ref-get (buffer-text buffer)))) (grow-buffer! buffer count))
        (string-set! (ref-get (buffer-text buffer)) count character)
        (ref-set! (buffer-count buffer) (+ count 1))))
    (: grow-buffer! (-> Buffer I64 Unit))
    (define (grow-buffer! buffer count)
      (if (>= count 4294967294) (datum-fail "read: token exceeds String capacity")
          (let* ((size (if (> count 2147483647) 4294967294 (* count 2)))
                 (grown (make-string size)))
            (string-copy! grown 0 (ref-get (buffer-text buffer)) 0 count)
            (ref-set! (buffer-text buffer) grown))))
    (: buffer-string (-> Buffer String))
    (define (buffer-string buffer)
      (substring (ref-get (buffer-text buffer)) 0 (ref-get (buffer-count buffer))))
    (: read-word (-> InputPort I64 String))
    (define (read-word port first)
      (let ((buffer (new-buffer)))
        (append-character! buffer (integer->char first))
        (let loop ()
          (if (delimiter? (peek-code port)) (buffer-string buffer)
              (begin (append-character! buffer (integer->char (take-code port))) (loop))))))
    (: ascii-lower (-> String String))
    (define (ascii-lower text)
      (let ((result (string-copy text)))
        (let loop ((index 0))
          (if (= index (string-length result)) result
              (let ((code (char->integer (string-ref result index))))
                (when (and (>= code 65) (<= code 90))
                  (string-set! result index (integer->char (+ code 32))))
                (loop (+ index 1)))))))

    ;; ---- Layout includes complete, recursively parsed datum comments ----

    (: skip-line (-> InputPort Unit))
    (define (skip-line port)
      (let ((code (take-code port)))
        (unless (or (< code 0) (code=? code #\newline) (code=? code #\return)) (skip-line port))))
    (: skip-block (-> InputPort I64 Bool))
    (define (skip-block port depth)
      (let ((code (take-code port)))
        (if (< code 0) #f
            (if (and (code=? code #\#) (take-if port #\|)) (skip-block port (+ depth 1))
                (if (and (code=? code #\|) (take-if port #\#))
                    (or (= depth 1) (skip-block port (- depth 1)))
                    (skip-block port depth))))))
    (: discard-datum (-> InputPort Token))
    (define (discard-datum port)
      (match (read port)
        ((read-value value) (next-token port))
        ((read-end) (error-token "datum comment requires a datum"))
        ((read-error message) (error-token message))))
    (: next-token (-> InputPort Token))
    (define (next-token port)
      (let ((code (take-code port)))
        (if (< code 0) (end-token)
            (if (whitespace? code) (next-token port)
                (if (code=? code #\;) (begin (skip-line port) (next-token port))
                    (ordinary-token port code))))))

    ;; ---- Token dispatch exposes all supported syntax in one place ----

    (: ordinary-token (-> InputPort I64 Token))
    (define (ordinary-token port code)
      (cond
       ((code=? code #\() (open-token 0))
       ((code=? code #\)) (close-token))
       ((code=? code #\') (prefix-token "quote"))
       ((code=? code #\`) (prefix-token "quasiquote"))
       ((code=? code #\,) (prefix-token (if (take-if port #\@) "unquote-splicing" "unquote")))
       ((code=? code #\") (quoted-token port #\" #f))
       ((code=? code #\|) (quoted-token port #\| #t))
       ((code=? code #\#) (sharp-token port))
       ((or (code=? code #\[) (code=? code #\]) (code=? code #\{) (code=? code #\}))
        (error-token "unsupported datum delimiter"))
       (else (atom-token (read-word port code)))))
    (: sharp-token (-> InputPort Token))
    (define (sharp-token port)
      (let ((code (take-code port)))
        (cond
         ((< code 0) (error-token "incomplete # syntax"))
         ((code=? code #\() (open-token 1))
         ((code=? code #\;) (discard-datum port))
         ((code=? code #\|)
          (if (skip-block port 1) (next-token port) (error-token "unterminated block comment")))
         ((code=? code #\\) (character-token port))
         ((or (code=? code #\u) (code=? code #\U)) (bytevector-token port))
         ((code=? code #\!) (error-token "reader case directives are not supported"))
         ((and (>= code 48) (<= code 57)) (error-token "datum labels are not supported"))
         (else (sharp-word (string-append "#" (read-word port code)))))))
    (: bytevector-token (-> InputPort Token))
    (define (bytevector-token port)
      (if (and (take-if port #\8) (take-if port #\()) (open-token 2)
          (error-token "expected #u8( bytevector syntax")))
    (: sharp-word (-> String Token))
    (define (sharp-word text)
      (let ((folded (ascii-lower text)))
        (if (or (string=? folded "#t") (string=? folded "#true")) (value-token (datum-boolean #t))
            (if (or (string=? folded "#f") (string=? folded "#false")) (value-token (datum-boolean #f))
                (match (string->number text)
                  ((parsed-number number) (value-token (datum-number number)))
                  ((number-error message) (error-token message))
                  ((not-a-number) (error-token "invalid or unsupported # numeric syntax")))))))
    (: atom-token (-> String Token))
    (define (atom-token text)
      (if (string=? text ".") (dot-token)
          (match (string->number text)
            ((parsed-number number) (value-token (datum-number number)))
            ((number-error message) (error-token message))
            ((not-a-number)
             (if (identifier? text) (value-token (datum-symbol (string->symbol text)))
                 (error-token "invalid numeric token or identifier; rational numbers are not supported"))))))

    ;; ---- Strings and escaped symbols share scalar escapes ----

    (: quoted-token (-> InputPort Char Bool Token))
    (define (quoted-token port end symbol?)
      (match (read-text port end)
        ((text-value text) (value-token (if symbol? (datum-symbol (string->symbol text)) (datum-string text))))
        ((text-error message) (error-token message))))
    (: read-text (-> InputPort Char TextResult))
    (define (read-text port end) (text-loop port end (new-buffer)))
    (: text-loop (-> InputPort Char Buffer TextResult))
    (define (text-loop port end buffer)
      (let ((code (take-code port)))
        (if (< code 0) (text-error "unterminated string or escaped symbol")
            (if (code=? code end) (text-value (buffer-string buffer))
                (if (code=? code #\\) (continue-escape port end buffer (read-escape port end))
                    (begin
                      (append-character! buffer (text-character port end code))
                      (text-loop port end buffer)))))))
    (: text-character (-> InputPort Char I64 Char))
    (define (text-character port end code)
      (if (and (char=? end #\") (code=? code #\return))
          (begin (take-if port #\newline) #\newline) (integer->char code)))
    (: continue-escape (-> InputPort Char Buffer Escape TextResult))
    (define (continue-escape port end buffer escape)
      (match escape
        ((escaped-character value) (append-character! buffer value) (text-loop port end buffer))
        ((escaped-gap) (text-loop port end buffer)) ((escape-error message) (text-error message))))
    (: read-escape (-> InputPort Char Escape))
    (define (read-escape port end)
      (let ((code (take-code port)))
        (cond
         ((code=? code #\a) (escaped-character (integer->char 7)))
         ((code=? code #\b) (escaped-character (integer->char 8)))
         ((code=? code #\t) (escaped-character #\tab))
         ((code=? code #\n) (escaped-character #\newline))
         ((code=? code #\r) (escaped-character #\return))
         ((or (code=? code #\") (code=? code #\|) (code=? code #\\))
          (escaped-character (integer->char code)))
         ((code=? code #\x) (hex-escape port 0 0))
         ((and (char=? end #\") (continuation-space? code)) (line-continuation port code))
         (else (escape-error "unknown or incomplete escape")))))
    (: continuation-space? (-> I64 Bool))
    (define (continuation-space? code)
      (or (code=? code #\space) (code=? code #\tab) (code=? code #\newline) (code=? code #\return)))
    (: skip-horizontal (-> InputPort Unit))
    (define (skip-horizontal port)
      (when (or (code=? (peek-code port) #\space) (code=? (peek-code port) #\tab))
        (read-char port) (skip-horizontal port)))
    (: line-continuation (-> InputPort I64 Escape))
    (define (line-continuation port code)
      (if (or (code=? code #\space) (code=? code #\tab)) (line-continuation port (take-code port))
          (if (or (code=? code #\newline) (code=? code #\return))
              (begin (when (code=? code #\return) (take-if port #\newline) (unit))
                     (skip-horizontal port) (escaped-gap))
              (escape-error "expected newline in string continuation"))))

    ;; ---- Hexadecimal escapes validate Unicode before constructing Char ----

    (: hex-digit (-> I64 I64))
    (define (hex-digit code)
      (if (and (>= code 48) (<= code 57)) (- code 48)
          (if (and (>= code 65) (<= code 70)) (- code 55)
              (if (and (>= code 97) (<= code 102)) (- code 87) -1))))
    (: unicode-scalar? (-> I64 Bool))
    (define (unicode-scalar? value)
      (and (>= value 0) (<= value 1114111) (or (< value 55296) (> value 57343))))
    (: finish-hex (-> I64 I64 Escape))
    (define (finish-hex value count)
      (if (and (> count 0) (unicode-scalar? value)) (escaped-character (integer->char value))
          (escape-error "invalid Unicode scalar escape")))
    (: hex-escape (-> InputPort I64 I64 Escape))
    (define (hex-escape port value count)
      (let ((code (take-code port)))
        (if (code=? code #\;) (finish-hex value count)
            (let ((digit (hex-digit code)))
              (if (or (< digit 0) (> value 69631)) (escape-error "invalid hexadecimal escape")
                  (hex-escape port (+ (* value 16) digit) (+ count 1)))))))
    (: hex-character (-> String Escape))
    (define (hex-character text)
      (let loop ((index 1) (value 0))
        (if (= index (string-length text)) (finish-hex value (- index 1))
            (let ((digit (hex-digit (char->integer (string-ref text index)))))
              (if (or (< digit 0) (> value 69631)) (escape-error "invalid character code")
                  (loop (+ index 1) (+ (* value 16) digit)))))))

    ;; ---- Character literals can contain a delimiter as their one scalar ----

    (: character-token (-> InputPort Token))
    (define (character-token port)
      (let ((code (take-code port)))
        (if (< code 0) (error-token "incomplete character literal")
            (if (delimiter? code) (value-token (datum-character (integer->char code)))
                (named-character-token (read-word port code))))))
    (: named-character-token (-> String Token))
    (define (named-character-token text)
      (if (= (string-length text) 1) (value-token (datum-character (string-ref text 0)))
          (match (named-character (ascii-lower text))
            ((escaped-character value) (value-token (datum-character value)))
            ((escape-error message) (error-token message)) ((escaped-gap) (unreachable)))))
    (: named-character (-> String Escape))
    (define (named-character text)
      (cond
       ((string=? text "alarm") (escaped-character (integer->char 7)))
       ((string=? text "backspace") (escaped-character (integer->char 8)))
       ((string=? text "delete") (escaped-character (integer->char 127)))
       ((string=? text "escape") (escaped-character (integer->char 27)))
       ((string=? text "newline") (escaped-character #\newline))
       ((string=? text "null") (escaped-character (integer->char 0)))
       ((string=? text "return") (escaped-character #\return))
       ((string=? text "space") (escaped-character #\space))
       ((string=? text "tab") (escaped-character #\tab))
       ((char=? (string-ref text 0) #\x) (hex-character text))
       (else (escape-error "unknown character literal"))))

    ;; ---- Containers preserve source order and dotted-tail structure ----

    (: token-datum (-> InputPort Token ReadResult))
    (define (token-datum port token)
      (match token
        ((value-token value) (read-value value)) ((end-token) (read-end))
        ((error-token message) (read-error message))
        ((open-token kind) (container-loop port kind '()))
        ((prefix-token name) (prefix-datum port name))
        ((close-token) (read-error "unexpected closing parenthesis"))
        ((dot-token) (read-error "unexpected dot"))))
    (: prefix-datum (-> InputPort String ReadResult))
    (define (prefix-datum port name)
      (match (read port)
        ((read-value value) (read-value (datum-cons (datum-symbol (string->symbol name))
                                                    (datum-cons value (datum-null)))))
        ((read-end) (read-error "quote abbreviation requires a datum"))
        ((read-error message) (read-error message))))
    (: container-loop (-> InputPort I64 (List Datum) ReadResult))
    (define (container-loop port kind reversed)
      (let ((token (next-token port)))
        (match token
          ((close-token) (finish-container kind reversed))
          ((end-token) (read-error "unexpected end of input inside container"))
          ((dot-token) (if (and (= kind 0) (not (null? reversed))) (dotted-tail port reversed)
                           (read-error "dot requires a preceding list element")))
          ((error-token message) (read-error message))
          ((value-token value) (container-loop port kind (cons value reversed)))
          ((open-token nested-kind) (container-element port kind reversed (token-datum port token)))
          ((prefix-token name) (container-element port kind reversed (token-datum port token))))))
    (: container-element (-> InputPort I64 (List Datum) ReadResult ReadResult))
    (define (container-element port kind reversed result)
      (match result
        ((read-value value) (container-loop port kind (cons value reversed)))
        ((read-error message) (read-error message)) ((read-end) (unreachable))))
    (: dotted-tail (-> InputPort (List Datum) ReadResult))
    (define (dotted-tail port reversed)
      (match (read port)
        ((read-value tail) (match (next-token port)
                             ((close-token) (read-value (attach-reversed reversed tail)))
                             ((error-token message) (read-error message))
                             ((value-token value) (read-error "extra datum after dotted tail"))
                             ((end-token) (read-error "unclosed dotted list"))
                             ((dot-token) (read-error "extra dot after dotted tail"))
                             ((open-token kind) (read-error "extra container after dotted tail"))
                             ((prefix-token name) (read-error "extra abbreviation after dotted tail"))))
        ((read-end) (read-error "missing dotted tail"))
        ((read-error message) (read-error message))))
    (: attach-reversed (-> (List Datum) Datum Datum))
    (define (attach-reversed reversed tail)
      (if (null? reversed) tail
          (attach-reversed (cdr reversed) (datum-cons (car reversed) tail))))
    (: reverse-elements (-> (List Datum) (List Datum)))
    (define (reverse-elements elements)
      (let loop ((elements elements) (result '()))
        (if (null? elements) result (loop (cdr elements) (cons (car elements) result)))))
    (: finish-container (-> I64 (List Datum) ReadResult))
    (define (finish-container kind reversed)
      (if (= kind 0) (read-value (attach-reversed reversed (datum-null)))
          (if (= kind 1) (read-value (datum-vector (list->vector (reverse-elements reversed))))
              (finish-bytes reversed))))
    (: finish-bytes (-> (List Datum) ReadResult))
    (define (finish-bytes reversed)
      (let ((count (let loop ((tail reversed) (count 0))
                     (if (null? tail) count (loop (cdr tail) (+ count 1))))))
        (fill-bytes reversed (make-bytevector count) count)))
    (: byte-value (-> Datum I64))
    (define (byte-value value)
      (if (datum-number? value)
          (match (datum-number-value value) ((exact-number value) value)
                 ((inexact-number value) -1) ((complex-number real imaginary) -1)) -1))
    (: fill-bytes (-> (List Datum) Bytevector I64 ReadResult))
    (define (fill-bytes reversed result index)
      (if (null? reversed) (read-value (datum-bytevector result))
          (let ((value (byte-value (car reversed))))
            (if (or (< value 0) (> value 255)) (read-error "bytevector requires exact bytes in [0,255]")
                (begin (bytevector-u8-set! result (- index 1) value)
                       (fill-bytes (cdr reversed) result (- index 1)))))))))
