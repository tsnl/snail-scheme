;; PNG files and data URLs of top-to-bottom RGBA texels. Stored zlib blocks
;; make the encoder deterministic and allow a full frame to be copied by row.
(define-library (snail shell png)
  (export rgba->png png-data-url)
  (import
   (snail core base)
   (snail shell base64)
   (only (snail shell zip) crc32))
  (begin
    (define (word (n I64)) (→ Bytes)
      (array-generate 4
                      (lambda (i) (i32->u8 (i64->i32 (i64-shift-right/logical n (* 8 (- 3 i))))))))
    (define (chunk (name String) (data Bytes)) (→ Bytes)
      (let ((typed
             (array-append (array-map (lambda (c) (i32->u8 (char->i32 c))) (string->array name))
                           data)))
        (array-concatenate (list (word (array-length data)) typed (word (crc32 typed))))))
    (define (scanlines (row I64) (height I64) (pixels Bytes)) (→ Bytes)
      (let ((out (make-array (* (+ row 1) height) (i32->u8 0))))
        (for-each (lambda (y) (array-copy! out (+ (* y (+ 1 row)) 1) pixels (* y row) row))
                  (iota height))
        out))
    (define (adler32 (bytes Bytes)) (→ I64)
      (let loop ((i 0) (a 1) (b 0))
        (if (= i (array-length bytes)) (+ (* b 65536) a)
            (let ((next (modulo (+ a (i32->i64 (u8->i32 (array-ref bytes i)))) 65521)))
              (loop (+ i 1) next (modulo (+ b next) 65521))))))
    (define (little-half! (out Bytes) (at I64) (n I64)) (→ Unit)
      (array-set! out at (i32->u8 (i64->i32 n)))
      (array-set! out (+ at 1) (i32->u8 (i64->i32 (quotient n 256)))))
    (define (stored (data Bytes)) (→ Bytes)
      (let* ((n (array-length data)) (blocks (quotient (+ n 65534) 65535))
             (out (make-array (+ 6 (+ n (* 5 blocks))) (i32->u8 0))))
        (array-set! out 0 (i32->u8 120)) (array-set! out 1 (i32->u8 1))
        (let loop ((i 0) (at 2))
          (let ((k (min 65535 (- n i))))
            (array-set! out at (i32->u8 (if (= (+ i k) n) 1 0)))
            (little-half! out (+ at 1) k) (little-half! out (+ at 3) (- 65535 k))
            (array-copy! out (+ at 5) data i k)
            (if (= (+ i k) n) (array-copy! out (+ (+ at 5) k) (word (adler32 data)) 0 4)
                (loop (+ i k) (+ (+ at 5) k)))))
        out))
    (define (rgba->png (width I32) (height I32) (pixels Bytes)) (→ Bytes)
      (let ((row (* 4 (i32->i64 width))) (h (i32->i64 height)))
        (unless (and (> row 0) (> h 0) (= (* row h) (array-length pixels)))
          (panic "invalid PNG dimensions"))
        (array-concatenate
         (list (list->array (list 137 80 78 71 13 10 26 10))
               (chunk "IHDR" (array-concatenate (list (word (i32->i64 width)) (word h)
                                                      (list->array (list 8 6 0 0 0)))))
               (chunk "IDAT" (stored (scanlines row h pixels)))
               (chunk "IEND" (make-array 0 (i32->u8 0)))))))
    (define (png-data-url (png Bytes)) (→ String) (data-url "image/png" png))))
