;; Pixel-snapped orthographic sprites and their lazily composed image pages.
(define-library (snail shell graphics renderer sprites)
  (export SpriteScene
          make-sprite-scene
          release-sprites!
          release-sprite-context!
          sprite-pictures!
          restore-picture!
          sprite-frame!)
  (import
   (snail core base)
   (snail core io)
   (snail shell wire)
   (snail shell json)
   (snail shell gpu)
   (snail shell graphics api-trace)
   (snail shell graphics pod)
   (snail shell graphics atlas)
   (snail shell graphics quad)
   (snail shell graphics forward frame)
   (snail shell graphics compositor)
   (only (snail shell graphics raster) Plane release-plane)
   (only (snail shell graphics still) read-region))
  (begin
    (record SpriteScene
      ((atlas Atlas)
       (quads Quads)
       (output Plane)
       (width I32)
       (height I32)))
    (define (make-sprite-scene (gpu Gpu) (size I32) (layers I32)) (→ SpriteScene)
      (let ((a (make-atlas gpu "sprites" size layers)))
        (new SpriteScene (atlas a) (quads (make-quads gpu "sprites" (Rgba8Unorm) (● a texture)))
             (output (display-plane gpu 1 1)) (width 1) (height 1))))
    (define (release-sprites! (gpu Gpu) (s SpriteScene)) (→ Unit)
      (release-plane gpu (● s output)) (release-sprite-context! gpu s))
    (define (release-sprite-context! (gpu Gpu) (s SpriteScene)) (→ Unit)
      (release-quads gpu (● s quads)) (release-atlas gpu (● s atlas)))
    (define (region (a Atlas) (page I32) (x I32) (y I32)) (→ TextureCopy)
      (new TextureCopy (texture (● a texture)) (mip 0) (layer page) (x x) (y y)))
    (define (int-field (name String) (n I32))
      (→ (Pair String Json))
      (trace-field name (JsonInteger (i32->i64 n))))
    (define (capture-picture! (gpu Gpu) (out OutputPort) (atlas Atlas) (key I32) (cleared Bool))
      (→ Unit)
      (match (atlas-slot atlas key)
        ((Some slot)
         (let ((w (● slot width))
               (h (● slot height))
               (page (● slot page))
               (x (● slot x))
               (y (● slot y)))
           (write-command! out
                           "updateAtlas"
                           (trace-object (list (trace-field "clear" (JsonBool cleared))
                                               (int-field "page" page)
                                               (int-field "x" x)
                                               (int-field "y" y)
                                               (int-field "width" w)
                                               (int-field "height" h)))
                           (list (read-region gpu (region atlas page x y) w h 4)))))
        ((None) (panic "missing composed sprite"))))
    (define (sprite-pictures! (gpu Gpu)
                              (s SpriteScene)
                              (pictures (List Picture))
                              (out (Option OutputPort)))
      (→ Atlas)
      (let ((a (● s atlas)))
        (match (next-picture a pictures)
          ((None) a)
          ((Some pic)
           (let* ((enc ((● gpu create-command-encoder)))
                  (updated (compose-picture! gpu a enc pic))
                  (next (● updated second)))
             ((● gpu submit) (list ((● gpu finish) enc))) (set! (● s atlas) next)
             (match out
               ((Some port) (capture-picture! gpu port next (● pic key) (● updated first)))
               ((None) (unit)))
             next)))))
    (define (clear-atlas! (gpu Gpu) (atlas Atlas)) (→ Unit)
      (let ((enc ((● gpu create-command-encoder)))
            (clear (new Color (red 0.0) (green 0.0) (blue 0.0) (alpha 0.0))))
        (for-each (lambda (i)
                    (let ((v (layer-view gpu (● atlas texture) (i64->i32 i))))
                      ((● gpu end-pass) (begin-forward-pass gpu enc v (None) clear (None)))
                      ((● gpu destroy) (ViewObject v)))) (iota (i32->i64 (● atlas pages))))
        ((● gpu submit) (list ((● gpu finish) enc)))))
    (define (restore-picture! (gpu Gpu) (s SpriteScene) (cmd ApiCommand)) (→ Unit)
      (let* ((a (● s atlas))
             (args (● cmd args))
             (get (lambda ((k String)) (→ I32) (i64->i32 (trace-int (trace-member args k)))))
             (page (get "page"))
             (x (get "x"))
             (y (get "y"))
             (w (get "width"))
             (h (get "height"))
             (bytes (command-block cmd 0)))
        (unless (and (>= page 0) (< page (● a pages)) (>= x 0) (>= y 0) (> w 0) (> h 0)
                     (<= (i32->i64 x) (- (i32->i64 (● a size)) (i32->i64 w)))
                     (<= (i32->i64 y) (- (i32->i64 (● a size)) (i32->i64 h)))
                     (= (array-length bytes) (* 4 (* (i32->i64 w) (i32->i64 h)))))
          (panic "invalid sprite atlas rectangle"))
        (match (trace-member args "clear")
          ((JsonBool clear) (when clear (clear-atlas! gpu a)))
          (_ (panic "invalid atlas clear")))
        ((● gpu write-texture) (region a page x y) (* 4 w) w h bytes)))
    (define (sprite-frame! (gpu Gpu) (enc GpuCommandEncoder)
                           (s SpriteScene)
                           (bg I32)
                           (view View2D)
                           (quads (List Quad))
                           (w I32)
                           (h I32))
      (→ Plane)
      (unless (and (= w (● s width)) (= h (● s height)))
        (release-plane gpu (● s output)) (set! (● s output) (display-plane gpu w h))
        (set! (● s width) w) (set! (● s height) h))
      (let* ((pass (begin-forward-pass gpu enc (● s output view) (None) (rgb-color bg) (None)))
             (pixels (new Vec2f (x (i32->f32 w)) (y (i32->f32 h)))))
        (set! (● s quads) (draw-quads gpu pass (● s quads) (View2D-pixels-set view pixels) quads))
        ((● gpu end-pass) pass) (● s output)))))
