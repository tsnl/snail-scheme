;; Camera and light values remain readable in a JSONL trace.
(define-library (snail shell graphics renderer camera)
  (export frame-json json-frame v3-json json-v3 v4-json json-v4 matrix-json json-matrix)
  (import
   (snail core base)
   (snail shell json)
   (snail shell graphics api-trace)
   (snail shell graphics pod)
   (only (snail shell game rigid-body) V3 v3)
   (only (snail shell graphics animation) v4)
   (only (snail shell graphics raster) Camera3D)
   (only (snail shell graphics forward render)
         Shading
         BlinnPhong
         MetallicRoughness
         DirectionalLight)
   (only (snail shell graphics scene) SceneFrame))
  (begin
    (define (number-value (j Json)) (→ F64)
      (match j
        ((JsonNumber n) n)
        ((JsonInteger n) (i64->f64 n))
        (_ (panic "expected a numeric renderer field"))))
    (define (real32 (j Json)) (→ F32) (f64->f32 (number-value j)))
    (define (float-json (v F32)) (→ Json) (JsonNumber (f32->f64 v)))
    (define (values-of (j Json) (n I64)) (→ (List Json))
      (let ((a (trace-array j)))
        (unless (= (length a) n) (panic "invalid renderer vector length"))
        a))
    (define (v3-json (v V3)) (→ Json) (JsonArray (map JsonNumber (list (● v x) (● v y) (● v z)))))
    (define (json-v3 (v Json)) (→ V3)
      (let ((a (map number-value (values-of v 3))))
        (v3 (list-ref a 0) (list-ref a 1) (list-ref a 2))))
    (define (v4-json (v Vec4f))
      (→ Json)
      (JsonArray (map float-json (list (● v x) (● v y) (● v z) (● v w)))))
    (define (json-v4 (v Json)) (→ Vec4f)
      (let ((a (map real32 (values-of v 4))))
        (v4 (list-ref a 0) (list-ref a 1) (list-ref a 2) (list-ref a 3))))
    (define (matrix-json (m Mat4x4f)) (→ Json)
      (JsonArray (map v4-json (list (● m x) (● m y) (● m z) (● m w)))))
    (define (json-matrix (j Json)) (→ Mat4x4f)
      (let ((a (map json-v4 (values-of j 4))))
        (new Mat4x4f (x (list-ref a 0)) (y (list-ref a 1)) (z (list-ref a 2)) (w (list-ref a 3)))))
    (define (camera-json (c Camera3D)) (→ Json)
      (trace-object
       (list (trace-field "eye" (v4-json (● c eye))) (trace-field "forward" (v4-json (● c forward)))
             (trace-field "viewProjection" (matrix-json (● c view-projection)))
             (trace-field "inverse" (matrix-json (● c inverse)))
             (trace-field "previous" (matrix-json (● c previous)))
             (trace-field "time" (float-json (● c scene-time)))
             (trace-field "motion" (float-json (● c previous-motion)))
             (trace-field "heading"
                          (JsonArray (map float-json
                                          (list (● c previous-heading x)
                                                (● c previous-heading y))))))))
    (define (json-camera (j Json)) (→ Camera3D)
      (let* ((at (lambda ((key String)) (→ Json) (trace-member j key)))
             (h (map real32 (values-of (at "heading") 2))))
        (new Camera3D (eye (json-v4 (at "eye"))) (forward (json-v4 (at "forward")))
             (view-projection (json-matrix (at "viewProjection")))
             (inverse (json-matrix (at "inverse")))
             (previous (json-matrix (at "previous")))
             (scene-time (real32 (at "time")))
             (previous-motion (real32 (at "motion")))
             (previous-heading (new Vec2f (x (list-ref h 0)) (y (list-ref h 1)))))))
    (define (light-json (l DirectionalLight)) (→ Json)
      (trace-object (list (trace-field "direction" (v3-json (● l direction)))
                          (trace-field "irradiance" (v3-json (● l irradiance))))))
    (define (json-light (j Json)) (→ DirectionalLight)
      (new DirectionalLight
        (direction (json-v3 (trace-member j "direction")))
        (irradiance (json-v3 (trace-member j "irradiance")))))
    (define (frame-json (f SceneFrame)) (→ Json)
      (trace-object (list (trace-field "camera" (camera-json (● f camera)))
                          (trace-field "width" (JsonInteger (i32->i64 (● f width))))
                          (trace-field "height" (JsonInteger (i32->i64 (● f height))))
                          (trace-field "samples" (JsonInteger (i32->i64 (● f samples))))
                          (trace-field "exposure" (float-json (● f exposure)))
                          (trace-field "lights" (JsonArray (map light-json (● f lights))))
                          (trace-field "shadows" (JsonBool (● f shadows)))
                          (trace-field "shading"
                                       (JsonString (match (● f shading)
                                                     ((BlinnPhong) "blinn-phong")
                                                     (_ "pbr"))))
                          (trace-field "cascade" (JsonInteger (i32->i64 (● f cascade)))))))
    (define (json-frame (j Json)) (→ SceneFrame)
      (let ((at (lambda ((key String)) (→ Json) (trace-member j key))))
        (new SceneFrame
          (camera (json-camera (at "camera")))
          (width (i64->i32 (trace-int (at "width"))))
          (height (i64->i32 (trace-int (at "height"))))
          (samples (i64->i32 (trace-int (at "samples"))))
          (exposure (real32 (at "exposure"))) (lights (map json-light (trace-array (at "lights"))))
          (shadows (match (at "shadows") ((JsonBool b) b) (_ (panic "invalid shadow switch"))))
          (shading
           (let ((s (trace-string (at "shading")))) (cond ((string=? s "pbr") (MetallicRoughness))
                                                          ((string=? s "blinn-phong") (BlinnPhong))
                                                          (else
                                                           (panic
                                                            "unknown renderer shading model")))))
          (cascade (i64->i32 (trace-int (at "cascade")))))))))
