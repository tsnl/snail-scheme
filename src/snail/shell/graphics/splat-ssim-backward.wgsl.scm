;; SSIM's backward kernel (splat-ssim): the forward's partials and the
;; gradient of S, blurred together, into the gradient of x.
((var storage read) (@group 0) (@binding 2) (partials (array f32)))

((var storage read) (@group 0) (@binding 3) (gradient (array f32)))

((var storage read_write) (@group 0) (@binding 4) (grad (array f32)))

(fn (@compute)
    (@workgroup_size 256)
    ssim_backward
    (((@builtin workgroup_id) wid vec3u)
     ((@builtin num_workgroups) nwg vec3u)
     ((@builtin local_invocation_index) t u32))
    (if ((>= (+ (* (get wid y) (get nwg x)) (get wid x)) (* TILES_X TILES_Y)) (return)))
    (let origin (tile_origin wid nwg))
    (let px (+ (get origin x) (% t 16u)))
    (let py (+ (get origin y) (/ t 16u)))
    (for ((var c 0u) (< c CHANNELS) (+= c 1u))
         (for ((var part 0u) (< part 3u) (+= part 1u))
              (let k (+ t (* part 256u)))
              (if ((< k AREA)
                   (let cell (border_index origin k c))
                   (let g (select 0.0 (at gradient (get cell x)) (== (get cell y) 1u)))
                   (for ((var j 0u) (< j 3u) (+= j 1u))
                        (= (at tile_a (+ (* j AREA) k))
                           (* g (at partials (+ (* 3u (get cell x)) j))))))))
         (workgroupBarrier)
         (for ((var part 0u) (< part 2u) (+= part 1u))
              (let k (+ t (* part 256u)))
              (if ((< k BAND)
                   (let start (+ (* (/ k 16u) SIDE) (% k 16u)))
                   (for ((var j 0u) (< j 3u) (+= j 1u))
                        (var sum 0.0)
                        (for ((var q 0u) (< q 11u) (+= q 1u))
                             (+= sum (* (at WEIGHTS q) (at tile_a (+ (* j AREA) start q)))))
                        (= (at rows (+ (* j BAND) k)) sum)))))
         (workgroupBarrier)
         (let b1 (blurred_column t 0u))
         (let b2 (blurred_column t 1u))
         (let b3 (blurred_column t 2u))
         (if ((and (< px WIDTH) (< py HEIGHT))
              (let i (+ (* (+ (* py WIDTH) px) CHANNELS) c))
              (= (at grad i) (+ b1 (* 2.0 (at x i) b2) (* (at y i) b3)))))
         (workgroupBarrier)))
