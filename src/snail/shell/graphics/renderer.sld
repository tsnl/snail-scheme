;; The renderer owns the device context and the resources addressed by its API.
;; A trace is an observer of the same operations used by a running application.
(define-library (snail shell graphics renderer)
  (export Renderer RendererConfig make-renderer release-renderer! ModelHandle
          model-bounds
          model-counts
          create-model!
          use-model!
          delete-model!
          set-sky!
          set-sun!
          pose-model!
          model-lights! material-image! capture-material-tiles! render! present-render!
          renderer-output renderer-size renderer-forward create-scene-node!
          render-batches! create-sprite-atlas! compose-sprites! render-sprites!)
  (import
   (snail core base)
   (snail core io)
   (snail core table)
   (snail shell json)
   (snail shell wire)
   (snail shell gpu)
   (snail shell graphics api-trace)
   (snail shell graphics renderer camera)
   (snail shell graphics renderer model)
   (only (snail shell graphics renderer batches)
         Frame
         BatchState
         batch-state
         render-batch-frame!
         replay-batch-frame!
         restore-batch!
         release-batches!)
   (snail shell graphics renderer sprites)
   (only (snail shell graphics atlas) Atlas Picture)
   (only (snail shell graphics quad) Quad View2D)
   (snail shell graphics gltf)
   (snail shell graphics pod)
   (only (snail shell game rigid-body) V3)
   (only (snail shell graphics raster) Plane release-plane)
   (only (snail shell graphics passes) Tone Neutral Photographic Filmic)
   (snail shell graphics forward scene)
   (snail shell graphics forward lights)
   (snail shell graphics forward environment)
   (snail shell graphics forward render)
   (snail shell graphics compositor)
   (snail shell graphics scene)
   (only (snail shell graphics still) read-region))
  (begin
    (record ModelHandle
      ((id I64)))
    (record RenderResources
      ((models (Table ModelResource))
       (next I64)
       (sky (Option Environment))))
    (record RenderContext
      ((gpu Gpu)
       (surface-format TextureFormat)
       (compositor (Option Compositor))
       (batches BatchState)
       (sprites (Option SpriteScene))
       (active (Option I64))
       (forward (Option Forward))
       (tone Tone)
       (retained (Option Plane))
       (image (Option Plane))
       (width I32)
       (height I32)))
    (record Renderer
      ((config RendererConfig)
       (context RenderContext)
       (resources RenderResources)
       (replay (Fn InputPort (Option I64) → I64))))
    (define (make-renderer (gpu Gpu) (config RendererConfig)) (→ Renderer)
      (let ((c (new RenderContext
                 (gpu gpu)
                 (surface-format (● ((● gpu request-device)) format))
                 (compositor (None))
                 (batches (batch-state))
                 (sprites (None))
                 (active (None))
                 (forward (None))
                 (tone (Photographic))
                 (retained (None)) (image (None)) (width 0) (height 0)))
            (resources (new RenderResources (models (empty-table)) (next 1) (sky (None)))))
        (new Renderer (config config) (context c) (resources resources)
             (replay (lambda (port limit)
                       (replay-commands! port limit (lambda (cmd)
                                                      (apply-command! c resources cmd)
                                                      (match (● config trace)
                                                        ((Some out)
                                                         (write-command! out
                                                                         (● cmd op)
                                                                         (● cmd args)
                                                                         (● cmd blocks)))
                                                        (_ (unit))))))))))
    (define (get-model (res RenderResources) (id I64)) (→ ModelResource)
      (match (table-ref (● res models) (show id))
        ((Some m) m)
        (_ (panic "unknown renderer model"))))
    (define (model-bounds (r Renderer) (h ModelHandle)) (→ (Pair (List F64) (List F64)))
      (let ((m (get-model (● r resources) (● h id))))
        (new Pair (first (● m scene low)) (second (● m scene high)))))
    (define (model-counts (r Renderer) (h ModelHandle)) (→ (Pair I64 I64))
      (let ((m (get-model (● r resources) (● h id))))
        (new Pair (first (● m scene vertex-count)) (second (quotient (fold-left
                                                                      (lambda (n d)
                                                                        (+ n
                                                                           (i32->i64 (● d count))))
                                                                      0
                                                                      (● m scene draws))
                                                                     3)))))
    (define (get-sky (res RenderResources)) (→ Environment)
      (match (● res sky) ((Some sky) sky) (_ (panic "render needs an environment"))))
    (define (new-id (res RenderResources) (id I64)) (→ I64)
      (when (or (< id (● res next)) (>= id 9223372036854775807))
        (panic "invalid renderer model id"))
      id)
    (define (add-model! (res RenderResources) (id I64) (mesh ModelResource)) (→ ModelHandle)
      (set! (● res models) (table-set (● res models) (show id) mesh))
      (set! (● res next) (max (● res next) (+ id 1))) (new ModelHandle (id id)))
    (define (id-args (id I64)) (→ Json)
      (trace-object (list (trace-field "id" (JsonInteger id)))))
    (define (record-id! (config RendererConfig) (op String) (id I64)) (→ Unit)
      (match (● config trace) ((Some out) (write-command! out op (id-args id) (Nil))) (_ (unit))))
    ;; A prepared city window can share the active window's image table.
    (define (create-model! (r Renderer) (g Gltf) (read (Fn (List String) → (List Bytes)))
                           (images (Option SceneImages)) (skin (Option SkinLayout))
                           (lights (List Punctual)) (capacity I64)) (→ ModelHandle)
                           (let* ((files (match (● r config trace)
                                           ((Some _) (model-files g read))
                                           ((None)
                                            (match images
                                              ((Some _) (model-buffer-files g read))
                                              ((None) (model-files g read))))))
                                  (buffers (model-buffers g files))
                                  (mesh (make-model-resource (● r context gpu)
                                                             g
                                                             buffers
                                                             files
                                                             images
                                                             skin
                                                             lights
                                                             capacity))
                                  (id (● r resources next))
                                  (h (add-model! (● r resources) id mesh)))
                             (match (● r config trace)
                               ((Some port)
                                (let ((c (model-command id g buffers files skin lights capacity)))
                                  (write-command! port (● c op) (● c args) (● c blocks))))
                               (_ (unit)))
                             h))
    (define (create-scene-node! (r Renderer)
                                (read (Fn (List String) → (List Bytes)))
                                (node SceneNode))
      (→ ModelHandle)
      (let ((g (scene-geometry node (lambda (path) (read-model-file read path)))))
        (create-model! r (drawable g) read (None) (None) (Nil) 0)))
    (define (select-model! (c RenderContext) (res RenderResources) (id I64)) (→ Unit)
      (let ((model (get-model res id)))
        (match (● c forward)
          ((Some f) (set-scene! (● c gpu) f (● model scene))) (_ (unit)))
        (set! (● c active) (Some id))))
    (define (use-model! (r Renderer) (h ModelHandle)) (→ Unit)
      (select-model! (● r context) (● r resources) (● h id))
      (record-id! (● r config) "useModel" (● h id)))
    ;; Transfer the last displayed plane out of a retiring backend. It remains
    ;; readable after deleteModel and is freed when another frame completes.
    (define (retire-plane! (c RenderContext) (p Plane)) (→ Unit)
      (if (match (● c image) ((Some shown) (= (● p texture id) (● shown texture id))) (_ #f))
          (set! (● c retained) (Some p)) (release-plane (● c gpu) p)))
    (define (release-retained! (c RenderContext)) (→ Unit)
      (match (● c retained)
        ((Some p) (release-plane (● c gpu) p) (set! (● c retained) (None)))
        (_ (unit))))
    (define (forget-forward! (c RenderContext)) (→ Unit)
      (match (● c forward)
        ((Some f) (retire-plane! c (● f target output)) (release-forward-context (● c gpu) f))
        (_ (unit)))
      (set! (● c forward) (None)))
    (define (remove-model! (c RenderContext) (res RenderResources) (id I64)) (→ Unit)
      (let ((m (get-model res id)))
        (when (match (● c active) ((Some a) (= a id)) (_ #f))
          (forget-forward! c) (set! (● c active) (None)))
        (set! (● res models) (table-remove (● res models) (show id))) (release-model! (● c gpu) m)))
    (define (delete-model! (r Renderer) (h ModelHandle)) (→ Unit)
      (remove-model! (● r context) (● r resources) (● h id))
      (record-id! (● r config) "deleteModel" (● h id)))

    ;; Environment bytes include the prefiltered specular cube and diffuse irradiance.
    (define (tone-name (t Tone)) (→ String)
      (match t ((Filmic) "filmic") ((Neutral) "neutral") (_ "photographic")))
    (define (tone-value (s String)) (→ Tone)
      (cond ((string=? s "filmic") (Filmic)) ((string=? s "neutral") (Neutral))
            ((string=? s "photographic") (Photographic)) (else (panic "unknown tone curve"))))
    (define (replace-sky! (c RenderContext) (res RenderResources) (env Environment) (tone Tone))
      (→ Unit)
      (unless (string=? (tone-name tone) (tone-name (● c tone))) (forget-forward! c))
      (match (● c forward) ((Some f) (set-environment! (● c gpu) f env)) (_ (unit)))
      (match (● res sky) ((Some old) (release-environment (● c gpu) old)) (_ (unit)))
      (set! (● res sky) (Some env)) (set! (● c tone) tone))
    (define (set-sky! (r Renderer) (env Environment) (tone Tone)) (→ Unit)
      (replace-sky! (● r context) (● r resources) env tone)
      (match (● r config trace)
        ((Some out) (write-command! out "setEnvironment"
                                    (trace-object (list (trace-field "sun" (v3-json (● env sun)))
                                                        (trace-field "color"
                                                                     (v3-json (● env color)))
                                                        (trace-field "disc"
                                                                     (JsonNumber (● env disc)))
                                                        (trace-field "tone"
                                                                     (JsonString
                                                                      (tone-name tone)))))
                                    (list (● env baked)))) (_ (unit))))
    (define (set-sun! (r Renderer) (sun V3)) (→ Unit)
      (set! (● (get-sky (● r resources)) sun) sun)
      (match (● r config trace)
        ((Some out) (write-command! out "setSun" (v3-json sun) (Nil)))
        (_ (unit))))
    (define (pose! (gpu Gpu) (mesh ModelResource) (poses (List Mat4x4f))) (→ Unit)
      (match (● mesh moving)
        ((Some m) (deform-scene! gpu m poses))
        (_ (panic "model has no skin"))))
    (define (pose-model! (r Renderer) (h ModelHandle) (poses (List Mat4x4f))) (→ Unit)
      (pose! (● r context gpu) (get-model (● r resources) (● h id)) poses)
      (match (● r config trace)
        ((Some out) (write-command! out "setPose" (id-args (● h id)) (list (serialize poses))))
        (_ (unit))))
    (define (model-lights! (r Renderer) (h ModelHandle) (lights (List Punctual))) (→ Unit)
      (update-moving-lights! (● r context gpu)
                             (● (get-model (● r resources) (● h id)) scene lights)
                             lights)
      (match (● r config trace)
        ((Some out)
         (write-command! out "setLocalLights" (id-args (● h id)) (list (serialize lights))))
        (_ (unit))))
    (define (configure-image! (c RenderContext)
                              (res RenderResources)
                              (id I64)
                              (w I32)
                              (h I32)
                              (uv Vec4f))
      (→ Plane)
      (let* ((m (get-model res id)) (p (configure-ground-layer! (● c gpu) (● m scene) w h uv)))
        (when (match (● c active) ((Some a) (= a id)) (_ #f))
          (match (● c forward) ((Some f) (set-scene! (● c gpu) f (● m scene))) (_ (unit)))) p))
    (define (material-image! (r Renderer) (h ModelHandle) (w I32) (height I32) (uv Vec4f)) (→ Plane)
      (let ((p (configure-image! (● r context) (● r resources) (● h id) w height uv)))
        (match (● r config trace) ((Some out)
                                   (write-command! out
                                                   "createMaterialImage"
                                                   (trace-object
                                                    (list (trace-field "id" (JsonInteger (● h id)))
                                                          (trace-field "width"
                                                                       (JsonInteger (i32->i64 w)))
                                                          (trace-field "height"
                                                                       (JsonInteger
                                                                        (i32->i64 height)))
                                                          (trace-field "uv" (v4-json uv)))) (Nil)))
               (_ (unit)))
        p))
    (define (image-region (res RenderResources) (id I64) (x I32) (y I32)) (→ TextureCopy)
      (new TextureCopy
        (texture (● (get-model res id) scene ground-layer texture))
        (mip 0)
        (layer 0)
        (x x)
        (y y)))
    ;; One readback for every dirty tile in this paint dispatch. The native
    ;; tile rows include WebGPU's padding so the trace is portable across devices.
    (define (tile-region (res RenderResources) (id I64) (side I64) (cols I64) (tile I64))
      (→ TextureCopy)
      (image-region res
                    id
                    (i64->i32 (* side (remainder tile cols)))
                    (i64->i32 (* side (quotient tile cols)))))
    (define (tile-pitch (side I64)) (→ I64) (* 256 (quotient (+ (* 4 side) 255) 256)))
    (define (capture-material-tiles! (r Renderer)
                                     (h ModelHandle)
                                     (side I64)
                                     (cols I64)
                                     (tiles (List I64)))
      (→ Unit)
      (match (● r config trace)
        ((None) (unit))
        ((Some out)
         (unless (null? tiles)
           (let* ((gpu (● r context gpu)) (pitch (tile-pitch side)) (stride (* pitch side))
                  (bytes (i64->i32 (* (length tiles) stride))) (edge (i64->i32 side))
                  (buffer ((● gpu create-buffer)
                           (new BufferDescriptor
                             (label "trace/material-tiles")
                             (size bytes)
                             (usage (list (CopyDst) (MapRead))))))
                  (encoder ((● gpu create-command-encoder))))
             (let loop ((left tiles) (at 0))
               (match left ((Nil) (unit)) ((Cons tile rest)
                                           ((● gpu copy-texture-to-buffer)
                                            encoder
                                            (tile-region (● r resources) (● h id) side cols tile)
                                            buffer (i64->i32 at) (i64->i32 pitch) edge edge)
                                           (loop rest (+ at stride)))))
             ((● gpu submit) (list ((● gpu finish) encoder)))
             (let ((pixels ((● gpu read-buffer) buffer 0 bytes)))
               ((● gpu destroy) (BufferObject buffer))
               (write-command! out
                               "updateMaterialTiles"
                               (trace-object (list (trace-field "id" (JsonInteger (● h id)))
                                                   (trace-field "side" (JsonInteger side))
                                                   (trace-field "columns" (JsonInteger cols))
                                                   (trace-field "tiles"
                                                                (JsonArray
                                                                 (map JsonInteger tiles)))))
                               (list pixels))))))))
    (define (update-tiles! (c RenderContext) (res RenderResources) (id I64) (cmd ApiCommand))
      (→ Unit)
      (let* ((a (● cmd args))
             (side (trace-int (trace-member a "side")))
             (cols (trace-int (trace-member a "columns")))
             (tiles (map trace-int (trace-array (trace-member a "tiles"))))
             (data (command-block cmd 0))
             (pitch (tile-pitch side)) (stride (* pitch side)) (edge (i64->i32 side)))
        (unless (and (> side 0)
                     (<= side 16384)
                     (> cols 0)
                     (= (array-length data) (* stride (length tiles))))
          (panic "invalid material tiles"))
        (let loop ((left tiles) (at 0))
          (match left ((Nil) (unit)) ((Cons tile rest)
                                      ((● c gpu write-texture)
                                       (tile-region res id side cols tile)
                                       (i64->i32 pitch)
                                       edge
                                       edge
                                       (subarray data at (+ at stride)))
                                      (loop rest (+ at stride)))))))
    (define (backend (c RenderContext) (res RenderResources) (f SceneFrame)) (→ Forward)
      (match (● c forward) ((Some b) b)
             (_ (let* ((id (match (● c active)
                             ((Some n) n)
                             (_ (panic "render needs an active model"))))
                       (b (make-forward (● c gpu) (● (get-model res id) scene) (get-sky res)
                                        (● f width) (● f height) (● f samples) (● c tone))))
                  (set! (● c forward) (Some b)) b))))
    (define (draw! (c RenderContext) (res RenderResources) (f SceneFrame)) (→ Plane)
      (let ((p (render-scene! (backend c res f) f)))
        (completed! c p (● f width) (● f height))))
    (define (render! (r Renderer) (f SceneFrame)) (→ Plane)
      (let ((p (draw! (● r context) (● r resources) f)))
        (match (● r config trace)
          ((Some out) (write-command! out "render" (frame-json f) (Nil)))
          (_ (unit)))
        p))
    (define (present-render! (r Renderer) (f SceneFrame) (blit Compositor) (surface Image)) (→ Unit)
      (let* ((c (● r context)) (b (backend c (● r resources) f)))
        (present-scene! b f blit surface)
        (completed! c (● b target output) (● f width) (● f height))
        (match (● r config trace)
          ((Some out) (write-command! out "render" (frame-json f) (Nil)))
          (_ (unit)))))
    ;; ---- Orthographic batches and sprites ----

    (define (completed! (c RenderContext) (p Plane) (w I32) (h I32)) (→ Plane)
      (release-retained! c)
      (set! (● c image) (Some p))
      (set! (● c width) w)
      (set! (● c height) h)
      p)
    (define (render-batches! (r Renderer) (f Frame) (w I32) (h I32) (surface (Option Image)))
      (→ Plane)
      (let* ((c (● r context)) (enc ((● c gpu create-command-encoder)))
             (p (render-batch-frame! (● c gpu) enc (● c batches) f w h (● r config trace))))
        (submit-frame! c enc p w h surface)))
    (define (atlas! (c RenderContext) (size I32) (pages I32)) (→ Unit)
      (unless (and (> size 0) (<= size 16384) (> pages 0) (<= pages 256))
        (panic "invalid sprite atlas dimensions"))
      (match (● c sprites)
        ((Some old) (retire-plane! c (● old output)) (release-sprite-context! (● c gpu) old))
        (_ (unit)))
      (set! (● c sprites) (Some (make-sprite-scene (● c gpu) size pages))))
    (define (sprites (c RenderContext)) (→ SpriteScene)
      (match (● c sprites) ((Some s) s) (_ (panic "no renderer sprite atlas"))))
    (define (create-sprite-atlas! (r Renderer) (size I32) (pages I32)) (→ Unit)
      (atlas! (● r context) size pages)
      (match (● r config trace) ((Some out) (write-command! out "createAtlas" (trace-object (list
                                                                                             (trace-field
                                                                                              "size"
                                                                                              (JsonInteger
                                                                                               (i32->i64
                                                                                                size)))
                                                                                             (trace-field
                                                                                              "pages"
                                                                                              (JsonInteger
                                                                                               (i32->i64
                                                                                                pages)))))
                                                            (Nil)))
             (_ (unit))))
    (define (compose-sprites! (r Renderer) (pictures (List Picture))) (→ Atlas)
      (sprite-pictures! (● r context gpu) (sprites (● r context)) pictures (● r config trace)))
    (define (render-sprites! (r Renderer)
                             (bg I32)
                             (view View2D)
                             (quads (List Quad))
                             (w I32)
                             (h I32) (surface (Option Image)))
      (→ Plane)
      (let* ((c (● r context))
             (enc ((● c gpu create-command-encoder)))
             (p (sprite-frame! (● c gpu) enc (sprites c) bg view quads w h)))
        (match (● r config trace)
          ((Some out) (write-command! out "renderSprites" (trace-object (list
                                                                         (trace-field "width"
                                                                                      (JsonInteger
                                                                                       (i32->i64
                                                                                        w)))
                                                                         (trace-field "height"
                                                                                      (JsonInteger
                                                                                       (i32->i64
                                                                                        h)))
                                                                         (trace-field "background"
                                                                                      (JsonInteger
                                                                                       (i32->i64
                                                                                        bg)))))
                                      (list (serialize view) (serialize quads))))
          (_ (unit)))
        (submit-frame! c enc p w h surface)))
    ;; Compose after drawing and submit both passes together. Replay can read
    ;; the same owned plane on a device that has no surface.
    (define (compositor! (c RenderContext)) (→ Compositor)
      (match (● c compositor) ((Some blit) blit)
             ((None)
              (let ((p (make-compositor (● c gpu) (● c surface-format))))
                (set! (● c compositor) (Some p))
                p))))
    (define (submit-frame! (c RenderContext)
                           (enc GpuCommandEncoder)
                           (p Plane)
                           (w I32)
                           (h I32)
                           (surface (Option Image)))
      (→ Plane)
      (match surface
        ((Some canvas) (present! (● c gpu) (compositor! c) enc (● p view) canvas))
        ((None) (unit)))
      ((● c gpu submit) (list ((● c gpu finish) enc))) (completed! c p w h))
    (define (renderer-output (r Renderer)) (→ Plane)
      (match (● r context image) ((Some p) p) (_ (panic "renderer has no completed frame"))))
    (define (renderer-size (r Renderer)) (→ (Pair I32 I32))
      (new Pair (first (● r context width)) (second (● r context height))))
    (define (renderer-forward (r Renderer)) (→ Forward)
      (match (● r context forward) ((Some f) f) (_ (panic "renderer has no mesh frame"))))
    (define (release-renderer! (r Renderer)) (→ Unit)
      (let ((gpu (● r context gpu)) (res (● r resources)))
        (forget-forward! (● r context))
        (release-retained! (● r context))
        (set! (● r context image) (None))
        (set! (● r context width) 0)
        (set! (● r context height) 0)
        (release-batches! gpu (● r context batches))
        (match (● r context sprites) ((Some s) (release-sprites! gpu s)) (_ (unit)))
        (set! (● r context sprites) (None))
        (match (● r context compositor) ((Some p) (release-compositor gpu p)) (_ (unit)))
        (set! (● r context compositor) (None))
        (for-each (lambda (m) (release-model! gpu m)) (table-values (● res models)))
        (set! (● res models) (empty-table)) (set! (● r context active) (None))
        (match (● res sky) ((Some sky) (release-environment gpu sky)) (_ (unit)))
        (set! (● res sky) (None))))

    (define (apply-command! (c RenderContext) (res RenderResources) (cmd ApiCommand)) (→ Unit)
      (let* ((op (● cmd op)) (args (● cmd args)) (gpu (● c gpu))
             (at (lambda ((k String)) (→ Json) (trace-member args k)))
             (id (lambda () (trace-int (at "id"))))
             (n (lambda ((k String)) (→ I32) (i64->i32 (trace-int (at k))))))
        (cond
         ((string=? op "createModel")
          (let ((key (new-id res (id)))) (add-model! res key (restore-model gpu cmd)))
          (unit))
         ((string=? op "useModel") (select-model! c res (id)))
         ((string=? op "deleteModel") (remove-model! c res (id)))
         ((string=? op "setEnvironment")
          (let ((disc (match (at "disc")
                        ((JsonNumber x) x)
                        ((JsonInteger x) (i64->f64 x))
                        (_ (panic "invalid sun disc")))))
            (replace-sky! c
                          res
                          (make-environment
                            gpu
                            (command-block cmd 0)
                            (json-v3 (at "sun"))
                            (json-v3 (at "color"))
                            disc)
                          (tone-value (trace-string (at "tone"))))))
         ((string=? op "setSun") (set! (● (get-sky res) sun) (json-v3 args)))
         ((string=? op "setPose") (pose! gpu (get-model res (id)) (command-value cmd 0)))
         ((string=? op "setLocalLights")
          (update-moving-lights! gpu (● (get-model res (id)) scene lights) (command-value cmd 0)))
         ((string=? op "createMaterialImage")
          (configure-image! c res (id) (n "width") (n "height") (json-v4 (at "uv")))
          (unit))
         ((string=? op "updateMaterialTiles") (update-tiles! c res (id) cmd))
         ((string=? op "setBatch") (restore-batch! (● c batches) cmd))
         ((string=? op "renderBatches")
          (let* ((w (n "width")) (h (n "height")) (enc ((● gpu create-command-encoder)))
                 (p (replay-batch-frame! gpu enc (● c batches) cmd w h)))
            (submit-frame! c enc p w h (None))
            (unit)))
         ((string=? op "createAtlas") (atlas! c (n "size") (n "pages")))
         ((string=? op "updateAtlas") (restore-picture! gpu (sprites c) cmd))
         ((string=? op "renderSprites")
          (let* ((w (n "width")) (h (n "height")) (enc ((● gpu create-command-encoder)))
                 (p (sprite-frame! gpu
                                   enc
                                   (sprites c)
                                   (n "background")
                                   (command-value cmd 0)
                                   (command-value cmd 1)
                                   w
                                   h)))
            (submit-frame! c enc p w h (None)) (unit)))
         ((string=? op "render") (draw! c res (json-frame args)) (unit))
         (else (panic (string-append "unknown renderer command: " op))))))))
