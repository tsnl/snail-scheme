;; SSIM's forward kernel (splat-ssim): each pixel's S into `ssim_map`, and its
;; three derivatives, by mu_x, E[xx] and E[xy], into `partials`, three
;; floats a pixel and channel.
((var storage read_write) (@group 0) (@binding 2) (ssim_map (array f32)))

((var storage read_write) (@group 0) (@binding 3) (partials (array f32)))

(fn (@compute)
    (@workgroup_size 256)
    ssim_forward
    (((@builtin workgroup_id) wid vec3u)
     ((@builtin num_workgroups) nwg vec3u)
     ((@builtin local_invocation_index) t u32))
    (if ((>= (+ (* (get wid y) (get nwg x)) (get wid x)) (* TILES_X TILES_Y)) (return)))
    (let origin (tile_origin wid nwg))
    (let px (+ (get origin x) (% t 16u)))
    (let py (+ (get origin y) (/ t 16u)))
    (for ((var c 0u) (< c CHANNELS) (+= c 1u))
         (for ((var part 0u) (< part 3u) (+= part 1u))
              (let k (+ t (* part 256u)))
              (if ((< k AREA)
                   (let cell (border_index origin k c))
                   (let inside (== (get cell y) 1u))
                   (= (at tile_a k) (select 0.0 (at x (get cell x)) inside))
                   (= (at tile_b k) (select 0.0 (at y (get cell x)) inside)))))
         (workgroupBarrier)
         (for ((var part 0u) (< part 2u) (+= part 1u))
              (let k (+ t (* part 256u)))
              (if ((< k BAND)
                   (let start (+ (* (/ k 16u) SIDE) (% k 16u)))
                   (var mx 0.0)
                   (var my 0.0)
                   (var xx 0.0)
                   (var yy 0.0)
                   (var xy 0.0)
                   (for ((var q 0u) (< q 11u) (+= q 1u))
                        (let a (at tile_a (+ start q)))
                        (let b (at tile_b (+ start q)))
                        (let w (at WEIGHTS q))
                        (+= mx (* w a))
                        (+= my (* w b))
                        (+= xx (* w a a))
                        (+= yy (* w b b))
                        (+= xy (* w a b)))
                   (= (at rows k) mx)
                   (= (at rows (+ BAND k)) my)
                   (= (at rows (+ (* 2u BAND) k)) xx)
                   (= (at rows (+ (* 3u BAND) k)) yy)
                   (= (at rows (+ (* 4u BAND) k)) xy))))
         (workgroupBarrier)
         (let mu_x (blurred_column t 0u))
         (let mu_y (blurred_column t 1u))
         (let a1 (+ (* 2.0 mu_x mu_y) C1))
         (let a2 (+ (* 2.0 (- (blurred_column t 4u) (* mu_x mu_y))) C2))
         (let b1 (+ (* mu_x mu_x) (* mu_y mu_y) C1))
         (let b2 (+
                  (- (blurred_column t 2u) (* mu_x mu_x))
                  (- (blurred_column t 3u) (* mu_y mu_y))
                  C2))
         (let s (/ (* a1 a2) (* b1 b2)))
         (if ((and (< px WIDTH) (< py HEIGHT))
              (let i (+ (* (+ (* py WIDTH) px) CHANNELS) c))
              (= (at ssim_map i) s)
              (= (at partials (* 3u i))
                 (- (/ (* 2.0 mu_y (- a2 a1)) (* b1 b2)) (* 2.0 mu_x s (- (/ 1.0 b1) (/ 1.0 b2)))))
              (= (at partials (+ (* 3u i) 1u)) (- (/ s b2)))
              (= (at partials (+ (* 3u i) 2u)) (/ (* 2.0 a1) (* b1 b2)))))
         (workgroupBarrier)))

