;; Reconstruction happens in the stable display grid. Raw G-buffer motion
;; includes both projections' jitter. Subtract their difference exactly once.
((var uniform) (@group 0) (@binding 0) (camera Camera3D))
((var uniform) (@group 0) (@binding 1) (shift vec4f))
(var (@group 0) (@binding 2) (light (texture_2d f32)))
(var (@group 0) (@binding 3) (depth texture_depth_2d))
(var (@group 0) (@binding 4) (motion (texture_2d f32)))
(var (@group 0) (@binding 5) (emission (texture_2d f32)))
(var (@group 0) (@binding 6) (triangles (texture_2d u32)))
(var (@group 0) (@binding 7) (previous_color (texture_2d f32)))
(var (@group 0) (@binding 8) (previous_id (texture_2d u32)))
(var (@group 0) (@binding 9) (resolved (texture_storage_2d rgba16float write)))
(var (@group 0) (@binding 10) (surface_id (texture_storage_2d r32uint write)))

(var (@group 0) (@binding 11) (front_depth texture_depth_2d))

(fn compressed ((c vec3f)) (-> vec3f)
    (return (/ c (+ 1.0 (max (get c r) (max (get c g) (get c b)))))))
(fn expanded ((c vec3f)) (-> vec3f)
    (return (/ c (max 0.00001 (- 1.0 (max (get c r) (max (get c g) (get c b))))))))
(fn surface_key ((p vec2i) (z f32)) (-> u32)
    (let opaque (select (+ 1u (get (textureLoad triangles p 0) x)) 0u (>= z 1.0)))
    ;; A composite of glass and its background has no single motion vector.
    (return (select opaque 0xffffffffu (< (textureLoad front_depth p 0) z))))
(fn ndc_at ((uv vec2f)) (-> vec2f) (return (+ (* uv (vec2f 2.0 -2.0)) (vec2f -1.0 1.0))))

(fn (@compute) (@workgroup_size 8 8) resolve (((@builtin global_invocation_id) id vec3u))
    (let out_size (vec2i (textureDimensions resolved)))
    (let dest (vec2i (get id xy)))
    (if ((any (>= dest out_size)) (return)))
    (let size (vec2i (textureDimensions light)))
    (let uv (/ (+ (vec2f dest) 0.5) (vec2f out_size)))
    (let low (- (* uv (vec2f size)) (get shift xy) 0.5))
    (let p (clamp (vec2i (floor (+ low 0.5))) (vec2i 0) (- size 1)))
    (let z (textureLoad depth p 0))
    (let key (surface_key p z))
    (let clip (vec4f (ndc_at (/ (+ (vec2f p) 0.5) (vec2f size))) z 1.0))
    (let world (* (get camera inverse) clip))
    (let current_z (select (/ z (get world w)) 0.0 (== key 0u)))
    (var current (vec3f 0.0)) (var weight 0.0)
    (var lo (vec3f 1.0)) (var hi (vec3f 0.0))
    (for ((var dy -1) (<= dy 1) (+= dy 1))
         (for ((var dx -1) (<= dx 1) (+= dx 1))
              (let q (clamp (+ p (vec2i dx dy)) (vec2i 0) (- size 1)))
              (let qz (textureLoad depth q 0))
              (if ((!= (surface_key q qz) key) (continue)))
              (let c (compressed (max (get (textureLoad light q 0) rgb) (vec3f 0.0))))
              (let d (- (vec2f q) low)) (let w (exp (* -3.5 (dot d d))))
              (+= weight w) (+= current (* w c)) (= lo (min lo c)) (= hi (max hi c))))
    (/= current (max 0.00001 weight))
    (let velocity (+
                   (get (textureLoad motion p 0) xy)
                   (/ (- (get shift xy) (get shift zw)) (vec2f size))))
    (let prev_uv (- uv velocity))
    (let before (- (* prev_uv (vec2f out_size)) 0.5))
    (let base (vec2i (floor before))) (let f (fract before))
    (let expected (get (textureLoad emission p 0) w))
    (var history (vec3f 0.0)) (var coverage 0.0)
    ;; A sentinel previous jitter invalidates the whole history on a cut or resize.
    ;; Sky and translucency can lack a stable opaque surface. Use fresh sky color.
    (if ((and (< (get shift z) 1.0) (!= key 0u) (!= key 0xffffffffu) (> expected 0.0))
         (for ((var k 0) (< k 4) (+= k 1))
              (let o (vec2i (bit-and k 1) (>> k 1))) (let q (+ base o))
              (if ((or (any (< q (vec2i 0))) (any (>= q out_size))) (continue)))
              (if ((!= (get (textureLoad previous_id q 0) x) key) (continue)))
              (let h (textureLoad previous_color q 0))
              (if ((> (abs (- (get h w) expected)) (max 0.012 (* expected 0.012))) (continue)))
              (let w (* (select (- 1.0 (get f x)) (get f x) (== (get o x) 1))
                        (select (- 1.0 (get f y)) (get f y) (== (get o y) 1))))
              (+= history (* w (compressed (get h rgb)))) (+= coverage w))))
    (if ((> coverage 0.001)
         (/= history coverage)
         (let diff (abs (- history current)))
         (let change (max (get diff x) (max (get diff y) (get diff z))))
         (let travel (length (* velocity (vec2f size))))
         (let stable (*
                      (- 1.0 (smoothstep 0.035 0.22 change))
                      (- 1.0 (* 0.6 (smoothstep 0.4 4.0 travel)))))
         (let near (dot (- (vec2f p) low) (- (vec2f p) low)))
         (let keep (* coverage stable (mix 0.54 0.78 (min 1.0 (* 3.0 near)))))
         (= current (mix current (clamp history (- lo 0.006) (+ hi 0.006)) keep))))
    (textureStore resolved
                  dest
                  (vec4f (expanded (clamp current (vec3f 0.0) (vec3f 0.99998))) current_z))
    (textureStore surface_id dest (vec4u key 0u 0u 0u)))
