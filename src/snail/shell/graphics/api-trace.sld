;; A command header and its inline binary blocks form one logical operation.
;; The input cursor stops immediately after the last requested operation.
(define-library (snail shell graphics api-trace)
  (export RendererConfig ApiCommand trace-field trace-object trace-member trace-int trace-string
          trace-array write-command! replay-commands! command-block command-value)
  (import
   (snail core base)
   (snail core io)
   (snail shell base64)
   (snail shell wire)
   (snail shell json)
   (snail shell json read))
  (begin
    (record RendererConfig
      ((trace (Option OutputPort))))
    (record ApiCommand
      ((op String)
       (args Json)
       (blocks (List Bytes))))
    (define (trace-field (key String) (value Json)) (→ (Pair String Json))
      (new Pair (first key) (second value)))
    (define (trace-object (fields (List (Pair String Json)))) (→ Json) (JsonObject fields))
    (define (trace-member (json Json) (key String)) (→ Json)
      (match (json-member json key) ((Some v) v)
             (_ (panic (string-append "missing renderer trace field: " key)))))
    (define (trace-int (v Json)) (→ I64)
      (match v ((JsonInteger n) n) (_ (panic "expected renderer trace integer"))))
    (define (trace-string (v Json)) (→ String)
      (match v ((JsonString s) s) (_ (panic "expected renderer trace string"))))
    (define (trace-array (v Json)) (→ (List Json))
      (match v ((JsonArray xs) xs) (_ (panic "expected renderer trace array"))))
    (define (command-block (cmd ApiCommand) (i I64)) (→ Bytes)
      (unless (and (>= i 0) (< i (length (● cmd blocks)))) (panic "missing renderer trace block"))
      (list-ref (● cmd blocks) i))
    (define (command-value (cmd ApiCommand) (i I64)) (→ T) (∀ (T)) (⊨ (Deserialize T))
      (deserialize (command-block cmd i)))

    ;; Binary lines are bounded so a large mesh never becomes one JSON string.
    (define part-size (→ I64) 24576)
    (define (write-block! (out OutputPort) (bytes Bytes)) (→ Unit)
      (let loop ((at 0))
        (when (< at (array-length bytes))
          (let ((end (min (array-length bytes) (+ at part-size))))
            (write-line out (string-append "\"" (base64-text (subarray bytes at end)) "\""))
            (loop end)))))
    (define (write-command! (out OutputPort) (op String) (args Json) (blocks (List Bytes))) (→ Unit)
      (write-line out (json->string (trace-object
                                     (list (trace-field "v" (JsonInteger 1))
                                           (trace-field "op" (JsonString op))
                                           (trace-field "args" args)
                                           (trace-field "bytes"
                                                        (JsonArray (map (lambda (b)
                                                                          (JsonInteger
                                                                           (array-length b)))
                                                                        blocks)))))))
      (for-each (lambda (b) (write-block! out b)) blocks))

    (define (read-part (in InputPort) (n I64)) (→ Bytes)
      (match (read-line in)
        ((None) (panic "truncated renderer trace block"))
        ((Some line)
         (let ((len (string-length line)))
           (unless (and (= len (+ 2 (* 4 (quotient (+ n 2) 3))))
                        (char=? (string-ref line 0) #\") (char=? (string-ref line (- len 1)) #\"))
             (panic "invalid renderer trace block line"))
           (let ((part (decode-base64 (substring line 1 (- len 1)))))
             (unless (= n (array-length part)) (panic "renderer trace block size mismatch"))
             part)))))
    ;; Allocate the joined block only after every promised chunk has arrived.
    (define (read-block (in InputPort) (size I64)) (→ Bytes)
      (unless (and (>= size 0) (<= size 2147483647)) (panic "invalid renderer trace block size"))
      (if (<= size part-size) (if (= size 0) (array) (read-part in size))
          (let loop ((left size) (parts (ann (Nil) (List Bytes))))
            (if (= left 0)
                (let ((bytes (make-array size (i32->u8 0))))
                  (fold-left (lambda (end part) (let ((n (array-length part)))
                                                  (array-copy! bytes (- end n) part 0 n) (- end n)))
                             size
                             parts)
                  bytes)
                (let* ((n (min left part-size)) (part (read-part in n)))
                  (loop (- left n) (Cons part parts)))))))
    (define (read-command (in InputPort) (header String)) (→ ApiCommand)
      (match (string->json header)
        ((Some object)
         (unless (= (trace-int (trace-member object "v")) 1)
           (panic "unsupported renderer trace version"))
         (let* ((op (trace-string (trace-member object "op"))) (args (trace-member object "args"))
                (sizes (map trace-int (trace-array (trace-member object "bytes")))))
           ;; Reads happen in port order even on hosts with different evaluation orders.
           (let loop ((left sizes) (blocks (ann (Nil) (List Bytes))))
             (match left ((Nil) (new ApiCommand (op op) (args args) (blocks (reverse blocks))))
                    ((Cons n rest) (let ((b (read-block in n))) (loop rest (Cons b blocks))))))))
        (_ (panic "invalid renderer trace JSON header"))))
    (define (replay-commands! (in InputPort) (limit (Option I64)) (apply (Fn ApiCommand → Unit)))
      (→ I64)
      (match limit ((Some n) (when (< n 0) (panic "negative renderer replay limit"))) (_ (unit)))
      (let loop ((count 0))
        (if (match limit ((Some n) (= count n)) (_ #f)) count
            (match (read-line in)
              ((None) count)
              ((Some header) (apply (read-command in header)) (loop (+ count 1)))))))))
