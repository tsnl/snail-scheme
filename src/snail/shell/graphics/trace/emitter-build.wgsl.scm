;; Weigh once in the scene's initial pose. Sampling uses the current
;; vertices, so deformation changes the integrand while this proposal stays fixed.
(var (@group 0) (@binding 0) (emitting_triangles (texture_2d u32)))
(var (@group 0) (@binding 1) (distribution (texture_storage_2d rgba32float write)))
((var storage read_write) (@group 0) (@binding 2) (row_sums (array f32)))

(fn (@compute) (@workgroup_size 64) weigh_rows (((@builtin global_invocation_id) id vec3u))
    (let size (textureDimensions emitting_triangles))
    (let y (get id x))
    (if ((>= y (get size y)) (return)))
    (var sum 0.0)
    (for ((var x 0u) (< x (get size x)) (+= x 1u))
         (let xy (vec2u x y))
         (let id (get (textureLoad emitting_triangles xy 0) x))
         (var le (vec3f 0.0))
         (if ((!= id 0xffffffffu)
              (let a (corner id 0u))
              (let ab (- (get (corner id 1u) position) (get a position)))
              (let ac (- (get (corner id 2u) position) (get a position)))
              (= le (get (at materials (get a material)) emissive xyz))
              (+= sum (* 0.5 (length (cross ab ac)) (dot le (vec3f 0.2126 0.7152 0.0722))))))
         (textureStore distribution xy (vec4f le sum)))
    (= (at row_sums y) sum))

(fn (@compute) (@workgroup_size 1) weigh_marginal ()
    (let size (textureDimensions emitting_triangles))
    (var sum 0.0)
    (for ((var y 0u) (< y (get size y)) (+= y 1u))
         (+= sum (at row_sums y))
         (textureStore distribution (vec2u (get size x) y) (vec4f 0.0 0.0 0.0 sum))))
