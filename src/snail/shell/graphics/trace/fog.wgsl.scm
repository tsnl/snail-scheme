;; Integrate a height-dependent participating medium over the eye ray. The
;; same BVH and alpha tests used by surface shadows split the sun into shafts.
((var uniform) (@group 2) (@binding 0) (camera Camera3D))
((var uniform) (@group 2) (@binding 1) (lens LensSettings))
(var (@group 2) (@binding 2) (depth texture_depth_2d))
(var (@group 2) (@binding 3) (front texture_depth_2d))
(var (@group 2) (@binding 4) (disc_light (texture_2d f32)))
(var (@group 2) (@binding 5) (sky_light (texture_2d f32)))
(var (@group 2) (@binding 6) (volume (texture_storage_2d rgba16float write)))
(fn (@compute) (@workgroup_size 8 8) mist (((@builtin global_invocation_id) id vec3u))
    (let size (vec2i (textureDimensions volume)))
    (let p (vec2i (get id xy))) (if ((any (>= p size)) (return)))
    (let hi (vec2i (textureDimensions depth)))
    (let uv (/ (+ (vec2f p) 0.5) (vec2f size)))
    (let q (clamp (vec2i (* uv (vec2f hi))) (vec2i 0) (- hi 1)))
    (let z (min (textureLoad depth q 0) (textureLoad front q 0)))
    (let ndc (- (* uv 2.0) 1.0))
    (let end (* (get camera inverse) (vec4f (get ndc x) (- (get ndc y)) z 1.0)))
    (let eye (get camera eye xyz))
    (let vector (- (/ (get end xyz) (get end w)) eye))
    (let length_m (min (get lens range) (length vector)))
    (let view (normalize vector))
    (let sun (normalize (get (textureLoad disc_light (vec2i 0 0) 0) xyz)))
    (let beam (get (textureLoad disc_light (vec2i 1 0) 0) xyz))
    (let sky_size (vec2f (textureDimensions sky_light)))
    (let ambient (get (textureLoad sky_light (vec2i (* sky_size (vec2f 0.24 0.33))) 0) rgb))
    ;; Henyey–Greenstein, with a little isotropic multiple-scattered light.
    (let g (get lens anisotropy))
    (let phase (/
                (- 1.0 (* g g))
                (* 12.56637 (pow (max 0.025 (+ 1.0 (* g g) (* -2.0 g (dot sun view)))) 1.5))))
    (var trans 1.0) (var light (vec3f 0.0)) (var last 0.0)
    (var seed (+ (u32 (get p x)) (* 1669u (u32 (get p y)))))
    (for ((var i 1) (<= i 10) (+= i 1))
         (let u (/ (f32 i) 10.0)) (let end_m (* length_m u u))
         (let at_point (+ eye (* view (* 0.5 (+ end_m last)))))
         (let density (* (get lens density)
                         (exp
                          (clamp (* (- (get lens falloff)) (- (get at_point y) (get lens level)))
                                 -6.0
                                 1.5))))
         (let absorb (- 1.0 (exp (* (- density) (- end_m last)))))
         (var incident (* 0.85 ambient))
         (if ((> (max (get beam r) (max (get beam g) (get beam b))) 0.000001)
              (let hit (bvh_traced at_point sun 320.0 true (address-of seed)))
              (if ((== (get hit triangle) BVH_NONE) (+= incident (* phase beam))))))
         (+= light (* trans absorb incident)) (*= trans (- 1.0 absorb)) (= last end_m))
    (textureStore volume p (vec4f (* light (get lens exposure)) trans)))
