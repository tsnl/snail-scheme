;; Samples live either on the environment sphere or on a named triangle.
;; On a triangle the uniform barycentric measure has total mass one,
;; independent of receiver and pose. Its Jacobian to solid angle is
;; J = area * abs(cos at light) / distance².
(var (@group 1) (@binding 6) (emitter_ids (texture_2d u32)))
(var (@group 1) (@binding 7) (emitter_table (texture_2d f32)))

(fn mesh_fraction () (-> f32)
    (let size (vec2i (textureDimensions emitter_ids)))
    (if ((<= (get (textureLoad emitter_table (- size (vec2i 0 1)) 0) w) 0.0) (return 0.0)))
    (let sun (get (textureLoad environment_disc (vec2i 1 0) 0) xyz))
    (return (select 1.0 0.5 (> (+ (sky_flux (environment_size)) (dot sun env_luma)) 0.0))))

(fn emitter_cell ((slot i32)) (-> vec2i)
    (let width (i32 (get (textureDimensions emitter_ids) x)))
    (return (vec2i (% slot width) (/ slot width))))

(fn emitter_cdf ((p vec2i)) (-> f32)
    (if ((any (< p (vec2i 0))) (return 0.0)))
    (return (get (textureLoad emitter_table p 0) w)))

;; The row and column each consume an independent uniform draw. Use the
;; intervals of the stored CDF for the PDF too, including float rounding.
(fn emitter_interval ((start vec2i) (step vec2i) (count i32) (u f32)) (-> i32)
    (let total (emitter_cdf (+ start (* step (- count 1)))))
    (var low 0)
    (var high (- count 1))
    (while (< low high)
           (let mid (/ (+ low high) 2))
           (if ((<= (/ (emitter_cdf (+ start (* step mid))) total) u) (= low (+ mid 1)))
               (else (= high mid))))
    (return low))

(fn draw_emitter ((u vec2f)) (-> i32)
    (let size (vec2i (textureDimensions emitter_ids)))
    (let y (emitter_interval (vec2i (get size x) 0) (vec2i 0 1) (get size y) (get u y)))
    (let x (emitter_interval (vec2i 0 y) (vec2i 1 0) (get size x) (get u x)))
    (return (+ 1 x (* y (get size x)))))

(fn emitter_mass ((cell vec2i)) (-> f32)
    (let size (vec2i (textureDimensions emitter_ids)))
    (let row (vec2i (get size x) (get cell y)))
    (let column_sum (emitter_cdf (vec2i (- (get size x) 1) (get cell y))))
    (let total (emitter_cdf (- size (vec2i 0 1))))
    (if ((or (<= total 0.0) (<= column_sum 0.0)) (return 0.0)))
    (return (* (/ (- (emitter_cdf row) (emitter_cdf (- row (vec2i 0 1)))) total)
               (/ (- (emitter_cdf cell) (emitter_cdf (- cell (vec2i 1 0)))) column_sum))))

;; Look up an emissive BSDF hit in the same ordered ID table used to draw it.
(fn hit_emitter ((triangle u32)) (-> i32)
    (let size (textureDimensions emitter_ids))
    (var low 0)
    (var high (i32 (* (get size x) (get size y))))
    (while (< low high)
           (let mid (/ (+ low high) 2))
           (let id (get (textureLoad emitter_ids (emitter_cell mid) 0) x))
           (if ((== id triangle) (return (+ 1 mid)))
               ((< id triangle) (= low (+ mid 1)))
               (else (= high mid))))
    (return 0))

(struct Proposal
        (direction vec3f)
        (pdf f32)
        (value vec3f)
        (endpoint vec3f)
        (emitter i32)
        (coordinates i32))

(fn sky_proposal ((s Surface) (v vec3f) (d vec3f) (pdf f32)) (-> Proposal)
    (var value (vec3f 0.0))
    (if ((and (> pdf 0.0) (> (dot (get s geometric) d) 0.0))
         (= value (* (environment_light d) (evaluated s v d) (balanced pdf (density s v d))))))
    (return (Proposal d pdf value d 0 0)))

(fn triangle_proposal ((s Surface) (v vec3f) (slot i32) (coordinates i32) (fraction f32))
    (-> Proposal)
    (let cell (emitter_cell (- slot 1)))
    (let id (get (textureLoad emitter_ids cell 0) x))
    (let a (get (corner id 0u) position))
    (let ab (- (get (corner id 1u) position) a))
    (let ac (- (get (corner id 2u) position) a))
    (let n (cross ab ac))
    (let packed (u32 coordinates))
    (var b (/ (+ (vec2f (vec2u (bit-and packed 65535u) (>> packed 16u))) 0.5) 65536.0))
    (if ((> (+ (get b x) (get b y)) 1.0) (= b (- 1.0 b))))
    (let point (+ a (* ab (get b x)) (* ac (get b y))))
    (let delta (- point (get s position)))
    (let r2 (dot delta delta))
    (var (p Proposal))
    (= (get p pdf) (* fraction (emitter_mass cell)))
    (= (get p emitter) slot)
    (= (get p coordinates) coordinates)
    (if ((<= r2 1e-16) (return p)))
    (let d (/ delta (sqrt r2)))
    (let facing (dot n (- d)))
    (let j (/ (* 0.5 (abs facing)) r2))
    (= (get p direction) d)
    (if ((or (<= j 0.0) (<= (dot (get s geometric) d) 0.0)) (return p)))
    (let le (get (textureLoad emitter_table cell 0) xyz))
    (= (get p value) (* le (evaluated s v d) j (balanced (get p pdf) (* (density s v d) j))))
    ;; Move the endpoint a few float ulps toward the visible side of the
    ;; light's plane so the sign cannot shadow itself at grazing incidence.
    (let extent (max 1.0 (max (abs (get point x)) (max (abs (get point y)) (abs (get point z))))))
    (= (get p endpoint) (+ point (* (normalize n) (sign facing) extent 4.8e-7)))
    (return p))

(fn draw_proposal ((s Surface) (v vec3f) (fraction f32) (seed (ptr function u32))) (-> Proposal)
    (let u (vec4f (random seed) (random seed) (random seed) (random seed)))
    (if ((and (> fraction 0.0) (< (random seed) fraction))
         (let uv (vec2u (* (get u zw) 65536.0)))
         (let bits (i32 (bit-or (get uv x) (<< (get uv y) 16u))))
         (return (triangle_proposal s v (draw_emitter (get u xy)) bits fraction))))
    (let sky (environment_sample u))
    (return (sky_proposal s v (get sky xyz) (* (- 1.0 fraction) (get sky w)))))

(fn selected_proposal ((s Surface) (v vec3f) (r Reservoir) (fraction f32)) (-> Proposal)
    (if ((> (get r emitter) 0)
         (return (triangle_proposal s v (get r emitter) (get r coordinates) fraction))))
    (let d (get r selected direction))
    (return (sky_proposal s v d (* (- 1.0 fraction) (environment_pdf d)))))

(fn emission_weight ((ray Ray) (triangle u32)) (-> f32)
    (let slot (hit_emitter triangle))
    (if ((== slot 0) (return 1.0)))
    (let q (* (mesh_fraction) (emitter_mass (emitter_cell (- slot 1)))))
    (if ((<= q 0.0) (return 1.0)))
    (let a (get (corner triangle 0u) position))
    (let n (cross
            (- (get (corner triangle 1u) position) a)
            (- (get (corner triangle 2u) position) a)))
    (let r (get ray hit t))
    (let j (/ (* 0.5 (abs (dot n (get ray direction xyz)))) (* r r)))
    (return (balanced (* (get ray more z) j) q)))
