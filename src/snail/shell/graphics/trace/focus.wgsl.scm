;; Apply the atmosphere and a depth-gated circular aperture to the denoised
;; HDR image, before temporal reconstruction, tone mapping and display AA.
((var uniform) (@group 0) (@binding 0) (camera Camera3D))
((var uniform) (@group 0) (@binding 1) (lens LensSettings))
(var (@group 0) (@binding 2) (depth texture_depth_2d))
(var (@group 0) (@binding 3) (front texture_depth_2d))
(var (@group 0) (@binding 4) (volume (texture_2d f32)))
(var (@group 0) (@binding 5) (light (texture_2d f32)))
(var (@group 0) (@binding 6) (output_color (texture_storage_2d rgba16float write)))
(fn view_depth ((p vec2i) (size vec2i)) (-> f32)
    (let z (min (textureLoad depth p 0) (textureLoad front p 0)))
    (if ((>= z 1.0) (return (get lens range))))
    (let uv (/ (+ (vec2f p) 0.5) (vec2f size))) (let ndc (- (* uv 2.0) 1.0))
    (let v (* (get camera inverse) (vec4f (get ndc x) (- (get ndc y)) z 1.0)))
    (return
     (max 0.05 (dot (- (/ (get v xyz) (get v w)) (get camera eye xyz)) (get camera forward xyz)))))
(fn thin_mist ((uv vec2f) (z f32) (air vec4f)) (-> vec4f)
    ;; When no low-resolution tap saw this twig or railing, estimate the
    ;; extinction to its own depth. Nearby volume samples supply light colour.
    (let ndc (- (* uv 2.0) 1.0))
    (let v (* (get camera inverse) (vec4f (get ndc x) (- (get ndc y)) 0.5 1.0)))
    (let dir (normalize (- (/ (get v xyz) (get v w)) (get camera eye xyz))))
    (let dist (min (get lens range) (/ z (max 0.01 (dot dir (get camera forward xyz))))))
    (var tau 0.0)
    (for ((var i 0) (< i 4) (+= i 1))
         (let h (+ (get camera eye y) (* dist (get dir y) (+ 0.125 (* 0.25 (f32 i))))))
         (+= tau (exp (clamp (* (- (get lens falloff)) (- h (get lens level))) -6.0 1.5))))
    (let trans (exp (* -0.25 (get lens density) tau dist)))
    (return (vec4f (* (get air rgb) (/ (- 1.0 trans) (max 0.001 (- 1.0 (get air w))))) trans)))
(fn mist_at ((uv vec2f) (size vec2i) (range_m f32)) (-> vec4f)
    (let grid (vec2i (textureDimensions volume))) (let pos (- (* uv (vec2f grid)) 0.5))
    (let base (vec2i (floor pos))) (let f (fract pos))
    (var sum (vec4f 0.0)) (var air (vec4f 0.0)) (var total 0.0)
    (for ((var j 0) (< j 4) (+= j 1))
         (let d (vec2i (bit-and j 1) (>> j 1u))) (let q (clamp (+ base d) (vec2i 0) (- grid 1)))
         (let sample_p (clamp
                        (vec2i (* (/ (+ (vec2f q) 0.5) (vec2f grid)) (vec2f size)))
                        (vec2i 0)
                        (- size 1)))
         (let k (mix (- (vec2f 1.0) f) f (vec2f d)))
         (let delta (/ (abs (- (view_depth sample_p size) range_m)) (max 1.0 range_m)))
         (let area (* (get k x) (get k y))) (let w (* area (exp (* -12.0 delta))))
         (let sample_air (textureLoad volume q 0))
         (+= air (* area sample_air)) (+= sum (* w sample_air)) (+= total w))
    (let filtered (/ sum (max total 0.00001)))
    (if ((>= total 0.06) (return filtered)))
    (return (mix (thin_mist uv range_m air) filtered (smoothstep 0.001 0.06 total))))
(fn (@compute) (@workgroup_size 8 8) photograph (((@builtin global_invocation_id) id vec3u))
    (let size (vec2i (textureDimensions light))) (let p (vec2i (get id xy)))
    (if ((any (>= p size)) (return))) (let z (view_depth p size))
    (let focus (max 0.1 (get lens focus)))
    (let radius (min
                 9.0
                 (* (get lens aperture) (f32 (get size y)) (abs (- (/ 1.0 z) (/ 1.0 focus))))))
    (var color (get (textureLoad light p 0) rgb)) (var weight 1.0)
    (if ((> radius 0.65)
         (for ((var i 0) (< i 12) (+= i 1))
              (let angle (* 2.3999632 (f32 i)))
              (let offset (*
                           radius
                           (sqrt (/ (+ (f32 i) 0.5) 12.0))
                           (vec2f (cos angle) (sin angle))))
              (let q (clamp (+ p (vec2i (round offset))) (vec2i 0) (- size 1)))
              (let near_z (view_depth q size))
              (let w (smoothstep (* -0.09 z) 0.0 (- near_z z)))
              (+= color (* w (get (textureLoad light q 0) rgb))) (+= weight w))))
    (let air (mist_at (/ (+ (vec2f p) 0.5) (vec2f size)) size z))
    (textureStore output_color p (vec4f (+ (* (/ color weight) (get air w)) (get air rgb)) 1.0)))
