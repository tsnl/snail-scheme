;; A forward frame has four passes: directional shadow maps, opaque camera
;; depth, direct and environment lighting into HDR, and display conversion.
(define-library (snail shell graphics forward render)
  (export Forward
          make-forward
          draw-forward
          resize-forward
          set-scene!
          set-environment!
          set-directional-lights!
          release-forward
          Light transparent-order cascade-views Lighting Shading MetallicRoughness BlinnPhong)
  (import
   (snail core base)
   (snail shell wire)
   (snail shell gpu)
   (only (snail shell game rigid-body) V3 v3 v+ v- scaled dot cross squared unit-vector)
   (snail shell graphics pod)
   (snail shell graphics kernel)
   (snail shell graphics raster)
   (snail shell graphics passes)
   (only (snail shell graphics gltf)
         Material
         AlphaMode
         OpaqueMaterial
         MaskedMaterial
         BlendedMaterial
         blended-material?)
   (snail shell graphics forward scene)
   (snail shell graphics forward environment)
   (snail shell graphics forward frame)
   (snail shell graphics forward shaders))
  (begin
    (enum Shading (MetallicRoughness) (BlinnPhong) (deriving Serialize Deserialize))
    (record Light
      ((position V3)
       (power V3)))
    (record Lighting
      ((near-map Mat4x4f)
       (mid-map Mat4x4f)
       (far-map Mat4x4f)
       (sun Vec4f)
       (key Vec4f)
       (splits Vec4f)
       (counts Vec4f)) (deriving Pod))
    (record DepthPipelines
      ((solid GpuRenderPipeline)
       (two-sided GpuRenderPipeline)
       (mask GpuRenderPipeline)))
    (record Pipelines
      ((depth DepthPipelines)
       (color GpuRenderPipeline)
       (front GpuRenderPipeline)
       (back GpuRenderPipeline)
       (sky GpuRenderPipeline)))
    (record BoundMaterial
      ((group GpuBindGroup)
       (uniform GpuBuffer)
       (alpha AlphaMode)
       (both Bool)
       (draws (List DrawRange))))
    (record View
      ((buffer GpuBuffer)
       (group GpuBindGroup)))
    (record Targets
      ((w I32)
       (h I32)
       (samples I32)
       (depth Plane)
       (multi (Option Plane))
       (post Post)
       (output Plane)))
    (record Forward
      ((scene Scene)
       (env Environment)
       (module GpuShaderModule)
       (layouts (List GpuPipelineLayout))
       (camera View)
       (shadow-cameras (List View))
       (shadow GpuTexture)
       (shadow-layers (List GpuTextureView))
       (shadow-view GpuTextureView)
       (depth-1x DepthPipelines)
       (pipes Pipelines)
       (shading Shading)
       (inspect I32)
       (inspector GpuComputePipeline)
       (target Targets)
       (materials (Array BoundMaterial))
       (opaque (List BoundMaterial))
       (blend (List DrawRange))
       (frame GpuBuffer)
       (sources GpuBuffer)
       (directions I64)
       (ibl-sampler GpuSampler)
       (lut Plane)
       (lighting GpuBindGroup)))
    (define camera-shape (→ (Shape Camera3D)) (shape))
    (define light-shape (→ (Shape Lighting)) (shape))
    (define (uniform (gpu Gpu) (name String) (size I64)) (→ GpuBuffer)
      (uniform-buffer gpu name (make-array size (i32->u8 0))))
    (define (group (gpu Gpu)
                   (pipe GpuRenderPipeline)
                   (index I32)
                   (label String)
                   (items (List BindGroupEntry)))
      (→ GpuBindGroup)
      ((● gpu create-bind-group) (new BindGroupDescriptor (pipeline (RenderPipeline pipe))
                                      (group index) (label label) (entries items))))
    (define (layouts (gpu Gpu)) (→ (List GpuPipelineLayout))
      (let* ((camera (list (UniformBinding)))
             (material (list (UniformBinding) (FilterSampler) (FloatTexture) (FloatTexture)
                             (FloatTexture) (FloatTexture) (FloatTexture)))
             (light (list (UniformBinding) (DepthArray) (CubeTexture) (FloatTexture) (FilterSampler)
                          (UniformBinding)
                          (FloatTexture)
                          (UniformBinding)
                          (UniformBinding)
                          (UnfilterableTexture))))
        (map (lambda (groups) ((● gpu create-layout) "forward/layout" groups))
             (list (list camera) (list camera material) (list camera material light)))))
    (define (attributes) (→ (List VertexBufferLayout))
      (list (new VertexBufferLayout (stride 48) (step (PerVertex))
                 (attributes (map (lambda (i) (new VertexAttribute (format (Float32x4))
                                                   (location (i64->i32 i))
                                                   (offset (i64->i32 (* 16 i)))))
                                  (iota 3))))))
    ;; Depth pipelines depend only on vertex layout, coverage, culling, and
    ;; sample count. Camera and light views bind the same geometry and uniforms.
    (define (depth-pipelines (gpu Gpu) (module GpuShaderModule) (ls (List GpuPipelineLayout))
                             (samples I32)) (→ DepthPipelines)
                             (let ((pipe (lambda ((label String) (mask Bool) (cull CullMode))
                                           (→ GpuRenderPipeline)
                                           ((● gpu create-raster-pipeline)
                                            (list-ref ls (if mask 1 0))
                                            samples
                                            (new RenderPipelineDescriptor
                                              (label label)
                                              (module module)
                                              (vertex-entry
                                               (if mask "cutout_vertex" "depth_vertex"))
                                              (buffers (attributes))
                                              (fragment (if mask
                                                            (Some (new FragmentState
                                                                    (entry "cutout_depth")
                                                                    (targets (Nil))))
                                                            (None)))
                                              (topology (TriangleList)) (cull cull)
                                              (depth (Some (new DepthState
                                                             (format (Depth32Float))
                                                             (write #t)
                                                             (compare (CompareLess))))))))))
                               (new DepthPipelines (solid (pipe "depth/opaque" #f (CullBack)))
                                    (two-sided (pipe "depth/two-sided" #f (CullNone)))
                                    (mask (pipe "depth/cutout" #t (CullNone))))))
    (define (pipelines (gpu Gpu) (module GpuShaderModule) (ls (List GpuPipelineLayout))
                       (one DepthPipelines) (samples I32)) (→ Pipelines)
                       (unless (or (= samples 1) (= samples 4))
                         (panic "raster samples must be 1 or 4"))
                       (let ((pipe (lambda ((name String)
                                            (vertex String)
                                            (fragment String)
                                            (cull CullMode)
                                            (blend Bool))
                                     (→ GpuRenderPipeline)
                                     ((● gpu create-raster-pipeline) (list-ref ls 2) samples
                                      (new RenderPipelineDescriptor
                                        (label (string-append "forward/" name))
                                        (module module)
                                        (vertex-entry vertex)
                                        (buffers (if (string=? vertex "background_vertex")
                                                     (Nil)
                                                     (attributes)))
                                        (fragment (Some (new FragmentState
                                                          (entry fragment)
                                                          (targets (list (Some (new ColorTarget
                                                                                 (format
                                                                                  (Rgba16Float))
                                                                                 (blend (if blend
                                                                                            (Some
                                                                                             over)
                                                                                            (None))))))))))
                                        (topology (TriangleList))
                                        (cull cull)
                                        (depth (Some (new DepthState (format (Depth32Float))
                                                          (write #f)
                                                          (compare (if blend
                                                                       (CompareLessEqual)
                                                                       (CompareEqual)))))))))))
                         (new Pipelines
                           (depth (if (= samples 1) one (depth-pipelines gpu module ls samples)))
                           (color (pipe "opaque-color" "mesh_vertex" "shade" (CullNone) #f))
                           (back (pipe "transparent-back" "mesh_vertex" "shade" (CullFront) #t))
                           (front (pipe "transparent-front" "mesh_vertex" "shade" (CullBack) #t))
                           (sky (pipe "sky" "background_vertex" "background" (CullNone) #f)))))
    (define (make-view (gpu Gpu) (pipe GpuRenderPipeline)) (→ View)
      (let ((b (uniform gpu "forward/view" (stride camera-shape))))
        (new View
          (buffer b)
          (group (group gpu pipe 0 "forward/view" (list (BufferEntry 0 b 0 0)))))))
    (define (map-entry (s Scene) (slot I32) (index I64)) (→ BindGroupEntry)
      (let ((i (if (< index 0) (- (array-length (● s images maps)) 1) index)))
        (TextureEntry slot (● (array-ref (● s images maps) i) view))))
    (define (bind-material (gpu Gpu)
                           (s Scene)
                           (pipe GpuRenderPipeline)
                           (m Material)
                           (draws (List DrawRange)))
      (→ BoundMaterial)
      (let* ((b (uniform-buffer gpu
                                "forward/material"
                                (pod-bytes material-shape (surface-material m))))
             (bg (group gpu
                        pipe
                        1
                        "forward/material"
                        (list (BufferEntry 0 b 0 0) (SamplerEntry 1 (● s images sampler))
                              (map-entry s 2 (● m base-texture))
                              (map-entry s 3 (● m metal-rough-texture))
                              (map-entry s 4 (● m normal-texture))
                              (map-entry s 5 (● m emissive-texture))
                              (map-entry s 6 (● m occlusion-texture))))))
        (new BoundMaterial
          (group bg)
          (uniform b)
          (alpha (● m alpha))
          (both (● m double-sided))
          (draws draws))))
    (define (make-materials (gpu Gpu) (scene Scene) (pipe GpuRenderPipeline))
      (→ (Array BoundMaterial))
      (let ((buckets (make-array (length (● scene materials)) (ann (Nil) (List DrawRange)))))
        (for-each (lambda (r) (let ((m (● r material)))
                                (array-set! buckets m (Cons r (array-ref buckets m)))))
                  (● scene draws))
        (list->array (map-indexed (lambda (i m)
                                    (bind-material gpu
                                                   scene
                                                   pipe
                                                   m
                                                   (reverse (array-ref buckets i))))
                                  (● scene materials)))))
    (define (multi-plane (gpu Gpu) (name String) (fmt TextureFormat) (samples I32) (w I32) (h I32))
      (→ Plane)
      (let ((t ((● gpu create-multisample-texture)
                samples
                (new TextureDescriptor (label name) (width w)
                     (height h) (mips 1) (layers 1) (format fmt)
                     (usage (if (= samples 1)
                                (list (RenderAttachment) (TextureCopySrc))
                                (list (RenderAttachment))))))))
        (new Plane (texture t) (view (view-of gpu t 1)))))
    (define (targets (gpu Gpu) (post Post) (w I32) (h I32) (samples I32)) (→ Targets)
      (new Targets (w w) (h h) (samples samples) (post post)
           (output (display-plane gpu w h))
           (depth (multi-plane gpu "forward/depth" (Depth32Float) samples w h))
           (multi (if (= samples 1)
                      (None)
                      (Some (multi-plane gpu "forward/msaa" (Rgba16Float) samples w h))))))
    (define (lighting-group (gpu Gpu)
                            (p GpuRenderPipeline)
                            (frame GpuBuffer)
                            (shadows GpuTextureView)
                            (env Environment)
                            (sampler GpuSampler)
                            (lut Plane)
                            (scene Scene)
                            (sources GpuBuffer))
      (→ GpuBindGroup)
      (group gpu p 2 "forward/lighting" (list (BufferEntry 0 frame 0 0) (TextureEntry 1 shadows)
                                              (TextureEntry 2 (● env cube view))
                                              (TextureEntry 3 (● lut view))
                                              (SamplerEntry 4 sampler)
                                              (BufferEntry 5 (● env diffuse) 0 0)
                                              (TextureEntry 6 (● scene ground-layer view))
                                              (BufferEntry 7 (● scene ground-frame) 0 0)
                                              (BufferEntry 8 sources 0 0)
                                              (TextureEntry 9 (● scene lights plane view)))))
    (define (make-forward (gpu Gpu) (scene Scene) (env Environment)
                          (w I32) (h I32) (samples I32) (curve Tone)) (→ Forward)
                          (let* ((module ((● gpu create-shader-module)
                                          (new ShaderModuleDescriptor (label "forward/material")
                                               (code (string-append (declarations camera-shape)
                                                                    (declarations material-shape)
                                                                    (declarations light-shape)
                                                                    forward-shader
                                                                    ground-layer-shader
                                                                    water-shader)))))
                                 (ls (layouts gpu)) (one (depth-pipelines gpu module ls 1))
                                 (p (pipelines gpu module ls one samples))
                                 (mats (make-materials gpu scene (● p color)))
                                 (shadow ((● gpu create-texture)
                                          (new TextureDescriptor (label "shadow/cascades")
                                               (width 1024)
                                               (height 1024)
                                               (layers 3)
                                               (mips 1)
                                               (format (Depth32Float))
                                               (usage (list (TextureBinding)
                                                            (RenderAttachment)
                                                            (TextureCopySrc))))))
                                 (sv (array-view gpu shadow)) (lut (make-brdf gpu))
                                 (frame (uniform gpu "forward/lights" (stride light-shape)))
                                 (sources (uniform gpu "forward/sources" 96))
                                 (samp ((● gpu create-sampler)
                                        (new SamplerDescriptor
                                          (label "ibl/clamp")
                                          (mag-filter (Linear))
                                          (min-filter (Linear))
                                          (mipmap-filter (Linear))
                                          (address (ClampToEdge))))))
                            (new Forward (scene scene) (env env) (module module) (layouts ls)
                                 (camera (make-view gpu (● one solid)))
                                 (shadow-cameras
                                  (map (lambda (_) (make-view gpu (● one solid))) (iota 3)))
                                 (shadow shadow)
                                 (shadow-view sv)
                                 (shadow-layers
                                  (map (lambda (i) (layer-view gpu shadow (i64->i32 i))) (iota 3)))
                                 (depth-1x one) (pipes p) (shading (MetallicRoughness)) (inspect -1)
                                 (inspector (compute-kernel gpu module "shadow" "inspect_cascade"))
                                 (target
                                  (targets gpu (make-post gpu (Rgba8Unorm) w h curve) w h samples))
                                 (materials mats) (opaque (opaque-materials mats))
                                 (blend (blended-draws scene mats))
                                 (frame frame)
                                 (sources sources)
                                 (directions 0)
                                 (ibl-sampler samp)
                                 (lut lut)
                                 (lighting (lighting-group gpu
                                                           (● p color)
                                                           frame
                                                           sv
                                                           env
                                                           samp
                                                           lut
                                                           scene
                                                           sources)))))
    (define (opaque-materials (mats (Array BoundMaterial))) (→ (List BoundMaterial))
      (filter (lambda (m) (not (blended-material? (● m alpha)))) (array->list mats)))
    (define (blended-draws (scene Scene) (mats (Array BoundMaterial))) (→ (List DrawRange))
      (filter (lambda (mesh) (blended-material? (● (array-ref mats (● mesh material)) alpha)))
              (● scene draws)))
    (define (release-materials (gpu Gpu) (mats (Array BoundMaterial))) (→ Unit)
      (for-each (lambda (m) ((● gpu destroy) (BindGroupObject (● m group)))
                        ((● gpu destroy) (BufferObject (● m uniform)))) (array->list mats)))
    ;; Sector swaps keep pipelines, shadow maps and all output textures.
    (define (set-scene! (gpu Gpu) (r Forward) (scene Scene)) (→ Unit)
      (let ((mats (make-materials gpu scene (● r pipes color))))
        (release-materials gpu (● r materials))
        (set! (● r materials) mats) (set! (● r scene) scene)
        (set! (● r opaque) (opaque-materials mats)) (set! (● r blend) (blended-draws scene mats))
        (set-environment! gpu r (● r env))))
    (define (set-environment! (gpu Gpu) (r Forward) (env Environment)) (→ Unit)
      (let ((group (lighting-group gpu (● r pipes color) (● r frame) (● r shadow-view) env
                                   (● r ibl-sampler) (● r lut) (● r scene) (● r sources))))
        ((● gpu destroy) (BindGroupObject (● r lighting)))
        (set! (● r lighting) group)
        (set! (● r env) env)))
    (define (f4 (p V3) (w F64)) (→ Vec4f)
      (new Vec4f
        (x (f64->f32 (● p x)))
        (y (f64->f32 (● p y)))
        (z (f64->f32 (● p z)))
        (w (f64->f32 w))))
    (define (set-directional-lights! (gpu Gpu) (r Forward) (directions (List Light))) (→ Unit)
      (when (> (length directions) 3) (panic "too many directional lights"))
      (unless (null? directions)
        ((● gpu write-buffer) (● r sources) 0 (pack (ann (shape) (Shape Vec4f))
                                                    (concatenate (map (lambda (l)
                                                                        (list
                                                                         (f4 (● l position) 0.0)
                                                                         (f4 (● l power) 0.0)))
                                                                      directions)))))
      (set! (● r directions) (length directions)))
    (define (release-depth (gpu Gpu) (p DepthPipelines)) (→ Unit)
      (for-each (lambda (pipe) ((● gpu destroy) (PipelineObject pipe)))
                (list (● p solid) (● p two-sided) (● p mask))))
    (define (release-pipes (gpu Gpu) (p Pipelines) (samples I32)) (→ Unit)
      ;; The renderer owns its 1× set for its entire lifetime, including when the camera uses 4×.
      (unless (= samples 1) (release-depth gpu (● p depth)))
      (for-each (lambda (pipe) ((● gpu destroy) (PipelineObject pipe)))
                (list (● p color) (● p back) (● p front) (● p sky))))
    (define (release-targets (gpu Gpu) (t Targets)) (→ Unit)
      (release-plane gpu (● t output))
      (release-plane gpu (● t depth))
      (match (● t multi) ((Some p) (release-plane gpu p)) ((None) (unit))))
    (define (resize-forward (gpu Gpu) (r Forward) (w I32) (h I32) (samples I32)) (→ Forward)
      (let ((t (● r target)))
        (unless (and (= w (● t w)) (= h (● t h)) (= samples (● t samples)))
          (unless (or (= samples 1) (= samples 4)) (panic "raster samples must be 1 or 4"))
          (release-targets gpu t)
          (unless (= samples (● t samples))
            (release-pipes gpu (● r pipes) (● t samples))
            (set! (● r pipes) (pipelines gpu (● r module) (● r layouts) (● r depth-1x) samples)))
          (set! (● r target) (targets gpu (resize-post gpu (● t post) w h) w h samples))) r))
    (define (as-v3 (p Vec4f)) (→ V3) (v3 (f32->f64 (● p x)) (f32->f64 (● p y)) (f32->f64 (● p z))))
    (define (gpu-point (p V3)) (→ Vec3f)
      (new Vec3f (x (f64->f32 (● p x))) (y (f64->f32 (● p y))) (z (f64->f32 (● p z)))))
    (define (shadow-camera (cam Camera3D) (sun V3) (distance F64) (radius F64)) (→ Camera3D)
      (let* ((center (v+ (as-v3 (● cam eye)) (scaled (as-v3 (● cam forward)) distance)))
             (right (unit-vector
                     (cross (if (> (abs (● sun y)) 0.999) (v3 0.0 0.0 -1.0) (v3 0.0 1.0 0.0)) sun)))
             (up (cross sun right)) (texel (/ (* 2.0 radius) 1024.0))
             (snap (lambda ((axis V3)) (→ V3) (let ((x (dot center axis)))
                                                (scaled axis (- (* texel (round (/ x texel))) x)))))
             (target (v+ center (v+ (snap right) (snap up)))))
        (camera-3d (gpu-point (v+ target (scaled sun (max 80.0 (* radius 2.0))))) (gpu-point target)
                   (Parallel (* radius 2.0)) 1.0 0.0)))
    (define (cascade-views (cam Camera3D) (sun V3)) (→ (List Camera3D))
      (map (lambda (split) (shadow-camera cam sun (● split first) (● split second)))
           (list (new Pair (first 7.0) (second 19.0)) (new Pair (first 28.0) (second 58.0))
                 (new Pair (first 91.0) (second 178.0)))))
    (define (transparent-order (draws (List DrawRange)) (eye Vec4f)) (→ (List DrawRange))
      (let ((dist (lambda ((r DrawRange)) (→ F32) (let ((x (- (● r center x) (● eye x)))
                                                        (y (- (● r center y) (● eye y)))
                                                        (z (- (● r center z) (● eye z))))
                                                    (+ (* x x) (+ (* y y) (* z z)))))))
        (map (lambda (kv) (● kv second))
             (list-sort (lambda (a b) (> (● a first) (● b first)))
                        (map (lambda (r) (new Pair (first (dist r)) (second r))) draws)))))
    (define (bind-mesh (gpu Gpu) (pass GpuRenderPass) (r Forward) (view View)) (→ Unit)
      ((● gpu set-bind-group) pass 0 (● view group))
      ((● gpu set-vertex-buffer) pass 0 (● r scene vertices) 0)
      ((● gpu set-index-buffer) pass (● r scene indices) (Uint32Index) 0))
    (define (draw-mesh (gpu Gpu) (pass GpuRenderPass) (range DrawRange)) (→ Unit)
      ((● gpu draw-indexed) pass (● range count) 1 (● range first) 0 0))
    (define (draw-depth (gpu Gpu)
                        (r Forward)
                        (encoder GpuCommandEncoder)
                        (target GpuTextureView)
                        (view View)
                        (p DepthPipelines))
      (→ Unit)
      (let ((pass ((● gpu begin-render-pass) encoder (new RenderPassDescriptor (colors (Nil))
                                                          (depth (Some (new DepthAttachment
                                                                         (view target)
                                                                         (load (ClearDepth 1.0))
                                                                         (store #t))))))))
        (bind-mesh gpu pass r view)
        (for-each (lambda (m)
                    (match (● m alpha)
                      ((MaskedMaterial)
                       ((● gpu set-pipeline) pass (● p mask))
                       ((● gpu set-bind-group) pass 1 (● m group)))
                      ((OpaqueMaterial)
                       ((● gpu set-pipeline) pass (if (● m both) (● p two-sided) (● p solid))))
                      ((BlendedMaterial) (panic "blended mesh in opaque depth list")))
                    (for-each (lambda (mesh) (draw-mesh gpu pass mesh)) (● m draws))) (● r opaque))
        ((● gpu end-pass) pass)))
    (define (draw-color (gpu Gpu) (r Forward) (encoder GpuCommandEncoder) (cam Camera3D)) (→ Unit)
      (let* ((t (● r target)) (hdr (● t post targets light-view)) (p (● r pipes))
             (pass (begin-forward-pass gpu encoder hdr (● t multi)
                                       (new Color (red 0.0) (green 0.0) (blue 0.0) (alpha 1.0))
                                       (Some (new DepthAttachment
                                               (view (● t depth view))
                                               (load (ReadOnlyDepth))
                                               (store #t))))))
        (bind-mesh gpu pass r (● r camera))
        ((● gpu set-bind-group) pass 2 (● r lighting))
        ((● gpu set-pipeline) pass (● p sky))
        ((● gpu set-bind-group) pass 1 (● (array-ref (● r materials) 0) group))
        ((● gpu draw) pass 3 1 0 0)
        ((● gpu set-pipeline) pass (● p color))
        (for-each (lambda (m) ((● gpu set-bind-group) pass 1 (● m group))
                          (for-each (lambda (mesh) (draw-mesh gpu pass mesh)) (● m draws)))
                  (● r opaque))
        (for-each (lambda (mesh) (let ((m (array-ref (● r materials) (● mesh material))))
                                   ((● gpu set-bind-group) pass 1 (● m group))
                                   (when (● m both)
                                     ((● gpu set-pipeline) pass (● p back))
                                     (draw-mesh gpu pass mesh))
                                   ((● gpu set-pipeline) pass (● p front))
                                   (draw-mesh gpu pass mesh)))
                  (transparent-order (● r blend) (● cam eye)))
        ((● gpu end-pass) pass)))
    ;; A diagnostic copies the chosen cascade into the same owned output.
    (define (draw-inspector (gpu Gpu) (encoder GpuCommandEncoder) (r Forward)) (→ Unit)
      (let* ((t (● r target)) (p (● r inspector))
             (g (kernel-group gpu p 0 "shadow/inspect"
                              (list (TextureEntry 4 (● r shadow-view))
                                    (TextureEntry 5 (● t output view))
                                    (BufferEntry 6 (● r frame) 0 0))))
             (pass ((● gpu begin-compute-pass) encoder)))
        ((● gpu set-compute-pipeline) pass p) ((● gpu set-compute-bind-group) pass 0 g)
        (dispatch-texels gpu pass (● t w) (● t h)) ((● gpu end-compute-pass) pass)
        ((● gpu destroy) (BindGroupObject g))))
    (define (draw-forward (gpu Gpu) (encoder GpuCommandEncoder) (r Forward) (cam Camera3D)
                          (exposure F32) (shadows Bool)) (→ Plane)
                          (let* ((e (● r env)) (sun (● e sun))
                                 (cams (cascade-views cam sun))
                                 (matrix (lambda ((i I64))
                                           (→ Mat4x4f)
                                           (● (list-ref cams i) view-projection)))
                                 (frame (new Lighting
                                          (near-map (matrix 0))
                                          (mid-map (matrix 1))
                                          (far-map (matrix 2))
                                          (sun (f4 sun (● e disc)))
                                          (key (f4 (● e color) (f32->f64 exposure)))
                                          (splits (new Vec4f
                                                    (x 14.0)
                                                    (y 46.0)
                                                    (z 140.0)
                                                    (w (if shadows 1.0 0.0))))
                                          (counts (new Vec4f
                                                    (x (i64->f32 (● r directions)))
                                                    (y (if (● r scene local-lights) 1.0 0.0))
                                                    (z (match (● r shading)
                                                         ((BlinnPhong) 1.0)
                                                         (_ 0.0)))
                                                    (w (i32->f32 (● r inspect))))))))
                            ((● gpu write-buffer) (● r frame) 0 (pod-bytes light-shape frame))
                            ((● gpu write-buffer)
                             (● r camera buffer)
                             0
                             (pod-bytes camera-shape cam))
                            (when (or shadows (>= (● r inspect) 0))
                              (for-each (lambda (i) (let ((v (list-ref (● r shadow-cameras) i)))
                                                      ((● gpu write-buffer)
                                                       (● v buffer)
                                                       0
                                                       (pod-bytes camera-shape (list-ref cams i)))
                                                      (draw-depth gpu
                                                                  r
                                                                  encoder
                                                                  (list-ref (● r shadow-layers) i)
                                                                  v
                                                                  (● r depth-1x))))
                                        (iota 3)))
                            (if (>= (● r inspect) 0) (draw-inspector gpu encoder r)
                                (begin
                                  (draw-depth gpu
                                              r
                                              encoder
                                              (● r target depth view)
                                              (● r camera)
                                              (● r pipes depth))
                                  (draw-color gpu r encoder cam)
                                  (draw-post gpu
                                             encoder
                                             (● r target output view)
                                             (● r target post))))
                            (● r target output)))
    (define (release-forward (gpu Gpu) (r Forward)) (→ Unit)
      (release-pipes gpu (● r pipes) (● r target samples)) (release-depth gpu (● r depth-1x))
      (release-targets gpu (● r target)) (release-post gpu (● r target post))
      (release-plane gpu (● r lut))
      (for-each (lambda (v) ((● gpu destroy) (ViewObject v))) (● r shadow-layers))
      (for-each (lambda (v) ((● gpu destroy) (BufferObject (● v buffer)))
                        ((● gpu destroy) (BindGroupObject (● v group))))
                (Cons (● r camera) (● r shadow-cameras)))
      (release-materials gpu (● r materials))
      (for-each (lambda (layout) ((● gpu destroy) (PipelineLayoutObject layout))) (● r layouts))
      (for-each (lambda (obj) ((● gpu destroy) obj))
                (list (ComputePipelineObject (● r inspector))
                      (ModuleObject (● r module))
                      (TextureObject (● r shadow))
                      (ViewObject (● r shadow-view))
                      (BufferObject (● r frame))
                      (BufferObject (● r sources))
                      (SamplerObject (● r ibl-sampler))
                      (BindGroupObject (● r lighting)))))))
