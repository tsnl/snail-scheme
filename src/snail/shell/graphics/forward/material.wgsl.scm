;; Every draw is of instances: a mesh's vertices are in its own space, and
;; each instance's record names its first bone and its material frame. A
;; vertex is placed by its instance's bone; a static scene is one instance
;; whose bone is the identity, and whose frame changes nothing.
((var uniform) (@group 0) (@binding 0) (camera Camera3D))
((var storage read) (@group 0) (@binding 1) (bones (array mat4x4f)))
((var storage read) (@group 0) (@binding 2) (frames (array MaterialFrame)))
((var uniform) (@group 1) (@binding 0) (material SurfaceMaterial))
(var (@group 1) (@binding 1) (repeat sampler))
(var (@group 1) (@binding 2) (base_map (texture_2d f32)))
(var (@group 1) (@binding 3) (mr_map (texture_2d f32)))
(var (@group 1) (@binding 4) (normal_map (texture_2d f32)))
(var (@group 1) (@binding 5) (emission_map (texture_2d f32)))
(var (@group 1) (@binding 6) (ao_map (texture_2d f32)))

((var uniform) (@group 2) (@binding 0) (light Lighting))
(var (@group 2) (@binding 1) (shadow texture_depth_2d_array))
(var (@group 2) (@binding 2) (sky (texture_cube f32)))
(var (@group 2) (@binding 3) (lut (texture_2d f32)))
(var (@group 2) (@binding 4) (linear_clamp sampler))
((var uniform) (@group 2) (@binding 5) (sh (array vec4f 9)))
(var (@group 2) (@binding 6) (ground_layer (texture_2d f32)))
((var uniform) (@group 2) (@binding 7) (ground_frame vec4f))
((var uniform) (@group 2) (@binding 8) (sources (array vec4f 6)))

(var (@group 2) (@binding 9) (fixtures (texture_2d f32)))

(struct VertexIn
        ((@location 0) pos_u vec4f)
        ((@location 1) norm_v vec4f)
        ((@location 2) tangent vec4f)
        ((@location 3) placing vec2u))
(struct Surface ((@invariant) (@builtin position) clip vec4f) ((@location 0) world vec3f)
        ((@location 1) normal vec3f) ((@location 2) uv vec2f) ((@location 3) tangent vec4f)
        ((@location 4) (@interpolate flat) frame u32))
;; The instance's bone, the vertex placed by it, and its normal and tangent
;; turned with it. The cofactors, signed by the determinant, turn a normal
;; even under a nonuniform scale or a mirror.
(fn bone_of ((v VertexIn)) (-> mat4x4f) (return (at bones (get v placing x))))
(fn world_of ((v VertexIn)) (-> vec3f)
    (return (get (* (bone_of v) (vec4f (get v pos_u xyz) 1.0)) xyz)))
(fn normal_of ((v VertexIn)) (-> vec3f)
    (let m (bone_of v))
    (let a (get (at m 0) xyz))
    (let b (get (at m 1) xyz))
    (let c (get (at m 2) xyz))
    (let flip (select 1.0 -1.0 (< (dot a (cross b c)) 0.0)))
    (return (* (* (mat3x3f (cross b c) (cross c a) (cross a b)) (get v norm_v xyz)) flip)))
(fn tangent_of ((v VertexIn)) (-> vec4f)
    (let m (bone_of v))
    (let a (get (at m 0) xyz))
    (let b (get (at m 1) xyz))
    (let c (get (at m 2) xyz))
    (let flip (select 1.0 -1.0 (< (dot a (cross b c)) 0.0)))
    (return (vec4f (* (mat3x3f a b c) (get v tangent xyz)) (* flip (get v tangent w)))))
(fn clip_position ((v VertexIn)) (-> vec4f)
    (return (* (get camera view_projection) (vec4f (world_of v) 1.0))))
;; A frame shows a region of the material's images: its offset, then its size.
(fn mesh_uv ((v VertexIn)) (-> vec2f)
    (let region (get (at frames (get v placing y)) region))
    (return (+ (get region xy) (* (vec2f (get v pos_u w) (get v norm_v w)) (get region zw)))))
(fn (@vertex) mesh_vertex ((v VertexIn)) (-> Surface)
    (var (o Surface))
    (= (get o clip) (clip_position v))
    (= (get o world) (world_of v)) (= (get o uv) (mesh_uv v))
    (= (get o normal) (normal_of v)) (= (get o tangent) (tangent_of v))
    (= (get o frame) (get v placing y)) (return o))
(fn (@vertex) depth_vertex ((v VertexIn)) (-> (@invariant) (@builtin position) vec4f)
    (return (clip_position v)))
(struct Cutout ((@invariant) (@builtin position) clip vec4f) ((@location 2) uv vec2f)
        ((@location 4) (@interpolate flat) frame u32))
(fn (@vertex) cutout_vertex ((v VertexIn)) (-> Cutout)
    (return (Cutout (clip_position v) (mesh_uv v) (get v placing y))))
(fn visible_side ((front bool)) (-> bool) (return (or front (!= (get material flags x) 0))))
;; A frame's tint scales the base color, and its alpha the opacity.
(fn opacity ((frame u32)) (-> f32) (return (get (at frames frame) tint w)))
(fn covers ((texture_alpha f32) (frame u32)) (-> bool)
    (return
     (>= (* texture_alpha (get material base_color w) (opacity frame)) (get material emissive w))))
(fn (@fragment) cutout_depth ((s Cutout) ((@builtin front_facing) front bool))
    (let uv (get s uv))
    (let a (get (textureSampleGrad base_map repeat uv (dpdx uv) (dpdy uv)) a))
    (if ((or (not (visible_side front)) (not (covers a (get s frame)))) (discard))))
(fn decoded ((c vec3f)) (-> vec3f)
    (return (select (pow (/ (+ c 0.055) 1.055) (vec3f 2.4)) (/ c 12.92) (<= c (vec3f 0.04045)))))
(fn irradiance ((d vec3f)) (-> vec3f)
    (let x (get d x)) (let y (get d y)) (let z (get d z))
    (return (max (vec3f 0.0)
                 (+ (* (get (at sh 0) xyz) 0.2820948) (* (get (at sh 1) xyz) 0.4886025 y)
                    (* (get (at sh 2) xyz) 0.4886025 z) (* (get (at sh 3) xyz) 0.4886025 x)
                    (* (get (at sh 4) xyz) 1.0925484 x y) (* (get (at sh 5) xyz) 1.0925484 y z)
                    (* (get (at sh 6) xyz) 0.3153916 (- (* 3.0 z z) 1.0))
                    (* (get (at sh 7) xyz) 1.0925484 x z)
                    (* (get (at sh 8) xyz) 0.5462742 (- (* x x) (* y y)))))))
(fn pcf ((p vec3f) (n vec3f) (index i32)) (-> f32)
    (var vp (get light near_map))
    (if ((== index 1) (= vp (get light mid_map))) ((== index 2) (= vp (get light far_map))))
    (let h (* vp (vec4f p 1.0))) (let q (/ (get h xyz) (get h w)))
    (let uv (+ (* (get q xy) (vec2f 0.5 -0.5)) 0.5))
    (if
     ((or (any (< uv (vec2f 0.0))) (any (> uv (vec2f 1.0))) (<= (get q z) 0.0) (>= (get q z) 1.0))
      (return 1.0)))
    (let size (vec2i (textureDimensions shadow))) (let pos (- (* uv (vec2f size)) 0.5))
    (let base (vec2i (floor pos))) (let sub (fract pos))
    (let bias (*
               (+ 0.00013 (* 0.00052 (- 1.0 (abs (dot n (get light sun xyz))))))
               (+ 1.0 (* 0.25 (f32 index)))))
    (var total 0.0)
    (for ((var y -1) (<= y 1) (+= y 1))
         (for ((var x -1) (<= x 1) (+= x 1))
              (let pixel (clamp (+ base (vec2i x y)) (vec2i 0) (- size (vec2i 1))))
              (let w (*
                      (- 1.5 (abs (- (f32 x) (get sub x) -0.5)))
                      (- 1.5 (abs (- (f32 y) (get sub y) -0.5)))))
              (+= total
                  (* w
                     (select 0.0 1.0 (<= (- (get q z) bias) (textureLoad shadow pixel index 0)))))))
    (let wx (+ 1.5 (- 1.0 (abs (- (get sub x) 0.5)))))
    (let wy (+ 1.5 (- 1.0 (abs (- (get sub y) 0.5)))))
    (return (clamp (/ total (* wx wy)) 0.0 1.0)))
(fn sunlight ((p vec3f) (n vec3f)) (-> f32)
    (let d (dot (- p (get camera eye xyz)) (get camera forward xyz)))
    (if ((or (<= (get light splits w) 0.0) (>= d (get light splits z))) (return 1.0)))
    (let i (select (select 0 1 (> d (get light splits x))) 2 (> d (get light splits y))))
    (let edge (at (get light splits) i)) (let v (pcf p n i))
    (let mix_in (smoothstep (* edge 0.88) edge d))
    (if ((> mix_in 0.0) (if ((== i 2) (return (mix v 1.0 mix_in))))
         (return (mix v (pcf p n (+ i 1)) mix_in))))
    (return v))
(fn fresnel ((f0 vec3f) (vh f32)) (-> vec3f)
    (return (+ f0 (* (- (vec3f 1.0) f0) (pow (- 1.0 vh) 5.0)))))
(fn direct
    ((n vec3f)
     (v vec3f)
     (l vec3f)
     (rgb vec3f)
     (albedo vec3f)
     (f0 vec3f)
     (metal f32)
     (rough f32)
     (trans f32))
    (-> vec3f)
    (let nl (dot n l)) (let nv (max 0.001 (dot n v))) (let h (normalize (+ l v)))
    (let nh (max 0.0 (dot n h))) (let vh (max 0.0 (dot v h)))
    (if ((> (get light counts z) 0.5)
         (let shininess (clamp (- (/ 2.0 (max 0.0001 (pow rough 4.0))) 2.0) 1.0 1024.0))
         (let spec (* f0 (+ 8.0 shininess) 0.039788736 (pow nh shininess)))
         (return
          (* rgb (+ (* albedo (- 1.0 metal) 0.31830989 (max nl 0.0)) (* spec (max nl 0.0)))))))
    (let a2 (pow rough 4.0)) (let den (+ (* nh nh (- a2 1.0)) 1.0))
    (let f (fresnel f0 vh))
    (let k (/ (* (+ rough 1.0) (+ rough 1.0)) 8.0))
    (let spec (/
               (* f a2)
               (max 0.000001 (* 12.566371 den den (mix nv 1.0 k) (mix (max nl 0.0) 1.0 k)))))
    (let diffuse (* (* (- (vec3f 1.0) f) (- 1.0 metal) albedo 0.31830989)
                    (+ (* (- 1.0 trans) (max nl 0.0)) (* trans (max (- nl) 0.0)))))
    (return (* rgb (+ diffuse (* spec (max nl 0.0))))))
(fn fixture_word ((i i32) (width i32)) (-> vec4f)
    (return (textureLoad fixtures (vec2i (% i width) (/ i width)) 0)))
(fn fixture_light ((i i32) (width i32) (world vec3f) (n vec3f) (v vec3f) (color vec3f)
                   (f0 vec3f) (metal f32) (rough f32) (trans f32)) (-> vec3f)
                   (let p (fixture_word i width))
                   (let delta (- (get p xyz) world))
                   (let d2 (dot delta delta))
                   (let radius2 (* (get p w) (get p w)))
                   (if ((or (>= d2 radius2) (< d2 1e-8)) (return (vec3f 0.0))))
                   (let l (* delta (inverseSqrt d2))) (let axis (fixture_word (+ i 2) width))
                   (var fade (- 1.0 (/ d2 radius2)))
                   (if ((>= (get axis w) 0.0)
                        (*= fade
                            (smoothstep (get axis w)
                                        (mix (get axis w) 1.0 0.45)
                                        (dot (- l) (get axis xyz))))))
                   (let power (*
                               (get (fixture_word (+ i 1) width) xyz)
                               (/ (* fade fade) (max 0.04 d2))))
                   (return (direct n v l power color f0 metal rough trans)))
(fn local_light ((world vec3f) (n vec3f) (v vec3f) (color vec3f) (f0 vec3f)
                 (metal f32) (rough f32) (trans f32)) (-> vec3f)
                 (let width (i32 (get (textureDimensions fixtures) x)))
                 (let grid (fixture_word width width))
                 (let cell (vec2i (floor (/ (- (get world xz) (get grid xy)) (get grid z)))))
                 (let moving (i32 (get (fixture_word 0 width) x))) (var sum (vec3f 0.0))
                 (for ((var j 0) (< j moving) (+= j 1))
                      (+= sum
                          (fixture_light (+ 1 (* 3 j)) width world n v color f0 metal rough trans)))
                 (if ((and (all (>= cell (vec2i 0))) (all (< cell (vec2i (i32 (get grid w))))))
                      (let span (fixture_word
                                 (+ width 1 (get cell x) (* (get cell y) (i32 (get grid w))))
                                 width))
                      (for ((var j 0) (< j (i32 (get span y))) (+= j 1))
                           (+= sum
                               (fixture_light (+ (i32 (get span x)) (* 3 j))
                                              width
                                              world
                                              n
                                              v
                                              color
                                              f0
                                              metal
                                              rough
                                              trans)))))
                 (return sum))
(fn (@fragment) shade ((s Surface) ((@builtin front_facing) front bool)) (-> (@location 0) vec4f)
    (let uv (get s uv)) (let dx (dpdx uv)) (let dy (dpdy uv))
    (let wx (dpdx (get s world))) (let wy (dpdy (get s world)))
    (let base (textureSampleGrad base_map repeat uv dx dy))
    (let frame (at frames (get s frame)))
    (let alpha (* (get base a) (get material base_color w) (get frame tint w)))
    (if
     ((and (== (get material factors w) 1.0) (not (covers (get base a) (get s frame)))) (discard)))
    (if ((not (visible_side front)) (discard)))
    (let mr (textureSampleGrad mr_map repeat uv dx dy))
    (var color (* (decoded (get base rgb)) (get material base_color rgb) (get frame tint rgb)))
    (let metal (* (get material factors x) (get mr b)))
    (var rough (max 0.045 (* (get material factors y) (get mr g))))
    (var n (get s normal))
    (if ((< (dot n n) 0.001) (= n (cross wy wx))))
    (= n (* (normalize n) (select -1.0 1.0 front)))
    (if ((>= (get material textures z) 0)
         (let raw (- (* (get (textureSampleGrad normal_map repeat uv dx dy) xyz) 2.0) 1.0))
         (var t (get s tangent xyz)) (var sign (get s tangent w))
         (if ((< (dot t t) 0.001) (= t (- (* wx (get dy y)) (* wy (get dx y))))
              (= sign
                 (select -1.0
                         1.0
                         (> (- (* (get dx x) (get dy y)) (* (get dx y) (get dy x))) 0.0)))))
         (if ((> (dot t t) 1e-12) (= t (normalize (- t (* n (dot n t)))))
              (= n
                 (normalize (+ (* (get raw z) n)
                               (* (get material factors z)
                                  (+ (* t (get raw x)) (* (cross n t) sign (get raw y)))))))))))
    (if ((!= (get material flags w) 0) (let g (ground_sample (get s world)))
         (= n (ground_normal n g))
         (= color (* color (ground_tint g)))
         (= rough (ground_roughness rough g))))
    (if ((!= (get material flags y) 0)
         (let w (water_surface
                 (get s world)
                 n
                 (get camera scene_time)
                 (mat2x2f (get wx xz) (get wy xz))
                 rough))
         (= n (get w xyz)) (= rough (get w w))))
    (let v (select
            (normalize (- (get camera eye xyz) (get s world)))
            (- (get camera forward xyz))
            (> (get camera eye w) 0.5)))
    (let nv (max 0.001 (dot n v)))
    (let f0 (mix (vec3f (dielectric_f0 (!= (get material flags y) 0))) color metal))
    (let vis (sunlight (get s world) n))
    (var lit
         (direct n
                 v
                 (get light sun xyz)
                 (* vis (get light key xyz))
                 color
                 f0
                 metal
                 rough
                 (get material optics x)))
    (for ((var i 0) (< i (i32 (get light counts x))) (+= i 1))
         (let dir (get (at sources (* i 2)) xyz)) (let power (get (at sources (+ (* i 2) 1)) xyz))
         (+= lit (direct n v dir power color f0 metal rough (get material optics x))))
    (if ((> (get light counts y) 0.0)
         (+= lit (local_light (get s world) n v color f0 metal rough (get material optics x)))))
    (let ao (mix 1.0 (get (textureSampleGrad ao_map repeat uv dx dy) r) (get material optics z)))
    (let diffuse (* (irradiance n) color (- 1.0 metal) (- (vec3f 1.0) (fresnel f0 nv))))
    (let spec (get (textureSampleLevel sky linear_clamp (reflect (- v) n) (* rough 5.0)) rgb))
    (let brdf (get
               (textureSampleLevel lut linear_clamp (/ (+ (* (vec2f nv rough) 31.0) 0.5) 32.0) 0.0)
               rg))
    ;; A frame's glow adds the surface's own color, as an emissive one does.
    (let emit (+ (* (get material emissive xyz)
                    (decoded (get (textureSampleGrad emission_map repeat uv dx dy) rgb)))
                 (* color (get frame light x))))
    (return (vec4f (* (+ emit lit (* ao (+ diffuse (* spec (+ (* f0 (get brdf x)) (get brdf y))))))
                      (get light key w))
                   (select 1.0 alpha (== (get material factors w) 2.0)))))
(struct SkyVertex ((@builtin position) clip vec4f) ((@location 0) xy vec2f))
(fn (@vertex) background_vertex (((@builtin vertex_index) i u32)) (-> SkyVertex)
    (let xy (- (* (vec2f (f32 (bit-and i 1u)) (f32 (>> i 1u))) 4.0) 1.0))
    (var (o SkyVertex)) (= (get o xy) xy) (= (get o clip) (vec4f xy 1.0 1.0)) (return o))
(fn (@fragment) background ((s SkyVertex)) (-> (@location 0) vec4f)
    (let w (* (get camera inverse) (vec4f (get s xy) 1.0 1.0)))
    (let d (select
            (normalize (- (/ (get w xyz) (get w w)) (get camera eye xyz)))
            (get camera forward xyz)
            (> (get camera eye w) 0.5)))
    (let c (get (textureSampleLevel sky linear_clamp d 0.0) rgb))
    (let disc (smoothstep
               (get light sun w)
               (+ (get light sun w) 0.00008)
               (dot d (get light sun xyz))))
    (return (vec4f (* (+ c (* disc (get light key xyz) 5.0)) (get light key w)) 1.0)))

;; The inspector reads the actual depth array. White is an untouched texel.
(var (@group 0) (@binding 4) (inspect_map texture_depth_2d_array))
(var (@group 0) (@binding 5) (inspect_output (texture_storage_2d rgba8unorm write)))
((var uniform) (@group 0) (@binding 6) (inspect_light Lighting))
(fn (@compute) (@workgroup_size 8 8) inspect_cascade (((@builtin global_invocation_id) id vec3u))
    (let dim (textureDimensions inspect_output))
    (if ((any (>= (get id xy) dim)) (return)))
    (let uv (/ (+ (vec2f (get id xy)) 0.5) (vec2f dim)))
    (let xy (vec2i (* uv (vec2f (textureDimensions inspect_map)))))
    (let d (textureLoad inspect_map xy (i32 (get inspect_light counts w)) 0))
    (textureStore inspect_output (get id xy) (vec4f (vec3f d) 1.0)))
