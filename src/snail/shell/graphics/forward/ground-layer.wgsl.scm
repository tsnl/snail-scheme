;; Each scene declares its texture and world-XZ frame in the appropriate group.
(fn ground_sample ((p vec3f)) (-> vec4f)
    (let uv (* (- (get p xz) (get ground_frame xy)) (get ground_frame zw)))
    (if ((or (<= (get ground_frame z) 0.0) (any (< uv (vec2f 0.0))) (any (>= uv (vec2f 1.0))))
         (return (vec4f 0.0))))
    (return (textureSampleLevel ground_layer repeat uv 0.0)))
(fn ground_normal ((base vec3f) (layer vec4f)) (-> vec3f)
    (let amount (max (get layer w) (get layer z)))
    (if ((< amount 0.004) (return base)))
    (let slopes (- (* (get layer xy) 2.0) 1.0))
    (let base_n (normalize (mix base (vec3f 0.0 1.0 0.0) (get layer z))))
    (return (normalize (+ base_n (* amount (vec3f (get slopes x) 0.0 (get slopes y)))))))
(fn ground_roughness ((base f32) (layer vec4f)) (-> f32)
    (return (mix (mix base 0.43 (get layer w)) 0.075 (get layer z))))
(fn ground_tint ((layer vec4f)) (-> vec3f)
    (return (mix (mix (vec3f 1.0) (vec3f 0.46 0.32 0.23) (get layer w))
                 (vec3f 0.20 0.16 0.12) (get layer z))))
