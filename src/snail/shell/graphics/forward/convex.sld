;; A transparent draw is one consistently wound convex shell or planar polygon. Weld UV and
;; normal seams by their positions for this construction-time test only.
(define-library (snail shell graphics forward convex)
  (export check-transparent-meshes convex-shell?)
  (import
   (snail core base)
   (snail core table)
   (only (snail shell game rigid-body) V3 v3 v+ v- scaled dot cross squared unit-vector)
   (snail shell build-mode)
   (snail shell graphics gltf))
  (begin
    (record Edge
      ((a I64)
       (b I64)
       (face I64)
       (opposite V3)
       (used Bool)))
    (record Shell
      ((verts (Table I64))
       (edges (Table Edge))
       (volume F64)
       (folds (List F64))))
    (define (point (v (List F64))) (→ V3)
      (unless (and (= (length v) 3) (every? (lambda (x) (<= (abs x) 3.4028234663852886e38)) v))
        (unreadable "invalid transparent vertex position"))
      (v3 (list-ref v 0) (list-ref v 1) (list-ref v 2)))
    (define (component-key (v F64)) (→ String)
      (show (if (= v 0.0) (ann 0 I32) (f32->bits (f64->f32 v)))))
    (define (position-key (p V3)) (→ String)
      (string-join (list (component-key (● p x)) (component-key (● p y)) (component-key (● p z)))
                   "/"))
    (define (root (parents (Array I64)) (i I64)) (→ I64)
      (let ((p (array-ref parents i))) (if (= p i) i (root parents p))))
    (define (convex-shell? (vertices (List (List F64))) (indices (List I64))) (→ Bool)
      (match (attempt-reading
              (lambda () (validate-shell (list->array (map point vertices)) indices)))
        ((Ok _) #t) ((Err _) #f)))
    (define (validate-shell (p (Array V3)) (indices (List I64))) (→ Unit)
      (unless (and (> (length indices) 0) (= (remainder (length indices) 3) 0)
                   (every? (lambda (i) (and (>= i 0) (< i (array-length p)))) indices))
        (unreadable "invalid transparent triangle indices"))
      (let* ((ix (list->array indices)) (n (quotient (array-length ix) 3))
             (origin (array-ref p (array-ref ix 0))) (parents (array-generate n (lambda (i) i)))
             (shell
              (new Shell (verts (empty-table)) (edges (empty-table)) (volume 0.0) (folds (Nil)))))
        (let ((vertex (lambda ((i I64)) (→ I64)
                        (let ((k (position-key (array-ref p i))))
                          (match (table-ref (● shell verts) k) ((Some found) found)
                                 ((None)
                                  (set! (● shell verts) (table-set (● shell verts) k i))
                                  i))))))
          (for-each (lambda (face)
                      (let* ((at
                              (lambda ((k I64)) (→ I64) (vertex (array-ref ix (+ (* 3 face) k)))))
                             (ids (list (at 0) (at 1) (at 2)))
                             (a (array-ref p (at 0)))
                             (b (array-ref p (at 1)))
                             (c (array-ref p (at 2))))
                        (when (<= (squared (cross (v- b a) (v- c a))) 0.0)
                          (unreadable "degenerate transparent triangle"))
                        (set! (● shell volume)
                              (+ (● shell volume)
                                 (dot (v- a origin) (cross (v- b origin) (v- c origin)))))
                        (for-each (lambda (k)
                                    (let* ((u (list-ref ids k))
                                           (v (list-ref ids (remainder (+ k 1) 3)))
                                           (third
                                            (array-ref p (list-ref ids (remainder (+ k 2) 3))))
                                           (key
                                            (string-append (show (min u v)) "/" (show (max u v)))))
                                      (match (table-ref (● shell edges) key)
                                        ((None) (set! (● shell edges) (table-set (● shell edges) key
                                                                                 (new Edge
                                                                                   (a u)
                                                                                   (b v)
                                                                                   (face face)
                                                                                   (opposite third)
                                                                                   (used #f)))))
                                        ((Some e)
                                         (when (or (● e used) (not (= (● e b) u)))
                                           (unreadable
                                            "nonmanifold or inconsistent transparent edge"))
                                         (set! (● e used) #t)
                                         (array-set! parents
                                                     (root parents face)
                                                     (root parents (● e face)))
                                         (let* ((edge (v- (array-ref p v) (array-ref p u)))
                                                (h (v- third (array-ref p u)))
                                                (other (v- (● e opposite) (array-ref p u)))
                                                (n1 (cross edge h)) (n2 (cross other edge))
                                                (scale (sqrt (* (dot n1 n1) (dot n2 n2)))))
                                           (when (<= (/ (dot n1 n2) scale) -0.999999999)
                                             (unreadable "folded-back transparent edge"))
                                           (set! (● shell folds)
                                                 (Cons (/ (* (dot n1 other) (sqrt (dot edge edge)))
                                                          scale)
                                                       (● shell folds))))))))
                                  (list 0 1 2)))) (iota n)))
        (unless (every? (lambda (i) (= (root parents i) (root parents 0))) (iota n))
          (unreadable "disconnected transparent triangles"))
        (let* ((border (filter (lambda (e) (not (● e used))) (table-values (● shell edges))))
               (euler (- (+ (table-count (● shell verts)) n) (table-count (● shell edges)))))
          (if (null? border)
              (unless (and (= euler 2) (not (= (● shell volume) 0.0))
                           (every?
                            (lambda (d) (<= (* (if (< (● shell volume) 0.0) -1.0 1.0) d) 0.000001))
                            (● shell folds)))
                (unreadable "transparent mesh has a reflex dihedral or invalid shell"))
              (unless (and (= euler 1) (planar-polygon? p ix border (table-values (● shell verts))))
                (unreadable "open transparent mesh must be a convex planar polygon"))))))

    ;; A consistently wound planar disk is convex iff every boundary edge
    ;; supports it: all vertices lie on the interior side of that edge.
    (define (planar-polygon? (p (Array V3)) (ix (Array I64)) (border (List Edge)) (used (List I64)))
      (→ Bool)
      (let* ((at (lambda ((k I64)) (→ V3) (array-ref p (array-ref ix k))))
             (a (at 0)) (normal (unit-vector (cross (v- (at 1) a) (v- (at 2) a))))
             (points (map (lambda (i) (array-ref p i)) used))
             (eps
              (* 0.000001 (sqrt (fold-left (lambda (m v) (max m (squared (v- v a)))) 0.0 points)))))
        (and (every? (lambda (v) (<= (abs (dot normal (v- v a))) eps)) points)
             (every? (lambda (edge)
                       (let* ((a (array-ref p (● edge a))) (b (array-ref p (● edge b)))
                              (inward (unit-vector (cross normal (v- b a)))))
                         (every? (lambda (v) (>= (dot inward (v- v a)) (negate eps))) points)))
                     border))))

    (define (word-at (bytes Bytes) (offset I64) (size I64)) (→ I64)
      (let loop ((i size) (result 0))
        (if (= i 0)
            result
            (loop (- i 1)
                  (+ (* 256 result) (i32->i64 (u8->i32 (array-ref bytes (+ offset (- i 1))))))))))
    (define (position-component (bytes Bytes) (a Attribute) (at I64) (axis I64)) (→ F64)
      (let* ((format (● a component))
             (size (case format
                     ((5120 5121) 1)
                     ((5122 5123) 2)
                     ((5126) 4)
                     (else (unreadable "unsupported position component"))))
             (raw (word-at bytes (+ at (* axis size)) size))
             (range (if (= size 1) 256 65536)) (signed (or (= format 5120) (= format 5122))))
        (if (= format 5126) (f32->f64 (bits->f32 (i64->i32 raw)))
            (let ((v (i64->f64 (if (and signed (>= raw (quotient range 2))) (- raw range) raw))))
              (if (● a normalized)
                  (max -1.0 (/ v (i64->f64 (- (if signed (quotient range 2) range) 1))))
                  v)))))

    (define (validate-primitive (bytes Bytes) (prim Primitive)) (→ Unit)
      (let* ((pos (● prim positions))
             (points (array-generate (● pos count) (lambda (i)
                                                     (point (map (lambda (axis)
                                                                   (position-component bytes
                                                                                       pos
                                                                                       (+ (● pos
                                                                                             offset)
                                                                                          (* i
                                                                                             (● pos
                                                                                                stride)))
                                                                                       axis))
                                                                 (list 0 1 2))))))
             (indices (match (● prim indices)
                        ((None) (iota (● pos count)))
                        ((Some a)
                         (map (lambda (i) (word-at bytes (+ (● a offset) (* i (● a stride)))
                                                   (case (● a component)
                                                     ((5121) 1)
                                                     ((5123) 2)
                                                     (else 4))))
                              (iota (● a count)))))))
        (validate-shell points indices)))
    (define (check-transparent-meshes (g Gltf) (buffers (List Bytes)) (materials (List Material)))
      (→ Unit)
      (when debug-build?
        (let ((blends (filter (lambda (p)
                                (let ((m (● p primitive material)))
                                  (blended-material?
                                   (● (list-ref materials (if (< m 0) (- (length materials) 1) m))
                                      alpha))))
                              (● g placed))))
          (unless (null? blends)
            (let ((bytes (make-array (● g size) (i32->u8 0))))
              (for-each
               (lambda (b) (array-copy! bytes (● b first start) (● b second) 0 (● b first length)))
               (zip (● g buffers) buffers))
              (for-each (lambda (p) (validate-primitive bytes (● p primitive))) blends)))))))
  )
