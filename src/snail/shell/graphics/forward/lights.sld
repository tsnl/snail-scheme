;; Point and spot lights in world space. A fragment visits its ground cell and
;; the small moving list. Each fixture occupies three consecutive RGBA texels.
(define-library (snail shell graphics forward lights)
  (export Punctual point-light spot-light LightGrid light-grid update-moving-lights!)
  (import
   (snail core base)
   (snail shell math)
   (snail shell gpu)
   (snail shell graphics pod)
   (only (snail shell graphics raster) Plane make-plane)
   (only (snail shell graphics animation) v4))
  (begin
    (record Punctual
      ((position Vec4f)
       (intensity Vec4f)
       (axis Vec4f)))
    (define (point-light (p Vec3f) (rgb Vec3f) (reach F32)) (→ Punctual)
      (unless (and (> reach 0.0) (>= (min (● rgb x) (min (● rgb y) (● rgb z))) 0.0))
        (panic "light needs a positive range and nonnegative intensity"))
      (new Punctual (position (v4 (● p x) (● p y) (● p z) reach))
           (intensity (v4 (● rgb x) (● rgb y) (● rgb z) 0.0)) (axis (v4 0.0 0.0 0.0 -1.0))))
    (define (spot-light (p Vec3f) (rgb Vec3f) (reach F32) (aim Vec3f) (cutoff F32)) (→ Punctual)
      (let* ((x (● aim x)) (y (● aim y)) (z (● aim z))
             (n (f64->f32 (sqrt (f32->f64 (+ (* x x) (+ (* y y) (* z z))))))))
        (unless (and (> n 0.0) (>= cutoff 0.0) (< cutoff 1.0)) (panic "invalid spotlight cone"))
        (Punctual-axis-set (point-light p rgb reach) (v4 (/ x n) (/ y n) (/ z n) cutoff))))
    (record LightGrid
      ((plane Plane)
       (moving-capacity I64)))
    (define texel (→ (Shape Vec4f)) (shape))
    (define (as-float (n I64)) (→ F32) (f64->f32 (i64->f64 n)))
    (define (words (p Punctual)) (→ (List Vec4f)) (list (● p position) (● p intensity) (● p axis)))
    (define (bounds (lights (List Punctual))) (→ Vec4f)
      (fold-left (lambda (b lamp)
                   (let ((p (● lamp position)))
                     (v4 (min (● b x) (- (● p x) (● p w))) (min (● b y) (- (● p z) (● p w)))
                         (max (● b z) (+ (● p x) (● p w))) (max (● b w) (+ (● p z) (● p w))))))
                 (v4 1e30 1e30 -1e30 -1e30) lights))
    (define (bin (p F32) (origin F32) (step F32) (side I64)) (→ I64)
      (max 0 (min (- side 1) (f64->i64 (floor (f32->f64 (/ (- p origin) step)))))))
    (define (cell-lights (lights (List Punctual)) (b Vec4f) (step F32) (side I64))
      (→ (Array (List Punctual)))
      (let ((cells (make-array (* side side) (ann (Nil) (List Punctual)))))
        (for-each (lambda (lamp)
                    (let* ((p (● lamp position)) (r (● p w))
                           (x0 (bin (- (● p x) r) (● b x) step side))
                           (x1 (bin (+ (● p x) r) (● b x) step side))
                           (z0 (bin (- (● p z) r) (● b y) step side))
                           (z1 (bin (+ (● p z) r) (● b y) step side)))
                      (let rows ((z z0))
                        (when (<= z z1)
                          (let cols ((x x0))
                            (when (<= x x1) (let ((i (+ (* z side) x)))
                                              (array-set! cells i (Cons lamp (array-ref cells i))))
                                  (cols (+ x 1))))
                          (rows (+ z 1)))))) lights) cells))
    (define (cell-spans (cells (List (List Punctual))) (start I64)) (→ (List Vec4f))
      (let loop ((rest cells) (at start) (out (ann (Nil) (List Vec4f))))
        (match rest ((Nil) (reverse out))
               ((Cons cell tail) (let ((n (length cell)))
                                   (loop tail
                                         (+ at (* 3 n))
                                         (Cons (v4 (as-float at) (as-float n) 0.0 0.0) out)))))))
    (define (upload-grid (gpu Gpu) (frame Vec4f) (cells (List (List Punctual))) (capacity I64))
      (→ LightGrid)
      (let* ((fixtures (concatenate (map words (concatenate cells))))
             (static (+ 1 (+ (length cells) (length fixtures))))
             (width (max (+ 1 (* 3 capacity)) (f64->i64 (ceiling (sqrt (i64->f64 static))))))
             (height (+ 1 (quotient (+ static (- width 1)) width)))
             (data (concatenate (list (map (lambda (_) (v4 0.0 0.0 0.0 0.0)) (iota width))
                                      (list frame)
                                      (cell-spans cells (+ width (+ 1 (length cells))))
                                      fixtures)))
             (bytes (pack texel data)))
        ;; WebGPU guarantees 8192 texels per axis. All offsets below 2^24
        ;; remain exact in the float texture and in the shader's integer load.
        (when (or (> (max width height) 8192) (>= (+ width static) 16777216))
          (panic "light grid exceeds texture capacity"))
        (let ((plane (make-plane gpu "forward/local-lights" (i64->i32 width) (i64->i32 height)
                                 (Rgba32Float) (list (TextureBinding) (TextureCopyDst)))))
          ((● gpu write-texture) (whole-texture (● plane texture)) (i64->i32 (* width 16))
           (i64->i32 width) (i64->i32 height)
           (array-append bytes
                         (make-array (- (* 16 (* width height)) (array-length bytes)) (i32->u8 0))))
          (new LightGrid (plane plane) (moving-capacity capacity)))))
    (define (light-grid (gpu Gpu) (lights (List Punctual)) (capacity I64)) (→ LightGrid)
      (unless (and (>= capacity 0) (<= capacity 2730))
        (panic "moving lights must fit the texture's first row"))
      (let* ((b (if (null? lights) (v4 0.0 0.0 0.0 0.0) (bounds lights)))
             (span (max (- (● b z) (● b x)) (- (● b w) (● b y))))
             (side (max 1 (min 48 (f64->i64 (ceiling (/ (f32->f64 span) 24.0))))))
             (step (max 1.0 (/ span (as-float side)))))
        (upload-grid gpu (v4 (● b x) (● b y) step (as-float side))
                     (array->list (cell-lights lights b step side)) capacity)))
    (define (update-moving-lights! (gpu Gpu) (g LightGrid) (lights (List Punctual))) (→ Unit)
      (let* ((n (length lights)) (width (i64->i32 (+ 1 (* 3 n)))))
        (when (> n (● g moving-capacity)) (panic "moving lights exceed the scene capacity"))
        ((● gpu write-texture) (whole-texture (● g plane texture)) (* 16 width) width 1
         (pack texel (Cons (v4 (as-float n) 0.0 0.0 0.0)
                           (concatenate (map words lights)))))))))
