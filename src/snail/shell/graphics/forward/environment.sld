(define-library (snail shell graphics forward environment)
  (export Environment make-environment daylight furnace-environment release-environment
          make-brdf import-hdr)
  (import
   (snail core base)
   (snail shell math)
   (only (snail shell game rigid-body) V3 v3 v+ v- scaled dot cross squared unit-vector)
   (snail shell gpu)
   (snail shell graphics kernel)
   (snail shell graphics raster)
   (snail shell graphics forward bake)
   (snail shell graphics forward skies)
   (only (snail shell graphics environment) Hdr))
  (begin
    (record Environment
      ((cube Plane)
       (diffuse GpuBuffer)
       (sun V3)
       (color V3)
       (disc F64)))
    (define (make-environment (gpu Gpu) (bytes Bytes) (sun V3) (color V3) (disc F64))
      (→ Environment)
      (unless (= (array-length bytes) 65664) (panic "invalid baked environment"))
      (let* ((texture ((● gpu create-texture) (new TextureDescriptor (label "ibl/specular")
                                                   (width 32)
                                                   (height 32)
                                                   (layers 6)
                                                   (mips 6)
                                                   (format (Rgba16Float))
                                                   (usage
                                                    (list (TextureBinding) (TextureCopyDst))))))
             (view ((● gpu create-view) texture (new TextureViewDescriptor (dimension (ViewCube))
                                                     (base-layer 0)
                                                     (layers 6)
                                                     (base-mip 0)
                                                     (mips 6)))))
        (let loop ((level 0) (side 32) (start 144))
          (when (< level 6)
            (let ((stride (* 8 (* side side))))
              (for-each (lambda (face) (let ((at (+ start (* face stride))))
                                         ((● gpu write-texture)
                                          (new TextureCopy (texture texture) (mip (i64->i32 level))
                                               (x 0) (y 0) (layer (i64->i32 face)))
                                          (i64->i32 (* 8 side))
                                          (i64->i32 side)
                                          (i64->i32 side)
                                          (subarray bytes at (+ at stride)))))
                        (iota 6))
              (loop (+ level 1) (quotient side 2) (+ start (* 6 stride))))))
        (new Environment (cube (new Plane (texture texture) (view view)))
             (diffuse (uniform-buffer gpu "ibl/diffuse" (subarray bytes 0 144)))
             (sun sun) (color color) (disc disc))))
    (define (daylight (gpu Gpu) (id I64)) (→ Environment)
      (make-environment gpu (case id ((0) morning) ((1) high-sun) ((2) golden-hour) (else moonrise))
                        (key-direction id) (key-color id) (if (= id 3) 0.997 0.99985)))
    (define (furnace-environment (gpu Gpu)) (→ Environment)
      (make-environment gpu white-sky (v3 0.0 1.0 0.0) (v3 0.0 0.0 0.0) 1.0))
    (define (release-environment (gpu Gpu) (env Environment)) (→ Unit)
      (release-plane gpu (● env cube)) ((● gpu destroy) (BufferObject (● env diffuse))))
    (define (make-brdf (gpu Gpu)) (→ Plane)
      (let ((p (make-plane gpu
                           "ibl/brdf"
                           32
                           32
                           (Rgba16Float)
                           (list (TextureBinding) (TextureCopyDst)))))
        ((● gpu write-texture) (whole-texture (● p texture)) 256 32 32 brdf-lut) p))

    ;; A dropped RGBE panorama is decoded once and passed through the bake used by the producer.
    (define (byte (b Bytes) (i I64)) (→ I64) (i32->i64 (u8->i32 (array-ref b i))))
    (define (decode-rows (hdr Hdr)) (→ Bytes)
      (let* ((w (● hdr width)) (h (● hdr height)) (b (● hdr bytes)) (rows (● hdr rows))
             (pixels (make-array (* 4 (* w h)) (i32->u8 0))))
        (for-each (lambda (y)
                    (let ((start
                           (fold-left (lambda (acc k) (+ (* acc 256) (byte rows (+ (* 4 y) k))))
                                      0
                                      (list 3 2 1 0))))
                      (let channel ((c 0) (at (+ start 4)))
                        (when (< c 4)
                          (let run ((x 0) (cursor at))
                            (if (= x w) (channel (+ c 1) cursor)
                                (let* ((code (byte b cursor)) (repeat (> code 128))
                                       (n (if repeat (- code 128) code)))
                                  (for-each
                                   (lambda (k) (array-set! pixels (+ c (* 4 (+ (* w y) (+ x k))))
                                                           (array-ref b
                                                                      (+ cursor
                                                                         (+ 1 (if repeat 0 k))))))
                                   (iota n))
                                  (run (+ x n) (+ cursor (+ 1 (if repeat 1 n))))))))))) (iota h))
        pixels))
    (define (import-hdr (gpu Gpu) (hdr Hdr)) (→ Environment)
      (let* ((b (decode-rows hdr)) (w (● hdr width)) (h (● hdr height))
             (sample (lambda ((d V3)) (→ V3)
                       (let* ((u (+ 0.5 (/ (atan2 (● d z) (● d x)) (* 2.0 pi))))
                              (x (modulo (f64->i64 (floor (* u (i64->f64 w)))) w))
                              (y (min (- h 1)
                                      (f64->i64 (* (/ (acos (max -1.0 (min 1.0 (● d y)))) pi)
                                                   (i64->f64 h)))))
                              (i (* 4 (+ x (* y w))))
                              (k (expt 2.0 (- (i64->f64 (byte b (+ i 3))) 136.0))))
                         (scaled (v3 (i64->f64 (byte b i))
                                     (i64->f64 (byte b (+ i 1)))
                                     (i64->f64 (byte b (+ i 2))))
                                 k)))))
        (make-environment gpu (bake-environment sample) (v3 0.0 1.0 0.0) (v3 0.0 0.0 0.0) 1.0)))))
