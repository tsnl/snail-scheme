;; Directed streets, indexed by junction. A* keeps the previous junction for
;; the winning route. Traffic follows the same outgoing edges as navigation.
(define-library (snail shell game roads)
  (export Roads read-roads node-at nearest-road exits street-name road-route route-length next-turn
          follow-edge edge-fraction edge-distance)
  (import
   (snail core base)
   (only (snail shell math) sin)
   (snail shell little-endian)
   (only (snail shell utf8) utf8->string)
   (snail shell game physics))
  (begin
    (record Roads
      ((points (Array XZ))
       (index (Array I64))
       (to (Array I64))
       (streets (Array I64))
       (names (Array String))))
    (define (labels (b Bytes) (base I64)) (→ (Array String))
      (let loop ((i base) (start base) (out (Nil)))
        (if (or (= i (array-length b)) (= (u8->i32 (array-ref b i)) 10))
            (let ((s (match (utf8->string (subarray b start i))
                       ((Ok s) s)
                       (_ (panic "invalid street name")))))
              (if (= i (array-length b))
                  (list->array (reverse (Cons s out)))
                  (loop (+ i 1) (+ i 1) (Cons s out))))
            (loop (+ i 1) start out))))
    (define (read-roads (b Bytes)) (→ Roads)
      (unless (and (>= (array-length b) 20) (= (u32 b 0) 827736398))
        (panic "invalid street network"))
      (let* ((n (u32 b 4)) (e (u32 b 8)) (idx (+ 16 (* 4 n))) (edges (+ idx (* 4 (+ 1 n))))
             (strings (+ edges (* 6 e))))
        (unless (and (> n 0) (= (+ strings (u32 b 12)) (array-length b)) (= (u32 b idx) 0)
                     (= (u32 b (- edges 4)) e)) (panic "truncated street network"))
        (let ((names (labels b strings)))
          (new Roads
            (points (array-generate n
                                    (lambda (i)
                                      (let ((p (+ 16 (* 4 i))))
                                        (xz (i64->f64 (i16 b p)) (i64->f64 (i16 b (+ p 2))))))))
            (index (array-generate (+ n 1)
                                   (lambda (i)
                                     (let ((v (u32 b (+ idx (* 4 i)))))
                                       (when (and (> i 0) (< v (u32 b (+ idx (* 4 (- i 1))))))
                                         (panic "unordered junctions"))
                                       v))))
            (to (array-generate e
                                (lambda (i)
                                  (let ((v (u32 b (+ edges (* 6 i)))))
                                    (when (>= v n) (panic "invalid junction"))
                                    v))))
            (streets (array-generate e
                                     (lambda (i)
                                       (let ((v (u16 b (+ (+ edges 4) (* 6 i)))))
                                         (when (>= v (array-length names)) (panic "invalid street"))
                                         v))))
            (names names)))))
    (define (node-at (r Roads) (n I64)) (→ XZ) (array-ref (● r points) n))
    (define (nearest-road (r Roads) (p XZ)) (→ I64)
      (let loop ((i 0) (best 0) (cost 1e30))
        (if (= i (array-length (● r points))) best
            (let* ((at (node-at r i))
                   (dx (- (● p x) (● at x)))
                   (dz (- (● p z) (● at z)))
                   (c (+ (* dx dx) (* dz dz))))
              (if (and (< c cost) (< (array-ref (● r index) i) (array-ref (● r index) (+ i 1))))
                  (loop (+ i 1) i c) (loop (+ i 1) best cost))))))
    (define (exits (r Roads) (n I64)) (→ (List I64))
      (let loop ((i (array-ref (● r index) (+ n 1))) (out (Nil)))
        (if (= i (array-ref (● r index) n)) out
            (loop (- i 1) (Cons (array-ref (● r to) (- i 1)) out)))))
    (define (street-name (r Roads) (a I64) (b I64)) (→ String)
      (let loop ((i (array-ref (● r index) a)))
        (cond ((= i (array-ref (● r index) (+ a 1))) "")
              ((= (array-ref (● r to) i) b) (array-ref (● r names) (array-ref (● r streets) i)))
              (else (loop (+ 1 i))))))
    ;; A pairing heap: adding a candidate links two roots. Removing the best
    ;; pairs its children once, then merges the pairs back from the right.
    (record Candidate
      ((key F64)
       (node I64)
       (children (List Candidate))))
    (define (merge (a Candidate) (b Candidate)) (→ Candidate)
      (if (<= (● a key) (● b key)) (Candidate-children-set a (Cons b (● a children)))
          (Candidate-children-set b (Cons a (● b children)))))
    (define (heap (items (List Candidate))) (→ (Option Candidate))
      (match items ((Nil) (None)) ((Cons a (Nil)) (Some a))
             ((Cons a (Cons b rest))
              (let ((pair (merge a b)))
                (match (heap rest) ((Some h) (Some (merge pair h))) (_ (Some pair)))))))
    (define (via (previous (Array I64)) (at I64) (out (List I64))) (→ (List I64))
      (let ((from (array-ref previous at)))
        (if (= from at) (Cons at out) (via previous from (Cons at out)))))
    (define (road-route (r Roads) (from I64) (goal I64)) (→ (List I64))
      (let* ((n (array-length (● r points))) (cost (make-array n 1e30)) (seen (make-array n #f))
             (prev (make-array n -1)) (end (node-at r goal)))
        (array-set! cost from 0.0) (array-set! prev from from)
        (let loop ((open (Some (new Candidate (key 0.0) (node from) (children (Nil))))))
          (match open ((None) (Nil))
                 ((Some top)
                  (let ((now (● top node)) (rest (heap (● top children))))
                    (cond ((= now goal) (via prev goal (Nil)))
                          ((array-ref seen now) (loop rest))
                          (else (array-set! seen now #t)
                                (loop (fold-left (lambda (q next)
                                                   (let* ((p (node-at r next))
                                                          (c (+ (array-ref cost now)
                                                                (distance (node-at r now) p))))
                                                     (if (>= c (array-ref cost next)) q
                                                         (let ((h (new Candidate
                                                                    (key (+ c (distance p end)))
                                                                    (node next)
                                                                    (children (Nil)))))
                                                           (array-set! cost next c)
                                                           (array-set! prev next now)
                                                           (Some (match q
                                                                   ((Some other) (merge other h))
                                                                   (_ h)))))))
                                                 rest (exits r now)))))))))))
    (define (edge-distance (r Roads) (a I64) (b I64))
      (→ F64)
      (distance (node-at r a) (node-at r b)))
    (define (edge-fraction (p XZ) (a XZ) (b XZ)) (→ F64)
      (let ((dx (- (● b x) (● a x))) (dz (- (● b z) (● a z))))
        (max 0.0
             (min 1.0
                  (/ (+ (* (- (● p x) (● a x)) dx) (* (- (● p z) (● a z)) dz))
                     (max 0.001 (+ (* dx dx) (* dz dz))))))))
    (define (follow-edge (r Roads) (a I64) (b I64) (travel F64) (right F64)) (→ Body)
      (let* ((p (node-at r a)) (q (node-at r b)) (h (heading-to p q)) (dir (forward h))
             (at (offset (offset p dir travel) (xz (- 0.0 (● dir z)) (● dir x)) right)))
        (body at h)))
    (define (route-length (r Roads) (path (List I64))) (→ F64)
      (let loop ((p path) (d 0.0))
        (match p ((Cons a (Cons b bs)) (loop (Cons b bs) (+ d (edge-distance r a b)))) (_ d))))
    (define (next-turn (r Roads) (path (List I64)) (position XZ)) (→ String)
      (match path ((Cons a (Cons b bs))
                   (let ((street (street-name r a b)))
                     (let loop ((last a)
                                (at b)
                                (rest bs)
                                (d (* (edge-distance r a b)
                                      (- 1.0
                                         (edge-fraction position (node-at r a) (node-at r b))))))
                       (match rest ((Cons next tail)
                                    (let ((name (street-name r at next)))
                                      (if (and (not (string=? street name)) (< d 240.0))
                                          (let ((angle
                                                 (- (heading-to (node-at r at) (node-at r next))
                                                    (heading-to (node-at r last) (node-at r at)))))
                                            (string-append (if (> (sin angle) 0.30)
                                                               "Right on "
                                                               (if (< (sin angle) -0.30)
                                                                   "Left on "
                                                                   "Continue on "))
                                                           name
                                                           " in "
                                                           (show (f64->i64 d))
                                                           " m"))
                                          (if (> d 240.0)
                                              (string-append "Follow " street)
                                              (loop at
                                                    next
                                                    tail
                                                    (+ d (edge-distance r at next)))))))
                              (_ (string-append "Follow " street))))))
             (_ "Approach the marked curb")))))
