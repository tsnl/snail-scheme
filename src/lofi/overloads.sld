;; Free overloads are static classes over complete function signatures. Candidate
;; trials use copies; only one applicable row may constrain the actual use.
(define-library (lofi overloads)
  (export overload-class select-overload-view improve-overloads! require-overloads!
          overload-view-instance overload-view-constraints duplicate-overload?)
  (import (scheme base) (lofi types) (lofi checked))
  (begin

    ;; ---- Fresh row views and isolated compatibility trials ----

    (define-record-type <overload-view>
      (make-overload-view instance type constraints) overload-view?
      (instance overload-view-instance) (type overload-view-type)
      (constraints overload-view-constraints))
    (define (overload-class definition classes)
      (cond ((null? classes) #f)
            ((eq? definition (class-definition (car classes)))
             (and (class-overload? (car classes)) (car classes)))
            (else (overload-class definition (cdr classes)))))
    (define (fresh-overload instance)
      (let-values (((type constraints substitutions) (instantiate (instance-scheme instance))))
        (make-overload-view instance type constraints)))
    (define (copy-trial-type type flexible-rigid?)
      (substitute type (map (lambda (variable)
                              (cons variable (if (and (variable-rigid? variable) (not flexible-rigid?))
                                                 variable (fresh-variable))))
                            (type-variables type))))
    (define (compatible? left right flexible-rigid?)
      (guard (failure (else #f))
        (unify! (copy-trial-type left #t) (copy-trial-type right flexible-rigid?) #f) #t))
    ;; Rigid declaration variables may specialize later. Keep any row that
    ;; could then overlap; the commit below still respects their rigid identity.
    (define (overload-candidates class type instances)
      (cond ((null? instances) '())
            ((and (eq? class (instance-class (car instances)))
                  (compatible? (scheme-type (instance-scheme (car instances))) type #t))
             (cons (car instances) (overload-candidates class type (cdr instances))))
            (else (overload-candidates class type (cdr instances)))))
    (define (scheme-key scheme)
      (let ((mapping '()))
        (define (walk type)
          (let ((type (resolve type)))
            (cond ((variable? type)
                   (unless (assq type mapping)
                     (set! mapping (cons (cons type (list 'parameter (length mapping))) mapping)))
                   (cdr (assq type mapping)))
                  ((pair? type) (let ((head (walk (car type)))) (cons head (walk (cdr type)))))
                  (else type))))
        (walk (scheme-type scheme))))
    (define (duplicate-overload? class scheme instances)
      (and (pair? instances)
           (or (and (eq? class (instance-class (car instances)))
                    (equal? (scheme-key scheme) (scheme-key (instance-scheme (car instances)))))
               (duplicate-overload? class scheme (cdr instances)))))

    ;; ---- Selection uses the complete known function shape ----

    (define (apply-overload-view instance type loc)
      (let ((view (fresh-overload instance)))
        (and (compatible? (overload-view-type view) type #f)
             (begin (unify! (overload-view-type view) type loc) view))))
    (define (select-overload-view class type instances loc required?)
      (let ((candidates (overload-candidates class type instances)))
        (cond ((null? candidates) (strict-error loc "no compatible overload signature" type))
              ((and (null? (cdr candidates)) (function-type? type))
               (or (apply-overload-view (car candidates) type loc)
                   (and required? (strict-error loc "overload cannot satisfy rigid signature" type))))
              ((or required? (concrete-type? type))
               (strict-error loc "ambiguous overload; provide argument or result type context" type))
              (else #f))))
    (define (check-family-constraint constraint loc)
      (unless (= (length (cdr constraint)) 1)
        (strict-error loc "overload constraint requires one complete function signature"))
      (let ((type (resolve (cadr constraint))))
        (unless (or (variable? type) (function-type? type))
          (strict-error loc "overload constraint requires a function signature" type))))
    (define (seen-constraint? constraint seen)
      (and (pair? seen) (or (type-equal? constraint (car seen)) (seen-constraint? constraint (cdr seen)))))
    (define (assumption-compatible? left right)
      (guard (failure (else #f))
        (unify! (copy-trial-type left #f) (copy-trial-type right #f) #f) #t))
    (define (matching-assumptions constraint assumptions)
      (let collect ((remaining assumptions) (matches '()))
        (cond ((null? remaining) matches)
              ((and (eq? (car constraint) (caar remaining))
                    (assumption-compatible? (cdr constraint) (cdar remaining))
                    (not (seen-constraint? (car remaining) matches)))
               (collect (cdr remaining) (cons (car remaining) matches)))
              (else (collect (cdr remaining) matches)))))
    (define (use-overload-assumption! constraint assumptions loc)
      (let ((matches (matching-assumptions constraint assumptions)))
        (and (pair? matches) (null? (cdr matches))
             (begin (unify! (cdr constraint) (cdar matches) loc) #t))))
    (define (improve-constraint! constraint assumptions classes instances loc seen)
      (let ((class (overload-class (car constraint) classes)))
        (when (and class (not (seen-constraint? constraint seen)))
          (check-family-constraint constraint loc)
          (unless (use-overload-assumption! constraint assumptions loc)
            (when (>= (length seen) 128) (strict-error loc "overload prerequisite expansion limit exceeded"))
            (let ((view (select-overload-view class (cadr constraint) instances loc #f)))
              (when view
                (improve-goals! (overload-view-constraints view) assumptions classes instances loc (cons constraint seen))))))))
    (define (improve-goals! constraints assumptions classes instances loc seen)
      (let ((before (type-datum constraints)))
        (for-each (lambda (constraint) (improve-constraint! constraint assumptions classes instances loc seen)) constraints)
        (unless (equal? before (type-datum constraints))
          (improve-goals! constraints assumptions classes instances loc seen))))
    (define (improve-overloads! constraints assumptions classes instances loc)
      (for-each (lambda (constraint)
                  (let ((class (overload-class (car constraint) classes)))
                    (when class (check-family-constraint constraint loc)))) assumptions)
      (improve-goals! constraints assumptions classes instances loc '()))
    (define (require-overloads! constraints classes instances loc)
      (improve-overloads! constraints '() classes instances loc)
      (for-each (lambda (constraint)
                  (let ((class (overload-class (car constraint) classes)))
                    (when class (select-overload-view class (cadr constraint) instances loc #t)))) constraints))))
