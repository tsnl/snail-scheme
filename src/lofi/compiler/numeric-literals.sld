;; Literal conversion happens once, at its selected representation. In particular,
;; a decimal F32 literal must not round through the reader's F64 approximation.
(define-library (lofi compiler numeric-literals)
  (export literal-number-value checked-integer-literal rounded-float-literal)
  (import
   (scheme base)
   (scheme char)
   (scheme inexact)
   (only (scheme bitwise) integer-length)
   (only (scheme bytevector) bytevector-u32-native-set! bytevector-u64-native-set!
         bytevector-ieee-single-native-ref bytevector-ieee-double-native-ref)
   (only (lofi compiler types) strict-error))
  (begin

    ;; ---- Source spelling and explicit IEEE values ----

    (define (number-body text)
      (let skip ((index 0))
        (if (and (< (+ index 1) (string-length text)) (char=? (string-ref text index) #\#))
            (skip (+ index 2)) (substring text index (string-length text)))))
    (define (explicit-special? text)
      (and text (member (string-downcase (number-body text))
                        '("+inf.0" "-inf.0" "+nan.0" "-nan.0"))))
    (define (exact-spelling text)
      (let ((copy (string-copy text)))
        (let scan ((index 0))
          (cond ((or (>= (+ index 1) (string-length copy)) (not (char=? (string-ref copy index) #\#)))
                 (string-append "#e" copy))
                ((memv (char-downcase (string-ref copy (+ index 1))) '(#\e #\i))
                 (string-set! copy (+ index 1) #\e) copy)
                (else (scan (+ index 2)))))))
    (define (negative-literal? value text)
      (if text (let ((body (number-body text))) (char=? (string-ref body 0) #\-))
          (or (negative? value) (and (zero? value) (negative? (/ 1.0 value))))))

    ;; ---- Exact decimal values ----

    ;; Chibi's #e decimal reader can itself round long decimal significands.
    ;; Decode decimal digits as an integer and scale by an exact power of ten.
    ;; Prefix and rational spellings still use the host's exact integer reader.
    (define (spelling-index text characters)
      (let scan ((index 0))
        (cond ((= index (string-length text)) #f)
              ((memv (char-downcase (string-ref text index)) characters) index)
              (else (scan (+ index 1))))))
    (define (decimal-spelling? text)
      (not (spelling-index text '(#\b #\o #\x #\/ #\i #\@))))
    (define (decimal-significand text)
      (string->number
       (list->string (let digits ((characters (string->list text)))
                       (cond ((null? characters) '())
                             ((char=? (car characters) #\.) (digits (cdr characters)))
                             (else (cons (car characters) (digits (cdr characters)))))))))
    (define (decimal-parts text)
      (let* ((body (number-body text)) (end (string-length body))
             (marker (spelling-index body '(#\e)))
             (significand (substring body 0 (or marker end)))
             (point (spelling-index significand '(#\.)))
             (exponent (- (if marker (string->number (substring body (+ marker 1) end)) 0)
                          (if point (- (string-length significand) point 1) 0)))
             (digits (decimal-significand significand)))
        (values digits exponent)))
    (define (scale-decimal digits exponent)
      (cond ((zero? digits) 0)
            ((negative? exponent) (/ digits (expt 10 (- exponent))))
            (else (* digits (expt 10 exponent)))))
    (define (bounded-decimal digits exponent type loc)
      (let ((order (+ exponent (- (string-length (number->string (abs digits))) 1)))
            (single? (eq? type 'F32)))
        (cond ((zero? digits) 0)
              ((and type (> order (if single? 38 308)))
               (strict-error loc "floating literal is outside representation range" type))
              ((and type (< order (if single? -46 -324))) 0)
              (else (scale-decimal digits exponent)))))
    (define (check-real-spelling text loc)
      (let ((body (number-body text)))
        (when (or (char-ci=? (string-ref body (- (string-length body) 1)) #\i)
                  (spelling-index body '(#\@)))
          (strict-error loc "complex and polar spellings are not scalar literals" text))))
    (define (exact-source-number text type loc)
      (check-real-spelling text loc)
      (let ((text (exact-spelling text)))
        (if (decimal-spelling? text)
            (let-values (((digits exponent) (decimal-parts text))) (bounded-decimal digits exponent type loc))
            (let ((value (string->number text)))
              (unless (and value (rational? value) (exact? value))
                (strict-error loc "numeric literal has no finite real value" text))
              value))))
    (define (literal-number-value value text loc)
      (when (and text (number? value)) (check-real-spelling text loc))
      (if (and text (number? value) (exact? value)) (exact-source-number text #f loc) value))

    ;; ---- Round an exact magnitude to an IEEE significand ----

    (define (power-of-two exponent)
      (if (negative? exponent) (/ 1 (expt 2 (- exponent))) (expt 2 exponent)))
    (define (binary-exponent magnitude)
      (let ((estimate (- (integer-length (numerator magnitude))
                         (integer-length (denominator magnitude)))))
        (if (< magnitude (power-of-two estimate)) (- estimate 1) estimate)))
    (define (round-even magnitude)
      (let* ((whole (quotient (numerator magnitude) (denominator magnitude)))
             (twice-remainder (* 2 (remainder (numerator magnitude) (denominator magnitude))))
             (divisor (denominator magnitude)))
        (if (or (> twice-remainder divisor) (and (= twice-remainder divisor) (odd? whole)))
            (+ whole 1) whole)))
    (define (rounded-magnitude magnitude fraction-bits maximum-exponent loc type)
      (let* ((minimum-exponent (- 1 maximum-exponent))
             (exponent (max minimum-exponent (binary-exponent magnitude)))
             (significand (round-even (/ magnitude (power-of-two (- exponent fraction-bits)))))
             (leading-bit (expt 2 fraction-bits)))
        (when (= significand (* 2 leading-bit))
          (set! significand leading-bit) (set! exponent (+ exponent 1)))
        (when (> exponent maximum-exponent)
          (strict-error loc "floating literal is outside representation range" type))
        (if (< significand leading-bit) significand
            (+ (* (+ exponent maximum-exponent) leading-bit) (- significand leading-bit)))))
    (define (bits->float bits type)
      (let ((bytes (make-bytevector (if (eq? type 'F32) 4 8) 0)))
        (if (eq? type 'F32)
            (begin (bytevector-u32-native-set! bytes 0 bits) (bytevector-ieee-single-native-ref bytes 0))
            (begin (bytevector-u64-native-set! bytes 0 bits) (bytevector-ieee-double-native-ref bytes 0)))))
    (define (round-exact-float magnitude negative? type loc)
      (let* ((single? (eq? type 'F32)) (fraction-bits (if single? 23 52))
             (sign (if negative? (expt 2 (if single? 31 63)) 0))
             (bits (if (zero? magnitude) 0
                       (rounded-magnitude magnitude fraction-bits (if single? 127 1023) loc type))))
        (bits->float (+ sign bits) type)))

    ;; ---- Checked literal construction ----

    (define (checked-integer-literal value type loc)
      (let ((bits (if (eq? type 'I32) 31 63)))
        (unless (<= (- (expt 2 bits)) value (- (expt 2 bits) 1))
          (strict-error loc "integer literal is outside representation range" type value))
        value))
    (define (rounded-float-literal value text type loc)
      (cond ((or (explicit-special? text) (and (not text) (or (infinite? value) (nan? value)))) value)
            (else
             ;; Source text, including its decimal order, decides the value.
             ;; The host approximation can wrongly overflow or underflow at a boundary.
             (let ((exact-value (if text (exact-source-number text type loc) (exact value))))
               (round-exact-float (abs exact-value) (negative-literal? value text) type loc)))))
    )

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-numeric-literals)
    (import
     (native test-utils)
     (only (scheme bytevector) bytevector-ieee-single-native-set! bytevector-ieee-double-native-set!
           bytevector-u32-native-ref bytevector-u64-native-ref))
    (begin
      (define (literal-bits text type)
        (let ((value (rounded-float-literal (string->number text) text type #f))
              (bytes (make-bytevector 8 0)))
          (if (eq? type 'F32)
              (begin (bytevector-ieee-single-native-set! bytes 0 value) (bytevector-u32-native-ref bytes 0))
              (begin (bytevector-ieee-double-native-set! bytes 0 value) (bytevector-u64-native-ref bytes 0)))))
      (define (test-float-rounding)
        (for-each (lambda (row) (expect (literal-bits (car row) 'F32) (cadr row)))
                  '(("0.1" #x3dcccccd) ("-0.0" #x80000000) ("#i-0" #x80000000)
                    ("1.0000000596046448" #x3f800001)
                    ("1.000000059604644775390625" #x3f800000)
                    ("1.000000178813934326171875" #x3f800002)
                    ("1.401298464324817070923729583289916131280e-45" 1)
                    ("7.006492321624085354618647916449580656401e-46" 0)
                    ("7.006492321624085354618647916449580656402e-46" 1)
                    ("1.175494350822287507968736537222245677818e-38" #x00800000)
                    ("3.40282346638528859811704183484516925440e38" #x7f7fffff)
                    ("3.4028235e38" #x7f7fffff) ("#i1/3" #x3eaaaaab)
                    ("#i#x10" #x41800000) ("-1e-999999999" #x80000000)))
        (for-each (lambda (row) (expect (literal-bits (car row) 'F64) (cadr row)))
                  '(("0.1" #x3fb999999999999a) ("-0.0" #x8000000000000000)
                    ("4.940656458412465441765687928682213723651e-324" 1)
                    ("2.470328229206232720882843964341106861826e-324" 1)
                    ("2.2250738585072014e-308" #x0010000000000000)
                    ("1.7976931348623157e308" #x7fefffffffffffff)
                    ("1.7976931348623158e308" #x7fefffffffffffff))))
      (define (test-literal-ranges)
        (for-each (lambda (row)
                    (expect (guard (failure (else #t)) (literal-bits (car row) (cadr row)) #f) #t))
                  '(("3.40282356779733661637539395458142568448e38" F32)
                    ("3.4028236e38" F32) ("1e999999999" F64)
                    ("1.0000000596046448+0i" F32) ("1.0000000596046448@0" F64)))
        (expect (infinite? (rounded-float-literal (string->number "+inf.0") "+inf.0" 'F32 #f)) #t)
        (expect (nan? (rounded-float-literal (string->number "+nan.0") "+nan.0" 'F64 #f)) #t)
        (for-each (lambda (type)
                    (let ((limit (expt 2 (if (eq? type 'I32) 31 63))))
                      (expect (checked-integer-literal (- limit) type #f) (- limit))
                      (expect (checked-integer-literal (- limit 1) type #f) (- limit 1))
                      (expect (guard (failure (else #t)) (checked-integer-literal limit type #f) #f) #t)
                      (expect (guard (failure (else #t)) (checked-integer-literal (- (- limit) 1) type #f) #f) #t)))
                  '(I32 I64)))
      (define (test-numeric-literals)
        (run-test test-float-rounding)
        (run-test test-literal-ranges))))))
