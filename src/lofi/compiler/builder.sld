;; Constructive library syntax. Values wrap immutable host nodes belonging to
;; one explicit builder invocation; no constructor reads or compiles source.
(define-library (lofi compiler builder)
  (export Name SourceSpan ScopeId BindingId BindingReference TypeSyntax Expression
          Declaration ImportRename ImportSelection Import Export LofiLibrary
          builder-name source-span library-scope nested-scope binding
          local-reference import-reference reference-expression function-type
          type-i32 type-i64 type-f32 type-f64 type-bool type-char type-unit
          literal-i32 literal-i64 literal-f32 literal-f64 literal-bool literal-char
          lambda-expression application-expression conditional-expression definition
          all-imports only-imports import-rename rename-imports library-import
          library-export lofi-library library-token checked-library
          literal-number view-number-literal
          signature-location signature-location-set)
  (export
   DataField Signature MatchArm MethodImplementation
   DataCase ClassMethod ConstraintSyntax TypeVariableId type-variable
   variable-type reference-type list-type vector-type
   nominal-type constraint all-signature
   literal-string literal-bytevector
   block-expression annotation-expression instantiation-expression match-arm match-expression
   inferred-definition local-binding inferred-local-binding expression-statement data-field
   accessor-field data-constructor datatype-definition class-method typeclass-definition
   method-implementation instance-definition extern-definition overload-definition
   type-string type-bytevector type-never type-any
   binding-signature signature-definition builder-name-text same-binding? same-scope?
   same-type-variable? SourceSpanView view-span inspect-span ScopeIdView
   view-scope view-child-scope inspect-scope BindingIdView view-binding
   inspect-binding BindingReferenceView view-local-reference view-import-reference inspect-reference
   TypeSyntaxView view-type-i32 view-type-i64 view-type-f32 view-type-f64
   view-type-bool view-type-char view-type-unit view-type-string view-type-bytevector
   view-type-never view-type-any view-function-type view-variable-type view-reference-type
   view-list-type view-vector-type view-nominal-type inspect-type
   ExpressionView view-literal-i32 view-literal-i64 view-literal-f32 view-literal-f64
   view-literal-bool view-literal-char view-reference view-lambda view-application
   view-conditional view-string-literal view-bytevector-literal view-block
   view-annotation view-instantiation view-match inspect-expression DeclarationView
   view-definition view-inferred-definition view-local-binding view-inferred-local-binding view-expression-statement
   view-datatype view-typeclass view-instance view-extern
   view-overload inspect-declaration ImportRenameView view-rename-pair
   inspect-import-rename ImportSelectionView view-all view-only view-rename
   inspect-import-selection ImportView view-import inspect-import ExportView
   view-export inspect-export LofiLibraryView view-library inspect-library
   TypeVariableIdView view-variable-id inspect-type-variable ConstraintSyntaxView view-constraint
   inspect-constraint SignatureView view-binding-signature view-all-signature inspect-signature
   MatchArmView view-match-arm inspect-match-arm DataFieldView
   view-data-field view-accessor-field inspect-data-field DataCaseView view-data-case
   inspect-data-constructor ClassMethodView view-class-method inspect-class-method MethodImplementationView
   view-method-implementation inspect-method-implementation
   )
  (import
   (only (lofi primitive) null? car cdr cons empty-list string-length string-ref
         make-string string-set! make-bytevector bytevector-length bytevector-u8-ref bytevector-u8-set!
         i32-eq i64-eq i64-add i64-sub unreachable))
  (begin

    ;; ---- Nominal handles keep the constructor categories distinct ----

    (def Name (datatype ()
                (wrap-name
                 (token I64 name-token))))
    (def SourceSpan (datatype ()
                      (wrap-span
                       (token I64 span-token))))
    (def ScopeId (datatype ()
                   (wrap-scope
                    (token I64 scope-token))))
    (def BindingId (datatype ()
                     (wrap-binding
                      (token I64 binding-token))))
    (def BindingReference (datatype ()
                            (wrap-reference
                             (token I64 reference-token))))
    (def TypeSyntax (datatype ()
                      (wrap-type
                       (token I64 type-token))))
    (def Expression (datatype ()
                      (wrap-expression
                       (token I64 expression-token))))
    (def Declaration (datatype ()
                       (wrap-declaration
                        (token I64 declaration-token))))
    (def ImportRename (datatype ()
                        (wrap-rename
                         (token I64 rename-token))))
    (def ImportSelection (datatype ()
                           (wrap-selection
                            (token I64 selection-token))))
    (def Import (datatype ()
                  (wrap-import
                   (token I64 import-token))))
    (def Export (datatype ()
                  (wrap-export
                   (token I64 export-token))))
    (def LofiLibrary (datatype ()
                       (wrap-library
                        (token I64 library-token))))

    (def TypeVariableId (datatype ()
                          (wrap-variable
                           (token I64 variable-token))))
    (def ConstraintSyntax (datatype ()
                            (wrap-constraint
                             (token I64 constraint-token))))
    (def Signature (datatype ()
                     (wrap-signature
                      (token I64 signature-token))))
    (def MatchArm (datatype ()
                    (wrap-arm
                     (token I64 arm-token))))
    (def DataField (datatype ()
                     (wrap-field
                      (token I64 field-token))))
    (def DataCase (datatype ()
                    (wrap-case
                     (token I64 case-token))))
    (def ClassMethod (datatype ()
                       (wrap-method
                        (token I64 method-token))))
    (def MethodImplementation (datatype ()
                                (wrap-implementation
                                 (token I64 implementation-token))))

    ;; ---- Only scalar tokens and values cross the provider boundary ----

    (define-extern raw-signature-location "lofi.builder" "signature-location" (-> I64 I64))
    (define-extern raw-signature-location-set "lofi.builder" "signature-location-set" (-> I64 I64 I64))
    (define-extern raw-checked-library "lofi.builder" "checked-library" (-> I64 I64))
    (define-extern raw-number-literal "lofi.builder" "number-literal" (-> I64 I64 I64))
    (define-extern raw-name-empty "lofi.builder" "name-empty" (-> I64))
    (define-extern raw-name-character "lofi.builder" "name-character" (-> I64 Char I64))
    (define-extern raw-span "lofi.builder" "span" (-> I64 I32 I32 I64))
    (define-extern raw-root-scope "lofi.builder" "root-scope" (-> I64))
    (define-extern raw-child-scope "lofi.builder" "child-scope" (-> I64 I64))
    (define-extern raw-binding "lofi.builder" "binding" (-> I64 I64 I64 I64))
    (define-extern raw-nil "lofi.builder" "nil" (-> I64))
    (define-extern raw-cons "lofi.builder" "cons" (-> I64 I64 I64))
    (define-extern raw-scalar-type "lofi.builder" "scalar-type" (-> I32 I64))
    (define-extern raw-function-type "lofi.builder" "function-type" (-> I64 I64 I64))
    (define-extern raw-local-reference "lofi.builder" "local-reference" (-> I64 I64 I64))
    (define-extern raw-import-reference "lofi.builder" "import-reference" (-> I64 I64 I64 I64))
    (define-extern raw-reference "lofi.builder" "reference" (-> I64 I64))
    (define-extern raw-literal-I32 "lofi.builder" "literal-I32" (-> I32 I64 I64))
    (define-extern raw-literal-I64 "lofi.builder" "literal-I64" (-> I64 I64 I64))
    (define-extern raw-literal-F32 "lofi.builder" "literal-F32" (-> F32 I64 I64))
    (define-extern raw-literal-F64 "lofi.builder" "literal-F64" (-> F64 I64 I64))
    (define-extern raw-literal-Bool "lofi.builder" "literal-Bool" (-> Bool I64 I64))
    (define-extern raw-literal-Char "lofi.builder" "literal-Char" (-> Char I64 I64))
    (define-extern raw-lambda "lofi.builder" "lambda" (-> I64 I64 I64 I64 I64))
    (define-extern raw-application "lofi.builder" "application" (-> I64 I64 I64 I64))
    (define-extern raw-conditional "lofi.builder" "conditional" (-> I64 I64 I64 I64 I64))
    (define-extern raw-definition "lofi.builder" "definition" (-> I64 I64 I64 I64 I64))
    (define-extern raw-all "lofi.builder" "all" (-> I64))
    (define-extern raw-only "lofi.builder" "only" (-> I64 I64 I64))
    (define-extern raw-rename-pair "lofi.builder" "rename-pair" (-> I64 I64 I64))
    (define-extern raw-rename "lofi.builder" "rename" (-> I64 I64 I64))
    (define-extern raw-import "lofi.builder" "import" (-> I64 I64 I64 I64 I64))
    (define-extern raw-export "lofi.builder" "export" (-> I64 I64 I64))
    (define-extern raw-library "lofi.builder" "library" (-> I64 I64 I64 I64 I64 I64 I64))

    (define-extern raw-variable-id "lofi.builder" "variable-id" (-> I64 I64 I64 I64))
    (define-extern raw-variable-type "lofi.builder" "variable-type" (-> I64 I64))
    (define-extern raw-reference-type "lofi.builder" "reference-type" (-> I64 I64))
    (define-extern raw-list-type "lofi.builder" "list-type" (-> I64 I64))
    (define-extern raw-vector-type "lofi.builder" "vector-type" (-> I64 I64))
    (define-extern raw-nominal-type "lofi.builder" "nominal-type" (-> I64 I64 I64))
    (define-extern raw-constraint "lofi.builder" "constraint" (-> I64 I64 I64 I64))
    (define-extern raw-all-signature "lofi.builder" "all-signature" (-> I64 I64 I64 I64 I64 I64))
    (define-extern raw-string-literal "lofi.builder" "string-literal" (-> I64 I64 I64))
    (define-extern raw-bytevector-literal "lofi.builder" "bytevector-literal" (-> I64 I64 I64))
    (define-extern raw-block "lofi.builder" "block" (-> I64 I64 I64 I64 I64))
    (define-extern raw-annotation "lofi.builder" "annotation" (-> I64 I64 I64 I64))
    (define-extern raw-instantiation "lofi.builder" "instantiation" (-> I64 I64 I64 I64))
    (define-extern raw-match-arm "lofi.builder" "match-arm" (-> I64 I64 I64 I64 I64 I64))
    (define-extern raw-match "lofi.builder" "match" (-> I64 I64 I64 I64))
    (define-extern raw-inferred-definition "lofi.builder" "inferred-definition" (-> I64 I64 I64 I64))
    (define-extern raw-local-binding "lofi.builder" "local-binding" (-> I64 I64 I64 I64 I64))
    (define-extern raw-inferred-local-binding "lofi.builder" "inferred-local-binding" (-> I64 I64 I64 I64))
    (define-extern raw-expression-statement "lofi.builder" "expression-statement" (-> I64 I64))
    (define-extern raw-data-field "lofi.builder" "data-field" (-> I64 I64 I64 I64))
    (define-extern raw-accessor-field "lofi.builder" "accessor-field" (-> I64 I64 I64 I64 I64))
    (define-extern raw-data-case "lofi.builder" "data-case" (-> I64 I64 I64 I64))
    (define-extern raw-datatype "lofi.builder" "datatype" (-> I64 I64 I64 I64 I64 I64))
    (define-extern raw-class-method "lofi.builder" "class-method" (-> I64 I64 I64 I64))
    (define-extern raw-typeclass "lofi.builder" "typeclass" (-> I64 I64 I64 I64 I64 I64))
    (define-extern raw-method-implementation "lofi.builder" "method-implementation" (-> I64 I64 I64 I64))
    (define-extern raw-instance "lofi.builder" "instance" (-> I64 I64 I64 I64 I64))
    (define-extern raw-extern "lofi.builder" "extern" (-> I64 I64 I64 I64 I64 I64))
    (define-extern raw-overload "lofi.builder" "overload" (-> I64 I64 I64 I64 I64))
    (define-extern raw-byte "lofi.builder" "byte" (-> I64 I64))
    (define-extern raw-inspect-tag "lofi.builder" "inspect-tag" (-> I64 I32))
    (define-extern raw-inspect-field "lofi.builder" "inspect-field" (-> I64 I32 I64))
    (define-extern raw-name-length "lofi.builder" "name-length" (-> I64 I64))
    (define-extern raw-name-ref "lofi.builder" "name-ref" (-> I64 I64 Char))
    (define-extern raw-span-line "lofi.builder" "span-line" (-> I64 I32))
    (define-extern raw-span-column "lofi.builder" "span-column" (-> I64 I32))
    (define-extern raw-scalar-index "lofi.builder" "scalar-index" (-> I64 I32))
    (define-extern raw-literal-index "lofi.builder" "literal-index" (-> I64 I32))
    (define-extern raw-byte-value "lofi.builder" "byte-value" (-> I64 I64))
    (define-extern raw-sequence-length "lofi.builder" "sequence-length" (-> I64 I64))
    (define-extern raw-inspect-literal-I32 "lofi.builder" "inspect-literal-I32" (-> I64 I32))
    (define-extern raw-inspect-literal-I64 "lofi.builder" "inspect-literal-I64" (-> I64 I64))
    (define-extern raw-inspect-literal-F32 "lofi.builder" "inspect-literal-F32" (-> I64 F32))
    (define-extern raw-inspect-literal-F64 "lofi.builder" "inspect-literal-F64" (-> I64 F64))
    (define-extern raw-inspect-literal-Bool "lofi.builder" "inspect-literal-Bool" (-> I64 Bool))
    (define-extern raw-inspect-literal-Char "lofi.builder" "inspect-literal-Char" (-> I64 Char))

    ;; ---- Private provider tags name the closed syntax cases ----

    (def tag-span I32 1)
    (def tag-scope I32 2)
    (def tag-child-scope I32 3)
    (def tag-binding I32 4)
    (def tag-nil I32 5)
    (def tag-scalar-type I32 7)
    (def tag-function-type I32 8)
    (def tag-local-reference I32 9)
    (def tag-import-reference I32 10)
    (def tag-reference I32 11)
    (def tag-literal I32 12)
    (def tag-lambda I32 13)
    (def tag-application I32 14)
    (def tag-conditional I32 15)
    (def tag-definition I32 16)
    (def tag-all I32 17)
    (def tag-only I32 18)
    (def tag-rename-pair I32 19)
    (def tag-rename I32 20)
    (def tag-import I32 21)
    (def tag-export I32 22)
    (def tag-library I32 23)
    (def tag-variable-id I32 25)
    (def tag-variable-type I32 26)
    (def tag-reference-type I32 27)
    (def tag-list-type I32 28)
    (def tag-vector-type I32 29)
    (def tag-nominal-type I32 31)
    (def tag-constraint I32 32)
    (def tag-all-signature I32 33)
    (def tag-string-literal I32 38)
    (def tag-bytevector-literal I32 39)
    (def tag-block I32 41)
    (def tag-annotation I32 42)
    (def tag-instantiation I32 43)
    (def tag-match-arm I32 44)
    (def tag-match I32 45)
    (def tag-inferred-definition I32 46)
    (def tag-local-binding I32 47)
    (def tag-inferred-local-binding I32 48)
    (def tag-expression-statement I32 49)
    (def tag-data-field I32 50)
    (def tag-accessor-field I32 51)
    (def tag-data-case I32 52)
    (def tag-datatype I32 53)
    (def tag-class-method I32 54)
    (def tag-typeclass I32 55)
    (def tag-method-implementation I32 56)
    (def tag-instance I32 57)
    (def tag-extern I32 59)
    (def tag-overload I32 60)
    (def tag-number-literal I32 61)

    ;; ---- Ordinary lists are copied into immutable sequence nodes ----

    (def encode-names (-> (List Name) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (name-token (car items)) (encode-names (cdr items))))))
    (def encode-bindings (-> (List BindingId) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (binding-token (car items)) (encode-bindings (cdr items))))))
    (def encode-types (-> (List TypeSyntax) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (type-token (car items)) (encode-types (cdr items))))))
    (def encode-expressions (-> (List Expression) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (expression-token (car items)) (encode-expressions (cdr items))))))
    (def encode-declarations (-> (List Declaration) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (declaration-token (car items)) (encode-declarations (cdr items))))))
    (def encode-renames (-> (List ImportRename) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (rename-token (car items)) (encode-renames (cdr items))))))
    (def encode-imports (-> (List Import) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (import-token (car items)) (encode-imports (cdr items))))))
    (def encode-exports (-> (List Export) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (export-token (car items)) (encode-exports (cdr items))))))

    (def decode-names (-> I64 (List Name))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-name (raw-inspect-field token 0)) (decode-names (raw-inspect-field token 1))))))
    (def decode-bindings (-> I64 (List BindingId))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-binding (raw-inspect-field token 0)) (decode-bindings (raw-inspect-field token 1))))))
    (def decode-types (-> I64 (List TypeSyntax))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-type (raw-inspect-field token 0)) (decode-types (raw-inspect-field token 1))))))
    (def decode-expressions (-> I64 (List Expression))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-expression (raw-inspect-field token 0)) (decode-expressions (raw-inspect-field token 1))))))
    (def decode-declarations (-> I64 (List Declaration))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-declaration (raw-inspect-field token 0)) (decode-declarations (raw-inspect-field token 1))))))
    (def decode-renames (-> I64 (List ImportRename))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-rename (raw-inspect-field token 0)) (decode-renames (raw-inspect-field token 1))))))
    (def decode-imports (-> I64 (List Import))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-import (raw-inspect-field token 0)) (decode-imports (raw-inspect-field token 1))))))
    (def decode-exports (-> I64 (List Export))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-export (raw-inspect-field token 0)) (decode-exports (raw-inspect-field token 1))))))
    (def encode-variables (-> (List TypeVariableId) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (variable-token (car items)) (encode-variables (cdr items))))))
    (def decode-variables (-> I64 (List TypeVariableId))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-variable (raw-inspect-field token 0)) (decode-variables (raw-inspect-field token 1))))))
    (def encode-constraints (-> (List ConstraintSyntax) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (constraint-token (car items)) (encode-constraints (cdr items))))))
    (def decode-constraints (-> I64 (List ConstraintSyntax))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-constraint (raw-inspect-field token 0)) (decode-constraints (raw-inspect-field token 1))))))
    (def encode-arms (-> (List MatchArm) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (arm-token (car items)) (encode-arms (cdr items))))))
    (def decode-arms (-> I64 (List MatchArm))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-arm (raw-inspect-field token 0)) (decode-arms (raw-inspect-field token 1))))))
    (def encode-fields (-> (List DataField) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (field-token (car items)) (encode-fields (cdr items))))))
    (def decode-fields (-> I64 (List DataField))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-field (raw-inspect-field token 0)) (decode-fields (raw-inspect-field token 1))))))
    (def encode-cases (-> (List DataCase) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (case-token (car items)) (encode-cases (cdr items))))))
    (def decode-cases (-> I64 (List DataCase))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-case (raw-inspect-field token 0)) (decode-cases (raw-inspect-field token 1))))))
    (def encode-methods (-> (List ClassMethod) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (method-token (car items)) (encode-methods (cdr items))))))
    (def decode-methods (-> I64 (List ClassMethod))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-method (raw-inspect-field token 0)) (decode-methods (raw-inspect-field token 1))))))
    (def encode-implementations (-> (List MethodImplementation) I64)
         (lambda (items)
           (if (null? items) (raw-nil)
               (raw-cons (implementation-token (car items)) (encode-implementations (cdr items))))))
    (def decode-implementations (-> I64 (List MethodImplementation))
         (lambda (token)
           (if (i32-eq (raw-inspect-tag token) tag-nil) (empty-list)
               (cons (wrap-implementation (raw-inspect-field token 0)) (decode-implementations (raw-inspect-field token 1))))))

    ;; ---- Names, locations, scopes and explicit binding identities ----

    (def builder-name (-> String Name)
         (lambda (text)
           (begin
             (def loop (-> I64 I64 I64)
                  (lambda (index token)
                    (if (i64-eq index (string-length text)) token
                        (loop (i64-add index (ann 1 I64))
                              (raw-name-character token (string-ref text index))))))
             (wrap-name (loop (ann 0 I64) (raw-name-empty))))))
    (def source-span (-> Name I32 I32 SourceSpan)
         (lambda (source line column) (wrap-span (raw-span (name-token source) line column))))
    (def library-scope (-> ScopeId)
         (lambda () (wrap-scope (raw-root-scope))))
    (def nested-scope (-> ScopeId ScopeId)
         (lambda (parent) (wrap-scope (raw-child-scope (scope-token parent)))))
    (def binding (-> ScopeId Name SourceSpan BindingId)
         (lambda (scope name span) (wrap-binding (raw-binding (scope-token scope) (name-token name) (span-token span)))))
    (def local-reference (-> BindingId SourceSpan BindingReference)
         (lambda (binding span) (wrap-reference (raw-local-reference (binding-token binding) (span-token span)))))
    (def import-reference (-> ScopeId Name SourceSpan BindingReference)
         (lambda (scope name span) (wrap-reference (raw-import-reference (scope-token scope) (name-token name) (span-token span)))))

    ;; ---- Declared types and expression syntax ----

    (def type-i32 (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 0 I32)))))
    (def type-i64 (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 1 I32)))))
    (def type-f32 (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 2 I32)))))
    (def type-f64 (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 3 I32)))))
    (def type-bool (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 4 I32)))))
    (def type-char (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 5 I32)))))
    (def type-unit (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type (ann 6 I32)))))
    (def function-type (-> (List TypeSyntax) TypeSyntax TypeSyntax)
         (lambda (parameters result) (wrap-type (raw-function-type (encode-types parameters) (type-token result)))))
    (def reference-expression (-> BindingReference Expression)
         (lambda (reference) (wrap-expression (raw-reference (reference-token reference)))))
    ;; The provider checks origin and syntax category before wrapping transport.
    (def signature-location (-> Declaration SourceSpan)
         (lambda (declaration) (wrap-span (raw-signature-location (declaration-token declaration)))))
    (def signature-location-set (-> Declaration SourceSpan Declaration)
         (lambda (declaration span)
           (wrap-declaration (raw-signature-location-set (declaration-token declaration) (span-token span)))))
    (def checked-library (-> I64 LofiLibrary)
         (lambda (token) (wrap-library (raw-checked-library token))))
    (def literal-number (-> String SourceSpan Expression)
         (lambda (spelling span)
           (wrap-expression (raw-number-literal (name-token (builder-name spelling)) (span-token span)))))
    (def literal-i32 (-> I32 SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-I32 value (span-token span)))))
    (def literal-i64 (-> I64 SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-I64 value (span-token span)))))
    (def literal-f32 (-> F32 SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-F32 value (span-token span)))))
    (def literal-f64 (-> F64 SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-F64 value (span-token span)))))
    (def literal-bool (-> Bool SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-Bool value (span-token span)))))
    (def literal-char (-> Char SourceSpan Expression)
         (lambda (value span) (wrap-expression (raw-literal-Char value (span-token span)))))
    (def lambda-expression (-> ScopeId (List BindingId) Expression SourceSpan Expression)
         (lambda (scope parameters body span)
           (wrap-expression (raw-lambda (scope-token scope) (encode-bindings parameters)
                                        (expression-token body) (span-token span)))))
    (def application-expression (-> Expression (List Expression) SourceSpan Expression)
         (lambda (operator arguments span)
           (wrap-expression (raw-application (expression-token operator) (encode-expressions arguments)
                                             (span-token span)))))
    (def conditional-expression (-> Expression Expression Expression SourceSpan Expression)
         (lambda (test yes no span)
           (wrap-expression (raw-conditional (expression-token test) (expression-token yes)
                                             (expression-token no) (span-token span)))))
    (def definition (-> BindingId TypeSyntax Expression SourceSpan Declaration)
         (lambda (binding type value span)
           (wrap-declaration (raw-definition (binding-token binding) (type-token type)
                                             (expression-token value) (span-token span)))))

    ;; ---- Imports stay descriptive until the result is compiled ----

    (def all-imports (-> ImportSelection)
         (lambda () (wrap-selection (raw-all))))
    (def only-imports (-> ImportSelection (List Name) ImportSelection)
         (lambda (from names) (wrap-selection (raw-only (selection-token from) (encode-names names)))))
    (def import-rename (-> Name Name ImportRename)
         (lambda (from to) (wrap-rename (raw-rename-pair (name-token from) (name-token to)))))
    (def rename-imports (-> ImportSelection (List ImportRename) ImportSelection)
         (lambda (from renames) (wrap-selection (raw-rename (selection-token from) (encode-renames renames)))))
    (def library-import (-> (List Name) ImportSelection ScopeId SourceSpan Import)
         (lambda (key selection scope span)
           (wrap-import (raw-import (encode-names key) (selection-token selection)
                                    (scope-token scope) (span-token span)))))
    (def library-export (-> Name BindingReference Export)
         (lambda (name reference) (wrap-export (raw-export (name-token name) (reference-token reference)))))
    (def lofi-library (-> (List Name) ScopeId (List Import) (List Export) (List Declaration) SourceSpan LofiLibrary)
         (lambda (key scope imports exports declarations span)
           (wrap-library (raw-library (encode-names key) (scope-token scope) (encode-imports imports)
                                      (encode-exports exports) (encode-declarations declarations) (span-token span)))))

    ;; ---- Complete type, statement and static declaration constructors ----

    (def type-variable (-> ScopeId Name SourceSpan TypeVariableId)
         (lambda (scope name span)
           (wrap-variable (raw-variable-id (scope-token scope) (name-token name) (span-token span)))))
    (def variable-type (-> TypeVariableId TypeSyntax)
         (lambda (variable)
           (wrap-type (raw-variable-type (variable-token variable)))))
    (def reference-type (-> TypeSyntax TypeSyntax)
         (lambda (element)
           (wrap-type (raw-reference-type (type-token element)))))
    (def list-type (-> TypeSyntax TypeSyntax)
         (lambda (element)
           (wrap-type (raw-list-type (type-token element)))))
    (def vector-type (-> TypeSyntax TypeSyntax)
         (lambda (element)
           (wrap-type (raw-vector-type (type-token element)))))
    (def nominal-type (-> BindingReference (List TypeSyntax) TypeSyntax)
         (lambda (reference arguments)
           (wrap-type (raw-nominal-type (reference-token reference) (encode-types arguments)))))
    (def constraint (-> BindingReference (List TypeSyntax) SourceSpan ConstraintSyntax)
         (lambda (reference arguments span)
           (wrap-constraint (raw-constraint (reference-token reference) (encode-types arguments) (span-token span)))))
    (def all-signature (-> ScopeId (List TypeVariableId) (List ConstraintSyntax) TypeSyntax SourceSpan Signature)
         (lambda (scope variables constraints type span)
           (wrap-signature
            (raw-all-signature
             (scope-token scope)
             (encode-variables variables)
             (encode-constraints constraints)
             (type-token type)
             (span-token span)))))
    (def literal-string (-> String SourceSpan Expression)
         (lambda (value span)
           (wrap-expression (raw-string-literal (name-token (builder-name value)) (span-token span)))))
    (def literal-bytevector (-> Bytevector SourceSpan Expression)
         (lambda (value span)
           (wrap-expression (raw-bytevector-literal (encode-bytes value) (span-token span)))))
    (def block-expression (-> ScopeId (List Declaration) Expression SourceSpan Expression)
         (lambda (scope statements result span)
           (wrap-expression (raw-block (scope-token scope) (encode-declarations statements) (expression-token result) (span-token span)))))
    (def annotation-expression (-> Expression TypeSyntax SourceSpan Expression)
         (lambda (expression type span)
           (wrap-expression (raw-annotation (expression-token expression) (type-token type) (span-token span)))))
    (def instantiation-expression (-> BindingReference (List TypeSyntax) SourceSpan Expression)
         (lambda (reference arguments span)
           (wrap-expression (raw-instantiation (reference-token reference) (encode-types arguments) (span-token span)))))
    (def match-arm (-> BindingReference ScopeId (List BindingId) Expression SourceSpan MatchArm)
         (lambda (constructor scope parameters body span)
           (wrap-arm
            (raw-match-arm
             (reference-token constructor)
             (scope-token scope)
             (encode-bindings parameters)
             (expression-token body)
             (span-token span)))))
    (def match-expression (-> Expression (List MatchArm) SourceSpan Expression)
         (lambda (subject arms span)
           (wrap-expression (raw-match (expression-token subject) (encode-arms arms) (span-token span)))))
    (def inferred-definition (-> BindingId Expression SourceSpan Declaration)
         (lambda (binding value span)
           (wrap-declaration (raw-inferred-definition (binding-token binding) (expression-token value) (span-token span)))))
    (def local-binding (-> BindingId Signature Expression SourceSpan Declaration)
         (lambda (binding signature value span)
           (wrap-declaration
            (raw-local-binding
             (binding-token binding)
             (signature-token signature)
             (expression-token value)
             (span-token span)))))
    (def inferred-local-binding (-> BindingId Expression SourceSpan Declaration)
         (lambda (binding value span)
           (wrap-declaration (raw-inferred-local-binding (binding-token binding) (expression-token value) (span-token span)))))
    (def expression-statement (-> Expression Declaration)
         (lambda (expression)
           (wrap-declaration (raw-expression-statement (expression-token expression)))))
    (def data-field (-> Name TypeSyntax SourceSpan DataField)
         (lambda (name type span)
           (wrap-field (raw-data-field (name-token name) (type-token type) (span-token span)))))
    (def accessor-field (-> Name TypeSyntax BindingId SourceSpan DataField)
         (lambda (name type accessor span)
           (wrap-field (raw-accessor-field (name-token name) (type-token type) (binding-token accessor) (span-token span)))))
    (def data-constructor (-> BindingId (List DataField) SourceSpan DataCase)
         (lambda (binding fields span)
           (wrap-case (raw-data-case (binding-token binding) (encode-fields fields) (span-token span)))))
    (def datatype-definition (-> BindingId ScopeId (List TypeVariableId) (List DataCase) SourceSpan Declaration)
         (lambda (binding scope parameters cases span)
           (wrap-declaration
            (raw-datatype
             (binding-token binding)
             (scope-token scope)
             (encode-variables parameters)
             (encode-cases cases)
             (span-token span)))))
    (def class-method (-> BindingId TypeSyntax SourceSpan ClassMethod)
         (lambda (binding type span)
           (wrap-method (raw-class-method (binding-token binding) (type-token type) (span-token span)))))
    (def typeclass-definition (-> BindingId ScopeId (List TypeVariableId) (List ClassMethod) SourceSpan Declaration)
         (lambda (binding scope parameters methods span)
           (wrap-declaration
            (raw-typeclass
             (binding-token binding)
             (scope-token scope)
             (encode-variables parameters)
             (encode-methods methods)
             (span-token span)))))
    (def method-implementation (-> BindingReference Expression SourceSpan MethodImplementation)
         (lambda (method value span)
           (wrap-implementation (raw-method-implementation (reference-token method) (expression-token value) (span-token span)))))
    (def instance-definition (-> BindingId ConstraintSyntax (List MethodImplementation) SourceSpan Declaration)
         (lambda (binding head methods span)
           (wrap-declaration (raw-instance (binding-token binding) (constraint-token head) (encode-implementations methods) (span-token span)))))
    (def extern-definition (-> BindingId String String TypeSyntax SourceSpan Declaration)
         (lambda (binding module symbol type span)
           (wrap-declaration
            (raw-extern
             (binding-token binding)
             (name-token (builder-name module))
             (name-token (builder-name symbol))
             (type-token type)
             (span-token span)))))
    (def overload-definition (-> BindingId Signature Expression SourceSpan Declaration)
         (lambda (binding signature value span)
           (wrap-declaration (raw-overload (binding-token binding) (signature-token signature) (expression-token value) (span-token span)))))
    (def type-string (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type 7))))
    (def type-bytevector (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type 8))))
    (def type-never (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type 9))))
    (def type-any (-> TypeSyntax)
         (lambda () (wrap-type (raw-scalar-type 10))))
    (def binding-signature (-> TypeSyntax Signature)
         (lambda (type) (wrap-signature (type-token type))))
    (def signature-definition (-> BindingId Signature Expression SourceSpan Declaration)
         (lambda (binding signature value span)
           (wrap-declaration (raw-definition (binding-token binding) (signature-token signature)
                                             (expression-token value) (span-token span)))))
    (def same-binding? (-> BindingId BindingId Bool)
         (lambda (left right) (i64-eq (binding-token left) (binding-token right))))
    (def same-scope? (-> ScopeId ScopeId Bool)
         (lambda (left right) (i64-eq (scope-token left) (scope-token right))))
    (def same-type-variable? (-> TypeVariableId TypeVariableId Bool)
         (lambda (left right) (i64-eq (variable-token left) (variable-token right))))

    ;; ---- Text and bytes cross the boundary only as scalar copies ----

    (def encode-bytes (-> Bytevector I64)
         (lambda (bytes)
           (begin
             (def loop (-> I64 I64 I64)
                  (lambda (index tail)
                    (if (i64-eq index (ann 0 I64)) tail
                        (begin (let previous (i64-sub index (ann 1 I64)))
                               (loop previous (raw-cons (raw-byte (bytevector-u8-ref bytes previous)) tail))))))
             (loop (bytevector-length bytes) (raw-nil)))))
    (def builder-name-text (-> Name String)
         (lambda (name)
           (begin
             (let token (name-token name))
             (let length (raw-name-length token))
             (let result (make-string length #\space))
             (def loop (-> I64 String)
                  (lambda (index)
                    (if (i64-eq index length) result
                        (begin (string-set! result index (raw-name-ref token index))
                               (loop (i64-add index (ann 1 I64)))))))
             (loop (ann 0 I64)))))
    (def decode-bytes (-> I64 Bytevector)
         (lambda (token)
           (begin
             (let result (make-bytevector (raw-sequence-length token) (ann 0 I64)))
             (def loop (-> I64 I64 Bytevector)
                  (lambda (tail index)
                    (if (i32-eq (raw-inspect-tag tail) tag-nil) result
                        (begin (bytevector-u8-set! result index (raw-byte-value (raw-inspect-field tail 0)))
                               (loop (raw-inspect-field tail 1) (i64-add index (ann 1 I64)))))))
             (loop token (ann 0 I64)))))

    ;; ---- Immutable views expose syntax without granting checking authority ----

    (def SourceSpanView
         (datatype ()
           (view-span
            (source Name)
            (line I32)
            (column I32)) ))
    (def inspect-span (-> SourceSpan SourceSpanView)
         (lambda (value)
           (begin (let token (span-token value))
                  (let tag (raw-inspect-tag token))
                  (if (i32-eq tag tag-span)
                      (view-span (wrap-name (raw-inspect-field token 0)) (raw-span-line token) (raw-span-column token))
                      (unreachable)))))
    (def ScopeIdView
         (datatype ()
           (view-scope)
           (view-child-scope
            (parent ScopeId)) ))
    (def inspect-scope (-> ScopeId ScopeIdView)
         (lambda (value)
           (begin (let token (scope-token value))
                  (let tag (raw-inspect-tag token))
                  (if (i32-eq tag tag-scope)
                      (view-scope)
                      (if (i32-eq tag tag-child-scope)
                          (view-child-scope (wrap-scope (raw-inspect-field token 0)))
                          (unreachable))))))
    (def BindingIdView
         (datatype ()
           (view-binding
            (scope ScopeId)
            (name Name)
            (span SourceSpan)) ))
    (def inspect-binding (-> BindingId BindingIdView)
         (lambda (value)
           (begin (let token (binding-token value))
                  (let tag (raw-inspect-tag token))
                  (if (i32-eq tag tag-binding)
                      (view-binding
                       (wrap-scope (raw-inspect-field token 0))
                       (wrap-name (raw-inspect-field token 1))
                       (wrap-span (raw-inspect-field token 2)))
                      (unreachable)))))
    (def BindingReferenceView
         (datatype ()
           (view-local-reference
            (binding BindingId)
            (span SourceSpan))
           (view-import-reference
            (scope ScopeId)
            (name Name)
            (span SourceSpan)) ))
    (def inspect-reference (-> BindingReference BindingReferenceView)
         (lambda (value)
           (begin (let token (reference-token value))
                  (let tag (raw-inspect-tag token))
                  (if (i32-eq tag tag-local-reference)
                      (view-local-reference (wrap-binding (raw-inspect-field token 0)) (wrap-span (raw-inspect-field token 1)))
                      (if (i32-eq tag tag-import-reference)
                          (view-import-reference
                           (wrap-scope (raw-inspect-field token 0))
                           (wrap-name (raw-inspect-field token 1))
                           (wrap-span (raw-inspect-field token 2)))
                          (unreachable))))))
    (def TypeSyntaxView
         (datatype ()
           (view-type-i32)
           (view-type-i64)
           (view-type-f32)
           (view-type-f64)
           (view-type-bool)
           (view-type-char)
           (view-type-unit)
           (view-type-string)
           (view-type-bytevector)
           (view-type-never)
           (view-type-any)
           (view-function-type
            (parameters (List TypeSyntax))
            (result TypeSyntax))
           (view-variable-type
            (variable TypeVariableId))
           (view-reference-type
            (element TypeSyntax))
           (view-list-type
            (element TypeSyntax))
           (view-vector-type
            (element TypeSyntax))
           (view-nominal-type
            (reference BindingReference)
            (arguments (List TypeSyntax))) ))
    (def inspect-scalar-type (-> I32 TypeSyntaxView)
         (lambda (index)
           (if (i32-eq index 0)
               (view-type-i32)
               (if (i32-eq index 1)
                   (view-type-i64)
                   (if (i32-eq index 2)
                       (view-type-f32)
                       (if (i32-eq index 3)
                           (view-type-f64)
                           (if (i32-eq index 4)
                               (view-type-bool)
                               (if (i32-eq index 5)
                                   (view-type-char)
                                   (if (i32-eq index 6)
                                       (view-type-unit)
                                       (if (i32-eq index 7)
                                           (view-type-string)
                                           (if (i32-eq index 8)
                                               (view-type-bytevector)
                                               (if (i32-eq index 9)
                                                   (view-type-never)
                                                   (if (i32-eq index 10) (view-type-any) (unreachable))))))))))))))
    (def inspect-type (-> TypeSyntax TypeSyntaxView)
         (lambda (value)
           (begin (let token (type-token value))
                  (let tag (raw-inspect-tag token))
                  (if (i32-eq tag tag-scalar-type)
                      (inspect-scalar-type (raw-scalar-index token))
                      (if (i32-eq tag tag-function-type)
                          (view-function-type (decode-types (raw-inspect-field token 0)) (wrap-type (raw-inspect-field token 1)))
                          (if (i32-eq tag tag-variable-type)
                              (view-variable-type (wrap-variable (raw-inspect-field token 0)))
                              (if (i32-eq tag tag-reference-type)
                                  (view-reference-type (wrap-type (raw-inspect-field token 0)))
                                  (if (i32-eq tag tag-list-type)
                                      (view-list-type (wrap-type (raw-inspect-field token 0)))
                                      (if (i32-eq tag tag-vector-type)
                                          (view-vector-type (wrap-type (raw-inspect-field token 0)))
                                          (if (i32-eq tag tag-nominal-type)
                                              (view-nominal-type
                                               (wrap-reference (raw-inspect-field token 0))
                                               (decode-types (raw-inspect-field token 1)))
                                              (unreachable)))))))))))
    (def ExpressionView
         (datatype ()
           (view-number-literal
            (spelling String)
            (span SourceSpan))
           (view-literal-i32
            (value I32)
            (span SourceSpan))
           (view-literal-i64
            (value I64)
            (span SourceSpan))
           (view-literal-f32
            (value F32)
            (span SourceSpan))
           (view-literal-f64
            (value F64)
            (span SourceSpan))
           (view-literal-bool
            (value Bool)
            (span SourceSpan))
           (view-literal-char
            (value Char)
            (span SourceSpan))
           (view-reference
            (reference BindingReference))
           (view-lambda
            (scope ScopeId)
            (parameters (List BindingId))
            (body Expression)
            (span SourceSpan))
           (view-application
            (operator Expression)
            (arguments (List Expression))
            (span SourceSpan))
           (view-conditional
            (test Expression)
            (yes Expression)
            (no Expression)
            (span SourceSpan))
           (view-string-literal
            (value String)
            (span SourceSpan))
           (view-bytevector-literal
            (value Bytevector)
            (span SourceSpan))
           (view-block
            (scope ScopeId)
            (statements (List Declaration))
            (result Expression)
            (span SourceSpan))
           (view-annotation
            (expression Expression)
            (type TypeSyntax)
            (span SourceSpan))
           (view-instantiation
            (reference BindingReference)
            (arguments (List TypeSyntax))
            (span SourceSpan))
           (view-match
            (subject Expression)
            (arms (List MatchArm))
            (span SourceSpan)) ))
    (def inspect-scalar-literal (-> I64 I32 ExpressionView)
         (lambda (token index)
           (if (i32-eq index 0)
               (view-literal-i32 (raw-inspect-literal-I32 token) (wrap-span (raw-inspect-field token 2)))
               (if (i32-eq index 1)
                   (view-literal-i64 (raw-inspect-literal-I64 token) (wrap-span (raw-inspect-field token 2)))
                   (if (i32-eq index 2)
                       (view-literal-f32 (raw-inspect-literal-F32 token) (wrap-span (raw-inspect-field token 2)))
                       (if (i32-eq index 3)
                           (view-literal-f64 (raw-inspect-literal-F64 token) (wrap-span (raw-inspect-field token 2)))
                           (if (i32-eq index 4)
                               (view-literal-bool
                                (raw-inspect-literal-Bool token)
                                (wrap-span (raw-inspect-field token 2)))
                               (if (i32-eq index 5)
                                   (view-literal-char
                                    (raw-inspect-literal-Char token)
                                    (wrap-span (raw-inspect-field token 2)))
                                   (unreachable)))))))))
    (def inspect-expression (-> Expression ExpressionView)
         (lambda (value)
           (begin (let token (expression-token value))
                  (let tag (raw-inspect-tag token))
                  (if (i32-eq tag tag-number-literal)
                      (view-number-literal (builder-name-text (wrap-name (raw-inspect-field token 0)))
                                           (wrap-span (raw-inspect-field token 1)))
                      (if (i32-eq tag tag-literal)
                          (inspect-scalar-literal token (raw-literal-index token))
                          (if (i32-eq tag tag-reference)
                              (view-reference (wrap-reference (raw-inspect-field token 0)))
                              (if (i32-eq tag tag-lambda)
                                  (view-lambda
                                   (wrap-scope (raw-inspect-field token 0))
                                   (decode-bindings (raw-inspect-field token 1))
                                   (wrap-expression (raw-inspect-field token 2))
                                   (wrap-span (raw-inspect-field token 3)))
                                  (if (i32-eq tag tag-application)
                                      (view-application
                                       (wrap-expression (raw-inspect-field token 0))
                                       (decode-expressions (raw-inspect-field token 1))
                                       (wrap-span (raw-inspect-field token 2)))
                                      (if (i32-eq tag tag-conditional)
                                          (view-conditional
                                           (wrap-expression (raw-inspect-field token 0))
                                           (wrap-expression (raw-inspect-field token 1))
                                           (wrap-expression (raw-inspect-field token 2))
                                           (wrap-span (raw-inspect-field token 3)))
                                          (if (i32-eq tag tag-string-literal)
                                              (view-string-literal
                                               (builder-name-text (wrap-name (raw-inspect-field token 0)))
                                               (wrap-span (raw-inspect-field token 1)))
                                              (if (i32-eq tag tag-bytevector-literal)
                                                  (view-bytevector-literal
                                                   (decode-bytes (raw-inspect-field token 0))
                                                   (wrap-span (raw-inspect-field token 1)))
                                                  (if (i32-eq tag tag-block)
                                                      (view-block
                                                       (wrap-scope (raw-inspect-field token 0))
                                                       (decode-declarations (raw-inspect-field token 1))
                                                       (wrap-expression (raw-inspect-field token 2))
                                                       (wrap-span (raw-inspect-field token 3)))
                                                      (if (i32-eq tag tag-annotation)
                                                          (view-annotation
                                                           (wrap-expression (raw-inspect-field token 0))
                                                           (wrap-type (raw-inspect-field token 1))
                                                           (wrap-span (raw-inspect-field token 2)))
                                                          (if (i32-eq tag tag-instantiation)
                                                              (view-instantiation
                                                               (wrap-reference (raw-inspect-field token 0))
                                                               (decode-types (raw-inspect-field token 1))
                                                               (wrap-span (raw-inspect-field token 2)))
                                                              (if (i32-eq tag tag-match)
                                                                  (view-match
                                                                   (wrap-expression (raw-inspect-field token 0))
                                                                   (decode-arms (raw-inspect-field token 1))
                                                                   (wrap-span (raw-inspect-field token 2)))
                                                                  (unreachable))))))))))))))))
    (def DeclarationView
         (datatype ()
           (view-definition
            (binding BindingId)
            (signature Signature)
            (value Expression)
            (span SourceSpan))
           (view-inferred-definition
            (binding BindingId)
            (value Expression)
            (span SourceSpan))
           (view-local-binding
            (binding BindingId)
            (signature Signature)
            (value Expression)
            (span SourceSpan))
           (view-inferred-local-binding
            (binding BindingId)
            (value Expression)
            (span SourceSpan))
           (view-expression-statement
            (expression Expression))
           (view-datatype
            (binding BindingId)
            (scope ScopeId)
            (parameters (List TypeVariableId))
            (cases (List DataCase))
            (span SourceSpan))
           (view-typeclass
            (binding BindingId)
            (scope ScopeId)
            (parameters (List TypeVariableId))
            (methods (List ClassMethod))
            (span SourceSpan))
           (view-instance
            (binding BindingId)
            (head ConstraintSyntax)
            (methods (List MethodImplementation))
            (span SourceSpan))
           (view-extern
            (binding BindingId)
            (module String)
            (symbol String)
            (type TypeSyntax)
            (span SourceSpan))
           (view-overload
            (binding BindingId)
            (signature Signature)
            (value Expression)
            (span SourceSpan)) ))
    (def inspect-declaration (-> Declaration DeclarationView)
         (lambda (value)
           (begin (let token (declaration-token value))
                  (let tag (raw-inspect-tag token))
                  (if (i32-eq tag tag-definition)
                      (view-definition
                       (wrap-binding (raw-inspect-field token 0))
                       (wrap-signature (raw-inspect-field token 1))
                       (wrap-expression (raw-inspect-field token 2))
                       (wrap-span (raw-inspect-field token 3)))
                      (if (i32-eq tag tag-inferred-definition)
                          (view-inferred-definition
                           (wrap-binding (raw-inspect-field token 0))
                           (wrap-expression (raw-inspect-field token 1))
                           (wrap-span (raw-inspect-field token 2)))
                          (if (i32-eq tag tag-local-binding)
                              (view-local-binding
                               (wrap-binding (raw-inspect-field token 0))
                               (wrap-signature (raw-inspect-field token 1))
                               (wrap-expression (raw-inspect-field token 2))
                               (wrap-span (raw-inspect-field token 3)))
                              (if (i32-eq tag tag-inferred-local-binding)
                                  (view-inferred-local-binding
                                   (wrap-binding (raw-inspect-field token 0))
                                   (wrap-expression (raw-inspect-field token 1))
                                   (wrap-span (raw-inspect-field token 2)))
                                  (if (i32-eq tag tag-expression-statement)
                                      (view-expression-statement (wrap-expression (raw-inspect-field token 0)))
                                      (if (i32-eq tag tag-datatype)
                                          (view-datatype
                                           (wrap-binding (raw-inspect-field token 0))
                                           (wrap-scope (raw-inspect-field token 1))
                                           (decode-variables (raw-inspect-field token 2))
                                           (decode-cases (raw-inspect-field token 3))
                                           (wrap-span (raw-inspect-field token 4)))
                                          (if (i32-eq tag tag-typeclass)
                                              (view-typeclass
                                               (wrap-binding (raw-inspect-field token 0))
                                               (wrap-scope (raw-inspect-field token 1))
                                               (decode-variables (raw-inspect-field token 2))
                                               (decode-methods (raw-inspect-field token 3))
                                               (wrap-span (raw-inspect-field token 4)))
                                              (if (i32-eq tag tag-instance)
                                                  (view-instance
                                                   (wrap-binding (raw-inspect-field token 0))
                                                   (wrap-constraint (raw-inspect-field token 1))
                                                   (decode-implementations (raw-inspect-field token 2))
                                                   (wrap-span (raw-inspect-field token 3)))
                                                  (if (i32-eq tag tag-extern)
                                                      (view-extern
                                                       (wrap-binding (raw-inspect-field token 0))
                                                       (builder-name-text
                                                        (wrap-name (raw-inspect-field token 1)))
                                                       (builder-name-text
                                                        (wrap-name (raw-inspect-field token 2)))
                                                       (wrap-type (raw-inspect-field token 3))
                                                       (wrap-span (raw-inspect-field token 4)))
                                                      (if (i32-eq tag tag-overload)
                                                          (view-overload
                                                           (wrap-binding (raw-inspect-field token 0))
                                                           (wrap-signature (raw-inspect-field token 1))
                                                           (wrap-expression (raw-inspect-field token 2))
                                                           (wrap-span (raw-inspect-field token 3)))
                                                          (unreachable))))))))))))))
    (def ImportRenameView
         (datatype ()
           (view-rename-pair
            (from Name)
            (to Name)) ))
    (def inspect-import-rename (-> ImportRename ImportRenameView)
         (lambda (value)
           (begin (let token (rename-token value))
                  (let tag (raw-inspect-tag token))
                  (if (i32-eq tag tag-rename-pair)
                      (view-rename-pair (wrap-name (raw-inspect-field token 0)) (wrap-name (raw-inspect-field token 1)))
                      (unreachable)))))
    (def ImportSelectionView
         (datatype ()
           (view-all)
           (view-only
            (selection ImportSelection)
            (names (List Name)))
           (view-rename
            (selection ImportSelection)
            (renames (List ImportRename))) ))
    (def inspect-import-selection (-> ImportSelection ImportSelectionView)
         (lambda (value)
           (begin (let token (selection-token value))
                  (let tag (raw-inspect-tag token))
                  (if (i32-eq tag tag-all)
                      (view-all)
                      (if (i32-eq tag tag-only)
                          (view-only (wrap-selection (raw-inspect-field token 0)) (decode-names (raw-inspect-field token 1)))
                          (if (i32-eq tag tag-rename)
                              (view-rename (wrap-selection (raw-inspect-field token 0)) (decode-renames (raw-inspect-field token 1)))
                              (unreachable)))))))
