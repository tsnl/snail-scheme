;; Check source once and freeze its evidence into an immutable typed tree.
;; Solver holes and lexical checking state belong to this visit; specialization
;; consumes the tree instead of replaying source typing rules.
(define-library (lofi compiler infer)
  (export infer-program infer-literal judgment-type judgment-detail)
  (import
   (scheme base)
   (scheme cxr)
   (lofi compiler types)
   (lofi compiler typed)
   (lofi compiler checked)
   (lofi compiler overloads)
   (lofi compiler primitives)
   (lofi compiler data)
   (lofi compiler numeric-literals)
   (only (srfi 69) make-hash-table hash-table-ref hash-table-ref/default hash-table-set! hash-table-exists?)
   (lofi compiler wasm-extern)
   (only (lofi compiler ir)
         make-node node? node-kind node-loc node-data
         prepare-binding! binding-scheme set-binding-scheme!
         binding-initializer set-binding-initializer! binding-kind binding-payload
         binding-declaration set-binding-declaration! children copy-ir-graph)
   (prefix (lofi compiler ir) ir:)
   (prefix (lofi compiler signatures) source:))
  (begin

    ;; ---- Lexical checking scopes ----

    (define-record-type <scope>
      (make-scope bindings types assumptions classes instances recursive) scope?
      (bindings scope-bindings)
      (types scope-types)
      (assumptions scope-assumptions)
      (classes scope-classes)
      (instances scope-instances)
      (recursive scope-recursive))
    (define (lookup key entries) (let ((entry (assq key entries))) (and entry (cdr entry))))
    (define (visible-binding definition bindings)
      (and (memq definition bindings) definition))
    (define (extend-scope scope bindings)
      (make-scope (append bindings (scope-bindings scope)) (scope-types scope)
                  (scope-assumptions scope) (scope-classes scope) (scope-instances scope) (scope-recursive scope)))
    (define (lexical-schemes scope excluded)
      (let collect ((bindings (scope-bindings scope)))
        (cond ((null? bindings) '()) ((memq (car bindings) excluded) (collect (cdr bindings)))
              (else (cons (binding-scheme (car bindings)) (collect (cdr bindings)))))))
    (define (environment-schemes scope excluded)
      ;; Scoped All parameters and recursive tuples are nongeneralizable even
      ;; when a phantom parameter is absent from every ordinary binding type.
      (append (lexical-schemes scope excluded)
              (map (lambda (entry) (mono-scheme (cdr entry))) (scope-types scope))
              (map (lambda (entry)
                     (let ((view (cdr entry)))
                       (make-scheme '() (cons (view-type view) (map cdr (view-substitutions view)))
                                    (view-constraints view)))) (scope-recursive scope))))
    (define (mono-scheme type) (make-scheme '() type '()))
    ;; Obligations are proof sets. Repeated reads do not duplicate a proof;
    ;; equality includes class identity and every argument/result type.
    (define (proof-set obligations)
      (let collect ((remaining obligations) (unique '()))
        (cond ((null? remaining) (reverse unique))
              ((assumed? (car remaining) unique) (collect (cdr remaining) unique))
              (else (collect (cdr remaining) (cons (car remaining) unique))))))
    ;; The solver may link holes, but it never writes expression fields. A
    ;; judgment owns this arm's result and provisional typed children.
    (define-record-type <judgment>
      (make-judgment type constraints source detail nonexpansive? expression) judgment?
      (type judgment-type)
      (constraints judgment-constraints)
      (source judgment-source)
      (detail judgment-detail)
      (nonexpansive? judgment-nonexpansive?)
      (expression judgment-expression))
    (define (judgment-loc result) (node-loc (judgment-source result)))
    (define (constraints results) (proof-set (apply append (map judgment-constraints results))))
    (define (result source type detail inert? . children)
      (let ((obligations (constraints children)))
        (make-judgment type obligations source detail inert?
                       (make-typed-expression source type '() detail (map judgment-expression children)))))
    (define-record-type <binding-summary>
      (make-binding-summary result scope expression) binding-summary?
      (result summary-result set-summary-result!)
      (scope summary-scope set-summary-scope!)
      (expression summary-expression set-summary-expression!))
    (define checking-summaries (make-parameter '()))
    (define (binding-summary binding) (caddr (binding-payload binding)))
    (define (binding-judgment result)
      (make-judgment (judgment-type result) (judgment-constraints result) (judgment-source result)
                     #f (judgment-nonexpansive? result) #f))
    (define (binding-result binding) (summary-result (binding-summary binding)))
    ;; ---- Source signatures and rigid quantified binders ----

    (define (source-type type variables loc)
      (cond ((lookup type variables) => (lambda (type) type))
            ((or (memq type scalar-types) (memq type '(String Bytevector))) type)
            ((and (pair? type) (memq (car type) '(Ref List Vector)) (= (length type) 2))
             (list (car type) (source-type (cadr type) variables loc)))
            ((and (pair? type) (eq? (car type) '->)) (source-function type variables loc))
            ((and (pair? type) (eq? (car type) 'record)) (source-data-type type variables loc))
            (else (strict-error loc "unsupported strict type" type))))
    (define (source-data-type type variables loc)
      (let ((definition (cadr type)))
        (unless (eq? (binding-kind definition) 'data-type)
          (strict-error loc "nominal type requires a define-data declaration"))
        (unless (= (length (cddr type))
                   (length (ir:data-schema-variables (binding-payload definition))))
          (strict-error loc "wrong number of data type arguments"))
        (data-type definition (map (lambda (type) (source-type type variables loc)) (cddr type)))))
    (define (source-function type variables loc)
      (let ((parts (reverse (cdr type))))
        (when (null? parts) (strict-error loc "function type requires a result"))
        (function-type (map (lambda (type) (source-type type variables loc)) (reverse (cdr parts)))
                       (source-type (car parts) variables loc))))
    (define (declared-scheme type variables loc)
      (let* ((fresh (map (lambda (variable) (cons variable (fresh-variable #t)))
                         (source:signature-variables type)))
             (scope (append fresh variables))
             (obligations (map (lambda (constraint)
                                 (cons (car constraint) (map (lambda (type) (source-type type scope loc)) (cdr constraint))))
                               (source:signature-requirements type))))
        (cons (make-scheme (map cdr fresh) (source-type (source:signature-type type) scope loc) obligations) scope)))

    ;; ---- Closed nominal data declarations ----

    ;; Reserve every identity before checking any field: mutual recursion is a
    ;; graph of declarations, not recursive expansion of their field syntax.
    (define (prepare-data-schemas! items)
      (let ((schemas (let collect ((items items))
                       (cond ((null? items) '())
                             ((ir:data-schema? (car items)) (cons (car items) (collect (cdr items))))
                             (else (collect (cdr items)))))))
        (for-each (lambda (schema)
                    (unless (eq? (binding-kind (ir:data-schema-definition schema)) 'data-type)
                      (prepare-binding! (ir:data-schema-definition schema) (mono-scheme 'Unit)
                                        #f 'data-type schema))) schemas)
        (for-each check-data-schema! schemas)
        (apply append (map data-schema-bindings schemas))))
    (define (check-data-schema! schema)
      (when (eq? schema (binding-payload (ir:data-schema-definition schema)))
        (let* ((mapping (map (lambda (variable) (cons variable (fresh-rigid)))
                             (ir:data-schema-variables schema)))
               (cases (map (lambda (row) (check-data-case row mapping (node-loc schema)))
                           (ir:data-schema-cases schema))))
          (let ((checked (make-node 'data-schema (node-loc schema)
                                    (list (ir:data-schema-definition schema) (map cdr mapping) cases))))
            (prepare-binding! (ir:data-schema-definition schema) (mono-scheme 'Unit) #f 'data-type checked)
            (let visit ((cases cases) (index 0))
              (unless (null? cases)
                (prepare-data-case! checked (car cases) index) (visit (cdr cases) (+ index 1))))))))
    (define (check-data-case row mapping loc)
      (list (car row)
            (map (lambda (field)
                   (list (car field) (source-type (cadr field) mapping loc) (caddr field)))
                 (cadr row))))
    (define (prepare-data-case! schema row index)
      (let* ((variables (ir:data-schema-variables schema))
             (type (data-type (ir:data-schema-definition schema) variables))
             (signature (function-type (map cadr (cadr row)) type)))
        (prepare-binding! (car row) (make-scheme variables signature '()) #f
                          'data (list 'construct schema index))
        (let visit ((fields (cadr row)) (field-index 0))
          (unless (null? fields)
            (prepare-data-accessor! schema type index (car fields) field-index)
            (visit (cdr fields) (+ field-index 1))))))
    (define (prepare-data-accessor! schema type index field field-index)
      (when (caddr field)
        (prepare-binding! (caddr field)
                          (make-scheme (ir:data-schema-variables schema)
                                       (function-type (list type) (cadr field)) '())
                          #f 'data (list 'access schema index field-index))))

    ;; ---- Scalar foreign declarations ----

    (define (extern-binding node)
      (let ((loc (node-loc node)) (definition (ir:extern-declaration-definition node)))
        (guard (failure (else (if (error-object? failure)
                                  (apply strict-error loc (error-object-message failure) (error-object-irritants failure))
                                  (strict-error loc "invalid scalar extern declaration"))))
          (let ((declaration (parse-extern `(define-extern ,(ir:value-definition-name definition)
                                              ,(ir:extern-declaration-module node) ,(ir:extern-declaration-symbol node)
                                              ,(ir:extern-declaration-type node)))))
            (prepare-binding! definition (mono-scheme (source-type (extern-type declaration) '() loc)) #f 'extern declaration)))))
    (define (extern-bindings items)
      (cond ((null? items) '())
            ((ir:extern-declaration? (car items)) (cons (extern-binding (car items)) (extern-bindings (cdr items))))
            (else (extern-bindings (cdr items)))))

    ;; ---- Exact static classes and instance initializer sites ----

    (define (prepare-class node)
      (let* ((definition (ir:class-declaration-definition node))
             (variables (map (lambda (variable) (cons variable (fresh-variable #t))) (ir:class-declaration-variables node)))
             (methods (map (lambda (row)
                             (prepare-binding! (car row)
                                               (make-scheme (map cdr variables) (source-type (cadr row) variables (node-loc node))
                                                            (list (cons definition (map cdr variables))))
                                               #f 'method definition)) (ir:class-declaration-methods node))))
        (make-class definition (map cdr variables) methods #f)))
    (define (find-class definition classes loc)
      (cond ((null? classes) (strict-error loc "unknown static typeclass"))
            ((eq? definition (class-definition (car classes))) (car classes))
            (else (find-class definition (cdr classes) loc))))
    (define (find-instance class types instances)
      (cond ((null? instances) #f)
            ((and (eq? class (instance-class (car instances))) (type-equal? types (instance-types (car instances)))) (car instances))
            (else (find-instance class types (cdr instances)))))
    (define (constraint-class constraint scope loc)
      (let ((class (find-class (car constraint) (scope-classes scope) loc)))
        (unless (= (length (cdr constraint)) (length (class-variables class)))
          (strict-error loc "wrong number of static typeclass arguments")) class))
    (define (assumed? constraint assumptions)
      (and (pair? assumptions) (or (type-equal? constraint (car assumptions)) (assumed? constraint (cdr assumptions)))))
    (define-record-type <declaration-check>
      (make-declaration-check binding scope) declaration-check?
      (binding declaration-binding)
      (scope declaration-scope))
    ;; Each owned compilation discharges its own sites after inference settles.
    (define pending-declarations (make-parameter '()))
    (define (check-obligations obligations scope loc declared? . enclosing)
      (for-each (lambda (constraint) (constraint-class constraint scope loc)) (scope-assumptions scope))
      (improve-overloads! obligations (scope-assumptions scope) (scope-classes scope) (scope-instances scope) loc)
      (for-each (lambda (constraint)
                  (check-obligation constraint scope loc declared? '() (if (null? enclosing) '() (car enclosing)))) obligations))
    (define (enclosing-obligation? constraint schemes)
      ;; Only flexible variables free in enclosing bindings can remain their
      ;; inference problem. Own quantified variables and private holes require
      ;; evidence at this declaration's boundary.
      (let ((variables (type-variables (cdr constraint)))
            (free (apply append (map free-scheme-variables schemes))))
        (and (pair? variables)
             (let all ((variables variables))
               (or (null? variables)
                   (and (hole? (car variables)) (memq (car variables) free) (all (cdr variables))))))))
    (define (require-declared-obligation constraint loc declared? enclosing)
      (when (and declared? (not (enclosing-obligation? constraint enclosing)))
        (strict-error loc "typeclass obligation is absent from declared constraints" constraint)))
    (define (check-obligation constraint scope loc declared? seen enclosing)
      (let ((class (constraint-class constraint scope loc)))
        (cond ((assumed? constraint (scope-assumptions scope)))
              ((assumed? constraint seen) (strict-error loc "cyclic overload obligations" constraint))
              ((class-overload? class)
               (let ((view (select-overload-view class (cadr constraint) (scope-instances scope) loc #f)))
                 (if view (check-overload-view! view scope loc declared? (cons constraint seen) enclosing)
                     (require-declared-obligation constraint loc declared? enclosing))))
              ((concrete-type? (cdr constraint))
               (unless (find-instance class (cdr constraint) (scope-instances scope))
                 (strict-error loc "no exact static typeclass instance" constraint)))
              (else (require-declared-obligation constraint loc declared? enclosing)))))
    (define (check-overload-view! view scope loc declared? seen enclosing)
      ;; Keep one fresh row view: a sibling prerequisite may determine a type
      ;; absent from the selected arrow but needed by another prerequisite.
      (let ((goals (overload-view-constraints view)))
        (improve-overloads! goals (scope-assumptions scope) (scope-classes scope) (scope-instances scope) loc)
        (for-each (lambda (goal) (check-obligation goal scope loc declared? seen enclosing)) goals)))
    (define (surface-type type)
      (cond ((function-type? type)
             `(-> ,@(map surface-type (function-domains type))
                  ,(surface-type (function-result type))))
            ((data-type? type) (cons 'record (cons (cadr type) (map surface-type (cddr type)))))
            ((pair? type) (map surface-type type)) (else type)))
    (define (prepare-member method types class expression loc)
      ;; Evidence names this concrete source binding. Even a name expression
      ;; must read its target here, once, rather than when a method is called.
      (let* ((definition (ir:make-value-definition (ir:value-definition-name method) loc))
             (type (substitute (scheme-type (binding-scheme method)) (map cons (class-variables class) types))))
        (set-binding-declaration! definition (ir:make-type-declaration definition (surface-type type) loc))
        (list (cons method definition) (ir:make-value-binding definition expression loc))))
    (define (prepare-instance node classes prior)
      (let* ((loc (node-loc node)) (class (find-class (ir:instance-declaration-class node) classes loc))
             (types (map (lambda (type) (require-concrete (source-type type '() loc) loc)) (ir:instance-declaration-types node)))
             (rows (ir:instance-declaration-methods node)))
        (when (class-overload? class) (strict-error loc "free overload instances require define-overload"))
        (unless (= (length types) (length (class-variables class))) (strict-error loc "wrong number of static typeclass arguments"))
        (when (find-instance class types prior) (strict-error loc "duplicate static typeclass instance"))
        (check-member-names rows (class-methods class) loc)
        ;; Class order checks completeness; row order controls initialization.
        (let ((members (map (lambda (row) (prepare-member (car row) types class (cdr row) loc)) rows)))
          (values (make-instance class types (map car members) #f #f) (apply append (map cdr members))))))
    (define (check-member-names rows methods loc)
      (unless (and (= (length rows) (length methods))
                   (let check ((methods methods))
                     (or (null? methods) (and (assq (car methods) rows) (check (cdr methods))))))
        (strict-error loc "instance must implement each class method exactly once")))
    (define (prepare-class-items items classes)
      (let visit ((items items) (instances '()) (rewritten '()))
        (cond ((null? items) (values (reverse rewritten) (reverse instances)))
              ((ir:class-declaration? (car items)) (visit (cdr items) instances rewritten))
              ((ir:instance-declaration? (car items))
               (let-values (((instance nodes) (prepare-instance (car items) classes instances)))
                 (visit (cdr items) (cons instance instances) (append (reverse nodes) rewritten))))
              ((ir:overload-declaration? (car items))
               (let-values (((instance nodes) (prepare-overload-instance (car items) classes instances)))
                 (visit (cdr items) (cons instance instances) (append (reverse nodes) rewritten))))
              (else (visit (cdr items) instances (cons (car items) rewritten))))))

    ;; ---- Free overloads as classes over complete function signatures ----

    (define (overload-scheme node)
      (let* ((loc (node-loc node))
             (scheme (car (declared-scheme (ir:overload-declaration-type node) '() loc)))
             (type (scheme-type scheme)))
        (unless (function-type? type)
          (strict-error loc "overload requires a fixed-arity function signature")) scheme))
    (define (prepare-overload node)
      (let* ((definition (ir:overload-declaration-definition node)) (signature (fresh-variable #t))
             (scheme (make-scheme (list signature) signature (list (list definition signature)))))
        (make-class definition (list signature) (list (prepare-binding! definition scheme #f 'method definition)) #t)))
    (define (collect-program-classes items)
      (let collect ((items items) (classes '()))
        (cond ((null? items) (reverse classes))
              ((ir:class-declaration? (car items)) (collect (cdr items) (cons (prepare-class (car items)) classes)))
              ((ir:overload-declaration? (car items))
               (let ((definition (ir:overload-declaration-definition (car items))))
                 (collect (cdr items) (if (assq definition (map (lambda (class) (cons (class-definition class) class)) classes))
                                          classes (cons (prepare-overload (car items)) classes)))))
              (else (collect (cdr items) classes)))))
    (define (prepare-overload-instance node classes prior)
      (let* ((loc (node-loc node)) (definition (ir:overload-declaration-definition node))
             (class (find-class definition classes loc))
             (scheme (overload-scheme node)))
        (unless (class-overload? class) (strict-error loc "overload name belongs to an ordinary class"))
        (when (duplicate-overload? class scheme prior)
          (strict-error loc "duplicate overload signature" (scheme-type scheme)))
        (set-binding-scheme! (ir:overload-declaration-member node) scheme)
        (let ((member (prepare-overload-member node)))
          (values (make-instance class '() (list (car member)) scheme node) (cdr member)))))
    (define (prepare-overload-member node)
      (let ((expression (ir:overload-declaration-implementation node))
            (method (ir:overload-declaration-definition node)) (loc (node-loc node)))
        (cond ((ir:name? expression) (list (cons method (ir:name-definition expression))))
              ((ir:lambda? expression)
               (let ((definition (ir:overload-declaration-member node)))
                 (list (cons method definition) (ir:make-value-binding definition expression loc))))
              (else (strict-error loc "instance member must be a lambda or stable function binding")))))
    (define (occupied-definitions items classes primitives)
      (append primitives
              (apply append (map (lambda (class)
                                   (if (class-overload? class) '()
                                       (cons (class-definition class) (class-methods class)))) classes))
              (let collect ((items items))
                (cond ((null? items) '())
                      ((ir:value-binding? (car items)) (cons (ir:value-binding-definition (car items)) (collect (cdr items))))
                      ((ir:extern-declaration? (car items)) (cons (ir:extern-declaration-definition (car items)) (collect (cdr items))))
                      ((ir:data-schema? (car items))
                       (cons (ir:data-schema-definition (car items))
                             (append (data-schema-bindings (car items)) (collect (cdr items)))))
                      (else (collect (cdr items)))))))
    (define (check-overload-names items classes primitives)
      (let ((occupied (occupied-definitions items classes primitives)))
        (for-each (lambda (node)
                    (when (and (ir:overload-declaration? node) (memq (ir:overload-declaration-definition node) occupied))
                      (strict-error (node-loc node) "overload name already has an ordinary value or class definition"))
                    (when (and (ir:type-declaration? node) (overload-class (ir:type-declaration-definition node) classes))
                      (strict-error (node-loc node) "overload signature belongs directly to its define-overload row"))) items)))

    ;; ---- Definition groups and the value restriction ----

    (define nonexpansive? judgment-nonexpansive?)
    (define (reserve-binding node scope)
      (let* ((definition (ir:value-binding-definition node))
             (annotation (binding-declaration definition))
             (signature (and annotation
                             (declared-scheme (ir:type-declaration-type annotation)
                                              (scope-types scope) (node-loc annotation))))
             (scheme (if signature (car signature) (binding-scheme definition))))
        (prepare-binding! definition scheme #f 'value
                          (list (ir:value-binding-initializer node) signature #f))))
    (define (source-initializer binding) (car (binding-payload binding)))
    (define (binding-annotation binding) (cadr (binding-payload binding)))
    (define (definition-bindings items scope)
      (let collect ((items items))
        (cond ((null? items) '())
              ((ir:value-binding? (car items))
               (cons (reserve-binding (car items) scope) (collect (cdr items))))
              (else (collect (cdr items))))))
    ;; Each block owns a fixed dependency graph. Build it before inference
    ;; refines the source nodes. Binding identity, never spelling, keys its edges.
    (define-record-type <binding-plan>
      (make-binding-plan edges groups) binding-plan?
      (edges plan-edges)
      (groups plan-groups))
    (define-record-type <binding-group>
      (make-binding-group members) binding-group?
      (members group-members set-group-members!))
    (define (binding-edges binding plan) (hash-table-ref (plan-edges plan) binding))
    (define (binding-group binding plan) (group-members (hash-table-ref (plan-groups plan) binding)))
    (define (referenced-bindings node index)
      (let ((seen (make-hash-table eq?)) (references '()))
        (define (visit node)
          (if (ir:name? node)
              (let ((binding (ir:name-definition node)))
                (when (and (hash-table-exists? index binding) (not (hash-table-exists? seen binding)))
                  (hash-table-set! seen binding #t)
                  (set! references (cons binding references))))
              (for-each visit (children node))))
        (visit node)
        (reverse references)))
    (define (dependency-edges bindings)
      (let ((edges (make-hash-table eq?)))
        (for-each (lambda (binding) (hash-table-set! edges binding '())) bindings)
        (for-each (lambda (binding)
                    (hash-table-set! edges binding (referenced-bindings (source-initializer binding) edges))) bindings)
        edges))
    (define (reverse-edges bindings edges)
      (let ((reversed (make-hash-table eq?)))
        (for-each (lambda (binding) (hash-table-set! reversed binding '())) bindings)
        (for-each (lambda (binding)
                    (for-each (lambda (dependency)
                                (hash-table-set! reversed dependency
                                                 (cons binding (hash-table-ref reversed dependency))))
                              (hash-table-ref edges binding))) bindings)
        reversed))
    (define (dependency-postorder bindings edges)
      (let ((seen (make-hash-table eq?)) (ordered '()))
        (define (visit binding)
          (unless (hash-table-exists? seen binding)
            (hash-table-set! seen binding #t)
            (for-each visit (hash-table-ref edges binding))
            (set! ordered (cons binding ordered))))
        (for-each visit bindings)
        ordered))
    ;; Reverse finishing order on reversed edges visits one strongly connected
    ;; component at a time. Keep identity groups here; restore source order below.
    (define (assign-dependency-group! binding group reversed groups)
      (unless (hash-table-exists? groups binding)
        (hash-table-set! groups binding group)
        (for-each (lambda (dependency) (assign-dependency-group! dependency group reversed groups))
                  (hash-table-ref reversed binding))))
    (define (dependency-groups bindings edges)
      (let ((reversed (reverse-edges bindings edges)) (groups (make-hash-table eq?)) (components '()))
        (for-each (lambda (binding)
                    (unless (hash-table-exists? groups binding)
                      (let ((group (make-binding-group '())))
                        (set! components (cons group components))
                        (assign-dependency-group! binding group reversed groups))))
                  (dependency-postorder bindings edges))
        (order-group-members! bindings groups components)
        groups))
    (define (order-group-members! bindings groups components)
      (for-each (lambda (binding)
                  (let ((group (hash-table-ref groups binding)))
                    (set-group-members! group (cons binding (group-members group))))) bindings)
      (for-each (lambda (group) (set-group-members! group (reverse (group-members group)))) components))
    (define (plan-bindings bindings)
      (let ((edges (dependency-edges bindings)))
        (make-binding-plan edges (dependency-groups bindings edges))))

    ;; ---- Check ordinary binding groups in dependency order ----

    ;; Every overload scheme is already declared. Only ordinary references
    ;; determine checking order; source order still determines initialization.
    ;; Mark the whole SCC before visiting its dependencies so recursive members
    ;; share provisional monotypes until every body in the group is checked.
    (define (check-binding-group! binding plan scope visited)
      (unless (hash-table-exists? visited binding)
        (let ((group (binding-group binding plan)))
          (for-each (lambda (member) (hash-table-set! visited member #t)) group)
          (for-each (lambda (member)
                      (for-each (lambda (dependency) (check-binding-group! dependency plan scope visited))
                                (binding-edges member plan))) group)
          (if (annotated-recursive-group? group plan)
              (check-annotated-group! group scope)
              (begin (for-each (lambda (member) (check-initializer! member scope)) group)
                     (generalize-group! group scope))))))
    (define (check-bindings! bindings scope)
      (let ((plan (plan-bindings bindings)) (visited (make-hash-table eq?)))
        (for-each (lambda (binding) (check-binding-group! binding plan scope visited)) bindings)))
    (define (annotated-recursive-group? group plan)
      (and (or (pair? (cdr group)) (memq (car group) (binding-edges (car group) plan)))
           (let quantified ((remaining group))
             (and (pair? remaining)
                  (or (pair? (scheme-variables (binding-scheme (car remaining))))
                      (quantified (cdr remaining)))))))
    (define (initializer-scope binding scope)
      (let ((annotation (binding-annotation binding)) (scheme (binding-scheme binding)))
        ;; A signature adds assumptions for its fresh binders; it does not hide
        ;; evidence already available for captured types in the lexical scope.
        (if annotation (make-scope (scope-bindings scope) (cdr annotation)
                                   (append (scheme-constraints scheme) (scope-assumptions scope))
                                   (scope-classes scope) (scope-instances scope) (scope-recursive scope)) scope)))
    (define (check-initializer! binding scope)
      (let* ((annotation (binding-annotation binding)) (scheme (binding-scheme binding))
             (checking (initializer-scope binding scope))
             (value (infer-initializer binding checking)))
        (unify! (scheme-type scheme) (judgment-type value) (judgment-loc value))
        (when (and annotation (pair? (scheme-variables scheme)) (not (nonexpansive? value)))
          (strict-error (judgment-loc value) "polymorphic annotation requires a nonexpansive value"))
        (check-skolem-escape binding scope)
        (check-obligations (scheme-constraints scheme) checking (judgment-loc value) #f)
        (check-obligations (judgment-constraints value) checking (judgment-loc value) #f)
        ;; The enclosing body or later call arguments can still constrain captured
        ;; monotypes. Keep this declaration's own proof scope until that inference
        ;; finishes, including obligations mentioning its private quantified types.
        (when annotation
          (pending-declarations (cons (make-declaration-check binding scope) (pending-declarations))))
        (prepare-binding! binding (binding-scheme binding) (source-initializer binding) 'value
                          (list (source-initializer binding) annotation (make-binding-summary (binding-judgment value) checking (judgment-expression value))))
        (checking-summaries (cons (binding-summary binding) (checking-summaries)))))
    (define (infer-initializer binding scope)
      (let* ((source (source-initializer binding)) (type (scheme-type (binding-scheme binding)))
             (annotation (binding-annotation binding)))
        (if (and annotation (ir:literal? source))
            (conform (infer-literal source type) type #f)
            (infer source scope (and (or annotation (lookup binding (scope-recursive scope))) type)))))
    (define (finish-declaration-check! check)
      (let* ((binding (declaration-binding check)) (scope (declaration-scope check))
             (value (binding-result binding)))
        (check-obligations (judgment-constraints value) (initializer-scope binding scope) (judgment-loc value) #t
                           (lexical-schemes scope (list binding)))
        (check-concrete-declaration! binding scope)
        ;; Keep the escape check after proof improvement, which may link an
        ;; enclosing hole to a private rigid type since the initializer's check.
        (check-skolem-escape binding scope)))
    (define (check-concrete-declaration! binding scope)
      ;; A closed requirement must have enclosing evidence even when its body
      ;; never uses it. The declaration's own assumptions cannot prove it.
      (for-each (lambda (constraint)
                  (when (concrete-type? (cdr constraint))
                    (check-obligations (list constraint) scope
                                       (node-loc (source-initializer binding)) #f)))
                (scheme-constraints (binding-scheme binding))))
    (define (check-skolem-escape binding scope)
      (let ((variables (scheme-variables (binding-scheme binding))))
        ;; A monomorphic declaration has no rigid binders that could escape.
        (unless (null? variables)
          (for-each (lambda (scheme)
                      (for-each (lambda (variable)
                                  (when (memq variable variables)
                                    (strict-error (node-loc (source-initializer binding)) "rigid type escapes its declaration")))
                                (free-scheme-variables scheme))) (lexical-schemes scope (list binding))))))
    (define (group-environment group scope)
      ;; Freeze every expansive member before any sibling can generalize.
      (append (environment-schemes scope group) (expansive-schemes group)))
    (define (expansive-schemes group)
      (let collect ((remaining group))
        (cond ((null? remaining) '())
              ((nonexpansive? (binding-result (car remaining))) (collect (cdr remaining)))
              (else (cons (binding-scheme (car remaining)) (collect (cdr remaining)))))))
    (define (generalize-group! group scope)
      (let ((environment (group-environment group scope)))
        (for-each (lambda (binding) (generalize-binding! binding environment)) group)))
    (define (generalize-binding! binding environment)
      (unless (binding-annotation binding)
        (set-binding-scheme! binding
                             (generalize (judgment-type (binding-result binding))
                                         (proof-set (judgment-constraints (binding-result binding)))
                                         environment (nonexpansive? (binding-result binding))))))

    ;; ---- Recursive templates preserve independent rigid annotations ----

    ;; A recursive use has one type and one explicit-instantiation tuple. The
    ;; tuple includes phantom binders: omitting them would permit type-changing
    ;; recursion whose arrow happens not to mention its changing argument.
    (define-record-type <recursive-view>
      (make-recursive-view type constraints substitutions) recursive-view?
      (type view-type)
      (constraints view-constraints)
      (substitutions view-substitutions))
    (define-record-type <recursive-template>
      (make-recursive-template bindings slots views) recursive-template?
      (bindings template-bindings)
      (slots template-slots)
      (views template-views))
    (define (recursive-scope scope bindings views)
      (make-scope bindings (scope-types scope) (scope-assumptions scope)
                  (scope-classes scope) (scope-instances scope) (append views (scope-recursive scope))))
    (define (outside-bindings group scope)
      (let collect ((bindings (scope-bindings scope)))
        (cond ((null? bindings) '()) ((memq (car bindings) group) (collect (cdr bindings)))
              (else (cons (car bindings) (collect (cdr bindings)))))))
    (define (retained-template-identities group scope)
      (let* ((outside (outside-bindings group scope))
             (schemes (lexical-schemes scope group))
             (variables (type-variables (cons (map (lambda (scheme) (cons (scheme-type scheme) (scheme-constraints scheme))) schemes)
                                              (scope-types scope)))))
        (map (lambda (identity) (cons identity identity))
             (append outside variables (scope-nominal-identities scope) (map class-definition (scope-classes scope))))))
    (define (scope-nominal-identities scope)
      (let collect ((bindings (scope-bindings scope)))
        (cond ((null? bindings) '())
              ((eq? (binding-kind (car bindings)) 'data)
               (cons (ir:data-schema-definition (cadr (binding-payload (car bindings))))
                     (collect (cdr bindings))))
              (else (collect (cdr bindings))))))
    (define (substituted-view scheme substitutions)
      (make-recursive-view (substitute (scheme-type scheme) substitutions)
                           (substitute (scheme-constraints scheme) substitutions) substitutions))
    (define (prepare-template-binding! binding)
      (let* ((scheme (binding-scheme binding))
             (substitutions (map (lambda (variable) (cons variable (fresh-hole))) (scheme-variables scheme)))
             (view (substituted-view scheme substitutions)) (annotation (binding-annotation binding))
             (mono (make-scheme '() (view-type view) (view-constraints view))))
        (when annotation
          (prepare-binding! binding mono #f 'value
                            (list (source-initializer binding)
                                  (cons mono (map (lambda (entry) (cons (car entry) (substitute (cdr entry) substitutions)))
                                                  (cdr annotation))))))
        view))
    (define (new-recursive-template group scope)
      (let* ((copies (copy-ir-graph group (retained-template-identities group scope)))
             (views (map (lambda (binding) (cons binding (prepare-template-binding! binding))) copies))
             (slots (map (lambda (original entry)
                           (cons original (map cons (scheme-variables (binding-scheme original))
                                               (map cdr (view-substitutions (cdr entry)))))) group views)))
        (make-recursive-template (map cons group copies) slots views)))
    (define (template-scope template scope)
      (recursive-scope scope
                       (map (lambda (binding) (or (lookup binding (template-bindings template)) binding))
                            (scope-bindings scope)) (template-views template)))
    (define (environment-variables schemes)
      (let collect ((remaining schemes))
        (if (null? remaining) '()
            (identity-union (free-scheme-variables (car remaining)) (collect (cdr remaining))))))
    (define (template-environment template scope)
      (append (environment-schemes scope (map car (template-bindings template)))
              (expansive-schemes (map cdr (template-bindings template)))))
    (define (check-template-slots! slots frozen loc)
      (let check ((remaining slots) (seen '()))
        (unless (null? remaining)
          (let ((variable (resolve (cdar remaining))))
            (unless (and (hole? variable) (not (memq variable frozen)) (not (memq variable seen)))
              (strict-error loc "recursive use cannot specialize a quantified type" variable))
            (check (cdr remaining) (cons variable seen))))))
    (define (solve-recursive-template group scope)
      ;; These copies solve a monomorphic relation; only the original bodies
      ;; retain declaration proofs for the final rigid checking judgment.
      (parameterize ((pending-declarations '()) (checking-summaries '()))
        (let* ((template (new-recursive-template group scope)) (checking (template-scope template scope)))
          (for-each (lambda (entry) (check-initializer! (cdr entry) checking)) (template-bindings template))
          (let ((frozen (environment-variables (template-environment template scope))))
            (for-each (lambda (entry)
                        (check-template-slots! (cdr entry) frozen (ir:value-definition-loc (car entry))))
                      (template-slots template)))
          template)))
    (define (publish-inferred-template-schemes! template scope)
      (let ((environment (template-environment template scope)))
        (for-each (lambda (entry)
                    (unless (binding-annotation (car entry))
                      (generalize-binding! (cdr entry) environment)
                      (publish-template-scheme! (car entry) (binding-scheme (cdr entry)) template)))
                  (template-bindings template))))
    (define (publish-template-scheme! binding scheme template)
      ;; Stable quantified identities keep the checked body's substitutions
      ;; valid when its older parameter holes are unified with this signature.
      (let* ((variables (map (lambda (unused) (fresh-rigid)) (scheme-variables scheme)))
             (mapping (map cons (scheme-variables scheme) variables)))
        (set-cdr! (assq binding (template-slots template)) (map cons variables (scheme-variables scheme)))
        (set-binding-scheme! binding (make-scheme variables (substitute (scheme-type scheme) mapping)
                                                  (substitute (scheme-constraints scheme) mapping)))))
    (define (template-variables template scope)
      (let ((frozen (template-environment template scope)))
        (scheme-variables
         (generalize (append (map (lambda (entry)
                                    (let ((scheme (binding-scheme (cdr entry))))
                                      (cons (scheme-type scheme) (scheme-constraints scheme))))
                                  (template-bindings template))
                             (map (lambda (entry) (map cdr (cdr entry))) (template-slots template)))
                     '() frozen #t))))
    (define (body-template-substitutions binding template scope)
      (let ((mapping (map (lambda (variable) (cons variable (fresh-hole))) (template-variables template scope))))
        (for-each (lambda (entry)
                    (unify! (substitute (cdr entry) mapping) (car entry) (ir:value-definition-loc binding)))
                  (lookup binding (template-slots template)))
        mapping))
    (define (body-recursive-view entry template mapping)
      (let* ((binding (car entry)) (copy (cdr entry)) (scheme (binding-scheme copy))
             (slots (lookup binding (template-slots template))))
        (make-recursive-view (substitute (scheme-type scheme) mapping)
                             (substitute (scheme-constraints scheme) mapping)
                             (map (lambda (slot) (cons (car slot) (substitute (cdr slot) mapping))) slots))))
    (define (check-annotated-group! group scope)
      (let ((template (solve-recursive-template group scope)))
        (publish-inferred-template-schemes! template scope)
        (for-each (lambda (binding)
                    (let* ((mapping (body-template-substitutions binding template scope))
                           (views (map (lambda (entry) (cons (car entry) (body-recursive-view entry template mapping)))
                                       (template-bindings template))))
                      (check-initializer! binding (recursive-scope scope (scope-bindings scope) views)))) group)))

    ;; A generalized initializer checks its obligations inside its template.
    ;; Its concrete uses instantiate them; the enclosing scope must not inherit
    ;; private type variables from a local polymorphic function or name alias.
    (define (initialization-constraints binding)
      (let ((bound (scheme-variables (binding-scheme binding))))
        (let collect ((obligations (judgment-constraints (binding-result binding))))
          (cond ((null? obligations) '())
                ((let intersects ((variables (type-variables (car obligations))))
                   (and (pair? variables) (or (memq (car variables) bound) (intersects (cdr variables)))))
                 (collect (cdr obligations)))
                (else (cons (car obligations) (collect (cdr obligations))))))))

    ;; ---- Expression rules consume returned child judgments ----

    (define (infer node scope expected)
      (let ((result (conform (infer-rule node scope expected) expected #f)))
        (improve-overloads! (judgment-constraints result) (scope-assumptions scope)
                            (scope-classes scope) (scope-instances scope) (node-loc node))
        result))
    (define (conform value expected projection?)
      (let ((actual (resolve (judgment-type value))) (expected (and expected (resolve expected))))
        (cond ((or (not expected) (type-equal? actual expected)) value)
              ((or (eq? actual 'Never) (eq? expected 'Top) (and projection? (eq? actual 'Top)))
               (make-judgment expected (judgment-constraints value) (judgment-source value)
                              (judgment-detail value)
                              (and (judgment-nonexpansive? value) (not (eq? actual 'Top)))
                              (make-typed-conversion (judgment-source value) actual expected (judgment-expression value))))
              (else (unify! actual expected (judgment-loc value)) value))))
    (define (literal-type value selected loc)
      (cond ((boolean? value) 'Bool) ((char? value) 'Char) ((string? value) 'String)
            ((bytevector? value) 'Bytevector) ((null? value) (list 'List (fresh-variable)))
            ((exact-integer? value)
             (let ((type (if (memq selected '(I32 I64)) selected 'I32)))
               (checked-integer-literal value type loc) type))
            ((and (real? value) (inexact? value)) (if (eq? selected 'F32) 'F32 'F64))
            (else (strict-error loc "unsupported strict literal" value))))
    (define (infer-literal node selected)
      (let* ((spelling (ir:literal-number-spelling node))
             (value (literal-number-value (ir:literal-value node) spelling (node-loc node)))
             (type (literal-type value (and selected (resolve selected)) (node-loc node))))
        (result node type
                (if (memq type '(F32 F64)) (rounded-float-literal value spelling type (node-loc node)) value) #t)))
    (define (rule-literal node scope expected children) (infer-literal node #f))
    (define (rule-name node scope expected children)
      (let ((binding (visible-binding (ir:name-definition node) (scope-bindings scope))))
        (unless binding (strict-error (node-loc node) "missing strict binding" (ir:value-definition-name (ir:name-definition node))))
        (let ((view (lookup binding (scope-recursive scope))))
          (if view (recursive-name node binding view)
              (let-values (((type obligations substitutions) (instantiate (binding-scheme binding))))
                (make-judgment type obligations node (list binding substitutions) #t
                               (make-typed-expression node type obligations (list binding substitutions) '())))))))
    (define (recursive-name node binding view)
      (make-judgment (view-type view) (view-constraints view) node
                     (list binding (view-substitutions view)) #t
                     (make-typed-expression node (view-type view) (view-constraints view)
                                            (list binding (view-substitutions view)) '())))
    (define (rule-instantiation node scope expected children)
      (let ((source (ir:instantiation-expression node)))
        (unless (ir:name? source) (strict-error (node-loc node) "explicit instantiation requires a named scheme"))
        (let ((binding (visible-binding (ir:name-definition source) (scope-bindings scope))))
          (unless binding (strict-error (node-loc node) "missing strict binding" (ir:value-definition-name (ir:name-definition source))))
          (instantiate-binding node scope binding))))
    (define (instantiate-binding node scope binding)
      (let* ((scheme (binding-scheme binding)) (view (lookup binding (scope-recursive scope)))
             (variables (if view (map car (view-substitutions view)) (scheme-variables scheme)))
             (types (map (lambda (type) (source-type type (scope-types scope) (node-loc node))) (ir:instantiation-types node))))
        (unless (= (length types) (length variables))
          (strict-error (node-loc node) "wrong number of explicit type arguments"))
        (if view
            (begin (for-each (lambda (actual entry) (unify! actual (cdr entry) (node-loc node))) types (view-substitutions view))
                   (recursive-name node binding view))
            (let* ((mapping (map cons variables types)) (type (substitute (scheme-type scheme) mapping)))
              (make-judgment type (substitute (scheme-constraints scheme) mapping) node (list binding mapping) #t
                             (make-typed-expression node type (substitute (scheme-constraints scheme) mapping)
                                                    (list binding mapping) '()))))))
    (define (rule-lambda node scope expected children)
      (let ((type (function-type
                   (map (lambda (binding) (scheme-type (binding-scheme binding))) (ir:lambda-parameters node))
                   (judgment-type (car children)))))
        (result node type #f #t (car children))))
    (define (rule-call node scope expected children)
      (let* ((operator (car children)) (signature (resolve (judgment-type operator))))
        (apply result node (function-result signature)
               (cons signature (map judgment-type (cdr children))) #f children)))
    (define (rule-block node scope expected children)
      (apply result node (if (null? children) 'Unit (judgment-type (car (reverse children)))) #f #f children))
    (define (rule-conditional node scope expected children)
      (let ((type (join-types (judgment-type (cadr children)) (judgment-type (caddr children)) (node-loc node))))
        (apply result node type (map judgment-type children) #f children)))
    (define (rule-annotation node scope expected children)
      (let* ((child (car children))
             (value (conform child (source-type (ir:annotation-type node) (scope-types scope) (node-loc node)) #t)))
        (make-judgment (judgment-type value) (judgment-constraints value) node
                       (judgment-type child) (judgment-nonexpansive? value)
                       (make-typed-expression node (judgment-type value) '()
                                              (judgment-type child) (list (judgment-expression child))))))
    (define (rule-match node scope expected children)
      (let ((type (let join ((arms (cdr children)))
                    (if (null? arms) 'Never (join-types (judgment-type (car arms)) (join (cdr arms)) (node-loc node))))))
        (apply result node type (judgment-type (car children)) #f children)))
    (define (rule-binding node scope expected children)
      (let ((binding (ir:value-binding-definition node)))
        (let ((obligations (initialization-constraints binding)))
          (make-judgment 'Unit obligations node binding #f
                         (make-typed-expression node 'Unit '() binding
                                                (list (summary-expression (binding-summary binding))))))))
    ;; ---- Structural visit and inherited expectations ----

    ;; Each rule above receives completed children. This walker owns ordering,
    ;; lexical scope construction, and expected types. Later passes consume the
    ;; resulting immutable tree instead of replaying these rules.
    (define (infer-rule node scope expected)
      (let ((children
             (case (node-kind node)
               ((lambda) (visit-lambda node scope expected))
               ((call) (visit-call node scope))
               ((block) (visit-block node scope expected))
               ((if) (visit-conditional node scope expected))
               ((annotation) (visit-annotation node scope))
               ((match) (visit-match node scope expected))
               (else '()))))
        (case (node-kind node)
          ((literal) (rule-literal node scope expected children))
          ((name) (rule-name node scope expected children))
          ((lambda) (rule-lambda node scope expected children))
          ((call) (rule-call node scope expected children))
          ((block) (rule-block node scope expected children))
          ((if) (rule-conditional node scope expected children))
          ((annotation) (rule-annotation node scope expected children))
          ((instantiation) (rule-instantiation node scope expected children))
          ((match) (rule-match node scope expected children))
          ((bind) (rule-binding node scope expected children))
          (else (strict-error (node-loc node) "unsupported checked expression" (node-kind node))))))
    (define (parameter-binding definition type)
      (unify! (scheme-type (binding-scheme definition)) type (ir:value-definition-loc definition))
      (prepare-binding! definition (mono-scheme type) #f 'parameter #f))
    (define (lambda-signature node expected)
      (let* ((signature (and expected (function-type? expected) (resolve expected)))
             (parameters (ir:lambda-parameters node))
             (types (if signature (function-domains signature)
                        (map (lambda (binding) (fresh-variable)) parameters))))
        (unless (= (length types) (length parameters))
          (strict-error (node-loc node) "lambda and annotation arity mismatch"))
        (function-type types (and signature (function-result signature)))))
    (define (visit-lambda node scope expected)
      (let* ((signature (lambda-signature node expected))
             (parameters (map parameter-binding (ir:lambda-parameters node) (function-domains signature)))
             (inner (extend-scope scope parameters)))
        (list (infer (ir:lambda-body node) inner (function-result signature)))))
    (define (call-signature operator count loc)
      (let ((type (resolve (judgment-type operator))))
        (when (variable? type)
          (unify! type (function-type (map (lambda (unused) (fresh-variable)) (make-list count #f)) (fresh-variable)) loc))
        (unless (function-type? type) (strict-error loc "call requires a function" type))
        (let* ((signature (resolve type)) (fixed (length (function-domains signature))))
          (unless (= count fixed)
            (strict-error loc "function call arity mismatch" count fixed)) signature)))
    (define (visit-call node scope)
      (let* ((operator (infer (ir:application-operator node) scope #f))
             (operands (ir:application-operands node))
             (signature (call-signature operator (length operands) (node-loc node))))
        (cons operator (infer-operands operands (function-domains signature) scope))))
    (define (infer-operands operands domains scope)
      (if (null? operands) '()
          (let ((operand (infer (car operands) scope (car domains))))
            (cons operand (infer-operands (cdr operands) (cdr domains) scope)))))
    (define (visit-annotation node scope)
      (let ((type (source-type (ir:annotation-type node) (scope-types scope) (node-loc node)))
            (child (ir:annotation-expression node)))
        (list (if (ir:literal? child) (infer-literal child type) (infer-rule child scope type)))))
    (define (visit-conditional node scope expected)
      (let* ((test (infer (ir:conditional-test node) scope 'Bool))
             (yes (infer (ir:conditional-consequent node) scope expected))
             (no (if (ir:conditional-opt-alternate node) (infer (ir:conditional-opt-alternate node) scope expected)
                     (result node 'Unit #f #t))))
        (list test yes no)))

    ;; ---- Pattern scopes retain only their bound field types ----

    (define (check-match-constructors arms loc)
      (let visit ((remaining arms) (schema #f) (seen '()))
        (if (null? remaining)
            (unless (= (length seen) (length (ir:data-schema-cases schema)))
              (strict-error loc "non-exhaustive match: every constructor needs one arm"))
            (let ((constructor (caar remaining)))
              (unless (data-constructor? constructor) (strict-error loc "match pattern requires a data constructor"))
              (when (memq constructor seen) (strict-error loc "duplicate match constructor"))
              (when (and schema (not (eq? schema (data-constructor-schema constructor))))
                (strict-error loc "match constructors belong to different data types"))
              (visit (cdr remaining) (data-constructor-schema constructor) (cons constructor seen))))))
    (define (visit-match node scope expected)
      (let ((subject (infer (ir:match-subject node) scope #f)) (arms (ir:match-arms node)))
        (check-match-constructors arms (node-loc node))
        (cons subject (map (lambda (arm) (visit-match-arm arm (judgment-type subject) scope expected)) arms))))
    (define (visit-match-arm arm subject scope expected)
      (let-values (((type obligations substitutions) (instantiate (binding-scheme (car arm)))))
        (unify! subject (function-result type) (node-loc (cadr arm)))
        (car (visit-lambda (cadr arm) scope (function-type (function-domains type) expected)))))

    ;; ---- Blocks retain lexical scopes, never checked expression children ----

    (define (check-declaration-owners items)
      (for-each (lambda (node)
                  (when (ir:type-declaration? node)
                    (unless (eq? node (binding-declaration (ir:type-declaration-definition node)))
                      (strict-error (node-loc node) "type declaration requires one local definition")))) items))
    (define (prepare-block-scope source scope)
      (let ((items (ir:block-items source)))
        (for-each (lambda (node) (when (ir:overload-declaration? node)
                                   (strict-error (node-loc node) "overloads require module scope"))) items)
        (check-declaration-owners items)
        (let* ((data (prepare-data-schemas! items)) (bindings (definition-bindings items scope))
               (foreign (extern-bindings items)) (inner (extend-scope scope (append bindings foreign data))))
          (check-bindings! bindings inner) inner)))
    (define (visit-block node scope expected)
      (infer-items (ir:block-items node) (prepare-block-scope node scope) expected))
    (define (infer-items items scope expected)
      (cond ((null? items) '())
            ((memq (node-kind (car items)) '(type-declaration extern-declaration data-schema))
             (infer-items (cdr items) scope expected))
            (else (let ((item (infer (car items) scope (and (null? (cdr items)) expected))))
                    (cons item (infer-items (cdr items) scope expected))))))

    ;; ---- Whole-program checking discharges every initializer obligation ----

    (define (infer-program items primitive-bindings loc)
      (let ((owned (copy-ir-graph (list items primitive-bindings))))
        (infer-owned-program (car owned) (cadr owned) loc)))
    (define (infer-owned-program items primitive-bindings loc)
      (parameterize ((pending-declarations '()) (checking-summaries '()))
        (let* ((primitives (map (lambda (entry) (prepare-binding! (car entry) (primitive-scheme (cdr entry)) #f 'primitive (cdr entry))) primitive-bindings))
               (data (prepare-data-schemas! items)) (classes (collect-program-classes items)))
          (check-overload-names items classes primitives)
          (let-values (((items instances) (prepare-class-items items classes)))
            (let* ((scope (extend-scope (make-scope '() '() '() classes instances '())
                                        (append primitives data (apply append (map class-methods classes)))))
                   (source (ir:make-block items loc)) (body (infer source scope #f))
                   (globals (map ir:value-binding-definition (filter-bindings items)))
                   (members (resolve-instance-members instances (append globals primitives data) scope)))
              (settle-summary-obligations! (cons (make-binding-summary (binding-judgment body) scope #f) (checking-summaries)))
              (for-each finish-declaration-check! (reverse (pending-declarations)))
              (check-obligations (judgment-constraints body) scope loc #f)
              (require-overloads! (judgment-constraints body) classes instances loc)
              (let ((expression (freeze-typed-expression (judgment-expression body))))
                ;; Solver-owned construction roots are no longer needed. Neither
                ;; provisional nor frozen expression records are ever mutated.
                (for-each (lambda (summary)
                            (set-summary-expression! summary #f)
                            (set-summary-result! summary #f)
                            (set-summary-scope! summary #f)) (checking-summaries))
                (make-program source globals classes members (judgment-type body) expression)))))))
    (define (filter-bindings items)
      (cond ((null? items) '())
            ((ir:value-binding? (car items)) (cons (car items) (filter-bindings (cdr items))))
            (else (filter-bindings (cdr items)))))
    (define (settle-summary-obligations! summaries)
      (let ((before (type-holes (map (lambda (summary) (judgment-constraints (summary-result summary))) summaries))))
        (for-each (lambda (summary)
                    (let ((result (summary-result summary)))
                      (check-obligations (judgment-constraints result) (summary-scope summary) (judgment-loc result) #f))) summaries)
        (when (type-holes-linked? before)
          (settle-summary-obligations! summaries))))
    (define (checked-member member instance definitions scope)
      (let* ((binding (visible-binding (cdr member) definitions)) (class (instance-class instance))
             (method (let find ((methods (class-methods class)))
                       (if (eq? (car methods) (car member)) (car methods) (find (cdr methods)))))
             (expected (substitute (scheme-type (binding-scheme method)) (map cons (class-variables class) (instance-types instance))))
             (loc (ir:value-definition-loc (cdr member)))
             (checking (if (instance-scheme instance)
                           (make-scope (scope-bindings scope) '() (scheme-constraints (instance-scheme instance))
                                       (scope-classes scope) (scope-instances scope) (scope-recursive scope)) scope)))
        (unless binding (strict-error loc "instance member requires a stable runtime function binding"))
        (let-values (((type obligations substitutions) (instantiate (binding-scheme binding))))
          (unify! type expected loc) (check-obligations obligations checking loc #t))
        (cons (car member) binding)))
    (define (resolve-instance-members instances bindings scope)
      (map (lambda (instance)
             (make-instance (instance-class instance) (instance-types instance)
                            (map (lambda (member) (checked-member member instance bindings scope)) (instance-members instance))
                            (instance-scheme instance) (instance-row instance))) instances)))

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-infer)
    (import
     (lofi host test-utils)
     (only (lofi compiler frontend) syntax->ir-library syntax-list->ir-library)
     (only (lofi compiler reader) string->reader)
     (only (lofi compiler syntax-parser) reader->syntax-list)
     (prefix (lofi compiler resolved-library) library:))
    (begin
      (define (test-dependencies! binding dependencies)
        (let ((references (map (lambda (dependency) (ir:make-name dependency #f)) dependencies)))
          (prepare-binding! binding (mono-scheme 'I64) #f 'value
                            (list (ir:make-block (append references (list (ir:make-literal 0 #f))) #f) #f))))
      (define (test-dependency-cycles)
        (let* ((a (ir:make-value-definition 'a #f)) (b (ir:make-value-definition 'b #f))
               (target (ir:make-value-definition 'target #f))
               (other (ir:make-value-definition 'target #f)) (bindings (list a b target other)))
          (for-each (lambda (binding) (test-dependencies! binding '())) bindings)
          (test-dependencies! a (list b target target)) (test-dependencies! b (list a))
          (test-dependencies! target (list target))
          (let ((plan (plan-bindings bindings)))
            (expect (binding-group a plan) (list a b))
            (expect (binding-group b plan) (list a b))
            (expect (binding-group target plan) (list target))
            (expect (binding-group other plan) (list other))
            (expect (binding-edges a plan) (list b target))
            (expect (binding-edges target plan) (list target))
            (expect (binding-edges other plan) '())
            (test-dependencies! a '())
            (expect (binding-edges a plan) (list b target)))))
      (define (test-dependency-diamond)
        (let ((base (ir:make-value-definition 'value #f)))
          (test-dependencies! base '())
          (let loop ((left 1000) (latest base) (bindings (list base)))
            (if (= left 0)
                (let ((plan (plan-bindings bindings)))
                  (for-each (lambda (binding) (expect (binding-group binding plan) (list binding))) bindings)
                  (expect (binding-edges base plan) '())
                  (expect (length (binding-edges latest plan)) 1))
                (let ((next (ir:make-value-definition 'value #f)))
                  (test-dependencies! next (list latest latest))
                  (loop (- left 1) next (cons next bindings)))))))
      (define (test-forms text)
        (reader->syntax-list (string->reader "ownership.sld" text)))
      (define (test-no-load name) (error "unexpected library load" name))
      (define (test-cached-library)
        (syntax->ir-library
         (car (test-forms "(define-library (cache) (export identity)
                           (begin (def identity (lambda (x) x))))")) test-no-load '()))
      (define (test-cached-program cache text)
        (syntax-list->ir-library (test-forms text) test-no-load (library:library-dependency-order cache)))
      (define (test-infer-library library)
        (infer-program
         (apply append (map library:library-body (library:library-dependency-order library)))
         '() (library:library-loc library)))
      (define (test-cached-compilations)
        (let* ((cache (test-cached-library))
               (source (car (library:library-body cache)))
               (definition (ir:value-binding-definition source))
               (hole (scheme-type (binding-scheme definition)))
               (integer (test-infer-library
                         (test-cached-program cache "(import (cache)) (identity (ann 42 I64))")))
               (boolean (test-infer-library
                         (test-cached-program cache "(import (cache)) (identity #t)"))))
          (expect (resolve (program-type integer)) 'I64)
          (expect (resolve (program-type boolean)) 'Bool)
          (expect (eq? (car (program-globals integer)) (car (program-globals boolean))) #f)
          (expect (eq? (car (program-globals integer)) definition) #f)
          (expect (hole-link hole) #f)
          (expect (node-kind (ir:value-binding-initializer source)) 'lambda)))
      (define (test-template-ownership)
        (let* ((program (test-infer-library (test-cached-program (test-cached-library)
                                                                 "(import (cache)) (identity (ann 42 I64))")))
               (binding (car (program-globals program))) (scheme (binding-scheme binding))
               (variable (car (scheme-variables scheme)))
               (template (car (typed-children (program-expression program))))
               (parameter (cdar (cdr (typed-detail template))))
               (type (typed-type (car (typed-children template)))))
          (expect (substitute type (list (cons parameter 'Bool))) (function-type '(Bool) 'Bool))
          (expect (rigid? parameter) #t)
          (expect (eq? (binding-scheme binding) scheme) #t)
          (expect (hole-link variable) #f)
          (expect (summary-result (binding-summary binding)) #f)
          (expect (summary-scope (binding-summary binding)) #f)))
      (define (test-imported-declaration-owner)
        (let ((cache (syntax->ir-library
                      (car (test-forms "(define-library (cache) (export identity)
                       (begin (def identity (All (A) (-> A A)) (lambda (x) x))))")) test-no-load '())))
          (expect (guard (failure (else (error-object-message failure)))
                    (test-cached-program cache "(import (cache)) (: identity (-> I64 I64)) (identity #t)"))
                  "declaration is not an expression")
          (expect (resolve (program-type (test-infer-library (test-cached-program cache "(import (cache)) (identity #t)")))) 'Bool)))
      (define (test-cached-overload-signatures)
        (let* ((cache (syntax->ir-library
                       (car (test-forms "(define-library (cache) (export choose)
                         (begin (define-overload choose (All (T) (-> T T)) (lambda (value) value))))")) test-no-load '()))
               (row (car (library:library-body cache))) (member (ir:overload-declaration-member row))
               (declaration (binding-declaration member))
               (hole (scheme-type (binding-scheme member)))
               (integer (test-infer-library (test-cached-program cache "(import (cache)) (choose (ann 42 I64))")))
               (boolean (test-infer-library (test-cached-program cache "(import (cache)) (choose #t)")))
               (first (car (program-instances integer))) (second (car (program-instances boolean))))
          (expect (resolve (program-type integer)) 'I64)
          (expect (resolve (program-type boolean)) 'Bool)
          (expect (eq? (instance-scheme first) (instance-scheme second)) #f)
          (expect (eq? (ir:overload-declaration-member (instance-row first)) member) #f)
          (expect (eq? (binding-declaration member) declaration) #t)
          (expect (hole-link hole) #f)))
      (define (test-cached-data-identities)
        (let* ((cache (syntax->ir-library
                       (car (test-forms "(define-library (cache) (export Box box unbox)
                         (begin (def Box (datatype (T) (box (value T unbox))))))")) test-no-load '()))
               (schema (car (library:library-body cache)))
               (source (ir:data-schema-definition schema)) (variables (ir:data-schema-variables schema))
               (integer (test-infer-library
                         (test-cached-program cache
                                              "(import (rename (cache) (Box Crate) (box pack) (unbox unpack))
                                                (rename (cache) (Box Same) (box also-pack) (unbox also-unpack)))
                                               (also-unpack (ann (pack (ann 42 I64)) (Same I64)))")))
               (boolean (test-infer-library
                         (test-cached-program cache "(import (cache)) (unbox (box #t))"))))
          (expect (resolve (program-type integer)) 'I64)
          (expect (resolve (program-type boolean)) 'Bool)
          (expect (binding-kind source) 'datatype)
          (expect (eq? (ir:data-schema-variables schema) variables) #t)))
      (define (test-infer)
        (run-test test-dependency-cycles)
        (run-test test-dependency-diamond)
        (run-test test-cached-compilations)
        (run-test test-template-ownership)
        (run-test test-imported-declaration-owner)
        (run-test test-cached-overload-signatures)
        (run-test test-cached-data-identities))))
   (else)))
