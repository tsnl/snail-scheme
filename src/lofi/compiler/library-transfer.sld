;; Transfer parsed and constructed syntax through one closed packet. Reception
;; establishes lexical ownership; writing copies only unresolved source syntax.
;; Packets cannot supply origins or checking evidence.
(define-library (lofi compiler library-transfer)
  (export read-library-transfer write-library-transfer library-transfer?
          make-library-transfer-context receive-library-transfer)
  (import
   (scheme base)
   (scheme cxr)
   (scheme write)
   (only (native json) json-read json->string)
   (lofi compiler source)
   (lofi compiler ir)
   (lofi compiler syntax)
   (lofi compiler reader)
   (lofi compiler syntax-parser)
   (only (lofi compiler resolved-library) make-named-binding named-binding-name named-binding-definition)
   (lofi compiler library)
   (lofi compiler signatures)
   (lofi compiler numeric-literals)
   (only (lofi compiler frontend) lofi-binding-name? parse-library))
  (begin

    ;; ---- A closed, versioned syntax packet ----

    ;; An owned transfer is its unforgeable origin within this receiver. Reading
    ;; raw bytes again creates another origin, even when every local ID matches.
    (define-record-type <library-transfer>
      (make-library-transfer nodes root) library-transfer?
      (nodes transfer-nodes)
      (root transfer-root))
    (define-record-type <transfer-node>
      (make-transfer-node kind fields) transfer-node?
      (kind transfer-kind)
      (fields transfer-fields))
    (define (field node index) (list-ref (transfer-fields node) index))
    (define schemas
      '((syntax-token text span) (syntax-list sequence syntax-tail span) (syntax-vector sequence span)
        (name text) (span name positive positive) (scope) (child-scope scope-id)
        (binding scope-id name span) (variable-id scope-id name span) (nil) (cons any sequence)
        (scalar-type scalar) (function-type sequence type) (rest-function-type sequence type type)
        (reference-type type) (list-type type) (vector-type type) (rest-type type)
        (nominal-type binding-reference sequence) (variable-type variable-id)
        (constraint binding-reference sequence span) (all-signature child-scope sequence sequence type span)
        (kind-type) (kind-constraint) (kind-function sequence kind) (kind-evidence constraint)
        (local-reference binding span) (import-reference scope name span)
        (reference binding-reference) (literal scalar text span) (number-literal name span)
        (byte byte-value) (string-literal name span) (bytevector-literal sequence span)
        (lambda child-scope sequence expression span)
        (rest-lambda child-scope sequence binding expression span)
        (block child-scope sequence expression span) (annotation expression type span)
        (instantiation binding-reference sequence span)
        (match-arm binding-reference child-scope sequence expression span) (match expression sequence span)
        (application expression sequence span) (conditional expression expression expression span)
        (definition binding signature expression span) (inferred-definition binding expression span)
        (local-binding binding signature expression span) (inferred-local-binding binding expression span)
        (expression-statement expression)
        (data-field name type span) (accessor-field name type binding span)
        (data-case binding sequence span) (datatype binding child-scope sequence sequence span)
        (class-method binding type span) (typeclass binding child-scope sequence sequence span)
        (method-implementation binding-reference expression span) (instance binding constraint sequence span)
        (kind-annotation kind static-declaration span) (extern binding name name type span)
        (overload binding signature expression span)
        (all) (only selection sequence) (rename-pair name name) (rename selection sequence)
        (import sequence selection scope span) (export name binding-reference)
        (library sequence scope sequence sequence sequence span)))
    (define type-kinds
      '(scalar-type function-type rest-function-type reference-type list-type vector-type nominal-type variable-type rest-type))
    (define categories
      `((scope-id scope child-scope) (sequence nil cons) (type ,@type-kinds)
        (syntax syntax-token syntax-list syntax-vector)
        (syntax-tail nil syntax-token syntax-list syntax-vector)
        (signature ,@type-kinds all-signature)
        (binding-reference local-reference import-reference)
        (expression literal number-literal reference lambda rest-lambda application conditional string-literal bytevector-literal
                    block annotation instantiation match)
        (declaration definition inferred-definition local-binding inferred-local-binding expression-statement
                     datatype typeclass instance kind-annotation extern overload)
        (static-declaration datatype typeclass instance) (data-field data-field accessor-field)
        (kind kind-type kind-constraint kind-function kind-evidence) (selection all only rename)))
    (define (reference-field? descriptor) (not (memq descriptor '(text positive scalar byte-value))))
    (define (accepts-kind? descriptor kind)
      (or (eq? descriptor 'any) (eq? descriptor kind)
          (let ((category (assq descriptor categories))) (and category (memq kind (cdr category))))))
    (define (node-id? value count)
      (and (integer? value) (exact? value) (<= 0 value) (< value count)))
    (define (transfer-text value)
      (unless (string? value) (error "expected transfer text"))
      (string-for-each (lambda (character)
                         (unless (unicode-scalar? (char->integer character))
                           (error "transfer text must contain Unicode scalar values"))) value)
      (string-copy value))
    (define (parse-field descriptor value count)
      (cond ((eq? descriptor 'text) (transfer-text value))
            ((eq? descriptor 'scalar)
             (if (member value '("I32" "I64" "F32" "F64" "Bool" "Char" "Unit" "String" "Bytevector" "Never" "Any"))
                 (string->symbol value) (error "unsupported transfer scalar type" value)))
            ((eq? descriptor 'byte-value)
             (if (and (integer? value) (exact? value) (<= 0 value 255)) value
                 (error "byte literal must be in 0..255")))
            ((eq? descriptor 'positive)
             (if (and (integer? value) (exact? value) (<= 1 value 2147483647)) value
                 (error "source locations are one-based I32 values")))
            ((node-id? value count) value)
            (else (error "dangling transfer node ID" value))))
    ;; Attached signatures have an independent source location. Existing
    ;; constructor packets omit it and use the declaration's own span.
    (define (node-schema kind count)
      (when (eq? kind 'inferred-overload) (error "overload requires an explicit signature"))
      (let ((schema (assq kind schemas)))
        (cond ((and schema (= count (length schema))) (cdr schema))
              ((and (eq? kind 'library) (= count (+ (length schema) 1))) (append (cdr schema) '(syntax)))
              ((and (memq kind '(definition local-binding overload)) (= count (+ (length schema) 1)))
               (append (cdr schema) '(span)))
              (else (error "unsupported transfer node" kind)))))
    (define (parse-node row count)
      (unless (and (vector? row) (positive? (vector-length row)) (string? (vector-ref row 0)))
        (error "expected a tagged transfer node"))
      (let* ((kind (string->symbol (vector-ref row 0))) (schema (node-schema kind (vector-length row))))
        (make-transfer-node kind
                            (map (lambda (descriptor value) (parse-field descriptor value count))
                                 schema (cdr (vector->list row))))))
    (define (node-edges node)
      (let scan ((schema (node-schema (transfer-kind node) (+ 1 (length (transfer-fields node))))) (fields (transfer-fields node)))
        (cond ((null? schema) '())
              ((reference-field? (car schema))
               (cons (cons (car schema) (car fields)) (scan (cdr schema) (cdr fields))))
              (else (scan (cdr schema) (cdr fields))))))
    (define (check-node-graph nodes)
      (let ((marks (make-vector (vector-length nodes) #f)))
        (define (visit id chain)
          (when (eq? (vector-ref marks id) 'pending) (error "cyclic transfer structure" (reverse (cons id chain))))
          (unless (eq? (vector-ref marks id) 'complete)
            (vector-set! marks id 'pending)
            (for-each (lambda (edge)
                        (unless (accepts-kind? (car edge) (transfer-kind (vector-ref nodes (cdr edge))))
                          (error "transfer node has wrong kind" id (car edge) (cdr edge)))
                        (visit (cdr edge) (cons id chain))) (node-edges (vector-ref nodes id)))
            (vector-set! marks id 'complete)))
        (do ((id 0 (+ id 1))) ((= id (vector-length nodes))) (visit id '()))))
    ;; The port contains one complete, bounded JSON transfer packet.
    (define (read-library-transfer port)
      (let ((packet (json-read port)))
        (unless (and (list? packet) (= (length packet) 3)
                     (assq 'version packet) (assq 'root packet) (assq 'nodes packet)
                     (eqv? (cdr (assq 'version packet)) 1) (vector? (cdr (assq 'nodes packet))))
          (error "unsupported library transfer packet"))
        (let* ((rows (cdr (assq 'nodes packet))) (count (vector-length rows)) (root (cdr (assq 'root packet))))
          (unless (node-id? root count) (error "invalid transfer root"))
          (let ((nodes (vector-map (lambda (row) (parse-node row count)) rows)))
            (check-node-graph nodes)
            (unless (eq? (transfer-kind (vector-ref nodes root)) 'library) (error "transfer root must be a library"))
            (make-library-transfer nodes root)))))

    ;; ---- Explicit receiving contexts preserve legitimate identity reuse ----

    (define-record-type <transfer-context>
      (new-transfer-context libraries) transfer-context?
      (libraries context-libraries set-context-libraries!))
    (define (make-library-transfer-context) (new-transfer-context '()))
    (define (receive-library-transfer context transfer)
      (unless (and (transfer-context? context) (library-transfer? transfer))
        (error "receiving requires a context and an owned library transfer"))
      (let ((known (assq transfer (context-libraries context))))
        (if known (cdr known)
            (let ((library (lower-transfer transfer)))
              (set-context-libraries! context (cons (cons transfer library) (context-libraries context))) library))))
    (define-record-type <decoding>
      (make-decoding nodes bindings scopes root import-scope) decoding?
      (nodes decoding-nodes)
      (bindings decoding-bindings)
      (scopes decoding-scopes)
      (root decoding-root)
      (import-scope decoding-import-scope))
    (define (get-node state id) (vector-ref (decoding-nodes state) id))
    (define (get-name state id) (string->symbol (field (get-node state id) 0)))
    (define (get-binding-name state id location)
      (let ((name (get-name state id)))
        (unless (lofi-binding-name? name) (error "reserved Lofi keyword cannot be a binding" location name)) name))
    (define (get-location state id)
      (let ((node (get-node state id)))
        (make-loc (field (get-node state (field node 0)) 0) (field node 1) (field node 2))))
    (define (sequence-items state id descriptor)
      (let ((node (get-node state id)))
        (if (eq? (transfer-kind node) 'nil) '()
            (let ((head (field node 0)))
              (unless (accepts-kind? descriptor (transfer-kind (get-node state head)))
                (error "transfer sequence element has wrong kind" descriptor head))
              (cons head (sequence-items state (field node 1) descriptor))))))
    (define (library-key state id)
      (let ((names (map (lambda (name) (get-name state name)) (sequence-items state id 'name))))
        (when (null? names) (error "library key must not be empty")) names))
    (define (unique-names names location)
      (unless (null? names)
        (when (memq (car names) (cdr names)) (error "duplicate transfer name" location (car names)))
        (unique-names (cdr names) location)))

    ;; ---- Definitions and lexical ownership ----

    (define (claim-scope state id parent)
      (when (vector-ref (decoding-scopes state) id) (error "transfer scope has multiple owners" id))
      (let ((node (get-node state id)))
        (unless (if parent (and (eq? (transfer-kind node) 'child-scope) (= (field node 0) parent))
                    (eq? (transfer-kind node) 'scope))
          (error "transfer scope has wrong parent" id)))
      (vector-set! (decoding-scopes state) id #t))
    (define (declare-binding state id scope)
      (let* ((node (get-node state id)) (location (get-location state (field node 2))))
        (unless (= (field node 0) scope) (error "binding belongs to a different scope" location id))
        (when (vector-ref (decoding-bindings state) id) (error "duplicate binding definition" location id))
        (let ((binding (make-value-definition (get-binding-name state (field node 1) location) location)))
          (vector-set! (decoding-bindings state) id binding) binding)))
    (define (declare-bindings state ids scope location)
      (let ((bindings (map (lambda (id) (declare-binding state id scope)) ids)))
        (unique-names (map value-definition-name bindings) location) bindings))
    (define-record-type <lexical-context>
      (make-lexical-context scope values variables) lexical-context?
      (scope lexical-scope)
      (values lexical-values)
      (variables lexical-variables))
    (define (extend-values context ids)
      (make-lexical-context (lexical-scope context) (append ids (lexical-values context)) (lexical-variables context)))
    (define (nested-context context scope ids)
      (make-lexical-context scope (append ids (lexical-values context)) (lexical-variables context)))
    (define (local-role? binding role)
      (case role
        ((binding) #t)
        ((value) (not (memq (binding-kind binding) '(datatype typeclass instance))))
        ((datatype) (eq? (binding-kind binding) 'datatype))
        ((constraint) (memq (binding-kind binding) '(typeclass overload)))
        (else #f)))
    (define (lower-local-reference state node context role)
      ;; A DAG node can occur in several lexical contexts. Validity belongs to
      ;; this occurrence; a previous successful visit cannot authorize reuse.
      (let ((id (field node 0)) (location (get-location state (field node 1))))
        (unless (memv id (lexical-values context)) (error "binding reference escapes its lexical scope" location))
        (let ((binding (vector-ref (decoding-bindings state) id)))
          (unless (local-role? binding role) (error "local binding has the wrong kind" location role)) binding)))
    (define (lower-reference state id context role)
      (let ((node (get-node state id)))
        (if (eq? (transfer-kind node) 'local-reference) (lower-local-reference state node context role)
            (begin
              (unless (= (field node 0) (decoding-root state))
                (error "import reference belongs to a different library scope" (get-location state (field node 2))))
              (make-scoped-reference (get-name state (field node 1)) (decoding-import-scope state) role
                                     (get-location state (field node 2)))))))
    (define (reference-location state id)
      (let ((node (get-node state id)))
        (get-location state (field node (if (eq? (transfer-kind node) 'local-reference) 1 2)))))

    ;; ---- Declared types and quantified identities create no checking evidence ----

    (define (lower-types state id context)
      (map (lambda (type) (lower-type state type context)) (sequence-items state id 'type)))
    (define (lower-variable state id context)
      (unless (memv id (lexical-variables context))
        (error "type variable escapes its lexical scope" (get-location state (field (get-node state id) 2))))
      (vector-ref (decoding-bindings state) id))
    (define (lower-type state id context)
      (let ((node (get-node state id)))
        (case (transfer-kind node)
          ((scalar-type) (if (eq? (field node 0) 'Any) 'Top (field node 0)))
          ((variable-type) (lower-variable state (field node 0) context))
          ((nominal-type) (cons 'record (cons (lower-reference state (field node 0) context 'datatype)
                                              (lower-types state (field node 1) context))))
          ((reference-type) (list 'Ref (lower-type state (field node 0) context)))
          ((list-type) (list 'List (lower-type state (field node 0) context)))
          ((vector-type) (list 'Vector (lower-type state (field node 0) context)))
          ((rest-type) (list 'Rest (lower-type state (field node 0) context)))
          ((function-type) (cons '-> (append (lower-types state (field node 0) context)
                                             (list (lower-type state (field node 1) context)))))
          ((rest-function-type)
           (cons '-> (append (lower-types state (field node 0) context)
                             (list (list 'Rest (lower-type state (field node 1) context))
                                   (lower-type state (field node 2) context))))))))
    (define (declare-variable state id scope)
      (let* ((node (get-node state id)) (location (get-location state (field node 2))))
        (unless (= (field node 0) scope) (error "type variable belongs to a different scope" location id))
        (when (vector-ref (decoding-bindings state) id) (error "duplicate type variable definition" location id))
        (let ((variable (make-type-variable (get-binding-name state (field node 1) location) location)))
          (vector-set! (decoding-bindings state) id variable) variable)))
    (define (quantified-context state scope variables location context)
      (claim-scope state scope (lexical-scope context))
      (let ((bindings (map (lambda (id) (declare-variable state id scope)) variables)))
        (unique-names (map type-variable-name bindings) location)
        (make-lexical-context (lexical-scope context) (lexical-values context)
                              (append variables (lexical-variables context)))))
    (define (lower-constraint state id context)
      (let ((node (get-node state id)))
        (cons (lower-reference state (field node 0) context 'constraint)
              (lower-types state (field node 1) context))))
    (define (lower-signature state id context)
      (let ((node (get-node state id)))
        (if (not (eq? (transfer-kind node) 'all-signature)) (values (lower-type state id context) context)
            (let* ((ids (sequence-items state (field node 1) 'variable-id))
                   (inner (quantified-context state (field node 0) ids (get-location state (field node 4)) context))
                   (constraints (map (lambda (id) (lower-constraint state id inner))
                                     (sequence-items state (field node 2) 'constraint)))
                   (type (lower-type state (field node 3) inner)))
              (values (list 'All (map (lambda (id) (lower-variable state id inner)) ids)
                            (if (null? constraints) type (list '=> constraints type))) inner)))))
    (define (lower-kind state id context)
      (let ((node (get-node state id)))
        (case (transfer-kind node)
          ((kind-type) 'Type) ((kind-constraint) 'Constraint)
          ((kind-evidence) (list 'Evidence (lower-constraint state (field node 0) context)))
          ((kind-function)
           (let ((parameters (sequence-items state (field node 0) 'kind)))
             (when (null? parameters) (error "kind arrow requires a parameter"))
             (cons 'Kind-> (append (map (lambda (id) (lower-kind state id context)) parameters)
                                   (list (lower-kind state (field node 1) context)))))))))

    ;; ---- Literal representations are checked before entering unresolved IR ----

    (define (unicode-scalar? value)
      (and (integer? value) (exact? value) (<= 0 value #x10ffff) (not (<= #xd800 value #xdfff))))
    ;; The wire grammar is decimal, not the host Scheme reader's numeric
    ;; language. In particular #e decimal text must never round to an integer
    ;; before its width is checked. Finite floats use the exact decimal decoder.
    (define (digits-end text start)
      (let scan ((index start))
        (if (and (< index (string-length text)) (char<=? #\0 (string-ref text index) #\9))
            (scan (+ index 1)) index)))
    (define (number-start text)
      (if (and (positive? (string-length text)) (char=? (string-ref text 0) #\-)) 1 0))
    (define (decimal-integer? text)
      (let ((start (number-start text)))
        (and (< start (string-length text)) (= (digits-end text start) (string-length text)))))
    (define (fraction-end text start)
      (if (and (< start (string-length text)) (char=? (string-ref text start) #\.))
          (let ((end (digits-end text (+ start 1)))) (and (> end (+ start 1)) end)) start))
    (define (exponent-end text start)
      (if (and (< start (string-length text)) (char=? (string-ref text start) #\e))
          (let* ((next (+ start 1))
                 (digits (if (and (< next (string-length text)) (memv (string-ref text next) '(#\+ #\-)))
                             (+ next 1) next)) (end (digits-end text digits)))
            (and (> end digits) end)) start))
    (define (decimal-float? text)
      (let* ((start (number-start text)) (whole (digits-end text start))
             (fraction (and (> whole start) (fraction-end text whole)))
             (end (and fraction (exponent-end text fraction))))
        (and end (= end (string-length text)) (or (> fraction whole) (> end fraction)))))
    (define (wire-float type text location)
      (if (member text '("+inf.0" "-inf.0" "+nan.0")) (string->number text)
          (begin
            (unless (decimal-float? text) (error "invalid floating transfer literal" location text))
            (rounded-float-literal 0.0 text type location))))
    (define (wire-literal-value type text location)
      (case type
        ((I32 I64)
         (unless (decimal-integer? text) (error "invalid integer transfer literal" location text))
         (checked-integer-literal (string->number text) type location))
        ((F32 F64) (wire-float type text location))
        ((Bool) (unless (member text '("0" "1")) (error "invalid Bool transfer literal" location)) (string=? text "1"))
        ((Char)
         (unless (and (decimal-integer? text) (unicode-scalar? (string->number text)))
           (error "invalid Char transfer literal" location))
         (integer->char (string->number text)))
        (else (error "unsupported transfer literal" location type))))
    (define (lower-literal state node)
      (let* ((type (field node 0)) (text (field node 1)) (location (get-location state (field node 2)))
             (value (wire-literal-value type text location)))
        (make-annotation (make-literal value location (and (number? value) text)) type location)))

    ;; ---- Expression scopes carry values and declared type variables ----

    (define (lower-lambda state node context)
      (let* ((rest? (eq? (transfer-kind node) 'rest-lambda)) (scope (field node 0))
             (parameters (sequence-items state (field node 1) 'binding))
             (rest (and rest? (field node 2))) (ids (append parameters (if rest (list rest) '())))
             (location (get-location state (field node (if rest? 4 3)))))
        (claim-scope state scope (lexical-scope context))
        (declare-bindings state ids scope location)
        (make-lambda (map (lambda (id) (vector-ref (decoding-bindings state) id)) parameters)
                     (and rest (vector-ref (decoding-bindings state) rest))
                     (lower-expression state (field node (if rest? 3 2)) (nested-context context scope ids)) location)))
    (define (lower-block state node context)
      (let ((scope (field node 0)) (location (get-location state (field node 3))))
        (claim-scope state scope (lexical-scope context))
        (let-values (((items final) (lower-body state (field node 1) (nested-context context scope '()) #f)))
          (make-block (append items (list (lower-expression state (field node 2) final))) location))))
    (define (lower-match-arm state id context)
      (let* ((node (get-node state id)) (scope (field node 1))
             (ids (sequence-items state (field node 2) 'binding)) (location (get-location state (field node 4)))
             (constructor (lower-reference state (field node 0) context 'value)))
        (claim-scope state scope (lexical-scope context))
        (let ((parameters (declare-bindings state ids scope location)))
          (list constructor (make-lambda parameters #f
                                         (lower-expression state (field node 3) (nested-context context scope ids)) location)))))
    (define (lower-match state node context)
      (let ((arms (sequence-items state (field node 1) 'match-arm)))
        (when (null? arms) (error "match requires constructor arms" (get-location state (field node 2))))
        (make-match (lower-expression state (field node 0) context)
                    (map (lambda (id) (lower-match-arm state id context)) arms) (get-location state (field node 2)))))
    (define (lower-instantiation state node context)
      (let ((types (lower-types state (field node 1) context)) (location (get-location state (field node 2))))
        (when (null? types) (error "inst requires at least one type argument" location))
        (make-instantiation (make-name (lower-reference state (field node 0) context 'value)
                                       (reference-location state (field node 0))) types location)))
    (define (lower-expression state id context)
      (let ((node (get-node state id)))
        (case (transfer-kind node)
          ((literal) (lower-literal state node))
          ((number-literal)
           (let* ((text (field (get-node state (field node 0)) 0))
                  (location (get-location state (field node 1))) (value (string->number text)))
             (unless value (error "invalid source number literal" location text))
             (make-literal value location text)))
          ((string-literal) (make-literal (string-copy (field (get-node state (field node 0)) 0))
                                          (get-location state (field node 1))))
          ((bytevector-literal)
           (make-literal (apply bytevector (map (lambda (id) (field (get-node state id) 0))
                                                (sequence-items state (field node 0) 'byte)))
                         (get-location state (field node 1))))
          ((reference) (make-name (lower-reference state (field node 0) context 'value)
                                  (reference-location state (field node 0))))
          ((lambda rest-lambda) (lower-lambda state node context))
          ((block) (lower-block state node context))
          ((annotation) (make-annotation (lower-expression state (field node 0) context)
                                         (lower-type state (field node 1) context) (get-location state (field node 2))))
          ((instantiation) (lower-instantiation state node context))
          ((match) (lower-match state node context))
          ((application)
           (make-application (lower-expression state (field node 0) context)
                             (map (lambda (argument) (lower-expression state argument context))
                                  (sequence-items state (field node 1) 'expression)) (get-location state (field node 2))))
          ((conditional)
           (make-conditional (lower-expression state (field node 0) context)
                             (lower-expression state (field node 1) context)
                             (lower-expression state (field node 2) context) (get-location state (field node 3)))))))

    ;; ---- Reserve recursive definitions, then introduce lets in source order ----

    (define (declaration-node state id)
      (let ((node (get-node state id)))
        (if (eq? (transfer-kind node) 'kind-annotation) (get-node state (field node 1)) node)))
    (define (data-case-bindings state id)
      (let ((node (get-node state id)))
        (cons (field node 0)
              (apply append (map (lambda (id)
                                   (let ((field-node (get-node state id)))
                                     (if (eq? (transfer-kind field-node) 'accessor-field)
                                         (list (field field-node 2)) '())))
                                 (sequence-items state (field node 1) 'data-field))))))
    (define (declaration-ids state node)
      (case (transfer-kind node)
        ((definition inferred-definition extern instance overload) (list (field node 0)))
        ((datatype) (cons (field node 0) (apply append (map (lambda (id) (data-case-bindings state id))
                                                            (sequence-items state (field node 3) 'data-case)))))
        ((typeclass) (cons (field node 0) (map (lambda (id) (field (get-node state id) 0))
                                               (sequence-items state (field node 3) 'class-method))))
        (else '())))
    (define (reserve-declaration state node context library? reserved)
      (let* ((kind (transfer-kind node)) (ids (declaration-ids state node))
             (static? (memq kind '(datatype typeclass instance))) (overload? (eq? kind 'overload)))
        (when (and (or static? overload?) (not library?)) (error "static definitions and overloads require library scope"))
        (for-each (lambda (id)
                    (if (and overload? (memv id reserved))
                        (unless (eq? (binding-kind (vector-ref (decoding-bindings state) id)) 'overload)
                          (error "overload collides with an ordinary binding" id))
                        (declare-binding state id (lexical-scope context)))) ids)
        (when (or static? overload?)
          (let ((binding (vector-ref (decoding-bindings state) (car ids))))
            (prepare-binding! binding (binding-scheme binding) #f (if overload? 'overload kind) #f)))
        (append (if overload? (if (memv (car ids) reserved) '() ids) ids) reserved)))
    (define (reserve-body state statements context library?)
      (let loop ((statements statements) (reserved '()))
        (if (null? statements)
            (begin (unique-definition-names state reserved) reserved)
            (loop (cdr statements)
                  (reserve-declaration state (declaration-node state (car statements)) context library? reserved)))))
    (define (unique-definition-names state ids)
      (let loop ((ids ids) (names '()))
        (unless (null? ids)
          (let* ((binding (vector-ref (decoding-bindings state) (car ids))) (name (value-definition-name binding)))
            (when (memq name names) (error "duplicate transfer name" (value-definition-loc binding) name))
            (loop (cdr ids) (cons name names))))))
    (define (local-binding-node? node) (memq (transfer-kind node) '(local-binding inferred-local-binding)))
    (define (check-local-name state node reserved)
      (let* ((binding (get-node state (field node 0))) (name (get-name state (field binding 1))))
        (when (memq name (map (lambda (id) (value-definition-name (vector-ref (decoding-bindings state) id))) reserved))
          (error "let conflicts with a definition" (get-location state (field binding 2)) name))))
    (define (lower-body state id context library?)
      (let* ((statements (sequence-items state id 'declaration))
             (reserved (reserve-body state statements context library?)))
        (for-each (lambda (id) (let ((node (get-node state id)))
                                 (when (local-binding-node? node) (check-local-name state node reserved)))) statements)
        (lower-statements state statements (extend-values context reserved))))
    (define (lower-statements state ids context)
      (if (null? ids) (values '() context)
          (let* ((node (get-node state (car ids))) (local? (local-binding-node? node)))
            (when local? (declare-binding state (field node 0) (lexical-scope context)))
            (let ((statement (lower-declaration state node context))
                  (next (if local? (extend-values context (list (field node 0))) context)))
              (let-values (((rest final) (lower-statements state (cdr ids) next)))
                (values (cons statement rest) final))))))
    (define (attached-signature-location state node fallback)
      (if (= (length (transfer-fields node)) 5) (get-location state (field node 4)) fallback))
    (define (lower-value-definition state node context)
      (let* ((annotated? (memq (transfer-kind node) '(definition local-binding overload)))
             (overload? (eq? (transfer-kind node) 'overload))
             (binding (vector-ref (decoding-bindings state) (field node 0)))
             (location (get-location state (field node (if annotated? 3 2))))
             (signature-location (attached-signature-location state node location)))
        (let-values (((signature inner) (if annotated? (lower-signature state (field node 1) context) (values #f context))))
          (let ((value (lower-expression state (field node (if annotated? 2 1)) inner)))
            (if overload?
                (begin (unless (arrow-type? (all-body signature))
                         (error "overload requires a function signature" location))
                       (make-overload-declaration binding signature value location signature-location))
                (begin (when signature
                         (set-binding-declaration! binding (make-type-declaration binding signature signature-location)))
                       (make-value-binding binding value location (if (local-binding-node? node) 'let 'def))))))))

    ;; ---- Static declarations retain only declared syntax and fresh identities ----

    (define (lower-data-field state id context)
      (let ((node (get-node state id)))
        (list (get-name state (field node 0)) (lower-type state (field node 1) context)
              (and (eq? (transfer-kind node) 'accessor-field) (vector-ref (decoding-bindings state) (field node 2))))))
    (define (lower-data-case state id context)
      (let* ((node (get-node state id))
             (fields (map (lambda (id) (lower-data-field state id context)) (sequence-items state (field node 1) 'data-field))))
        (unique-names (map car fields) (get-location state (field node 2)))
        (list (vector-ref (decoding-bindings state) (field node 0)) fields)))
    (define (lower-class-method state id context)
      (let* ((node (get-node state id)) (type (lower-type state (field node 1) context)))
        (unless (arrow-type? type) (error "class method requires a function signature" (get-location state (field node 2))))
        (list (vector-ref (decoding-bindings state) (field node 0)) type)))
    (define (lower-parameterized-declaration state node context)
      (let* ((data? (eq? (transfer-kind node) 'datatype)) (ids (sequence-items state (field node 2) 'variable-id))
             (location (get-location state (field node 4)))
             (inner (quantified-context state (field node 1) ids location context))
             (rows (sequence-items state (field node 3) (if data? 'data-case 'class-method))))
        (when (and data? (null? rows)) (error "datatype requires constructors" location))
        ((if data? make-data-schema make-class-declaration)
         (vector-ref (decoding-bindings state) (field node 0))
         (map (lambda (id) (lower-variable state id inner)) ids)
         (map (lambda (id) (if data? (lower-data-case state id inner) (lower-class-method state id inner))) rows) location)))
    (define (lower-method-implementation state id context)
      (let ((node (get-node state id)))
        (cons (lower-reference state (field node 0) context 'value) (lower-expression state (field node 1) context))))
    (define (lower-instance state node context)
      (let ((head (lower-constraint state (field node 1) context)))
        (make-instance-declaration (vector-ref (decoding-bindings state) (field node 0)) (car head) (cdr head)
                                   (map (lambda (id) (lower-method-implementation state id context))
                                        (sequence-items state (field node 2) 'method-implementation))
                                   (get-location state (field node 3)))))
    (define (declared-static-kind state node context)
      (if (eq? (transfer-kind node) 'instance) (list 'Evidence (lower-constraint state (field node 1) context))
          (let ((parameters (sequence-items state (field node 2) 'variable-id))
                (result (if (eq? (transfer-kind node) 'datatype) 'Type 'Constraint)))
            (if (null? parameters) result (append '(Kind->) (make-list (length parameters) 'Type) (list result))))))
    (define (lower-declaration state node context)
      (case (transfer-kind node)
        ((definition inferred-definition local-binding inferred-local-binding overload)
         (lower-value-definition state node context))
        ((expression-statement) (lower-expression state (field node 0) context))
        ((datatype typeclass) (lower-parameterized-declaration state node context))
        ((instance) (lower-instance state node context))
        ((kind-annotation)
         (let ((declaration (get-node state (field node 1))))
           (make-node 'static-kind (get-location state (field node 2))
                      (list (lower-kind state (field node 0) context) (declared-static-kind state declaration context)
                            (lower-declaration state declaration context)))))
        ((extern)
         (make-extern-declaration (vector-ref (decoding-bindings state) (field node 0))
                                  (field (get-node state (field node 1)) 0) (field (get-node state (field node 2)) 0)
                                  (lower-type state (field node 3) context) (get-location state (field node 4))))))

    ;; ---- Imports and exports remain independent of provider availability ----

    (define (lower-renames state id)
      (let ((names (map (lambda (pair)
                          (let ((node (get-node state pair)))
                            (cons (get-name state (field node 0)) (get-binding-name state (field node 1) #f))))
                        (sequence-items state id 'rename-pair))))
        (unique-names (map car names) #f) names))
    (define (lower-selection state id)
      (let ((node (get-node state id)))
        (case (transfer-kind node)
          ((all) (make-import-selection 'all #f '()))
          ((only) (make-import-selection 'only (lower-selection state (field node 0))
                                         (map (lambda (name) (get-name state name))
                                              (sequence-items state (field node 1) 'name))))
          ((rename) (make-import-selection 'rename (lower-selection state (field node 0))
                                           (lower-renames state (field node 1)))))))
    (define (lower-import state id)
      (let* ((node (get-node state id)) (location (get-location state (field node 3))))
        (unless (= (field node 2) (decoding-root state)) (error "import belongs to a different library scope" location))
        (make-lofi-import (library-key state (field node 0)) (lower-selection state (field node 1))
                          (decoding-import-scope state) location)))
    (define (lower-export state id context)
      (let ((node (get-node state id)))
        (make-named-binding (get-binding-name state (field node 0) (reference-location state (field node 1)))
                            (lower-reference state (field node 1) context 'binding))))
    (define (lower-syntax state id)
      (let ((node (get-node state id)))
        (case (transfer-kind node)
          ((nil) '())
          ((syntax-token)
           (let* ((loc (get-location state (field node 1)))
                  (forms (reader->syntax-list (string->reader (loc-filename loc) (field node 0)))))
             (unless (and (= (length forms) 1) (atom-syntax? (car forms))) (error "expected one transferred syntax token"))
             (make-atom-syntax (atom-syntax-value (car forms)) loc (atom-syntax-number-spelling (car forms)))))
          ((syntax-list)
           (make-list-syntax (map (lambda (item) (lower-syntax state item)) (sequence-items state (field node 0) 'syntax))
                             (lower-syntax state (field node 1)) (get-location state (field node 2))))
          ((syntax-vector)
           (make-vector-syntax (map (lambda (item) (lower-syntax state item)) (sequence-items state (field node 0) 'syntax))
                               (get-location state (field node 1))))
          (else (error "invalid located syntax node")))))
    (define (lower-transfer transfer)
      (let* ((nodes (transfer-nodes transfer)) (root (vector-ref nodes (transfer-root transfer))))
        (if (= (length (transfer-fields root)) 7)
            (let* ((state (make-decoding nodes #f #f #f #f))
                   (library (parse-library (lower-syntax state (field root 6)))))
              (unless (equal? (lofi-library-name library) (library-key state (field root 0)))
                (error "located syntax library name differs from transfer header")) library)
            (lower-constructed-transfer transfer))))
    (define (lower-constructed-transfer transfer)
      (let* ((nodes (transfer-nodes transfer)) (root (vector-ref nodes (transfer-root transfer)))
             (scope (field root 1)) (count (vector-length nodes))
             (state (make-decoding nodes (make-vector count #f) (make-vector count #f) scope (make-scope-id)))
             (location (get-location state (field root 5)))
             (context (make-lexical-context scope '() '())) (exports (sequence-items state (field root 3) 'export)))
        (claim-scope state scope #f)
        (unique-names (map (lambda (id) (get-name state (field (get-node state id) 0))) exports) location)
        (let-values (((declarations final) (lower-body state (field root 4) context #t)))
          (make-lofi-library (library-key state (field root 0)) (decoding-import-scope state)
                             (map (lambda (id) (lower-import state id)) (sequence-items state (field root 2) 'import))
                             (map (lambda (id) (lower-export state id final)) exports) declarations
                             (map (lambda (id) (let ((binding (vector-ref (decoding-bindings state) id)))
                                                 (cons (value-definition-name binding) binding))) (lexical-values final)) location))))

    ;; ---- Parsed syntax becomes the same constructive packet ----

    ;; Only source declarations are traversed. Inferred schemes, checked node
    ;; types and mutable compiler caches are never transferred. Binding objects
    ;; are the keys: equal spellings never identify two declarations.
    (define-record-type <encoding>
      (make-encoding rows count bindings variables root) encoding?
      (rows encoding-rows set-encoding-rows!)
      (count encoding-count set-encoding-count!)
      (bindings encoding-bindings set-encoding-bindings!)
      (variables encoding-variables set-encoding-variables!)
      (root encoding-root))
    (define (emit-node state tag . fields)
      (let ((id (encoding-count state)))
        (set-encoding-count! state (+ id 1))
        (set-encoding-rows! state (cons (list->vector (cons (symbol->string tag) fields))
                                        (encoding-rows state))) id))
    (define (emit-sequence state ids)
      (if (null? ids) (emit-node state 'nil)
          (emit-node state 'cons (car ids) (emit-sequence state (cdr ids)))))
    (define (emit-name state name)
      (emit-node state 'name (if (symbol? name) (symbol->string name) name)))
    (define (emit-location state location)
      (unless (loc? location) (error "transferred source syntax requires a location"))
      (emit-node state 'span (emit-name state (loc-filename location))
                 (loc-line location) (loc-column location)))
    (define (emit-binding state definition scope)
      (let ((known (assq definition (encoding-bindings state))))
        (if known (cdr known)
            (let ((id (emit-node state 'binding scope (emit-name state (value-definition-name definition))
                                 (emit-location state (value-definition-loc definition)))))
              (set-encoding-bindings! state (cons (cons definition id) (encoding-bindings state))) id))))
    (define (binding-node-id state definition)
      (let ((known (assq definition (encoding-bindings state))))
        (unless known (error "source binding has no lexical owner" (value-definition-name definition)))
        (cdr known)))
    (define (emit-reference state reference location)
      (if (scoped-reference? reference)
          (emit-node state 'import-reference (encoding-root state) (emit-name state (reference-name reference))
                     (emit-location state (reference-loc reference)))
          (emit-node state 'local-reference (binding-node-id state reference) (emit-location state location))))
    (define (emit-variables state variables scope location)
      (map (lambda (variable)
             (let ((id (emit-node state 'variable-id scope (emit-name state (type-variable-name variable))
                                  (emit-location state (or (type-variable-loc variable) location)))))
               (set-encoding-variables! state (cons (cons variable id) (encoding-variables state))) id)) variables))

    ;; A declaration body determines its binding owners before any initializer
    ;; is copied. Visibility remains the parser's decision, represented by the
    ;; exact referenced object and the retained def/let source former.
    (define (source-case-bindings row)
      (cons (car row) (apply append (map (lambda (field) (if (caddr field) (list (caddr field)) '())) (cadr row)))))
    (define (source-declaration-bindings node)
      (case (node-kind node)
        ((bind) (list (value-binding-definition node)))
        ((extern-declaration) (list (extern-declaration-definition node)))
        ((overload-declaration) (list (overload-declaration-definition node)))
        ((instance-declaration) (list (instance-declaration-definition node)))
        ((class-declaration)
         (cons (class-declaration-definition node) (map car (class-declaration-methods node))))
        ((data-schema)
         (cons (data-schema-definition node) (apply append (map source-case-bindings (data-schema-cases node)))))
        ((static-kind) (source-declaration-bindings (caddr (node-data node))))
        (else '())))
    (define (emit-body state items scope)
      (for-each (lambda (node)
                  (for-each (lambda (binding) (emit-binding state binding scope))
                            (source-declaration-bindings node))) items)
      (map (lambda (node) (emit-declaration state node scope)) items))

    ;; ---- Declared types retain quantifiers and unresolved static references ----

    (define (emit-types state types location)
      (emit-sequence state (map (lambda (type) (emit-type state type location)) types)))
    (define (emit-type state type location)
      (cond ((symbol? type) (emit-node state 'scalar-type (symbol->string (if (eq? type 'Top) 'Any type))))
            ((type-variable? type)
             (let ((known (assq type (encoding-variables state))))
               (unless known (error "source type variable has no quantifier" (type-variable-name type)))
               (emit-node state 'variable-type (cdr known))))
            (else
             (case (car type)
               ((Ref List Vector Rest)
                (emit-node state (case (car type) ((Ref) 'reference-type) ((List) 'list-type)
                                       ((Vector) 'vector-type) ((Rest) 'rest-type))
                           (emit-type state (cadr type) location)))
               ((->) (emit-node state 'function-type (emit-types state (type-arguments type) location)
                                (emit-type state (car (reverse type)) location)))
               ((record) (emit-node state 'nominal-type (emit-reference state (cadr type) location)
                                    (emit-types state (cddr type) location)))
               (else (error "not declared source type syntax" type))))))
    (define (emit-constraint state constraint location)
      (emit-node state 'constraint (emit-reference state (car constraint) location)
                 (emit-types state (cdr constraint) location) (emit-location state location)))
    (define (emit-signature state signature scope location)
      (if (not (all-type? signature)) (emit-type state signature location)
          (let* ((inner (emit-node state 'child-scope scope))
                 (variables (emit-variables state (all-variables signature) inner location))
                 (requirements (map (lambda (constraint) (emit-constraint state constraint location))
                                    (type-constraints signature))))
            (emit-node state 'all-signature inner (emit-sequence state variables) (emit-sequence state requirements)
                       (emit-type state (all-body signature) location) (emit-location state location)))))
    (define (emit-kind state kind location)
      (cond ((eq? kind 'Type) (emit-node state 'kind-type))
            ((eq? kind 'Constraint) (emit-node state 'kind-constraint))
            ((eq? (car kind) 'Evidence) (emit-node state 'kind-evidence (emit-constraint state (cadr kind) location)))
            (else (emit-node state 'kind-function
                             (emit-sequence state (map (lambda (kind) (emit-kind state kind location)) (type-arguments kind)))
                             (emit-kind state (car (reverse kind)) location)))))

    ;; ---- Expressions preserve literal spellings until ordinary checking ----

    (define (emit-bytes state value)
      (emit-sequence state
                     (let bytes ((index 0))
                       (if (= index (bytevector-length value)) '()
                           (cons (emit-node state 'byte (bytevector-u8-ref value index)) (bytes (+ index 1)))))))
    (define (emit-literal state node)
      (let ((value (literal-value node)) (span (emit-location state (node-loc node))))
        (cond ((number? value)
               (emit-node state 'number-literal (emit-name state (or (literal-number-spelling node) (number->string value))) span))
              ((boolean? value) (emit-node state 'literal "Bool" (if value "1" "0") span))
              ((char? value) (emit-node state 'literal "Char" (number->string (char->integer value)) span))
              ((string? value) (emit-node state 'string-literal (emit-name state value) span))
              ((bytevector? value) (emit-node state 'bytevector-literal (emit-bytes state value) span))
              (else (error "unsupported source literal" (node-loc node) value)))))
    (define (emit-lambda state node scope)
      (let* ((inner (emit-node state 'child-scope scope))
             (parameters (map (lambda (binding) (emit-binding state binding inner)) (lambda-parameters node)))
             (rest (and (lambda-opt-rest-parameter node) (emit-binding state (lambda-opt-rest-parameter node) inner)))
             (body (emit-expression state (lambda-body node) inner)) (span (emit-location state (node-loc node))))
        (if rest (emit-node state 'rest-lambda inner (emit-sequence state parameters) rest body span)
            (emit-node state 'lambda inner (emit-sequence state parameters) body span))))
    (define (emit-block state node scope)
      (let* ((inner (emit-node state 'child-scope scope)) (items (block-items node))
             (statements (reverse (cdr (reverse items)))) (result (car (reverse items)))
             (declarations (emit-body state statements inner)))
        (emit-node state 'block inner (emit-sequence state declarations) (emit-expression state result inner)
                   (emit-location state (node-loc node)))))
    (define (emit-match-arm state arm scope)
      (let* ((function (cadr arm)) (inner (emit-node state 'child-scope scope))
             (parameters (map (lambda (binding) (emit-binding state binding inner)) (lambda-parameters function)))
             (location (node-loc function)))
        (emit-node state 'match-arm (emit-reference state (car arm) location) inner (emit-sequence state parameters)
                   (emit-expression state (lambda-body function) inner) (emit-location state location))))
    (define (emit-expression state node scope)
      (let ((location (node-loc node)))
        (case (node-kind node)
          ((literal) (emit-literal state node))
          ((name) (emit-node state 'reference (emit-reference state (name-definition node) location)))
          ((lambda) (emit-lambda state node scope))
          ((block) (emit-block state node scope))
          ((call) (emit-node state 'application (emit-expression state (application-operator node) scope)
                             (emit-sequence state (map (lambda (operand) (emit-expression state operand scope))
                                                       (application-operands node))) (emit-location state location)))
          ((if) (emit-node state 'conditional (emit-expression state (conditional-test node) scope)
                           (emit-expression state (conditional-consequent node) scope)
                           (emit-expression state (conditional-opt-alternate node) scope) (emit-location state location)))
          ((annotation) (emit-node state 'annotation (emit-expression state (annotation-expression node) scope)
                                   (emit-type state (annotation-type node) location) (emit-location state location)))
          ((instantiation) (emit-node state 'instantiation
                                      (emit-reference state (name-definition (instantiation-expression node))
                                                      (node-loc (instantiation-expression node)))
                                      (emit-types state (instantiation-types node) location) (emit-location state location)))
          ((match) (emit-node state 'match (emit-expression state (match-subject node) scope)
                              (emit-sequence state (map (lambda (arm) (emit-match-arm state arm scope)) (match-arms node)))
                              (emit-location state location)))
          (else (error "not unresolved source expression syntax" location (node-kind node))))))

    ;; ---- Source declarations retain order, attached signatures and static kinds ----

    (define (emit-value-definition state node scope)
      (let* ((overload? (overload-declaration? node))
             (binding (if overload? (overload-declaration-definition node) (value-binding-definition node)))
             (declaration (binding-declaration (if overload? (overload-declaration-member node) binding)))
             (signature (if overload? (overload-declaration-type node) (and declaration (type-declaration-type declaration))))
             (tag (if overload? 'overload (if (eq? (value-binding-form node) 'let) 'local-binding 'definition)))
             (location (node-loc node))
             (type (and signature (emit-signature state signature scope (if declaration (node-loc declaration) location))))
             (value (emit-expression state (if overload? (overload-declaration-implementation node)
                                               (value-binding-initializer node)) scope)))
        (if signature (emit-node state tag (binding-node-id state binding) type value (emit-location state location)
                                 (emit-location state (node-loc declaration)))
            (emit-node state (case tag ((local-binding) 'inferred-local-binding)
                                   (else 'inferred-definition))
                       (binding-node-id state binding) value (emit-location state location)))))
    (define (emit-data-field state field location)
      (let ((name (emit-name state (car field))) (type (emit-type state (cadr field) location))
            (span (emit-location state location)))
        (if (caddr field) (emit-node state 'accessor-field name type (binding-node-id state (caddr field)) span)
            (emit-node state 'data-field name type span))))
    (define (emit-data-case state row)
      (let ((location (value-definition-loc (car row))))
        (emit-node state 'data-case (binding-node-id state (car row))
                   (emit-sequence state (map (lambda (field) (emit-data-field state field location)) (cadr row)))
                   (emit-location state location))))
    (define (emit-class-method state row)
      (let ((location (value-definition-loc (car row))))
        (emit-node state 'class-method (binding-node-id state (car row)) (emit-type state (cadr row) location)
                   (emit-location state location))))
    (define (emit-parameterized state node scope)
      (let* ((data? (data-schema? node)) (inner (emit-node state 'child-scope scope)) (location (node-loc node))
             (variables (emit-variables state ((if data? data-schema-variables class-declaration-variables) node) inner location))
             (rows ((if data? data-schema-cases class-declaration-methods) node)))
        (emit-node state (if data? 'datatype 'typeclass)
                   (binding-node-id state ((if data? data-schema-definition class-declaration-definition) node)) inner
                   (emit-sequence state variables)
                   (emit-sequence state (map (lambda (row) (if data? (emit-data-case state row) (emit-class-method state row))) rows))
                   (emit-location state location))))
    (define (emit-instance state node scope)
      (let ((location (node-loc node)))
        (emit-node state 'instance (binding-node-id state (instance-declaration-definition node))
                   (emit-constraint state (cons (instance-declaration-class node) (instance-declaration-types node)) location)
                   (emit-sequence state (map (lambda (row)
                                               (emit-node state 'method-implementation (emit-reference state (car row) location)
                                                          (emit-expression state (cdr row) scope) (emit-location state location)))
                                             (instance-declaration-methods node))) (emit-location state location))))
    (define (emit-declaration state node scope)
      (case (node-kind node)
        ((bind overload-declaration) (emit-value-definition state node scope))
        ((data-schema class-declaration) (emit-parameterized state node scope))
        ((instance-declaration) (emit-instance state node scope))
        ((static-kind) (emit-node state 'kind-annotation (emit-kind state (car (node-data node)) (node-loc node))
                                  (emit-declaration state (caddr (node-data node)) scope) (emit-location state (node-loc node))))
        ((extern-declaration) (emit-node state 'extern (binding-node-id state (extern-declaration-definition node))
                                         (emit-name state (extern-declaration-module node)) (emit-name state (extern-declaration-symbol node))
                                         (emit-type state (extern-declaration-type node) (node-loc node)) (emit-location state (node-loc node))))
        (else (emit-node state 'expression-statement (emit-expression state node scope)))))

    ;; ---- Library identity is owned by reception, never chosen by the packet ----

    (define (emit-names state names)
      (emit-sequence state (map (lambda (name) (emit-name state name)) names)))
    (define (emit-selection state selection)
      (case (selection-kind selection)
        ((all) (emit-node state 'all))
        ((only) (emit-node state 'only (emit-selection state (selection-from selection))
                           (emit-names state (selection-names selection))))
        ((rename) (emit-node state 'rename (emit-selection state (selection-from selection))
                             (emit-sequence state (map (lambda (row)
                                                         (emit-node state 'rename-pair (emit-name state (car row)) (emit-name state (cdr row))))
                                                       (selection-names selection)))))))
    (define (emit-import state declaration)
      (emit-node state 'import (emit-names state (lofi-import-provider declaration))
                 (emit-selection state (lofi-import-selection declaration)) (encoding-root state)
                 (emit-location state (lofi-import-loc declaration))))
    (define (emit-export state declaration location)
      (let ((reference (named-binding-definition declaration)))
        (emit-node state 'export (emit-name state (named-binding-name declaration))
                   (emit-reference state reference (if (value-definition? reference) (value-definition-loc reference) location)))))
    ;; Original located syntax preserves transformer definitions and imports
    ;; across the scalar service boundary. Reception reparses it; the packet
    ;; never supplies binding identity or expansion evidence.
    (define (emit-syntax state form)
      (cond ((null? form) (emit-node state 'nil))
            ((atom-syntax? form)
             (let ((port (open-output-string)))
               (if (atom-syntax-number-spelling form) (display (atom-syntax-number-spelling form) port)
                   (write (atom-syntax-value form) port))
               (emit-node state 'syntax-token (get-output-string port) (emit-location state (syntax-loc form)))))
            ((list-syntax? form)
             (emit-node state 'syntax-list (emit-sequence state (map (lambda (item) (emit-syntax state item)) (list-syntax-elements form)))
                        (emit-syntax state (list-syntax-improper-tail form)) (emit-location state (syntax-loc form))))
            (else (emit-node state 'syntax-vector (emit-sequence state (map (lambda (item) (emit-syntax state item)) (vector-syntax-elements form)))
                             (emit-location state (syntax-loc form))))))
    (define (source-library-packet library)
      (unless (and (lofi-library? library) (lofi-library-name library))
        (error "transfer requires a named source library"))
      (let* ((state (make-encoding '() 0 '() '() 0)) (scope (emit-node state 'scope))
             (intrinsic? (let scan ((bindings (lofi-library-bindings library)))
                           (and (pair? bindings) (or (memq (binding-kind (cdar bindings)) '(syntax-form primitive)) (scan (cdr bindings))))))
             (declarations (emit-body state (lofi-library-declarations library) scope))
             (root (apply emit-node state 'library (append (list (emit-names state (lofi-library-name library)) scope
                                                                 (emit-sequence state (map (lambda (item) (emit-import state item)) (lofi-library-imports library)))
                                                                 (emit-sequence state (map (lambda (item) (emit-export state item (lofi-library-loc library)))
                                                                                           (if intrinsic? '() (lofi-library-exports library))))
                                                                 (emit-sequence state declarations) (emit-location state (lofi-library-loc library)))
                                                           (if (lofi-library-syntax library) (list (emit-syntax state (lofi-library-syntax library))) '())))))
        `((version . 1) (root . ,root) (nodes . ,(list->vector (reverse (encoding-rows state)))))))
    ;; Chibi's compact JSON writer leaves some control characters in strings.
    ;; Escape those characters so copied literal text is valid JSON in every host.
    (define (write-library-transfer library port)
      (string-for-each
       (lambda (character)
         (if (< (char->integer character) 32)
             (let ((hex (number->string (char->integer character) 16)))
               (display "\\u" port) (display (substring "0000" (string-length hex) 4) port) (display hex port))
             (write-char character port)))
       (json->string (source-library-packet library))))
    )

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-library-transfer)
    (import
     (native test-utils)
     (only (lofi compiler macros) core-syntax-names)
     (only (lofi compiler primitives) primitive-names)
     (only (chibi temp-file) call-with-temp-dir)
     (only (native chromium-trace) with-chromium-trace-to)
     (only (lofi compiler frontend) parse-library)
     (only (lofi compiler reader) string->reader)
     (only (lofi compiler syntax-parser) reader->syntax-list)
     (only (scheme bytevector) bytevector-ieee-single-native-set! bytevector-ieee-double-native-set!
           bytevector-u32-native-ref bytevector-u64-native-ref))
    (begin
      (define (read-test-packet text) (read-library-transfer (open-input-string text)))
      (define (test-packet-nodes)
        (vector '#("library" 1 2 3 7 10 4) '#("cons" 6 3) '#("scope") '#("nil")
                '#("span" 5 11 5) '#("name" "generated.sld") '#("name" "descriptive")
                '#("cons" 8 3) '#("export" 9 11) '#("name" "run") '#("cons" 12 3)
                '#("local-reference" 13 4) '#("definition" 13 14 15 4) '#("binding" 2 16 4)
                '#("function-type" 3 17) '#("lambda" 18 3 19 4) '#("name" "hidden")
                '#("scalar-type" "I32") '#("child-scope" 2) '#("literal" "I32" "42" 4)))
      (define (test-packet-text nodes)
        (json->string `((version . 1) (root . 0) (nodes . ,nodes))))
      (define (test-receive nodes)
        (receive-library-transfer (make-library-transfer-context) (read-test-packet (test-packet-text nodes))))
      (define (test-transfer-identity)
        (let* ((text (test-packet-text (test-packet-nodes))) (context (make-library-transfer-context))
               (transfer (read-test-packet text)) (library (receive-library-transfer context transfer))
               (separate (receive-library-transfer context (read-test-packet text))))
          (expect (eq? library (receive-library-transfer context transfer)) #t)
          (expect (eq? (lofi-library-id library) (lofi-library-id separate)) #f)
          (expect (eq? (binding-origin (value-binding-definition (car (lofi-library-declarations library))))
                       (binding-origin (value-binding-definition (car (lofi-library-declarations separate))))) #f)
          (expect (loc-filename (lofi-library-loc library)) "generated.sld")
          (expect (loc-line (lofi-library-loc library)) 11)
          (expect (loc-line (type-declaration-loc (binding-declaration
                                                   (value-binding-definition (car (lofi-library-declarations library)))))) 11)))
      (define (test-invalid-declarations)
        (for-each
         (lambda (change)
           (let ((nodes (test-packet-nodes)))
             (vector-set! nodes (car change) (cdr change))
             (expect (guard (failure (else #t)) (test-receive nodes) #f) #t)))
         (list (cons 8 '#("export" 9 15)) (cons 13 '#("binding" 18 16 4))
               (cons 10 '#("cons" 12 10)) (cons 12 '#("definition" 13 14 15 4 16))
               (cons 12 '#("definition" 13 14 15 4 4 4)) (cons 1 '#("nil")) (cons 4 '#("span" 5 0 1))
               (cons 19 '#("literal" "I32" "1/2" 4)) (cons 19 '#("literal" "I64" "9223372036854775808" 4))
               (cons 19 '#("literal" "Bool" "2" 4)) (cons 19 '#("literal" "Char" "55296" 4))
               (cons 19 '#("literal" "Unit" "0" 4)) (cons 19 '#("reference" 19))
               (cons 16 '#("name" "def")) (cons 9 '#("name" "I32"))))
        (let ((nodes (test-packet-nodes)))
          (vector-set! nodes 12 '#("inferred-overload" 13 15 4))
          (expect (guard (failure (else (error-object-message failure))) (test-receive nodes) #f)
                  "overload requires an explicit signature")))
      (define (test-definition-ownership)
        (let* ((original (test-packet-nodes)) (nodes (vector-append original (vector '#("cons" 12 3)))))
          (vector-set! nodes 10 '#("cons" 12 20))
          (expect (guard (failure (else #t)) (test-receive nodes) #f) #t))
        (let ((nodes (vector-append (test-packet-nodes) (vector '#("binding" 18 16 4)))))
          (vector-set! nodes 11 '#("local-reference" 20 4))
          (expect (guard (failure (else #t)) (test-receive nodes) #f) #t)))
      (define (test-structure-and-recursion)
        (let ((nodes (test-packet-nodes)))
          (vector-set! nodes 10 '#("cons" 12 10))
          (expect (guard (failure (else (error-object-message failure))) (test-receive nodes) #f)
                  "cyclic transfer structure"))
        (let ((nodes (vector-append (test-packet-nodes) (vector '#("application" 21 3 4) '#("reference" 11)))))
          (vector-set! nodes 15 '#("lambda" 18 3 20 4))
          (expect (lofi-library? (test-receive nodes)) #t))
        (expect (guard (failure (else #t))
                  (read-test-packet (json->string `((version . 1) (root . 0) (nodes . ,(test-packet-nodes)) (origin . 0)))) #f)
                #t))
      (define (received-literal type spelling)
        (let ((nodes (test-packet-nodes)))
          (vector-set! nodes 17 (vector "scalar-type" type))
          (vector-set! nodes 19 (vector "literal" type spelling 4))
          (literal-value (annotation-expression
                          (lambda-body (value-binding-initializer (car (lofi-library-declarations (test-receive nodes)))))))))
      (define (received-float-bits type spelling)
        (let ((bytes (make-bytevector 8 0)) (value (received-literal type spelling)))
          (if (string=? type "F32")
              (begin (bytevector-ieee-single-native-set! bytes 0 value) (bytevector-u32-native-ref bytes 0))
              (begin (bytevector-ieee-double-native-set! bytes 0 value) (bytevector-u64-native-ref bytes 0)))))
      (define (test-numeric-transfer)
        (expect (received-literal "I64" "9223372036854775807") 9223372036854775807)
        (expect (received-literal "I64" "-9223372036854775808") -9223372036854775808)
        (for-each (lambda (row) (expect (received-float-bits (car row) (cadr row)) (caddr row)))
                  '(("F32" "-0.0" #x80000000) ("F32" "1.401298464324817e-45" 1)
                    ("F32" "3.4028234663852886e+38" #x7f7fffff)
                    ("F64" "1.0000000000000002" #x3ff0000000000001)
                    ("F64" "1.7976931348623157e+308" #x7fefffffffffffff)
                    ("F64" "5e-324" 1) ("F64" "-0.0" #x8000000000000000)))
        (for-each (lambda (text)
                    (expect (guard (failure (else #t)) (received-literal "I64" text) #f) #t))
                  '("#e9223372036854775807.0" "9223372036854775807.0" "9223372036854775808" "-9223372036854775809"))
        (for-each (lambda (text)
                    (expect (guard (failure (else #t)) (received-literal "F32" text) #f) #t))
                  '("1" "1+2i" "1@2" "#e1.0" "1/2" " 1.0" ".5" "1." "1e" "1e+" "3.4028236e+38")))
      (define (test-malformed-packets)
        (for-each
         (lambda (text) (expect (guard (failure (else #t)) (read-test-packet text) #f) #t))
         '("{}" "{\"version\":2,\"root\":0,\"nodes\":[]}"
           "{\"version\":1,\"root\":0,\"nodes\":[[\"nil\"]]}"
           "{\"version\":1,\"root\":0,\"nodes\":[[\"cons\",0,0]]}"
           "{\"version\":1,\"root\":0,\"nodes\":[[\"reference\",9]]}"
           "{\"version\":1,\"root\":0,\"nodes\":[[\"reference\",1],[\"nil\"]]}")))
      (define (test-transfer-text)
        (expect (guard (failure (else (error-object-message failure)))
                  (read-test-packet "{\"version\":1,\"root\":0,\"nodes\":[[\"name\",\"\\ud800\"]]}") #f)
                "transfer text must contain Unicode scalar values")
        (let ((value (json-read (open-input-string "\"\\ud83d\\ude42\\u0000\""))))
          (expect (map char->integer (string->list (transfer-text value))) '(128578 0))))
      (define (parse-test-library text)
        (parse-library (car (reader->syntax-list (string->reader "parsed-transfer.sld" text)))))
      (define (roundtrip-source source)
        (let ((output (open-output-string)))
          (write-library-transfer source output)
          (receive-library-transfer (make-library-transfer-context) (read-test-packet (get-output-string output)))))
      (define (test-source-binding-identity)
        (let* ((source (parse-test-library
                        "(define-library (test shadow) (import (missing provider)) (export last)
                          (begin (let x remote) (def capture (lambda () x)) (let x 2)
                                 (def later (lambda () after)) (def after 3) (def last x)))"))
               (received (roundtrip-source source)) (items (lofi-library-declarations received))
               (first (value-binding-definition (car items))) (second (value-binding-definition (caddr items)))
               (capture (lambda-body (value-binding-initializer (cadr items))))
               (last (value-binding-initializer (list-ref items 5))))
          (expect (map value-binding-form items) '(let def let def def def))
          (expect (eq? first second) #f)
          (expect (eq? (name-definition capture) first) #t)
          (expect (eq? (name-definition last) second) #t)
          (expect (eq? (name-definition (lambda-body (value-binding-initializer (list-ref items 3))))
                       (value-binding-definition (list-ref items 4))) #t)
          (expect (reference-name (name-definition (value-binding-initializer (car items)))) 'remote)
          (expect (eq? (reference-scope (name-definition (value-binding-initializer (car items))))
                       (lofi-library-scope received)) #t)
          (expect (loc-column (node-loc capture))
                  (loc-column (node-loc (lambda-body (value-binding-initializer (cadr (lofi-library-declarations source)))))))
          (expect (eq? (lofi-library-id source) (lofi-library-id received)) #f)))
      (define (test-source-type-identity)
        (let* ((library (roundtrip-source (parse-test-library
                                           "(define-library (test generic) (export identity)
                                            (begin (def Identity (typeclass (T) (: copy (-> T T))))
                                              (def identity (All (T) (requires (Identity T)) (-> T T))
                                              (lambda (value) (ann value T)))))")))
               (declarations (lofi-library-declarations library)) (binding (cadr declarations))
               (signature (type-declaration-type (binding-declaration (value-binding-definition binding))))
               (variable (car (all-variables signature)))
               (annotation (lambda-body (value-binding-initializer binding))))
          (expect (eq? variable (cadr (all-body signature))) #t)
          (expect (eq? variable (annotation-type annotation)) #t)
          (expect (eq? (caar (type-constraints signature)) (class-declaration-definition (car declarations))) #t)
          (expect (eq? (cadar (type-constraints signature)) variable) #t)
          (expect (loc-filename (type-variable-loc variable)) "parsed-transfer.sld")
          (expect (> (loc-column (node-loc (binding-declaration (value-binding-definition binding))))
                     (loc-column (node-loc binding))) #t)))
      (define (test-source-number-syntax)
        (for-each
         (lambda (spelling)
           (let* ((text (string-append "(define-library (test number) (begin (def value " spelling ")))"))
                  (original (parse-test-library text)) (received (roundtrip-source original))
                  (literal (value-binding-initializer (car (lofi-library-declarations received)))))
             (expect (literal? literal) #t)
             (expect (literal-number-spelling literal) spelling)))
         '("9223372036854775807" "9223372036854775808" "1.0000000596046448" "-0.0" "+inf.0"
           "1e999" "#e1.25" "#i1/3" "#x1000000000000001" "1+2i"))
        (let* ((library (roundtrip-source (parse-test-library
                                           "(define-library (test rest) (begin (def value (Rest I32) 1)))")))
               (definition (value-binding-definition (car (lofi-library-declarations library)))))
          (expect (type-declaration-type (binding-declaration definition)) '(Rest I32))))
      (define (test-intrinsic-source-transfer)
        (for-each
         (lambda (key names kind)
           (let ((port (open-output-string)))
             (write `(define-library ,key (export ,@names)) port)
             (let ((received (roundtrip-source (parse-test-library (get-output-string port)))))
               (expect (map named-binding-name (lofi-library-exports received)) names)
               (expect (map (lambda (entry) (binding-kind (cdr entry))) (lofi-library-bindings received))
                       (map (lambda (name) kind) names))
               (expect (loc-filename (lofi-library-loc received)) "parsed-transfer.sld"))))
         '((lofi core) (lofi primitive)) (list core-syntax-names primitive-names) '(syntax-form primitive)))
      (define (test-library-transfer)
        (run-test test-malformed-packets)
        (run-test test-transfer-text)
        (run-test test-transfer-identity)
        (run-test test-invalid-declarations)
        (run-test test-definition-ownership)
        (run-test test-structure-and-recursion)
        (run-test test-numeric-transfer)
        (call-with-temp-dir
         "lofi-transfer-tests"
         (lambda (directory preserve)
           (with-chromium-trace-to
            (string-append directory "/parse.json")
            (lambda ()
              (run-test test-source-binding-identity)
              (run-test test-source-type-identity)
              (run-test test-source-number-syntax)
              (run-test test-intrinsic-source-transfer))))))))
   (else)))
