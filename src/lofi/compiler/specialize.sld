;; Concrete demand is a graph of binding storage and function implementations.
;; Checking evidence is specialized into immutable concrete trees. Emission
;; consumes those trees without replaying source typing rules.
(define-library (lofi compiler specialize)
  (export prepare-generation prepare-entry-generation prepared-body prepared-functions
          prepared-globals prepared-exports prepared-context prepared-activations prepared-expression
          compilation-program compilation-definitions compilation-next context-entity concrete-key-comparator
          environment-substitutions environment-sites environment-owner
          site-id site-source site-global? site-instances site-token site-check site-values
          value-binding? value-id value-index value-type value-site value-source value-parameter?
          value-initializer value-environment value-function value-expression value-ready-at-capture?
          function-index function-type* function-parameters function-expression
          function-captures function-source function-environment
          site-environment sites-for-source)
  (import
   (scheme base)
   (scheme cxr)
   (lofi compiler hashmap)
   (only (srfi 128) make-default-comparator make-eq-comparator make-comparator comparator-hash-function number-hash)
   (lofi compiler types)
   (lofi compiler checked)
   (lofi compiler concrete)
   (lofi compiler typed)
   (lofi compiler overloads)
   (lofi compiler data)
   (lofi compiler ir)
   (only (lofi compiler wasm-extern) wasm-scalar-signature))
  (begin

    ;; ---- Persistent compilation requests ----

    ;; Cache keys contain source identities, integer scope identities, and
    ;; frozen concrete types. A unification hole is never part of a key.
    ;; Lists encode composite keys and type structure. Records are opaque
    ;; identities: structural hashing would walk whole bodies and binding graphs.
    (define identity-hash (comparator-hash-function (make-eq-comparator)))
    (define (request-key=? left right)
      (or (eqv? left right)
          (and (pair? left) (pair? right) (request-key=? (car left) (car right)) (request-key=? (cdr left) (cdr right)))))
    (define (request-key-hash key)
      (cond ((pair? key) (modulo (+ (* 31 (request-key-hash (car key))) (request-key-hash (cdr key))) 536870909))
            ((number? key) (number-hash key))
            (else (identity-hash key))))
    (define concrete-key-comparator (make-comparator (lambda (key) #t) request-key=? #f request-key-hash))
    (define-record-type <compilation>
      (make-compilation cache entities pending definitions next program) compilation?
      (cache compilation-cache)
      (entities compilation-entities)
      (pending compilation-pending)
      (definitions compilation-definitions)
      (next compilation-next)
      (program compilation-program))
    (define (context-entity context id) (hashmap-ref (compilation-entities context) id))
    (define (context-put context id entity)
      (make-compilation (compilation-cache context) (hashmap-set (compilation-entities context) id entity)
                        (compilation-pending context) (compilation-definitions context)
                        (compilation-next context) (compilation-program context)))
    (define (reserve context key entity pending?)
      (let ((id (compilation-next context)))
        (values id (make-compilation (hashmap-set (compilation-cache context) key id)
                                     (hashmap-set (compilation-entities context) id entity)
                                     (if pending? (cons id (compilation-pending context)) (compilation-pending context))
                                     (compilation-definitions context) (+ id 1) (compilation-program context)))))
    (define (cached context key) (hashmap-ref/default (compilation-cache context) key #f))
    (define (pop-request context)
      (make-compilation (compilation-cache context) (compilation-entities context)
                        (cdr (compilation-pending context)) (compilation-definitions context)
                        (compilation-next context) (compilation-program context)))
    (define (complete-function context id expression)
      (let* ((function (context-entity context id))
             (context (context-put context id (make-function id (function-source function) (function-type* function)
                                                             (function-environment function) (function-parameters function)
                                                             (function-reads function)
                                                             (function-closures function) (function-captures function) expression (function-template function)))))
        (make-compilation (compilation-cache context) (compilation-entities context)
                          (compilation-pending context) (cons id (compilation-definitions context))
                          (compilation-next context) (compilation-program context))))

    ;; ---- Lexical storage and implementation summaries ----

    (define-record-type <environment>
      (make-environment substitutions sites owner instance) environment?
      (substitutions environment-substitutions)
      (sites environment-sites)
      (owner environment-owner)
      (instance environment-instance))
    (define-record-type <site>
      (make-site id source environment global? instances token check template) site?
      (id site-id)
      (source site-source)
      (environment site-environment)
      (global? site-global?)
      (instances site-instances)
      (token site-token)
      (check site-check)
      (template site-template))
    (define-record-type <value>
      (make-value id source type site environment parameter? function expression) value-binding?
      (id value-id)
      (source value-source)
      (type value-type)
      (site value-site)
      (environment value-environment)
      (parameter? value-parameter?)
      (function value-function)
      (expression value-expression))
    (define value-index value-id)
    (define (value-initializer value) (binding-initializer (value-source value)))
    (define (value-ready-at-capture? value) (value-parameter? value))
    (define-record-type <function>
      (make-function id source type environment parameters reads closures captures expression template) function?
      (id function-index)
      (source function-source)
      (type function-type*)
      (environment function-environment)
      (parameters function-parameters)
      (reads function-reads)
      (closures function-closures)
      (captures function-captures)
      (expression function-expression)
      (template function-template))
    (define-record-type <program>
      (make-prepared-program body functions globals exports context activations expression) prepared-program?
      (body prepared-body)
      (functions prepared-functions)
      (globals prepared-globals)
      (exports prepared-exports)
      (context prepared-context)
      (activations prepared-activations)
      (expression prepared-expression))
    (define (concrete type environment loc)
      (require-concrete (substitute type (environment-substitutions environment)) loc))
    (define (lookup-site binding environment context)
      (let ((id (hashmap-ref/default (environment-sites environment) binding #f)))
        (unless id (strict-error (value-definition-loc binding) "missing lexical specialization site"))
        (context-entity context id)))
    (define (site-values sites context)
      (apply append (map (lambda (site)
                           (map (lambda (id) (context-entity context id))
                                (append (if (site-token site) (list (site-token site)) '()) (site-instances site)))) sites)))
    (define (scope-bindings-at source)
      (let collect ((items (block-items source)))
        (cond ((null? items) '())
              ((eq? (node-kind (car items)) 'bind)
               (cons (value-binding-definition (car items)) (collect (cdr items))))
              (else (collect (cdr items))))))
    (define (scope-key source environment) (list 'scope (environment-owner environment) (environment-instance environment) source))
    (define (sites-for-source source environment context)
      (let ((id (cached context (scope-key source environment))))
        (unless id (strict-error (node-loc source) "missing prepared lexical scope"))
        (context-entity context id)))
    (define (allocate-sites bindings environment context)
      (let loop ((bindings bindings) (sites (environment-sites environment)) (ids '()) (context context))
        (if (null? bindings) (values sites (reverse ids) context)
            (let-values (((id next) (reserve context (list 'site (environment-owner environment) (environment-instance environment) (car bindings)) #f #f)))
              (loop (cdr bindings) (hashmap-set sites (car bindings) id) (cons id ids) next)))))
    (define (prepare-sites source bindings parent global? context templates)
      (let ((prior (cached context (scope-key source parent))))
        (if prior (values (context-entity context prior) context)
            (let-values (((sites ids context) (allocate-sites bindings parent context)))
              (let* ((inner (make-environment (environment-substitutions parent) sites
                                              (environment-owner parent) (environment-instance parent)))
                     (context (let add ((bindings bindings) (ids ids) (templates templates) (context context))
                                (if (null? ids) context
                                    (add (cdr bindings) (cdr ids) (if (pair? templates) (cdr templates) '())
                                         (context-put context (car ids) (make-site (car ids) (car bindings) inner global? '() #f #f (and (pair? templates) (car templates)))))))))
                (let-values (((id context) (reserve context (scope-key source parent) inner #f)))
                  (values inner context)))))))

    ;; Partition the completed graph once. Slot zero owns initialization;
    ;; function ID n owns slot n+1. Descending IDs cons each owner's values into
    ;; allocation order, preserving the slot order used by emission.
    (define (activation-value-index context)
      (let ((index (make-vector (+ 1 (compilation-next context)) '())))
        (do ((id (- (compilation-next context) 1) (- id 1))) ((< id 0) index)
          (let ((entity (context-entity context id)))
            (when (value-binding? entity)
              (let* ((owner (environment-owner (value-environment entity)))
                     (slot (if owner (+ owner 1) 0)))
                (vector-set! index slot (cons entity (vector-ref index slot)))))))))

    ;; ---- Exactly one queued implementation per frozen request ----

    (define (instance-mapping binding substitutions environment)
      (let collect ((variables (scheme-variables (binding-scheme binding))))
        (if (null? variables) '()
            (let* ((entry (assq (car variables) substitutions))
                   (type (substitute (if entry (cdr entry) (car variables)) (environment-substitutions environment))))
              ;; A truly phantom quantifier has no representation to choose.
              ;; A used unresolved variable fails at its concrete operation.
              (if (concrete-type? type) (cons (cons (car variables) type) (collect (cdr variables)))
                  (collect (cdr variables)))))))
    (define (indexed-mapping binding mapping)
      (let index ((variables (scheme-variables (binding-scheme binding))) (ordinal 0))
        (if (null? variables) '()
            (let ((entry (assq (car variables) mapping)))
              (if entry (cons (cons ordinal (cdr entry)) (index (cdr variables) (+ ordinal 1)))
                  (index (cdr variables) (+ ordinal 1)))))))
    (define (template-mapping site mapping)
      (if (not (site-template site)) '()
          (let collect ((aliases (cdr (typed-detail (site-template site)))))
            (if (null? aliases) '()
                (let ((entry (assq (caar aliases) mapping)))
                  (if entry (cons (cons (cdar aliases) (cdr entry)) (collect (cdr aliases)))
                      (collect (cdr aliases))))))))
    (define (request-value site type substitutions caller context)
      (let* ((mapping (instance-mapping (site-source site) substitutions caller))
             (key (list 'value (site-id site) type (indexed-mapping (site-source site) mapping))) (prior (cached context key)))
        (if prior (values (context-entity context prior) context)
            (begin
              (when (>= (length (site-instances site)) 64)
                (strict-error (value-definition-loc (site-source site)) "specialization limit exceeded; recursive instances keep changing"))
              (let* ((parent (site-environment site))
                     (environment (make-environment (append mapping (template-mapping site mapping) (environment-substitutions parent))
                                                    (environment-sites parent) (environment-owner parent) (compilation-next context)))
                     (value (make-value (compilation-next context) (site-source site) type (site-id site) environment #f #f #f)))
                (let-values (((id next) (reserve context key value #t)))
                  (values value (context-put next (site-id site)
                                             (make-site (site-id site) (site-source site) parent (site-global? site)
                                                        (append (site-instances site) (list id)) (site-token site) (site-check site) (site-template site))))))))))
    (define (request-token site context)
      (if (site-token site) (values (site-token site) context)
          (let ((value (make-value (compilation-next context) (site-source site) 'Unit (site-id site)
                                   (site-environment site) #f #f #f)))
            (let-values (((id context) (reserve context (list 'token (site-id site)) value #f)))
              (values id (context-put context (site-id site)
                                      (make-site (site-id site) (site-source site) (site-environment site) (site-global? site)
                                                 (site-instances site) id (site-check site) (site-template site))))))))
    (define (initializer-token source environment context)
      (case (node-kind source)
        ((annotation) (initializer-token (annotation-expression source) environment context))
        ((instantiation) (initializer-token (instantiation-expression source) environment context))
        ((name) (let ((binding (name-definition source)))
                  (if (memq (binding-kind binding) '(primitive method extern data)) (values #f context)
                      (request-token (lookup-site binding environment context) context))))
        (else (values #f context))))
    (define (prepare-initializer site environment context)
      (let* ((binding (site-source site)) (scheme (binding-scheme binding)))
        (if (null? (scheme-variables scheme))
            (let-values (((value context) (request-value site (concrete (scheme-type scheme) environment (value-definition-loc binding)) '() environment context)))
              (values (context-entity context (site-id site)) context))
            (let-values (((token context) (initializer-token (binding-initializer binding) environment context)))
              (let* ((current (context-entity context (site-id site)))
                     (site (make-site (site-id site) binding environment (site-global? site)
                                      (site-instances current) (site-token current) token (site-template current))))
                (values site (context-put context (site-id site) site)))))))
    (define (parameter-values bindings types environment context)
      (let loop ((bindings bindings) (types types) (result '()) (context context))
        (if (null? bindings) (values (reverse result) context)
            (let* ((site (lookup-site (car bindings) environment context))
                   (value (make-value (compilation-next context) (car bindings) (car types) (site-id site) environment #t #f #f)))
              (let-values (((id context) (reserve context (list 'parameter (site-id site)) value #f)))
                (loop (cdr bindings) (cdr types) (cons id result)
                      (context-put context (site-id site) (make-site (site-id site) (site-source site) environment #f (list id) #f #f (site-template site)))))))))
    (define (request-function source type environment context template)
      (let* ((key (list 'function (environment-owner environment) (environment-instance environment) source type))
             (prior (cached context key)))
        (if prior (values prior context)
            (let-values (((id context) (reserve context key #f #t)))
              (let* ((bindings (lambda-parameters source))
                     (parent (make-environment (environment-substitutions environment) (environment-sites environment) id id)))
                (let*-values (((inner context) (prepare-sites source bindings parent #f context '()))
                              ((parameters context) (parameter-values bindings (function-domains type) inner context)))
                  (values id (context-put context id
                                          (make-function id source type inner parameters '() '() '() #f template)))))))))

    ;; ---- Concrete static evidence ----

    (define (check-concrete-obligations obligations environment context loc)
      (let ((program (compilation-program context))
            (goals (substitute obligations (environment-substitutions environment))))
        ;; Sibling prerequisites share fresh holes. Solve them together before
        ;; requiring any one prerequisite's representation to be concrete.
        (require-overloads! goals (program-classes program) (program-instances program) loc)
        ;; Method references consume the first selected instance immediately.
        ;; Check sibling goals in order without selecting that first goal twice.
        (and (pair? goals)
             (let ((instance (exact-instance (car goals) environment context loc)))
               (for-each (lambda (goal) (exact-instance goal environment context loc)) (cdr goals))
               instance))))
    (define (exact-instance constraint environment context loc)
      (let* ((program (compilation-program context))
             (types (map (lambda (type) (concrete type environment loc)) (cdr constraint)))
             (class (overload-class (car constraint) (program-classes program))))
        (if class
            (let ((view (select-overload-view class (car types) (program-instances program) loc #t)))
              (check-concrete-obligations (overload-view-constraints view) environment context loc)
              (overload-view-instance view))
            (let find ((instances (program-instances program)))
              (cond ((null? instances) (strict-error loc "no exact static typeclass instance" constraint))
                    ((and (eq? (car constraint) (class-definition (instance-class (car instances))))
                          (type-equal? types (instance-types (car instances)))) (car instances))
                    (else (find (cdr instances))))))))
    (define (resolve-reference view instance type environment context loc)
      (let ((binding (car view)))
        (if (not (eq? (binding-kind binding) 'method)) view
            (let ((implementation (cdr (assq binding (instance-members instance)))))
              (let-values (((signature obligations substitutions) (instantiate (binding-scheme implementation))))
                (unify! signature type loc)
                (check-concrete-obligations obligations environment context loc)
                (list implementation substitutions))))))
    (define (unit-constructor? source)
      (and (application? source) (null? (application-operands source))
           (let ((operator (application-operator source)))
             (and (name? operator) (eq? (binding-kind (name-definition operator)) 'primitive)
                  (eq? (binding-payload (name-definition operator)) 'unit)))))

    ;; ---- Specialize immutable checking evidence ----

    (define (typed-result-type expression)
      (if (typed-conversion? expression) (typed-conversion-to expression) (typed-type expression)))
    (define (typed-source-node expression)
      (if (typed-conversion? expression) (typed-conversion-source expression) (typed-source expression)))
    (define (typed-concrete-type expression environment)
      (concrete (typed-result-type expression) environment (node-loc (typed-source-node expression))))
    (define (concrete-expression expression type detail children tail?)
      (make-concrete-expression (typed-source expression) type detail children tail?))
    (define (specialize-conversion expression environment context tail?)
      (let* ((source (typed-conversion-source expression))
             (from (concrete (typed-conversion-from expression) environment (node-loc source)))
             (to (concrete (typed-conversion-to expression) environment (node-loc source))))
        (let-values (((child context) (specialize-expression (typed-conversion-child expression) environment context
                                                             (and tail? (type-equal? from to)))))
          (values (if (type-equal? from to) child (make-concrete-conversion source from to child)) context))))
    (define (specialize-reference expression type environment context tail?)
      (let* ((source (typed-source expression)) (loc (node-loc source))
             (instance (check-concrete-obligations (typed-constraints expression) environment context loc))
             (view (resolve-reference (typed-detail expression) instance type environment context loc))
             (binding (car view)))
        (if (memq (binding-kind binding) '(primitive extern data))
            (values (concrete-expression expression type (list (binding-kind binding) (binding-payload binding)) '() tail?) context)
            (specialize-value-reference expression type binding (cadr view) environment context tail?))))
    (define (specialize-value-reference expression type binding substitutions environment context tail?)
      (let ((site (lookup-site binding environment context)))
        (if (eq? (binding-kind binding) 'parameter)
            (values (concrete-expression expression type (list 'get (car (site-instances site))) '() tail?)
                    (add-function-use context (environment-owner environment) (car (site-instances site)) #f))
            (let-values (((value context) (request-value site type substitutions environment context)))
              (values (concrete-expression expression type (list 'get (value-id value)) '() tail?)
                      (add-function-use context (environment-owner environment) (value-id value) #f))))))
    (define (specialize-lambda expression type environment context tail?)
      (let-values (((id context) (request-function (typed-source expression) type environment context
                                                   (car (typed-children expression)))))
        (values (concrete-expression expression type id '() tail?)
                (add-function-use context (environment-owner environment) id #t))))
    (define (specialize-children children environment context)
      (if (null? children) (values '() context)
          (let*-values (((first context) (specialize-expression (car children) environment context #f))
                        ((rest context) (specialize-children (cdr children) environment context)))
            (values (cons first rest) context))))
    (define (specialize-call expression type environment context tail?)
      (let ((children (typed-children expression)))
        (let*-values (((arguments context) (specialize-children (cdr children) environment context))
                      ((operator context) (specialize-expression (car children) environment context #f)))
          (values (concrete-expression expression type
                                       (substitute (typed-detail expression) (environment-substitutions environment))
                                       (cons operator arguments) tail?) context))))
    (define (specialize-binding expression environment context tail?)
      (let-values (((site context) (prepare-initializer (lookup-site (car (typed-detail expression)) environment context) environment context)))
        (let ((token (site-check site)))
          (values (concrete-expression expression 'Unit (site-id site) '() tail?)
                  (if token (add-function-use context (environment-owner environment) token #f) context)))))
    (define (typed-bindings children)
      (cond ((null? children) '())
            ((and (typed-expression? (car children)) (eq? (node-kind (typed-source (car children))) 'bind))
             (cons (car children) (typed-bindings (cdr children))))
            (else (typed-bindings (cdr children)))))
    (define (trim-typed-units children environment)
      (let trim ((remaining (reverse children)))
        (if (and (pair? remaining) (pair? (cdr remaining))
                 (unit-constructor? (typed-source-node (car remaining)))
                 (eq? (typed-concrete-type (cadr remaining) environment) 'Unit))
            (trim (cdr remaining)) (reverse remaining))))
    (define (specialize-sequence children type environment context tail?)
      (if (null? children) (values '() context)
          (let* ((last? (null? (cdr children)))
                 (from (and last? (typed-concrete-type (car children) environment)))
                 (adapt? (and last? (not (type-equal? from type)))))
            (let*-values (((first context) (specialize-expression (car children) environment context (and tail? last? (not adapt?))))
                          ((rest context) (specialize-sequence (cdr children) type environment context tail?)))
              (values (cons (if adapt? (make-concrete-conversion (typed-source-node (car children)) from type first) first) rest) context)))))
    (define (specialize-block expression type environment context tail?)
      (let* ((source (typed-source expression)) (program (compilation-program context))
             (children (typed-children expression)))
        (let*-values (((inner context) (prepare-sites source (scope-bindings-at source) environment
                                                      (eq? source (program-body program)) context (typed-bindings children)))
                      ((children context) (specialize-sequence (if tail? (trim-typed-units children inner) children) type inner context tail?)))
          (values (concrete-expression expression type
                                       (map (lambda (binding) (site-id (lookup-site binding inner context))) (scope-bindings-at source))
                                       children tail?) context))))
    (define (specialize-as expression type environment context tail?)
      (let* ((from (typed-concrete-type expression environment)) (same? (type-equal? from type)))
        (let-values (((expression context) (specialize-expression expression environment context (and tail? same?))))
          (values (if same? expression
                      (make-concrete-conversion (if (concrete-conversion? expression) (conversion-source expression) (concrete-source expression))
                                                from type expression)) context))))
    (define (specialize-conditional expression type environment context tail?)
      (let ((children (typed-children expression)))
        (let*-values (((test context) (specialize-expression (car children) environment context #f))
                      ((yes context) (specialize-as (cadr children) type environment context tail?))
                      ((no context) (if (conditional-opt-alternate (typed-source expression))
                                        (specialize-as (caddr children) type environment context tail?) (values #f context))))
          (values (concrete-expression expression type #f (list test yes no) tail?) context))))
    (define (specialize-annotation expression type environment context tail?)
      (let* ((child (car (typed-children expression))) (from (typed-concrete-type child environment)))
        (let-values (((child context) (specialize-expression child environment context (and tail? (type-equal? from type)))))
          (values (concrete-expression expression type (list from type) (list child) tail?) context))))
    (define (specialize-match-arms rows bodies subject-type result-type environment context tail?)
      (if (null? rows) (values '() context)
          (let* ((row (car rows)) (source (cadr row)) (bindings (lambda-parameters source))
                 (index (data-constructor-index (car row))) (types (data-case-fields subject-type index)))
            (let*-values (((inner context) (prepare-sites source bindings environment #f context '()))
                          ((ids context) (parameter-values bindings types inner context))
                          ((body context) (specialize-as (car bodies) result-type inner context tail?))
                          ((rest context) (specialize-match-arms (cdr rows) (cdr bodies) subject-type result-type environment context tail?)))
              (values (cons (list index ids body) rest) context)))))
    (define (specialize-match expression type environment context tail?)
      (let* ((children (typed-children expression)) (subject-type (typed-concrete-type (car children) environment)))
        (let*-values (((subject context) (specialize-expression (car children) environment context #f))
                      ((arms context) (specialize-match-arms (match-arms (typed-source expression)) (cdr children) subject-type type environment context tail?)))
          (values (concrete-expression expression type subject-type (cons subject arms) tail?) context))))
    (define (specialize-expression expression environment context tail?)
      (if (typed-conversion? expression) (specialize-conversion expression environment context tail?)
          (let ((type (typed-concrete-type expression environment)))
            (case (node-kind (typed-source expression))
              ((literal) (values (concrete-expression expression type (typed-detail expression) '() tail?) context))
              ((name instantiation) (specialize-reference expression type environment context tail?))
              ((lambda) (specialize-lambda expression type environment context tail?))
              ((call) (specialize-call expression type environment context tail?))
              ((bind) (specialize-binding expression environment context tail?))
              ((block) (specialize-block expression type environment context tail?))
              ((if) (specialize-conditional expression type environment context tail?))
              ((annotation) (specialize-annotation expression type environment context tail?))
              ((match) (specialize-match expression type environment context tail?))
              (else (strict-error (node-loc (typed-source expression)) "unsupported typed expression"))))))

    ;; ---- Function uses and queued specializations ----

    (define (add-function-use context owner value closure?)
      (if (not owner) context
          (let* ((function (context-entity context owner))
                 (reads (function-reads function)) (closures (function-closures function)))
            (context-put context owner
                         (make-function owner (function-source function) (function-type* function) (function-environment function)
                                        (function-parameters function)
                                        (if closure? reads (identity-union (list value) reads))
                                        (if closure? (identity-union (list value) closures) closures) (function-captures function) (function-expression function) (function-template function))))))
    (define (drain-requests context)
      (if (null? (compilation-pending context)) context
          (let* ((id (car (compilation-pending context))) (request (context-entity context id)) (context (pop-request context)))
            (if (function? request)
                (let-values (((expression context) (specialize-as (function-template request) (function-result (function-type* request)) (function-environment request) context #t)))
                  (drain-requests (complete-function context id expression)))
                (let-values (((expression context) (specialize-expression
                                                    (car (typed-children (site-template (context-entity context (value-site request)))))
                                                    (value-environment request) context #f)))
                  (drain-requests (context-put context id
                                               (make-value id (value-source request) (value-type request) (value-site request)
                                                           (value-environment request) #f (concrete-known-function expression) expression))))))))
    (define (free-captures function context)
      (let ((used (append (function-reads function)
                          (apply append (map (lambda (id) (function-captures (context-entity context id))) (function-closures function))))))
        (let collect ((used used) (result '()))
          (if (null? used) (list-sort < result)
              (let* ((value (context-entity context (car used))) (site (context-entity context (value-site value))))
                (collect (cdr used)
                         (if (or (site-global? site) (eqv? (environment-owner (value-environment value)) (function-index function))
                                 (memv (car used) result)) result (cons (car used) result))))))))
    (define (list-sort less? values)
      (define (insert value sorted)
        (if (or (null? sorted) (less? value (car sorted))) (cons value sorted)
            (cons (car sorted) (insert value (cdr sorted)))))
      (if (null? values) '() (insert (car values) (list-sort less? (cdr values)))))
    (define (settle-captures context)
      (let loop ((ids (compilation-definitions context)) (changed? #f) (context context))
        (if (null? ids) (if changed? (settle-captures context) context)
            (let* ((function (context-entity context (car ids))) (captures (free-captures function context)))
              (loop (cdr ids) (or changed? (not (equal? captures (function-captures function))))
                    (context-put context (car ids)
                                 (make-function (function-index function) (function-source function) (function-type* function)
                                                (function-environment function) (function-parameters function)
                                                (function-reads function) (function-closures function) captures (function-expression function) (function-template function))))))))

    ;; ---- Public scalar exports and program demand ----

    (define (check-export-names names loc)
      (unless (null? names)
        (unless (symbol? (car names)) (strict-error loc "export name must be an identifier" (car names)))
        (when (memq (car names) (cdr names)) (strict-error loc "export names must be distinct" (car names)))
        (check-export-names (cdr names) loc)))
    (define (check-export-signature type loc)
      (guard (failure (else (strict-error loc "Wasm export requires scalar parameters and a scalar or Unit result")))
        (wasm-scalar-signature (function-domains type) (function-result type))))
    (define (selected-export entry environment context)
      (let* ((binding (cdr entry)) (scheme (binding-scheme binding)) (type (scheme-type scheme))
             (site (lookup-site binding environment context)) (loc (value-definition-loc binding)))
        (unless (and (null? (scheme-variables scheme)) (function-type? type))
          (strict-error loc "entry requires a concrete function" (car entry)))
        (check-export-signature (require-concrete type loc) loc)
        (cons (car entry) (context-entity context (car (site-instances site))))))
    ;; CLI names retain their declaration requirement. The library Entry API
    ;; supplies a checked binding directly and accepts an inferred signature.
    (define (named-global-bindings name bindings)
      (cond ((null? bindings) '())
            ((eq? name (value-definition-name (car bindings)))
             (cons (car bindings) (named-global-bindings name (cdr bindings))))
            (else (named-global-bindings name (cdr bindings)))))
    (define (legacy-export-binding name program)
      (let ((loc (node-loc (program-body program)))
            (matches (named-global-bindings name (program-globals program))))
        (when (eq? name 'main) (strict-error loc "main is reserved for one-shot initialization"))
        (unless (= (length matches) 1) (strict-error loc "export requires one unambiguous top-level binding" name))
        (let* ((binding (car matches)) (scheme (binding-scheme binding)))
          (unless (and (eq? (binding-kind binding) 'value) (binding-declaration binding)
                       (null? (scheme-variables scheme)) (function-type? (scheme-type scheme)))
            (strict-error (value-definition-loc binding) "export requires an explicit concrete function declaration" name))
          (cons name binding))))
    (define (prepare-generation program . names)
      (check-export-names names (node-loc (program-body program)))
      (prepare-selected-generation program (map (lambda (name) (legacy-export-binding name program)) names)))
    (define (prepare-entry-generation program binding) (prepare-selected-generation program (list (cons 'entry binding))))
    (define (prepare-selected-generation program entries)
      (let* ((context (make-compilation (hashmap concrete-key-comparator) (hashmap (make-default-comparator)) '() '() 0 program))
             (source (program-body program))
             (environment (make-environment '() (hashmap (make-eq-comparator)) #f #f)))
        (let-values (((expression context) (specialize-expression (program-expression program) environment context #f)))
          (let* ((context (settle-captures (drain-requests context)))
                 (inner (sites-for-source source environment context))
                 (functions (map (lambda (id) (context-entity context id)) (list-sort < (compilation-definitions context))))
                 (globals (map (lambda (binding) (lookup-site binding inner context)) (scope-bindings-at source))))
            (make-prepared-program source functions globals (map (lambda (entry) (selected-export entry inner context)) entries)
                                   context (activation-value-index context) expression))))))

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-specialize)
    (import
     (lofi host test-utils)
     (only (lofi compiler infer) infer-program)
     (only (lofi compiler frontend) syntax-list->ir-library)
     (only (lofi compiler reader) string->reader)
     (only (lofi compiler syntax-parser) reader->syntax-list)
     (prefix (lofi compiler resolved-library) library:))
    (begin
      (define (test-program text)
        (let ((library (syntax-list->ir-library (reader->syntax-list (string->reader "demand.sld" text))
                                                (lambda (name) (error "unexpected import" name)) '())))
          (infer-program (library:library-body library) '() (library:library-loc library))))
      (define (test-recursive-reservation)
        (let* ((source (test-program "(def identity (lambda (x) (if #t x (identity x))))
                                     (identity #t) (identity #t) (identity (ann 42 I64))"))
               (first (prepare-generation source)) (second (prepare-generation source)))
          (expect (length (prepared-functions first)) 2)
          (expect (length (site-instances (car (prepared-globals first)))) 2)
          (expect (compilation-pending (prepared-context first)) '())
          (expect (map function-index (prepared-functions first))
                  (map function-index (prepared-functions second)))
          (expect (eq? (program-body source) (prepared-body first)) #t)))
      (define (test-concrete-lexical-captures)
        (let* ((source (test-program "(def make (lambda (x) (lambda () x)))
                                     (def integer (make 42)) (def boolean (make #t)) (integer) (boolean)"))
               (program (prepare-generation source)) (context (prepared-context program))
               (captures (apply append (map function-captures (prepared-functions program)))))
          (expect (length (prepared-functions program)) 4)
          (expect (length captures) 2)
          (expect (if (member 'I32 (map (lambda (id) (value-type (context-entity context id))) captures)) #t #f) #t)
          (expect (if (member 'Bool (map (lambda (id) (value-type (context-entity context id))) captures)) #t #f) #t)))
      (define (reference-activation-values owner context)
        (list-sort (lambda (left right) (< (value-id left) (value-id right)))
                   (hashmap-fold (lambda (id entity values)
                                   (if (and (value-binding? entity)
                                            (eqv? owner (environment-owner (value-environment entity))))
                                       (cons entity values) values)) '() (compilation-entities context))))
      (define (test-activation-partition)
        (let* ((source (test-program "(def make (lambda (x) (begin (let saved x) (lambda () saved))))
                                     (def integer (make 42)) (def boolean (make #t)) (integer) (boolean)"))
               (program (prepare-generation source)) (context (prepared-context program)))
          (expect (vector-ref (prepared-activations program) 0) (reference-activation-values #f context))
          (do ((id 0 (+ id 1))) ((= id (compilation-next context)))
            (expect (vector-ref (prepared-activations program) (+ id 1))
                    (reference-activation-values id context)))))
      (define (test-persistent-reservation)
        (let* ((context (make-compilation (hashmap concrete-key-comparator) (hashmap (make-default-comparator)) '() '() 0 #f)))
          (let-values (((id next) (reserve context '(function sample I64) #f #t)))
            (expect id 0) (expect (cached next '(function sample I64)) 0)
            (expect (compilation-pending next) '(0))
            (expect (compilation-pending context) '())
            (expect (cached context '(function sample I64)) #f)
            (expect (context-entity (context-put next id 'implementation) id) 'implementation)
            (expect (context-entity next id) #f)
            (expect (guard (failure (else #t)) (context-entity context id) #f) #t))))
      (define (test-colliding-reservations)
        (let ((context (make-compilation (hashmap (make-comparator (lambda (key) #t) request-key=? #f (lambda (key) 0)))
                                         (hashmap (make-default-comparator)) '() '() 0 #f)))
          (let*-values (((first reserved) (reserve context '(function first I64) #f #t))
                        ((second extended) (reserve reserved '(function second I64) 'second #f)))
            (let ((completed (context-put extended first 'first)))
              (expect (cached completed '(function first I64)) first)
              (expect (cached completed '(function second I64)) second)
              (expect (context-entity completed first) 'first)
              (expect (context-entity completed second) 'second)
              (expect (context-entity reserved first) #f)
              (expect (cached reserved '(function second I64)) #f)))))
      (define (test-source-request-identities)
        (let* ((body (make-literal 42 #f))
               (first (make-lambda '() body #f))
               (second (make-lambda '() body #f))
               (program (infer-program (list first second first) '() #f))
               (prepared (prepare-generation program)))
          (expect (length (prepared-functions prepared)) 2)
          (expect (eq? (function-source (car (prepared-functions prepared)))
                       (function-source (cadr (prepared-functions prepared)))) #f)))
      ;; Generated libraries may deliberately share syntax. A self-call proof
      ;; also needs the concrete binding instance, not just that shared node.
      (define (test-shared-initializer-identities)
        (let* ((first (make-value-definition 'first #f)) (second (make-value-definition 'second #f))
               (source (make-lambda '() (make-literal 42 #f) #f))
               (program (infer-program
                         (list (make-value-binding first source #f) (make-value-binding second source #f)
                               (make-application (make-name first #f) '() #f)
                               (make-application (make-name second #f) '() #f)) '() #f))
               (prepared (prepare-generation program))
               (values (site-values (prepared-globals prepared) (prepared-context prepared))))
          (expect (length values) 2)
          (expect (eq? (value-initializer (car values)) (value-initializer (cadr values))) #t)
          (expect (= (value-id (car values)) (value-id (cadr values))) #f)
          (expect (= (value-function (car values)) (value-function (cadr values))) #f)))
      (define (test-specialize)
        (run-test test-activation-partition)
        (run-test test-persistent-reservation)
        (run-test test-colliding-reservations)
        (run-test test-source-request-identities)
        (run-test test-shared-initializer-identities)
        (run-test test-recursive-reservation)
        (run-test test-concrete-lexical-captures))))
   (else)))
