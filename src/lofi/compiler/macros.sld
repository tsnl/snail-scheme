;; Declarative expansion owns lexical identity, not evaluation or type checking.
;; Pattern variables retain use-site syntax. Introduced identifiers remember the
;; definition environment and a fresh context shared only by this application.
(define-library (lofi compiler macros)
  (export expand-library-body expansion-required? finish-expansion! rebase-transformers!
          protected-reference? resolve-protected-reference core-syntax-names make-core-definition)
  (import
   (scheme base)
   (scheme cxr)
   (scheme write)
   (only (scheme hash-table) make-hash-table hash-table-ref/default hash-table-set!)
   (lofi compiler syntax)
   (lofi compiler ir)
   (lofi compiler resolved-library))
  (begin

    ;; ---- Identifier identity and definition-site references ----

    ;; A block owns one frame. Discovery can add generated definitions before
    ;; its bodies expand; transformer definition contexts retain this frame.
    (define-record-type <expansion-scope>
      (make-expansion-scope bindings index parent) expansion-scope?
      (bindings expansion-bindings replace-expansion-bindings!)
      (index expansion-index set-expansion-index!)
      (parent expansion-parent set-expansion-parent!))
    ;; The ordered list remains authoritative for discovery and diagnostics.
    ;; Name buckets retain that order and the same mutable binding objects;
    ;; context identity and namespace visibility are checked at lookup time.
    (define (binding-index bindings)
      (let ((index (make-hash-table eq?)))
        (for-each (lambda (binding)
                    (let ((name (lexical-name binding)))
                      (hash-table-set! index name (cons binding (hash-table-ref/default index name '())))))
                  (reverse bindings))
        index))
    (define (extend-environment bindings parent)
      (make-expansion-scope bindings (binding-index bindings) parent))
    (define (set-expansion-bindings! scope bindings)
      (replace-expansion-bindings! scope bindings)
      (set-expansion-index! scope (binding-index bindings)))
    (define (environment-bindings environment)
      (if environment (append (expansion-bindings environment) (environment-bindings (expansion-parent environment))) '()))
    (define-record-type <introduction>
      (make-introduction parent environment) introduction?
      (parent introduction-parent)
      (environment introduction-environment))
    (define-record-type <lexical-binding>
      (new-lexical-binding name context emitted definition transformer space loc) lexical-binding?
      (name lexical-name)
      (context lexical-context)
      (emitted lexical-emitted set-lexical-emitted!)
      (definition lexical-definition set-lexical-definition!)
      (transformer lexical-transformer set-lexical-transformer!)
      (space lexical-space set-lexical-space!)
      (loc lexical-loc))
    (define (make-lexical-binding name context emitted definition transformer)
      (new-lexical-binding name context emitted definition transformer 'term #f))
    (define current-namespace (make-parameter 'term))
    (define (visible-binding? binding)
      (if (eq? (current-namespace) 'term) (not (eq? (lexical-space binding) 'type))
          (or (memq (lexical-space binding) '(type static))
              (and (lexical-definition binding)
                   (memq (binding-kind (lexical-definition binding)) '(datatype typeclass instance overload syntax syntax-form))))))
    (define-record-type <protected-reference>
      (make-protected-reference definition name loc) protected-reference?
      (definition protected-definition)
      (name protected-name)
      (loc protected-loc))
    (define (resolve-protected-reference reference)
      (or (protected-definition reference)
          (error "unbound definition-site identifier" (protected-loc reference) (protected-name reference))))
    (define-record-type <transformer>
      (make-transformer rules environment) transformer?
      (rules transformer-rules)
      (environment transformer-environment))
    (define core-syntax-names
      '(def lambda if let begin library-begin ann inst match data deriving datatype typeclass instance
            identifier-name library-name type-name
            define-overload define-extern syntax-rules define-syntax
            : All requires -> Ref List Vector Rest
            I32 I64 F32 F64 Bool Char Unit Any Never String Bytevector))
    (define (make-core-definition name loc)
      (let ((definition (make-value-definition name loc)))
        (prepare-binding! definition #f #f 'syntax-form name) definition))
    (define next-name (make-parameter 0))
    (define (fresh-name name)
      (next-name (+ (next-name) 1))
      (string->symbol (string-append "#%lofi:" (number->string (next-name)) ":" (symbol->string name))))
    (define (fail form message . details) (apply error message (syntax-loc form) details))
    (define (identifier? form name)
      (and (syntax-identifier? form) (eq? (atom-syntax-value form) name)))
    (define (head form)
      (and (list-syntax? form) (pair? (list-syntax-elements form))
           (car (list-syntax-elements form))))
    (define (headed? form name) (and (head form) (identifier? (head form) name)))
    (define (parts form)
      (unless (and (list-syntax? form) (null? (list-syntax-improper-tail form)))
        (fail form "expected a proper expansion form"))
      (list-syntax-elements form))
    (define (local-binding name context bindings)
      (cond ((null? bindings) #f)
            ((and (eq? name (lexical-name (car bindings))) (eq? context (lexical-context (car bindings))) (visible-binding? (car bindings))) (car bindings))
            (else (local-binding name context (cdr bindings)))))
    (define (find-binding name context environment)
      (let find ((scope environment))
        (if scope (or (scope-binding name context scope) (find (expansion-parent scope)))
            (and (introduction? context) (find-binding name (introduction-parent context) (introduction-environment context))))))
    (define (scope-binding name context scope)
      (local-binding name context (hash-table-ref/default (expansion-index scope) name '())))
    (define (lookup identifier environment)
      (find-binding (atom-syntax-value identifier) (atom-syntax-context identifier) environment))
    (define (binding-identity identifier environment)
      (let ((binding (lookup identifier environment)))
        (cond ((not binding) (atom-syntax-value identifier))
              ((and (lexical-definition binding) (eq? (binding-kind (lexical-definition binding)) 'syntax-form))
               (binding-payload (lexical-definition binding)))
              ((lexical-definition binding) (binding-origin (lexical-definition binding)))
              (else binding))))
    (define discovery-reads (make-parameter #f))
    (define-record-type <literal-comparison>
      (make-literal-comparison left right left-environment right-environment matched?) literal-comparison?
      (left comparison-left)
      (right comparison-right)
      (left-environment comparison-left-environment)
      (right-environment comparison-right-environment)
      (matched? comparison-matched?))
    (define (observe-identifier identifier environment)
      (let ((identity (binding-identity identifier environment)) (reads (discovery-reads)))
        (when reads (set-car! reads (cons (list identifier environment identity) (car reads)))) identity))
    ;; Dispatch commits a binding. Literal matching commits only equality:
    ;; newly generated names may remain unequal to the same pattern literal.
    (define (discovery-read-stable? read)
      (if (literal-comparison? read)
          (eq? (comparison-matched? read)
               (eq? (binding-identity (comparison-left read) (comparison-left-environment read))
                    (binding-identity (comparison-right read) (comparison-right-environment read))))
          (eq? (caddr read) (binding-identity (car read) (cadr read)))))
    (define (check-discovery-reads reads)
      (for-each (lambda (read)
                  (unless (discovery-read-stable? read)
                    (fail (if (literal-comparison? read) (comparison-right read) (car read))
                          "generated binding changes an earlier macro decision; use a direct definition"))) reads))
    (define (same-identifier? left right left-environment right-environment)
      (and (syntax-identifier? right)
           (let ((matched? (eq? (binding-identity left left-environment) (binding-identity right right-environment)))
                 (reads (discovery-reads)))
             (when reads
               (set-car! reads (cons (make-literal-comparison left right left-environment right-environment matched?) (car reads))))
             matched?)))
    (define (emit-identifier form environment)
      (let* ((binding (lookup form environment)) (definition (and binding (lexical-definition binding))))
        (cond ((not binding)
               (if (introduction? (atom-syntax-context form))
                   (make-identifier-syntax (atom-syntax-value form) (syntax-loc form) 'generated
                                           (make-protected-reference #f (atom-syntax-value form) (syntax-loc form))) form))
              ((and definition (eq? (binding-kind definition) 'syntax-form))
               (make-atom-syntax (binding-payload definition) (syntax-loc form)))
              ((lexical-transformer binding) (fail form "transformer is not a runtime value"))
              (else (make-identifier-syntax (lexical-emitted binding) (syntax-loc form) 'generated
                                            (and definition (make-protected-reference definition (atom-syntax-value form) (syntax-loc form)))
                                            (atom-syntax-source-name form))))))
    (define (reserve form)
      (unless (syntax-identifier? form) (fail form "expected a binding identifier"))
      (let ((text (symbol->string (atom-syntax-value form))))
        (when (and (>= (string-length text) 7) (string=? (substring text 0 7) "#%lofi:")
                   (not (eq? (atom-syntax-context form) 'generated)))
          (fail form "reserved expansion identifier")))
      (new-lexical-binding (atom-syntax-value form) (atom-syntax-context form)
                           (fresh-name (atom-syntax-value form)) #f #f 'term (syntax-loc form)))
    (define (emit-binder form binding)
      (make-identifier-syntax (lexical-emitted binding) (syntax-loc form) 'generated #f (atom-syntax-source-name form)))
    (define (imported-binding entry)
      (let ((definition (named-binding-definition entry)))
        (make-lexical-binding (named-binding-name entry) #f (named-binding-name entry) definition
                              (and (eq? (binding-kind definition) 'syntax) (binding-payload definition)))))
    (define (import-environment imports)
      (apply append (map (lambda (declaration) (map imported-binding (import-declaration-bindings declaration))) imports)))
    (define (core-environment)
      (map (lambda (name) (make-lexical-binding name #f name (make-core-definition name #f) #f)) core-syntax-names))
    (define (form-kind form environment)
      (let* ((operator (head form)) (binding (and operator (syntax-identifier? operator) (lookup operator environment)))
             (definition (and binding (lexical-definition binding))))
        (and (not (derivation-invocation? form)) definition
             (eq? (binding-kind definition) 'syntax-form) (binding-payload definition))))

    ;; ---- Library declarations introduce complete binding groups ----

    (define (library-declaration? form environment)
      (let ((kind (form-kind form environment)) (items (and (list-syntax? form) (parts form))))
        (or (eq? kind 'data)
            (and (memq kind '(typeclass instance)) (pair? (cdr items))
                 (syntax-identifier? (cadr items))))))
    (define (intrinsic-identifier name source)
      (let ((scope (extend-environment (core-environment) #f)))
        (make-identifier-syntax name (syntax-loc source) (make-introduction #f scope) #f)))
    (define-record-type <derivation>
      (make-derivation declaration keyword targets) derivation?
      (declaration derivation-declaration)
      (keyword derivation-keyword)
      (targets derivation-targets))
    (define (deriving-clause? form environment)
      (or (eq? (form-kind form environment) 'deriving)
          (and (syntax-identifier? form) (eq? (binding-identity form environment) 'deriving))))
    (define (split-deriving-rows rows environment)
      (if (null? rows) (values '() #f)
          (let-values (((rest clause) (split-deriving-rows (cdr rows) environment)))
            (if (not (deriving-clause? (car rows) environment)) (values (cons (car rows) rest) clause)
                (begin
                  (when clause (fail (car rows) "duplicate deriving clause"))
                  (unless (null? (cdr rows)) (fail (car rows) "deriving clause must be last"))
                  (values '() (car rows)))))))
    (define (parse-deriving-targets clause)
      (unless (and (list-syntax? clause) (null? (list-syntax-improper-tail clause)))
        (fail clause "deriving requires a proper list of transformer identifiers"))
      (let ((targets (cdr (list-syntax-elements clause))))
        (for-each (lambda (target)
                    (unless (syntax-identifier? target) (fail target "deriving target must be a transformer identifier"))) targets)
        targets))
    (define (parse-data-derivation form environment)
      (let ((items (parts form)))
        (when (< (length items) 3) (fail form "declaration requires a name and parameter list"))
        (let-values (((rows clause) (split-deriving-rows (cdddr items) environment)))
          (if clause
              (make-derivation (rebuild form (append (list (car items) (cadr items) (caddr items)) rows))
                               (or (head clause) clause) (parse-deriving-targets clause))
              (make-derivation form #f '())))))
    ;; Normalize only declarations; never reinterpret an expression as a group.
    ;; Protected intrinsic heads cannot capture a use-site alias or local name.
    (define (normalize-declaration form environment)
      (if (not (library-declaration? form environment)) form
          (let* ((kind (form-kind form environment))
                 (items (parts (if (eq? kind 'data) (derivation-declaration (parse-data-derivation form environment)) form)))
                 (former (if (eq? kind 'data) 'datatype kind)))
            (when (< (length items) 3) (fail form "declaration requires a name and parameter list or instance head"))
            (rebuild form (list (intrinsic-identifier 'def form) (cadr items)
                                (rebuild form (cons (intrinsic-identifier former form) (cddr items))))))))
    ;; Targets may be macros generated by siblings. Ordinary discovery expands
    ;; their applications; only the completed group can reject nonmacro targets.
    (define pending-derivations (make-parameter #f))
    ;; Until their macro bindings exist these remain applications, even when a
    ;; target currently names core syntax such as begin or a declaration form.
    (define (derivation-invocation? form)
      (let ((pending (pending-derivations)))
        (and pending (assq form (car pending)))))
    (define (derivation-invocation derivation target)
      (let* ((pending (pending-derivations)) (declaration (derivation-declaration derivation))
             (invocation (make-list-syntax (list target declaration) '() (syntax-loc target))))
        (set-car! pending (cons (cons invocation target) (car pending))) invocation))
    (define (expand-derivation derivation environment)
      (let ((declaration (derivation-declaration derivation)))
        (observe-identifier (derivation-keyword derivation) environment)
        (rebuild declaration
                 (cons (intrinsic-identifier 'library-begin declaration)
                       (cons declaration (map (lambda (target) (derivation-invocation derivation target))
                                              (derivation-targets derivation)))))))
    (define (expand-library-declaration form environment)
      (if (not (eq? (form-kind form environment) 'data)) (normalize-declaration form environment)
          (let ((derivation (parse-data-derivation form environment)))
            (if (derivation-keyword derivation) (expand-derivation derivation environment)
                (normalize-declaration form environment)))))
    (define (check-derivation-targets invocations environment)
      (for-each (lambda (invocation)
                  (let* ((target (cdr invocation)) (binding (lookup target environment)))
                    (unless (and binding (lexical-transformer binding))
                      (fail target "deriving target must name a macro transformer")))) (reverse invocations)))

    ;; ---- Patterns establish variable depths before matching ----

    ;; Patterns are tagged trees; each variable is unique in a rule. Repetition
    ;; retains its variable list so zero matches still produces empty captures.
    (define-record-type <rule>
      (make-rule pattern variables template) rule?
      (pattern rule-pattern)
      (variables rule-variables)
      (template rule-template))
    (define (pattern-variables pattern)
      (case (car pattern)
        ((variable) (list (cadr pattern)))
        ((sequence) (append (apply append (map pattern-variables (cadr pattern))) (pattern-variables (caddr pattern))))
        ((repeat vector) (pattern-variables (cadr pattern)))
        (else '())))
    (define (pattern-sequence elements tail literals depth)
      (cond ((null? elements) (list 'sequence '() tail))
            ((and (pair? (cdr elements)) (identifier? (cadr elements) '...))
             (list 'sequence (cons (list 'repeat (parse-pattern (car elements) literals (+ depth 1)))
                                   (cadr (pattern-sequence (cddr elements) tail literals depth))) tail))
            (else (list 'sequence (cons (parse-pattern (car elements) literals depth)
                                        (cadr (pattern-sequence (cdr elements) tail literals depth))) tail))))
    (define (parse-pattern form literals depth)
      (cond ((identifier? form '_) '(wildcard))
            ((identifier? form '...) (fail form "misplaced pattern ellipsis"))
            ((syntax-identifier? form)
             (if (memq (atom-syntax-value form) (map atom-syntax-value literals)) (list 'identifier form)
                 (list 'variable (cons (atom-syntax-value form) depth))))
            ((list-syntax? form)
             (pattern-sequence (list-syntax-elements form)
                               (if (null? (list-syntax-improper-tail form)) '(datum ())
                                   (parse-pattern (list-syntax-improper-tail form) literals depth)) literals depth))
            ((vector-syntax? form)
             (list 'vector (pattern-sequence (vector-syntax-elements form) '(datum ()) literals depth)))
            (else (list 'datum (syntax->datum form)))))
    (define (parse-rule-pattern form literals)
      (pattern-sequence (cdr (list-syntax-elements form))
                        (if (null? (list-syntax-improper-tail form)) '(datum ())
                            (parse-pattern (list-syntax-improper-tail form) literals 0)) literals 0))
    (define (check-pattern-variables variables form)
      (unless (null? variables)
        (when (assq (caar variables) (cdr variables)) (fail form "duplicate pattern variable" (caar variables)))
        (check-pattern-variables (cdr variables) form)))
    (define (parse-rule form literals)
      (let* ((row (parts form)) (pattern-form (and (= (length row) 2) (car row))))
        (unless (and pattern-form (head pattern-form) (syntax-identifier? (head pattern-form)))
          (fail form "syntax-rules requires a pattern and template"))
        (let* ((pattern (parse-rule-pattern pattern-form literals)) (variables (pattern-variables pattern)))
          (check-pattern-variables variables form)
          (check-template (cadr row) variables 0)
          (make-rule pattern variables (cadr row)))))
    (define (template-drivers form variables depth)
      (let select ((variables (template-variables form variables)))
        (cond ((null? variables) '())
              ((> (cdar variables) depth) (cons (car variables) (select (cdr variables))))
              (else (select (cdr variables))))))
    (define (check-template-sequence elements variables depth)
      (unless (null? elements)
        (if (and (pair? (cdr elements)) (identifier? (cadr elements) '...))
            (begin
              (when (null? (template-drivers (car elements) variables depth))
                (fail (car elements) "template ellipsis has no repeated variable"))
              (check-template (car elements) variables (+ depth 1))
              (check-template-sequence (cddr elements) variables depth))
            (begin (check-template (car elements) variables depth)
                   (check-template-sequence (cdr elements) variables depth)))))
    (define (check-template form variables depth)
      (cond ((syntax-identifier? form)
             (let ((variable (assq (atom-syntax-value form) variables)))
               (when (and variable (> (cdr variable) depth)) (fail form "pattern variable used at wrong ellipsis depth"))
               (when (identifier? form '...) (fail form "misplaced template ellipsis"))))
            ((list-syntax? form)
             (check-template-sequence (list-syntax-elements form) variables depth)
             (unless (null? (list-syntax-improper-tail form)) (check-template (list-syntax-improper-tail form) variables depth)))
            ((vector-syntax? form) (check-template-sequence (vector-syntax-elements form) variables depth))))
    (define (parse-transformer form environment)
      (let* ((items (parts form)) (literals (and (pair? (cdr items)) (parts (cadr items)))))
        (unless (and (eq? (form-kind form environment) 'syntax-rules) (pair? (cddr items)))
          (fail form "expected syntax-rules literals and at least one rule"))
        (for-each (lambda (literal)
                    (unless (and (syntax-identifier? literal) (not (identifier? literal '...)))
                      (fail literal "expected a literal identifier"))) literals)
        (make-transformer (map (lambda (rule) (parse-rule rule literals)) (cddr items)) (extend-environment '() environment))))

    ;; ---- Structural matching, including empty and nested repetitions ----

    (define (syntax-tail elements tail loc)
      (if (null? elements) (if (null? tail) (make-list-syntax '() '() loc) tail)
          (make-list-syntax elements tail loc)))
    (define (syntax-spine form)
      (let ((tail (list-syntax-improper-tail form)))
        (if (list-syntax? tail)
            (let-values (((elements rest) (syntax-spine tail)))
              (values (append (list-syntax-elements form) elements) rest))
            (values (list-syntax-elements form) tail))))
    (define (match-pattern pattern form definition-environment use-environment)
      (case (car pattern)
        ((wildcard) '())
        ((variable) (list (cons (caadr pattern) form)))
        ((identifier) (and (same-identifier? (cadr pattern) form definition-environment use-environment) '()))
        ((datum) (and (equal? (cadr pattern) (syntax->datum form)) '()))
        ((vector) (and (vector-syntax? form)
                       (match-pattern (cadr pattern) (make-list-syntax (vector-syntax-elements form) '() (syntax-loc form))
                                      definition-environment use-environment)))
        ((sequence) (and (list-syntax? form)
                         (let-values (((elements tail) (syntax-spine form)))
                           (match-sequence (cadr pattern) (caddr pattern) elements tail (syntax-loc form)
                                           definition-environment use-environment))))))
    (define (collect-repetitions pattern rows)
      (map (lambda (variable) (cons (car variable) (map (lambda (row) (cdr (assq (car variable) row))) rows)))
           (pattern-variables pattern)))
    (define (match-repeated pattern rest tail elements improper loc definition-environment use-environment)
      (let try ((remaining elements) (rows '()))
        (let ((suffix (match-sequence rest tail remaining improper loc definition-environment use-environment)))
          (if suffix (append (collect-repetitions pattern (reverse rows)) suffix)
              (and (pair? remaining)
                   (let ((row (match-pattern pattern (car remaining) definition-environment use-environment)))
                     (and row (try (cdr remaining) (cons row rows)))))))))
    (define (match-sequence patterns tail elements improper loc definition-environment use-environment)
      (cond ((null? patterns) (match-pattern tail (syntax-tail elements improper loc) definition-environment use-environment))
            ((eq? (caar patterns) 'repeat)
             (match-repeated (cadar patterns) (cdr patterns) tail elements improper loc definition-environment use-environment))
            ((null? elements) #f)
            (else (let ((first (match-pattern (car patterns) (car elements) definition-environment use-environment)))
                    (and first (let ((rest (match-sequence (cdr patterns) tail (cdr elements) improper loc
                                                           definition-environment use-environment)))
                                 (and rest (append first rest))))))))

    ;; ---- Templates preserve arguments and introduce fresh lexical contexts ----

    (define (take-path path count)
      (if (zero? count) '() (cons (car path) (take-path (cdr path) (- count 1)))))
    (define (capture-at capture path)
      (if (null? path) capture (capture-at (list-ref capture (car path)) (cdr path))))
    (define (template-variables form variables)
      (cond ((syntax-identifier? form) (let ((entry (assq (atom-syntax-value form) variables))) (if entry (list entry) '())))
            ((list-syntax? form)
             (append (apply append (map (lambda (item) (template-variables item variables)) (list-syntax-elements form)))
                     (if (null? (list-syntax-improper-tail form)) '() (template-variables (list-syntax-improper-tail form) variables))))
            ((vector-syntax? form) (apply append (map (lambda (item) (template-variables item variables)) (vector-syntax-elements form))))
            (else '())))
    (define (repetition-length form variables captures path)
      (let collect ((variables (template-variables form variables)) (count #f))
        (cond ((null? variables) (or count (fail form "template ellipsis has no repeated variable")))
              ((<= (cdar variables) (length path)) (collect (cdr variables) count))
              (else (let ((size (length (capture-at (cdr (assq (caar variables) captures)) path))))
                      (when (and count (not (= count size))) (fail form "incompatible template repetition lengths"))
                      (collect (cdr variables) size))))))
    (define (introduce form contexts environment)
      (let* ((parent (atom-syntax-context form)) (known (assq parent (car contexts)))
             (context (if known (cdr known) (make-introduction parent environment))))
        (unless known (set-car! contexts (cons (cons parent context) (car contexts))))
        (make-identifier-syntax (atom-syntax-value form) (syntax-loc form) context #f)))
    (define (instantiate-sequence elements variables captures path contexts environment)
      (cond ((null? elements) '())
            ((and (pair? (cdr elements)) (identifier? (cadr elements) '...))
             (let repeat ((index 0) (count (repetition-length (car elements) variables captures path)))
               (if (= index count) (instantiate-sequence (cddr elements) variables captures path contexts environment)
                   (cons (instantiate (car elements) variables captures (append path (list index)) contexts environment)
                         (repeat (+ index 1) count)))))
            (else (cons (instantiate (car elements) variables captures path contexts environment)
                        (instantiate-sequence (cdr elements) variables captures path contexts environment)))))
    (define (instantiate-list form variables captures path contexts environment)
      (let* ((elements (instantiate-sequence (list-syntax-elements form) variables captures path contexts environment))
             (tail (if (null? (list-syntax-improper-tail form)) '()
                       (instantiate (list-syntax-improper-tail form) variables captures path contexts environment))))
        (if (list-syntax? tail)
            (let-values (((suffix improper) (syntax-spine tail)))
              (make-list-syntax (append elements suffix) improper (syntax-loc form)))
            (make-list-syntax elements tail (syntax-loc form)))))
    (define (instantiate form variables captures path contexts environment)
      (cond ((syntax-identifier? form)
             (let ((variable (assq (atom-syntax-value form) variables)))
               (cond (variable
                      (unless (<= (cdr variable) (length path)) (fail form "pattern variable used at wrong ellipsis depth"))
                      (capture-at (cdr (assq (car variable) captures)) (take-path path (cdr variable))))
                     ((identifier? form '...) (fail form "misplaced template ellipsis"))
                     (else (introduce form contexts environment)))))
            ((list-syntax? form) (instantiate-list form variables captures path contexts environment))
            ((vector-syntax? form)
             (make-vector-syntax (instantiate-sequence (vector-syntax-elements form) variables captures path contexts environment)
                                 (syntax-loc form)))
            (else form)))
    (define (apply-transformer transformer form environment)
      (let ((arguments (make-list-syntax (cdr (list-syntax-elements form)) (list-syntax-improper-tail form) (syntax-loc form))))
        (let choose ((rules (transformer-rules transformer)))
          (when (null? rules) (fail form "no syntax-rules pattern matched"))
          (let* ((rule (car rules))
                 (captures (match-pattern (rule-pattern rule) arguments (transformer-environment transformer) environment)))
            (if captures (instantiate (rule-template rule) (rule-variables rule) captures '() (list '())
                                      (transformer-environment transformer))
                (choose (cdr rules)))))))

    ;; ---- Expansion follows the core's lexical scopes ----

    (define expansion-budget (make-parameter 10000))
    (define (expand-head form environment)
      (let* ((operator (head form)) (binding (and operator (syntax-identifier? operator) (lookup operator environment)))
             (transformer (and binding (lexical-transformer binding))))
        (if (not transformer) form
            (begin
              (when (zero? (expansion-budget)) (fail form "macro expansion limit exceeded"))
              (expansion-budget (- (expansion-budget) 1))
              (observe-identifier operator environment)
              (expand-head (apply-transformer transformer form environment) environment)))))
    (define (macro-definition? form . environments)
      (let ((kind (if (null? environments)
                      (and (head form) (syntax-identifier? (head form)) (atom-syntax-value (head form)))
                      (form-kind form (car environments)))))
        (or (eq? kind 'define-syntax)
            (and (eq? kind 'def) (= (length (parts form)) 3)
                 (if (null? environments) (headed? (caddr (parts form)) 'syntax-rules)
                     (eq? (form-kind (caddr (parts form)) (car environments)) 'syntax-rules))))))
    (define (contains-expansion-form? form)
      (or (macro-definition? form) (memq (and (head form) (atom-syntax? (head form)) (atom-syntax-value (head form)))
                                         '(identifier-name library-name type-name))
          (and (list-syntax? form) (let scan ((forms (list-syntax-elements form)))
                                     (and (pair? forms) (or (contains-expansion-form? (car forms)) (scan (cdr forms))))))))
    ;; Declaration groups and named declarations require expansion only at
    ;; library scope. Nested begin and wrapped typeclass/instance are kernel forms.
    (define (declaration-expansion-form? form)
      (or (memq (and (head form) (atom-syntax? (head form)) (atom-syntax-value (head form)))
                '(begin library-begin data typeclass instance))
          (contains-expansion-form? form)))
    (define (expansion-required? forms imports)
      (or (let scan ((forms forms)) (and (pair? forms) (or (declaration-expansion-form? (car forms)) (scan (cdr forms)))))
          (let scan ((bindings (import-environment imports)))
            (and (pair? bindings) (or (lexical-transformer (car bindings))
                                      (and (lexical-definition (car bindings))
                                           (eq? (binding-kind (lexical-definition (car bindings))) 'syntax-form)
                                           (not (eq? (lexical-name (car bindings)) (binding-payload (lexical-definition (car bindings))))))
                                      (scan (cdr bindings)))))))
    (define (definition-names source environment)
      (let ((form (normalize-declaration source environment)))
        (case (form-kind form environment)
          ((define-syntax) (list (cadr (parts form))))
          ((def define-extern define-overload)
           (let* ((items (parts form)) (body (car (reverse items))))
             (cond ((eq? (form-kind body environment) 'datatype)
                    (cons (cadr items) (apply append (map (lambda (row)
                                                            (cons (car (parts row)) (apply append (map (lambda (field)
                                                                                                         (if (= (length (parts field)) 3) (list (caddr (parts field))) '()))
                                                                                                       (cdr (parts row)))))) (cddr (parts body))))))
                   ((eq? (form-kind body environment) 'typeclass) (cons (cadr items) (map (lambda (row) (cadr (parts row))) (cddr (parts body)))))
                   (else (list (cadr items))))))
          (else '()))))
    (define (reserve-declaration name form environment primary?)
      (let* ((binding (reserve name)) (kind (form-kind form environment))
             (imported (and (eq? kind 'define-overload) (lookup name environment))))
        (when (or (eq? kind 'define-overload)
                  (and primary? (or (library-declaration? form environment)
                                    (memq (form-kind (car (reverse (parts form))) environment) '(datatype typeclass instance)))))
          (set-lexical-space! binding 'static))
        ;; Preserve the imported family name so ordinary resolution joins the
        ;; extension to its canonical overload binding after expansion.
        (when (and imported (lexical-definition imported) (eq? (binding-kind (lexical-definition imported)) 'overload))
          (set-lexical-emitted! binding (lexical-emitted imported))) binding))
    (define (reserve-definitions forms environment)
      (let scan ((forms forms) (bindings '()))
        (if (null? forms) bindings
            (let ((names (definition-names (car forms) environment)))
              (for-each (lambda (name)
                          (let ((old (local-binding (atom-syntax-value name) (atom-syntax-context name) bindings)))
                            (when (and old (not (eq? (form-kind (car forms) environment) 'define-overload))) (fail name "duplicate binding"))
                            (unless old (set! bindings (cons (reserve-declaration name (car forms) environment (eq? name (car names))) bindings))))) names)
              (scan (cdr forms) bindings)))))
    (define (install-transformers! forms environment)
      (for-each (lambda (form)
                  (when (macro-definition? form environment)
                    (let* ((items (parts form)) (binding (lookup (cadr items) environment)))
                      (unless (= (length items) 3) (fail form "macro definition requires a name and syntax-rules"))
                      (if (lexical-transformer binding)
                          (set-expansion-parent! (transformer-environment (lexical-transformer binding)) environment)
                          (set-lexical-transformer! binding (parse-transformer (caddr items) environment)))))) forms))
    (define (rebuild form elements)
      (make-list-syntax elements (list-syntax-improper-tail form) (syntax-loc form)))
    (define (emit-tree form environment)
      (cond ((syntax-identifier? form) (emit-identifier form environment))
            ((list-syntax? form)
             (make-list-syntax (map (lambda (item) (emit-tree item environment)) (list-syntax-elements form))
                               (if (null? (list-syntax-improper-tail form)) '() (emit-tree (list-syntax-improper-tail form) environment))
                               (syntax-loc form)))
            ((vector-syntax? form) (make-vector-syntax (map (lambda (item) (emit-tree item environment)) (vector-syntax-elements form)) (syntax-loc form)))
            (else form)))
    (define (expand-lambda form environment)
      (let* ((items (parts form)) (parameters (cadr items))
             (names (if (list-syntax? parameters) (append (list-syntax-elements parameters)
                                                          (if (null? (list-syntax-improper-tail parameters)) '() (list (list-syntax-improper-tail parameters))))
                        (list parameters)))
             (bindings (map reserve names)) (scope (extend-environment bindings environment)))
        (unless (= (length items) 3) (fail form "core lambda requires parameters and one body"))
        (rebuild form (list (emit-identifier (car items) environment) (emit-tree parameters scope)
                            (expand-expression (caddr items) scope)))))
    (define (expand-expression form environment)
      (let ((form (expand-head form environment)))
        (cond ((syntax-identifier? form) (emit-identifier form environment))
              ((not (list-syntax? form)) form)
              ((library-declaration? form environment) (fail form "declarations require library scope"))
              (else (case (form-kind form environment)
                      ((lambda) (expand-lambda form environment))
                      ((begin) (let-values (((body scope) (expand-body (cdr (parts form)) environment #f)))
                                 (rebuild form (cons (emit-identifier (head form) environment) body))))
                      ((library-begin) (fail form "library-begin is only allowed in a library body"))
                      ((identifier-name) (expand-identifier-name form))
                      ((library-name) (expand-library-name form))
                      ((type-name) (expand-type-name form environment))
                      ((All) (let-values (((signature scope) (expand-all form environment))) signature))
                      ((datatype typeclass) (expand-quantified form environment))
                      ((instance) (expand-instance form environment))
                      ((ann inst) (expand-annotation form environment))
                      ((match) (expand-match form environment))
                      (else (rebuild form (map (lambda (item) (expand-expression item environment)) (parts form)))))))))
    (define current-library-name (make-parameter #f))
    (define current-library-types (make-parameter '()))
    (define claimed-type-names (make-parameter '()))
    (define (library-name-text)
      (let ((port (open-output-string)))
        (write (current-library-name) port)
        (get-output-string port)))
    (define (expand-identifier-name form)
      (let ((items (parts form)))
        (unless (and (= (length items) 2) (syntax-identifier? (cadr items)))
          (fail form "identifier-name requires one identifier"))
        (make-atom-syntax (symbol->string (atom-syntax-source-name (cadr items))) (syntax-loc form))))
    (define (expand-library-name form)
      (unless (= (length (parts form)) 1) (fail form "library-name takes no arguments"))
      (make-atom-syntax (library-name-text) (syntax-loc form)))
    ;; Discovery establishes datatype identity before metadata is expanded.
    ;; Only declarations owned by this library have a portable owner here.
    (define (local-datatype-name form environment)
      (and (eq? (form-kind form environment) 'def)
           (eq? (form-kind (car (reverse (parts form))) environment) 'datatype)
           (let ((name (cadr (parts form))))
             (cons (lookup name environment)
                   (string-append (library-name-text) ":" (symbol->string (atom-syntax-source-name name)))))))
    (define (library-type-names forms environment)
      (if (null? forms) '()
          (let ((entry (local-datatype-name (car forms) environment))
                (rest (library-type-names (cdr forms) environment)))
            (if entry (cons entry rest) rest))))
    (define (claim-type-name! entry source)
      (let* ((binding (car entry)) (name (cdr entry)) (claimed (assoc name (claimed-type-names))))
        (when (and claimed (not (eq? binding (cdr claimed))))
          (fail source "type-name collision between distinct local datatypes" name))
        (unless claimed (claimed-type-names (cons (cons name binding) (claimed-type-names))))))
    (define (expand-type-name form environment)
      (let ((items (parts form)))
        (unless (and (= (length items) 2) (syntax-identifier? (cadr items)))
          (fail form "type-name requires one datatype identifier"))
        (let* ((binding (parameterize ((current-namespace 'type)) (lookup (cadr items) environment)))
               (entry (and binding (assq binding (current-library-types)))))
          (unless entry (fail (cadr items) "type-name requires a datatype declared in the current library"))
          (claim-type-name! entry (cadr items))
          (make-atom-syntax (cdr entry) (syntax-loc form)))))
    (define (type-scope parameters environment)
      (extend-environment (map (lambda (name)
                                 (let ((binding (reserve name))) (set-lexical-space! binding 'type) binding)) parameters) environment))
    (define (emit-type form environment)
      (parameterize ((current-namespace 'type)) (expand-expression form environment)))
    (define (expand-all form environment)
      (let* ((items (parts form)) (scope (type-scope (parts (cadr items)) environment)))
        (values (parameterize ((current-namespace 'type))
                  (rebuild form (cons (emit-identifier (car items) scope)
                                      (cons (emit-tree (cadr items) scope)
                                            (map (lambda (item) (emit-type item scope)) (cddr items)))))) scope)))
    (define (expand-data-field field environment)
      (let ((items (parts field)))
        (rebuild field (cons (car items) (cons (emit-type (cadr items) environment)
                                               (map (lambda (item) (emit-identifier item environment)) (cddr items)))))))
    (define (expand-data-row row environment)
      (let ((items (parts row)))
        (rebuild row (cons (emit-identifier (car items) environment)
                           (map (lambda (field) (expand-data-field field environment)) (cdr items))))))
    (define (expand-class-row row environment)
      (let ((items (parts row)))
        (rebuild row (list (emit-identifier (car items) environment) (emit-identifier (cadr items) environment)
                           (emit-type (caddr items) environment)))))
    (define (expand-quantified form environment)
      (let* ((items (parts form)) (scope (type-scope (parts (cadr items)) environment))
             (data? (eq? (form-kind form environment) 'datatype)))
        (rebuild form (cons (emit-identifier (car items) environment)
                            (cons (parameterize ((current-namespace 'type)) (emit-tree (cadr items) scope))
                                  (map (lambda (item) (if data? (expand-data-row item scope) (expand-class-row item scope)))
                                       (cddr items)))))))
    (define (expand-instance form environment)
      (let ((items (parts form)))
        (rebuild form (cons (emit-identifier (car items) environment)
                            (cons (emit-type (cadr items) environment)
                                  (map (lambda (row)
                                         (rebuild row (list (emit-identifier (car (parts row)) environment)
                                                            (expand-expression (cadr (parts row)) environment)))) (cddr items)))))))
    (define (expand-annotation form environment)
      (let ((items (parts form)))
        (rebuild form (cons (emit-identifier (car items) environment)
                            (cons (expand-expression (cadr items) environment)
                                  (map (lambda (item) (emit-type item environment)) (cddr items)))))))
    (define (expand-match form environment)
      (let ((items (parts form)))
        (rebuild form (cons (emit-identifier (car items) environment)
                            (cons (expand-expression (cadr items) environment)
                                  (map (lambda (arm) (expand-arm arm environment)) (cddr items)))))))
    (define (expand-arm arm environment)
      (let ((items (parts arm)))
        (unless (= (length items) 2) (fail arm "match arm requires a pattern and one body expression"))
        (let* ((pattern (parts (car items))) (scope (extend-environment (map reserve (cdr pattern)) environment)))
          (rebuild arm (list (rebuild (car items) (cons (emit-identifier (car pattern) environment)
                                                        (map (lambda (name) (emit-identifier name scope)) (cdr pattern))))
                             (expand-expression (cadr items) scope))))))
    (define (expand-initializer-tail items environment)
      (cond ((= (length items) 1) (list (expand-expression (car items) environment)))
            ((eq? (form-kind (car items) environment) 'All)
             (let-values (((signature scope) (expand-all (car items) environment)))
               (list signature (expand-expression (cadr items) scope))))
            (else (list (emit-type (car items) environment) (expand-expression (cadr items) environment)))))
    (define (expand-definition form environment)
      (let* ((items (parts form)) (name (cadr items)) (binding (lookup name environment))
             (tail (if (eq? (form-kind form environment) 'define-extern)
                       (list (caddr items) (cadddr items) (emit-type (car (cddddr items)) environment))
                       (expand-initializer-tail (cddr items) environment))))
        (rebuild form (cons (emit-identifier (car items) environment) (cons (emit-binder name binding) tail)))))
    ;; Establish each transformer site's sequential-let environment before
    ;; expanding expressions. Earlier introduction contexts retain the same
    ;; capture frame and therefore see the completed definition-site scope.
    (define (statement-scope form environment definitions)
      (if (not (eq? (form-kind form environment) 'let)) environment
          (let ((name (cadr (parts form))))
            (when (local-binding (atom-syntax-value name) (atom-syntax-context name) definitions)
              (fail name "let conflicts with a definition or import"))
            (extend-environment (list (reserve name)) environment))))
    (define (prepare-statements forms environment definitions)
      (if (null? forms) (values '() environment)
          (let* ((form (car forms)) (next (statement-scope form environment definitions)))
            (install-transformers! (list form) environment)
            (let-values (((rest final) (prepare-statements (cdr forms) next definitions)))
              (values (cons (list form environment next) rest) final)))))
    (define (expand-let form before after)
      (let ((items (parts form)) (binding (car (expansion-bindings after))))
        (rebuild form (cons (emit-identifier (car items) before)
                            (cons (emit-binder (cadr items) binding)
                                  (expand-initializer-tail (cddr items) before))))))
    (define (expand-statements statements)
      (if (null? statements) '()
          (let* ((statement (car statements)) (form (car statement)) (before (cadr statement)) (after (caddr statement))
                 (kind (form-kind form before)))
            (if (macro-definition? form before) (expand-statements (cdr statements))
                (cons (case kind
                        ((let) (expand-let form before after))
                        ((def define-extern define-overload) (expand-definition form before))
                        (else (expand-expression form before)))
                      (expand-statements (cdr statements)))))))
    (define (new-definitions forms scope)
      (let filter ((bindings (reserve-definitions forms scope)))
        (cond ((null? bindings) '())
              ((scope-binding (lexical-name (car bindings)) (lexical-context (car bindings)) scope)
               (filter (cdr bindings)))
              (else (cons (car bindings) (filter (cdr bindings)))))))
    (define (add-discovered-definitions! forms scope)
      (let ((additions (new-definitions forms scope)))
        (unless (null? additions)
          (set-expansion-bindings! scope (append additions (expansion-bindings scope)))
          (check-discovery-reads (car (discovery-reads))))))
    (define (library-splice-contents form scope)
      (and (memq (form-kind form scope) '(begin library-begin))
           (begin (observe-identifier (head form) scope) (cdr (parts form)))))
    ;; Expose one layer, preserving the children's syntax identities. The next
    ;; discovery pass reserves those siblings before interpreting their heads.
    (define (expose-library-splices forms scope)
      (if (null? forms) (values '() #f)
          (let ((children (library-splice-contents (car forms) scope)))
            (let-values (((rest spliced?) (expose-library-splices (cdr forms) scope)))
              (values (if children (append children rest) (cons (car forms) rest))
                      (if children #t spliced?))))))
    (define (same-form-sequence? before after)
      (or (null? before) (and (eq? (car before) (car after)) (same-form-sequence? (cdr before) (cdr after)))))
    (define (expand-statement-head form scope library?)
      (if (macro-definition? form scope) form
          (let ((expanded (expand-head form scope)))
            (when (and library? (library-declaration? expanded scope))
              (observe-identifier (head expanded) scope))
            (if library? (expand-library-declaration expanded scope) expanded))))
    (define (discover-statement-heads forms scope library?)
      (let ((before (expansion-budget)))
        (let ((heads (map (lambda (form) (expand-statement-head form scope library?)) forms)))
          ;; Normalization changes syntax identity; macro applications can
          ;; establish progress even when their resulting syntax repeats.
          (values heads (or (< (expansion-budget) before) (not (same-form-sequence? forms heads)))))))
    (define (discover-definitions forms scope library?)
      (let discover ((forms forms))
        (add-discovered-definitions! forms scope)
        (let-values (((body spliced?) (if library? (expose-library-splices forms scope) (values forms #f))))
          (if spliced? (discover body)
              (begin
                (install-transformers! body scope)
                (let-values (((heads applied?) (discover-statement-heads body scope library?)))
                  (if applied? (discover heads) heads)))))))
    (define (expand-body forms environment library?)
      (let* ((scope (extend-environment (reserve-definitions forms environment) environment))
             (pending (list '()))
             (heads (parameterize ((discovery-reads (list '())) (pending-derivations pending))
                      (discover-definitions forms scope library?))))
        (check-derivation-targets (car pending) scope)
        (when library? (current-library-types (library-type-names heads scope)))
        (let-values (((statements final) (prepare-statements heads scope (expansion-bindings scope))))
          (values (expand-statements statements) final))))

    ;; ---- Library expansion retains macros beside runtime declarations ----

    (define (macro-binding binding loc)
      (let ((definition (make-value-definition (lexical-name binding) loc)))
        (prepare-binding! definition #f #f 'syntax (lexical-transformer binding))
        (cons (lexical-emitted binding) definition)))
    (define (expand-export form environment)
      (let* ((renamed? (list-syntax? form)) (items (and renamed? (parts form)))
             (local (if renamed? (cadr items) form)) (public (if renamed? (caddr items) form))
             (binding (lookup local environment)))
        (make-list-syntax (list (make-atom-syntax 'rename (syntax-loc form))
                                (if binding (make-identifier-syntax (lexical-emitted binding) (syntax-loc local) 'generated #f) local) public)
                          '() (syntax-loc form))))
    (define (library-body forms)
      (cond ((null? forms) '())
            ((or (headed? (car forms) 'import) (headed? (car forms) 'export)) (library-body (cdr forms)))
            (else (cons (car forms) (library-body (cdr forms))))))
    (define (expand-directives forms scope)
      (cond ((null? forms) '())
            ((headed? (car forms) 'import) (cons (car forms) (expand-directives (cdr forms) scope)))
            ((headed? (car forms) 'export)
             (cons (rebuild (car forms) (cons (head (car forms))
                                              (map (lambda (item) (expand-export item scope)) (cdr (parts (car forms))))))
                   (expand-directives (cdr forms) scope)))
            (else (expand-directives (cdr forms) scope))))
    (define (local-transformers bindings)
      (cond ((null? bindings) '())
            ((lexical-transformer (car bindings))
             (cons (macro-binding (car bindings) #f) (local-transformers (cdr bindings))))
            (else (local-transformers (cdr bindings)))))
    (define (library-transformers scope outer)
      (if (eq? scope outer) '()
          (append (local-transformers (expansion-bindings scope))
                  (library-transformers (expansion-parent scope) outer))))
    (define (check-import-collision binding imports)
      (let ((imported (local-binding (lexical-name binding) (lexical-context binding) imports)))
        (when (and imported
                   (not (and (eq? (lexical-space binding) 'static)
                             (eq? (binding-kind (lexical-definition imported)) 'overload)
                             (eq? (lexical-emitted binding) (lexical-emitted imported)))))
          (error "duplicate binding" (lexical-loc binding) (lexical-name binding)))))
    (define (check-library-conflicts scope outer)
      (unless (eq? scope outer)
        (for-each (lambda (binding) (check-import-collision binding (expansion-bindings outer)))
                  (expansion-bindings scope))
        (check-library-conflicts (expansion-parent scope) outer)))
    (define (check-expanded-library-body forms)
      (for-each (lambda (form)
                  (when (or (headed? form 'import) (headed? form 'export) (headed? form 'define-library))
                    (fail form "library directives are not allowed in expanded library bodies"))) forms))
    (define (expand-library-body forms imports . names)
      (parameterize ((expansion-budget 10000) (next-name 0)
                     (current-library-name (and (pair? names) (car names)))
                     (current-library-types '()) (claimed-type-names '()))
        (let ((environment (extend-environment (import-environment imports) (extend-environment (core-environment) #f))))
          (let-values (((expanded scope) (expand-body (library-body forms) environment #t)))
            (check-expanded-library-body expanded)
            (check-library-conflicts scope environment)
            (values (append (expand-directives forms scope) expanded)
                    (library-transformers scope environment) scope)))))
    (define (finish-expansion! environment bindings)
      (for-each (lambda (binding)
                  (let ((definition (assq (lexical-emitted binding) bindings)))
                    (when definition (set-lexical-definition! binding (cdr definition))))) (environment-bindings environment)))
    (define (definition-with-origin origin bindings)
      (cond ((null? bindings) #f)
            ((eq? origin (binding-origin (cdar bindings))) (cdar bindings))
            (else (definition-with-origin origin (cdr bindings)))))
    (define (rebase-capture! binding bindings)
      (let* ((original (lexical-definition binding))
             (target (and original (definition-with-origin (binding-origin original) bindings))))
        (when target (set-lexical-definition! binding target))))
    ;; Seal private as well as exported macros: public templates can call private
    ;; transformers, whose runtime helpers must use this resolved graph too.
    (define (rebase-transformers! bindings)
      (for-each (lambda (entry)
                  (let ((definition (cdr entry)))
                    (when (eq? (binding-kind definition) 'syntax)
                      (for-each (lambda (binding) (rebase-capture! binding bindings))
                                (environment-bindings (transformer-environment (binding-payload definition))))))) bindings))
    )

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-macros)
    (import
     (lofi host test-utils)
     (lofi compiler reader)
     (lofi compiler syntax-parser))
    (begin
      (define (check-scope-index scope contexts)
        (for-each (lambda (namespace)
                    (parameterize ((current-namespace namespace))
                      (for-each (lambda (name)
                                  (for-each (lambda (context)
                                              (expect (eq? (scope-binding name context scope)
                                                           (local-binding name context (expansion-bindings scope))) #t)) contexts))
                                '(x y absent)))) '(term type)))
      (define (test-scope-index)
        (let* ((context (make-introduction #f #f))
               (first (make-lexical-binding 'x #f 'first #f #f))
               (second (make-lexical-binding 'x #f 'second #f #f))
               (introduced (make-lexical-binding 'x context 'introduced #f #f))
               (scope (extend-environment (list first second introduced) #f)))
          (check-scope-index scope (list #f context))
          (set-lexical-space! first 'type)
          (check-scope-index scope (list #f context))
          (set-expansion-bindings! scope (list introduced second first))
          (check-scope-index scope (list #f context))))
      (define (expanded-datum text)
        (let-values (((forms macros scope)
                      (expand-library-body (reader->syntax-list (string->reader "macro-unit.sld" text)) '())))
          (syntax->datum (car (reverse forms)))))
      (define (test-pattern-shapes)
        (expect (expanded-datum "(def m (syntax-rules () ((_ ((x ...) ...)) #(#(x ...) ...)))) (m (() (1 2) (3)))")
                '#(#() #(1 2) #(3)))
        (expect (expanded-datum "(def m (syntax-rules () ((_ shared (x ...)) #((shared x) ...)))) (m 9 (1 2))")
                '#((9 1) (9 2)))
        (expect (expanded-datum "(def m (syntax-rules (stop) ((_ (x ... stop y)) #(x ... y)))) (m (1 2 stop 3))") '#(1 2 3))
        (expect (expanded-datum "(def m (syntax-rules () ((_ #(x ...)) #(x ...)))) (m #(1 2))") '#(1 2))
        (expect (expanded-datum "(def m (syntax-rules () ((_ (x . tail)) tail))) (m (1 . 42))") 42))
      (define (test-transformer-rejections)
        (for-each
         (lambda (text) (expect (guard (failure (else #t)) (expanded-datum text) #f) #t))
         '("(def m (syntax-rules () ((_ x x) x))) 0"
           "(def m (syntax-rules () ((_ (x ...)) x))) 0"
           "(def m (syntax-rules () ((_ x) #(x ...)))) 0"
           "(def m (syntax-rules () ((_ x) x))) (m)"
           "(def m (syntax-rules () ((_ (x ...) (y ...)) #((x y) ...)))) (m (1 2) (3))")))
      (define (test-library-splices)
        (for-each
         (lambda (text)
           (let-values (((forms macros scope)
                         (expand-library-body (reader->syntax-list (string->reader "splice-unit.sld" text)) '())))
             (expect (map syntax->datum forms) '(1 2 3 4))))
         '("(library-begin 1 (library-begin 2) 3) (library-begin) 4"
           "(begin 1 (begin 2) 3) (begin) 4"
           "(def m (syntax-rules () ((_) (begin 1 (library-begin 2) 3)))) (m) 4"))
        (for-each
         (lambda (text) (expect (guard (failure (else #t)) (expanded-datum text) #f) #t))
         '("(def m (syntax-rules () ((_) (library-begin 1)))) (lambda () (m))"
           "(def m (syntax-rules () ((_) (import (missing))))) (m)"
           "(library-begin (export))"
           "(library-begin (library-begin (define-library (nested))))"
           "(library-begin (def library-begin (lambda (x) x))) 0")))
      (define (test-declaration-discovery)
        (expect
         (guard (failure (else (error-object-message failure)))
           (expanded-datum "(data Flag () (flag))
                            (def m (syntax-rules () ((_ name) (def name (lambda (x) x)))))
                            (m data)")
           #f)
         "generated binding changes an earlier macro decision; use a direct definition"))
      (define (literal-transition-rejected? before after)
        (let* ((identifier (make-atom-syntax 'marker #f)) (shared (reserve identifier))
               (left (extend-environment (list shared) #f))
               (outer (extend-environment (list (if before shared (reserve identifier))) #f))
               (right (extend-environment '() outer)) (reads (list '())))
          (parameterize ((discovery-reads reads))
            (expect (same-identifier? identifier identifier left right) before))
          (set-expansion-bindings! right (list (if after shared (reserve identifier))))
          (guard (failure (else #t)) (check-discovery-reads (car reads)) #f)))
      (define (test-literal-decisions)
        (expect (literal-transition-rejected? #f #f) #f)
        (expect (literal-transition-rejected? #f #t) #t)
        (expect (literal-transition-rejected? #t #f) #t)
        (expect (literal-transition-rejected? #t #t) #f)
        (expect (expanded-datum
                 "(def bind (syntax-rules (marker) ((_ name marker) (def name 1))))
                  (bind marker marker) 42") 42))
      (define (test-deriving-rejections)
        (for-each
         (lambda (entry)
           (expect (guard (failure (else (error-object-message failure))) (expanded-datum (car entry)) #f)
                   (cadr entry)))
         '(("(data Flag () (flag) (deriving) (deriving))" "duplicate deriving clause")
           ("(data Flag () (deriving) (flag))" "deriving clause must be last")
           ("(data Flag () (flag) deriving)" "deriving requires a proper list of transformer identifiers")
           ("(data Flag () (flag) (deriving . target))" "deriving requires a proper list of transformer identifiers")
           ("(data Flag () (flag) (deriving (target)))" "deriving target must be a transformer identifier")
           ("(data Flag () (flag) (deriving missing))" "deriving target must name a macro transformer")
           ("(def value 1) (data Flag () (flag) (deriving value))" "deriving target must name a macro transformer"))))
      (define (test-syntax-names)
        (expect (expanded-datum "(identifier-name unbound)") "unbound")
        (expect (expanded-datum "(def named (syntax-rules () ((_ name) (identifier-name name)))) (named original)") "original")
        (expect (expanded-datum "(library-name)") "#f")
        (for-each (lambda (text) (expect (guard (failure (else #t)) (expanded-datum text) #f) #t))
                  '("(identifier-name)" "(identifier-name name extra)" "(identifier-name 1)" "(library-name extra)")))
      (define (test-type-names)
        (expect (expanded-datum "(data Box () (box)) (type-name Box) (type-name Box)") "#f:Box")
        (expect (expanded-datum "(def Box (datatype () (box))) (type-name Box)") "#f:Box")
        (for-each
         (lambda (text) (expect (guard (failure (else #t)) (expanded-datum text) #f) #t))
         '("(type-name)" "(type-name name extra)" "(type-name 1)" "(type-name missing)" "(type-name I32)"
           "(data Box () (box)) (type-name box)"
           "(typeclass C (T) (: method (-> T T))) (type-name C)"
           "(data Box () (box)) (def f (All (Box) (-> Box String)) (lambda (value) (type-name Box)))")))
      (define (test-unclaimed-type-names)
        (expect (expanded-datum
                 "(def private (syntax-rules () ((_) (data Hidden () (hidden)))))
                  (private) (private) 42") 42))
      (define (test-deriving-forward-target)
        (let-values (((forms macros scope)
                      (expand-library-body
                       (reader->syntax-list
                        (string->reader "derive-forward.sld"
                                        "(def install (syntax-rules (data)
                                           ((_ (data Name () (constructor (target Type accessor))))
                                            (begin (def target (syntax-rules () ((_ declaration) 1))) 2))))
                                         (data Box () (box (late I32 box-value)) (deriving late install))")) '())))
          (expect (map syntax->datum (cdr forms)) '(1 2))))
      (define (test-deriving-core-targets)
        (for-each
         (lambda (name)
           (expect (guard (failure (else (error-object-message failure)))
                     (expanded-datum (string-append "(data Flag () (flag) (deriving " (symbol->string name) "))")) #f)
                   "deriving target must name a macro transformer"))
         '(begin library-begin def define-syntax data typeclass instance define-extern define-overload)))
      (define (test-deriving-generated-core-name)
        (expect (expanded-datum
                 "(def install (syntax-rules () ((_ name) (def name (syntax-rules () ((_ declaration) 42))))))
                  (data Flag () (flag) (deriving begin))
                  (install begin)") 42))
      (define (test-macros)
        (run-test test-scope-index)
        (run-test test-pattern-shapes)
        (run-test test-transformer-rejections)
        (run-test test-library-splices)
        (run-test test-declaration-discovery)
        (run-test test-literal-decisions)
        (run-test test-deriving-rejections)
        (run-test test-deriving-core-targets)
        (run-test test-deriving-generated-core-name)
        (run-test test-deriving-forward-target)
        (run-test test-type-names)
        (run-test test-unclaimed-type-names)
        (run-test test-syntax-names))))
   (else)))
