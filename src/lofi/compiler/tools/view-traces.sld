;; One selected trace and contained Perfetto UI assets, served on loopback.
(define-library (lofi compiler tools view-traces)
  (export view-traces-main)
  (import
   (scheme base)
   (scheme cxr)
   (scheme char)
   (scheme file)
   (scheme write)
   (scheme process-context)
   (chibi filesystem)
   (chibi pathname)
   (lofi host json)
   (chibi net)
   (chibi net server)
   (only (chibi) port-fileno)
   (only (chibi mime) mime-type-from-extension)
   (only (chibi process) execute set-signal-action! signal/pipe signal/interrupt)
   (only (chibi string) string-prefix? string-contains string-split string-trim string-trim-left
         string-cursor-start substring-cursor)
   (srfi 1)
   (lofi host process)
   (lofi compiler tools host-tools))
  (begin

    ;; ---- Command-line inputs and contained files ----

    (define (usage message)
      (display "usage: view-traces TRACE [--port PORT]\n" (current-error-port))
      (display message (current-error-port)) (newline (current-error-port)) (exit 2))
    (define (parse-port text)
      (let* ((digits (if (and (> (string-length text) 0) (memv (string-ref text 0) '(#\+ #\-)))
                         (substring text 1 (string-length text)) text)) (number (string->number text)))
        (unless (and (> (string-length digits) 0)
                     (every (lambda (digit) (char<=? #\0 digit #\9)) (string->list digits))
                     (exact-integer? number) (<= 0 number 65535)) (usage "port must be between 0 and 65535")) number))
    (define (parse-options arguments)
      (let loop ((arguments arguments) (trace #f) (port 9000))
        (cond ((null? arguments) (if trace (cons trace port) (usage "expected a trace file")))
              ((member (car arguments) '("-h" "--help"))
               (display "usage: view-traces TRACE [--port PORT]\nServe one trace in the shell's Perfetto UI.\n") (exit 0))
              ((string=? (car arguments) "--port")
               (unless (pair? (cdr arguments)) (usage "expected a port"))
               (loop (cddr arguments) trace (parse-port (cadr arguments))))
              ((string-prefix? "--port=" (car arguments))
               (loop (cdr arguments) trace (parse-port (substring (car arguments) 7 (string-length (car arguments))))))
              ((string=? (car arguments) "--")
               (cond ((and trace (null? (cdr arguments))) (cons trace port))
                     ((and (not trace) (= 2 (length arguments))) (cons (cadr arguments) port))
                     (else (usage "expected one trace file"))))
              ((or trace (string-prefix? "-" (car arguments))) (usage "unexpected argument"))
              (else (loop (cdr arguments) (car arguments) port)))))
    (define (trace-file path)
      (let ((path (absolute-path path)))
        (unless (file-regular? path) (usage (string-append "not a trace file: " path)))
        (call-with-port (open-binary-input-file path) (lambda (port) #t)) path))
    (define (contained-file directory relative)
      ;; PERFETTO_UI is a trusted immutable tree, normally in the Nix store.
      ;; Resolve containment here; concurrent replacement of UI files is not supported.
      (when (memv (integer->char 0) (string->list relative)) (error "invalid path"))
      (let ((path (absolute-path (path-join directory relative))))
        (unless (and (string-prefix? (string-append directory "/") path) (file-regular? path))
          (error "File not found" relative)) path))
    (define (perfetto-directory)
      (let ((value (get-environment-variable "PERFETTO_UI")))
        (unless (and value (not (string=? value ""))) (error "Perfetto UI is unavailable; enter nix-shell first"))
        (let ((directory (absolute-path value))) (contained-file directory "index.html") directory)))

    ;; ---- Exact URL bytes and startup page ----

    (define (url-byte byte)
      (if (or (<= 48 byte 57) (<= 65 byte 90) (<= 97 byte 122) (memv byte '(45 46 95 126)))
          (string (integer->char byte))
          (let ((hex (string-upcase (number->string byte 16))))
            (string-append "%" (if (= 1 (string-length hex)) "0" "") hex))))
    (define (url-name text)
      (let ((bytes (string->utf8 text)))
        (apply string-append (map (lambda (index) (url-byte (bytevector-u8-ref bytes index)))
                                  (iota (bytevector-length bytes))))))
    (define (hex-nibble byte)
      (cond ((<= 48 byte 57) (- byte 48))
            ((<= 65 byte 70) (- byte 55))
            ((<= 97 byte 102) (- byte 87))
            (else (error "invalid URL escape"))))
    (define (decode-path target)
      (let* ((path (car (string-split (car (string-split target #\?)) #\#)))
             (bytes (string->utf8 path)) (out (open-output-bytevector)))
        (let loop ((index 0))
          (cond ((= index (bytevector-length bytes)) (utf8->string (get-output-bytevector out)))
                ((= 37 (bytevector-u8-ref bytes index))
                 (unless (< (+ index 2) (bytevector-length bytes)) (error "invalid URL escape"))
                 (let ((byte (+ (* 16 (hex-nibble (bytevector-u8-ref bytes (+ index 1))))
                                (hex-nibble (bytevector-u8-ref bytes (+ index 2))))))
                   (write-u8 byte out) (loop (+ index 3))))
                (else (write-u8 (bytevector-u8-ref bytes index) out) (loop (+ index 1)))))))
    (define (startup-page directory trace)
      (let* ((page (read-text (path-join directory "index.html"))) (head (string-contains page "</head>"))
             (route (string-append "/trace/" (url-name (path-strip-directory trace))))
             (bootstrap (string-append "<script>\nlet settings = {};\n"
                                       "try { settings = JSON.parse(localStorage.getItem('perfettoSettings')) || {}; } catch {}\n"
                                       "localStorage.setItem('perfettoSettings', JSON.stringify({...settings, theme: 'dark'}));\n"
                                       "location.replace('/#!/?url=' + encodeURIComponent(location.origin + " (json->string route) "));\n</script>\n")))
        (if head (string-append (substring-cursor page (string-cursor-start page) head)
                                bootstrap (substring-cursor page head)) page)))

    ;; ---- HTTP responses ----

    (define (headers out status type length)
      (display (string-append "HTTP/1.0 " status "\r\nContent-Type: " type "\r\nContent-Length: "
                              (number->string length) "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n") out))
    (define (send-text out status text)
      (let ((bytes (string->utf8 text)))
        (headers out status "text/html; charset=utf-8" (bytevector-length bytes)) (write-bytevector bytes out)))
    (define (file-type path)
      (let ((extension (path-extension path)))
        (if (equal? extension "wasm") "application/wasm"
            (or (mime-type-from-extension extension) "application/octet-stream"))))
    (define (send-file out path)
      (call-with-port (open-binary-input-file path)
        (lambda (source)
          (headers out "200 OK" (file-type path) (file-size (port-fileno source)))
          (let loop ()
            (let ((bytes (read-bytevector 65536 source)))
              (unless (eof-object? bytes) (write-bytevector bytes out) (loop)))))))
    (define (serve-route out route trace directory)
      (cond ((member route '("/" "/index.html")) (send-text out "200 OK" (startup-page directory trace)))
            ((string=? route (string-append "/trace/" (path-strip-directory trace))) (send-file out trace))
            ((string-prefix? "/trace/" route) (error "unselected trace"))
            (else (send-file out (contained-file directory (string-trim-left route #\/))))))
    (define (consume-headers input)
      (let ((line (read-line input)))
        (unless (or (eof-object? line) (string=? (string-trim line char-whitespace?) "")) (consume-headers input))))
    (define (serve-request input out trace directory)
      (guard (failure (else (send-text out "404 File not found" "File not found\n")))
        (let ((line (read-line input)))
          (unless (eof-object? line)
            (let ((parts (string-split (string-trim line char-whitespace?) #\space)))
              (consume-headers input)
              (if (and (= 3 (length parts)) (string=? (car parts) "GET"))
                  (serve-route out (decode-path (cadr parts)) trace directory)
                  (send-text out "501 Unsupported method" "Unsupported method\n")))))))

    ;; ---- Inherited loopback listener ----

    (define (listen-next descriptor port)
      (let ((address (get-address-info "127.0.0.1" port)))
        (let ((socket (accept descriptor (address-info-address address) (address-info-address-length address))))
          (and socket (list socket address)))))
    (define (serve trace directory)
      (let ((descriptor (string->number (or (get-environment-variable "SNAIL_TRACE_LISTENER") "")))
            (port (string->number (or (get-environment-variable "SNAIL_TRACE_PORT") ""))))
        (unless (and (exact-integer? descriptor) (>= descriptor 0) (exact-integer? port)) (error "missing loopback listener"))
        (set-signal-action! signal/pipe #f)
        (set-signal-action! signal/interrupt (lambda (signal) (exit 0)))
        (display (string-append "Open http://127.0.0.1:" (number->string port) "/\n"))
        (display (string-append "For SSH: ssh -N -L " (number->string port) ":127.0.0.1:" (number->string port) " user@server\n"))
        (flush-output-port (current-output-port))
        (run-net-server (lambda () (listen-next descriptor port))
                        (lambda (input out socket address) (serve-request input out trace directory)))))
    (define (start-viewer root arguments)
      (let* ((options (parse-options arguments)) (trace (trace-file (car options))) (directory (perfetto-directory))
             (helper (build-host-tool root "snail-loopback-listener"))
             (command (list helper (number->string (cdr options)) "--" (tool-name "CHIBI" "chibi-scheme")
                            "-I" (path-join root "bootstrap")
                            (path-join root "scripts/view-traces-driver.scm")
                            root "--serve" trace directory)))
        (execute helper command) (error "could not start loopback listener")))
    (define (view-traces-main root arguments)
      (guard (failure (else (display "view-traces: " (current-error-port)) (write failure (current-error-port))
                            (newline (current-error-port)) 1))
        (if (and (= 3 (length arguments)) (string=? (car arguments) "--serve"))
            (serve (cadr arguments) (caddr arguments)) (start-viewer root arguments)) 0))))
