;; Finite transport trees. Graph definitions and links are ordinary list forms;
;; this layer never traverses user storage or assigns object identities.
(define-library (lofi sexp)
  (export Sexp sexp-integer sexp-string sexp-symbol sexp-bytes sexp-list
          sexp-integer-value sexp-string-value sexp-symbol-value
          sexp-bytes-value sexp-list-values
          sexp=? sexp->text text->sexp sexp->binary binary->sexp)
  (import
   (scheme base)
   (scheme immutable)
   (lofi bytes)
   (only (lofi core) data def ann match -> I64 Bool Char String Bytevector List Ref)
   (only (lofi base) ref ref-get ref-set! string=? string-append substring list->string)
   (only (lofi scalar-text) datum-fail i64->string))
  (begin

    ;; ---- Shared finite representation ----

    (data Sexp ()
      (sexp-integer
       (value I64 sexp-integer-value))
      (sexp-string
       (value String sexp-string-value))
      (sexp-symbol
       (value String sexp-symbol-value))
      (sexp-bytes
       (value Bytevector sexp-bytes-value))
      (sexp-list
       (values (List Sexp) sexp-list-values)))

    (define (invalid message) (datum-fail (string-append "sexp: " message)))
    (define (sexp-kind value)
      (match value
        ((sexp-integer value) (ann 0 I64))
        ((sexp-string value) (ann 1 I64))
        ((sexp-symbol value) (ann 2 I64))
        ((sexp-bytes value) (ann 3 I64))
        ((sexp-list values) (ann 4 I64))))
    (def sexp=? (-> Sexp Sexp Bool)
         (lambda (left right)
           (and (= (sexp-kind left) (sexp-kind right))
                (match left
                  ((sexp-integer value) (= value (sexp-integer-value right)))
                  ((sexp-string value) (string=? value (sexp-string-value right)))
                  ((sexp-symbol value) (string=? value (sexp-symbol-value right)))
                  ((sexp-bytes value) (bytes=? value (sexp-bytes-value right)))
                  ((sexp-list values) (sexp-lists=? values (sexp-list-values right)))))))
    (define (bytes=? left right)
      (and (= (bytevector-length left) (bytevector-length right))
           (let loop ((at (ann 0 I64)))
             (or (= at (bytevector-length left))
                 (and (= (bytevector-u8-ref left at) (bytevector-u8-ref right at))
                      (loop (+ at (ann 1 I64))))))))
    (define (sexp-lists=? left right)
      (if (null? left) (null? right)
          (and (not (null? right)) (sexp=? (car left) (car right))
               (sexp-lists=? (cdr left) (cdr right)))))
    (define (list-count values)
      (let loop ((values values) (count (ann 0 I64)))
        (if (null? values) count (loop (cdr values) (+ count (ann 1 I64))))))

    ;; ---- Direct readable output ----

    ;; A reversed character list keeps appending linear. Symbols are always
    ;; bar quoted, so their spelling cannot be confused with an integer.
    (define (emit-char! output character)
      (ref-set! output (cons character (ref-get output))))
    (define (emit-text! output text)
      (let loop ((at (ann 0 I64)))
        (unless (= at (string-length text))
          (emit-char! output (string-ref text at)) (loop (+ at (ann 1 I64))))))
    (define (emit-hex! output value)
      (unless (< value (ann 16 I64)) (emit-hex! output (quotient value (ann 16 I64))))
      (emit-char! output (string-ref "0123456789abcdef" (remainder value (ann 16 I64)))))
    (define (emit-escaped! output character delimiter)
      (cond ((or (char=? character delimiter) (char=? character #\\))
             (emit-char! output #\\) (emit-char! output character))
            ((char=? character #\newline) (emit-text! output "\\n"))
            ((char=? character #\return) (emit-text! output "\\r"))
            ((char=? character #\tab) (emit-text! output "\\t"))
            ((or (< (char->integer character) (ann 32 I64))
                 (and (>= (char->integer character) (ann 127 I64))
                      (<= (char->integer character) (ann 159 I64))))
             (emit-text! output "\\x") (emit-hex! output (char->integer character))
             (emit-char! output #\;))
            (else (emit-char! output character))))
    (define (emit-quoted! output text delimiter)
      (emit-char! output delimiter)
      (let loop ((at (ann 0 I64)))
        (unless (= at (string-length text))
          (emit-escaped! output (string-ref text at) delimiter)
          (loop (+ at (ann 1 I64)))))
      (emit-char! output delimiter))
    (define (emit-list! output values)
      (emit-char! output #\()
      (let loop ((values values) (space? #f))
        (unless (null? values)
          (when space? (emit-char! output #\space))
          (emit-sexp! output (car values)) (loop (cdr values) #t)))
      (emit-char! output #\)))
    (define (emit-bytes-text! output bytes)
      (emit-text! output "#u8(")
      (let loop ((at (ann 0 I64)))
        (unless (= at (bytevector-length bytes))
          (when (> at (ann 0 I64)) (emit-char! output #\space))
          (emit-text! output (i64->string (bytevector-u8-ref bytes at)))
          (loop (+ at (ann 1 I64)))))
      (emit-char! output #\)))
    (define (emit-sexp! output value)
      (match value
        ((sexp-integer value) (emit-text! output (i64->string value)))
        ((sexp-string value) (emit-quoted! output value #\"))
        ((sexp-symbol value) (emit-quoted! output value #\|))
        ((sexp-bytes value) (emit-bytes-text! output value))
        ((sexp-list values) (emit-list! output values))))
    (def sexp->text (-> Sexp String)
         (lambda (value)
           (let ((output (ref (empty-list))))
             (emit-sexp! output value) (list->string (reverse (ref-get output))))))

    ;; ---- Text cursor and owned decoded atoms ----

    (data TextInput ()
      (text-input
       (source String text-source)
       (position (Ref I64) text-position)))
    (define (text-end? input)
      (= (ref-get (text-position input)) (string-length (text-source input))))
    (define (peek-char input)
      (when (text-end? input) (invalid "truncated text"))
      (string-ref (text-source input) (ref-get (text-position input))))
    (define (take-char! input)
      (let ((value (peek-char input)))
        (ref-set! (text-position input) (+ (ref-get (text-position input)) (ann 1 I64))) value))
    (define (expect-char! input expected)
      (unless (char=? (take-char! input) expected) (invalid "unexpected text character")))
    (define (whitespace? character)
      (or (char=? character #\space) (char=? character #\tab)
          (char=? character #\newline) (char=? character #\return)))
    (define (skip-space! input)
      (when (and (not (text-end? input)) (whitespace? (peek-char input)))
        (take-char! input) (skip-space! input)))
    (define (delimiter? character)
      (or (whitespace? character) (char=? character #\() (char=? character #\))
          (char=? character #\") (char=? character #\|)))
    (define (hex-digit character)
      (let ((code (char->integer character)))
        (cond ((and (>= code (ann 48 I64)) (<= code (ann 57 I64))) (- code (ann 48 I64)))
              ((and (>= code (ann 65 I64)) (<= code (ann 70 I64))) (- code (ann 55 I64)))
              ((and (>= code (ann 97 I64)) (<= code (ann 102 I64))) (- code (ann 87 I64)))
              (else (invalid "invalid hexadecimal escape")))))
    (define (read-hex-char! input)
      (let loop ((value (ann 0 I64)) (digits (ann 0 I64)))
        (let ((character (take-char! input)))
          (if (char=? character #\;)
              (begin
                (when (or (= digits (ann 0 I64))
                          (and (>= value (ann 55296 I64)) (<= value (ann 57343 I64))))
                  (invalid "invalid Unicode escape"))
                (integer->char value))
              (let ((next (+ (* value (ann 16 I64)) (hex-digit character))))
                (when (> next (ann 1114111 I64)) (invalid "Unicode escape out of range"))
                (loop next (+ digits (ann 1 I64))))))))
    (define (read-escaped! input delimiter)
      (let ((character (take-char! input)))
        (cond ((char=? character #\n) #\newline)
              ((char=? character #\r) #\return)
              ((char=? character #\t) #\tab)
              ((char=? character #\x) (read-hex-char! input))
              ((or (char=? character #\\) (char=? character delimiter)) character)
              (else (invalid "unknown text escape")))))
    (define (read-quoted! input delimiter)
      (expect-char! input delimiter)
      (let loop ((characters (empty-list)))
        (let ((character (take-char! input)))
          (if (char=? character delimiter) (list->string (reverse characters))
              (loop (cons (if (char=? character #\\) (read-escaped! input delimiter) character)
                          characters))))))
    (define (read-token! input)
      (let ((start (ref-get (text-position input))))
        (let loop ()
          (unless (or (text-end? input) (delimiter? (peek-char input)))
            (take-char! input) (loop)))
        (substring (text-source input) start (ref-get (text-position input)))))
    (define (decimal-digit? character)
      (and (not (char<? character #\0)) (not (char<? #\9 character))))

    ;; Accumulate negative digits: abs(I64_MIN) cannot be represented. Each
    ;; next multiply/subtract is proved in range before doing the operation.
    (define (accumulate-decimal-digit value character limit)
      (let ((digit (- (char->integer character) (ann 48 I64))))
        (when (or (< digit (ann 0 I64)) (> digit (ann 9 I64))) (invalid "invalid integer digit"))
        (when (or (< value (quotient limit (ann 10 I64)))
                  (and (= value (quotient limit (ann 10 I64)))
                       (> digit (- (ann 0 I64) (remainder limit (ann 10 I64))))))
          (invalid "integer outside signed I64 range"))
        (- (* value (ann 10 I64)) digit)))
    (define (read-decimal text)
      (let* ((first (string-ref text (ann 0 I64)))
             (negative? (char=? first #\-))
             (start (if (or negative? (char=? first #\+)) (ann 1 I64) (ann 0 I64)))
             (limit (if negative? (ann -9223372036854775808 I64) (ann -9223372036854775807 I64))))
        (when (= start (string-length text)) (invalid "missing integer digits"))
        (let loop ((at start) (value (ann 0 I64)))
          (if (= at (string-length text)) (if negative? value (- (ann 0 I64) value))
              (loop (+ at (ann 1 I64))
                    (accumulate-decimal-digit value (string-ref text at) limit))))))

    ;; A leading digit or sign+digit commits the whole token to integer
    ;; parsing. Other bare characters have no quote, comment, or escape syntax;
    ;; arbitrary symbol spellings remain available through bar quoting.
    (define (integer-token? text)
      (let ((first (string-ref text (ann 0 I64))))
        (or (decimal-digit? first)
            (and (> (string-length text) (ann 1 I64))
                 (or (char=? first #\-) (char=? first #\+))
                 (decimal-digit? (string-ref text (ann 1 I64)))))))
    (define (read-atom! input)
      (let ((text (read-token! input)))
        (when (= (string-length text) (ann 0 I64)) (invalid "expected an atom"))
        (if (integer-token? text) (sexp-integer (read-decimal text))
            (begin
              (when (or (string=? text ".") (char=? (string-ref text (ann 0 I64)) #\#))
                (invalid "unsupported text atom"))
              (sexp-symbol text)))))
    (define (read-list! input)
      (expect-char! input #\()
      (let loop ((values (empty-list)))
        (skip-space! input)
        (if (char=? (peek-char input) #\))
            (begin (take-char! input) (sexp-list (reverse values)))
            (loop (cons (read-text-value! input) values)))))
    (define (bytes-from-reversed values)
      (let ((bytes (make-bytevector (list-count values))))
        (let loop ((values values) (at (- (bytevector-length bytes) (ann 1 I64))))
          (unless (null? values)
            (bytevector-u8-set! bytes at (car values))
            (loop (cdr values) (- at (ann 1 I64))))) bytes))
    (define (read-bytes-text! input)
      (expect-char! input #\#) (expect-char! input #\u)
      (expect-char! input #\8) (expect-char! input #\()
      (let loop ((values (empty-list)))
        (skip-space! input)
        (if (char=? (peek-char input) #\))
            (begin (take-char! input) (sexp-bytes (bytes-from-reversed values)))
            (let ((token (read-token! input)))
              (when (= (string-length token) (ann 0 I64)) (invalid "expected byte integer"))
              (let ((value (read-decimal token)))
                (when (or (< value (ann 0 I64)) (> value (ann 255 I64))) (invalid "byte outside 0..255"))
                (loop (cons value values)))))))
    (define (read-text-value! input)
      (skip-space! input)
      (let ((character (peek-char input)))
        (cond ((char=? character #\() (read-list! input))
              ((char=? character #\") (sexp-string (read-quoted! input #\")))
              ((char=? character #\|) (sexp-symbol (read-quoted! input #\|)))
              ((char=? character #\#) (read-bytes-text! input))
              ((char=? character #\)) (invalid "unexpected closing parenthesis"))
              (else (read-atom! input)))))
    (def text->sexp (-> String Sexp)
         (lambda (source)
           (let* ((input (text-input source (ref (ann 0 I64)))) (value (read-text-value! input)))
             (skip-space! input)
             (unless (text-end? input) (invalid "trailing text")) value)))

    ;; ---- Compact MessagePack output ----

    ;; Standard integer, str, bin and array tags; extension type 1 is a UTF-8
    ;; symbol. No host object graph, text wrapper, or process-local IDs occur.
    (define (emit-byte! output value) (ref-set! output (cons value (ref-get output))))
    ;; Subtracting the low byte rounds down to a multiple of 256. This stays
    ;; in range even at I64_MIN, which is itself divisible by 256.
    (define (emit-integer-bytes! output value count)
      (unless (= count (ann 0 I64))
        (let* ((remainder (remainder value (ann 256 I64)))
               (byte (if (< remainder (ann 0 I64)) (+ remainder (ann 256 I64)) remainder)))
          (emit-integer-bytes! output (quotient (- value byte) (ann 256 I64)) (- count (ann 1 I64)))
          (emit-byte! output byte))))
    (define (emit-tagged-integer! output tag value count)
      (emit-byte! output tag) (emit-integer-bytes! output value count))
    (define (emit-binary-integer! output value)
      (cond ((and (>= value (ann 0 I64)) (<= value (ann 127 I64))) (emit-byte! output value))
            ((and (< value (ann 0 I64)) (>= value (ann -32 I64))) (emit-byte! output (+ value (ann 256 I64))))
            ((and (>= value (ann 0 I64)) (<= value (ann 255 I64))) (emit-tagged-integer! output (ann 204 I64) value (ann 1 I64)))
            ((and (>= value (ann 0 I64)) (<= value (ann 65535 I64))) (emit-tagged-integer! output (ann 205 I64) value (ann 2 I64)))
            ((and (>= value (ann 0 I64)) (<= value (ann 4294967295 I64))) (emit-tagged-integer! output (ann 206 I64) value (ann 4 I64)))
            ((and (>= value (ann -128 I64)) (< value (ann 0 I64))) (emit-tagged-integer! output (ann 208 I64) value (ann 1 I64)))
            ((and (>= value (ann -32768 I64)) (< value (ann 0 I64))) (emit-tagged-integer! output (ann 209 I64) value (ann 2 I64)))
            ((and (>= value (ann -2147483648 I64)) (< value (ann 0 I64))) (emit-tagged-integer! output (ann 210 I64) value (ann 4 I64)))
            (else (emit-tagged-integer! output (ann 211 I64) value (ann 8 I64)))))
    (define (emit-sized-header! output count tag8 tag16 tag32)
      (cond ((<= count (ann 255 I64)) (emit-tagged-integer! output tag8 count (ann 1 I64)))
            ((<= count (ann 65535 I64)) (emit-tagged-integer! output tag16 count (ann 2 I64)))
            ((<= count (ann 4294967295 I64)) (emit-tagged-integer! output tag32 count (ann 4 I64)))
            (else (invalid "binary length exceeds U32"))))
    (define (emit-raw-bytes! output bytes)
      (let loop ((at (ann 0 I64)))
        (unless (= at (bytevector-length bytes))
          (emit-byte! output (bytevector-u8-ref bytes at)) (loop (+ at (ann 1 I64))))))
    (define (emit-binary-text! output text symbol?)
      (let* ((bytes (string->utf8 text)) (count (bytevector-length bytes)))
        (if symbol?
            (begin (emit-sized-header! output count (ann 199 I64) (ann 200 I64) (ann 201 I64))
                   (emit-byte! output (ann 1 I64)))
            (if (< count (ann 32 I64)) (emit-byte! output (+ (ann 160 I64) count))
                (emit-sized-header! output count (ann 217 I64) (ann 218 I64) (ann 219 I64))))
        (emit-raw-bytes! output bytes)))
    (define (emit-binary-list! output values)
      (let ((count (list-count values)))
        (cond ((< count (ann 16 I64)) (emit-byte! output (+ (ann 144 I64) count)))
              ((<= count (ann 65535 I64)) (emit-tagged-integer! output (ann 220 I64) count (ann 2 I64)))
              ((<= count (ann 4294967295 I64)) (emit-tagged-integer! output (ann 221 I64) count (ann 4 I64)))
              (else (invalid "binary list exceeds U32"))))
      (let loop ((values values))
        (unless (null? values) (emit-binary-value! output (car values)) (loop (cdr values)))))
    (define (emit-binary-value! output value)
      (match value
        ((sexp-integer value) (emit-binary-integer! output value))
        ((sexp-string value) (emit-binary-text! output value #f))
        ((sexp-symbol value) (emit-binary-text! output value #t))
        ((sexp-bytes value)
         (begin
           (emit-sized-header! output (bytevector-length value) (ann 196 I64) (ann 197 I64) (ann 198 I64))
           (emit-raw-bytes! output value)))
        ((sexp-list values) (emit-binary-list! output values))))
    (def sexp->binary (-> Sexp Bytevector)
         (lambda (value)
           (let ((output (ref (empty-list))))
             (emit-binary-value! output value) (bytes-from-reversed (ref-get output)))))

    ;; ---- Bounded binary input ----

    (data BinaryInput ()
      (binary-input
       (source Bytevector binary-source)
       (position (Ref I64) binary-position)))
    (define (binary-remaining input)
      (- (bytevector-length (binary-source input)) (ref-get (binary-position input))))
    (define (require-bytes! input count)
      (when (> count (binary-remaining input)) (invalid "truncated binary payload")))
    (define (take-byte! input)
      (require-bytes! input (ann 1 I64))
      (let* ((at (ref-get (binary-position input))) (value (bytevector-u8-ref (binary-source input) at)))
        (ref-set! (binary-position input) (+ at (ann 1 I64))) value))
    (define (read-integer-bytes! input count signed?)
      (require-bytes! input count)
      (let* ((first (take-byte! input))
             (initial (if (and signed? (>= first (ann 128 I64))) (- first (ann 256 I64)) first)))
        (when (and (= count (ann 8 I64)) (not signed?) (>= first (ann 128 I64)))
          (invalid "unsigned integer exceeds signed I64"))
        (let loop ((remaining (- count (ann 1 I64))) (value initial))
          (if (= remaining (ann 0 I64)) value
              (loop (- remaining (ann 1 I64)) (+ (* value (ann 256 I64)) (take-byte! input)))))))
    (define (read-binary-bytes! input count)
      (require-bytes! input count)
      (let* ((start (ref-get (binary-position input))) (end (+ start count))
             (bytes (bytevector-copy (binary-source input) start end)))
        (ref-set! (binary-position input) end) bytes))

    ;; Validate UTF-8 before the allocating conversion so malformed wire input
    ;; reports the same useful datum error as structural failures.
    (define (utf8-continuation! bytes at low high)
      (when (>= at (bytevector-length bytes)) (invalid "truncated UTF-8"))
      (let ((byte (bytevector-u8-ref bytes at)))
        (when (or (< byte low) (> byte high)) (invalid "invalid UTF-8 continuation"))))
    (define (utf8-width bytes at)
      (let ((first (bytevector-u8-ref bytes at)))
        (cond ((< first (ann 128 I64)) (ann 1 I64))
              ((and (>= first (ann 194 I64)) (<= first (ann 223 I64))) (ann 2 I64))
              ((and (>= first (ann 224 I64)) (<= first (ann 239 I64))) (ann 3 I64))
              ((and (>= first (ann 240 I64)) (<= first (ann 244 I64))) (ann 4 I64))
              (else (invalid "invalid UTF-8 leading byte")))))
    (define (check-utf8-sequence! bytes at width)
      (let* ((first (bytevector-u8-ref bytes at))
             (low (cond ((= first (ann 224 I64)) (ann 160 I64))
                        ((= first (ann 240 I64)) (ann 144 I64)) (else (ann 128 I64))))
             (high (cond ((= first (ann 237 I64)) (ann 159 I64))
                         ((= first (ann 244 I64)) (ann 143 I64)) (else (ann 191 I64)))))
        (when (> width (ann 1 I64)) (utf8-continuation! bytes (+ at (ann 1 I64)) low high))
        (let loop ((offset (ann 2 I64)))
          (when (< offset width)
            (utf8-continuation! bytes (+ at offset) (ann 128 I64) (ann 191 I64))
            (loop (+ offset (ann 1 I64)))))))
    (define (read-binary-text! input count)
      (let ((bytes (read-binary-bytes! input count)))
        (let loop ((at (ann 0 I64)))
          (unless (= at (bytevector-length bytes))
            (let ((width (utf8-width bytes at)))
              (check-utf8-sequence! bytes at width) (loop (+ at width)))))
        (utf8->string bytes)))
    (define (read-binary-list! input count)
      ;; Every child needs at least one tag byte; reject impossible lengths
      ;; before constructing even the first child or list cell.
      (require-bytes! input count)
      (let loop ((remaining count) (values (empty-list)))
        (if (= remaining (ann 0 I64)) (sexp-list (reverse values))
            (loop (- remaining (ann 1 I64)) (cons (read-binary-value! input) values)))))
    (define (read-extension! input count)
      (unless (= (take-byte! input) (ann 1 I64)) (invalid "unknown binary extension"))
      (sexp-symbol (read-binary-text! input count)))
    (define (read-binary-sized! input tag count)
      (cond ((or (= tag (ann 196 I64)) (= tag (ann 197 I64)) (= tag (ann 198 I64)))
             (sexp-bytes (read-binary-bytes! input count)))
            ((or (= tag (ann 199 I64)) (= tag (ann 200 I64)) (= tag (ann 201 I64)))
             (read-extension! input count))
            ((or (= tag (ann 217 I64)) (= tag (ann 218 I64)) (= tag (ann 219 I64)))
             (sexp-string (read-binary-text! input count)))
            (else (read-binary-list! input count))))
    (define (binary-length-width tag)
      (cond ((or (= tag (ann 196 I64)) (= tag (ann 199 I64)) (= tag (ann 217 I64))) (ann 1 I64))
            ((or (= tag (ann 197 I64)) (= tag (ann 200 I64)) (= tag (ann 218 I64)) (= tag (ann 220 I64))) (ann 2 I64))
            (else (ann 4 I64))))
    (define (read-binary-value! input)
      ;; Exhaustive wire dispatch: unsupported MessagePack maps, floats, nil,
      ;; booleans and reserved tags cannot silently enter this smaller tree.
      (let ((tag (take-byte! input)))
        (cond ((< tag (ann 128 I64)) (sexp-integer tag))
              ((>= tag (ann 224 I64)) (sexp-integer (- tag (ann 256 I64))))
              ((and (>= tag (ann 144 I64)) (< tag (ann 160 I64))) (read-binary-list! input (- tag (ann 144 I64))))
              ((and (>= tag (ann 160 I64)) (< tag (ann 192 I64))) (sexp-string (read-binary-text! input (- tag (ann 160 I64)))))
              ((or (and (>= tag (ann 196 I64)) (<= tag (ann 201 I64)))
                   (and (>= tag (ann 217 I64)) (<= tag (ann 221 I64))))
               (read-binary-sized! input tag (read-integer-bytes! input (binary-length-width tag) #f)))
              ((or (= tag (ann 204 I64)) (= tag (ann 208 I64)))
               (sexp-integer (read-integer-bytes! input (ann 1 I64) (= tag (ann 208 I64)))))
              ((or (= tag (ann 205 I64)) (= tag (ann 209 I64)))
               (sexp-integer (read-integer-bytes! input (ann 2 I64) (= tag (ann 209 I64)))))
              ((or (= tag (ann 206 I64)) (= tag (ann 210 I64)))
               (sexp-integer (read-integer-bytes! input (ann 4 I64) (= tag (ann 210 I64)))))
              ((or (= tag (ann 207 I64)) (= tag (ann 211 I64)))
               (sexp-integer (read-integer-bytes! input (ann 8 I64) (= tag (ann 211 I64)))))
              ((= tag (ann 212 I64)) (read-extension! input (ann 1 I64)))
              ((= tag (ann 213 I64)) (read-extension! input (ann 2 I64)))
              ((= tag (ann 214 I64)) (read-extension! input (ann 4 I64)))
              ((= tag (ann 215 I64)) (read-extension! input (ann 8 I64)))
              ((= tag (ann 216 I64)) (read-extension! input (ann 16 I64)))
              (else (invalid "unsupported binary tag")))))
    (def binary->sexp (-> Bytevector Sexp)
         (lambda (source)
           (let* ((input (binary-input source (ref (ann 0 I64)))) (value (read-binary-value! input)))
             (unless (= (binary-remaining input) (ann 0 I64)) (invalid "trailing binary bytes")) value)))))
