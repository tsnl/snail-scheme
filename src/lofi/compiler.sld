;; Map compilation resolves supplied library values before checking. Source
;; preparation lives in source-driver; this module never discovers dependencies.
;; Read compile below for the path from a library map and public Entry to an
;; optimized Artifact. Resolution covers the whole map; checking starts at its root.
(define-library (lofi compiler)
  (export make-entry entry? entry-library entry-export compile
          artifact? artifact-entry artifact-parameters artifact-result artifact-bytes
          library-map->core)
  (import (scheme base) (lofi library)
          (lofi infer) (lofi primitives) (lofi artifact)
          (lofi specialize) (lofi emit-wasm)
          (only (lofi types) strict-error resolve scheme-variables scheme-type
                function-type? function-domains function-result)
          (only (lofi checked) program-globals program-type)
          (only (lofi ir) node-loc node-data binding-kind binding-payload
                binding-origin binding-scheme binding-initializer value-definition-loc
                make-value-definition make-value-binding make-name)
          (only (lofi source) loc?)
          (prefix (lofi resolved-library) library:))
  (begin

    ;; ---- Resolution and checking ----

    (define (primitive-bindings libraries)
      (let ((bindings '()))
        (for-each (lambda (library)
                    (for-each (lambda (entry)
                                (let ((binding (library:named-binding-definition entry)))
                                  (when (and (eq? (binding-kind binding) 'primitive) (not (assq binding bindings)))
                                    (set! bindings (cons (cons binding (binding-payload binding)) bindings)))))
                              (library:library-exports library))) libraries)
        bindings))
    (define (raise-source-diagnostic failure)
      (let ((details (and (error-object? failure) (error-object-irritants failure))))
        (if (and (pair? details) (loc? (car details)))
            (apply strict-error (car details) (error-object-message failure) (cdr details))
            (raise failure))))

    ;; ---- Compilation from supplied library values ----

    (define (resolved-root libraries key)
      (let ((root (assoc key (resolve-library-map libraries))))
        (unless root (error "Lofi root library not found" key)) (cdr root)))
    (define (library-map->core libraries root-key)
      (guard (failure (else (raise-source-diagnostic failure)))
        (resolved-library->core (resolved-root libraries root-key))))
    (define (resolved-library->core program . trailing-items)
      (let* ((libraries (library:library-dependency-order program))
             (items (apply append (map library:library-body libraries))))
        (infer-program (append items trailing-items) (primitive-bindings libraries) (library:library-loc program))))
    (define (public-entry-binding library entry)
      (let find ((exports (library:library-exports library)))
        (cond ((null? exports)
               (strict-error (library:library-loc library) "entry is not a public export"
                             (entry-library entry) (entry-export entry)))
              ((eq? (entry-export entry) (library:named-binding-name (car exports)))
               (library:named-binding-definition (car exports)))
              (else (find (cdr exports))))))
    (define (checked-binding program origin)
      (let find ((bindings (program-globals program)))
        (cond ((null? bindings) (error "entry binding was lost during checking"))
              ((eq? origin (binding-origin (car bindings))) (car bindings))
              (else (find (cdr bindings))))))
    (define (check-entry-function binding)
      (let* ((scheme (binding-scheme binding)) (source (car (node-data (binding-initializer binding))))
             (loc (node-loc (binding-initializer binding))))
        (unless (and (null? (scheme-variables scheme)) (null? (scheme-variables (binding-scheme source))))
          (strict-error loc "entry requires a monomorphic function; Entry supplies no type arguments"))
        (unless (function-type? (scheme-type scheme)) (strict-error loc "entry export must be a function"))))
    ;; A fresh ABI binding reads the selected export by identity after all
    ;; library initialization. It also gives static/foreign functions ordinary
    ;; closure storage without changing their provider or public identity.
    (define (entry-program libraries entry)
      (unless (entry? entry) (error "compile requires an entry value" entry))
      (let* ((root (resolved-root libraries (entry-library entry)))
             (public (public-entry-binding root entry)) (loc (value-definition-loc public))
             (abi (make-value-definition 'entry loc))
             (core (resolved-library->core root (make-value-binding abi (make-name public loc) loc)))
             (checked (checked-binding core (binding-origin abi))))
        (check-entry-function checked)
        (prepare-entry-generation core checked)))
    (define (compile libraries entry)
      (guard (failure (else (raise-source-diagnostic failure)))
        (let* ((program (entry-program libraries entry))
               (type (value-type (cdar (prepared-exports program)))))
          (emit-artifact (strict-core->wasm program) entry
                         (map resolve (function-domains type)) (resolve (function-result type))))))

    )

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-compiler)
    (import (wasm-native test-utils) (lofi frontend)
            (lofi reader) (lofi syntax-parser) (wasm-native chromium-trace)
            (only (lofi checked) program-body)
            (only (chibi temp-file) call-with-temp-dir)
            (only (srfi 130) string-contains)
            (only (lofi ir) name-definition application-operator lambda-body value-binding-initializer))
    (begin
      (define (test-parsed text)
        (call-with-temp-dir
         "lofi-map-source"
         (lambda (directory preserve)
           (with-chromium-trace-to
            (string-append directory "/parse.json")
            (lambda () (parse-library (car (reader->syntax-list (string->reader "map-compilation.lofi" text)))))))))
      (define (test-map-compilation)
        (let* ((primitive (make-primitive-library primitive-names))
               (provider (test-parsed "(define-library (test math)
                                       (import (only (lofi primitive) i32-add)) (export increment)
                                       (begin (def increment (lambda (x) (i32-add x 1)))))"))
               (app (test-parsed "(define-library (test app) (import (test math))
                                  (begin (increment 41)))"))
               (libraries (list (cons '(lofi primitive) primitive) (cons '(test math) provider)
                                (cons '(test app) app))))
          (expect (resolve (program-type (library-map->core libraries '(test app)))) 'I32)
          (expect (resolve (program-type (library-map->core libraries '(test app)))) 'I32)
          (expect (scoped-reference?
                   (name-definition (application-operator
                                     (lambda-body (value-binding-initializer
                                                   (car (lofi-library-declarations provider))))))) #t)))
      (define (test-entry-identity)
        (let* ((provider (test-parsed "(define-library (test provider) (export (rename worker public))
                                       (begin (def private (lambda () (ann 42 I64))) (def worker (lambda () (private)))))"))
               (decoy (test-parsed "(define-library (test decoy) (begin (def worker (lambda () (ann 99 I64)))))"))
               (facade (test-parsed "(define-library (test facade)
                                     (import (rename (test provider) (public local)) (only (test alias)) (only (test decoy)))
                                     (export (rename local main) (rename local again)))"))
               (libraries (list (cons '(test provider) provider) (cons '(test alias) provider)
                                (cons '(test decoy) decoy) (cons '(test facade) facade) (cons '(test other) facade)))
               (origin (binding-origin (cdr (assq 'worker (lofi-library-bindings provider))))))
          (for-each
           (lambda (entry)
             (let* ((program (entry-program libraries entry)) (exports (prepared-exports program))
                    (initializer (value-initializer (cdar exports)))
                    (selected (car (node-data initializer))))
               (expect (map car exports) '(entry))
               (expect (eq? (binding-origin selected) origin) #t)
               (expect (function-result (value-type (cdar exports))) 'I64)))
           (list (make-entry '(test facade) 'main) (make-entry '(test other) 'again)))))
      (define (test-entry-error libraries entry message)
        (expect (guard (failure (else (and (error-object? failure)
                                           (if (string-contains (error-object-message failure) message) #t #f))))
                  (entry-program libraries entry) #f) #t))
      (define (test-entry-rejections)
        (let* ((library (test-parsed "(define-library (test entries)
                                      (export number generic vacuous managed)
                                      (begin (def private (lambda () (ann 42 I64))) (def number (ann 42 I64))
                                        (def generic (All (A) (-> A A)) (lambda (x) x))
                                        (def vacuous (All (A) (-> I32 I32)) (lambda (x) x))
                                        (def managed (-> (Ref I32) (Ref I32)) (lambda (x) x))))"))
               (libraries (list (cons '(test entries) library))))
          (test-entry-error libraries (make-entry '(test absent) 'private) "root library not found")
          (for-each (lambda (name) (test-entry-error libraries (make-entry '(test entries) name) "not a public export"))
                    '(private absent))
          (test-entry-error libraries (make-entry '(test entries) 'number) "must be a function")
          (for-each (lambda (name) (test-entry-error libraries (make-entry '(test entries) name) "Entry supplies no type arguments"))
                    '(generic vacuous))
          (test-entry-error libraries (make-entry '(test entries) 'managed) "scalar parameters")))
      (define (test-entry-function-values)
        (let* ((library (test-parsed "(define-library (test entries) (export inferred foreign)
                                      (begin (let inferred (lambda () (ann 42 I64)))
                                        (define-extern foreign \"test\" \"foreign\" (-> I32 I32))))"))
               (libraries (list (cons '(test entries) library)
                                (cons '(lofi primitive) (make-primitive-library primitive-names)))))
          (for-each (lambda (case)
                      (let ((program (entry-program libraries (make-entry '(test entries) (car case)))))
                        (expect (function-result (value-type (cdar (prepared-exports program)))) (cdr case))))
                    '((inferred . I64) (foreign . I32)))
          (let ((program (entry-program libraries (make-entry '(lofi primitive) 'i32-add))))
            (expect (function-domains (value-type (cdar (prepared-exports program)))) '(I32 I32)))))
      (define (test-compiler)
        (run-test test-map-compilation)
        (run-test test-entry-identity)
        (run-test test-entry-rejections)
        (run-test test-entry-function-values))))
   (else)))
