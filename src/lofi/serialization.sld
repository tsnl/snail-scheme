;; Opt-in typed data transport. Graph identities belong to one traversal;
;; cached Any values are projected only after their declared wire type matches.
(define-library (lofi serialization)
  (export Serialize Deserialize serialize deserialize serialize-with deserialize-with
          SerializeContext DeserializeContext serialize-context deserialize-context
          Witness witness serialize-type deserialize-type
          derive-serialize derive-deserialize
          Sexp sexp->text text->sexp sexp->binary binary->sexp
          serialize-field deserialize-field)
  (import
   (scheme base)
   (scheme immutable)
   (lofi sexp)
   (only (lofi core) data deriving typeclass instance def ann inst match All => ->
         Ref List Vector I32 I64 F32 F64 Bool Char Unit Any String Bytevector
         identifier-name type-name)
   (only (lofi base) Default default ref ref-get ref-set! ref-eq? vector-eq? empty-vector
         string-eq? string-copy string=? string-append i32->i64 i64->i32
         f32->bits bits->f32 f64->bits bits->f64)
   (only (lofi bytes) bytevector-eq? bytevector-copy)
   (only (lofi scalar-text) datum-fail Symbol string->symbol symbol->string))
  (begin

    ;; ---- Separate capabilities and traversal-owned evidence ----

    (data Witness (T)
      (witness))
    (typeclass Serialize (T)
               (: serialize-type (-> (Witness T) String))
               (: serialize-with (-> SerializeContext T Sexp)))
    (typeclass Deserialize (T)
               (: deserialize-type (-> (Witness T) String))
               (: deserialize-with (-> DeserializeContext Sexp T)))
    (data SerializedObject ()
      (serialized-object
       (tag String serialized-object-tag)
       (value Any serialized-object-value)
       (id I64 serialized-object-id)))
    (data SerializeContext ()
      (serialize-context
       (objects (Ref (List SerializedObject)) serialized-objects)
       (next (Ref I64) serialized-next)))
    (data DeserializedObject ()
      (deserialized-object
       (tag String deserialized-object-tag)
       (value Any deserialized-object-value)
       (id I64 deserialized-object-id)))
    (data DeserializeContext ()
      (deserialize-context
       (objects (Ref (List DeserializedObject)) deserialized-objects)))
    (def serialize (All (T) (=> ((Serialize T)) (-> T Sexp)))
         (lambda (value)
           (serialize-with (serialize-context (ref (empty-list)) (ref (ann 0 I64))) value)))
    (def deserialize (All (T) (=> ((Deserialize T)) (-> Sexp T)))
         (lambda (value) (deserialize-with (deserialize-context (ref (empty-list))) value)))

    ;; ---- Parse wire shapes before using their contents ----

    (define (invalid message) (datum-fail (string-append "deserialize: " message)))
    (define (expect-list value)
      (match value
        ((sexp-list values) values)
        ((sexp-integer value) (invalid "expected a list"))
        ((sexp-string value) (invalid "expected a list"))
        ((sexp-symbol value) (invalid "expected a list"))
        ((sexp-bytes value) (invalid "expected a list"))))
    (define (expect-symbol value)
      (match value
        ((sexp-symbol value) value)
        ((sexp-list values) (invalid "expected a symbol"))
        ((sexp-integer value) (invalid "expected a symbol"))
        ((sexp-string value) (invalid "expected a symbol"))
        ((sexp-bytes value) (invalid "expected a symbol"))))
    (define (expect-integer value)
      (match value
        ((sexp-integer value) value)
        ((sexp-list values) (invalid "expected an integer"))
        ((sexp-symbol value) (invalid "expected an integer"))
        ((sexp-string value) (invalid "expected an integer"))
        ((sexp-bytes value) (invalid "expected an integer"))))
    (define (take! cursor)
      (let ((values (ref-get cursor)))
        (when (null? values) (invalid "missing field"))
        (ref-set! cursor (cdr values))
        (car values)))
    (define (finish! cursor)
      (unless (null? (ref-get cursor)) (invalid "unexpected extra fields")))
    (define (expect-tag! cursor expected)
      (let ((actual (expect-symbol (take! cursor))))
        (unless (string=? actual expected)
          (invalid (string-append "expected " expected ", received " actual)))))
    (define (tagged-fields value tag)
      (let ((cursor (ref (expect-list value))))
        (expect-tag! cursor tag) cursor))
    (define (scalar-payload value tag)
      (let* ((cursor (tagged-fields value tag)) (payload (take! cursor)))
        (finish! cursor) payload))
    (define (scalar tag payload) (sexp-list (list (sexp-symbol tag) payload)))
    (define (record-fields value tag)
      (let ((cursor (tagged-fields value "data")))
        (expect-tag! cursor tag) cursor))
    (define (read-field! cursor name)
      (let* ((field (tagged-fields (take! cursor) name)) (value (take! field)))
        (finish! field) value))

    ;; ---- Shared mutable storage receives one portable object number ----

    (define (find-serialized objects tag same?)
      (if (null? objects) (ann -1 I64)
          (let ((object (car objects)))
            (if (and (string=? tag (serialized-object-tag object))
                     (same? (serialized-object-value object)))
                (serialized-object-id object)
                (find-serialized (cdr objects) tag same?)))))
    (define (remember-serialized! context tag value)
      (let ((id (ref-get (serialized-next context))))
        (ref-set! (serialized-next context) (+ id (ann 1 I64)))
        (ref-set! (serialized-objects context)
                  (cons (serialized-object tag value id) (ref-get (serialized-objects context)))) id))
    (define (serialize-object context tag value same? contents)
      (let ((old (find-serialized (ref-get (serialized-objects context)) tag same?)))
        (if (>= old (ann 0 I64))
            (sexp-list (list (sexp-symbol "link") (sexp-integer old) (sexp-symbol tag)))
            (let ((id (remember-serialized! context tag value)))
              (sexp-list (list (sexp-symbol "object") (sexp-integer id)
                               (sexp-symbol tag) (contents)))))))
    (define (find-deserialized objects id)
      (if (or (null? objects) (= id (deserialized-object-id (car objects)))) objects
          (find-deserialized (cdr objects) id)))
    (define (check-object-identity context id)
      (when (or (< id (ann 0 I64))
                (not (null? (find-deserialized (ref-get (deserialized-objects context)) id))))
        (invalid "negative or duplicate object identity")))
    ;; deserialize-object has proved this identity fresh before allocation.
    (define (remember-deserialized! context tag id value)
      (ref-set! (deserialized-objects context)
                (cons (deserialized-object tag value id) (ref-get (deserialized-objects context)))))
    (define (resolve-link context tag id)
      (let ((found (find-deserialized (ref-get (deserialized-objects context)) id)))
        (when (null? found) (invalid "unknown or forward object reference"))
        (unless (string=? tag (deserialized-object-tag (car found)))
          (invalid "object reference has the wrong type"))
        (deserialized-object-value (car found))))
    ;; create must register storage before recursively decoding its contents.
    ;; The context is private until the complete root has been reconstructed.
    (define (deserialize-object context tag value create)
      (let* ((cursor (ref (expect-list value))) (kind (expect-symbol (take! cursor)))
             (id (expect-integer (take! cursor))))
        (expect-tag! cursor tag)
        (cond ((string=? kind "link") (finish! cursor) (resolve-link context tag id))
              ((string=? kind "object")
               (let ((payload (take! cursor)))
                 (finish! cursor) (check-object-identity context id) (create id payload)))
              (else (invalid "expected object definition or reference")))))

    ;; ---- Concrete scalar instances never accept arbitrary Any values ----

    (instance serialize-i32 (Serialize I32)
              (serialize-type (lambda (type) "I32"))
              (serialize-with (lambda (context value) (scalar "I32" (sexp-integer (i32->i64 value))))))
    (define (decode-i32 value tag)
      (let ((number (expect-integer (scalar-payload value tag))))
        (when (or (< number (ann -2147483648 I64)) (> number (ann 2147483647 I64)))
          (invalid "I32 outside its signed range"))
        (i64->i32 number)))
    (instance deserialize-i32 (Deserialize I32)
              (deserialize-type (lambda (type) "I32"))
              (deserialize-with (lambda (context value) (decode-i32 value "I32"))))
    (instance serialize-i64 (Serialize I64)
              (serialize-type (lambda (type) "I64"))
              (serialize-with (lambda (context value) (scalar "I64" (sexp-integer value)))))
    (instance deserialize-i64 (Deserialize I64)
              (deserialize-type (lambda (type) "I64"))
              (deserialize-with (lambda (context value) (expect-integer (scalar-payload value "I64")))))
    (instance serialize-f32 (Serialize F32)
              (serialize-type (lambda (type) "F32"))
              (serialize-with (lambda (context value) (scalar "F32" (sexp-integer (i32->i64 (f32->bits value)))))))
    (instance deserialize-f32 (Deserialize F32)
              (deserialize-type (lambda (type) "F32"))
              (deserialize-with (lambda (context value) (bits->f32 (decode-i32 value "F32")))))
    (instance serialize-f64 (Serialize F64)
              (serialize-type (lambda (type) "F64"))
              (serialize-with (lambda (context value) (scalar "F64" (sexp-integer (f64->bits value))))))
    (instance deserialize-f64 (Deserialize F64)
              (deserialize-type (lambda (type) "F64"))
              (deserialize-with (lambda (context value) (bits->f64 (expect-integer (scalar-payload value "F64"))))))
    (instance serialize-bool (Serialize Bool)
              (serialize-type (lambda (type) "Bool"))
              (serialize-with (lambda (context value) (scalar "Bool" (sexp-symbol (if value "true" "false"))))))
    (instance deserialize-bool (Deserialize Bool)
              (deserialize-type (lambda (type) "Bool"))
              (deserialize-with
               (lambda (context value)
                 (let ((name (expect-symbol (scalar-payload value "Bool"))))
                   (cond ((string=? name "true") #t) ((string=? name "false") #f)
                         (else (invalid "expected true or false")))))))
    (instance serialize-char (Serialize Char)
              (serialize-type (lambda (type) "Char"))
              (serialize-with (lambda (context value) (scalar "Char" (sexp-integer (char->integer value))))))
    (instance deserialize-char (Deserialize Char)
              (deserialize-type (lambda (type) "Char"))
              (deserialize-with
               (lambda (context value)
                 (let ((code (expect-integer (scalar-payload value "Char"))))
                   (when (or (< code (ann 0 I64)) (> code (ann 1114111 I64))
                             (and (>= code (ann 55296 I64)) (<= code (ann 57343 I64))))
                     (invalid "invalid Unicode scalar"))
                   (integer->char code)))))
    (instance serialize-unit (Serialize Unit)
              (serialize-type (lambda (type) "Unit"))
              (serialize-with (lambda (context value) (sexp-list (list (sexp-symbol "Unit"))))))
    (instance deserialize-unit (Deserialize Unit)
              (deserialize-type (lambda (type) "Unit"))
              (deserialize-with (lambda (context value) (finish! (tagged-fields value "Unit")))))
    (define (serialize-string context value)
      (serialize-object context "String" (ann value Any)
                        (lambda (old) (string-eq? value (ann old String)))
                        (lambda () (sexp-string (string-copy value)))))
    (define (decode-string value)
      (match value
        ((sexp-string value) (string-copy value))
        ((sexp-list values) (invalid "expected string contents"))
        ((sexp-symbol value) (invalid "expected string contents"))
        ((sexp-integer value) (invalid "expected string contents"))
        ((sexp-bytes value) (invalid "expected string contents"))))
    (define (deserialize-string context value)
      (ann (deserialize-object context "String" value
                               (lambda (id payload)
                                 (let ((text (decode-string payload)))
                                   (remember-deserialized! context "String" id (ann text Any)) (ann text Any)))) String))
    (instance serialize-string-instance (Serialize String)
              (serialize-type (lambda (type) "String"))
              (serialize-with serialize-string))
    (instance deserialize-string-instance (Deserialize String)
              (deserialize-type (lambda (type) "String"))
              (deserialize-with deserialize-string))
    (instance serialize-symbol (Serialize Symbol)
              (serialize-type (lambda (type) "Symbol"))
              (serialize-with (lambda (context value) (scalar "Symbol" (sexp-symbol (symbol->string value))))))
    (instance deserialize-symbol (Deserialize Symbol)
              (deserialize-type (lambda (type) "Symbol"))
              (deserialize-with (lambda (context value) (string->symbol (expect-symbol (scalar-payload value "Symbol"))))))
    (define (serialize-bytes context value)
      (serialize-object context "Bytevector" (ann value Any)
                        (lambda (old) (bytevector-eq? value (ann old Bytevector)))
                        (lambda () (sexp-bytes (bytevector-copy value)))))
    (define (decode-bytes value)
      (match value
        ((sexp-bytes value) (bytevector-copy value))
        ((sexp-list values) (invalid "expected byte contents"))
        ((sexp-symbol value) (invalid "expected byte contents"))
        ((sexp-integer value) (invalid "expected byte contents"))
        ((sexp-string value) (invalid "expected byte contents"))))
    (define (deserialize-bytes context value)
      (ann (deserialize-object context "Bytevector" value
                               (lambda (id payload)
                                 (let ((bytes (decode-bytes payload)))
                                   (remember-deserialized! context "Bytevector" id (ann bytes Any)) (ann bytes Any)))) Bytevector))
    (instance serialize-bytes-instance (Serialize Bytevector)
              (serialize-type (lambda (type) "Bytevector"))
              (serialize-with serialize-bytes))
    (instance deserialize-bytes-instance (Deserialize Bytevector)
              (deserialize-type (lambda (type) "Bytevector"))
              (deserialize-with deserialize-bytes))

    ;; ---- Typed collection operations share their enclosing traversal ----

    (define (map-values function values)
      (if (null? values) (empty-list)
          (cons (function (car values)) (map-values function (cdr values)))))
    (define (serialize-list tag encode values)
      (scalar tag (sexp-list (map-values encode values))))
    (define (deserialize-list tag decode value)
      (map-values decode (expect-list (scalar-payload value tag))))
    (def serialize-reference (All (T) (-> SerializeContext String (-> T Sexp) (Ref T) Sexp))
         (lambda (context tag encode value)
           (serialize-object context tag (ann value Any)
                             (lambda (old) (ref-eq? value (ann old (Ref T))))
                             (lambda () (encode (ref-get value))))))
    (def deserialize-reference
         (All (T) (-> DeserializeContext String (-> T) (-> Sexp T) Sexp (Ref T)))
         (lambda (context tag seed decode value)
           (ann (deserialize-object context tag value
                                    (lambda (id payload)
                                      (let ((storage (ref (seed))))
                                        (remember-deserialized! context tag id (ann storage Any))
                                        (ref-set! storage (decode payload)) (ann storage Any)))) (Ref T))))
    (define (encode-elements encode values index)
      (if (= index (vector-length values)) (empty-list)
          (cons (encode (vector-ref values index))
                (encode-elements encode values (+ index (ann 1 I64))))))
    (def serialize-vector (All (T) (-> SerializeContext String (-> T Sexp) (Vector T) Sexp))
         (lambda (context tag encode value)
           (serialize-object context tag (ann value Any)
                             (lambda (old) (vector-eq? value (ann old (Vector T))))
                             (lambda () (sexp-list (encode-elements encode value (ann 0 I64)))))))
    (define (value-count values)
      (if (null? values) (ann 0 I64) (+ (ann 1 I64) (value-count (cdr values)))))
    (define (fill-elements! storage values decode index)
      (unless (null? values)
        (vector-set! storage index (decode (car values)))
        (fill-elements! storage (cdr values) decode (+ index (ann 1 I64)))))
    (def deserialize-vector
         (All (T) (-> DeserializeContext String (-> T) (-> Sexp T) Sexp (Vector T)))
         (lambda (context tag seed decode value)
           (ann (deserialize-object context tag value
                                    (lambda (id payload)
                                      (let* ((values (expect-list payload))
                                             (storage (if (null? values) (empty-vector) (make-vector (value-count values) (seed)))))
                                        (remember-deserialized! context tag id (ann storage Any))
                                        (fill-elements! storage values decode (ann 0 I64)) (ann storage Any)))) (Vector T))))

    ;; Container syntax supplies typed callbacks; it does not invent generic
    ;; instances. Every leaf operation still requires its ordinary class evidence.
    (define-syntax field-type
      (syntax-rules (List Ref Vector)
        ((_ method (List T)) (string-append "(List " (field-type method T) ")"))
        ((_ method (Ref T)) (string-append "(Ref " (field-type method T) ")"))
        ((_ method (Vector T)) (string-append "(Vector " (field-type method T) ")"))
        ((_ method T) (method (ann (witness) (Witness T))))))
    (define-syntax serialize-field
      (syntax-rules (List Ref Vector)
        ((_ (List T) context value)
         (serialize-list (field-type serialize-type (List T))
                         (lambda (element) (serialize-field T context element)) value))
        ((_ (Ref T) context value)
         (serialize-reference context (field-type serialize-type (Ref T))
                              (lambda (element) (serialize-field T context element)) value))
        ((_ (Vector T) context value)
         (serialize-vector context (field-type serialize-type (Vector T))
                           (lambda (element) (serialize-field T context element)) value))
        ((_ T context value) (serialize-with context (ann value T)))))
    (define-syntax deserialize-field
      (syntax-rules (List Ref Vector)
        ((_ (List T) context value)
         (deserialize-list (field-type deserialize-type (List T))
                           (lambda (element) (deserialize-field T context element)) value))
        ((_ (Ref T) context value)
         (deserialize-reference context (field-type deserialize-type (Ref T))
                                (ann (lambda () (default)) (-> T))
                                (lambda (element) (deserialize-field T context element)) value))
        ((_ (Vector T) context value)
         (deserialize-vector context (field-type deserialize-type (Vector T))
                             (ann (lambda () (default)) (-> T))
                             (lambda (element) (deserialize-field T context element)) value))
        ((_ T context value) ((inst deserialize-with T) context value))))

    ;; ---- Derivation emits ordinary checked instances from a complete schema ----

    (define-syntax derive-serialize
      (syntax-rules ()
        ((_ (data Name ()
              (constructor
               (field Type accessor ...) ...) ...))
         (instance derived-serialize (Serialize Name)
                   (serialize-type (lambda (type) (type-name Name)))
                   (serialize-with
                    (lambda (context value)
                      (match value
                        ((constructor field ...)
                         (sexp-list
                          (list (sexp-symbol "data")
                                (sexp-symbol (type-name Name))
                                (sexp-symbol (identifier-name constructor))
                                (scalar (identifier-name field) (serialize-field Type context field)) ...))) ...)))))))
    (define-syntax deserialize-constructors
      (syntax-rules ()
        ((_ context name fields) (invalid (string-append "unknown constructor " name)))
        ((_ context name fields (constructor (field Type accessor ...) ...) rest ...)
         (if (string=? name (identifier-name constructor))
             (let ((value (constructor (deserialize-field Type context (read-field! fields (identifier-name field))) ...)))
               (finish! fields) value)
             (deserialize-constructors context name fields rest ...)))))
    (define-syntax derive-deserialize
      (syntax-rules ()
        ((_ (data Name () constructor ...))
         (instance derived-deserialize (Deserialize Name)
                   (deserialize-type (lambda (type) (type-name Name)))
                   (deserialize-with
                    (lambda (context value)
                      (let* ((fields (record-fields value (type-name Name)))
                             (name (expect-symbol (take! fields))))
                        (deserialize-constructors context name fields constructor ...))))))))))
