;; Build-time metadata comes from the exact parsed library compiled to Wasm.
;; This Chibi helper is host orchestration; application/reducer is the common
;; typed product API imported by Scheme and Lofi programs.
(define-library (application manifest bootstrap)
  (export application-source-manifest)
  (import (scheme base) (scheme cxr) (scheme write)
          (only (lofi library) lofi-library-syntax)
          (only (lofi syntax) syntax->datum))
  (begin
    (define (printed value)
      (let ((output (open-output-string))) (write value output) (get-output-string output)))
    (define (declarations clauses)
      (if (null? clauses) '()
          (append (if (and (pair? (car clauses)) (eq? (caar clauses) 'begin)) (cdar clauses) '())
                  (declarations (cdr clauses)))))
    (define (handler-description form)
      (list (cons 'binding (symbol->string (car form)))
            (cons 'payload (list->vector (map (lambda (argument) (printed (cadr argument)))
                                              (cdr (cadr form)))))))
    (define (application-description form)
      (list (cons 'binding (symbol->string (cadr form)))
            (cons 'state (printed (cadr (caddr form))))
            (cons 'schema (caddr (caddr form)))
            (cons 'handlers (list->vector (map handler-description (cddddr form))))))
    (define (applications forms)
      (cond ((null? forms) '())
            ((and (pair? (car forms)) (eq? (caar forms) 'application))
             (cons (application-description (car forms)) (applications (cdr forms))))
            (else (applications (cdr forms)))))
    (define (application-source-manifest library)
      (let ((form (syntax->datum (lofi-library-syntax library))))
        (unless (and (pair? form) (eq? (car form) 'define-library))
          (error "application manifest requires an explicit source library"))
        (list (cons 'library (list->vector (map symbol->string (cadr form))))
              (cons 'applications (list->vector (applications (declarations (cddr form))))))))))
