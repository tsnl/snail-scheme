;; Resolve macro-free SFIR into the shared located IR. Reserve a block's
;; identities before resolving its items, without moving runtime initializers.
;; No step here infers a type, chooses an overload, or executes source code.
(define-library (snail-sfir frontend)
  (export syntax-list->ir-library syntax->ir-library make-primitive-library)
  (import (scheme base) (scheme cxr)
          (snail-scheme syntax) (snail-scheme source) (snail-scheme library)
          (snail-scheme ir) (snail-sfir signatures))
  (begin

    ;; ---- Located syntax and grammar ----

    (define keywords
      '(define lambda if let begin quote ann inst match import export library
         define-data define-class define-instance define-overload define-extern
         : All => -> Ref List Vector Rest
         I32 I64 F32 F64 Bool Char Unit Top Never String Bytevector))
    (define unsupported-keywords
      '(define-syntax syntax-rules let-syntax letrec-syntax cond-expand include
         define-library generate-library set! let* letrec letrec*
         cond and or when unless quasiquote unquote unquote-splicing))
    (define scalar-names '(I32 I64 F32 F64 Bool Char Unit Top Never String Bytevector))
    (define (fail source message . details)
      (apply error message (syntax-loc source) details))
    (define (parts form)
      (unless (and (list-syntax? form) (null? (list-syntax-improper-tail form)))
        (fail form "expected a proper SFIR form"))
      (list-syntax-elements form))
    (define (identifier form)
      (unless (syntax-identifier? form) (fail form "expected an identifier"))
      (atom-syntax-value form))
    (define (head form)
      (and (list-syntax? form) (pair? (list-syntax-elements form))
           (syntax-identifier? (car (list-syntax-elements form)))
           (atom-syntax-value (car (list-syntax-elements form)))))
    (define (arguments form count)
      (let ((items (parts form)))
        (unless (= (length items) (+ count 1)) (fail form "wrong form arity" count))
        (cdr items)))
    (define (binder-name form)
      (let ((name (identifier form)))
        (when (or (memq name keywords) (memq name unsupported-keywords))
          (fail form "reserved SFIR keyword cannot be a binding" name))
        name))
    (define (unique-names names source)
      (unless (null? names)
        (when (memq (car names) (cdr names)) (fail source "duplicate binding" (car names)))
        (unique-names (cdr names) source)))
    (define (lookup name environment) (let ((entry (assq name environment))) (and entry (cdr entry))))
    (define (resolve form environment)
      (or (lookup (identifier form) environment) (fail form "unbound SFIR name" (identifier form))))
    (define (new-binding form)
      (let ((name (binder-name form))) (cons name (make-value-definition name (syntax-loc form)))))
    (define (new-bindings forms source)
      (let ((bindings (map new-binding forms)))
        (unique-names (map car bindings) source) bindings))
    (define (merge-bindings local additions source)
      (for-each (lambda (entry)
                  (when (assq (car entry) local) (fail source "duplicate binding" (car entry)))) additions)
      (append additions local))

    ;; ---- Library loading and import identities ----

    (define-record-type <modules>
      (make-modules loader cache families) modules?
      (loader modules-loader) (cache modules-cache set-modules-cache!)
      (families modules-families set-modules-families!))
    (define (initial-modules loader libraries)
      (make-modules loader (map (lambda (library) (cons (library-name library) library)) libraries) '()))
    (define (make-primitive-library names)
      (make-library '(sfir primitive) '()
                    (map (lambda (name) (make-named-binding name (make-value-definition name #f))) names)
                    '() '() #f))
    (define (module-name form)
      (let ((name (map identifier (parts form))))
        (when (null? name) (fail form "library name must not be empty")) name))
    (define (load-module name use modules loading)
      (when (member name loading) (fail use "cyclic library import" name))
      (let ((cached (assoc name (modules-cache modules))))
        (if cached (cdr cached)
            (let ((source ((modules-loader modules) name)))
              (unless source (fail use "SFIR library not found" name))
              (parse-library source modules loading name)))))
    (define (library-environment library)
      (map (lambda (binding) (cons (named-binding-name binding) (named-binding-definition binding)))
           (library-exports library)))
    (define (merge-imports environment additions source)
      (if (null? additions) environment
          (let* ((entry (car additions)) (old (assq (car entry) environment)))
            (when (and old (not (eq? (cdr old) (cdr entry))))
              (fail source "conflicting imported bindings" (car entry)))
            (merge-imports (if old environment (cons entry environment)) (cdr additions) source))))
    (define (select-imports bindings forms keep? source)
      (let ((names (map identifier forms)))
        (for-each (lambda (name) (unless (assq name bindings) (fail source "unknown import" name))) names)
        (let select ((entries bindings))
          (cond ((null? entries) '())
                ((eq? (and (memq (caar entries) names) #t) keep?)
                 (cons (car entries) (select (cdr entries))))
                (else (select (cdr entries)))))))
    (define (prefix-imports bindings forms source)
      (unless (= (length forms) 1) (fail source "prefix requires one identifier"))
      (let ((prefix (symbol->string (identifier (car forms)))))
        (map (lambda (entry)
               (cons (string->symbol (string-append prefix (symbol->string (car entry)))) (cdr entry))) bindings)))
    (define (rename-imports bindings forms source)
      (let ((renamings (map (lambda (form)
                              (let ((names (parts form)))
                                (unless (= (length names) 2) (fail form "expected old and new import names"))
                                (cons (identifier (car names)) (binder-name (cadr names))))) forms)))
        (unique-names (map car renamings) source)
        (for-each (lambda (entry) (unless (assq (car entry) bindings) (fail source "unknown import" (car entry)))) renamings)
        (map (lambda (entry)
               (let ((rename (assq (car entry) renamings)))
                 (cons (if rename (cdr rename) (car entry)) (cdr entry)))) bindings)))
    (define (modify-import tag bindings forms source)
      (let ((result (case tag
                      ((only) (select-imports bindings forms #t source))
                      ((except) (select-imports bindings forms #f source))
                      ((prefix) (prefix-imports bindings forms source))
                      ((rename) (rename-imports bindings forms source)))))
        (unique-names (map car result) source)
        (for-each (lambda (entry)
                    (when (or (memq (car entry) keywords) (memq (car entry) unsupported-keywords))
                      (fail source "import cannot bind a grammar keyword" (car entry)))) result)
        result))
    (define (parse-import-set form modules loading)
      (let ((items (parts form)) (tag (head form)))
        (if (memq tag '(only except prefix rename))
            (begin
              (when (< (length items) 2) (fail form "missing modified import set"))
              (let-values (((library bindings) (parse-import-set (cadr items) modules loading)))
                (values library (modify-import tag bindings (cddr items) form))))
            (let ((library (load-module (module-name form) form modules loading)))
              (values library (library-environment library))))))
    (define (parse-import form modules loading)
      (let loop ((sets (cdr (parts form))) (libraries '()) (bindings '()))
        (if (null? sets)
            (make-import-declaration (reverse libraries)
                                     (map (lambda (entry) (make-named-binding (car entry) (cdr entry))) bindings)
                                     form (syntax-loc form))
            (let-values (((library additions) (parse-import-set (car sets) modules loading)))
              (loop (cdr sets) (cons library libraries) (merge-imports bindings additions form))))))
    (define (import-environment declarations)
      (let loop ((remaining declarations) (environment '()))
        (if (null? remaining) environment
            (let ((declaration (car remaining)))
              (loop (cdr remaining)
                    (merge-imports environment
                                   (map (lambda (entry) (cons (named-binding-name entry) (named-binding-definition entry)))
                                        (import-declaration-bindings declaration))
                                   (import-declaration-source declaration)))))))
    (define (parse-export form environment)
      (if (syntax-identifier? form)
          (make-named-binding (identifier form) (resolve form environment))
          (let ((names (arguments form 2)))
            (unless (eq? (head form) 'rename) (fail form "unsupported export form"))
            (make-named-binding (binder-name (cadr names)) (resolve (car names) environment)))))
    (define (select-forms forms tag)
      (let loop ((forms forms))
        (cond ((null? forms) '()) ((eq? (head (car forms)) tag) (cons (car forms) (loop (cdr forms))))
              (else (loop (cdr forms))))))
    (define (body-forms forms)
      (let loop ((forms forms))
        (cond ((null? forms) '()) ((memq (head (car forms)) '(import export)) (loop (cdr forms)))
              (else (cons (car forms) (loop (cdr forms)))))))
    (define (resolve-library name forms source modules loading)
      (let* ((imports (map (lambda (form) (parse-import form modules loading)) (select-forms forms 'import)))
             (bindings (import-environment imports)))
        (let-values (((items environment) (resolve-body (body-forms forms) '() bindings modules)))
          (let ((exports (map (lambda (form) (parse-export form environment))
                              (apply append (map (lambda (form) (cdr (parts form))) (select-forms forms 'export))))))
            (unique-names (map named-binding-name exports) source)
            (make-library name imports exports
                          (map library-name (apply append (map import-declaration-libraries imports)))
                          items (syntax-loc source))))))
    (define (parse-library form modules loading expected)
      (unless (eq? (head form) 'library) (fail form "expected an SFIR library"))
      (let* ((items (parts form)) (name (and (pair? (cdr items)) (module-name (cadr items)))))
        (unless name (fail form "library requires a name"))
        (when (and expected (not (equal? name expected))) (fail form "library name does not match import" expected))
        (let ((library (resolve-library name (cddr items) form modules (cons name loading))))
          (set-modules-cache! modules (cons (cons name library) (modules-cache modules))) library)))
    (define (syntax->ir-library form loader libraries)
      (parse-library form (initial-modules loader libraries) '() #f))
    (define (syntax-list->ir-library forms loader libraries)
      (when (null? forms) (error "SFIR program is empty"))
      (let ((modules (initial-modules loader libraries)))
        (if (and (null? (cdr forms)) (eq? (head (car forms)) 'library))
            (parse-library (car forms) modules '() #f)
            (resolve-library #f forms (car forms) modules '()))))

    ;; ---- Reserve block identities before resolving initializers ----

    (define (definition-parts form)
      (let ((items (cdr (parts form))))
        (unless (memv (length items) '(2 3)) (fail form "define requires a name, optional type, and initializer"))
        (binder-name (car items)) items))
    (define (class-parts form)
      (let* ((items (cdr (parts form))) (header (and (pair? items) (parts (car items)))))
        (unless (and header (pair? header) (pair? (cdr header))) (fail form "class requires type parameters"))
        (list (car header) (cdr header) (cdr items))))
    (define (data-parts form)
      (let* ((items (cdr (parts form)))
             (header (and (pair? items) (if (syntax-identifier? (car items)) (list (car items)) (parts (car items))))))
        (unless (and (pair? header) (pair? (cdr items))) (fail form "data requires a name and constructors"))
        (list (car header) (cdr header) (cdr items))))
    (define (field-parts form)
      (let ((items (parts form)))
        (unless (memv (length items) '(2 3)) (fail form "field requires a name, type and optional accessor"))
        (identifier (car items)) items))
    (define (data-identifiers form)
      (let ((declaration (data-parts form)))
        (cons (car declaration)
              (apply append
                     (map (lambda (row)
                            (let ((items (parts row)))
                              (when (null? items) (fail row "constructor requires a name"))
                              (cons (car items) (apply append (map (lambda (field) (cddr (field-parts field))) (cdr items))))))
                          (caddr declaration))))))
    (define (declaration-identifiers form)
      (case (head form)
        ((define) (list (car (definition-parts form))))
        ((define-extern) (list (car (arguments form 4))))
        ((define-data) (data-identifiers form))
        ((define-class)
         (let ((declaration (class-parts form)))
           (cons (car declaration) (map (lambda (method) (car (arguments method 2))) (caddr declaration)))))
        (else '())))
    (define (reserve-overload form local outer modules)
      (let* ((name (car (definition-parts form))) (symbol (binder-name name))
             (existing (lookup symbol (append local outer))))
        (if existing
            (begin
              (unless (memq existing (modules-families modules)) (fail name "overload collides with an ordinary binding" symbol))
              local)
            (let ((binding (new-binding name)))
              (set-modules-families! modules (cons (cdr binding) (modules-families modules)))
              (cons binding local)))))
    (define (reserve-body forms outer initial modules)
      (let loop ((forms forms) (local initial))
        (cond ((null? forms) local)
              ((eq? (head (car forms)) 'define-overload)
               (loop (cdr forms) (reserve-overload (car forms) local outer modules)))
              (else (loop (cdr forms) (merge-bindings local (new-bindings (declaration-identifiers (car forms)) (car forms)) (car forms)))))))
    (define (resolve-body forms outer initial modules)
      (let ((environment (append (reserve-body forms outer initial modules) outer)))
        (values (map (lambda (form) (resolve-item form environment modules)) forms) environment)))
    (define (resolve-definition form environment modules)
      (let* ((items (definition-parts form)) (definition (resolve (car items) environment))
             (annotated? (= (length items) 3))
             (initializer (resolve-expression (if annotated? (caddr items) (cadr items)) environment modules)))
        (when annotated?
          (set-binding-declaration!
           definition (make-type-declaration definition (parse-type (cadr items) environment)
                                             (syntax-loc (cadr items)))))
        (make-value-binding definition initializer (syntax-loc form))))
    (define (resolve-item form environment modules)
      (case (head form)
        ((define) (resolve-definition form environment modules))
        ((define-extern) (resolve-extern form environment))
        ((define-data) (resolve-data form environment))
        ((define-class) (resolve-class form environment))
        ((define-instance) (resolve-instance form environment modules))
        ((define-overload) (resolve-overload form environment modules))
        (else (resolve-expression form environment modules))))
    (define (expression-item? item)
      (not (memq (node-kind item) '(bind extern-declaration data-schema class-declaration
                                         instance-declaration overload-declaration))))
    (define (resolve-block forms source environment modules)
      (let-values (((items scope) (resolve-body forms environment '() modules)))
        (when (or (null? items) (not (expression-item? (car (reverse items)))))
          (fail source "block requires a final expression"))
        (make-block items (syntax-loc source))))

    ;; ---- Expressions and lexical bindings ----

    (define (resolve-expression form environment modules)
      (cond ((syntax-identifier? form) (make-name (resolve form environment) (syntax-loc form)))
            ((atom-syntax? form) (make-literal (atom-syntax-value form) (syntax-loc form)))
            ((vector-syntax? form) (make-literal (syntax->datum form) (syntax-loc form)))
            ((list-syntax? form) (resolve-list-expression form environment modules))
            (else (fail form "expected an SFIR expression"))))
    ;; Each dispatch arm is a complete grammar production. Unsupported Scheme
    ;; forms are diagnosed even when they occur in unused function bodies.
    (define (resolve-list-expression form environment modules)
      (when (memq (head form) unsupported-keywords) (fail form "unsupported SFIR form" (head form)))
      (case (head form)
        ((define define-extern define-data define-class define-instance define-overload import export library :)
         (fail form "declaration is not an expression"))
        ((lambda) (resolve-lambda form environment modules))
        ((let) (resolve-let form environment modules))
        ((begin) (resolve-block (cdr (parts form)) form environment modules))
        ((if) (resolve-if form environment modules))
        ((quote) (make-literal (syntax->datum (car (arguments form 1))) (syntax-loc form)))
        ((ann) (resolve-annotation form environment modules))
        ((inst) (resolve-instantiation form environment modules))
        ((match) (resolve-match form environment modules))
        (else (resolve-call form environment modules))))
    (define (resolve-call form environment modules)
      (let ((items (parts form)))
        (when (null? items) (fail form "empty application"))
        (make-application (resolve-expression (car items) environment modules)
                          (map (lambda (item) (resolve-expression item environment modules)) (cdr items))
                          (syntax-loc form))))
    (define (resolve-if form environment modules)
      (let ((items (arguments form 3)))
        (make-conditional (resolve-expression (car items) environment modules)
                          (resolve-expression (cadr items) environment modules)
                          (resolve-expression (caddr items) environment modules) (syntax-loc form))))
    (define (lambda-bindings form)
      (cond ((syntax-identifier? form) (values '() (new-binding form)))
            ((list-syntax? form)
             (let* ((required (new-bindings (list-syntax-elements form) form))
                    (tail (list-syntax-improper-tail form)) (rest (and (not (null? tail)) (new-binding tail))))
               (unique-names (append (map car required) (if rest (list (car rest)) '())) form)
               (values required rest)))
            (else (fail form "expected lambda parameters"))))
    (define (resolve-lambda form environment modules)
      (let ((items (arguments form 2)))
        (let-values (((required rest) (lambda-bindings (car items))))
          (make-lambda (map cdr required) (and rest (cdr rest))
                       (resolve-expression (cadr items) (append required (if rest (list rest) '()) environment) modules)
                       (syntax-loc form)))))
    (define (let-binding-parts form)
      (let ((items (parts form)))
        (unless (= (length items) 2) (fail form "let binding requires a name and initializer")) items))
    ;; Direct lambda application is the checker's established typed-let form.
    ;; Its actuals are checked in the caller scope and eligible binders generalize.
    ;; The generated nodes retain the let site; source child locations survive.
    (define (resolve-let form environment modules)
      (let* ((items (arguments form 2)) (bindings (map let-binding-parts (parts (car items))))
             (names (new-bindings (map car bindings) form))
             (initializers (map (lambda (binding) (resolve-expression (cadr binding) environment modules)) bindings))
             (body (resolve-expression (cadr items) (append names environment) modules)))
        (make-application (make-lambda (map cdr names) #f body (syntax-loc form)) initializers (syntax-loc form))))
    (define (resolve-annotation form environment modules)
      (let ((items (arguments form 2)))
        (make-annotation (resolve-expression (car items) environment modules)
                         (parse-type (cadr items) environment) (syntax-loc form))))
    (define (resolve-instantiation form environment modules)
      (let ((items (cdr (parts form))))
        (when (null? items) (fail form "inst requires a function"))
        (make-instantiation (resolve-expression (car items) environment modules)
                            (map (lambda (type) (parse-type type environment)) (cdr items)) (syntax-loc form))))

    ;; ---- Declared type syntax ----

    (define (type-variables forms source)
      (let ((variables (map (lambda (form) (cons (binder-name form) (make-type-variable (identifier form)))) forms)))
        (unique-names (map car variables) source) variables))
    (define (parse-type form environment)
      (if (syntax-identifier? form)
          (let ((name (identifier form)))
            (cond ((memq name scalar-names) name)
                  ((lookup name environment) =>
                   (lambda (definition) (if (type-variable? definition) definition (list 'record definition))))
                  (else (fail form "unknown SFIR type" name))))
          (parse-compound-type form environment)))
    (define (parse-compound-type form environment)
      (let ((items (parts form)) (tag (head form)))
        (case tag
          ((All) (parse-all form environment))
          ((=>) (parse-qualified form environment))
          ((Ref List Vector Rest) (list tag (parse-type (car (arguments form 1)) environment)))
          ((->)
           (when (null? (cdr items)) (fail form "function type requires a result"))
           (cons '-> (map (lambda (type) (parse-type type environment)) (cdr items))))
          (else
           (when (null? items) (fail form "empty type application"))
           (cons 'record (cons (resolve (car items) environment)
                               (map (lambda (type) (parse-type type environment)) (cdr items))))))))
    (define (parse-all form environment)
      (let* ((items (arguments form 2)) (variables (type-variables (parts (car items)) form))
             (body (parse-type (cadr items) (append variables environment))))
        (unless (arrow-type? (all-body body)) (fail form "All requires a function signature"))
        (list 'All (map cdr variables) body)))
    (define (parse-constraint form environment)
      (let ((items (parts form)))
        (when (< (length items) 2) (fail form "constraint requires a class and type arguments"))
        (cons (resolve (car items) environment) (map (lambda (type) (parse-type type environment)) (cdr items)))))
    (define (parse-qualified form environment)
      (let ((items (arguments form 2)))
        (list '=> (map (lambda (constraint) (parse-constraint constraint environment)) (parts (car items)))
              (parse-type (cadr items) environment))))

    ;; ---- Data, classes, overloads and foreign declarations ----

    (define (resolve-data form environment)
      (let* ((items (data-parts form)) (variables (type-variables (cadr items) form))
             (scope (append variables environment)))
        (make-data-schema (resolve (car items) environment) (map cdr variables)
                          (map (lambda (row) (resolve-data-case row scope environment)) (caddr items))
                          (syntax-loc form))))
    (define (resolve-data-case form scope environment)
      (let* ((items (parts form))
             (fields (map (lambda (field)
                            (let ((row (field-parts field)))
                              (list (identifier (car row)) (parse-type (cadr row) scope)
                                    (and (pair? (cddr row)) (resolve (caddr row) environment))))) (cdr items))))
        (unique-names (map car fields) form)
        (list (resolve (car items) environment) fields)))
    (define (resolve-match form environment modules)
      (let ((items (cdr (parts form))))
        (when (< (length items) 2) (fail form "match requires a subject and constructor arms"))
        (make-match (resolve-expression (car items) environment modules)
                    (map (lambda (arm) (resolve-match-arm arm environment modules)) (cdr items)) (syntax-loc form))))
    (define (resolve-match-arm form environment modules)
      (let ((items (parts form)))
        (unless (= (length items) 2) (fail form "match arm requires a pattern and one body expression"))
        (let ((pattern (parts (car items))))
          (when (null? pattern) (fail form "match pattern requires a constructor"))
          (let ((bindings (new-bindings (cdr pattern) (car items))))
            (list (resolve (car pattern) environment)
                  (make-lambda (map cdr bindings) #f
                               (resolve-expression (cadr items) (append bindings environment) modules) (syntax-loc form)))))))
    (define (resolve-class form environment)
      (let* ((items (class-parts form)) (variables (type-variables (cadr items) form))
             (scope (append variables environment)))
        (make-class-declaration (resolve (car items) environment) (map cdr variables)
                                (map (lambda (method) (resolve-method method scope environment)) (caddr items)) (syntax-loc form))))
    (define (resolve-method form scope environment)
      (unless (eq? (head form) ':) (fail form "class method requires a signature"))
      (let* ((items (arguments form 2)) (type (parse-type (cadr items) scope)))
        (unless (arrow-type? type) (fail form "class method requires a fixed function signature"))
        (list (resolve (car items) environment) type)))
    (define (resolve-instance form environment modules)
      (let* ((items (cdr (parts form)))
             (constraint (if (pair? items) (parse-constraint (car items) environment) (fail form "instance requires a class"))))
        (make-instance-declaration
         (car constraint) (cdr constraint)
         (map (lambda (method)
                (let ((row (parts method)))
                  (unless (= (length row) 2) (fail method "instance method requires an implementation"))
                  (cons (resolve (car row) environment) (resolve-expression (cadr row) environment modules)))) (cdr items))
         (syntax-loc form))))
    (define (resolve-overload form environment modules)
      (let* ((items (definition-parts form)) (annotated? (= (length items) 3))
             (signature (and annotated? (parse-type (cadr items) environment))))
        (when (and signature (not (arrow-type? (all-body signature)))) (fail form "overload requires a function signature"))
        (make-overload-declaration (resolve (car items) environment) signature
                                   (resolve-expression (if annotated? (caddr items) (cadr items)) environment modules) (syntax-loc form))))
    (define (resolve-extern form environment)
      (let* ((items (arguments form 4)) (module (syntax->datum (cadr items)))
             (symbol (syntax->datum (caddr items))))
        (unless (and (string? module) (string? symbol)) (fail form "extern provider and symbol must be literal strings"))
        (make-extern-declaration (resolve (car items) environment) module symbol
                                 (parse-type (cadddr items) environment) (syntax-loc form))))))
