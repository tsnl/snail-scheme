;; Parse macro-free SFIR into a library value without obtaining dependencies.
;; Local lexical references are bound now; imported names retain their scope.
;; The final source adapters collect dependencies and call the explicit resolver.
(define-library (snail-sfir frontend)
  (export parse-library syntax-list->sfir-library collect-library-map sfir-binding-name?
          syntax-list->ir-library syntax->ir-library make-primitive-library)
  (import (scheme base) (scheme cxr)
          (snail-scheme syntax) (snail-scheme source) (snail-scheme library)
          (snail-scheme ir) (snail-sfir signatures) (snail-sfir library))
  (begin

    ;; ---- Located syntax and grammar ----

    (define keywords
      '(def lambda if let begin ann inst match import export define-library
            datatype typeclass instance define-overload define-extern
            : All => -> Ref List Vector Rest Type Constraint Kind-> Evidence
            I32 I64 F32 F64 Bool Char Unit Any Never String Bytevector))
    (define unsupported-keywords
      '(define-syntax syntax-rules let-syntax letrec-syntax cond-expand include
         define library define-data define-class define-instance quote Top
         generate-library set! let* letrec letrec*
         cond and or when unless quasiquote unquote unquote-splicing))
    (define scalar-names '(I32 I64 F32 F64 Bool Char Unit Any Never String Bytevector))
    (define (fail source message . details)
      (apply error message (syntax-loc source) details))
    (define (parts form)
      (unless (and (list-syntax? form) (null? (list-syntax-improper-tail form)))
        (fail form "expected a proper SFIR form"))
      (list-syntax-elements form))
    (define (identifier form)
      (unless (syntax-identifier? form) (fail form "expected an identifier"))
      (atom-syntax-value form))
    (define (head form)
      (and (list-syntax? form) (pair? (list-syntax-elements form))
           (syntax-identifier? (car (list-syntax-elements form)))
           (atom-syntax-value (car (list-syntax-elements form)))))
    (define (arguments form count)
      (let ((items (parts form)))
        (unless (= (length items) (+ count 1)) (fail form "wrong form arity" count))
        (cdr items)))
    (define (binder-name form)
      (let ((name (identifier form)))
        (unless (sfir-binding-name? name)
          (fail form "reserved SFIR keyword cannot be a binding" name))
        name))
    (define (sfir-binding-name? name)
      (and (symbol? name) (not (memq name keywords)) (not (memq name unsupported-keywords))))
    (define (unique-names names source)
      (unless (null? names)
        (when (memq (car names) (cdr names)) (fail source "duplicate binding" (car names)))
        (unique-names (cdr names) source)))
    (define (lookup name environment) (let ((entry (assq name environment))) (and entry (cdr entry))))
    (define-record-type <source-scope>
      (make-source-scope bindings types imports) source-scope?
      (bindings scope-bindings) (types scope-types) (imports scope-imports))
    (define (static-binding? definition)
      (memq (binding-kind definition) '(datatype typeclass instance)))
    (define (type-bindings bindings)
      (cond ((null? bindings) '())
            ((memq (binding-kind (cdar bindings)) '(datatype typeclass instance overload))
             (cons (car bindings) (type-bindings (cdr bindings))))
            (else (type-bindings (cdr bindings)))))
    (define (extend-scope scope bindings)
      (make-source-scope (append bindings (scope-bindings scope))
                         (append (type-bindings bindings) (scope-types scope)) (scope-imports scope)))
    (define (extend-types scope types)
      (make-source-scope (scope-bindings scope) (append types (scope-types scope)) (scope-imports scope)))
    (define (import-reference form scope role)
      (make-scoped-reference (identifier form) (scope-imports scope) role (syntax-loc form)))
    (define (resolve form scope)
      (or (lookup (identifier form) (scope-bindings scope))
          (import-reference form scope 'binding)))
    (define (resolve-value form scope)
      (let ((definition (lookup (identifier form) (scope-bindings scope))))
        (when (and definition (static-binding? definition))
          (fail form "static definition is not a value" (identifier form)))
        (or definition (import-reference form scope 'value))))
    (define (resolve-static form scope kind)
      (let ((definition (lookup (identifier form) (scope-types scope))))
        (when (and definition (not (and (value-definition? definition) (eq? (binding-kind definition) kind))))
          (fail form "expected a static type binding" kind (identifier form)))
        (or definition (import-reference form scope kind))))
    (define (new-binding form)
      (let ((name (binder-name form))) (cons name (make-value-definition name (syntax-loc form)))))
    (define (new-bindings forms source)
      (let ((bindings (map new-binding forms)))
        (unique-names (map car bindings) source) bindings))
    (define (merge-bindings local additions source)
      (for-each (lambda (entry)
                  (when (assq (car entry) local) (fail source "duplicate binding" (car entry)))) additions)
      (append additions local))

    ;; ---- Descriptive imports and exports ----

    (define (make-primitive-library names)
      (let ((bindings (map (lambda (name)
                             (let ((definition (make-value-definition name #f)))
                               (prepare-binding! definition (binding-scheme definition) #f 'primitive name)
                               (cons name definition))) names)))
        (make-sfir-library '(sfir primitive) (make-scope-id) '()
                           (map (lambda (entry) (make-named-binding (car entry) (cdr entry))) bindings)
                           '() bindings #f)))
    (define (module-name form)
      (let ((name (map identifier (parts form))))
        (when (null? name) (fail form "library name must not be empty")) name))
    (define (parse-renamings forms source)
      (let ((renamings (map (lambda (form)
                              (let ((names (parts form)))
                                (unless (= (length names) 2) (fail form "expected old and new import names"))
                                (cons (identifier (car names)) (binder-name (cadr names))))) forms)))
        (unique-names (map car renamings) source) renamings))
    (define (parse-import-set form scope)
      (let ((items (parts form)) (tag (head form)))
        (when (memq tag '(except prefix)) (fail form "unsupported SFIR import modifier" tag))
        (if (memq tag '(only rename))
            (begin
              (when (< (length items) 2) (fail form "missing modified import set"))
              (let* ((from (parse-import-set (cadr items) scope))
                     (names (if (eq? tag 'only) (map identifier (cddr items)) (parse-renamings (cddr items) form))))
                (make-sfir-import (sfir-import-provider from)
                                  (make-import-selection tag (sfir-import-selection from) names) scope (syntax-loc form))))
            (make-sfir-import (module-name form) (make-import-selection 'all #f '()) scope (syntax-loc form)))))
    (define (parse-import form scope)
      (map (lambda (set) (parse-import-set set scope)) (cdr (parts form))))
    (define (parse-export form environment)
      (if (syntax-identifier? form)
          (make-named-binding (binder-name form) (resolve form environment))
          (let ((names (arguments form 2)))
            (unless (eq? (head form) 'rename) (fail form "unsupported export form"))
            (make-named-binding (binder-name (cadr names)) (resolve (car names) environment)))))
    (define (select-forms forms tag)
      (let loop ((forms forms))
        (cond ((null? forms) '()) ((eq? (head (car forms)) tag) (cons (car forms) (loop (cdr forms))))
              (else (loop (cdr forms))))))
    (define (body-forms forms)
      (let loop ((forms forms))
        (cond ((null? forms) '()) ((memq (head (car forms)) '(import export)) (loop (cdr forms)))
              (else (cons (car forms) (loop (cdr forms)))))))
    (define (parse-library-body name forms source)
      (let* ((scope (make-source-scope '() '() (make-scope-id)))
             (imports (apply append (map (lambda (form) (parse-import form (scope-imports scope)))
                                         (select-forms forms 'import)))))
        (let-values (((items environment) (parse-body (body-forms forms) scope '() #t)))
          (let ((exports (map (lambda (form) (parse-export form environment))
                              (apply append (map (lambda (form) (cdr (parts form))) (select-forms forms 'export))))))
            (unique-names (map named-binding-name exports) source)
            (make-sfir-library name (scope-imports scope) imports exports items
                               (scope-bindings environment) (syntax-loc source))))))
    (define (body-clause-items form)
      (let ((items (cdr (parts form))))
        (for-each (lambda (item)
                    (when (memq (head item) '(import export define-library))
                      (fail item "library directives belong outside body clauses"))) items)
        items))
    (define (library-forms clauses)
      (if (null? clauses) '()
          (let ((clause (car clauses)))
            (case (head clause)
              ((import export) (cons clause (library-forms (cdr clauses))))
              ((begin) (append (body-clause-items clause) (library-forms (cdr clauses))))
              (else (fail clause "expected an import, export or library body clause"))))))
    (define (parse-library form)
      (unless (eq? (head form) 'define-library) (fail form "expected an SFIR define-library"))
      (let* ((items (parts form)) (name (and (pair? (cdr items)) (module-name (cadr items)))))
        (unless name (fail form "library requires a name"))
        (parse-library-body name (library-forms (cddr items)) form)))
    (define (syntax-list->sfir-library forms)
      (when (null? forms) (error "SFIR program is empty"))
      (if (and (null? (cdr forms)) (eq? (head (car forms)) 'define-library))
          (parse-library (car forms))
          (parse-library-body #f forms (car forms))))

    ;; ---- Source driver adapters ----

    ;; The loader chooses one located source per key. A found malformed source
    ;; remains an error. Register before collecting its dependencies so cycles
    ;; terminate here and are diagnosed by identity in map resolution.
    (define (collect-library-map root loader libraries)
      (collect-source-map root loader libraries '()))
    (define (register-source-root root libraries)
      (let* ((key (sfir-library-name root)) (entry (and key (assoc key libraries))))
        (when (and entry (not (eq? (cdr entry) root)))
          (error "source root conflicts with supplied library" (sfir-library-loc root) key))
        (if (and key (not entry)) (cons (cons key root) libraries) libraries)))
    (define (collect-source-map root loader libraries cached)
      (let ((collected (register-source-root root libraries)) (visited '()))
        (define (visit library)
          (unless (memq (sfir-library-id library) visited)
            (set! visited (cons (sfir-library-id library) visited))
            (for-each obtain (sfir-library-imports library))))
        (define (obtain declaration)
          (let* ((name (sfir-import-provider declaration)) (entry (assoc name collected)))
            (cond (entry (visit (cdr entry)))
                  ((assoc name cached) #t)
                  (else (let ((library (load-source-library name declaration loader)))
                          (set! collected (cons (cons name library) collected))
                          (visit library))))))
        (visit root) collected))
    (define (load-source-library name declaration loader)
      (let ((form (loader name)))
        (unless form (error "SFIR library not found" (sfir-import-loc declaration) name))
        (let ((library (parse-library form)))
          (unless (equal? (sfir-library-name library) name)
            (fail form "library name does not match import" name)) library)))
    (define (source-library->ir root loader libraries)
      (let ((parsed '()) (cached '()))
        (for-each (lambda (library)
                    (if (sfir-library? library)
                        (set! parsed (cons (cons (sfir-library-name library) library) parsed))
                        (set! cached (cons (cons (library-name library) library) cached)))) libraries)
        (resolve-source-library root (collect-source-map root loader parsed cached) cached)))
    (define (syntax->ir-library form loader libraries)
      (source-library->ir (parse-library form) loader libraries))
    (define (syntax-list->ir-library forms loader libraries)
      (source-library->ir (syntax-list->sfir-library forms) loader libraries))

    ;; ---- Reserve block identities before resolving initializers ----

    (define (definition-parts form)
      (let ((items (cdr (parts form))))
        (unless (memv (length items) '(2 3)) (fail form "binding requires a name, optional signature, and initializer"))
        (binder-name (car items)) items))
    (define (binding-body items) (if (= (length items) 3) (caddr items) (cadr items)))
    (define (definition-former form)
      (and (eq? (head form) 'def) (head (binding-body (definition-parts form)))))
    (define (static-former? former) (memq former '(datatype typeclass instance)))
    (define (parameterized-former-parts form)
      (let* ((definition (definition-parts form)) (body (binding-body definition))
             (items (cdr (parts body))))
        (when (null? items) (fail body "static former requires a parameter list"))
        (list (car definition) (parts (car items)) (cdr items))))
    (define class-parts parameterized-former-parts)
    (define (data-parts form)
      (let ((items (parameterized-former-parts form)))
        (when (null? (caddr items)) (fail form "datatype requires constructors")) items))
    (define (field-parts form)
      (let ((items (parts form)))
        (unless (memv (length items) '(2 3)) (fail form "field requires a name, type and optional accessor"))
        (identifier (car items)) items))
    (define (data-identifiers form)
      (let ((declaration (data-parts form)))
        (cons (car declaration)
              (apply append
                     (map (lambda (row)
                            (let ((items (parts row)))
                              (when (null? items) (fail row "constructor requires a name"))
                              (cons (car items) (apply append (map (lambda (field) (cddr (field-parts field))) (cdr items))))))
                          (caddr declaration))))))
    (define (declaration-identifiers form)
      (case (head form)
        ((def)
         (case (definition-former form)
           ((datatype) (data-identifiers form))
           ((typeclass)
            (let ((declaration (class-parts form)))
              (cons (car declaration) (map (lambda (method) (car (arguments method 2))) (caddr declaration)))))
           (else (list (car (definition-parts form))))))
        ((define-extern) (list (car (arguments form 4))))
        (else '())))
    (define (declaration-bindings form library?)
      (let ((former (definition-former form))
            (bindings (new-bindings (declaration-identifiers form) form)))
        (when (static-former? former)
          (unless library? (fail form "static definitions require library scope"))
          (let ((definition (cdar bindings)))
            (prepare-binding! definition (binding-scheme definition) #f former #f)))
        bindings))
    (define (reserve-overload form local outer)
      (let* ((name (car (definition-parts form))) (symbol (binder-name name))
             (existing (lookup symbol (append local outer))))
        (if existing
            (begin
              (unless (eq? (binding-kind existing) 'overload)
                (fail name "overload collides with an ordinary binding" symbol))
              local)
            (let ((binding (new-binding name)))
              (prepare-binding! (cdr binding) (binding-scheme (cdr binding)) #f 'overload #f)
              (cons binding local)))))
    (define (reserve-body forms outer initial library?)
      (let loop ((forms forms) (local initial))
        (cond ((null? forms) local)
              ((eq? (head (car forms)) 'define-overload)
               (unless library? (fail (car forms) "overloads require module scope"))
               (loop (cdr forms) (reserve-overload (car forms) local (scope-bindings outer))))
              (else (loop (cdr forms)
                          (merge-bindings local (declaration-bindings (car forms) library?) (car forms)))))))
    (define (check-let-names forms reserved)
      (for-each (lambda (form)
                  (when (eq? (head form) 'let)
                    (let ((name (car (definition-parts form))))
                      (when (lookup (identifier name) reserved)
                        (fail name "let conflicts with a definition or import" (identifier name)))))) forms))
    (define (parse-body forms outer initial library?)
      (let ((reserved (reserve-body forms outer initial library?)))
        (check-let-names forms reserved)
        (parse-statements forms (extend-scope outer reserved))))
    ;; Def identities already exist. A let's initializer uses this scope, then
    ;; its fresh identity shadows only later references. Both emit ordinary
    ;; binding nodes; runtime slots keep their source-order initialization.
    (define (parse-statements forms scope)
      (if (null? forms) (values '() scope)
          (let* ((form (car forms)) (local? (eq? (head form) 'let))
                 (binding (and local? (new-binding (car (definition-parts form)))))
                 (node (if local? (parse-binding form (cdr binding) scope)
                           (parse-item form scope)))
                 (next (if local? (extend-scope scope (list binding)) scope)))
            (let-values (((rest final) (parse-statements (cdr forms) next)))
              (values (cons node rest) final)))))
    (define (signature-scope signature scope)
      (if (and signature (all-type? signature))
          (extend-types scope (map (lambda (variable) (cons (type-variable-name variable) variable))
                                   (all-variables signature))) scope))
    (define (parse-binding form definition scope)
      (let* ((items (definition-parts form))
             (signature (and (= (length items) 3) (parse-signature (cadr items) scope)))
             (initializer (parse-expression (binding-body items) (signature-scope signature scope))))
        (when signature
          (set-binding-declaration! definition
                                    (make-type-declaration definition signature (syntax-loc (cadr items)))))
        (make-value-binding definition initializer (syntax-loc form) (head form))))
    (define (parse-definition form scope)
      (let ((former (definition-former form)))
        (let ((declaration
               (case former
                 ((datatype) (parse-data form scope))
                 ((typeclass) (parse-class form scope))
                 ((instance) (parse-instance form scope))
                 (else (parse-binding form (resolve (car (definition-parts form)) scope) scope)))))
          (if (static-former? former) (attach-static-kind form scope declaration) declaration))))
    (define (parse-item form environment)
      (case (head form)
        ((def) (parse-definition form environment))
        ((define-extern) (parse-extern form environment))
        ((define-overload) (parse-overload form environment))
        (else (parse-expression form environment))))
    (define (expression-item? item)
      (not (memq (node-kind item) '(bind extern-declaration data-schema class-declaration
                                         instance-declaration overload-declaration))))
    (define (parse-block forms source environment)
      (let-values (((items scope) (parse-body forms environment '() #f)))
        (when (or (null? items) (not (expression-item? (car (reverse items)))))
          (fail source "block requires a final expression"))
        (make-block items (syntax-loc source))))

    ;; ---- Expressions and lexical bindings ----

    (define (parse-expression form environment)
      (cond ((syntax-identifier? form) (make-name (resolve-value form environment) (syntax-loc form)))
            ((atom-syntax? form)
             (make-literal (atom-syntax-value form) (syntax-loc form) (atom-syntax-number-spelling form)))
            ((vector-syntax? form) (fail form "vector data is not an SFIR literal"))
            ((list-syntax? form) (parse-list-expression form environment))
            (else (fail form "expected an SFIR expression"))))
    ;; Each dispatch arm is a complete grammar production. Unsupported Scheme
    ;; forms are diagnosed even when they occur in unused function bodies.
    (define (parse-list-expression form environment)
      (when (memq (head form) unsupported-keywords) (fail form "unsupported SFIR form" (head form)))
      (case (head form)
        ((def let datatype typeclass instance define-extern define-overload import export define-library :)
         (fail form "declaration is not an expression"))
        ((lambda) (parse-lambda form environment))
        ((begin) (parse-block (cdr (parts form)) form environment))
        ((if) (parse-if form environment))
        ((ann) (parse-annotation form environment))
        ((inst) (parse-instantiation form environment))
        ((match) (parse-match form environment))
        (else (parse-call form environment))))
    (define (parse-call form environment)
      (let ((items (parts form)))
        (when (null? items) (fail form "empty application"))
        (make-application (parse-expression (car items) environment)
                          (map (lambda (item) (parse-expression item environment)) (cdr items))
                          (syntax-loc form))))
    (define (parse-if form environment)
      (let ((items (arguments form 3)))
        (make-conditional (parse-expression (car items) environment)
                          (parse-expression (cadr items) environment)
                          (parse-expression (caddr items) environment) (syntax-loc form))))
    (define (lambda-bindings form)
      (cond ((syntax-identifier? form) (values '() (new-binding form)))
            ((list-syntax? form)
             (let* ((required (new-bindings (list-syntax-elements form) form))
                    (tail (list-syntax-improper-tail form)) (rest (and (not (null? tail)) (new-binding tail))))
               (unique-names (append (map car required) (if rest (list (car rest)) '())) form)
               (values required rest)))
            (else (fail form "expected lambda parameters"))))
    (define (parse-lambda form environment)
      (let ((items (arguments form 2)))
        (let-values (((required rest) (lambda-bindings (car items))))
          (make-lambda (map cdr required) (and rest (cdr rest))
                       (parse-expression (cadr items) (extend-scope environment (append required (if rest (list rest) '()))))
                       (syntax-loc form)))))
    (define (parse-annotation form environment)
      (let ((items (arguments form 2)))
        (make-annotation (parse-expression (car items) environment)
                         (parse-type (cadr items) environment) (syntax-loc form))))
    (define (parse-instantiation form environment)
      (let ((items (cdr (parts form))))
        (when (< (length items) 2) (fail form "inst requires a name and at least one type argument"))
        (make-instantiation (make-name (resolve-value (car items) environment) (syntax-loc (car items)))
                            (map (lambda (type) (parse-type type environment)) (cdr items)) (syntax-loc form))))

    ;; ---- Declared type syntax ----

    (define (type-variables forms source)
      (let ((variables (map (lambda (form) (cons (binder-name form) (make-type-variable (identifier form) (syntax-loc form)))) forms)))
        (unique-names (map car variables) source) variables))
    (define (parse-type form environment)
      (if (syntax-identifier? form)
          (let ((name (identifier form)))
            (cond ((eq? name 'Any) 'Top)
                  ((memq name scalar-names) name)
                  ((type-variable? (lookup name (scope-types environment)))
                   (lookup name (scope-types environment)))
                  (else (list 'record (resolve-static form environment 'datatype)))))
          (parse-compound-type form environment)))
    (define (parse-compound-type form environment)
      (let ((items (parts form)) (tag (head form)))
        (case tag
          ((All =>) (fail form "All and constraints belong to an attached binding signature"))
          ((Ref List Vector Rest) (list tag (parse-type (car (arguments form 1)) environment)))
          ((->)
           (when (null? (cdr items)) (fail form "function type requires a result"))
           (cons '-> (map (lambda (type) (parse-type type environment)) (cdr items))))
          (else
           (when (< (length items) 2) (fail form "nominal application requires type arguments"))
           (cons 'record (cons (resolve-static (car items) environment 'datatype)
                               (map (lambda (type) (parse-type type environment)) (cdr items))))))))
    (define (parse-signature form environment)
      (if (eq? (head form) 'All) (parse-all form environment) (parse-type form environment)))
    (define (parse-all form environment)
      (let* ((items (arguments form 2)) (variables (type-variables (parts (car items)) form))
             (scope (extend-types environment variables))
             (body (if (eq? (head (cadr items)) '=>) (parse-qualified (cadr items) scope)
                       (parse-type (cadr items) scope))))
        (list 'All (map cdr variables) body)))
    (define (parse-constraint form environment)
      (let ((items (parts form)))
        (when (null? items) (fail form "constraint requires a class"))
        (cons (constraint-definition (car items) environment)
              (map (lambda (type) (parse-type type environment)) (cdr items)))))
    (define (constraint-definition form scope)
      (let ((definition (lookup (identifier form) (scope-types scope))))
        (when (and definition (not (and (value-definition? definition)
                                        (memq (binding-kind definition) '(typeclass overload)))))
          (fail form "constraint requires a typeclass or overload family"))
        (or definition (import-reference form scope 'constraint))))
    (define (parse-qualified form environment)
      (let ((items (arguments form 2)))
        (list '=> (map (lambda (constraint) (parse-constraint constraint environment)) (parts (car items)))
              (parse-type (cadr items) environment))))

    ;; ---- Static kinds ----

    ;; Kinds describe declarations, never runtime values. The checker still
    ;; verifies every field and instance method; a kind annotation is no proof.
    (define (former-kind form scope)
      (let ((former (definition-former form)))
        (if (eq? former 'instance)
            (let* ((body (binding-body (definition-parts form))) (items (cdr (parts body))))
              (when (null? items) (fail body "instance requires a class"))
              (list 'Evidence (parse-constraint (car items) scope)))
            (let* ((items (parameterized-former-parts form))
                   (result (if (eq? former 'datatype) 'Type 'Constraint)) (parameters (cadr items)))
              (if (null? parameters) result (append '(Kind->) (make-list (length parameters) 'Type) (list result)))))))
    (define (parse-kind form scope)
      (if (syntax-identifier? form)
          (let ((name (identifier form)))
            (unless (memq name '(Type Constraint)) (fail form "expected a kind")) name)
          (case (head form)
            ((Evidence) (list 'Evidence (parse-constraint (car (arguments form 1)) scope)))
            ((Kind->)
             (let ((items (cdr (parts form))))
               (when (< (length items) 2) (fail form "kind arrow requires a parameter and result"))
               (cons 'Kind-> (map (lambda (item) (parse-kind item scope)) items))))
            (else (fail form "expected a kind")))))
    (define (attach-static-kind form scope declaration)
      (let ((items (definition-parts form)) (expected (former-kind form scope)))
        (if (= (length items) 3)
            (make-node 'static-kind (syntax-loc (cadr items))
                       (list (parse-kind (cadr items) scope) expected declaration))
            declaration)))

    ;; ---- Data, classes, overloads and foreign declarations ----

    (define (parse-data form environment)
      (let* ((items (data-parts form)) (variables (type-variables (cadr items) form))
             (scope (extend-types environment variables)))
        (make-data-schema (resolve (car items) environment) (map cdr variables)
                          (map (lambda (row) (parse-data-case row scope environment)) (caddr items))
                          (syntax-loc form))))
    (define (parse-data-case form scope environment)
      (let* ((items (parts form))
             (fields (map (lambda (field)
                            (let ((row (field-parts field)))
                              (list (identifier (car row)) (parse-type (cadr row) scope)
                                    (and (pair? (cddr row)) (resolve (caddr row) environment))))) (cdr items))))
        (unique-names (map car fields) form)
        (list (resolve (car items) environment) fields)))
    (define (parse-match form environment)
      (let ((items (cdr (parts form))))
        (when (< (length items) 2) (fail form "match requires a subject and constructor arms"))
        (make-match (parse-expression (car items) environment)
                    (map (lambda (arm) (parse-match-arm arm environment)) (cdr items)) (syntax-loc form))))
    (define (parse-match-arm form environment)
      (let ((items (parts form)))
        (unless (= (length items) 2) (fail form "match arm requires a pattern and one body expression"))
        (let ((pattern (parts (car items))))
          (when (null? pattern) (fail form "match pattern requires a constructor"))
          (let ((bindings (new-bindings (cdr pattern) (car items))))
            (list (resolve (car pattern) environment)
                  (make-lambda (map cdr bindings) #f
                               (parse-expression (cadr items) (extend-scope environment bindings)) (syntax-loc form)))))))
    (define (parse-class form environment)
      (let* ((items (class-parts form)) (variables (type-variables (cadr items) form))
             (scope (extend-types environment variables)))
        (make-class-declaration (resolve (car items) environment) (map cdr variables)
                                (map (lambda (method) (parse-method method scope environment)) (caddr items)) (syntax-loc form))))
    (define (parse-method form scope environment)
      (unless (eq? (head form) ':) (fail form "class method requires a signature"))
      (let* ((items (arguments form 2)) (type (parse-type (cadr items) scope)))
        (unless (arrow-type? type) (fail form "class method requires a fixed function signature"))
        (list (resolve (car items) environment) type)))
    (define (parse-instance form environment)
      (let* ((items (cdr (parts (binding-body (definition-parts form)))))
             (constraint (if (pair? items) (parse-constraint (car items) environment) (fail form "instance requires a class"))))
        (make-instance-declaration
         (resolve (car (definition-parts form)) environment) (car constraint) (cdr constraint)
         (map (lambda (method)
                (let ((row (parts method)))
                  (unless (= (length row) 2) (fail method "instance method requires an implementation"))
                  (cons (resolve (car row) environment) (parse-expression (cadr row) environment)))) (cdr items))
         (syntax-loc form))))
    (define (parse-overload form environment)
      (let ((items (definition-parts form)))
        (unless (= (length items) 3) (fail form "overload requires an explicit signature"))
        (let ((signature (parse-signature (cadr items) environment)))
          (unless (arrow-type? (all-body signature)) (fail form "overload requires a function signature"))
          (make-overload-declaration (resolve (car items) environment) signature
                                     (parse-expression (binding-body items) (signature-scope signature environment)) (syntax-loc form)
                                     (syntax-loc (cadr items))))))
    (define (parse-extern form environment)
      (let* ((items (arguments form 4)) (module (syntax->datum (cadr items)))
             (symbol (syntax->datum (caddr items))))
        (unless (and (string? module) (string? symbol)) (fail form "extern provider and symbol must be literal strings"))
        (make-extern-declaration (resolve (car items) environment) module symbol
                                 (parse-type (cadddr items) environment) (syntax-loc form)))))

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-frontend)
    (import (wasm-native test-utils)
            (only (snail-scheme reader) string->reader)
            (only (snail-scheme syntax-parser) reader->syntax-list))
    (begin
      (define (test-source text . libraries)
        (syntax-list->ir-library (reader->syntax-list (string->reader "frontend-test.sfir" text))
                                 (lambda (name) #f) libraries))
      (define (test-rejected text)
        (expect (guard (failure (else #t)) (test-source text) #f) #t))
      (define (test-parsed text)
        (syntax-list->sfir-library (reader->syntax-list (string->reader "parsed-test.sfir" text))))
      (define (test-library-map . libraries)
        (resolve-library-map (map (lambda (library) (cons (sfir-library-name library) library)) libraries)))
      (define (test-export library name)
        (let loop ((exports (library-exports library)))
          (if (eq? (named-binding-name (car exports)) name) (named-binding-definition (car exports))
              (loop (cdr exports)))))
      (define (test-resolution-error text . providers)
        (expect (guard (failure (else #t)) (apply test-library-map (test-parsed text) providers) #f) #t))
      (define (test-independent-library-parse)
        (let* ((text "(define-library (test app) (import (only (missing dependency) remote))
                        (export answer) (begin (def answer (lambda (x) (remote x)))))")
               (library (test-parsed text)) (other (test-parsed text))
               (definition (car (sfir-library-declarations library)))
               (function (value-binding-initializer definition)) (call (lambda-body function))
               (reference (name-definition (application-operator call))))
          (expect (sfir-library? library) #t)
          (expect (library-id? (sfir-library-id library)) #t)
          (expect (eq? (sfir-library-id library) (sfir-library-id other)) #f)
          (expect (scoped-reference? reference) #t)
          (expect (reference-name reference) 'remote)
          (expect (eq? (reference-scope reference) (sfir-library-scope library)) #t)
          (expect (loc-filename (reference-loc reference)) "parsed-test.sfir")
          (expect (eq? (name-definition (car (application-operands call))) (car (lambda-parameters function))) #t)
          (expect (eq? (binding-origin (value-binding-definition definition))
                       (binding-origin (value-binding-definition (car (sfir-library-declarations other))))) #f)))
      (define (test-map-aliases-and-reexports)
        (let* ((provider (test-parsed "(define-library (test original) (export public)
                                       (begin (def private 42) (def public (lambda () private))))"))
               (bridge (test-parsed "(define-library (test bridge)
                                     (import (rename (only (test left) public) (public alias)))
                                     (export (rename alias relayed)))"))
               (consumer (test-parsed "(define-library (test app)
                                       (import (test right) (rename (test bridge) (relayed public)))
                                       (export public) (begin (def private 0) (public)))"))
               (resolved-map (resolve-library-map (list (cons '(test left) provider) (cons '(test right) provider)
                                                        (cons '(test bridge) bridge) (cons '(test app) consumer))))
               (left (cdr (assoc '(test left) resolved-map))) (right (cdr (assoc '(test right) resolved-map)))
               (app (cdr (assoc '(test app) resolved-map))))
          (expect (eq? left right) #t)
          (expect (eq? (library-id left) (sfir-library-id provider)) #t)
          (expect (eq? (test-export app 'public) (test-export left 'public)) #t)
          (expect (map library-name (library-dependency-order app)) '((test original) (test bridge) (test app)))
          (expect (eq? (binding-origin (value-binding-definition (car (library-body app))))
                       (binding-origin (value-binding-definition (car (library-body left))))) #f)))
      (define (test-library-reuse)
        (let* ((first (test-parsed "(define-library (test provider) (export remote) (begin (def remote 1)))"))
               (second (test-parsed "(define-library (test provider) (export remote) (begin (def remote 2)))"))
               (app (test-parsed "(define-library (test app) (import (test provider))
                                  (export result) (begin (def result remote)))"))
               (one (cdr (assoc '(test app) (test-library-map app first))))
               (two (cdr (assoc '(test app) (test-library-map app second))))
               (read-one (name-definition (value-binding-initializer (car (library-body one)))))
               (read-two (name-definition (value-binding-initializer (car (library-body two))))))
          (expect (eq? (binding-origin (test-export one 'result)) (binding-origin (test-export two 'result))) #t)
          (expect (eq? (test-export one 'result) (test-export two 'result)) #f)
          (expect (eq? (binding-origin read-one) (binding-origin read-two)) #f)
          (expect (literal-value (binding-initializer read-one)) 1)
          (expect (literal-value (binding-initializer read-two)) 2)
          (expect (scoped-reference? (name-definition
                                      (value-binding-initializer (car (sfir-library-declarations app))))) #t)))
      (define (test-simultaneous-import-renames)
        (let* ((provider (test-parsed "(define-library (test provider) (export x y (rename x alias))
                                       (begin (def x 1) (def y 2)))"))
               (swap (test-parsed "(define-library (test swap) (import (rename (only (test provider) x y) (x y) (y x)))
                                   (export x y))"))
               (shared (test-parsed "(define-library (test shared)
                                     (import (rename (only (test provider) x alias) (x z) (alias z))) (export z))"))
               (resolved (test-library-map provider swap shared))
               (original (cdr (assoc '(test provider) resolved)))
               (swapped (cdr (assoc '(test swap) resolved)))
               (merged (cdr (assoc '(test shared) resolved))))
          (expect (eq? (test-export original 'x) (test-export swapped 'y)) #t)
          (expect (eq? (test-export original 'y) (test-export swapped 'x)) #t)
          (expect (eq? (test-export original 'x) (test-export merged 'z)) #t)
          (expect (length (import-declaration-bindings (car (library-imports merged)))) 1)))
      (define (test-imported-static-scopes)
        (let* ((provider (test-parsed "(define-library (test types) (export T C method)
                                       (begin (def T (datatype () (value)))
                                              (def C (typeclass (A) (: method (-> A A))))))"))
               (app (test-parsed "(define-library (test app) (import (test types))
                                  (begin (def identity (-> T T) (lambda (T) (ann T T)))
                                         (def evidence (Evidence (C T))
                                           (instance (C T) (method (lambda (x) x))))))"))
               (resolved (test-library-map app provider))
               (type (test-export (cdr (assoc '(test types) resolved)) 'T))
               (items (library-body (cdr (assoc '(test app) resolved))))
               (function (value-binding-initializer (car items)))
               (annotation (lambda-body function)))
          (expect (eq? (cadr (annotation-type annotation)) type) #t)
          (expect (eq? (name-definition (annotation-expression annotation)) (car (lambda-parameters function))) #t)
          (expect (eq? (cadar (instance-declaration-types (cadr items))) type) #t)))
      (define (test-imported-overload-aliases)
        (let* ((provider (test-parsed "(define-library (test family) (export choose)
                                       (begin (define-overload choose (-> I32 I32) (lambda (x) x))))"))
               (app (test-parsed "(define-library (test app)
                                  (import (rename (test family) (choose left)) (rename (test family) (choose right)))
                                  (export left right) (begin (def before left)
                                    (define-overload left (-> Bool Bool) (lambda (x) x))
                                    (define-overload right (-> I64 I64) (lambda (x) x))))"))
               (resolved (test-library-map app provider))
               (consumer (cdr (assoc '(test app) resolved)))
               (family (test-export (cdr (assoc '(test family) resolved)) 'choose))
               (items (library-body consumer)))
          (expect (eq? (test-export consumer 'left) family) #t)
          (expect (eq? (test-export consumer 'right) family) #t)
          (expect (eq? (name-definition (value-binding-initializer (car items))) family) #t)
          (expect (eq? (overload-declaration-definition (cadr items)) family) #t)
          (expect (eq? (overload-declaration-definition (caddr items)) family) #t)
          (expect (eq? (overload-declaration-member (cadr items)) (overload-declaration-member (caddr items))) #f)))
      (define (test-empty-import-dependency)
        (let* ((provider (test-parsed "(define-library (test provider)
                                       (begin (def C (typeclass (T) (: method (-> T T))))
                                         (def evidence (instance (C I32) (method (lambda (x) x))))))"))
               (app (test-parsed "(define-library (test app) (import (only (test provider))) (begin 42))"))
               (root (cdr (assoc '(test app) (test-library-map app provider))))
               (dependency (car (library-dependency-order root))))
          (expect (length (library-dependency-order root)) 2)
          (expect (import-declaration-bindings (car (library-imports root))) '())
          (expect (node-kind (cadr (library-body dependency))) 'instance-declaration)))
      (define (test-library-map-errors)
        (let ((provider (test-parsed "(define-library (test provider) (export x y) (begin (def x 1) (def y 2)))")))
          (for-each (lambda (text) (test-resolution-error text provider))
                    '("(define-library (test app) (import (test absent)))"
                      "(define-library (test app) (import (only (test provider) absent)))"
                      "(define-library (test app) (import (rename (test provider) (absent x))))"
                      "(define-library (test app) (import (rename (test provider) (x y))))"
                      "(define-library (test app) (import (test provider)) (begin (def x 3)))"
                      "(define-library (test app) (import (test provider)) (begin (let y 3)))"
                      "(define-library (test app) (import (test provider)) (begin (def a x) (def b (lambda () later)) (let later 3)))"
                      "(define-library (test app) (import (test provider)) (begin (def bad x (lambda () 1))))"
                      "(define-library (test app) (import (test provider)) (export absent))"))
          (let ((other (test-parsed "(define-library (test other) (export x) (begin (def x 1)))")))
            (test-resolution-error "(define-library (test app) (import (test provider) (test other)))" provider other)))
        (let ((cycle (test-parsed "(define-library (test origin) (import (test alias)))")))
          (expect (guard (failure (else #t))
                    (resolve-library-map (list (cons '(test alias) cycle))) #f) #t)))
      (define (test-source-collection)
        (let* ((root (test-parsed "(define-library (test app) (import (test provider) (only (test provider))))"))
               (reads 0)
               (libraries (collect-library-map
                           root (lambda (name)
                                  (set! reads (+ reads 1))
                                  (car (reader->syntax-list (string->reader "provider.sfir"
                                                                            "(define-library (test provider) (begin 42))")))) '())))
          (expect reads 1)
          (expect (length libraries) 2)
          (expect (sfir-library? (cdr (assoc '(test provider) libraries))) #t)))
      (define (test-source-cache-conflicts)
        (let* ((provider (test-parsed "(define-library (test provider) (export x) (begin (def x 1)))"))
               (parsed (list (cons '(test provider) provider)))
               (cached (resolve-library-map parsed))
               (app (test-parsed "(define-library (test app) (import (test provider)))")))
          (expect (guard (failure (else (error-object-message failure)))
                    (resolve-source-library app parsed cached)) "duplicate library key")
          (expect (guard (failure (else (error-object-message failure)))
                    (resolve-library-map cached)) "invalid library map entry")))
      (define (test-sequential-scope)
        (let* ((items (library-body (test-source
                                     "(let value 40) (def read (lambda () value)) (let value value) value")))
               (first (value-binding-definition (car items)))
               (second (value-binding-definition (caddr items))))
          (expect (eq? first second) #f)
          (expect (eq? (name-definition (lambda-body (value-binding-initializer (cadr items)))) first) #t)
          (expect (eq? (name-definition (value-binding-initializer (caddr items))) first) #t)
          (expect (eq? (name-definition (cadddr items)) second) #t)))
      (define (test-recursive-scope)
        (let* ((items (library-body (test-source "(def first second) (def second 42) first")))
               (first (value-binding-definition (car items)))
               (second (value-binding-definition (cadr items))))
          (expect (eq? (name-definition (value-binding-initializer (car items))) second) #t)
          (expect (eq? (name-definition (caddr items)) first) #t)))
      (define (test-quantifier-scope)
        (let* ((item (car (library-body (test-source
                                         "(def identity (All (T) (-> T T)) (lambda (T) (ann T T)))"))))
               (signature (type-declaration-type (binding-declaration (value-binding-definition item))))
               (function (value-binding-initializer item)) (annotation (lambda-body function)))
          (expect (eq? (annotation-type annotation) (car (all-variables signature))) #t)
          (expect (eq? (name-definition (annotation-expression annotation)) (car (lambda-parameters function))) #t)))
      (define (test-library-body-scope)
        (let* ((library (test-source "(define-library (test clauses) (export answer)
                                      (begin (def answer later)) (begin (def later 42)))"))
               (items (library-body library)))
          (expect (length items) 2)
          (expect (eq? (name-definition (value-binding-initializer (car items)))
                       (value-binding-definition (cadr items))) #t)
          (expect (eq? (named-binding-definition (car (library-exports library)))
                       (value-binding-definition (car items))) #t)))
      (define (test-static-kinds)
        (let* ((library (test-source "(def Flag Type (datatype () (off) (on)))
                                      (def C (Kind-> Type Constraint) (typeclass (T) (: f (-> T T))))
                                      (def evidence (Evidence (C Flag)) (instance (C Flag) (f (lambda (x) x))))"))
               (items (library-body library)))
          (expect (map node-kind items) '(data-schema class-declaration instance-declaration))
          (expect (value-definition-name (instance-declaration-definition (caddr items))) 'evidence)))
      (define (test-cached-overload-identity)
        (let* ((provider (test-source "(define-library (test provider) (export choose)
                                      (begin (define-overload choose (-> I64 I64) (lambda (x) x))))"))
               (consumer (test-source "(import (test provider))
                                      (define-overload choose (-> Bool Bool) (lambda (x) x))" provider)))
          (expect (eq? (overload-declaration-definition (car (library-body consumer)))
                       (named-binding-definition (car (library-exports provider)))) #t)))
      (define (test-invalid-forms)
        (for-each test-rejected
                  '("(def x 1) (def x 2)" "(let x 1) (def x 2)" "(def x 1) (let x 2)"
                    "(def read (lambda () later)) (let later 42) (read)"
                    "(begin (let x 42))" "(let x x)" "(lambda (x . x) x)"
                    "(begin (def Flag (datatype () (flag))) 0)"
                    "(def Flag Constraint (datatype () (flag)))"
                    "(let Flag (datatype () (flag)))" "(def Flag (datatype () (flag))) Flag"
                    "(define x 1)" "(library (test old))" "(quote ())" "#()" "#(1 2)"
                    "(define-library (test bad) (def x 1))"
                    "(define-library (test bad) (begin (import (sfir base))))"
                    "(import (prefix (sfir base) p:))" "(inst missing)"
                    "(def bad (-> (All (T) (-> T T))) (lambda () 0))")))
      (define (test-explicit-overload-signatures)
        (for-each
         (lambda (text)
           (expect (guard (failure (else (error-object-message failure))) (test-parsed text) #f)
                   "overload requires an explicit signature"))
         '("(define-overload identity (lambda (value) value))"
           "(def identity (All (T) (-> T T)) (lambda (value) value)) (define-overload choose identity)"
           "(define-overload choose (-> Bool Bool) (lambda (value) value))
             (define-overload choose (lambda (value) (ann value I64)))"
           "(define-library (unused) (export) (begin (define-overload unused (lambda (value) value))))")))
      (define (test-frontend)
        (run-test test-independent-library-parse)
        (run-test test-map-aliases-and-reexports)
        (run-test test-library-reuse)
        (run-test test-simultaneous-import-renames)
        (run-test test-imported-static-scopes)
        (run-test test-imported-overload-aliases)
        (run-test test-empty-import-dependency)
        (run-test test-library-map-errors)
        (run-test test-source-collection)
        (run-test test-source-cache-conflicts)
        (run-test test-sequential-scope)
        (run-test test-recursive-scope)
        (run-test test-quantifier-scope)
        (run-test test-library-body-scope)
        (run-test test-static-kinds)
        (run-test test-cached-overload-identity)
        (run-test test-explicit-overload-signatures)
        (run-test test-invalid-forms))))
   (else)))
