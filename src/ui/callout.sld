;; Fit the final painted card before checking its protected rectangles. When no
;; side fits, reserve a context strip and return a smaller world viewport.
(define-library (ui callout)
  (export Callout layout-callout dock-callout callout-rect callout-world callout-side callout-docked
          callout-offset rectangles-overlap?)
  (import
   (scheme base)
   (scheme immutable)
   (ui core)
   (only (lofi core) datatype I32))
  (begin

    ;; ---- Rectangle arithmetic includes the arrow and focus clearance ----

    (define (min a b) (if (< a b) a b))
    (define (max a b) (if (> a b) a b))
    (define (clamp value low high) (max low (min value high)))
    (define (right value) (+ (rect-x value) (rect-width value)))
    (define (bottom value) (+ (rect-y value) (rect-height value)))
    (define (rectangles-overlap? a b)
      (and (< (rect-x a) (right b)) (< (rect-x b) (right a))
           (< (rect-y a) (bottom b)) (< (rect-y b) (bottom a))))
    (define (painted value)
      (rect (- (rect-x value) 12) (- (rect-y value) 12)
            (+ (rect-width value) 24) (+ (rect-height value) 24)))
    (define (inside-rect? child parent)
      (and (>= (rect-x child) (rect-x parent)) (>= (rect-y child) (rect-y parent))
           (<= (right child) (right parent)) (<= (bottom child) (bottom parent))))
    (define (avoids? value obstacles)
      (or (null? obstacles)
          (and (not (rectangles-overlap? value (car obstacles))) (avoids? value (cdr obstacles)))))
    (define Callout
      (datatype ()
        (callout
         (rect Rect callout-rect)
         (world Rect callout-world)
         (side I32 callout-side)
         (docked Bool callout-docked))))

    ;; ---- Four stable candidates; clamping never bypasses collision checks ----

    (define (candidate side target width height)
      (let ((cx (+ (rect-x target) (quotient (rect-width target) 2)))
            (cy (+ (rect-y target) (quotient (rect-height target) 2))))
        (cond ((= side 1) (rect (+ (right target) 18) (- cy (quotient height 2)) width height))
              ((= side 2) (rect (- (- (rect-x target) width) 18) (- cy (quotient height 2)) width height))
              ((= side 3) (rect (- cx (quotient width 2)) (+ (bottom target) 18) width height))
              (else (rect (- cx (quotient width 2)) (- (- (rect-y target) height) 18) width height)))))
    (define (fit-card card available)
      (rect (clamp (rect-x card) (+ (rect-x available) 12) (- (- (right available) (rect-width card)) 12))
            (clamp (rect-y card) (+ (rect-y available) 12) (- (- (bottom available) (rect-height card)) 12))
            (rect-width card) (rect-height card)))
    (define (try-sides sides target width height available obstacles)
      (if (null? sides) (empty-list)
          (let* ((side (car sides)) (card (fit-card (candidate side target width height) available))
                 (footprint (painted card)))
            (if (and (inside-rect? footprint available) (avoids? footprint (cons target obstacles)))
                (list (callout card available side #f))
                (try-sides (cdr sides) target width height available obstacles)))))
    (define (dock-callout available width height menu-height)
      (if (>= (rect-width available) 700)
          (callout (rect (- (- (right available) width) 12) (+ (rect-y available) 12) width height)
                   (rect (rect-x available) (rect-y available) (- (- (rect-width available) width) 36)
                         (max 1 (- (- (rect-height available) menu-height) 12))) 1 #t)
          (let ((top (- (- (- (bottom available) menu-height) height) 24)))
            (callout (rect (+ (rect-x available) 12) top width height)
                     (rect (rect-x available) (rect-y available) (rect-width available)
                           (max 1 (- (- top (rect-y available)) 12))) 3 #t))))
    (define (layout-callout available target obstacles width height menu-height)
      (let ((found (try-sides (list 1 2 4 3) target width height available obstacles)))
        (if (null? found) (dock-callout available width height menu-height) (car found))))
    ;; Offset uses the final projection, including a reserved world's viewport.
    (define (callout-offset value x y)
      (let ((card (callout-rect value)))
        (if (<= (callout-side value) 2)
            (clamp (- y (rect-y card)) 16 (max 16 (- (rect-height card) 16)))
            (clamp (- x (rect-x card)) 16 (max 16 (- (rect-width card) 16))))))))
