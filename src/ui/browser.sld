;; The browser receives copied rectangles, text and typed endpoint descriptors.
(define-library (ui browser)
  (export ui-viewport present-ui!)
  (import
   (scheme base)
   (scheme immutable)
   (ui core)
   (application reducer)
   (browser application)
   (only (lofi core) define-extern match -> I32))
  (begin
    (define-extern viewport "snail.ui" "viewport" (-> I32 I32))
    (define-extern begin-node "snail.ui" "begin" (-> I32 I32 I32 I32 I32 Unit))
    (define-extern node-property "snail.ui" "property" (-> I32 I32 Unit))
    (define-extern node-text "snail.ui" "text" (-> I32 I32 I32 Unit))
    (define-extern node-action "snail.ui" "action" (-> I32 I32 I32 I32 Unit))
    (define-extern end-node "snail.ui" "end" (-> Unit))
    (define (ui-viewport) (rect 0 0 (viewport 0) (viewport 1)))

    ;; ---- Scalar encoding is private to this backend ----

    (define (copy-text field text)
      (node-text field -1 (text-scalar text -1))
      (let loop ((index 0))
        (when (< index (text-scalar text -1))
          (node-text field index (text-scalar text index)) (loop (+ index 1)))))
    (define (copy-action target request)
      (let ((effect (enqueue target request)))
        (node-action (effect-owner effect) (effect-slot effect) (effect-a effect) (effect-b effect))))
    (define (open-node kind bounds)
      (begin-node kind (rect-x bounds) (rect-y bounds) (rect-width bounds) (rect-height bounds)))
    (define (copy-content target content bounds)
      (match content
        ((label-content text tone)
         (begin (open-node 1 bounds) (copy-text 1 text) (node-property 0 tone)))
        ((button-content text help enabled selected event)
         (begin (open-node 2 bounds) (copy-text 1 text) (copy-text 2 help)
                (node-property 1 (if enabled 1 0)) (node-property 2 (if selected 1 0))
                (copy-action target event)))
        ((number-content text help value minimum maximum event)
         (begin (open-node 3 bounds) (copy-text 1 text) (copy-text 2 help)
                (node-property 3 value) (node-property 4 minimum) (node-property 5 maximum)
                (copy-action target event)))
        ((meter-content text value maximum tone)
         (begin (open-node 4 bounds) (copy-text 1 text) (node-property 0 tone)
                (node-property 3 value) (node-property 5 maximum)))
        ((group-content axis gap padding panel extent children)
         (begin (open-node 5 bounds) (node-property 6 padding)
                (node-property 7 (if panel 1 0)) (node-property 8 extent)))))
    (define (copy-placement target placed)
      (let ((node (placement-node placed)))
        (copy-content target (ui-content node) (placement-rect placed))
        (copy-text 0 (ui-key node))
        (copy-children target (placement-children placed))
        (end-node)))
    (define (copy-children target children)
      (unless (null? children)
        (copy-placement target (car children)) (copy-children target (cdr children))))
    ;; Destination connects every widget event to one lexical application owner.
    ;; No widget owns game state or keeps a Wasm closure alive between queries.
    (define (present-ui! target tree)
      (copy-placement target (layout-ui (viewport 0) (viewport 1) tree)))))
