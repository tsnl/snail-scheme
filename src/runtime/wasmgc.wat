    (br_if $done (i32.eq (local.get $index) (array.len (local.get $arguments))))
    (local.set $current (call $character_value (array.get $vector (local.get $arguments) (local.get $index))))
    (local.set $matches (i32.and (local.get $matches) (i32.ge_u (local.get $previous) (local.get $current))))
    (local.set $previous (local.get $current))
    (local.set $index (i32.add (local.get $index) (i32.const 1)))
