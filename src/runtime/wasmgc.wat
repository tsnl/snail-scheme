    (br_if $done (i32.eq (local.get $index) (array.len (local.get $arguments))))
    (local.set $current (call $character_value (array.get $vector (local.get $arguments) (local.get $index))))
    (local.set $matches (i32.and (local.get $matches) (i32.gt_u (local.get $previous) (local.get $current))))
    (local.set $previous (local.get $current))
    (local.set $index (i32.add (local.get $index) (i32.const 1)))
    (br $next)))
  (call $pack_boolean (local.get $matches)))

(func $builtin:char>=? (param $arguments (ref $vector)) (result eqref)
  (local $index i32) (local $previous i32) (local $current i32) (local $matches i32)
  (call $arity (local.get $arguments) (i32.const 2) (i32.const 1))
  (local.set $previous (call $character_value (array.get $vector (local.get $arguments) (i32.const 0))))
  (local.set $index (i32.const 1))
  (local.set $matches (i32.const 1))
