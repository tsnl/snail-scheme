;; Check every source body before choosing native instances. Inference changes
;; only private type holes; typed nodes preserve located source binding identity.
(define-library (snail-scheme strict-infer)
  (export infer-program source-type)
  (import (scheme base) (scheme cxr) (snail-scheme strict-types)
          (snail-scheme strict-core) (snail-scheme strict-primitives)
          (snail-scheme wasm-extern)
          (prefix (snail-scheme ir) ir:)
          (prefix (snail-scheme types) source:))
  (begin

    ;; ---- Lexical checking scopes ----

    (define-record-type <scope>
      (make-scope bindings types assumptions classes instances) scope?
      (bindings scope-bindings) (types scope-types) (assumptions scope-assumptions)
      (classes scope-classes) (instances scope-instances))
    (define (lookup key entries) (let ((entry (assq key entries))) (and entry (cdr entry))))
    (define (extend-scope scope bindings)
      (make-scope (append (map (lambda (binding) (cons (binding-definition binding) binding)) bindings)
                          (scope-bindings scope)) (scope-types scope) (scope-assumptions scope)
                          (scope-classes scope) (scope-instances scope)))
    (define (environment-schemes scope excluded)
      (let collect ((entries (scope-bindings scope)))
        (cond ((null? entries) '()) ((memq (cdar entries) excluded) (collect (cdr entries)))
              (else (cons (binding-scheme (cdar entries)) (collect (cdr entries)))))))
    (define (mono-scheme type) (make-scheme '() type '()))
    (define (constraints nodes) (apply append (map node-constraints nodes)))
    (define (typed kind type source data . children)
      (make-node kind type (node-location source) data (constraints children)))

    ;; ---- Source signatures and rigid quantified binders ----

    (define (source-type type variables loc)
      (cond ((lookup type variables) => (lambda (type) type))
            ((memq type scalar-types) type)
            ((and (pair? type) (memq (car type) '(Ref List Vector)) (= (length type) 2))
             (list (car type) (source-type (cadr type) variables loc)))
            ((and (pair? type) (eq? (car type) '->)) (source-function type variables loc))
            (else (strict-error loc "unsupported strict type" type))))
    (define (source-function type variables loc)
      (let* ((parts (reverse (cdr type)))
             (result (if (null? parts) (strict-error loc "function type requires a result") (car parts)))
             (domains (reverse (cdr parts)))
             (last (and (pair? domains) (car (reverse domains))))
             (rest (and (pair? last) (eq? (car last) 'Rest))))
        (function-type (map (lambda (type) (source-type type variables loc))
                            (if rest (reverse (cdr (reverse domains))) domains))
                       (and rest (source-type (cadr last) variables loc)) (source-type result variables loc))))
    (define (declared-scheme type variables loc)
      (let* ((all? (source:all-type? type))
             (fresh (if all? (map (lambda (variable) (cons variable (fresh-variable #t)))
                                  (source:all-variables type)) '()))
             (scope (append fresh variables))
             (obligations (map (lambda (constraint)
                                 (cons (car constraint) (map (lambda (type) (source-type type scope loc)) (cdr constraint))))
                               (source:type-constraints type))))
        (cons (make-scheme (map cdr fresh) (source-type (source:all-body type) scope loc) obligations) scope)))

    ;; ---- Native foreign declarations ----

    (define (extern-binding node)
      (let ((loc (node-location node)) (definition (ir:extern-declaration-definition node)))
        (guard (failure (else (if (error-object? failure)
                                  (apply strict-error loc (error-object-message failure) (error-object-irritants failure))
                                  (strict-error loc "invalid native extern declaration"))))
          (let ((declaration (parse-extern `(define-extern ,(ir:value-definition-name definition)
                                              ,(ir:extern-declaration-module node) ,(ir:extern-declaration-symbol node)
                                              ,(ir:extern-declaration-type node)))))
            (make-binding definition (mono-scheme (source-type (extern-type declaration) '() loc)) #f 'extern declaration)))))
    (define (extern-bindings items)
      (cond ((null? items) '())
            ((ir:extern-declaration? (car items)) (cons (extern-binding (car items)) (extern-bindings (cdr items))))
            (else (extern-bindings (cdr items)))))

    ;; ---- Exact static classes and instance initializer sites ----

    (define (prepare-class node)
      (let* ((definition (ir:class-declaration-definition node))
             (variables (map (lambda (variable) (cons variable (fresh-variable #t))) (ir:class-declaration-variables node)))
             (methods (map (lambda (row)
                             (make-binding (car row)
                                           (make-scheme (map cdr variables) (source-type (cadr row) variables (node-location node))
                                                        (list (cons definition (map cdr variables))))
                                           #f 'method definition)) (ir:class-declaration-methods node))))
        (make-class definition (map cdr variables) methods)))
    (define (find-class definition classes loc)
      (cond ((null? classes) (strict-error loc "unknown static typeclass"))
            ((eq? definition (class-definition (car classes))) (car classes))
            (else (find-class definition (cdr classes) loc))))
    (define (find-instance class types instances)
      (cond ((null? instances) #f)
            ((and (eq? class (instance-class (car instances))) (type-equal? types (instance-types (car instances)))) (car instances))
            (else (find-instance class types (cdr instances)))))
    (define (constraint-class constraint scope loc)
      (let ((class (find-class (car constraint) (scope-classes scope) loc)))
        (unless (= (length (cdr constraint)) (length (class-variables class)))
          (strict-error loc "wrong number of static typeclass arguments")) class))
    (define (assumed? constraint assumptions)
      (and (pair? assumptions) (or (type-equal? constraint (car assumptions)) (assumed? constraint (cdr assumptions)))))
    (define (check-obligations obligations scope loc declared?)
      (for-each (lambda (constraint)
                  (let ((class (constraint-class constraint scope loc)))
                    (cond ((assumed? constraint (scope-assumptions scope)))
                          ((concrete-type? (cdr constraint))
                           (unless (find-instance class (cdr constraint) (scope-instances scope))
                             (strict-error loc "no exact static typeclass instance" constraint)))
                          (declared? (strict-error loc "typeclass obligation is absent from declared constraints" constraint))))) obligations))
    (define (surface-type type)
      (cond ((function-type? type)
             `(-> ,@(map surface-type (function-domains type))
                  ,@(if (function-rest type) (list (list 'Rest (surface-type (function-rest type)))) '())
                  ,(surface-type (function-result type))))
            ((pair? type) (map surface-type type)) (else type)))
    (define (prepare-member method types class expression loc)
      (unless (or (ir:lambda? expression) (ir:name? expression))
        (strict-error loc "instance member must be a lambda or stable function binding"))
      (if (ir:name? expression)
          (list (cons (binding-definition method) (ir:name-definition expression)))
          (let* ((definition (ir:make-value-definition (ir:value-definition-name (binding-definition method)) loc))
                 (type (substitute (scheme-type (binding-scheme method)) (map cons (class-variables class) types))))
            (cons (cons (binding-definition method) definition)
                  (list (ir:make-type-declaration definition (surface-type type) loc)
                        (ir:make-value-binding definition expression loc))))))
    (define (prepare-instance node classes prior)
      (let* ((loc (node-location node)) (class (find-class (ir:instance-declaration-class node) classes loc))
             (types (map (lambda (type) (require-concrete (source-type type '() loc) loc)) (ir:instance-declaration-types node)))
             (rows (ir:instance-declaration-methods node)))
        (unless (= (length types) (length (class-variables class))) (strict-error loc "wrong number of static typeclass arguments"))
        (when (find-instance class types prior) (strict-error loc "duplicate static typeclass instance"))
        (check-member-names rows (class-methods class) loc)
        (let ((members (map (lambda (method) (prepare-member method types class (cdr (assq (binding-definition method) rows)) loc))
                            (class-methods class))))
          (values (make-instance class types (map car members)) (apply append (map cdr members))))))
    (define (check-member-names rows methods loc)
      (unless (and (= (length rows) (length methods))
                   (let check ((methods methods))
                     (or (null? methods) (and (assq (binding-definition (car methods)) rows) (check (cdr methods))))))
        (strict-error loc "instance must implement each class method exactly once")))
    (define (prepare-class-items items classes)
      (let visit ((items items) (instances '()) (rewritten '()))
        (cond ((null? items) (values (reverse rewritten) (reverse instances)))
              ((ir:class-declaration? (car items)) (visit (cdr items) instances rewritten))
              ((ir:instance-declaration? (car items))
               (let-values (((instance nodes) (prepare-instance (car items) classes instances)))
                 (visit (cdr items) (cons instance instances) (append (reverse nodes) rewritten))))
              (else (visit (cdr items) instances (cons (car items) rewritten))))))

    ;; ---- Definition groups and the value restriction ----

    (define (nonexpansive? node)
      (or (ir:literal? node) (ir:name? node) (ir:lambda? node)
          (and (ir:annotation? node) (nonexpansive? (ir:annotation-expression node)))
          (and (ir:instantiation? node) (nonexpansive? (ir:instantiation-expression node)))))
    (define (declarations items)
      (let collect ((items items))
        (cond ((null? items) '())
              ((ir:type-declaration? (car items))
               (cons (cons (ir:type-declaration-definition (car items)) (car items)) (collect (cdr items))))
              (else (collect (cdr items))))))
    (define (reserve-binding node declared scope)
      (let* ((definition (ir:value-binding-definition node)) (annotation (lookup definition declared))
             (signature (and annotation (declared-scheme (ir:type-declaration-type annotation) (scope-types scope)
                                                         (node-location annotation)))))
        (make-binding definition (if signature (car signature) (mono-scheme (fresh-variable))) #f 'value
                      (list (ir:value-binding-initializer node) signature))))
    (define (source-initializer binding) (car (binding-payload binding)))
    (define (binding-annotation binding) (cadr (binding-payload binding)))
    (define (definition-bindings items scope)
      (let ((declared (declarations items)))
        (let collect ((items items))
          (cond ((null? items) '())
                ((ir:value-binding? (car items)) (cons (reserve-binding (car items) declared scope) (collect (cdr items))))
                (else (collect (cdr items)))))))
    (define (referenced-bindings node bindings)
      (if (ir:name? node)
          (let find ((bindings bindings))
            (cond ((null? bindings) '())
                  ((eq? (ir:name-definition node) (binding-definition (car bindings))) (list (car bindings)))
                  (else (find (cdr bindings)))))
          (apply append (map (lambda (child) (referenced-bindings child bindings)) (children node)))))
    (define (binding-reaches? from target bindings seen)
      (and (not (memq from seen))
           (let visit ((remaining (referenced-bindings (source-initializer from) bindings)))
             (and (pair? remaining)
                  (or (eq? (car remaining) target)
                      (binding-reaches? (car remaining) target bindings (cons from seen))
                      (visit (cdr remaining)))))))
    (define (recursive-group binding bindings)
      (let collect ((remaining bindings))
        (cond ((null? remaining) '())
              ((or (eq? binding (car remaining))
                   (and (binding-reaches? binding (car remaining) bindings '())
                        (binding-reaches? (car remaining) binding bindings '())))
               (cons (car remaining) (collect (cdr remaining))))
              (else (collect (cdr remaining))))))

    ;; SCC checking uses provisional monotypes internally. Generalization waits
    ;; until the entire component is solved; runtime initializer order is kept
    ;; separately in the block's original item sequence.
    (define (check-bindings! bindings scope)
      (let ((done '()))
        (define (check binding)
          (unless (memq binding done)
            (let ((group (recursive-group binding bindings)))
              (set! done (append group done))
              (for-each (lambda (member) (for-each check (referenced-bindings (source-initializer member) bindings))) group)
              (check-recursive-values group bindings)
              (for-each (lambda (member) (check-initializer! member scope)) group)
              (for-each (lambda (member) (generalize-binding! member group scope)) group))))
        (for-each check bindings)))
    (define (check-recursive-values group bindings)
      (for-each (lambda (binding)
                  (when (and (binding-reaches? binding binding bindings '())
                             (not (ir:lambda? (source-initializer binding))))
                    (strict-error (node-location (source-initializer binding)) "recursive values require lambda initializers"))) group))
    (define (check-initializer! binding scope)
      (let* ((annotation (binding-annotation binding)) (scheme (binding-scheme binding))
             (checking (if annotation (make-scope (scope-bindings scope) (cdr annotation) (scheme-constraints scheme)
                                                  (scope-classes scope) (scope-instances scope)) scope))
             (value (infer (source-initializer binding) checking (and annotation (scheme-type scheme)))))
        (unify! (scheme-type scheme) (node-type value) (node-loc value))
        (when (and annotation (pair? (scheme-variables scheme)) (not (nonexpansive? (source-initializer binding))))
          (strict-error (node-loc value) "polymorphic annotation requires a nonexpansive value"))
        (check-skolem-escape binding scope)
        (check-obligations (scheme-constraints scheme) checking (node-loc value) #f)
        (check-obligations (node-constraints value) checking (node-loc value) (and annotation #t))
        (set-binding-initializer! binding value)))
    (define (check-skolem-escape binding scope)
      (let ((variables (scheme-variables (binding-scheme binding))))
        (for-each (lambda (scheme)
                    (for-each (lambda (variable)
                                (when (memq variable variables)
                                  (strict-error (node-location (source-initializer binding)) "rigid type escapes its declaration")))
                              (free-scheme-variables scheme))) (environment-schemes scope (list binding)))))
    (define (generalize-binding! binding group scope)
      (unless (binding-annotation binding)
        (set-binding-scheme! binding
                             (generalize (node-type (binding-initializer binding))
                                         (node-constraints (binding-initializer binding))
                                         (environment-schemes scope group) (nonexpansive? (source-initializer binding))))))

    ;; ---- Expressions and explicit conversions ----

    (define (infer node scope expected)
      (conform (infer-rule node scope expected) expected #f))
    (define (conform node expected projection?)
      (let ((actual (resolve (node-type node))) (expected (and expected (resolve expected))))
        (cond ((or (not expected) (type-equal? actual expected)) node)
              ((eq? actual 'Never) (make-node 'convert expected (node-loc node) (list node) (node-constraints node)))
              ((or (eq? expected 'Top) (and projection? (eq? actual 'Top)))
               (make-node 'convert expected (node-loc node) (list node) (node-constraints node)))
              (else (unify! actual expected (node-loc node)) node))))
    (define (infer-rule node scope expected)
      (cond ((ir:literal? node) (infer-literal node expected))
            ((ir:name? node) (infer-name node scope))
            ((ir:lambda? node) (infer-lambda node scope expected))
            ((ir:application? node) (infer-application node scope expected))
            ((ir:block? node) (infer-block (ir:block-items node) scope expected node))
            ((ir:conditional? node) (infer-conditional node scope expected))
            ((ir:annotation? node) (infer-annotation node scope))
            ((ir:instantiation? node) (infer-instantiation node scope))
            ((ir:assignment? node) (strict-error (node-location node) "immutable binding: use explicit ref-set! instead of set!"))
            (else (strict-error (node-location node) "unsupported strict expression")) ))
    (define (literal-type value expected loc)
      (cond ((boolean? value) 'Bool) ((char? value) 'Char)
            ((null? value) (list 'List (fresh-variable)))
            ((exact-integer? value)
             (let ((type (if (memq expected '(I32 I64)) expected 'I64)))
               (check-integer-range value type loc) type))
            ((and (real? value) (inexact? value)) (if (eq? expected 'F32) 'F32 'F64))
            (else (strict-error loc "unsupported strict literal" value))))
    (define (check-integer-range value type loc)
      (let ((bits (if (eq? type 'I32) 31 63)))
        (unless (<= (- (expt 2 bits)) value (- (expt 2 bits) 1))
          (strict-error loc "integer literal is outside representation range" type value))))
    (define (infer-literal node expected)
      (typed 'literal (literal-type (ir:literal-value node) (and expected (resolve expected)) (node-location node))
             node (list (ir:literal-value node))))
    (define (infer-name node scope)
      (let ((binding (lookup (ir:name-definition node) (scope-bindings scope))))
        (unless binding (strict-error (node-location node) "missing strict binding" (ir:value-definition-name (ir:name-definition node))))
        (let-values (((type obligations substitutions) (instantiate (binding-scheme binding))))
          (make-node 'name type (node-location node) (list binding substitutions) obligations))))
    (define (infer-annotation node scope)
      (let ((type (source-type (ir:annotation-type node) (scope-types scope) (node-location node))))
        (conform (infer-rule (ir:annotation-expression node) scope type) type #t)))
    (define (infer-instantiation node scope)
      (let ((source (ir:instantiation-expression node)))
        (unless (ir:name? source) (strict-error (node-location node) "explicit instantiation requires a named scheme"))
        (let* ((binding (lookup (ir:name-definition source) (scope-bindings scope)))
               (scheme (and binding (binding-scheme binding)))
               (types (map (lambda (type) (source-type type (scope-types scope) (node-location node))) (ir:instantiation-types node))))
          (unless (and scheme (= (length types) (length (scheme-variables scheme))))
            (strict-error (node-location node) "wrong number of explicit type arguments"))
          (let ((substitutions (map cons (scheme-variables scheme) types)))
            (make-node 'name (substitute (scheme-type scheme) substitutions) (node-location node)
                       (list binding substitutions) (substitute (scheme-constraints scheme) substitutions))))))

    ;; ---- Procedures and applications ----

    (define (parameter-binding definition type)
      (make-binding definition (mono-scheme type) #f 'parameter #f))
    (define (infer-lambda node scope expected)
      (let* ((signature (and expected (function-type? expected) (resolve expected)))
             (types (if signature (function-domains signature) (map (lambda (unused) (fresh-variable)) (ir:lambda-parameters node))))
             (rest (and (ir:lambda-opt-rest-parameter node) (if signature (function-rest signature) (fresh-variable)))))
        (unless (and (= (length types) (length (ir:lambda-parameters node)))
                     (or (not signature) (eq? (and (function-rest signature) #t) (and rest #t))))
          (strict-error (node-location node) "lambda and annotation arity mismatch"))
        (infer-lambda-body node scope types rest (and signature (function-result signature)))))
    (define (infer-lambda-body node scope types rest expected)
      (let* ((fixed (map parameter-binding (ir:lambda-parameters node) types))
             (rest-binding (and rest (parameter-binding (ir:lambda-opt-rest-parameter node) (list 'List rest))))
             (body (infer (ir:lambda-body node) (extend-scope scope (append fixed (if rest-binding (list rest-binding) '()))) expected)))
        (typed 'lambda (function-type types rest (node-type body)) node (list fixed rest-binding body) body)))
    (define (infer-application node scope expected)
      (let ((operator (ir:application-operator node)) (arguments (ir:application-operands node)))
        (if (and (ir:lambda? operator) (not (ir:lambda-opt-rest-parameter operator))
                 (= (length arguments) (length (ir:lambda-parameters operator))))
            (infer-direct-let node scope expected)
            (infer-call node scope))))
    (define (call-signature operator count loc)
      (let ((type (resolve (node-type operator))))
        (when (variable? type)
          (unify! type (function-type (map (lambda (unused) (fresh-variable)) (make-list count #f)) #f (fresh-variable)) loc))
        (unless (function-type? type) (strict-error loc "call requires a function" type))
        (let* ((signature (resolve type)) (fixed (length (function-domains signature))))
          (unless (if (function-rest signature) (>= count fixed) (= count fixed))
            (strict-error loc "function call arity mismatch" count fixed)) signature)))
    (define (infer-call node scope)
      (let* ((operator (infer (ir:application-operator node) scope #f))
             (signature (call-signature operator (length (ir:application-operands node)) (node-location node)))
             (domains (append (function-domains signature)
                              (make-list (- (length (ir:application-operands node)) (length (function-domains signature)))
                                         (function-rest signature))))
             (arguments (map (lambda (operand type) (infer operand scope type)) (ir:application-operands node) domains)))
        (make-node 'call (function-result signature) (node-location node) (list operator arguments)
                   (constraints (cons operator arguments)))))

    ;; Expansion represents let as a direct lambda application. Elaborate that
    ;; exact form to typed bindings, not polymorphic native function parameters.
    ;; All actuals see the caller scope and execute once in their original order.
    (define (infer-direct-let node scope expected)
      (let* ((operator (ir:application-operator node))
             (actuals (map (lambda (node) (infer node scope #f)) (ir:application-operands node)))
             (bindings (map (lambda (definition value source)
                              (make-binding definition
                                            (generalize (node-type value) (node-constraints value)
                                                        (environment-schemes scope '()) (nonexpansive? source))
                                            value 'let #f))
                            (ir:lambda-parameters operator) actuals (ir:application-operands node)))
             (body (infer (ir:lambda-body operator) (extend-scope scope bindings) expected)))
        (make-node 'let (node-type body) (node-location node) (list bindings actuals body)
                   (constraints (append actuals (list body))))))

    ;; ---- Blocks and programs ----

    (define (infer-conditional node scope expected)
      (let* ((test (infer (ir:conditional-test node) scope 'Bool))
             (yes (infer (ir:conditional-consequent node) scope expected))
             (no (if (ir:conditional-opt-alternate node) (infer (ir:conditional-opt-alternate node) scope expected)
                     (typed 'unit 'Unit node '())))
             (type (join-types (node-type yes) (node-type no) (node-location node))))
        (typed 'if type node (list test (conform yes type #f) (conform no type #f)) test yes no)))
    (define (infer-block items scope expected source)
      (let* ((bindings (definition-bindings items scope)) (foreign (extern-bindings items))
             (scope (extend-scope scope (append bindings foreign))))
        (check-bindings! bindings scope)
        (let ((nodes (infer-items items scope expected)))
          (make-node 'block (if (null? nodes) 'Unit (node-type (car (reverse nodes)))) (node-location source)
                     (list (append bindings foreign) nodes) (constraints nodes)))))
    (define (infer-items items scope expected)
      (cond ((null? items) '())
            ((or (ir:type-declaration? (car items)) (ir:extern-declaration? (car items)))
             (infer-items (cdr items) scope expected))
            ((ir:value-binding? (car items))
             (let* ((binding (lookup (ir:value-binding-definition (car items)) (scope-bindings scope)))
                    (value (binding-initializer binding)))
               (cons (typed 'bind 'Unit (car items) (list binding value) value) (infer-items (cdr items) scope expected))))
            (else (cons (infer (car items) scope (and (null? (cdr items)) expected)) (infer-items (cdr items) scope expected)))))
    ;; Dependency initializers precede the entry program. Keep its own location
    ;; for whole-program diagnostics instead of borrowing the first dependency.
    (define (infer-program items primitive-bindings loc)
      (let* ((primitives (map (lambda (entry)
                                (make-binding (car entry) (primitive-scheme (cdr entry)) #f 'primitive (cdr entry))) primitive-bindings))
             (classes (let collect ((items items))
                        (cond ((null? items) '()) ((ir:class-declaration? (car items)) (cons (prepare-class (car items)) (collect (cdr items))))
                              (else (collect (cdr items)))))))
        (let-values (((items instances) (prepare-class-items items classes)))
          (let* ((scope (extend-scope (make-scope '() '() '() classes instances) (append primitives (apply append (map class-methods classes)))))
                 (body (infer-block items scope #f (ir:make-block items loc)))
                 (globals (car (node-data body))))
            (make-program body globals classes (resolve-instance-members instances (append globals primitives) scope))))))
    (define (checked-member member instance definitions scope)
      (let* ((binding (lookup (cdr member) definitions)) (class (instance-class instance))
             (method (let find ((methods (class-methods class)))
                       (if (eq? (binding-definition (car methods)) (car member)) (car methods) (find (cdr methods)))))
             (expected (substitute (scheme-type (binding-scheme method)) (map cons (class-variables class) (instance-types instance))))
             (loc (ir:value-definition-loc (cdr member))))
        (unless binding (strict-error loc "instance member requires a stable runtime function binding"))
        (let-values (((type obligations substitutions) (instantiate (binding-scheme binding))))
          (unify! type expected loc) (check-obligations obligations scope loc #t))
        (cons (car member) binding)))
    (define (resolve-instance-members instances bindings scope)
      (let ((definitions (map (lambda (binding) (cons (binding-definition binding) binding)) bindings)))
        (map (lambda (instance)
               (make-instance (instance-class instance) (instance-types instance)
                              (map (lambda (member) (checked-member member instance definitions scope)) (instance-members instance)))) instances)))))
