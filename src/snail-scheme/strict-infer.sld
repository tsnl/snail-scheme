;; Check every source body before choosing native instances. Refine one owned
;; copy of the located IR; shared definitions own the schemes used by references.
(define-library (snail-scheme strict-infer)
  (export infer-program source-type)
  (import (scheme base) (scheme cxr) (snail-scheme strict-types)
          (snail-scheme strict-core) (snail-scheme strict-overloads) (snail-scheme strict-primitives)
          (snail-scheme wasm-extern)
          (only (snail-scheme ir)
                make-node node? node-kind node-type node-loc node-data node-constraints
                refine-node! prepare-binding! binding-scheme set-binding-scheme!
                binding-initializer set-binding-initializer! binding-kind binding-payload
                binding-declaration set-binding-declaration! children copy-ir-graph)
          (prefix (snail-scheme ir) ir:)
          (prefix (snail-scheme types) source:))
  (begin

    ;; ---- Lexical checking scopes ----

    (define-record-type <scope>
      (make-scope bindings types assumptions classes instances) scope?
      (bindings scope-bindings) (types scope-types) (assumptions scope-assumptions)
      (classes scope-classes) (instances scope-instances))
    (define (lookup key entries) (let ((entry (assq key entries))) (and entry (cdr entry))))
    (define (visible-binding definition bindings)
      (and (memq definition bindings) definition))
    (define (extend-scope scope bindings)
      (make-scope (append bindings (scope-bindings scope)) (scope-types scope)
                  (scope-assumptions scope) (scope-classes scope) (scope-instances scope)))
    (define (environment-schemes scope excluded)
      (let collect ((bindings (scope-bindings scope)))
        (cond ((null? bindings) '()) ((memq (car bindings) excluded) (collect (cdr bindings)))
              (else (cons (binding-scheme (car bindings)) (collect (cdr bindings)))))))
    (define (mono-scheme type) (make-scheme '() type '()))
    ;; Obligations are proof sets. Repeated reads do not duplicate a proof;
    ;; equality includes class identity and every argument/result type.
    (define (proof-set obligations)
      (let collect ((remaining obligations) (unique '()))
        (cond ((null? remaining) (reverse unique))
              ((assumed? (car remaining) unique) (collect (cdr remaining) unique))
              (else (collect (cdr remaining) (cons (car remaining) unique))))))
    (define (constraints nodes) (proof-set (apply append (map node-constraints nodes))))
    (define (typed kind type source data . children)
      (refine-node! source kind type data (constraints children)))

    ;; ---- Source signatures and rigid quantified binders ----

    (define (source-type type variables loc)
      (cond ((lookup type variables) => (lambda (type) type))
            ((memq type scalar-types) type)
            ((and (pair? type) (memq (car type) '(Ref List Vector)) (= (length type) 2))
             (list (car type) (source-type (cadr type) variables loc)))
            ((and (pair? type) (eq? (car type) '->)) (source-function type variables loc))
            (else (strict-error loc "unsupported strict type" type))))
    (define (source-function type variables loc)
      (let* ((parts (reverse (cdr type)))
             (result (if (null? parts) (strict-error loc "function type requires a result") (car parts)))
             (domains (reverse (cdr parts)))
             (last (and (pair? domains) (car (reverse domains))))
             (rest (and (pair? last) (eq? (car last) 'Rest))))
        (function-type (map (lambda (type) (source-type type variables loc))
                            (if rest (reverse (cdr (reverse domains))) domains))
                       (and rest (source-type (cadr last) variables loc)) (source-type result variables loc))))
    (define (declared-scheme type variables loc)
      (let* ((all? (source:all-type? type))
             (fresh (if all? (map (lambda (variable) (cons variable (fresh-variable #t)))
                                  (source:all-variables type)) '()))
             (scope (append fresh variables))
             (obligations (map (lambda (constraint)
                                 (cons (car constraint) (map (lambda (type) (source-type type scope loc)) (cdr constraint))))
                               (source:type-constraints type))))
        (cons (make-scheme (map cdr fresh) (source-type (source:all-body type) scope loc) obligations) scope)))

    ;; ---- Native foreign declarations ----

    (define (extern-binding node)
      (let ((loc (node-loc node)) (definition (ir:extern-declaration-definition node)))
        (guard (failure (else (if (error-object? failure)
                                  (apply strict-error loc (error-object-message failure) (error-object-irritants failure))
                                  (strict-error loc "invalid native extern declaration"))))
          (let ((declaration (parse-extern `(define-extern ,(ir:value-definition-name definition)
                                              ,(ir:extern-declaration-module node) ,(ir:extern-declaration-symbol node)
                                              ,(ir:extern-declaration-type node)))))
            (prepare-binding! definition (mono-scheme (source-type (extern-type declaration) '() loc)) #f 'extern declaration)))))
    (define (extern-bindings items)
      (cond ((null? items) '())
            ((ir:extern-declaration? (car items)) (cons (extern-binding (car items)) (extern-bindings (cdr items))))
            (else (extern-bindings (cdr items)))))

    ;; ---- Exact static classes and instance initializer sites ----

    (define (prepare-class node)
      (let* ((definition (ir:class-declaration-definition node))
             (variables (map (lambda (variable) (cons variable (fresh-variable #t))) (ir:class-declaration-variables node)))
             (methods (map (lambda (row)
                             (prepare-binding! (car row)
                                               (make-scheme (map cdr variables) (source-type (cadr row) variables (node-loc node))
                                                            (list (cons definition (map cdr variables))))
                                               #f 'method definition)) (ir:class-declaration-methods node))))
        (make-class definition (map cdr variables) methods #f)))
    (define (find-class definition classes loc)
      (cond ((null? classes) (strict-error loc "unknown static typeclass"))
            ((eq? definition (class-definition (car classes))) (car classes))
            (else (find-class definition (cdr classes) loc))))
    (define (find-instance class types instances)
      (cond ((null? instances) #f)
            ((and (eq? class (instance-class (car instances))) (type-equal? types (instance-types (car instances)))) (car instances))
            (else (find-instance class types (cdr instances)))))
    (define (constraint-class constraint scope loc)
      (let ((class (find-class (car constraint) (scope-classes scope) loc)))
        (unless (= (length (cdr constraint)) (length (class-variables class)))
          (strict-error loc "wrong number of static typeclass arguments")) class))
    (define (assumed? constraint assumptions)
      (and (pair? assumptions) (or (type-equal? constraint (car assumptions)) (assumed? constraint (cdr assumptions)))))
    (define (check-obligations obligations scope loc declared?)
      (for-each (lambda (constraint) (constraint-class constraint scope loc)) (scope-assumptions scope))
      (improve-overloads! obligations (scope-assumptions scope) (scope-classes scope) (scope-instances scope) loc)
      (for-each (lambda (constraint) (check-obligation constraint scope loc declared? '())) obligations))
    (define (check-obligation constraint scope loc declared? seen)
      (let ((class (constraint-class constraint scope loc)))
        (cond ((assumed? constraint (scope-assumptions scope)))
              ((assumed? constraint seen) (strict-error loc "cyclic overload obligations" constraint))
              ((class-overload? class)
               (let ((view (select-overload-view class (cadr constraint) (scope-instances scope) loc #f)))
                 (cond (view (check-overload-view! view scope loc declared? (cons constraint seen)))
                       (declared? (strict-error loc "typeclass obligation is absent from declared constraints" constraint)))))
              ((concrete-type? (cdr constraint))
               (unless (find-instance class (cdr constraint) (scope-instances scope))
                 (strict-error loc "no exact static typeclass instance" constraint)))
              (declared? (strict-error loc "typeclass obligation is absent from declared constraints" constraint)))))
    (define (check-overload-view! view scope loc declared? seen)
      ;; Keep one fresh row view: a sibling prerequisite may determine a type
      ;; absent from the selected arrow but needed by another prerequisite.
      (let ((goals (overload-view-constraints view)))
        (improve-overloads! goals (scope-assumptions scope) (scope-classes scope) (scope-instances scope) loc)
        (for-each (lambda (goal) (check-obligation goal scope loc declared? seen)) goals)))
    (define (surface-type type)
      (cond ((function-type? type)
             `(-> ,@(map surface-type (function-domains type))
                  ,@(if (function-rest type) (list (list 'Rest (surface-type (function-rest type)))) '())
                  ,(surface-type (function-result type))))
            ((pair? type) (map surface-type type)) (else type)))
    (define (prepare-member method types class expression loc)
      (unless (or (ir:lambda? expression) (ir:name? expression))
        (strict-error loc "instance member must be a lambda or stable function binding"))
      (if (ir:name? expression)
          (list (cons method (ir:name-definition expression)))
          (let* ((definition (ir:make-value-definition (ir:value-definition-name method) loc))
                 (type (substitute (scheme-type (binding-scheme method)) (map cons (class-variables class) types))))
            (cons (cons method definition)
                  (begin
                    (set-binding-declaration! definition
                                              (ir:make-type-declaration definition (surface-type type) loc))
                    (list (ir:make-value-binding definition expression loc)))))))
    (define (prepare-instance node classes prior)
      (let* ((loc (node-loc node)) (class (find-class (ir:instance-declaration-class node) classes loc))
             (types (map (lambda (type) (require-concrete (source-type type '() loc) loc)) (ir:instance-declaration-types node)))
             (rows (ir:instance-declaration-methods node)))
        (when (class-overload? class) (strict-error loc "free overload instances require define-overload"))
        (unless (= (length types) (length (class-variables class))) (strict-error loc "wrong number of static typeclass arguments"))
        (when (find-instance class types prior) (strict-error loc "duplicate static typeclass instance"))
        (check-member-names rows (class-methods class) loc)
        (let ((members (map (lambda (method) (prepare-member method types class (cdr (assq method rows)) loc))
                            (class-methods class))))
          (values (make-instance class types (map car members) #f #f) (apply append (map cdr members))))))
    (define (check-member-names rows methods loc)
      (unless (and (= (length rows) (length methods))
                   (let check ((methods methods))
                     (or (null? methods) (and (assq (car methods) rows) (check (cdr methods))))))
        (strict-error loc "instance must implement each class method exactly once")))
    (define (prepare-class-items items classes)
      (let visit ((items items) (instances '()) (rewritten '()))
        (cond ((null? items) (values (reverse rewritten) (reverse instances)))
              ((ir:class-declaration? (car items)) (visit (cdr items) instances rewritten))
              ((ir:instance-declaration? (car items))
               (let-values (((instance nodes) (prepare-instance (car items) classes instances)))
                 (visit (cdr items) (cons instance instances) (append (reverse nodes) rewritten))))
              ((ir:overload-declaration? (car items))
               (let-values (((instance nodes) (prepare-overload-instance (car items) classes instances)))
                 (visit (cdr items) (cons instance instances) (append (reverse nodes) rewritten))))
              (else (visit (cdr items) instances (cons (car items) rewritten))))))

    ;; ---- Free overloads as classes over complete function signatures ----

    (define (overload-scheme node)
      (let* ((loc (node-loc node))
             (scheme (car (declared-scheme (ir:overload-declaration-type node) '() loc)))
             (type (scheme-type scheme)))
        (unless (and (function-type? type) (not (function-rest type)))
          (strict-error loc "overload requires a fixed-arity function signature")) scheme))
    (define (prepare-overload node)
      (let* ((definition (ir:overload-declaration-definition node)) (signature (fresh-variable #t))
             (scheme (make-scheme (list signature) signature (list (list definition signature)))))
        (make-class definition (list signature) (list (prepare-binding! definition scheme #f 'method definition)) #t)))
    (define (collect-program-classes items)
      (let collect ((items items) (classes '()))
        (cond ((null? items) (reverse classes))
              ((ir:class-declaration? (car items)) (collect (cdr items) (cons (prepare-class (car items)) classes)))
              ((ir:overload-declaration? (car items))
               (let ((definition (ir:overload-declaration-definition (car items))))
                 (collect (cdr items) (if (assq definition (map (lambda (class) (cons (class-definition class) class)) classes))
                                          classes (cons (prepare-overload (car items)) classes)))))
              (else (collect (cdr items) classes)))))
    (define (prepare-overload-instance node classes prior)
      (let* ((loc (node-loc node)) (definition (ir:overload-declaration-definition node))
             (class (find-class definition classes loc))
             (scheme (and (ir:overload-declaration-type node) (overload-scheme node))))
        (unless (class-overload? class) (strict-error loc "overload name belongs to an ordinary class"))
        (when (and scheme (duplicate-overload? class scheme prior))
          (strict-error loc "duplicate overload signature" (scheme-type scheme)))
        (when scheme (set-binding-scheme! (ir:overload-declaration-member node) scheme))
        (let ((member (prepare-overload-member node)))
          (values (make-instance class '() (list (car member)) scheme node) (cdr member)))))
    (define (prepare-overload-member node)
      (let ((expression (ir:overload-declaration-implementation node))
            (method (ir:overload-declaration-definition node)) (loc (node-loc node)))
        (cond ((ir:name? expression) (list (cons method (ir:name-definition expression))))
              ((ir:lambda? expression)
               (let ((definition (ir:overload-declaration-member node)))
                 (list (cons method definition) (ir:make-value-binding definition expression loc))))
              (else (strict-error loc "instance member must be a lambda or stable function binding")))))
    ;; A row may inherit a completed implementation scheme, never an unfinished
    ;; monotype that a later caller could specialize. Named rows keep the target's
    ;; original runtime binding and initializer; only row evidence is published.
    (define (implementation-scheme-ready? binding completed)
      (or (memq binding completed) (memq (binding-kind binding) '(primitive extern))
          (and (eq? (binding-kind binding) 'value) (binding-annotation binding))))
    ;; A checked body may still share a captured monomorphic hole. Keep its row
    ;; pending while independent binding groups can solve that storage type.
    (define (complete-overload! instance instances)
      (let* ((row (instance-row instance)) (scheme (binding-scheme (cdar (instance-members instance))))
             (type (scheme-type scheme)) (loc (node-loc row)))
        (unless (and (function-type? type) (not (function-rest type)))
          (strict-error loc "inferred overload requires a fixed-arity function signature"))
        (when (null? (free-scheme-variables scheme))
          (when (duplicate-overload? (instance-class instance) scheme instances)
            (strict-error loc "duplicate overload signature" type))
          (set-binding-scheme! (ir:overload-declaration-member row) scheme)
          (set-instance-scheme! instance scheme))))
    (define (complete-overloads! instances completed)
      (for-each (lambda (instance)
                  (when (and (instance-row instance) (not (instance-scheme instance))
                             (implementation-scheme-ready? (cdar (instance-members instance)) completed))
                    (complete-overload! instance instances))) instances))

    (define (reject-open-row-captures instances completed)
      (for-each (lambda (instance)
                  (when (and (instance-row instance) (not (instance-scheme instance))
                             (memq (cdar (instance-members instance)) completed))
                    (strict-error (node-loc (instance-row instance))
                                  (string-append "inferred overload captures an unresolved type; "
                                                 "annotate the captured storage or the row: "
                                                 "its signature must settle before executable expressions use the family")))) instances))

    (define (occupied-definitions items classes primitives)
      (append primitives
              (apply append (map (lambda (class)
                                   (if (class-overload? class) '()
                                       (cons (class-definition class) (class-methods class)))) classes))
              (let collect ((items items))
                (cond ((null? items) '())
                      ((ir:value-binding? (car items)) (cons (ir:value-binding-definition (car items)) (collect (cdr items))))
                      ((ir:extern-declaration? (car items)) (cons (ir:extern-declaration-definition (car items)) (collect (cdr items))))
                      (else (collect (cdr items)))))))
    (define (check-overload-names items classes primitives)
      (let ((occupied (occupied-definitions items classes primitives)))
        (for-each (lambda (node)
                    (when (and (ir:overload-declaration? node) (memq (ir:overload-declaration-definition node) occupied))
                      (strict-error (node-loc node) "overload name already has an ordinary value or class definition"))
                    (when (and (ir:type-declaration? node) (overload-class (ir:type-declaration-definition node) classes))
                      (strict-error (node-loc node) "overload signature belongs directly to its define-overload row"))) items)))

    ;; ---- Definition groups and the value restriction ----

    (define (nonexpansive? node)
      (or (ir:literal? node) (ir:name? node) (ir:lambda? node)
          (and (ir:annotation? node) (nonexpansive? (ir:annotation-expression node)))
          (and (ir:instantiation? node) (nonexpansive? (ir:instantiation-expression node)))))
    (define (reserve-binding node scope)
      (let* ((definition (ir:value-binding-definition node))
             (annotation (binding-declaration definition))
             (signature (and annotation
                             (declared-scheme (ir:type-declaration-type annotation)
                                              (scope-types scope) (node-loc annotation))))
             (scheme (if signature (car signature) (binding-scheme definition))))
        (prepare-binding! definition scheme #f 'value
                          (list (ir:value-binding-initializer node) signature))))
    (define (source-initializer binding) (car (binding-payload binding)))
    (define (binding-annotation binding) (cadr (binding-payload binding)))
    (define (definition-bindings items scope)
      (let collect ((items items))
        (cond ((null? items) '())
              ((ir:value-binding? (car items))
               (cons (reserve-binding (car items) scope) (collect (cdr items))))
              (else (collect (cdr items))))))
    (define (referenced-bindings node bindings)
      (if (ir:name? node)
          (let find ((bindings bindings))
            (cond ((null? bindings) '())
                  ((eq? (ir:name-definition node) (car bindings)) (list (car bindings)))
                  (else (find (cdr bindings)))))
          (apply append (map (lambda (child) (referenced-bindings child bindings)) (children node)))))
    (define (binding-reaches? from target bindings seen)
      (and (not (memq from seen))
           (let visit ((remaining (referenced-bindings (source-initializer from) bindings)))
             (and (pair? remaining)
                  (or (eq? (car remaining) target)
                      (binding-reaches? (car remaining) target bindings (cons from seen))
                      (visit (cdr remaining)))))))
    (define (recursive-group binding bindings)
      (let collect ((remaining bindings))
        (cond ((null? remaining) '())
              ((or (eq? binding (car remaining))
                   (and (binding-reaches? binding (car remaining) bindings '())
                        (binding-reaches? (car remaining) binding bindings '())))
               (cons (car remaining) (collect (cdr remaining))))
              (else (collect (cdr remaining))))))

    ;; ---- Signature dependencies for inferred overload rows ----

    ;; An ordinary reference waits for its dependency's inferred scheme. A family
    ;; reference also waits for every unfinished row of the relevant arity. Walk
    ;; completed row prerequisites transitively: they can improve an inferred
    ;; result, but never exclude or rank competing rows.
    (define (signature-arity type)
      (and (function-type? type) (not (function-rest type)) (length (function-domains type))))
    (define (constraint-family-queries obligations classes)
      (let collect ((remaining obligations))
        (if (null? remaining) '()
            (let ((class (overload-class (caar remaining) classes)))
              (if class
                  (cons (cons class (and (= (length (cdar remaining)) 1)
                                         (signature-arity (cadar remaining)))) (collect (cdr remaining)))
                  (collect (cdr remaining)))))))
    (define (source-signature-arity type)
      (let ((type (source:all-body type)))
        (and (source:arrow-type? type)
             (let* ((domains (source:type-arguments type)) (last (and (pair? domains) (car (reverse domains)))))
               (and (not (and (pair? last) (eq? (car last) 'Rest))) (length domains))))))
    (define (instantiation-arity node classes)
      (let ((expression (ir:instantiation-expression node)) (types (ir:instantiation-types node)))
        (and (ir:name? expression) (overload-class (ir:name-definition expression) classes)
             (= (length types) 1) (source-signature-arity (car types)))))
    (define (expression-family-queries node classes arity)
      (cond ((ir:name? node)
             (let* ((binding (ir:name-definition node)) (class (overload-class binding classes)))
               (if class (list (cons class arity))
                   (constraint-family-queries (scheme-constraints (binding-scheme binding)) classes))))
            ((ir:application? node)
             (append (expression-family-queries (ir:application-operator node) classes
                                                (length (ir:application-operands node)))
                     (apply append (map (lambda (child) (expression-family-queries child classes #f))
                                        (ir:application-operands node)))))
            ((ir:annotation? node)
             (expression-family-queries (ir:annotation-expression node) classes
                                        (or arity (source-signature-arity (ir:annotation-type node)))))
            ((ir:instantiation? node)
             (expression-family-queries (ir:instantiation-expression node) classes
                                        (or arity (instantiation-arity node classes))))
            (else (apply append (map (lambda (child) (expression-family-queries child classes #f)) (children node))))))
    (define (seen-family-query? query seen)
      (and (pair? seen)
           (or (and (eq? (car query) (caar seen)) (eqv? (cdr query) (cdar seen)))
               (seen-family-query? query (cdr seen)))))
    (define (row-prerequisite-queries query instances classes)
      (let collect ((remaining instances))
        (if (null? remaining) '()
            (let ((instance (car remaining)))
              (if (and (eq? (car query) (instance-class instance)) (instance-scheme instance)
                       (or (not (cdr query)) (= (cdr query) (overload-instance-arity instance))))
                  (append (constraint-family-queries (scheme-constraints (instance-scheme instance)) classes)
                          (collect (cdr remaining))) (collect (cdr remaining)))))))
    (define (pending-query-rows queries scope)
      (let visit ((queries queries) (seen '()) (pending '()))
        (cond ((null? queries) pending)
              ((seen-family-query? (car queries) seen) (visit (cdr queries) seen pending))
              (else (visit (append (row-prerequisite-queries (car queries) (scope-instances scope) (scope-classes scope))
                                   (cdr queries))
                           (cons (car queries) seen)
                           (identity-union (pending-overload-instances (caar queries) (cdar queries) (scope-instances scope))
                                           pending))))))
    (define (unfinished-overloads? instances)
      (and (pair? instances)
           (or (and (instance-row (car instances)) (not (instance-scheme (car instances))))
               (unfinished-overloads? (cdr instances)))))
    (define (group-pending-rows group scope)
      (if (not (unfinished-overloads? (scope-instances scope))) '()
          (pending-query-rows
           (apply append (map (lambda (binding)
                                (append (expression-family-queries (source-initializer binding) (scope-classes scope) #f)
                                        (constraint-family-queries (scheme-constraints (binding-scheme binding)) (scope-classes scope)))) group)) scope)))

    ;; Ordinary SCCs share provisional monotypes. Their schemes become available
    ;; together after checking every body. Declared schemes are already usable,
    ;; even when their bodies must wait for an inferred row elsewhere. These
    ;; scheduling decisions never move an initializer in the executable block.
    (define-record-type <binding-checks>
      (make-binding-checks bindings scope done active) binding-checks?
      (bindings checks-bindings) (scope checks-scope)
      (done checks-done set-checks-done!) (active checks-active set-checks-active!))
    (define (group-references group bindings)
      (apply append (map (lambda (binding) (referenced-bindings (source-initializer binding) bindings)) group)))
    (define (group-references-ready? group checks)
      (let ready ((remaining (group-references group (checks-bindings checks))))
        (or (null? remaining)
            (and (or (memq (car remaining) group) (memq (car remaining) (checks-done checks))
                     (binding-annotation (car remaining))) (ready (cdr remaining))))))
    (define (check-pending-row-dependencies! group checks)
      (for-each (lambda (instance)
                  (let ((binding (cdar (instance-members instance))))
                    (when (memq binding (checks-bindings checks)) (try-check-binding! binding checks))))
                (group-pending-rows group (checks-scope checks))))
    (define (finish-binding-group! group checks)
      (for-each (lambda (binding) (check-initializer! binding (checks-scope checks))) group)
      (for-each (lambda (binding) (generalize-binding! binding group (checks-scope checks))) group)
      (set-checks-done! checks (append group (checks-done checks)))
      (complete-overloads! (scope-instances (checks-scope checks)) (checks-done checks)))
    (define (try-check-binding! binding checks)
      (unless (or (memq binding (checks-done checks)) (memq binding (checks-active checks)))
        (let ((group (recursive-group binding (checks-bindings checks))) (active (checks-active checks)))
          (set-checks-active! checks (append group active))
          (for-each (lambda (dependency) (try-check-binding! dependency checks)) (group-references group (checks-bindings checks)))
          (check-pending-row-dependencies! group checks)
          (when (and (group-references-ready? group checks) (null? (group-pending-rows group (checks-scope checks))))
            (finish-binding-group! group checks))
          (set-checks-active! checks active))))
    (define (unfinished-binding bindings done)
      (and (pair? bindings) (if (memq (car bindings) done) (unfinished-binding (cdr bindings) done) (car bindings))))
    (define (check-bindings! bindings scope)
      (let ((checks (make-binding-checks bindings scope '() '())))
        (check-recursive-values bindings bindings)
        (complete-overloads! (scope-instances scope) '())
        (let repeat ((before '()))
          (for-each (lambda (binding) (try-check-binding! binding checks)) bindings)
          (let ((remaining (unfinished-binding bindings (checks-done checks))))
            (when (or (not remaining) (eq? before (checks-done checks)))
              (reject-open-row-captures (scope-instances scope) (checks-done checks)))
            (when remaining
              (when (eq? before (checks-done checks))
                (strict-error (node-loc (source-initializer remaining))
                              "inferred overload signature cycle; provide an explicit signature"))
              (repeat (checks-done checks)))))))
    (define (check-recursive-values group bindings)
      (for-each (lambda (binding)
                  (when (and (binding-reaches? binding binding bindings '())
                             (not (ir:lambda? (source-initializer binding))))
                    (strict-error (node-loc (source-initializer binding)) "recursive values require lambda initializers"))) group))
    (define (initializer-scope binding scope)
      (let ((annotation (binding-annotation binding)) (scheme (binding-scheme binding)))
        (if annotation (make-scope (scope-bindings scope) (cdr annotation) (scheme-constraints scheme)
                                   (scope-classes scope) (scope-instances scope)) scope)))
    (define (check-initializer! binding scope)
      (let* ((annotation (binding-annotation binding)) (scheme (binding-scheme binding))
             (checking (initializer-scope binding scope))
             (value (infer (source-initializer binding) checking (and annotation (scheme-type scheme)))))
        (unify! (scheme-type scheme) (node-type value) (node-loc value))
        (when (and annotation (pair? (scheme-variables scheme)) (not (nonexpansive? (source-initializer binding))))
          (strict-error (node-loc value) "polymorphic annotation requires a nonexpansive value"))
        (check-skolem-escape binding scope)
        (check-obligations (scheme-constraints scheme) checking (node-loc value) #f)
        (check-obligations (node-constraints value) checking (node-loc value) (and annotation #t))
        (set-binding-initializer! binding value)))
    (define (check-skolem-escape binding scope)
      (let ((variables (scheme-variables (binding-scheme binding))))
        (for-each (lambda (scheme)
                    (for-each (lambda (variable)
                                (when (memq variable variables)
                                  (strict-error (node-loc (source-initializer binding)) "rigid type escapes its declaration")))
                              (free-scheme-variables scheme))) (environment-schemes scope (list binding)))))
    (define (generalize-binding! binding group scope)
      (unless (binding-annotation binding)
        (set-binding-scheme! binding
                             (generalize (node-type (binding-initializer binding))
                                         (proof-set (node-constraints (binding-initializer binding)))
                                         (environment-schemes scope group) (nonexpansive? (source-initializer binding))))))

    ;; A generalized initializer checks its obligations inside its template.
    ;; Its concrete uses instantiate them; the enclosing scope must not inherit
    ;; private type variables from a local polymorphic function or name alias.
    (define (initialization-constraints binding)
      (let ((bound (scheme-variables (binding-scheme binding))))
        (let collect ((obligations (node-constraints (binding-initializer binding))))
          (cond ((null? obligations) '())
                ((let intersects ((variables (type-variables (car obligations))))
                   (and (pair? variables) (or (memq (car variables) bound) (intersects (cdr variables)))))
                 (collect (cdr obligations)))
                (else (cons (car obligations) (collect (cdr obligations))))))))

    ;; ---- Expressions and explicit conversions ----

    (define (infer node scope expected)
      (let ((result (conform (infer-rule node scope expected) expected #f)))
        (improve-overloads! (node-constraints result) (scope-assumptions scope) (scope-classes scope) (scope-instances scope) (node-loc result))
        result))
    (define (conform node expected projection?)
      (let ((actual (resolve (node-type node))) (expected (and expected (resolve expected))))
        (cond ((or (not expected) (type-equal? actual expected)) node)
              ((eq? actual 'Never) (make-node 'convert expected (node-loc node) (list node) (node-constraints node)))
              ((or (eq? expected 'Top) (and projection? (eq? actual 'Top)))
               (make-node 'convert expected (node-loc node) (list node) (node-constraints node)))
              (else (unify! actual expected (node-loc node)) node))))
    (define (infer-rule node scope expected)
      (cond ((ir:literal? node) (infer-literal node expected))
            ((ir:name? node) (infer-name node scope))
            ((ir:lambda? node) (infer-lambda node scope expected))
            ((ir:application? node) (infer-application node scope expected))
            ((ir:block? node) (infer-block (ir:block-items node) scope expected node))
            ((ir:conditional? node) (infer-conditional node scope expected))
            ((ir:annotation? node) (infer-annotation node scope))
            ((ir:instantiation? node) (infer-instantiation node scope))
            ((ir:overload-declaration? node) (strict-error (node-loc node) "overloads require module scope"))
            ((ir:assignment? node) (strict-error (node-loc node) "immutable binding: use explicit ref-set! instead of set!"))
            (else (strict-error (node-loc node) "unsupported strict expression")) ))
    (define (literal-type value expected loc)
      (cond ((boolean? value) 'Bool) ((char? value) 'Char)
            ((null? value) (list 'List (fresh-variable)))
            ((exact-integer? value)
             (let ((type (if (memq expected '(I32 I64)) expected 'I64)))
               (check-integer-range value type loc) type))
            ((and (real? value) (inexact? value)) (if (eq? expected 'F32) 'F32 'F64))
            (else (strict-error loc "unsupported strict literal" value))))
    (define (check-integer-range value type loc)
      (let ((bits (if (eq? type 'I32) 31 63)))
        (unless (<= (- (expt 2 bits)) value (- (expt 2 bits) 1))
          (strict-error loc "integer literal is outside representation range" type value))))
    (define (infer-literal node expected)
      (typed 'literal (literal-type (ir:literal-value node) (and expected (resolve expected)) (node-loc node))
             node (list (ir:literal-value node))))
    (define (infer-name node scope)
      (let ((binding (visible-binding (ir:name-definition node) (scope-bindings scope))))
        (unless binding (strict-error (node-loc node) "missing strict binding" (ir:value-definition-name (ir:name-definition node))))
        (let-values (((type obligations substitutions) (instantiate (binding-scheme binding))))
          (refine-node! node 'name type (list binding substitutions) obligations))))
    (define (infer-annotation node scope)
      (let ((type (source-type (ir:annotation-type node) (scope-types scope) (node-loc node))))
        (conform (infer-rule (ir:annotation-expression node) scope type) type #t)))
    (define (infer-instantiation node scope)
      (let ((source (ir:instantiation-expression node)))
        (unless (ir:name? source) (strict-error (node-loc node) "explicit instantiation requires a named scheme"))
        (let* ((binding (visible-binding (ir:name-definition source) (scope-bindings scope)))
               (scheme (and binding (binding-scheme binding)))
               (types (map (lambda (type) (source-type type (scope-types scope) (node-loc node))) (ir:instantiation-types node))))
          (unless (and scheme (= (length types) (length (scheme-variables scheme))))
            (strict-error (node-loc node) "wrong number of explicit type arguments"))
          (let ((substitutions (map cons (scheme-variables scheme) types)))
            (refine-node! node 'name (substitute (scheme-type scheme) substitutions)
                          (list binding substitutions) (substitute (scheme-constraints scheme) substitutions))))))

    ;; ---- Procedures and applications ----

    (define (parameter-binding definition type)
      (unify! (scheme-type (binding-scheme definition)) type (ir:value-definition-loc definition))
      (prepare-binding! definition (mono-scheme type) #f 'parameter #f))
    (define (infer-lambda node scope expected)
      (let* ((signature (and expected (function-type? expected) (resolve expected)))
             (types (if signature (function-domains signature) (map (lambda (unused) (fresh-variable)) (ir:lambda-parameters node))))
             (rest (and (ir:lambda-opt-rest-parameter node) (if signature (function-rest signature) (fresh-variable)))))
        (unless (and (= (length types) (length (ir:lambda-parameters node)))
                     (or (not signature) (eq? (and (function-rest signature) #t) (and rest #t))))
          (strict-error (node-loc node) "lambda and annotation arity mismatch"))
        (infer-lambda-body node scope types rest (and signature (function-result signature)))))
    (define (infer-lambda-body node scope types rest expected)
      (let* ((fixed (map parameter-binding (ir:lambda-parameters node) types))
             (rest-binding (and rest (parameter-binding (ir:lambda-opt-rest-parameter node) (list 'List rest))))
             (body (infer (ir:lambda-body node) (extend-scope scope (append fixed (if rest-binding (list rest-binding) '()))) expected)))
        (typed 'lambda (function-type types rest (node-type body)) node (list fixed rest-binding body) body)))
    (define (infer-application node scope expected)
      (let ((operator (ir:application-operator node)) (arguments (ir:application-operands node)))
        (if (and (ir:lambda? operator) (not (ir:lambda-opt-rest-parameter operator))
                 (= (length arguments) (length (ir:lambda-parameters operator))))
            (infer-direct-let node scope expected)
            (infer-call node scope))))
    (define (call-signature operator count loc)
      (let ((type (resolve (node-type operator))))
        (when (variable? type)
          (unify! type (function-type (map (lambda (unused) (fresh-variable)) (make-list count #f)) #f (fresh-variable)) loc))
        (unless (function-type? type) (strict-error loc "call requires a function" type))
        (let* ((signature (resolve type)) (fixed (length (function-domains signature))))
          (unless (if (function-rest signature) (>= count fixed) (= count fixed))
            (strict-error loc "function call arity mismatch" count fixed)) signature)))
    (define (infer-call node scope)
      (let* ((operator (infer (ir:application-operator node) scope #f))
             (signature (call-signature operator (length (ir:application-operands node)) (node-loc node)))
             (domains (append (function-domains signature)
                              (make-list (- (length (ir:application-operands node)) (length (function-domains signature)))
                                         (function-rest signature))))
             (arguments (infer-operands (ir:application-operands node) domains scope)))
        (refine-node! node 'call (function-result signature) (list operator arguments)
                      (constraints (cons operator arguments)))))

    (define (infer-operands operands domains scope)
      ;; Earlier operands constrain shared variables before later literals choose
      ;; their contextual widths. Scheme map does not promise callback order.
      (if (null? operands) '()
          (let ((operand (infer (car operands) scope (car domains))))
            (cons operand (infer-operands (cdr operands) (cdr domains) scope)))))

    ;; Expansion represents let as a direct lambda application. Elaborate that
    ;; exact form to typed bindings, not polymorphic native function parameters.
    ;; All actuals see the caller scope and execute once in their original order.
    (define (infer-direct-let node scope expected)
      (let* ((operator (ir:application-operator node))
             (actuals (map (lambda (node) (infer node scope #f)) (ir:application-operands node)))
             (bindings (map (lambda (definition value source)
                              (prepare-binding! definition
                                                (generalize (node-type value) (proof-set (node-constraints value))
                                                            (environment-schemes scope '()) (nonexpansive? source))
                                                value 'let #f))
                            (ir:lambda-parameters operator) actuals (ir:application-operands node)))
             (body (infer (ir:lambda-body operator) (extend-scope scope bindings) expected)))
        (refine-node! node 'let (node-type body) (list bindings actuals body)
                      (append (apply append (map initialization-constraints bindings)) (node-constraints body)))))

    ;; ---- Blocks and programs ----

    ;; Expansion attaches each colon to one local definition. Merely finding a
    ;; declaration on an imported/outer binding does not make this colon its owner.
    (define (check-declaration-owners items)
      (for-each (lambda (node)
                  (when (ir:type-declaration? node)
                    (unless (eq? node (binding-declaration (ir:type-declaration-definition node)))
                      (strict-error (node-loc node) "type declaration requires one local definition")))) items))
    (define (infer-conditional node scope expected)
      (let* ((test (infer (ir:conditional-test node) scope 'Bool))
             (yes (infer (ir:conditional-consequent node) scope expected))
             (no (if (ir:conditional-opt-alternate node) (infer (ir:conditional-opt-alternate node) scope expected)
                     (make-node 'unit 'Unit (node-loc node) '() '())))
             (type (join-types (node-type yes) (node-type no) (node-loc node))))
        (typed 'if type node (list test (conform yes type #f) (conform no type #f)) test yes no)))
    (define (infer-block items scope expected source)
      (for-each (lambda (node)
                  (when (ir:overload-declaration? node) (strict-error (node-loc node) "overloads require module scope"))) items)
      (check-declaration-owners items)
      (let* ((bindings (definition-bindings items scope)) (foreign (extern-bindings items))
             (scope (extend-scope scope (append bindings foreign))))
        (check-bindings! bindings scope)
        (let ((nodes (infer-items items scope expected)))
          (refine-node! source 'block (if (null? nodes) 'Unit (node-type (car (reverse nodes))))
                        (list (append bindings foreign) nodes) (constraints nodes)))))
    (define (infer-items items scope expected)
      (cond ((null? items) '())
            ((or (ir:type-declaration? (car items)) (ir:extern-declaration? (car items)))
             (infer-items (cdr items) scope expected))
            ((ir:value-binding? (car items))
             (let* ((binding (visible-binding (ir:value-binding-definition (car items)) (scope-bindings scope)))
                    (value (binding-initializer binding)))
               (cons (refine-node! (car items) 'bind 'Unit (list binding value)
                                   (initialization-constraints binding)) (infer-items (cdr items) scope expected))))
            (else (cons (infer (car items) scope (and (null? (cdr items)) expected)) (infer-items (cdr items) scope expected)))))
    ;; Dependency initializers precede the entry program. Keep its own location
    ;; for whole-program diagnostics instead of borrowing the first dependency.
    (define (infer-program items primitive-bindings loc)
      ;; Cached expansion results remain unmodified. Copy all checking roots
      ;; together so imported aliases and primitive references share one identity.
      (let ((owned (copy-ir-graph (list items primitive-bindings))))
        (infer-owned-program (car owned) (cadr owned) loc)))
    (define (infer-owned-program items primitive-bindings loc)
      (let* ((primitives (map (lambda (entry)
                                (prepare-binding! (car entry) (primitive-scheme (cdr entry)) #f 'primitive (cdr entry))) primitive-bindings))
             (classes (collect-program-classes items)))
        (check-overload-names items classes primitives)
        (let-values (((items instances) (prepare-class-items items classes)))
          (let* ((scope (extend-scope (make-scope '() '() '() classes instances) (append primitives (apply append (map class-methods classes)))))
                 (body (infer-block items scope #f (ir:make-block items loc)))
                 (globals (car (node-data body)))
                 (members (resolve-instance-members instances (append globals primitives) scope)))
            (let repeat () (when (recheck-templates! body scope) (repeat)))
            (check-obligations (node-constraints body) scope loc #f)
            (require-overloads! (node-constraints body) classes instances loc)
            (make-program body globals classes members)))))
    ;; Later uses can constrain a captured monomorphic value after an unused
    ;; function was generalized. Revisit every body, including those templates,
    ;; until no type changes; dropping private obligations must not skip checking.
    (define (template-children data)
      (cond ((node? data) (list data))
            ((pair? data) (append (template-children (car data)) (template-children (cdr data))))
            (else '())))
    (define (recheck-templates! node scope)
      (let* ((scope (if (eq? (node-kind node) 'bind) (initializer-scope (car (node-data node)) scope) scope))
             (before (type-datum (node-constraints node))) (changed? #f))
        (for-each (lambda (child) (when (recheck-templates! child scope) (set! changed? #t)))
                  (template-children (node-data node)))
        (check-obligations (node-constraints node) scope (node-loc node) #f)
        (or changed? (not (equal? before (type-datum (node-constraints node)))))))
    (define (checked-member member instance definitions scope)
      (let* ((binding (visible-binding (cdr member) definitions)) (class (instance-class instance))
             (method (let find ((methods (class-methods class)))
                       (if (eq? (car methods) (car member)) (car methods) (find (cdr methods)))))
             (expected (substitute (scheme-type (binding-scheme method)) (map cons (class-variables class) (instance-types instance))))
             (loc (ir:value-definition-loc (cdr member)))
             (checking (if (instance-scheme instance)
                           (make-scope (scope-bindings scope) '() (scheme-constraints (instance-scheme instance))
                                       (scope-classes scope) (scope-instances scope)) scope)))
        (unless binding (strict-error loc "instance member requires a stable runtime function binding"))
        (let-values (((type obligations substitutions) (instantiate (binding-scheme binding))))
          (unify! type expected loc) (check-obligations obligations checking loc #t))
        (cons (car member) binding)))
    (define (resolve-instance-members instances bindings scope)
      (for-each (lambda (instance)
                  (when (and (instance-row instance) (not (instance-scheme instance)))
                    (strict-error (node-loc (instance-row instance)) "inferred overload requires a stable runtime function binding"))) instances)
      (map (lambda (instance)
             (make-instance (instance-class instance) (instance-types instance)
                            (map (lambda (member) (checked-member member instance bindings scope)) (instance-members instance))
                            (instance-scheme instance) (instance-row instance))) instances)))

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-strict-infer)
    (import (snail-scheme test-utils)
            (only (snail-scheme expand) syntax->ir-library syntax-list->ir-library)
            (only (snail-scheme reader) string->reader)
            (only (snail-scheme syntax-parser) reader->syntax-list)
            (prefix (snail-scheme library) library:)
            (prefix (snail-scheme strict-specialize) mono:))
    (begin
      (define (test-forms text)
        (reader->syntax-list (string->reader "ownership.scm" text)))
      (define (test-no-load name) (error "unexpected library load" name))
      (define (test-cached-library)
        (syntax->ir-library
         (car (test-forms "(define-library (cache)
                           (import (scheme base)) (export identity)
                           (begin (define (identity x) x)))")) test-no-load))
      (define (test-cached-program cache text)
        (syntax-list->ir-library (test-forms text) test-no-load (library:library-dependency-order cache)))
      (define (test-infer-library library)
        (infer-program
         (apply append (map library:library-body (library:library-dependency-order library)))
         '() (library:library-loc library)))
      (define (test-cached-compilations)
        (let* ((cache (test-cached-library))
               (source (car (library:library-body cache)))
               (definition (ir:value-binding-definition source))
               (hole (scheme-type (binding-scheme definition)))
               (integer (test-infer-library
                         (test-cached-program cache "(import (cache)) (identity 42)")))
               (boolean (test-infer-library
                         (test-cached-program cache "(import (cache)) (identity #t)"))))
          (expect (resolve (node-type (program-body integer))) 'I64)
          (expect (resolve (node-type (program-body boolean))) 'Bool)
          (expect (eq? (car (program-globals integer)) (car (program-globals boolean))) #f)
          (expect (eq? (car (program-globals integer)) definition) #f)
          (expect (hole-link hole) #f)
          (expect (hole? (node-type (ir:value-binding-initializer source))) #t)))
      (define (test-template-ownership)
        (let* ((library (test-cached-program
                         (test-cached-library)
                         "(import (rename (cache) (identity left))
                                  (rename (cache) (identity right)))
                          (left 42) (right #t)"))
               (program (test-infer-library library))
               (binding (car (program-globals program))) (scheme (binding-scheme binding))
               (variable (car (scheme-variables scheme)))
               (first (mono:monomorphize program)) (second (mono:monomorphize program)))
          (expect (map mono:function-type* (mono:mono-program-functions first))
                  (list (function-type '(I64) #f 'I64) (function-type '(Bool) #f 'Bool)))
          (expect (eq? (car (mono:mono-program-functions first))
                       (car (mono:mono-program-functions second))) #f)
          (expect (eq? (mono:site-source (car (mono:mono-program-globals first))) binding) #t)
          (expect (eq? (binding-scheme binding) scheme) #t)
          (expect (hole-link variable) #f)
          (expect (eq? (resolve (function-result (node-type (binding-initializer binding)))) variable) #t)))
      (define (test-imported-declaration-owner)
        (let* ((cache (syntax->ir-library
                       (car (test-forms "(define-library (cache)
                                         (import (scheme base)) (export identity)
                                         (begin (: identity (All (A) (-> A A))))
                                         (begin (define (identity x) x)))")) test-no-load))
               (program (test-cached-program cache
                                             "(import (scheme base) (cache))\n(: identity (-> I64 I64))\n(identity #t)")))
          (expect (guard (failure (else (error-object-message failure))) (test-infer-library program))
                  "ownership.scm:2:1: type declaration requires one local definition")))
      (define (test-cached-inferred-overloads)
        (let* ((cache (syntax->ir-library
                       (car (test-forms "(define-library (cache)
                                         (import (scheme base)) (export choose)
                                         (begin (define-overload choose (lambda (value) value))))")) test-no-load))
               (row (car (library:library-body cache))) (member (ir:overload-declaration-member row))
               (hole (scheme-type (binding-scheme member)))
               (integer (test-infer-library (test-cached-program cache "(import (cache)) (choose 42)")))
               (boolean (test-infer-library (test-cached-program cache "(import (cache)) (choose #t)")))
               (first (car (program-instances integer))) (second (car (program-instances boolean))))
          (expect (resolve (node-type (program-body integer))) 'I64)
          (expect (resolve (node-type (program-body boolean))) 'Bool)
          (expect (eq? (instance-scheme first) (instance-scheme second)) #f)
          (expect (eq? (ir:overload-declaration-member (instance-row first)) member) #f)
          (expect (binding-declaration member) #f)
          (expect (hole-link hole) #f)))
      (define (test-strict-infer)
        (run-test test-cached-compilations)
        (run-test test-template-ownership)
        (run-test test-imported-declaration-owner)
        (run-test test-cached-inferred-overloads))))
   (else)))
