;; Concrete types determine native values, positional function signatures and
;; GC layouts. Top conversions are explicit nodes, never a representation
;; fallback. All references in locals, environments and cells remain GC roots.
(define-library (snail-scheme strict-wasm)
  (export strict-core->wasm)
  (import (scheme base) (scheme cxr)
          (only (snail-scheme ir)
                make-node node-kind node-type node-loc node-data binding-scheme)
          (snail-scheme strict-types)
          (snail-scheme strict-data)
          (only (snail-scheme ir) data-schema-cases)
          (snail-scheme strict-specialize) (snail-scheme strict-primitives)
          (snail-scheme wasm-extern))
  (begin

    ;; ---- Concrete layout registry ----

    (define-record-type <state>
      (make-state layouts workers cells imports) state?
      (layouts state-layouts set-state-layouts!)
      (workers state-workers set-state-workers!) (cells state-cells)
      (imports state-imports set-state-imports!))
    (define-record-type <context>
      (make-context state slots locals) context?
      (state context-state) (slots context-slots set-context-slots!)
      (locals context-locals set-context-locals!))
    (define (identifier prefix index)
      (string->symbol (string-append "$" prefix (number->string index))))
    (define (find-type type entries)
      (cond ((null? entries) #f) ((type-equal? type (caar entries)) (car entries))
            (else (find-type type (cdr entries)))))
    (define (layout! type state)
      (or (find-type type (state-layouts state))
          (let ((entry (cons type (length (state-layouts state)))))
            (check-layout-budget type state)
            (set-state-layouts! state (append (state-layouts state) (list entry)))
            (for-each (lambda (type) (wasm-type type state)) (layout-dependencies type))
            entry)))
    ;; Reserve first, then visit fields. Exact recursive applications reuse their
    ;; pending entry. The per-declaration application budget bounds compiler
    ;; resources, as the value-specialization budget does. Exceeding it is not
    ;; proof of an infinite graph; a sufficiently large finite graph also fails.
    (define (check-layout-budget type state)
      (when (and (data-type? type)
                 (>= (data-layout-count (cadr type) (state-layouts state)) 64))
        (strict-error (node-loc (data-type-schema type))
                      "data layout specialization limit exceeded (64 applications per declaration)")))
    (define (data-layout-count definition entries)
      (if (null? entries) 0
          (+ (if (and (data-type? (caar entries)) (eq? definition (cadr (caar entries)))) 1 0)
             (data-layout-count definition (cdr entries)))))
    (define (data-case-layout type index)
      (if (data-tagged? type) (list 'Data-case type index) type))
    (define (layout-dependencies type)
      (case (car type)
        ((Function) (append (function-arguments type) (list (function-result type))))
        ((Data) (if (data-tagged? type)
                    (let visit ((cases (data-schema-cases (data-type-schema type))) (index 0))
                      (if (null? cases) '()
                          (cons (data-case-layout type index) (visit (cdr cases) (+ index 1)))))
                    (data-case-fields type 0)))
        ((Data-case) (cons (cadr type) (data-case-fields (cadr type) (caddr type))))
        (else (cdr type))))
    (define (layout-name type state) (identifier "type" (cdr (layout! type state))))
    (define (call-name type state) (identifier "call" (cdr (layout! type state))))
    (define (function-arguments type)
      (append (function-domains type) (if (function-rest type) (list (list 'List (function-rest type))) '())))
    (define (wasm-type type state)
      (case type
        ((I32 Bool Char Unit) 'i32) ((I64) 'i64) ((F32) 'f32) ((F64) 'f64)
        ((Top) 'eqref) ((Never) '(ref none))
        (else (if (eq? (car type) 'List) `(ref null ,(layout-name type state)) `(ref ,(layout-name type state))))))
    (define (storage-type type state)
      (let ((physical (wasm-type type state)))
        (if (and (pair? physical) (= (length physical) 2)) `(ref null ,(cadr physical)) physical)))
    (define (result-declaration type state)
      (if (eq? type 'Never) '() (list `(result ,(wasm-type type state)))))
    (define (default-value type state)
      (let ((physical (storage-type type state)))
        (case physical
          ((i32) '(i32.const 0)) ((i64) '(i64.const 0))
          ((f32) '(f32.const 0)) ((f64) '(f64.const 0))
          ((eqref) '(ref.null eq)) (else `(ref.null ,(caddr physical))))))
    (define (nonnull value type state)
      (let ((physical (wasm-type type state)))
        (if (and (pair? physical) (= (length physical) 2)) `(ref.as_non_null ,value) value)))
    (define (layout-definitions entry state)
      (let* ((type (car entry)) (name (layout-name type state)))
        (case (car type)
          ((Function)
           (list `(type ,(call-name type state) (func (param eqref)
                                                      ,@(map (lambda (type) `(param ,(wasm-type type state))) (function-arguments type))
                                                      ,@(result-declaration (function-result type) state)))
                 `(type ,name (struct (field (ref ,(call-name type state))) (field eqref)))))
          ((Ref) (list `(type ,name (struct (field (mut ,(wasm-type (cadr type) state)))))))
          ((List) (list `(type ,name (struct (field ,(wasm-type (cadr type) state)) (field (ref null ,name))))))
          ((Vector) (list `(type ,name (array (mut ,(wasm-type (cadr type) state))))))
          ((Binding) (list `(type ,name (struct (field (mut i32)) (field (mut ,(storage-type (cadr type) state)))))))
          ((Data) (list `(type ,name ,(if (data-tagged? type)
                                          '(sub (struct (field i32)))
                                          `(struct ,@(data-field-layouts type 0 state))))))
          ((Data-case)
           (list `(type ,name (sub ,(layout-name (cadr type) state)
                                   (struct (field i32) ,@(data-field-layouts (cadr type) (caddr type) state))))))
          (else (error "unknown concrete GC layout" type)))))
    (define (data-field-layouts type index state)
      (map (lambda (field) `(field ,(wasm-type field state))) (data-case-fields type index)))

    ;; ---- Immutable products and closed sum payloads ----

    ;; Sum cases extend one tagged base; every payload field has its concrete
    ;; native type. Accessors check the tag before reading: Wasm can canonicalize
    ;; two cases with equal field shapes, so a cast alone cannot distinguish them.
    ;; Match checks the same tag when selecting an arm, then reads its fields.
    ;; Fields are immutable: mutation and its separate allocation remain Ref's
    ;; responsibility. Engine-owned reference fields trace recursive cycles.
    (define (emit-data-operation operation signature arguments state)
      (let ((index (caddr operation)))
        (if (eq? (car operation) 'construct)
            (let ((type (function-result signature)))
              `(struct.new ,(layout-name (data-case-layout type index) state)
                           ,@(if (data-tagged? type) `((i32.const ,index)) '()) ,@arguments))
            (emit-data-access signature index (cadddr operation) (car arguments) state))))
    (define (emit-data-access signature index field value state)
      (let* ((type (car (function-domains signature)))
             (payload (emit-data-field type index field value state))
             (read (if (eq? (function-result signature) 'Never)
                       `(block (drop ,payload) (unreachable)) payload)))
        (if (not (data-tagged? type)) read
            `(block ,@(result-declaration (function-result signature) state)
                    (if (i32.ne (struct.get ,(layout-name type state) 0 ,value) (i32.const ,index))
                        (then (unreachable))) ,read))))
    (define (emit-data-field type index field value state)
      (let ((name (layout-name (data-case-layout type index) state)))
        `(struct.get ,name ,(+ field (if (data-tagged? type) 1 0))
                     ,(if (data-tagged? type) `(ref.cast (ref ,name) ,value) value))))
    (define (emit-data-read node context)
      (let* ((data (node-data node)) (subject (car data)) (type (node-type subject))
             (state (context-state context)) (value (emit subject context #f)))
        (if (eq? (node-kind node) 'data-field)
            (emit-data-field type (cadr data) (caddr data) value state)
            `(i32.eq (struct.get ,(layout-name type state) 0 ,value) (i32.const ,(cadr data))))))

    ;; ---- Native slots and initialization readiness ----

    ;; A captured local binding uses a private, once-initialized cell. Capturing
    ;; its address permits recursive/forward closures without reading its value
    ;; early. The payload still has its concrete type; this is not a user Ref.
    (define (cell-value? value state) (memq value (state-cells state)))
    (define (capture-type value state)
      (if (cell-value? value state) (list 'Binding (value-type value)) (value-type value)))
    (define (new-local type context)
      (let ((name (identifier "local" (length (context-locals context)))))
        (set-context-locals! context (append (context-locals context)
                                             (list `(local ,name ,(storage-type type (context-state context)))))) name))
    (define (add-slot! value slot context)
      (set-context-slots! context (cons (cons value slot) (context-slots context))))
    (define (value-slot value context)
      (let ((entry (assq value (context-slots context))))
        (if entry (cdr entry)
            (if (site-global? (value-site value))
                (list 'global (identifier "global" (value-index value)) (identifier "ready" (value-index value)))
                (error "missing concrete local slot" (value-index value))))))
    (define (slot-cell slot) (cadr slot))
    (define (check-ready expression ready type state)
      `(block (result ,(wasm-type type state)) (if (i32.eqz ,ready) (then (unreachable))) ,expression))
    (define (read-value value context)
      (let* ((slot (value-slot value context)) (type (value-type value)) (state (context-state context)))
        (case (car slot)
          ((direct) (cadr slot))
          ((cell) (let ((name (layout-name (list 'Binding type) state)) (cell (slot-cell slot)))
                    (check-ready (nonnull `(struct.get ,name 1 ,cell) type state) `(struct.get ,name 0 ,cell) type state)))
          (else (let ((get (if (eq? (car slot) 'global) 'global.get 'local.get)))
                  (check-ready (nonnull `(,get ,(cadr slot)) type state) `(,get ,(caddr slot)) type state))))))
    (define (capture-value value context)
      (if (cell-value? value (context-state context)) (slot-cell (value-slot value context)) (read-value value context)))
    (define (initialize-value value expression context)
      (let ((slot (value-slot value context)))
        (if (eq? (car slot) 'cell)
            (let ((name (layout-name (list 'Binding (value-type value)) (context-state context))))
              `((struct.set ,name 1 ,(slot-cell slot) ,expression) (struct.set ,name 0 ,(slot-cell slot) (i32.const 1))))
            (let ((set (if (eq? (car slot) 'global) 'global.set 'local.set)))
              `((,set ,(cadr slot) ,expression) (,set ,(caddr slot) (i32.const 1)))))))
    (define (prepare-value value context)
      (cond ((site-global? (value-site value)) '())
            ((cell-value? value (context-state context))
             (let* ((type (list 'Binding (value-type value))) (name (new-local type context)))
               (add-slot! value (list 'cell `(ref.as_non_null (local.get ,name))) context)
               `((local.set ,name (struct.new_default ,(layout-name type (context-state context)))))))
            (else (add-slot! value (list 'local (new-local (value-type value) context) (new-local 'Bool context)) context) '())))
    (define (prepare-sites sites context)
      (apply append (map (lambda (value) (prepare-value value context)) (site-values sites))))
    (define (emit-bind site context)
      (append (if (site-check site) (list `(drop ,(emit (site-check site) context #f))) '())
              (apply append (map (lambda (value) (initialize-value value (emit (value-initializer value) context #f) context))
                                 (map cdr (site-instances site))))
              (if (site-token site) (initialize-value (site-token site) '(i32.const 0) context) '())))

    ;; ---- Typed closures and environments ----

    (define (environment-name function) (identifier "environment" (function-index function)))
    (define (function-name function) (identifier "function" (function-index function)))
    (define (environment-definition function state)
      `(type ,(environment-name function)
             (struct ,@(map (lambda (value) `(field ,(wasm-type (capture-type value state) state))) (function-captures function)))))
    (define (emit-closure function context)
      (let ((type (function-type* function)) (state (context-state context)))
        `(struct.new ,(layout-name type state) (ref.func ,(function-name function))
                     ,(if (null? (function-captures function)) '(ref.null eq)
                          `(struct.new ,(environment-name function)
                                       ,@(map (lambda (value) (capture-value value context)) (function-captures function)))))))
    (define (install-captures! function context)
      (let ((name (environment-name function)))
        (let visit ((captures (function-captures function)) (index 0))
          (unless (null? captures)
            (let ((expression `(struct.get ,name ,index (ref.cast (ref ,name) (local.get $environment)))))
              (add-slot! (car captures) (list (if (cell-value? (car captures) (context-state context)) 'cell 'direct) expression) context))
            (visit (cdr captures) (+ index 1))))))
    (define (emit-function function state)
      (let* ((context (make-context state '() '()))
             (values (append (function-parameters function) (if (function-rest-binding function) (list (function-rest-binding function)) '())))
             (parameters (map (lambda (value)
                                (let ((name (identifier "argument" (value-index value))))
                                  (add-slot! value (list 'direct `(local.get ,name)) context)
                                  `(param ,name ,(wasm-type (value-type value) state)))) values)))
        (install-captures! function context)
        (let ((body (emit (function-body function) context #t)))
          `(func ,(function-name function) (type ,(call-name (function-type* function) state))
                 (param $environment eqref) ,@parameters ,@(result-declaration (function-result (function-type* function)) state)
                 ,@(context-locals context) ,body))))

    ;; ---- Concrete primitives ----

    ;; I64 source indices must fit unsigned i32 before conversion. The unsigned
    ;; comparison also rejects negative I64 values. Array instructions then check
    ;; the actual bounds. Arguments here are already evaluated parameter/local
    ;; reads, so repeating an expression never repeats a source effect.
    (define (array-index expression)
      `(block (result i32)
              (if (i64.gt_u ,expression (i64.const 4294967295)) (then (unreachable)))
              (i32.wrap_i64 ,expression)))
    (define (emit-array-copy name arguments)
      ;; Checked start and end >= start make subtraction nonnegative and exact.
      ;; Native bounds then check start + span, which is the original I64 end.
      (let ((target (car arguments)) (at (cadr arguments)) (source (caddr arguments))
            (start (cadddr arguments)) (end (car (cddddr arguments))))
        `(block (result i32)
                (if (i64.lt_s ,end ,start) (then (unreachable)))
                (array.copy ,name ,name ,target ,(array-index at) ,source
                            ,(array-index start) ,(array-index `(i64.sub ,end ,start)))
                (i32.const 0))))
    ;; A Vector T is one mutable GC array with native T elements. No per-element
    ;; Scheme wrapper is introduced. array.copy checks both complete ranges
    ;; before writing and preserves overlapping-copy semantics.
    (define (emit-vector-primitive name signature arguments state)
      (let* ((type (if (memq name '(empty-vector make-vector))
                       (function-result signature) (car (function-domains signature))))
             (layout (layout-name type state)))
        (case name
          ((empty-vector) `(array.new_fixed ,layout 0))
          ((make-vector) `(array.new ,layout ,(cadr arguments) ,(array-index (car arguments))))
          ((vector-length) `(i64.extend_i32_u (array.len ,(car arguments))))
          ((vector-ref) `(array.get ,layout ,(car arguments) ,(array-index (cadr arguments))))
          ((vector-set!) `(block (result i32)
                                 (array.set ,layout ,(car arguments) ,(array-index (cadr arguments)) ,(caddr arguments))
                                 (i32.const 0)))
          ((vector-eq?) `(ref.eq ,@arguments))
          ((vector-copy!) (emit-array-copy layout arguments)))))

    (define (emit-primitive name signature arguments state)
      (let ((expression (primitive-expression name signature arguments state)))
        (if (eq? (function-result signature) 'Never) `(block (drop ,expression) (unreachable)) expression)))
    (define (primitive-expression name signature arguments state)
      (let ((opcode (primitive-opcode name)) (domains (function-domains signature)))
        (case name
          ((not) `(i32.eqz ,@arguments)) ((unit) '(i32.const 0)) ((unreachable) '(unreachable))
          ((ref) `(struct.new ,(layout-name (function-result signature) state) ,@arguments))
          ((ref-get) `(struct.get ,(layout-name (car domains) state) 0 ,@arguments))
          ((ref-set!) `(block (result i32) (struct.set ,(layout-name (car domains) state) 0 ,@arguments) (i32.const 0)))
          ((ref-eq?) `(ref.eq ,@arguments))
          ((cons) `(struct.new ,(layout-name (function-result signature) state) ,@arguments))
          ((car cdr) `(struct.get ,(layout-name (car domains) state) ,(if (eq? name 'car) 0 1) ,@arguments))
          ((null?) `(ref.is_null ,@arguments))
          ((empty-vector make-vector vector-length vector-ref vector-set! vector-eq? vector-copy!)
           (emit-vector-primitive name signature arguments state))
          (else `(,opcode ,@arguments)))))
    (define (native-wrapper! name type state)
      (let* ((key (list name type)) (prior (find-type key (state-workers state))))
        (if prior (cdr prior)
            (let ((id (identifier "primitive" (length (state-workers state)))))
              (set-state-workers! state (append (state-workers state) (list (cons key id))))
              (layout! type state) id))))
    (define (emit-primitive-closure node context)
      (let* ((state (context-state context)) (type (node-type node))
             (worker (native-wrapper! (car (node-data node)) type state)))
        `(struct.new ,(layout-name type state) (ref.func ,worker) (ref.null eq))))
    (define (emit-primitive-worker entry state)
      (let* ((name (caar entry)) (type (cadar entry))
             (parameters (let loop ((types (function-domains type)) (index 0))
                           (if (null? types) '() (cons `(param ,(identifier "argument" index) ,(wasm-type (car types) state))
                                                       (loop (cdr types) (+ index 1))))))
             (arguments (map (lambda (parameter) `(local.get ,(cadr parameter))) parameters)))
        `(func ,(cdr entry) (type ,(call-name type state)) (param $environment eqref)
               ,@parameters ,@(result-declaration (function-result type) state)
               ,(cond ((extern? name) (emit-extern-call name arguments state))
                      ((pair? name) (emit-data-operation name type arguments state))
                      (else (emit-primitive name type arguments state))))))

    ;; ---- Native scalar imports ----

    (define (extern-import! declaration state)
      (let ((prior (assq declaration (state-imports state))))
        (if prior (cdr prior)
            (let ((name (identifier "foreign" (length (state-imports state)))))
              (set-state-imports! state (append (state-imports state) (list (cons declaration name)))) name))))
    (define (emit-extern-call declaration arguments state)
      (let ((call (extern-wasm-call declaration (extern-import! declaration state) arguments)))
        (if (eq? (extern-result-type declaration) 'Unit) `(block (result i32) ,call (i32.const 0)) call)))

    ;; ---- Explicit Top injection and projection ----

    ;; Only I64 uses i31 immediates. Other source types have distinct tags even
    ;; when they share a Wasm scalar type. Managed payloads carry a full semantic
    ;; type witness because the engine may canonicalize identical GC layouts.
    (define scalar-tags '((I32 . 1) (I64 . 2) (F32 . 3) (F64 . 4) (Bool . 5) (Char . 6) (Unit . 7)))
    (define (type-tag type state)
      (let ((entry (assq type scalar-tags))) (if entry (cdr entry) (+ 16 (cdr (layout! type state))))))
    (define (scalar-bits type expression)
      (case type ((I64) expression) ((F64) `(i64.reinterpret_f64 ,expression))
            ((F32) `(i64.extend_i32_u (i32.reinterpret_f32 ,expression)))
            (else `(i64.extend_i32_u ,expression))))
    (define (bits-scalar type expression)
      (case type ((I64) expression) ((F64) `(f64.reinterpret_i64 ,expression))
            ((F32) `(f32.reinterpret_i32 (i32.wrap_i64 ,expression)))
            (else `(i32.wrap_i64 ,expression))))
    (define (inject-top type expression context)
      (let* ((state (context-state context)) (tag (type-tag type state)))
        (cond ((eq? type 'I64)
               (let ((local (new-local 'I64 context)))
                 `(block (result eqref) (local.set ,local ,expression)
                         (if (result eqref) (i64.eq (local.get ,local) (i64.shr_s (i64.shl (local.get ,local) (i64.const 33)) (i64.const 33)))
                             (then (ref.i31 (i32.wrap_i64 (local.get ,local))))
                             (else (struct.new $top-scalar (i32.const ,tag) (local.get ,local)))))))
              ((assq type scalar-tags) `(struct.new $top-scalar (i32.const ,tag) ,(scalar-bits type expression)))
              (else `(struct.new $top-reference (i32.const ,tag) ,expression)))))
    (define (checked-payload type expression state)
      (let* ((scalar? (assq type scalar-tags)) (box (if scalar? '$top-scalar '$top-reference))
             (cast `(ref.cast (ref ,box) ,expression))
             (payload `(struct.get ,box 1 ,cast))
             (result (if scalar? (bits-scalar type payload)
                         `(ref.cast ,(wasm-type type state) ,payload))))
        `(block ,@(result-declaration type state)
                (if (i32.ne (struct.get ,box 0 ,cast) (i32.const ,(type-tag type state))) (then (unreachable))) ,result)))
    (define (project-top type expression context)
      (let* ((state (context-state context)) (local (new-local 'Top context)) (get `(local.get ,local)))
        `(block ,@(result-declaration type state) (local.set ,local ,expression)
                ,(if (eq? type 'I64)
                     `(if (result i64) (ref.test (ref i31) ,get)
                          (then (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) ,get))))
                          (else ,(checked-payload type get state)))
                     (checked-payload type get state)))))
    (define (emit-conversion node context tail?)
      (let* ((child (car (node-data node))) (from (node-type child)) (to (node-type node)))
        (cond ((eq? from 'Never) `(block ,@(result-declaration to (context-state context)) ,(emit child context #f) (unreachable)))
              ((eq? to 'Never) `(block (drop ,(emit child context #f)) (unreachable)))
              ((type-equal? from to) (emit child context tail?))
              ((eq? to 'Top) (inject-top from (emit child context #f) context))
              ((eq? from 'Top) (project-top to (emit child context #f) context))
              (else (error "unsupported explicit representation conversion" from to)))))

    ;; ---- Positional calls and proper tail calls ----

    ;; Evaluate operands left to right before the operator, matching the source
    ;; frontend contract. These locals are GC roots. A rest list is materialized
    ;; only for a declared rest parameter, after every operand has been evaluated.
    (define (hold-node node context)
      (let ((local (new-local (node-type node) context)))
        (cons `(local.set ,local ,(emit node context #f))
              (nonnull `(local.get ,local) (node-type node) (context-state context)))))
    (define (split-at values count)
      (if (= count 0) (cons '() values)
          (let ((rest (split-at (cdr values) (- count 1)))) (cons (cons (car values) (car rest)) (cdr rest)))))
    (define (rest-list values type state)
      (if (null? values) `(ref.null ,(layout-name (list 'List type) state))
          `(struct.new ,(layout-name (list 'List type) state) ,(car values) ,(rest-list (cdr values) type state))))
    (define (call-arguments values signature state)
      (if (not (function-rest signature)) values
          (let ((parts (split-at values (length (function-domains signature)))))
            (append (car parts) (list (rest-list (cdr parts) (function-rest signature) state))))))
    (define (known-function operator)
      (cond ((eq? (node-kind operator) 'closure) (car (node-data operator)))
            ((eq? (node-kind operator) 'get)
             (let ((initializer (value-initializer (car (node-data operator)))))
               (and initializer (eq? (node-kind initializer) 'closure) (car (node-data initializer)))))
            (else #f)))
    (define (emit-invocation operator closure arguments context tail?)
      (let* ((state (context-state context)) (type (node-type operator)) (name (layout-name type state))
             (function (known-function operator)) (environment `(struct.get ,name 1 ,closure)))
        (if function
            `(,(if tail? 'return_call 'call) ,(function-name function) ,environment ,@arguments)
            `(,(if tail? 'return_call_ref 'call_ref) ,(call-name type state) ,environment ,@arguments (struct.get ,name 0 ,closure)))))
    (define (emit-call node context tail?)
      (let* ((operator (car (node-data node))) (arguments (cadr (node-data node)))
             (state (context-state context)) (type (node-type operator))
             (held (map (lambda (argument) (hold-node argument context)) arguments))
             (values (call-arguments (map cdr held) type state)))
        (if (memq (node-kind operator) '(primitive extern data))
            `(block ,@(result-declaration (node-type node) state) ,@(map car held)
                    ,(case (node-kind operator)
                       ((extern) (emit-extern-call (car (node-data operator)) values state))
                       ((data) (emit-data-operation (car (node-data operator)) type values state))
                       (else (emit-primitive (car (node-data operator)) type values state))))
            (let ((closure (hold-node operator context)))
              `(block ,@(result-declaration (node-type node) state) ,@(map car held) ,(car closure)
                      ,(emit-invocation operator (cdr closure) values context tail?)
                      ,@(if (eq? (node-type node) 'Never) '((unreachable)) '()))))))

    ;; ---- Structured expression emission ----

    (define (float-token value)
      (let ((spelling (number->string value)))
        (cond ((string=? spelling "+inf.0") 'inf)
              ((string=? spelling "-inf.0") (string->symbol "-inf"))
              ((or (string=? spelling "+nan.0") (string=? spelling "-nan.0")) 'nan)
              (else value))))
    (define (emit-literal node state)
      (let ((value (car (node-data node))))
        (case (node-type node)
          ((Bool) `(i32.const ,(if value 1 0))) ((Char) `(i32.const ,(char->integer value)))
          ((I32) `(i32.const ,value)) ((I64) `(i64.const ,value))
          ((F32) `(f32.const ,(float-token value))) ((F64) `(f64.const ,(float-token value)))
          (else `(ref.null ,(layout-name (node-type node) state))))))
    (define (unit-constructor? node)
      (or (eq? (node-kind node) 'unit)
          (and (eq? (node-kind node) 'call)
               (null? (cadr (node-data node)))
               (let ((operator (car (node-data node))))
                 (and (eq? (node-kind operator) 'primitive)
                      (eq? (car (node-data operator)) 'unit))))))
    ;; A Unit result already supplies the value of a trailing Unit constructor.
    ;; Only the constructor is inert: other Unit expressions may mutate or trap.
    ;; Compare semantic types, since Bool, Char and I32 also use Wasm i32.
    (define (trim-unit-suffix nodes)
      (let trim ((remaining (reverse nodes)))
        (if (and (pair? remaining) (pair? (cdr remaining))
                 (unit-constructor? (car remaining))
                 (eq? (node-type (cadr remaining)) 'Unit))
            (trim (cdr remaining))
            (reverse remaining))))
    (define (emit-sequence nodes context tail?)
      (cond ((null? nodes) '((i32.const 0)))
            ((null? (cdr nodes)) (list (emit (car nodes) context tail?)))
            (else (cons (if (eq? (node-type (car nodes)) 'Never) (emit (car nodes) context #f)
                            `(drop ,(emit (car nodes) context #f)))
                        (emit-sequence (cdr nodes) context tail?)))))
    (define (emit-block node context tail?)
      (let* ((data (node-data node)) (preparation (prepare-sites (car data) context))
             (nodes (if tail? (trim-unit-suffix (cadr data)) (cadr data)))
             (body (emit-sequence nodes context tail?)))
        `(block ,@(result-declaration (node-type node) (context-state context)) ,@preparation ,@body)))
    (define (emit-let node context tail?)
      (let* ((data (node-data node)) (preparation (prepare-sites (car data) context))
             (initializers (apply append (map (lambda (site) (emit-bind site context)) (car data))))
             (body (emit (cadr data) context tail?)))
        `(block ,@(result-declaration (node-type node) (context-state context)) ,@preparation ,@initializers ,body)))
    (define (emit node context tail?)
      (let ((state (context-state context)) (data (node-data node)))
        (case (node-kind node)
          ((literal) (emit-literal node state)) ((unit) '(i32.const 0))
          ((get) (if (eq? (node-type node) 'Never) `(block (drop ,(read-value (car data) context)) (unreachable))
                     (read-value (car data) context)))
          ((closure) (emit-closure (car data) context))
          ((primitive extern data) (emit-primitive-closure node context)) ((call) (emit-call node context tail?))
          ((data-field data-test) (emit-data-read node context))
          ((convert) (emit-conversion node context tail?))
          ((if) `(if ,@(result-declaration (node-type node) state) ,(emit (car data) context #f)
                     (then ,(emit (cadr data) context tail?)) (else ,(emit (caddr data) context tail?))))
          ((bind) `(block (result i32) ,@(emit-bind (car data) context) (i32.const 0)))
          ((block) (emit-block node context tail?))
          ((let) (emit-let node context tail?))
          (else (error "unknown concrete expression" (node-kind node))))))

    ;; ---- Standalone native module ----

    (define (global-definitions value state)
      `((global ,(identifier "global" (value-index value)) (mut ,(storage-type (value-type value) state))
                ,(default-value (value-type value) state))
        (global ,(identifier "ready" (value-index value)) (mut i32) (i32.const 0))))
    (define (captured-locals functions)
      (let collect ((values (apply append (map function-captures functions))) (result '()))
        (cond ((null? values) (reverse result))
              ((or (value-parameter? (car values)) (site-global? (value-site (car values))) (memq (car values) result))
               (collect (cdr values) result))
              (else (collect (cdr values) (cons (car values) result))))))
    (define (emit-entry body context)
      (let* ((state (context-state context)) (type (node-type body)) (expression (emit body context #f))
             (result (and (not (memq type '(Never Unit))) (new-local type context))))
        `(block ,@(if (eq? type 'Unit) '() (result-declaration type state))
                (if (global.get $execution) (then (unreachable)))
                (global.set $execution (i32.const 1))
                ,@(cond (result `((local.set ,result ,expression) (global.set $execution (i32.const 2))
                                  ,(nonnull `(local.get ,result) type state)))
                        ((eq? type 'Unit) `((drop ,expression) (global.set $execution (i32.const 2))))
                        (else `(,expression (unreachable)))))))
    (define (emit-export entry index state)
      (let* ((value (cdr entry)) (type (value-type value)) (result (function-result type))
             (context (make-context state '() '()))
             (parameters (let visit ((types (function-arguments type)) (index 0))
                           (if (null? types) '()
                               (cons `(param ,(identifier "argument" index) ,(wasm-type (car types) state))
                                     (visit (cdr types) (+ index 1))))))
             (operator (make-node 'get type #f (list value) '())) (closure (hold-node operator context))
             (call (emit-invocation operator (cdr closure) (map (lambda (parameter) `(local.get ,(cadr parameter))) parameters)
                                    context (not (eq? result 'Unit)))))
        `(func ,(identifier "export" index) (export ,(symbol->string (car entry)))
               ,@parameters ,@(if (eq? result 'Unit) '() (result-declaration result state)) ,@(context-locals context)
               (if (i32.ne (global.get $execution) (i32.const 2)) (then (unreachable)))
               ,(car closure) ,(if (eq? result 'Unit) `(drop ,call) call))))
    (define (strict-core->wasm program)
      (let* ((functions (mono-program-functions program)) (state (make-state '() '() (captured-locals functions) '()))
             (globals (apply append (map (lambda (value) (global-definitions value state)) (site-values (mono-program-globals program)))))
             (bodies (map (lambda (function) (emit-function function state)) functions))
             (context (make-context state '() '())) (main (emit-entry (mono-program-body program) context))
             (exports (let visit ((entries (mono-program-exports program)) (index 0))
                        (if (null? entries) '() (cons (emit-export (car entries) index state) (visit (cdr entries) (+ index 1))))))
             (workers (map (lambda (entry) (emit-primitive-worker entry state)) (state-workers state)))
             (environments (map (lambda (function) (environment-definition function state)) functions))
             (layouts (apply append (map (lambda (entry) (layout-definitions entry state)) (state-layouts state)))))
        `(module (rec (type $top-scalar (struct (field i32) (field i64)))
                      (type $top-reference (struct (field i32) (field eqref))) ,@layouts ,@environments)
                 ,@(map (lambda (entry) (extern-wasm-import (car entry) (cdr entry))) (state-imports state))
                 (global $execution (mut i32) (i32.const 0)) ,@globals ,@bodies ,@workers ,@exports
                 (func $main (export "main") ,@(if (eq? (node-type (mono-program-body program)) 'Unit) '()
                                                   (result-declaration (node-type (mono-program-body program)) state))
                       ,@(context-locals context) ,main))))))
