;; Whole-program storage constraints over the existing resolved IR. A hole is
;; a value set, not a source type variable: rigid All checking has already run.
;; Aliases retain allocation identities; fresh containers have fresh slot holes.
;; Directed dependencies reach a fixed point before any Wasm layout is chosen.
(define-library (snail-scheme storage-analysis)
  (export analyze-storage expression-storage-hole expression-storage-type expression-storage-reached?
          binding-storage-hole binding-storage-type binding-storage-single? storage-hole-type storage-hole-root storage-hole-single?
          storage-hole-allocations storage-allocation-kind storage-allocation-fields storage-allocation-schema
          expression-record-schema expression-record-field-index expression-field-types
          expression-storage-allocation expression-element-type expression-storage-hint storage-lambda-family storage-family-captures
          storage-lambda-captures storage-family-id storage-families)
  (import (scheme base) (scheme cxr) (snail-scheme types) (snail-scheme type-analysis)
          (snail-scheme lambda-inference) (snail-scheme specialize)
          (only (snail-scheme hash-table) make-hash-table hash-table-ref/default hash-table-set!
                hash-table-values)
          (prefix (snail-scheme ir) ir:))
  (begin

    ;; ---- Shared holes and retained dependencies ----

    (define-record-type <hole>
      (make-hole id parent type allocations callees unknown? single? tasks) hole?
      (id hole-id) (parent hole-parent set-hole-parent!)
      (type hole-type set-hole-type!) (allocations hole-allocations set-hole-allocations!)
      (callees hole-callees set-hole-callees!) (unknown? hole-unknown? set-hole-unknown!)
      (single? hole-single? set-hole-single!)
      (tasks hole-tasks set-hole-tasks!))
    (define-record-type <task>
      (make-task action queued?) task? (action task-action) (queued? task-queued? set-task-queued!))
    (define-record-type <analysis>
      (make-analysis next expressions reached bindings allocations lambdas families primitives copies globals declarations records selection queue)
      analysis? (next analysis-next set-analysis-next!)
      (expressions analysis-expressions) (reached analysis-reached) (bindings analysis-bindings)
      (allocations analysis-allocations) (lambdas analysis-lambdas)
      (families analysis-families) (primitives analysis-primitives)
      (copies analysis-copies) (globals analysis-globals) (declarations analysis-declarations)
      (records analysis-records)
      (selection analysis-selection)
      (queue analysis-queue set-analysis-queue!))

    (define (storage-hole-root hole)
      (if (not (hole-parent hole)) hole
          (let ((root (storage-hole-root (hole-parent hole)))) (set-hole-parent! hole root) root)))
    (define (storage-hole-type hole)
      (let ((type (hole-type (storage-hole-root hole)))) (if (eq? type 'Never) '? type)))
    (define (storage-hole-allocations hole) (hole-allocations (storage-hole-root hole)))
    (define (storage-hole-single? hole) (hole-single? (storage-hole-root hole)))
    (define (fresh-hole state)
      (let ((id (analysis-next state))) (set-analysis-next! state (+ id 1))
           (make-hole id #f 'Never '() '() #f #t '())))
    (define (intern-hole key table state)
      (or (hash-table-ref/default table key #f)
          (let ((hole (fresh-hole state))) (hash-table-set! table key hole) hole)))
    (define (expression-storage-hole node state) (intern-hole node (analysis-expressions state) state))
    (define (expression-storage-reached? node state) (hash-table-ref/default (analysis-reached state) node #f))
    (define (binding-storage-hole definition state) (intern-hole definition (analysis-bindings state) state))
    (define (expression-storage-type node state) (storage-hole-type (expression-storage-hole node state)))
    (define (binding-storage-type definition state) (storage-hole-type (binding-storage-hole definition state)))
    (define (binding-storage-single? definition state) (storage-hole-single? (binding-storage-hole definition state)))
    (define (lookup key entries default) (let ((entry (assq key entries))) (if entry (cdr entry) default)))
    (define (identity-union left right)
      (if (null? left) right
          (identity-union (cdr left) (if (memq (car left) right) right (cons (car left) right)))))

    (define (enqueue! task state)
      (unless (task-queued? task)
        (set-task-queued! task #t) (set-analysis-queue! state (cons task (analysis-queue state)))))
    (define (watch! holes action state)
      (let ((task (make-task action #f)))
        (for-each (lambda (hole) (let ((root (storage-hole-root hole)))
                                   (set-hole-tasks! root (cons task (hole-tasks root))))) holes)
        (enqueue! task state)))
    (define (solve! state)
      (unless (null? (analysis-queue state))
        (let ((task (car (analysis-queue state))))
          (set-analysis-queue! state (cdr (analysis-queue state))) (set-task-queued! task #f)
          ((task-action task)) (solve! state))))

    ;; This atomic join publishes all changed components before waking readers.
    (define (include! target type allocations callees unknown? state)
      (let* ((target (storage-hole-root target)) (joined (type-union (hole-type target) type))
             (objects (identity-union allocations (hole-allocations target)))
             (functions (identity-union callees (hole-callees target)))
             (opaque (and (or unknown? (hole-unknown? target)) #t)))
        (unless (and (type-equal? joined (hole-type target))
                     (= (length objects) (length (hole-allocations target)))
                     (= (length functions) (length (hole-callees target))) (eq? opaque (hole-unknown? target)))
          (set-hole-type! target joined) (set-hole-allocations! target objects)
          (set-hole-callees! target functions) (set-hole-unknown! target opaque)
          (for-each (lambda (task) (enqueue! task state)) (hole-tasks target)))))
    (define (seed! target type state) (include! target type '() '() (memq type '(? Any)) state))
    (define (raw-ingress! hole state)
      (let ((root (storage-hole-root hole)))
        (when (hole-single? root)
          (set-hole-single! root #f)
          (for-each (lambda (task) (enqueue! task state)) (hole-tasks root)))))
    (define (flow-now! source target bound state)
      (let* ((source (storage-hole-root source)) (type (hole-type source))
             (type (if bound (type-intersect type (type-erasure bound)) type)))
        (include! target type (hole-allocations source) (hole-callees source)
                  (hole-unknown? source) state)))
    (define (flow! source target bound state)
      (watch! (list source) (lambda () (flow-now! source target bound state)) state))
    (define (bind! source definition state)
      (flow! source (binding-storage-hole definition state) (lookup definition (analysis-declarations state) #f) state))

    ;; Equality is reserved for the same mutable location/capture family. Value
    ;; flow and fresh-copy element constraints are directional, never equality.
    (define (collapse! left right state)
      (let* ((left (storage-hole-root left)) (right (storage-hole-root right))
             (first (if (< (hole-id left) (hole-id right)) left right))
             (other (if (eq? first left) right left)))
        (unless (eq? first other)
          (set-hole-parent! other first)
          (set-hole-single! first (and (hole-single? first) (hole-single? other)))
          (set-hole-tasks! first (identity-union (hole-tasks other) (hole-tasks first)))
          (include! first (hole-type other) (hole-allocations other) (hole-callees other) (hole-unknown? other) state)
          (for-each (lambda (task) (enqueue! task state)) (hole-tasks first)))
        first))

    ;; ---- Allocation identity and closure environment families ----

    (define-record-type <allocation>
      (make-allocation kind fields schema escaped?) allocation?
      (kind storage-allocation-kind) (fields storage-allocation-fields)
      (schema storage-allocation-schema set-allocation-schema!)
      (escaped? allocation-escaped? set-allocation-escaped!))
    (define-record-type <family>
      (make-family id source captures) family? (id storage-family-id)
      (source family-source) (captures storage-family-captures))
    (define-record-type <procedure>
      (make-procedure node result active? escaped? captures) storage-procedure?
      (node procedure-node) (result procedure-result)
      (active? procedure-active? set-procedure-active!)
      (escaped? procedure-escaped? set-procedure-escaped!) (captures procedure-captures))

    (define (allocation! node kind count state . position)
      (let ((entries (hash-table-ref/default (analysis-allocations state) node '())))
        (let* ((key (if (null? position) kind (cons kind (car position)))) (prior (assoc key entries)))
          (if prior (cdr prior)
              (let ((object (make-allocation kind (map (lambda (unused) (fresh-hole state)) (make-list count #f)) #f #f)))
                (hash-table-set! (analysis-allocations state) node (cons (cons key object) entries)) object)))))
    (define (expression-storage-allocation node kind state . position)
      (let ((entry (assoc (if (null? position) kind (cons kind (car position)))
                          (hash-table-ref/default (analysis-allocations state) node '()))))
        (and entry (cdr entry))))
    (define (expression-element-type node kind index state)
      (let ((hole (storage-hole-root (expression-storage-hole node state))))
        (if (hole-unknown? hole) '?
            (let collect ((objects (hole-allocations hole)) (type 'Never))
              (cond ((null? objects) (if (eq? type 'Never) '? type))
                    ((eq? kind (storage-allocation-kind (car objects)))
                     (collect (cdr objects) (type-union type (hole-type (storage-hole-root (list-ref (storage-allocation-fields (car objects)) index))))))
                    (else (collect (cdr objects) type)))))))
    ;; Native reads require canonical ingress as well as a value category.
    ;; The nominal filter mirrors the check before a record's physical access.
    (define (expression-field-types node kind count schema state)
      (let ((root (storage-hole-root (expression-storage-hole node state))))
        (let collect ((objects (hole-allocations root)) (types (make-list count (if (hole-unknown? root) '? 'Never))))
          (cond ((null? objects) types)
                ((and (or (eq? kind (storage-allocation-kind (car objects)))
                          (and (eq? kind 'pair) (eq? (storage-allocation-kind (car objects)) 'rest)))
                      (or (not schema) (eq? schema (storage-allocation-schema (car objects)))))
                 (collect (cdr objects)
                          (map (lambda (type field) (type-union type (if (storage-hole-single? field) (storage-hole-type field) '?)))
                               types (storage-allocation-fields (car objects)))))
                (else (collect (cdr objects) types))))))
    (define (expression-storage-hint node state)
      (let ((type (hole-storage-hint (expression-storage-hole node state) 4)))
        (and (storage-hint? type) type)))
    (define (allocation-type object)
      (case (storage-allocation-kind object)
        ((vector) 'Vector) ((pair rest) 'Pair)
        ((record) (list 'record (ir:record-schema-definition (storage-allocation-schema object)))) (else 'Never)))
    (define (allocation-storage-hint object depth)
      (let ((fields (map (lambda (field) (hole-storage-hint field (- depth 1))) (storage-allocation-fields object))))
        (case (storage-allocation-kind object)
          ((vector) (cons 'vector-storage fields)) ((pair rest) (cons 'pair-storage fields)) (else (allocation-type object)))))
    (define (hole-storage-hint hole depth)
      (let* ((root (storage-hole-root hole)) (type (hole-type root)))
        (if (or (= depth 0) (hole-unknown? root) (null? (hole-allocations root))) type
            (let collect ((objects (hole-allocations root))
                          (result (type-subtract type (apply type-union (map allocation-type (hole-allocations root))))))
              (if (null? objects) result
                  (collect (cdr objects) (type-union result (allocation-storage-hint (car objects) depth))))))))
    (define (allocate! node kind type count result state)
      (let ((object (allocation! node kind count state)))
        (include! result type (list object) '() #f state) object))
    (define (children node)
      (cond ((ir:lambda? node) (list (ir:lambda-body node))) ((ir:block? node) (ir:block-items node))
            ((ir:application? node) (cons (ir:application-operator node) (ir:application-operands node)))
            ((ir:value-binding? node) (list (ir:value-binding-initializer node)))
            ((ir:assignment? node) (list (ir:assignment-target node) (ir:assignment-value node)))
            ((ir:conditional? node) (list (ir:conditional-test node) (ir:conditional-consequent node) (ir:conditional-opt-alternate node)))
            ((ir:annotation? node) (list (ir:annotation-expression node)))
            ((ir:instantiation? node) (list (ir:instantiation-expression node)))
            ((ir:specialization? node) (list (ir:specialization-expression node))) (else '())))
    (define (local-definitions node)
      (if (ir:lambda? node) '()
          (append (if (ir:value-binding? node) (list (ir:value-binding-definition node)) '())
                  (apply append (map local-definitions (children node))))))
    (define (parameters node)
      (append (ir:lambda-parameters node) (if (ir:lambda-opt-rest-parameter node) (list (ir:lambda-opt-rest-parameter node)) '())))
    (define (free-definitions node globals)
      (define (visit node bound)
        (cond ((ir:name? node) (let ((definition (ir:name-definition node)))
                                 (if (or (memq definition bound) (memq definition globals)) '() (list definition))))
              ((ir:lambda? node) (visit (ir:lambda-body node)
                                        (append (parameters node) (local-definitions (ir:lambda-body node)) bound)))
              (else (apply append (map (lambda (child) (visit child bound)) (children node))))))
      (let keep ((remaining (visit node '())) (seen '()))
        (cond ((null? remaining) (reverse seen)) ((memq (car remaining) seen) (keep (cdr remaining) seen))
              (else (keep (cdr remaining) (cons (car remaining) seen))))))

    (define (storage-lambda-family node state)
      (let* ((source (ir:lambda-origin node)) (table (analysis-families state)))
        (or (hash-table-ref/default table source #f)
            (let ((family (make-family (length (hash-table-values table)) source
                                       (map (lambda (definition) (cons definition (fresh-hole state)))
                                            (free-definitions source (analysis-globals state))))))
              (hash-table-set! table source family) family))))
    (define (storage-lambda-captures node state)
      (procedure-captures (register-lambda! node state)))
    (define (storage-families state) (hash-table-values (analysis-families state)))
    (define (register-lambda! node state)
      (or (hash-table-ref/default (analysis-lambdas state) node #f)
          (let* ((family (storage-lambda-family node state))
                 (definitions (free-definitions node (analysis-globals state)))
                 (captures (map (lambda (definition field)
                                  (collapse! (binding-storage-hole definition state) (cdr field) state)
                                  (cons definition (cdr field))) definitions (storage-family-captures family)))
                 (procedure (make-procedure node (fresh-hole state) #f #f captures)))
            (hash-table-set! (analysis-lambdas state) node procedure) procedure)))
    (define (activate! procedure state)
      (unless (procedure-active? procedure)
        (set-procedure-active! procedure #t)
        (flow! (scan! (ir:lambda-body (procedure-node procedure)) state) (procedure-result procedure) #f state)))

    ;; ---- Escapes invalidate every reachable mutable slot ----

    (define (escape-object! object state)
      (unless (allocation-escaped? object)
        (set-allocation-escaped! object #t)
        (for-each (lambda (field) (seed! field '? state) (escape! field state)) (storage-allocation-fields object))))
    (define (escape-procedure! procedure state)
      (unless (procedure-escaped? procedure)
        (set-procedure-escaped! procedure #t)
        (activate! procedure state)
        (for-each (lambda (definition)
                    ;; Foreign argv may carry an unconsumed values envelope.
                    ;; A physical field cannot consume it before the source does.
                    (raw-ingress! (binding-storage-hole definition state) state)
                    (let ((hole (fresh-hole state))) (seed! hole '? state) (bind! hole definition state)))
                  (parameters (procedure-node procedure)))
        (for-each (lambda (field) (escape! (cdr field) state)) (procedure-captures procedure))
        (escape! (procedure-result procedure) state)))
    (define (escape! hole state)
      (let ((seen '()))
        (watch! (list hole)
                (lambda ()
                  (let* ((root (storage-hole-root hole))
                         (objects (append (hole-allocations root) (hole-callees root))))
                    (for-each (lambda (object)
                                (unless (memq object seen)
                                  (set! seen (cons object seen))
                                  (cond ((allocation? object) (escape-object! object state))
                                        ((storage-procedure? object) (escape-procedure! object state))))) objects))) state)))

    ;; ---- Resolved expressions and guarded binding values ----

    (define (scan! node state)
      (let ((result (expression-storage-hole node state)))
        (unless (expression-storage-reached? node state)
          (hash-table-set! (analysis-reached state) node #t)
          (scan-node! node result state)) result))
    (define (scan-node! node result state)
      (cond ((ir:literal? node) (scan-literal! node (ir:literal-value node) result state))
            ((ir:name? node) (flow! (binding-storage-hole (ir:name-definition node) state) result #f state))
            ((ir:lambda? node) (include! result 'Procedure '() (list (register-lambda! node state)) #f state))
            ((ir:value-binding? node) (bind! (scan! (ir:value-binding-initializer node) state) (ir:value-binding-definition node) state))
            ((ir:assignment? node) (bind! (scan! (ir:assignment-value node) state) (ir:name-definition (ir:assignment-target node)) state)
             (seed! result 'Unspecified state))
            ((ir:block? node) (let loop ((items (ir:block-items node)))
                                (cond ((null? items) (seed! result 'Unspecified state))
                                      ((null? (cdr items)) (flow! (scan! (car items) state) result #f state))
                                      (else (scan! (car items) state) (loop (cdr items))))))
            ((ir:conditional? node) (scan! (ir:conditional-test node) state)
             (flow! (scan! (ir:conditional-consequent node) state) result #f state)
             (if (ir:conditional-opt-alternate node)
                 (flow! (scan! (ir:conditional-opt-alternate node) state) result #f state)
                 (seed! result 'Unspecified state)))
            ((ir:annotation? node) (flow! (scan! (ir:annotation-expression node) state) result (ir:annotation-type node) state))
            ((ir:instantiation? node) (flow! (scan! (ir:instantiation-expression node) state) result #f state))
            ((ir:specialization? node) (scan-view! node result state))
            ((ir:application? node) (scan-call! node result state))
            (else (seed! result 'Unspecified state))))

    (define (scan-literal! node value result state)
      (seed! result (literal-type value) state)
      ;; Literal slots stay generic, but their nested identities still participate
      ;; in alias escape. A cyclic datum is reserved before its fields are visited.
      (when (or (pair? value) (vector? value))
        (let* ((kind (if (pair? value) 'pair 'vector)) (count (if (pair? value) 2 1))
               (object (allocate! value kind (if (pair? value) 'Pair 'Vector) count result state)))
          (for-each (lambda (field) (seed! field '? state)) (storage-allocation-fields object)))))
    (define (scan-view! node result state)
      (flow! (scan! (ir:specialization-expression node) state) result #f state)
      (let ((copy (lookup (ir:specialization-definition node) (analysis-copies state) #f)))
        (if copy
            (include! result 'Procedure '() (list (register-lambda! (specialized-procedure copy) state)) #f state)
            (flow! (binding-storage-hole (ir:specialization-definition node) state) result #f state))))
    (define (scan-call! node result state)
      (let ((arguments (map (lambda (operand) (scan! operand state)) (ir:application-operands node)))
            (operator (scan! (ir:application-operator node) state))
            (selection (and (analysis-selection state) ((analysis-selection state) node)))
            (seen '()) (opaque? #f))
        (if (and selection (cadr selection))
            (connect-call! node (register-lambda! (specialized-procedure (cadr selection)) state) arguments result state)
            (watch! (list operator)
                    (lambda ()
                      (let ((root (storage-hole-root operator)))
                        (for-each (lambda (callee)
                                    (unless (or (memq callee seen)
                                                (and selection (storage-procedure? callee)
                                                     (lookup (procedure-node callee) (analysis-copies state) #f)))
                                      (set! seen (cons callee seen))
                                      (if (storage-procedure? callee) (connect-call! node callee arguments result state)
                                          (primitive-call! node (ir:value-definition-name callee) arguments result state)))) (hole-callees root))
                        (when (and (hole-unknown? root) (not opaque?))
                          (set! opaque? #t) (seed! result '? state)
                          (for-each (lambda (argument) (escape! argument state)) arguments)))) state))))

    (define (rest-list! key arguments state)
      (let ((tail (fresh-hole state)))
        (seed! tail 'Null state)
        (let prepend ((arguments (reverse arguments)) (index (- (length arguments) 1)) (tail tail))
          (if (null? arguments) tail
              (let* ((result (fresh-hole state)) (object (allocation! key 'rest 2 state index))
                     (fields (storage-allocation-fields object)))
                (include! result 'Pair (list object) '() #f state)
                (flow! (car arguments) (car fields) #f state) (flow! tail (cadr fields) #f state)
                (prepend (cdr arguments) (- index 1) result))))))
    ;; apply's unknown-length tail needs a recursive summary; a direct call's
    ;; known rest operands instead retain distinct positions and fresh spines.
    (define (unknown-rest-list! key elements state)
      (let ((result (fresh-hole state)))
        (seed! result 'Null state)
        (let* ((object (allocate! key 'rest 'Pair 2 result state)) (fields (storage-allocation-fields object)))
          (flow! elements (car fields) #f state) (flow! result (cadr fields) #f state)) result))
    (define (connect-call! node procedure arguments result state)
      (let* ((lambda (procedure-node procedure)) (copy (lookup lambda (analysis-copies state) #f))
             (source (if copy (specialized-source copy) lambda))
             (fixed (ir:lambda-parameters source)) (rest (ir:lambda-opt-rest-parameter source)))
        (when (if rest (>= (length arguments) (length fixed)) (= (length arguments) (length fixed)))
          (activate! procedure state)
          (let bind ((formals (parameters lambda)) (arguments arguments) (count (length fixed)))
            (cond ((null? formals) #t)
                  ((and rest (= count 0)) (bind! (rest-list! node arguments state) (car formals) state))
                  (else (bind! (car arguments) (car formals) state) (bind (cdr formals) (cdr arguments) (- count 1)))))
          (flow! (procedure-result procedure) result #f state))))

    ;; ---- Heap dependencies and builtin effects ----

    (define (for-objects! hole kind action unknown state)
      (let ((seen '()) (opaque? #f))
        (watch! (list hole)
                (lambda ()
                  (let ((root (storage-hole-root hole)))
                    (for-each (lambda (object)
                                (when (and (or (eq? kind (storage-allocation-kind object))
                                               (and (eq? kind 'pair) (eq? (storage-allocation-kind object) 'rest)))
                                           (not (memq object seen)))
                                  (set! seen (cons object seen)) (action object))) (hole-allocations root))
                    (when (and (hole-unknown? root) (not opaque?)) (set! opaque? #t) (unknown)))) state)))
    (define (load-field! object kind index result state)
      (for-objects! object kind (lambda (object) (flow! (list-ref (storage-allocation-fields object) index) result #f state))
                    (lambda () (seed! result '? state)) state))
    (define (store-field! object kind index value state)
      (for-objects! object kind (lambda (object) (flow! value (list-ref (storage-allocation-fields object) index) #f state))
                    (lambda () (escape! value state)) state))
    (define (copy-fields! destination source state)
      (let ((elements (fresh-hole state))) (load-field! source 'vector 0 elements state)
           (store-field! destination 'vector 0 elements state)))
    (define (vector-allocation! node arguments fill result state)
      (let* ((object (allocate! node 'vector 'Vector 1 result state)) (slot (car (storage-allocation-fields object))))
        (if fill (flow! fill slot #f state)
            (for-each (lambda (argument) (flow! argument slot #f state)) arguments))))
    (define (computed-result! name arguments result state)
      (watch! arguments (lambda ()
                          (unless (let any ((arguments arguments))
                                    (and (pair? arguments) (or (eq? (hole-type (storage-hole-root (car arguments))) 'Never)
                                                               (any (cdr arguments)))))
                            (seed! result (inferred-primitive-type name (map storage-hole-type arguments)) state))) state))

    ;; ---- Nominal records and positional constructor values ----

    (define (expression-record-schema node state)
      (and (pair? (ir:application-operands node))
           (let ((descriptor (car (ir:application-operands node))))
             (and (ir:name? descriptor) (lookup (ir:name-definition descriptor) (analysis-records state) #f)))))
    (define (record-field-index name schema)
      (let find ((fields (ir:record-schema-fields schema)) (index 0))
        (cond ((null? fields) #f) ((eq? name (caar fields)) index)
              (else (find (cdr fields) (+ index 1))))))
    (define (expression-record-field-index node state)
      (let ((schema (expression-record-schema node state)) (field (cadr (ir:application-operands node))))
        (and schema (ir:literal? field) (record-field-index (ir:literal-value field) schema))))
    (define (list-position! spine index state)
      (let ((field (fresh-hole state)))
        (if (= index 0) (load-field! spine 'pair 0 field state)
            (let ((tail (fresh-hole state))) (load-field! spine 'pair 1 tail state)
                 (flow! (list-position! tail (- index 1) state) field #f state))) field))
    (define (record-initializers! object names values state)
      (let ((schema (storage-allocation-schema object)) (fields (storage-allocation-fields object)))
        (let fill ((remaining names) (position 0))
          (unless (null? remaining)
            (let ((index (record-field-index (car remaining) schema)))
              (when index (flow! (list-position! values position state) (list-ref fields index) #f state)))
            (fill (cdr remaining) (+ position 1))))
        (for-each (lambda (field hole) (unless (memq (car field) names) (seed! hole 'Unspecified state)))
                  (ir:record-schema-fields schema) fields)))
    (define (record-allocation! node arguments result state)
      (let ((schema (expression-record-schema node state)) (names (cadr (ir:application-operands node))))
        (if (and schema (ir:literal? names) (list? (ir:literal-value names))
                 (let valid? ((names (ir:literal-value names)))
                   (or (null? names) (and (record-field-index (car names) schema) (valid? (cdr names))))))
            (let ((object (allocate! node 'record (list 'record (ir:record-schema-definition schema))
                                     (length (ir:record-schema-fields schema)) result state)))
              (set-allocation-schema! object schema)
              (record-initializers! object (ir:literal-value names) (caddr arguments) state))
            (begin (for-each (lambda (argument) (escape! argument state)) arguments) (seed! result '? state)))))
    (define (record-access! node name arguments result state)
      (let ((index (expression-record-field-index node state)) (schema (expression-record-schema node state)))
        (if index
            (begin
              (for-objects! (caddr arguments) 'record
                            (lambda (object)
                              (when (eq? schema (storage-allocation-schema object))
                                (let ((field (list-ref (storage-allocation-fields object) index)))
                                  (if (eq? name '%record-ref) (flow! field result #f state)
                                      (flow! (cadddr arguments) field #f state)))))
                            (lambda () (if (eq? name '%record-ref) (seed! result '? state)
                                           (escape! (cadddr arguments) state))) state)
              (unless (eq? name '%record-ref) (seed! result 'Unspecified state)))
            (begin (for-each (lambda (argument) (escape! argument state)) arguments) (seed! result '? state)))))

    ;; Exhaustive effect classes are deliberately visible here. Unsupported
    ;; primitives are an escape boundary, not optimistic pure Scheme functions.
    (define (primitive-call! node name arguments result state)
      (let ((count (length arguments)))
        (cond ((eq? name 'vector) (vector-allocation! node arguments #f result state))
              ((and (memq name '(make-vector %wasm.vector.new)) (memv count '(1 2)))
               (let ((fill (if (= count 2) (cadr arguments) (fresh-hole state))))
                 (when (= count 1) (seed! fill 'Unspecified state)) (vector-allocation! node '() fill result state)))
              ((and (eq? name '%wasm.vector.new-like) (= count 2))
               (vector-allocation! node '() #f result state) (copy-fields! result (cadr arguments) state))
              ((and (memq name '(vector-ref %wasm.vector.ref)) (= count 2)) (load-field! (car arguments) 'vector 0 result state))
              ((and (memq name '(vector-set! %wasm.vector.set!)) (= count 3))
               (store-field! (car arguments) 'vector 0 (caddr arguments) state) (seed! result 'Unspecified state))
              ((and (eq? name '%wasm.vector.copy!) (= count 5))
               (copy-fields! (car arguments) (caddr arguments) state) (seed! result 'Unspecified state))
              ((and (eq? name 'cons) (= count 2))
               (let ((object (allocate! node 'pair 'Pair 2 result state)))
                 (for-each (lambda (value slot) (flow! value slot #f state)) arguments (storage-allocation-fields object))))
              ((and (memq name '(car cdr)) (= count 1)) (load-field! (car arguments) 'pair (if (eq? name 'car) 0 1) result state))
              ((and (memq name '(set-car! set-cdr!)) (= count 2))
               (store-field! (car arguments) 'pair (if (eq? name 'set-car!) 0 1) (cadr arguments) state)
               (seed! result 'Unspecified state))
              ((and (eq? name '%make-record) (= count 3)) (record-allocation! node arguments result state))
              ((or (and (eq? name '%record-ref) (= count 3)) (and (eq? name '%record-set!) (= count 4)))
               (record-access! node name arguments result state))
              ((eq? name '%record?) (seed! result 'Boolean state))
              ((eq? name '%make-record-type) (seed! result 'Any state))
              ((eq? name 'values) (if (= count 1) (flow! (car arguments) result #f state) (seed! result '? state)))
              ((eq? name 'apply) (apply-call! node arguments result state))
              ((memq name '(call-with-values call/cc call-with-current-continuation))
               (for-each (lambda (argument) (escape! argument state)) arguments) (seed! result '? state))
              ((non-escaping-primitive? name) (computed-result! name arguments result state))
              (else (for-each (lambda (argument) (escape! argument state)) arguments) (seed! result '? state)))))

    ;; String/bytevector writes cannot introduce Scheme references or change
    ;; their fixed byte storage; they do not escape the tracked mutable slots.
    (define (non-escaping-primitive? name)
      (or (memq name '(+ - * / quotient remainder modulo inexact = < <= > >= eq? eqv? not
                         boolean? number? complex? rational? real? inexact? integer? exact-integer?
                         string? symbol? char? pair? null? vector? bytevector? procedure? error
                         vector-length bytevector-length bytevector-u8-ref bytevector-u8-set!
                         string-length string-ref string-set! string->symbol symbol->string
                         char->integer integer->char char=? char<? char<=? char>? char>=?
                         %hash-by-identity %eqv-hash %equal-hash %string-hash %string-ci-hash))
          (memq name '(%wasm.vector.length %wasm.i32.wrap_i64 %wasm.i64.extend_i32
                                           %wasm.f32.demote_f64 %wasm.f64.promote_f32
                                           %wasm.i32.add %wasm.i32.sub %wasm.i32.mul %wasm.i32.eq %wasm.i32.lt_s %wasm.i32.lt_u
                                           %wasm.i64.add %wasm.i64.sub %wasm.i64.mul
                                           %wasm.f32.add %wasm.f32.sub %wasm.f32.mul %wasm.f32.div
                                           %wasm.f64.add %wasm.f64.sub %wasm.f64.mul %wasm.f64.div))))
    (define (list-elements! list-hole state)
      (let ((elements (fresh-hole state)) (seen '()))
        (define (walk hole)
          (for-objects! hole 'pair
                        (lambda (object) (unless (memq object seen)
                                           (set! seen (cons object seen))
                                           (flow! (car (storage-allocation-fields object)) elements #f state)
                                           (walk (cadr (storage-allocation-fields object)))))
                        (lambda () (seed! elements '? state)) state))
        (walk list-hole) elements))
    (define (apply-call! node arguments result state)
      (when (>= (length arguments) 2)
        (let* ((operator (car arguments)) (tail (car (reverse arguments)))
               (elements (list-elements! tail state)) (seen '()))
          (for-each (lambda (argument) (flow! argument elements #f state))
                    (reverse (cdr (reverse (cdr arguments)))))
          (watch! (list operator)
                  (lambda ()
                    (let ((root (storage-hole-root operator)))
                      (for-each (lambda (callee)
                                  (unless (memq callee seen)
                                    (set! seen (cons callee seen))
                                    (if (storage-procedure? callee)
                                        (begin (activate! callee state)
                                               (for-each (lambda (parameter) (bind! elements parameter state))
                                                         (ir:lambda-parameters (procedure-node callee)))
                                               (when (ir:lambda-opt-rest-parameter (procedure-node callee))
                                                 (bind! (unknown-rest-list! node elements state)
                                                        (ir:lambda-opt-rest-parameter (procedure-node callee)) state))
                                               (flow! (procedure-result callee) result #f state))
                                        (if (eq? (ir:value-definition-name callee) 'vector)
                                            (vector-allocation! node '() elements result state)
                                            (begin (escape! elements state) (seed! result '? state)))))) (hole-callees root))
                      (when (hole-unknown? root) (escape! elements state) (seed! result '? state)))) state))))

    ;; ---- Module solve ----

    (define (register-tree! node state)
      (when (ir:lambda? node) (register-lambda! node state))
      (for-each (lambda (child) (register-tree! child state)) (children node)))
    (define (parameter-declarations typing copies)
      (append
       (apply append
              (map (lambda (binding)
                     (let ((signature (lookup (car binding) (typing-declarations typing) #f)))
                       (if (and signature (ir:lambda? (cdr binding)) (function-type? signature))
                           (map cons (ir:lambda-parameters (cdr binding)) (type-arguments (type-erasure signature))) '())))
                   (typing-bindings typing)))
       (apply append (map (lambda (copy)
                            (if (specialized-signature copy)
                                (map cons (ir:lambda-parameters (specialized-procedure copy))
                                     (type-arguments (specialized-signature copy))) '())) copies))))
    (define (analyze-storage items typing copies globals . entries)
      (let* ((copy-map (apply append (map (lambda (copy) (list (cons (specialized-definition copy) copy)
                                                               (cons (specialized-procedure copy) copy))) copies)))
             (state (make-analysis 0 (make-hash-table eq?) (make-hash-table eq?) (make-hash-table eq?) (make-hash-table eq?)
                                   (make-hash-table eq?) (make-hash-table eq?) (typing-primitives typing)
                                   copy-map globals (append (typing-declarations typing) (parameter-declarations typing copies))
                                   (typing-records typing) (and (pair? entries) (pair? (cdr entries)) (cadr entries)) '())))
        (for-each (lambda (definition)
                    (let ((hole (binding-storage-hole definition state)))
                      (if (memq definition (typing-primitives typing))
                          (include! hole 'Procedure '() (list definition) #f state)
                          (unless (assq definition (typing-bindings typing)) (seed! hole '? state))))) globals)
        (for-each (lambda (node) (register-tree! node state)) (append items (map specialized-procedure copies)))
        (for-each (lambda (node) (scan! node state)) items)
        (when (pair? items) (escape! (scan! (car (reverse items)) state) state))
        (for-each (lambda (definition) (escape! (binding-storage-hole definition state) state))
                  (if (null? entries) '() (car entries)))
        (solve! state) state))
    )

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-storage-analysis)
    (import (snail-scheme test-utils))
    (begin
      (define (test-definition name) (ir:make-value-definition name #f))
      (define (test-name definition) (ir:make-name definition #f))
      (define (test-literal value) (ir:make-literal value #f))
      (define (test-call definition . arguments) (ir:make-application (test-name definition) arguments #f))
      (define (test-binding definition value) (ir:make-value-binding definition value #f))
      (define (test-analysis items primitives . unknown)
        (let* ((items (append items (list (test-literal #f))))
               (typing (prepare-types items primitives)))
          (analyze-storage items typing '() (append primitives unknown))))
      (define (vector-slot node state)
        (storage-hole-type (car (storage-allocation-fields (expression-storage-allocation node 'vector state)))))
      (define (test-alias-and-copy)
        (let* ((vector (test-definition 'vector)) (copy (test-definition '%wasm.vector.new-like))
               (set (test-definition 'vector-set!)) (x (test-definition 'x)) (y (test-definition 'y))
               (source (test-call vector (test-literal 1)))
               (target (test-call copy (test-literal 1) (test-name x)))
               (writes (test-call set (test-name y) (test-literal 0) (test-literal "changed")))
               (copied (test-analysis (list (test-binding x source) (test-binding y target) writes) (list vector copy set)))
               (aliased (test-analysis (list (test-binding x source) (test-binding y (test-name x)) writes) (list vector copy set))))
          (expect (vector-slot source copied) 'i32)
          (expect (type-subtype? 'String (vector-slot target copied)) #t)
          (expect (type-subtype? 'String (vector-slot source aliased)) #t)))
      (define (test-known-setter-and-escape)
        (let* ((vector (test-definition 'vector)) (set (test-definition 'vector-set!))
               (setter (test-definition 'setter)) (object (test-definition 'object)) (value (test-definition 'value))
               (x (test-definition 'x)) (unknown (test-definition 'foreign))
               (source (test-call vector (test-literal 1)))
               (procedure (ir:make-lambda (list object value) #f
                                          (test-call set (test-name object) (test-literal 0) (test-name value)) #f))
               (items (list (test-binding setter procedure) (test-binding x source)
                            (test-call setter (test-name x) (test-literal 2))))
               (state (test-analysis items (list vector set)))
               (escaped (test-analysis (append items (list (test-call unknown (test-name x)))) (list vector set) unknown)))
          (expect (vector-slot source state) 'i32)
          (expect (vector-slot source escaped) '?)))
      (define (test-family-collapse)
        (let* ((x (test-definition 'x)) (y (test-definition 'y))
               (source (ir:make-lambda '() #f (test-name x) #f))
               (copy (ir:make-lambda '() #f (test-name y) #f source))
               (state (test-analysis (list (test-binding x (test-literal 1))
                                           (test-binding y (test-literal "other")) source copy) '()))
               (left (binding-storage-hole x state)) (right (binding-storage-hole y state)))
          (expect (eq? (storage-lambda-family source state) (storage-lambda-family copy state)) #t)
          (expect (eq? (storage-hole-root left) (storage-hole-root right)) #t)
          (expect (type-subtype? 'String (storage-hole-type left)) #t)
          (raw-ingress! right state) (solve! state)
          (expect (storage-hole-single? left) #f)))
      (define (test-storage-hints)
        (let* ((vector (test-definition 'vector)) (pair (test-definition 'cons))
               (source (test-call vector (test-literal 1)))
               (spine (test-call pair source (test-literal '())))
               (nullable (ir:make-conditional (test-literal #t) spine (test-literal '()) #f))
               (state (test-analysis (list nullable) (list vector pair))))
          (expect (expression-storage-hint source state) '(vector-storage i32))
          (expect (expression-storage-hint spine state) '(pair-storage (vector-storage i32) Null))
          ;; A nullable list must not acquire a non-null Pair ABI from its only
          ;; allocation: the null alternative has no allocation identity.
          (expect (expression-storage-hint nullable state) #f)))
      (define (test-record-fields)
        (let* ((make-type (test-definition '%make-record-type)) (make-record (test-definition '%make-record))
               (pair (test-definition 'cons)) (set (test-definition '%record-set!))
               (descriptor (test-definition '<record>)) (value (test-definition 'value))
               (schema (ir:make-record-schema descriptor (test-definition 'make-record) (test-definition 'record?)
                                              '(x y) (list (list 'x '? (test-definition 'x) #f)
                                                           (list 'y '? (test-definition 'y) #f)) #f))
               (fields (test-call pair (test-literal 1.5) (test-call pair (test-literal 7) (test-literal '()))))
               (object (test-call make-record (test-name descriptor) (test-literal '(x y)) fields))
               (state (test-analysis (list (test-binding descriptor (test-call make-type (test-literal 'record) (test-literal '(x y))))
                                           schema (test-binding value object)
                                           (test-call set (test-name descriptor) (test-literal 'x) (test-name value) (test-literal "changed")))
                                     (list make-type make-record pair set)))
               (allocation (expression-storage-allocation object 'record state)))
          (expect (eq? schema (storage-allocation-schema allocation)) #t)
          (expect (map storage-hole-type (storage-allocation-fields allocation)) '((U InexactReal String) i32))))
      (define (test-reached-expressions)
        (let* ((name (test-definition 'unused)) (body (test-literal 42))
               (procedure (ir:make-lambda '() #f body #f))
               (state (test-analysis (list (test-binding name procedure)) '())))
          (expect (expression-storage-reached? body state) #f)
          (expression-storage-type body state)
          ;; Emission may ask about an unexecuted body. Such a query must not
          ;; manufacture reachability and re-enable a discarded call pin.
          (expect (expression-storage-reached? body state) #f)
          (expect (expression-storage-reached? procedure state) #t)
          (scan! body state)
          (expect (expression-storage-type body state) 'i32)
          (expect (expression-storage-reached? body state) #t)))
      (define (test-unknown-join-quiescence)
        (let* ((state (test-analysis '() '())) (hole (fresh-hole state)))
          (seed! hole 'Any state)
          (watch! (list hole) (lambda () (seed! hole '? state)) state)
          (solve! state)
          (expect (hole-unknown? hole) #t)
          (for-each (lambda (unknown)
                      (include! hole 'Never '() '() unknown state)
                      (expect (analysis-queue state) '())) '(#t (Any) (? Any)))))
      (define (test-storage-analysis)
        (test-alias-and-copy) (test-known-setter-and-escape) (test-family-collapse) (test-storage-hints)
        (test-record-fields) (test-reached-expressions) (test-unknown-join-quiescence))))))
