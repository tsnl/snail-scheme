;; UTF-8 storage and scalar-indexed operations shared by both execution targets.
(define-library (snail-scheme wasm-strings)
  (export utf8-string-layout utf8-string-operation utf8-string-runtime
          utf8-string-literal utf8-string-initializers)
  (import (scheme base) (scheme cxr))
  (begin

    ;; ---- Ownership and representation ----

    ;; Fields: permission, scalar count, used bytes, backing bytes, cursor scalar,
    ;; cursor byte. Only [0, used) is text; the array length is its capacity.
    ;; That prefix is valid UTF-8. A cursor always names a scalar boundary.
    ;; Mutable owners never share backing storage. Readonly owners still cache
    ;; positions, but every public mutation checks permission before any write.
    ;; Backing references stay in Wasm locals across allocation. Native lowering
    ;; publishes these roots; there are no interior pointers or Rust handles.
    (define (utf8-string-layout name bytes)
      `(type ,name (struct (field i32) (field i32) (field (mut i32))
                           (field (mut (ref ,bytes))) (field (mut i32)) (field (mut i32)))))
    (define (text-bytes name value) `(struct.get ,name 3 ,value))
    (define (text-length name value) `(struct.get ,name 1 ,value))
    (define (text-used name value) `(struct.get ,name 2 ,value))
    (define (text-owner name permission length used bytes)
      `(struct.new ,name (i32.const ,permission) ,length ,used ,bytes (i32.const 0) (i32.const 0)))
    (define (write-permission name target)
      `(if (i32.ne (struct.get ,name 0 ,target) (i32.const 1)) (then (unreachable))))
    (define (cache-position name target scalar byte)
      `((struct.set ,name 4 ,target ,scalar) (struct.set ,name 5 ,target ,byte)))
    (define (utf8-string-operation operation arguments)
      `(call ,(string->symbol (string-append "$" (symbol->string operation))) ,@arguments))

    ;; ---- Encoding and validation ----

    (define (size-definition)
      '(func $string-size (param $length i64) (result i32)
             (if (i64.gt_u (local.get $length) (i64.const 4294967294)) (then (unreachable)))
             (i32.wrap_i64 (local.get $length))))
    (define (width-definition)
      '(func $utf8-width (param $scalar i32) (result i32)
             (if (result i32) (i32.lt_u (local.get $scalar) (i32.const 128)) (then (i32.const 1))
                 (else (if (result i32) (i32.lt_u (local.get $scalar) (i32.const 2048)) (then (i32.const 2))
                           (else (if (result i32) (i32.lt_u (local.get $scalar) (i32.const 65536))
                                     (then (i32.const 3)) (else (i32.const 4)))))))))
    ;; This width query is used only on an established UTF-8 scalar boundary.
    (define (leading-width-definition)
      '(func $utf8-leading-width (param $byte i32) (result i32)
             (if (result i32) (i32.lt_u (local.get $byte) (i32.const 128)) (then (i32.const 1))
                 (else (if (result i32) (i32.lt_u (local.get $byte) (i32.const 224)) (then (i32.const 2))
                           (else (if (result i32) (i32.lt_u (local.get $byte) (i32.const 240))
                                     (then (i32.const 3)) (else (i32.const 4)))))))))
    (define (store-definition bytes)
      `(func $utf8-store (param $bytes (ref ,bytes)) (param $at i32) (param $scalar i32) (param $width i32)
             (local $remaining i32) (local $prefix i32)
             (if (i32.eq (local.get $width) (i32.const 1))
                 (then (array.set ,bytes (local.get $bytes) (local.get $at) (local.get $scalar)))
                 (else
                  (local.set $remaining (local.get $width))
                  (loop $continuation
                        (local.set $remaining (i32.sub (local.get $remaining) (i32.const 1)))
                        (array.set ,bytes (local.get $bytes) (i32.add (local.get $at) (local.get $remaining))
                                   (i32.or (i32.const 128) (i32.and (local.get $scalar) (i32.const 63))))
                        (local.set $scalar (i32.shr_u (local.get $scalar) (i32.const 6)))
                        (br_if $continuation (i32.gt_u (local.get $remaining) (i32.const 1))))
                  (local.set $prefix
                             (if (result i32) (i32.eq (local.get $width) (i32.const 2)) (then (i32.const 192))
                                 (else (if (result i32) (i32.eq (local.get $width) (i32.const 3))
                                           (then (i32.const 224)) (else (i32.const 240))))))
                  (array.set ,bytes (local.get $bytes) (local.get $at) (i32.or (local.get $prefix) (local.get $scalar)))))))
    (define (read-definition bytes)
      `(func $utf8-read (param $bytes (ref ,bytes)) (param $at i32) (result i32)
             (local $scalar i32) (local $width i32) (local $offset i32)
             (local.set $scalar (array.get_u ,bytes (local.get $bytes) (local.get $at)))
             (if (i32.lt_u (local.get $scalar) (i32.const 128)) (then (return (local.get $scalar))))
             (local.set $width (call $utf8-leading-width (local.get $scalar)))
             (local.set $scalar (i32.and (local.get $scalar) (i32.shr_u (i32.const 127) (local.get $width))))
             (local.set $offset (i32.const 1))
             (loop $decode
                   (local.set $scalar
                              (i32.or (i32.shl (local.get $scalar) (i32.const 6))
                                      (i32.and (array.get_u ,bytes (local.get $bytes) (i32.add (local.get $at) (local.get $offset)))
                                               (i32.const 63))))
                   (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                   (br_if $decode (i32.lt_u (local.get $offset) (local.get $width))))
             (local.get $scalar)))
    ;; Validate only the requested span. Counting and validation are one walk;
    ;; the caller then copies bytes without repeating decoding or checks.
    (define (count-definition bytes)
      `(func $utf8-count (param $bytes (ref ,bytes)) (param $at i32) (param $end i32) (result i32)
             (local $count i32) (local $lead i32) (local $width i32) (local $offset i32) (local $scalar i32)
             (block $done
                    (loop $scan
                          (br_if $done (i32.eq (local.get $at) (local.get $end)))
                          (local.set $lead (array.get_u ,bytes (local.get $bytes) (local.get $at)))
                          (local.set $width (i32.const 1))
                          (if (i32.ge_u (local.get $lead) (i32.const 128))
                              (then
                               (if (i32.or (i32.lt_u (local.get $lead) (i32.const 194))
                                           (i32.gt_u (local.get $lead) (i32.const 244))) (then (unreachable)))
                               (local.set $width (call $utf8-leading-width (local.get $lead)))
                               (if (i32.gt_u (local.get $width) (i32.sub (local.get $end) (local.get $at))) (then (unreachable)))
                               (local.set $offset (i32.const 1))
                               (loop $check
                                     (if (i32.gt_u
                                          (i32.sub (array.get_u ,bytes (local.get $bytes) (i32.add (local.get $at) (local.get $offset)))
                                                   (i32.const 128)) (i32.const 63)) (then (unreachable)))
                                     (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                                     (br_if $check (i32.lt_u (local.get $offset) (local.get $width))))
                               (local.set $scalar (call $utf8-read (local.get $bytes) (local.get $at)))
                               (if (i32.ne (call $utf8-width (local.get $scalar)) (local.get $width)) (then (unreachable)))
                               (if (i32.or (i32.gt_u (local.get $scalar) (i32.const 1114111))
                                           (i32.le_u (i32.sub (local.get $scalar) (i32.const 55296)) (i32.const 2047)))
                                   (then (unreachable)))))
                          (local.set $at (i32.add (local.get $at) (local.get $width)))
                          (local.set $count (i32.add (local.get $count) (i32.const 1)))
                          (br $scan)))
             (local.get $count)))

    ;; ---- Scalar boundaries and sequential traversal ----

    (define (distance-definition)
      '(func $string-distance (param $a i32) (param $b i32) (result i32)
             (if (result i32) (i32.lt_u (local.get $a) (local.get $b))
                 (then (i32.sub (local.get $b) (local.get $a))) (else (i32.sub (local.get $a) (local.get $b))))))
    (define (boundary-definition name bytes)
      `(func $string-boundary (param $text (ref ,name)) (param $index i32) (result i32)
             (local $position i32) (local $at i32) (local $length i32) (local $bytes (ref null ,bytes))
             (local.set $length ,(text-length name '(local.get $text)))
             (if (i32.gt_u (local.get $index) (local.get $length)) (then (unreachable)))
             (if (i32.eq (local.get $length) ,(text-used name '(local.get $text))) (then (return (local.get $index))))
             (local.set $bytes ,(text-bytes name '(local.get $text)))
             (local.set $position (struct.get ,name 4 (local.get $text)))
             (local.set $at (struct.get ,name 5 (local.get $text)))
             (if (i32.lt_u (local.get $index) (call $string-distance (local.get $index) (local.get $position)))
                 (then (local.set $position (i32.const 0)) (local.set $at (i32.const 0))))
             (if (i32.lt_u (i32.sub (local.get $length) (local.get $index))
                           (call $string-distance (local.get $index) (local.get $position)))
                 (then (local.set $position (local.get $length)) (local.set $at ,(text-used name '(local.get $text)))))
             (block $forward-done
                    (loop $forward
                          (br_if $forward-done (i32.ge_u (local.get $position) (local.get $index)))
                          (local.set $at (i32.add (local.get $at) (call $utf8-leading-width (array.get_u ,bytes (local.get $bytes) (local.get $at)))))
                          (local.set $position (i32.add (local.get $position) (i32.const 1)))
                          (br $forward)))
             (block $backward-done
                    (loop $backward
                          (br_if $backward-done (i32.le_u (local.get $position) (local.get $index)))
                          (loop $previous
                                (local.set $at (i32.sub (local.get $at) (i32.const 1)))
                                (br_if $previous (i32.eq (i32.and (array.get_u ,bytes (local.get $bytes) (local.get $at)) (i32.const 192))
                                                         (i32.const 128))))
                          (local.set $position (i32.sub (local.get $position) (i32.const 1)))
                          (br $backward)))
             ,@(cache-position name '(local.get $text) '(local.get $index) '(local.get $at))
             (local.get $at)))
    (define (length-definition name)
      `(func $string-length (param $text (ref ,name)) (result i64)
             (i64.extend_i32_u ,(text-length name '(local.get $text)))))
    (define (ref-definition name)
      `(func $string-ref (param $text (ref ,name)) (param $index i64) (result i32)
             (if (i64.ge_u (local.get $index) (call $string-length (local.get $text))) (then (unreachable)))
             (call $utf8-read ,(text-bytes name '(local.get $text))
                   (call $string-boundary (local.get $text) (i32.wrap_i64 (local.get $index))))))

    ;; ---- Construction and mutation ----

    (define (new-definition name bytes)
      `(func $make-string (param $count i64) (param $fill i32) (result (ref ,name))
             (local $length i32) (local $width i32) (local $used i32) (local $bytes (ref null ,bytes)) (local $at i32)
             (local.set $length (call $string-size (local.get $count)))
             (local.set $width (call $utf8-width (local.get $fill)))
             (local.set $used (call $string-size (i64.mul (local.get $count) (i64.extend_i32_u (local.get $width)))))
             (local.set $bytes (array.new ,bytes (local.get $fill) (local.get $used)))
             (if (i32.gt_u (local.get $width) (i32.const 1))
                 (then (block $done
                              (loop $fill
                                    (br_if $done (i32.eq (local.get $at) (local.get $used)))
                                    (call $utf8-store (ref.as_non_null (local.get $bytes)) (local.get $at) (local.get $fill) (local.get $width))
                                    (local.set $at (i32.add (local.get $at) (local.get $width)))
                                    (br $fill)))))
             ,(text-owner name 1 '(local.get $length) '(local.get $used) '(ref.as_non_null (local.get $bytes)))))
    ;; Opens a byte span of the requested size. Callers fill it without any
    ;; allocation or callback, then reset the cursor to an established boundary.
    ;; Capacity avoids repeated allocations during public NUL-then-fill loops;
    ;; moving the suffix is still linear for a width-changing replacement.
    (define (resize-definition name bytes)
      `(func $string-resize (param $text (ref ,name)) (param $start i32) (param $end i32) (param $inserted i32)
             (result (ref ,bytes)) (local $old (ref null ,bytes)) (local $next (ref null ,bytes))
             (local $used i32) (local $size i32) (local $capacity i64)
             (local.set $old ,(text-bytes name '(local.get $text)))
             (if (i32.eq (i32.sub (local.get $end) (local.get $start)) (local.get $inserted))
                 (then (return (ref.as_non_null (local.get $old)))))
             (local.set $used ,(text-used name '(local.get $text)))
             (local.set $size (call $string-size
                                    (i64.add (i64.extend_i32_u (i32.sub (local.get $used) (i32.sub (local.get $end) (local.get $start))))
                                             (i64.extend_i32_u (local.get $inserted)))))
             (local.set $next (local.get $old))
             (if (i32.gt_u (local.get $size) (array.len (local.get $old)))
                 (then
                  (local.set $capacity (i64.mul (i64.extend_i32_u (array.len (local.get $old))) (i64.const 2)))
                  (if (i64.gt_u (local.get $capacity) (i64.const 4294967294)) (then (local.set $capacity (i64.const 4294967294))))
                  (if (i64.lt_u (local.get $capacity) (i64.extend_i32_u (local.get $size)))
                      (then (local.set $capacity (i64.extend_i32_u (local.get $size)))))
                  (local.set $next (array.new_default ,bytes (i32.wrap_i64 (local.get $capacity))))
                  (array.copy ,bytes ,bytes (local.get $next) (i32.const 0) (local.get $old) (i32.const 0) (local.get $start))))
             (array.copy ,bytes ,bytes (local.get $next) (i32.add (local.get $start) (local.get $inserted))
                         (local.get $old) (local.get $end) (i32.sub (local.get $used) (local.get $end)))
             (struct.set ,name 3 (local.get $text) (ref.as_non_null (local.get $next)))
             (struct.set ,name 2 (local.get $text) (local.get $size))
             (ref.as_non_null (local.get $next))))
    (define (set-definition name bytes)
      `(func $string-set! (param $text (ref ,name)) (param $index i64) (param $scalar i32) (result i32)
             (local $at i32) (local $old-width i32) (local $width i32) (local $bytes (ref null ,bytes))
             ,(write-permission name '(local.get $text))
             (if (i64.ge_u (local.get $index) (call $string-length (local.get $text))) (then (unreachable)))
             (local.set $at (call $string-boundary (local.get $text) (i32.wrap_i64 (local.get $index))))
             (local.set $old-width (call $utf8-leading-width (array.get_u ,bytes ,(text-bytes name '(local.get $text)) (local.get $at))))
             (local.set $width (call $utf8-width (local.get $scalar)))
             (local.set $bytes (call $string-resize (local.get $text) (local.get $at)
                                     (i32.add (local.get $at) (local.get $old-width)) (local.get $width)))
             (call $utf8-store (ref.as_non_null (local.get $bytes)) (local.get $at) (local.get $scalar) (local.get $width))
             ,@(cache-position name '(local.get $text) '(i32.wrap_i64 (local.get $index)) '(local.get $at))
             (i32.const 0)))
    (define (range-check length start end)
      `((if (i64.gt_u ,end ,length) (then (unreachable)))
        (if (i64.gt_u ,start ,end) (then (unreachable)))))
    (define (copy-definition name bytes)
      `(func $string-copy! (param $target (ref ,name)) (param $at i64) (param $source (ref ,name))
             (param $start i64) (param $end i64) (result i32)
             (local $first i32) (local $last i32) (local $to i32) (local $until i32) (local $size i32)
             (local $input (ref null ,bytes)) (local $snapshot (ref null ,bytes)) (local $output (ref null ,bytes))
             ,(write-permission name '(local.get $target))
             ,@(range-check '(call $string-length (local.get $source)) '(local.get $start) '(local.get $end))
             (if (i64.gt_u (local.get $at) (call $string-length (local.get $target))) (then (unreachable)))
             (if (i64.gt_u (i64.sub (local.get $end) (local.get $start))
                           (i64.sub (call $string-length (local.get $target)) (local.get $at))) (then (unreachable)))
             (local.set $first (call $string-boundary (local.get $source) (i32.wrap_i64 (local.get $start))))
             (local.set $last (call $string-boundary (local.get $source) (i32.wrap_i64 (local.get $end))))
             (local.set $to (call $string-boundary (local.get $target) (i32.wrap_i64 (local.get $at))))
             (local.set $until (call $string-boundary (local.get $target)
                                     (i32.wrap_i64 (i64.add (local.get $at) (i64.sub (local.get $end) (local.get $start))))))
             (local.set $size (i32.sub (local.get $last) (local.get $first)))
             (local.set $input ,(text-bytes name '(local.get $source)))
             ;; Resizing an overlapping source would invalidate its saved span.
             ;; Equal byte spans need no snapshot: array.copy already is memmove.
             (if (i32.and (ref.eq (local.get $source) (local.get $target))
                          (i32.ne (local.get $size) (i32.sub (local.get $until) (local.get $to))))
                 (then
                  (local.set $snapshot (array.new_default ,bytes (local.get $size)))
                  (array.copy ,bytes ,bytes (local.get $snapshot) (i32.const 0) (local.get $input) (local.get $first) (local.get $size))
                  (local.set $input (local.get $snapshot)) (local.set $first (i32.const 0))))
             (local.set $output (call $string-resize (local.get $target) (local.get $to) (local.get $until) (local.get $size)))
             (array.copy ,bytes ,bytes (local.get $output) (local.get $to) (local.get $input) (local.get $first) (local.get $size))
             ,@(cache-position name '(local.get $target) '(i32.wrap_i64 (local.get $at)) '(local.get $to))
             (i32.const 0)))

    ;; ---- Copies and UTF-8 boundaries ----

    (define (slice-definition name bytes)
      `(func $substring (param $text (ref ,name)) (param $start i64) (param $end i64) (result (ref ,name))
             (local $first i32) (local $size i32) (local $bytes (ref null ,bytes))
             ,@(range-check '(call $string-length (local.get $text)) '(local.get $start) '(local.get $end))
             (local.set $first (call $string-boundary (local.get $text) (i32.wrap_i64 (local.get $start))))
             (local.set $size (i32.sub (call $string-boundary (local.get $text) (i32.wrap_i64 (local.get $end))) (local.get $first)))
             (local.set $bytes (array.new_default ,bytes (local.get $size)))
             (array.copy ,bytes ,bytes (local.get $bytes) (i32.const 0) ,(text-bytes name '(local.get $text)) (local.get $first) (local.get $size))
             ,(text-owner name 1 '(i32.wrap_i64 (i64.sub (local.get $end) (local.get $start)))
                          '(local.get $size) '(ref.as_non_null (local.get $bytes)))))
    (define (decode-definition name bytes owner)
      `(func $utf8->string (param $source (ref ,owner)) (param $start i64) (param $end i64) (result (ref ,name))
             (local $input (ref null ,bytes)) (local $output (ref null ,bytes)) (local $count i32) (local $size i32)
             (local.set $input (struct.get ,owner 1 (local.get $source)))
             ,@(range-check '(i64.extend_i32_u (array.len (local.get $input))) '(local.get $start) '(local.get $end))
             (local.set $count (call $utf8-count (ref.as_non_null (local.get $input))
                                     (i32.wrap_i64 (local.get $start)) (i32.wrap_i64 (local.get $end))))
             (local.set $size (call $string-size (i64.sub (local.get $end) (local.get $start))))
             (local.set $output (array.new_default ,bytes (local.get $size)))
             (array.copy ,bytes ,bytes (local.get $output) (i32.const 0) (local.get $input) (i32.wrap_i64 (local.get $start)) (local.get $size))
             ,(text-owner name 1 '(local.get $count) '(local.get $size) '(ref.as_non_null (local.get $output)))))
    (define (encode-definition name bytes owner)
      `(func $string->utf8 (param $source (ref ,name)) (param $start i64) (param $end i64) (result (ref ,owner))
             (local $first i32) (local $size i32) (local $output (ref null ,bytes))
             ,@(range-check '(call $string-length (local.get $source)) '(local.get $start) '(local.get $end))
             (local.set $first (call $string-boundary (local.get $source) (i32.wrap_i64 (local.get $start))))
             (local.set $size (i32.sub (call $string-boundary (local.get $source) (i32.wrap_i64 (local.get $end))) (local.get $first)))
             (local.set $output (array.new_default ,bytes (local.get $size)))
             (array.copy ,bytes ,bytes (local.get $output) (i32.const 0) ,(text-bytes name '(local.get $source)) (local.get $first) (local.get $size))
             (struct.new ,owner (i32.const 1) (ref.as_non_null (local.get $output)))))
    (define (equal-definition name bytes)
      `(func $string=? (param $left (ref ,name)) (param $right (ref ,name)) (result i32)
             (local $size i32) (local $at i32) (local $a (ref null ,bytes)) (local $b (ref null ,bytes))
             (if (ref.eq (local.get $left) (local.get $right)) (then (return (i32.const 1))))
             (local.set $size ,(text-used name '(local.get $left)))
             (if (i32.ne (local.get $size) ,(text-used name '(local.get $right))) (then (return (i32.const 0))))
             (local.set $a ,(text-bytes name '(local.get $left))) (local.set $b ,(text-bytes name '(local.get $right)))
             (block $done
                    (loop $compare
                          (br_if $done (i32.eq (local.get $at) (local.get $size)))
                          (if (i32.ne (array.get_u ,bytes (local.get $a) (local.get $at))
                                      (array.get_u ,bytes (local.get $b) (local.get $at))) (then (return (i32.const 0))))
                          (local.set $at (i32.add (local.get $at) (i32.const 1))) (br $compare)))
             (i32.const 1)))
    (define (utf8-string-runtime name bytes owner)
      (list (size-definition) (width-definition) (leading-width-definition)
            (store-definition bytes) (read-definition bytes) (count-definition bytes)
            (distance-definition) (boundary-definition name bytes) (length-definition name) (ref-definition name)
            (new-definition name bytes) (resize-definition name bytes) (set-definition name bytes)
            (copy-definition name bytes) (slice-definition name bytes) (decode-definition name bytes owner)
            (encode-definition name bytes owner) (equal-definition name bytes)))

    ;; ---- Readonly module literals ----

    ;; Wasm array.new_fixed accepts at most 10000 elements. Large literal
    ;; storage is filled in bounded chunks by module start, before guest code
    ;; can observe it. This uses the existing supported Wasm operations.
    (define literal-chunk-size 8192)
    (define (literal-bytes bytes value start end)
      `(array.new_fixed ,bytes ,(- end start)
                        ,@(let loop ((at start))
                            (if (= at end) '() (cons `(i32.const ,(bytevector-u8-ref value at)) (loop (+ at 1)))))))
    (define (utf8-string-literal entry name bytes)
      (let* ((value (string->utf8 (car entry))) (length (bytevector-length value)))
        `(global ,(cdr entry) (ref ,name)
                 ,(text-owner name 0 `(i32.const ,(string-length (car entry))) `(i32.const ,length)
                              (if (<= length literal-chunk-size) (literal-bytes bytes value 0 length)
                                  `(array.new_default ,bytes (i32.const ,length)))))))
    (define (literal-initializers entry name bytes)
      (let* ((value (string->utf8 (car entry))) (length (bytevector-length value)))
        (if (<= length literal-chunk-size) '()
            (let loop ((at 0))
              (if (= at length) '()
                  (let ((end (min length (+ at literal-chunk-size))))
                    (cons `(array.copy ,bytes ,bytes ,(text-bytes name `(global.get ,(cdr entry))) (i32.const ,at)
                                       ,(literal-bytes bytes value at end) (i32.const 0) (i32.const ,(- end at)))
                          (loop end))))))))
    (define (utf8-string-initializers entries name bytes)
      (let ((copies (apply append (map (lambda (entry) (literal-initializers entry name bytes)) entries))))
        (if (null? copies) '() `((func $initialize-strings ,@copies) (start $initialize-strings)))))))
