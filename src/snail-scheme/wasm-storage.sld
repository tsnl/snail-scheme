;; Managed containers have one fixed element codec, selected after alias solving.
;; A codec combines a Wasm field type with its distinct Scheme boxing recipe.
(define-library (snail-scheme wasm-storage)
  (export storage-optimizations-enabled storage-definitions storage-codecs
          codec-id codec-name codec-type codec-representation codec-array codec-function
          type-codec)
  (import (scheme base) (scheme cxr) (snail-scheme types) (snail-scheme wasm-representation))
  (begin

    ;; ---- Element codecs ----

    (define storage-optimizations-enabled (make-parameter #t))
    ;; IDs describe meaning too: structurally equal i32 arrays may hold integers,
    ;; booleans, or characters. A ref.test on their array type cannot tell which.
    (define storage-codecs
      '((0 boxed Any eqref) (1 integer ExactInteger i64) (2 real InexactReal f64)
        (3 boolean Boolean (i32 boolean)) (4 character Char (i32 character))
        (5 pair Pair (ref $pair)) (6 vector Vector (ref $vector_object))
        (7 string String (ref $text_object)) (8 bytevector Bytevector (ref $bytevector))
        (9 closure Procedure (ref $closure)) (10 record Record (ref $record))
        (11 complex Complex (ref $complex)) (12 i32 WasmI32 (i32 integer)) (13 f32 WasmF32 f32)))
    (define (codec-id codec) (car codec))
    (define (codec-name codec) (cadr codec))
    (define (codec-type codec) (caddr codec))
    (define (codec-representation codec) (cadddr codec))
    (define (codec-array codec)
      (if (= (codec-id codec) 0) '$slots
          (string->symbol (string-append "$elements:" (symbol->string (codec-name codec))))))
    (define (codec-function operation codec)
      (string->symbol (string-append "$vector_" operation ":" (symbol->string (codec-name codec)))))
    (define (type-codec type)
      (let find ((codecs (cdr storage-codecs)))
        (cond ((null? codecs) (car storage-codecs))
              ((equal? (type-representation type) (codec-representation (car codecs))) (car codecs))
              (else (find (cdr codecs))))))

    (define (codec-accepts codec value)
      (case (codec-type codec)
        ((Any) '(i32.const 1)) ((ExactInteger) `(call $is_integer ,value))
        ((Boolean) `(i32.or (ref.eq ,value (global.get $false)) (ref.eq ,value (global.get $true))))
        ((Char) `(call $truthy (call $is_character ,value)))
        ((WasmI32) `(if (result i32) (call $is_integer ,value)
                        (then (i64.le_u (i64.add (call $known_integer_value ,value) (i64.const 2147483648))
                                        (i64.const 4294967295))) (else (i32.const 0))))
        ((WasmF32) `(call $is_f32 ,value))
        (else `(ref.test ,(if (eq? (codec-type codec) 'InexactReal) '(ref $float)
                              (codec-representation codec)) ,value))))
    (define (codec-storage codec object)
      `(ref.cast (ref ,(codec-array codec)) (struct.get $vector_object 1 ,object)))
    (define (codec-read codec object index)
      (box-representation `(array.get ,(codec-array codec) ,(codec-storage codec object) ,index)
                          (codec-representation codec)))
    (define (codec-write codec object index value)
      `(array.set ,(codec-array codec) ,(codec-storage codec object) ,index
                  ,(unbox-representation value (codec-representation codec))))

    ;; ---- Generated concrete workers ----

    (define (codec-allocator codec)
      `(func ,(codec-function "new" codec) (param $length i32)
             (param $fill ,(representation-wasm (codec-representation codec))) (result (ref $vector_object))
             (struct.new $vector_object (i32.const ,(if (storage-optimizations-enabled) (codec-id codec) 0))
                         ,(if (storage-optimizations-enabled)
                              `(array.new ,(codec-array codec) (local.get $fill) (local.get $length))
                              `(array.new $slots ,(box-representation '(local.get $fill) (codec-representation codec))
                                          (local.get $length)))
                         (local.get $length) (i32.const 0))))

    (define (codec-functions codec)
      (list (codec-allocator codec)
            (codec-like-allocator codec)
            (codec-reader codec)
            (codec-writer codec)
            `(func ,(codec-function "accepts" codec) (param $value eqref) (result i32)
                   ,(codec-accepts codec '(local.get $value)))))
    (define (codec-like-allocator codec)
      `(func ,(codec-function "new_like" codec) (param $length i32) (param $source (ref $vector_object))
             (result (ref $vector_object))
             (if (i32.eqz (local.get $length))
                 (then (return (struct.new $vector_object (i32.const ,(codec-id codec))
                                           (array.new_fixed ,(codec-array codec) 0) (i32.const 0) (i32.const 0)))))
             (call ,(codec-function "new" codec) (local.get $length)
                   ,(unbox-representation '(call $vector_ref (local.get $source) (i32.const 0)) (codec-representation codec)))))
    ;; A generic adapter can construct boxed storage even when every reachable
    ;; element has one concrete type. Guard the physical layout, not object
    ;; identity, and expose the fast array.get directly to the Wasm optimizer.
    (define (codec-reader codec)
      `(func ,(codec-function "ref" codec) (param $object (ref $vector_object)) (param $index i32)
             (result ,(representation-wasm (codec-representation codec)))
             (if (result ,(representation-wasm (codec-representation codec)))
                 (i32.eq (struct.get $vector_object 0 (local.get $object)) (i32.const ,(codec-id codec)))
                 (then (array.get ,(codec-array codec) ,(codec-storage codec '(local.get $object)) (local.get $index)))
                 (else ,(unbox-representation '(call $vector_ref (local.get $object) (local.get $index)) (codec-representation codec))))))
    (define (codec-writer codec)
      `(func ,(codec-function "set" codec) (param $object (ref $vector_object)) (param $index i32)
             (param $value ,(representation-wasm (codec-representation codec))) (result eqref)
             (if (i32.eq (struct.get $vector_object 0 (local.get $object)) (i32.const ,(codec-id codec)))
                 (then (array.set ,(codec-array codec) ,(codec-storage codec '(local.get $object)) (local.get $index) (local.get $value)))
                 (else (call $vector_set (local.get $object) (local.get $index)
                             ,(box-representation '(local.get $value) (codec-representation codec)))))
             (global.get $unspecified)))
    (define (layout-branch codec body)
      `(if (i32.eq (local.get $layout) (i32.const ,(codec-id codec))) (then ,body)))
    (define (storage-membership)
      `(func $storage_accepts (param $layout i32) (param $value eqref) (result i32)
             ,@(map (lambda (codec) (layout-branch codec `(return ,(codec-accepts codec '(local.get $value)))))
                    (cdr storage-codecs)) (i32.const 1)))
    (define (storage-allocation)
      `(func $vector_new_layout (param $layout i32) (param $length i32) (param $fill eqref)
             (result (ref $vector_object))
             ,@(map (lambda (codec)
                      (layout-branch codec `(return (call ,(codec-function "new" codec) (local.get $length)
                                                          ,(unbox-representation '(local.get $fill) (codec-representation codec))))))
                    (cdr storage-codecs))
             (call $vector_new:boxed (local.get $length) (local.get $fill))))
    (define (storage-read)
      `(func $vector_ref (param $object (ref $vector_object)) (param $index i32) (result eqref)
             (local $layout i32) (local.set $layout (struct.get $vector_object 0 (local.get $object)))
             ,@(map (lambda (codec) (layout-branch codec `(return ,(codec-read codec '(local.get $object) '(local.get $index)))))
                    (cdr storage-codecs))
             ,(codec-read (car storage-codecs) '(local.get $object) '(local.get $index))))
    (define (storage-write)
      `(func $vector_store (param $object (ref $vector_object)) (param $index i32) (param $value eqref)
             (local $layout i32) (local.set $layout (struct.get $vector_object 0 (local.get $object)))
             ,@(map (lambda (codec)
                      (layout-branch codec `(block ,(codec-write codec '(local.get $object) '(local.get $index) '(local.get $value))
                                                   (return)))) (cdr storage-codecs))
             ,(codec-write (car storage-codecs) '(local.get $object) '(local.get $index) '(local.get $value))))
    (define (storage-copy)
      `(func $vector_copy_same (param $destination (ref $vector_object)) (param $at i32)
             (param $source (ref $vector_object)) (param $start i32) (param $count i32)
             (local $layout i32) (local.set $layout (struct.get $vector_object 0 (local.get $destination)))
             ,@(map (lambda (codec)
                      (layout-branch codec `(block (array.copy ,(codec-array codec) ,(codec-array codec)
                                                               ,(codec-storage codec '(local.get $destination)) (local.get $at)
                                                               ,(codec-storage codec '(local.get $source)) (local.get $start) (local.get $count))
                                                   (return)))) storage-codecs)))

    ;; ---- Stable identity and generic boundaries ----

    (define shared-definitions
      '((func $vector_wrap (param $items (ref $slots)) (result (ref $vector_object))
              (struct.new $vector_object (i32.const 0) (local.get $items) (array.len (local.get $items)) (i32.const 0)))
        (func $vector_length (param $object (ref $vector_object)) (result i32)
              (struct.get $vector_object 2 (local.get $object)))
        ;; Generic adapters have no allocation-site proof. Their storage stays
        ;; generic; concrete allocations call a solver-selected codec worker.
        (func $vector_new (param $length i32) (param $fill eqref) (result (ref $vector_object))
              (call $vector_new:boxed (local.get $length) (local.get $fill)))
        (func $vector_from_slots (param $items (ref $slots)) (result (ref $vector_object))
              (call $vector_wrap (local.get $items)))
        (func $vector_new_like (param $length i32) (param $source (ref $vector_object)) (result (ref $vector_object))
              (call $vector_new:boxed (local.get $length) (global.get $unspecified)))
        (func $vector_slots (param $object (ref $vector_object)) (result (ref $slots))
              (local $items (ref $slots)) (local $index i32)
              (if (i32.eqz (struct.get $vector_object 0 (local.get $object)))
                  (then (return (ref.cast (ref $slots) (struct.get $vector_object 1 (local.get $object))))))
              (local.set $items (array.new $slots (global.get $unspecified) (call $vector_length (local.get $object))))
              (block $done (loop $next
                                 (br_if $done (i32.ge_u (local.get $index) (array.len (local.get $items))))
                                 (array.set $slots (local.get $items) (local.get $index) (call $vector_ref (local.get $object) (local.get $index)))
                                 (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next)))
              (local.get $items))
        (func $vector_bounds (param $object (ref $vector_object)) (param $start i32) (param $count i32)
              (if (i32.or (i32.gt_u (local.get $start) (call $vector_length (local.get $object)))
                          (i32.gt_u (local.get $count) (i32.sub (call $vector_length (local.get $object)) (local.get $start))))
                  (then unreachable)))
        (func $vector_set (param $object (ref $vector_object)) (param $index i32) (param $value eqref)
              (call $vector_bounds (local.get $object) (local.get $index) (i32.const 1))
              (if (i32.eqz (call $storage_accepts (struct.get $vector_object 0 (local.get $object)) (local.get $value)))
                  (then (call $fail (i32.const 8))))
              (call $vector_store (local.get $object) (local.get $index) (local.get $value)))
        (func $vector_copy (param $destination (ref $vector_object)) (param $at i32)
              (param $source (ref $vector_object)) (param $start i32) (param $count i32)
              (local $index i32)
              (call $vector_bounds (local.get $destination) (local.get $at) (local.get $count))
              (call $vector_bounds (local.get $source) (local.get $start) (local.get $count))
              (if (i32.eqz (local.get $count)) (then (return)))
              (if (i32.eq (struct.get $vector_object 0 (local.get $destination)) (struct.get $vector_object 0 (local.get $source)))
                  (then (call $vector_copy_same (local.get $destination) (local.get $at) (local.get $source) (local.get $start) (local.get $count))
                        (return)))
              (block $done (loop $next
                                 (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
                                 (call $vector_set (local.get $destination) (i32.add (local.get $at) (local.get $index))
                                       (call $vector_ref (local.get $source) (i32.add (local.get $start) (local.get $index))))
                                 (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next))))
        ;; Transport slots are not public vector objects. Values envelopes may
        ;; own either raw native slots or a stable public vector owner.
        (func $sequence_length (param $value eqref) (result i32)
              (if (result i32) (ref.test (ref $vector_object) (local.get $value))
                  (then (call $vector_length (ref.cast (ref $vector_object) (local.get $value))))
                  (else (array.len (ref.cast (ref $slots) (local.get $value))))))
        (func $sequence_ref (param $value eqref) (param $index i32) (result eqref)
              (if (result eqref) (ref.test (ref $vector_object) (local.get $value))
                  (then (call $vector_ref (ref.cast (ref $vector_object) (local.get $value)) (local.get $index)))
                  (else (array.get $slots (ref.cast (ref $slots) (local.get $value)) (local.get $index)))))
        (func $sequence_slots (param $value eqref) (result (ref $slots))
              (if (result (ref $slots)) (ref.test (ref $vector_object) (local.get $value))
                  (then (call $vector_slots (ref.cast (ref $vector_object) (local.get $value))))
                  (else (ref.cast (ref $slots) (local.get $value)))))))

    (define (storage-definitions)
      (append (map (lambda (codec) `(type ,(codec-array codec) (array (mut ,(representation-wasm (codec-representation codec))))))
                   (cdr storage-codecs))
              (apply append (map codec-functions storage-codecs))
              (list (storage-membership) (storage-allocation) (storage-read) (storage-write) (storage-copy))
              shared-definitions))))
