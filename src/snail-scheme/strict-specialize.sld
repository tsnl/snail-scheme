;; Concrete demand is a graph of binding storage and function implementations.
;; Its edges reference immutable source and substitutions, never cloned terms.
;; The source visitor is reused for summary discovery and Wasm generation.
(define-library (snail-scheme strict-specialize)
  (export prepare-generation prepare-entry-generation prepared-body prepared-functions
          prepared-globals prepared-exports prepared-context prepared-environment
          compilation-program compilation-definitions compilation-next context-entity activation-values
          generate-expression generate-initializer generate-body generation-type generation-detail generation-children
          generation-environment generation-source generation-tail?
          environment-scope environment-substitutions environment-sites environment-owner
          site-id site-source site-global? site-instances site-token site-check site-values
          value-binding? value-id value-index value-type value-site value-source value-parameter?
          value-initializer value-environment value-function value-ready-at-capture?
          function-index function-type* function-parameters function-rest-binding function-body
          function-captures function-source function-environment
          site-environment sites-for-source concrete-judgment)
  (import (scheme base) (scheme cxr) (srfi 146 hash)
          (only (srfi 128) make-default-comparator make-eq-comparator)
          (snail-scheme strict-types) (snail-scheme strict-core) (snail-scheme strict-infer)
          (snail-scheme strict-overloads) (snail-scheme strict-data) (snail-scheme strict-pass)
          (snail-scheme ir) (only (snail-scheme wasm-extern) native-scalar-signature))
  (begin

    ;; ---- Persistent compilation requests ----

    ;; Cache keys contain source identities, integer scope identities, and
    ;; frozen concrete types. A unification hole is never part of a key.
    (define-record-type <compilation>
      (make-compilation cache entities pending definitions next program) compilation?
      (cache compilation-cache) (entities compilation-entities)
      (pending compilation-pending) (definitions compilation-definitions)
      (next compilation-next) (program compilation-program))
    (define (context-entity context id) (hashmap-ref (compilation-entities context) id))
    (define (context-put context id entity)
      (make-compilation (compilation-cache context) (hashmap-set (compilation-entities context) id entity)
                        (compilation-pending context) (compilation-definitions context)
                        (compilation-next context) (compilation-program context)))
    (define (reserve context key entity pending?)
      (let ((id (compilation-next context)))
        (values id (make-compilation (hashmap-set (compilation-cache context) key id)
                                     (hashmap-set (compilation-entities context) id entity)
                                     (if pending? (cons id (compilation-pending context)) (compilation-pending context))
                                     (compilation-definitions context) (+ id 1) (compilation-program context)))))
    (define (cached context key) (hashmap-ref/default (compilation-cache context) key #f))
    (define (pop-request context)
      (make-compilation (compilation-cache context) (compilation-entities context)
                        (cdr (compilation-pending context)) (compilation-definitions context)
                        (compilation-next context) (compilation-program context)))
    (define (complete-function context id)
      (make-compilation (compilation-cache context) (compilation-entities context)
                        (compilation-pending context) (cons id (compilation-definitions context))
                        (compilation-next context) (compilation-program context)))

    ;; ---- Lexical storage and implementation summaries ----

    (define-record-type <environment>
      (make-environment scope substitutions sites owner instance) environment?
      (scope environment-scope) (substitutions environment-substitutions)
      (sites environment-sites) (owner environment-owner) (instance environment-instance))
    (define-record-type <site>
      (make-site id source environment global? instances token check) site?
      (id site-id) (source site-source) (environment site-environment)
      (global? site-global?) (instances site-instances) (token site-token) (check site-check))
    (define-record-type <value>
      (make-value id source type site environment parameter? function) value-binding?
      (id value-id) (source value-source) (type value-type) (site value-site)
      (environment value-environment) (parameter? value-parameter?) (function value-function))
    (define value-index value-id)
    (define (value-initializer value) (binding-initializer (value-source value)))
    (define (value-ready-at-capture? value) (value-parameter? value))
    (define-record-type <function>
      (make-function id source type environment parameters rest reads closures captures) function?
      (id function-index) (source function-source) (type function-type*)
      (environment function-environment) (parameters function-parameters) (rest function-rest-binding)
      (reads function-reads) (closures function-closures) (captures function-captures))
    (define (function-body function) (lambda-body (function-source function)))
    (define-record-type <program>
      (make-prepared-program body functions globals exports context environment) prepared-program?
      (body prepared-body) (functions prepared-functions) (globals prepared-globals)
      (exports prepared-exports) (context prepared-context) (environment prepared-environment))
    (define (concrete type environment loc)
      (require-concrete (substitute type (environment-substitutions environment)) loc))
    (define (lookup-site binding environment context)
      (let ((id (hashmap-ref/default (environment-sites environment) binding #f)))
        (unless id (strict-error (value-definition-loc binding) "missing lexical specialization site"))
        (context-entity context id)))
    (define (site-values sites context)
      (apply append (map (lambda (site)
                           (map (lambda (id) (context-entity context id))
                                (append (if (site-token site) (list (site-token site)) '()) (site-instances site)))) sites)))
    (define (scope-bindings-at source)
      (let collect ((items (block-items source)))
        (cond ((null? items) '())
              ((eq? (node-kind (car items)) 'bind)
               (cons (value-binding-definition (car items)) (collect (cdr items))))
              (else (collect (cdr items))))))
    (define (scope-key source environment) (list 'scope (environment-owner environment) (environment-instance environment) source))
    (define (sites-for-source source environment context)
      (let ((id (cached context (scope-key source environment))))
        (unless id (strict-error (node-loc source) "missing prepared lexical scope"))
        (context-entity context id)))
    (define (allocate-sites bindings environment global? context)
      (let loop ((bindings bindings) (sites (environment-sites environment)) (ids '()) (context context))
        (if (null? bindings) (values sites (reverse ids) context)
            (let-values (((id next) (reserve context (list 'site (environment-owner environment) (environment-instance environment) (car bindings)) #f #f)))
              (loop (cdr bindings) (hashmap-set sites (car bindings) id) (cons id ids) next)))))
    (define (prepare-sites source bindings scope parent global? context)
      (let ((prior (cached context (scope-key source parent))))
        (if prior (values (context-entity context prior) context)
            (let-values (((sites ids context) (allocate-sites bindings parent global? context)))
              (let* ((inner (make-environment scope (environment-substitutions parent) sites
                                              (environment-owner parent) (environment-instance parent)))
                     (context (let add ((bindings bindings) (ids ids) (context context))
                                (if (null? ids) context
                                    (add (cdr bindings) (cdr ids)
                                         (context-put context (car ids) (make-site (car ids) (car bindings) inner global? '() #f #f)))))))
                (let-values (((id context) (reserve context (scope-key source parent) inner #f)))
                  (values inner context)))))))

    (define (activation-values owner context)
      (let ((values (hashmap-fold (lambda (id entity values)
                                    (if (and (value-binding? entity)
                                             (eqv? owner (environment-owner (value-environment entity))))
                                        (cons entity values) values)) '() (compilation-entities context))))
        (list-sort (lambda (left right) (< (value-id left) (value-id right))) values)))

    ;; ---- Exactly one queued implementation per frozen request ----

    (define (instance-mapping binding substitutions environment)
      (let collect ((variables (scheme-variables (binding-scheme binding))))
        (if (null? variables) '()
            (let* ((entry (assq (car variables) substitutions))
                   (type (substitute (if entry (cdr entry) (car variables)) (environment-substitutions environment))))
              ;; A truly phantom quantifier has no representation to choose.
              ;; A used unresolved variable fails at its concrete operation.
              (if (concrete-type? type) (cons (cons (car variables) type) (collect (cdr variables)))
                  (collect (cdr variables)))))))
    (define (indexed-mapping binding mapping)
      (let index ((variables (scheme-variables (binding-scheme binding))) (ordinal 0))
        (if (null? variables) '()
            (let ((entry (assq (car variables) mapping)))
              (if entry (cons (cons ordinal (cdr entry)) (index (cdr variables) (+ ordinal 1)))
                  (index (cdr variables) (+ ordinal 1)))))))
    (define (request-value site type substitutions caller context)
      (let* ((mapping (instance-mapping (site-source site) substitutions caller))
             (key (list 'value (site-id site) type (indexed-mapping (site-source site) mapping))) (prior (cached context key)))
        (if prior (values (context-entity context prior) context)
            (begin
              (when (>= (length (site-instances site)) 64)
                (strict-error (value-definition-loc (site-source site)) "specialization limit exceeded; recursive instances keep changing"))
              (let* ((parent (site-environment site))
                     (environment (make-environment (binding-checking-scope (site-source site))
                                                    (append mapping (environment-substitutions parent))
                                                    (environment-sites parent) (environment-owner parent) (compilation-next context)))
                     (value (make-value (compilation-next context) (site-source site) type (site-id site) environment #f #f)))
                (let-values (((id next) (reserve context key value #t)))
                  (values value (context-put next (site-id site)
                                             (make-site (site-id site) (site-source site) parent (site-global? site)
                                                        (append (site-instances site) (list id)) (site-token site) (site-check site))))))))))
    (define (request-token site context)
      (if (site-token site) (values (site-token site) context)
          (let ((value (make-value (compilation-next context) (site-source site) 'Unit (site-id site)
                                   (site-environment site) #f #f)))
            (let-values (((id context) (reserve context (list 'token (site-id site)) value #f)))
              (values id (context-put context (site-id site)
                                      (make-site (site-id site) (site-source site) (site-environment site) (site-global? site)
                                                 (site-instances site) id (site-check site))))))))
    (define (initializer-token source environment context)
      (case (node-kind source)
        ((annotation) (initializer-token (annotation-expression source) environment context))
        ((instantiation) (initializer-token (instantiation-expression source) environment context))
        ((name) (let ((binding (name-definition source)))
                  (if (memq (binding-kind binding) '(primitive method extern data)) (values #f context)
                      (request-token (lookup-site binding environment context) context))))
        (else (values #f context))))
    (define (prepare-initializer site environment context)
      (let* ((binding (site-source site)) (scheme (binding-scheme binding)))
        (if (null? (scheme-variables scheme))
            (let-values (((value context) (request-value site (concrete (scheme-type scheme) environment (value-definition-loc binding)) '() environment context)))
              (values (context-entity context (site-id site)) context))
            (let-values (((token context) (initializer-token (source-initializer binding) environment context)))
              (let* ((current (context-entity context (site-id site)))
                     (site (make-site (site-id site) binding environment (site-global? site)
                                      (site-instances current) (site-token current) token)))
                (values site (context-put context (site-id site) site)))))))
    (define (parameter-values bindings types environment context)
      (let loop ((bindings bindings) (types types) (result '()) (context context))
        (if (null? bindings) (values (reverse result) context)
            (let* ((site (lookup-site (car bindings) environment context))
                   (value (make-value (compilation-next context) (car bindings) (car types) (site-id site) environment #t #f)))
              (let-values (((id context) (reserve context (list 'parameter (site-id site)) value #f)))
                (loop (cdr bindings) (cdr types) (cons id result)
                      (context-put context (site-id site) (make-site (site-id site) (site-source site) environment #f (list id) #f #f))))))))
    (define (request-function source type environment context)
      (let* ((key (list 'function (environment-owner environment) (environment-instance environment) source type))
             (prior (cached context key)))
        (if prior (values prior context)
            (let-values (((id context) (reserve context key #f #t)))
              (let* ((fixed (lambda-parameters source)) (rest (lambda-opt-rest-parameter source))
                     (bindings (append fixed (if rest (list rest) '())))
                     (types (append (function-domains type) (if rest (list (list 'List (function-rest type))) '())))
                     (parent (make-environment (checked-scope source (program-scopes (compilation-program context)))
                                               (environment-substitutions environment) (environment-sites environment)
                                               id id)))
                (let*-values (((inner context) (prepare-sites source bindings (environment-scope parent) parent #f context))
                              ((parameters context) (parameter-values bindings types inner context)))
                  (values id (context-put context id
                                          (make-function id source type inner
                                                         (if rest (reverse (cdr (reverse parameters))) parameters)
                                                         (and rest (car (reverse parameters))) '() '() '())))))))))

    ;; ---- Concrete static evidence ----

    (define (check-concrete-obligations obligations environment context loc)
      (let ((program (compilation-program context))
            (goals (substitute obligations (environment-substitutions environment))))
        ;; Sibling prerequisites share fresh holes. Solve them together before
        ;; requiring any one prerequisite's representation to be concrete.
        (require-overloads! goals (program-classes program) (program-instances program) loc)
        (for-each (lambda (goal) (exact-instance goal environment context loc)) goals)))
    (define (exact-instance constraint environment context loc)
      (let* ((program (compilation-program context))
             (types (map (lambda (type) (concrete type environment loc)) (cdr constraint)))
             (class (overload-class (car constraint) (program-classes program))))
        (if class
            (let ((view (select-overload-view class (car types) (program-instances program) loc #t)))
              (check-concrete-obligations (overload-view-constraints view) environment context loc)
              (overload-view-instance view))
            (let find ((instances (program-instances program)))
              (cond ((null? instances) (strict-error loc "no exact static typeclass instance" constraint))
                    ((and (eq? (car constraint) (class-definition (instance-class (car instances))))
                          (type-equal? types (instance-types (car instances)))) (car instances))
                    (else (find (cdr instances))))))))
    (define (resolve-name result environment context loc)
      (let* ((view (judgment-detail result)) (binding (car view)))
        (if (not (eq? (binding-kind binding) 'method)) view
            (let* ((instance (exact-instance (car (judgment-constraints result)) environment context loc))
                   (implementation (cdr (assq binding (instance-members instance)))))
              (let-values (((signature obligations substitutions) (instantiate (binding-scheme implementation))))
                (unify! signature (judgment-type result) loc)
                (check-concrete-obligations obligations environment context loc)
                (list implementation substitutions))))))
    (define (concrete-judgment source environment expected context)
      (let* ((program (compilation-program context))
             (result (replay-rule source (environment-scope environment) expected
                                  (environment-substitutions environment) (program-scopes program))))
        result))

    ;; ---- Manual typing and generation interleaving ----

    (define-record-type <generation>
      (make-generation source type detail children environment tail?) generation?
      (source generation-source) (type generation-type) (detail generation-detail)
      (children generation-children) (environment generation-environment) (tail? generation-tail?))
    (define (finish-arm pass source result detail children environment tail? context)
      (visit-pass pass source
                  (make-generation source (require-concrete (judgment-type result) (node-loc source))
                                   detail children environment tail?) context))
    ;; Siblings receive their predecessor's returned context. The typing replay
    ;; solves the current arm before any target instruction chooses its layout.
    ;; Only a call's signature is inspected before its operands; generated code
    ;; still evaluates operands left to right and then its operator.
    (define (generate-expression pass source environment expected context tail?)
      (generate-judgment pass source (concrete-judgment source environment expected context)
                         environment expected context tail?))
    (define (generate-judgment pass source result environment expected context tail?)
      (let* ((checked ((pass-conversion typing-pass) result expected #f))
             (from (require-concrete (judgment-type result) (node-loc source)))
             (to (require-concrete (judgment-type checked) (node-loc source))))
        (let-values (((value context) (generate-arm pass source result environment context
                                                    (and tail? (type-equal? from to)))))
          (if (type-equal? from to) (values value context)
              ((pass-conversion pass) source from to value context)))))
    (define (generate-arm pass source result environment context tail?)
      (begin
        (case (node-kind source)
          ((literal) (finish-arm pass source result (judgment-detail result) '() environment tail? context))
          ((name instantiation) (generate-name pass source result environment context tail?))
          ((lambda) (let-values (((id context) (request-function source (require-concrete (judgment-type result) (node-loc source)) environment context)))
                      (finish-arm pass source result id '() environment tail? context)))
          ((call) (generate-call pass source result environment context tail?))
          ((block) (generate-block pass source result environment context tail?))
          ((bind) (generate-binding pass source result environment context tail?))
          ((if) (generate-conditional pass source result environment context tail?))
          ((annotation) (generate-annotation pass source result environment context tail?))
          ((match) (generate-match pass source result environment context tail?))
          (else (strict-error (node-loc source) "unsupported source generation arm")))))
    (define (generate-name pass source result environment context tail?)
      (check-concrete-obligations (judgment-constraints result) environment context (node-loc source))
      (let* ((view (resolve-name result environment context (node-loc source))) (binding (car view)))
        (if (memq (binding-kind binding) '(primitive extern data))
            (finish-arm pass source result (list (binding-kind binding) (binding-payload binding)) '() environment tail? context)
            (let ((site (lookup-site binding environment context)))
              (if (memq (binding-kind binding) '(parameter mono-parameter))
                  (finish-arm pass source result (list 'get (car (site-instances site))) '() environment tail? context)
                  (let-values (((value context) (request-value site (require-concrete (judgment-type result) (node-loc source)) (cadr view) environment context)))
                    (finish-arm pass source result (list 'get (value-id value)) '() environment tail? context)))))))
    (define (generate-operands pass sources types environment context)
      (if (null? sources) (values '() context)
          (let*-values (((first context) (generate-expression pass (car sources) environment (car types) context #f))
                        ((rest context) (generate-operands pass (cdr sources) (cdr types) environment context)))
            (values (cons first rest) context))))
    (define (generate-call pass source result environment context tail?)
      (let* ((signature (require-concrete (car (judgment-detail result)) (node-loc source)))
             (types (map (lambda (type) (require-concrete type (node-loc source))) (cdr (judgment-detail result)))))
        (let*-values (((arguments context) (generate-operands pass (application-operands source) types environment context))
                      ((operator context) (generate-expression pass (application-operator source) environment signature context #f)))
          (finish-arm pass source result (cons signature types) (cons operator arguments) environment tail? context))))
    (define (generate-binding pass source result environment context tail?)
      (let-values (((site context) (prepare-initializer (lookup-site (value-binding-definition source) environment context) environment context)))
        (finish-arm pass source result (site-id site) '() environment tail? context)))
    (define (generate-sequence pass sources environment expected context tail?)
      (cond ((null? sources) (values '() context))
            ((memq (node-kind (car sources)) '(type-declaration extern-declaration data-schema))
             (generate-sequence pass (cdr sources) environment expected context tail?))
            (else
             (let*-values (((first context) (generate-expression pass (car sources) environment (and (null? (cdr sources)) expected) context (and tail? (null? (cdr sources)))))
                           ((rest context) (generate-sequence pass (cdr sources) environment expected context tail?)))
               (values (cons first rest) context)))))
    (define (unit-constructor? source)
      (and (application? source) (null? (application-operands source))
           (let ((operator (application-operator source)))
             (and (name? operator) (eq? (binding-kind (name-definition operator)) 'primitive)
                  (eq? (binding-payload (name-definition operator)) 'unit)))))
    (define (trim-unit-suffix sources environment context)
      (let trim ((remaining (reverse sources)))
        (if (and (pair? remaining) (pair? (cdr remaining)) (unit-constructor? (car remaining))
                 (eq? (resolve (judgment-type (concrete-judgment (cadr remaining) environment #f context))) 'Unit))
            (trim (cdr remaining)) (reverse remaining))))
    (define (generate-block pass source result environment context tail?)
      (let* ((program (compilation-program context)) (scope (checked-scope source (program-scopes program))))
        (let*-values (((inner context) (prepare-sites source (scope-bindings-at source) scope environment
                                                      (eq? source (program-body program)) context))
                      ((children context) (generate-sequence pass (if tail? (trim-unit-suffix (block-items source) inner context) (block-items source))
                                                             inner (judgment-type result) context tail?)))
          (finish-arm pass source result (map (lambda (binding) (site-id (lookup-site binding inner context))) (scope-bindings-at source))
                      children inner tail? context))))
    (define (generate-conditional pass source result environment context tail?)
      (let ((type (require-concrete (judgment-type result) (node-loc source))))
        (let*-values (((test context) (generate-expression pass (conditional-test source) environment 'Bool context #f))
                      ((yes context) (generate-expression pass (conditional-consequent source) environment type context tail?))
                      ((no context) (if (conditional-opt-alternate source)
                                        (generate-expression pass (conditional-opt-alternate source) environment type context tail?)
                                        (values #f context))))
          (finish-arm pass source result #f (list test yes no) environment tail? context))))
    (define (generate-annotation pass source result environment context tail?)
      (let* ((child (annotation-expression source))
             (selected (source-type (annotation-type source)
                                    (map (lambda (entry) (cons (car entry) (substitute (cdr entry) (environment-substitutions environment))))
                                         (scope-types (environment-scope environment))) (node-loc source)))
             (raw (replay-rule source (environment-scope environment) #f (environment-substitutions environment)
                               (program-scopes (compilation-program context))))
             (from (require-concrete (judgment-detail raw) (node-loc source))))
        (let-values (((value context)
                      (if (literal? child)
                          (let ((literal (infer-literal child selected)))
                            (finish-arm pass child literal (judgment-detail literal) '() environment tail? context))
                          (generate-expression pass child environment from context
                                               (and tail? (type-equal? from selected))))))
          (finish-arm pass source result (list from selected) (list value) environment tail? context))))
    (define (generate-match-arms pass arms subject-type result-type environment context tail?)
      (if (null? arms) (values '() context)
          (let* ((arm (car arms)) (arm-source (cadr arm)) (bindings (lambda-parameters arm-source))
                 (index (data-constructor-index (car arm))) (types (data-case-fields subject-type index)))
            (let*-values (((inner context) (prepare-sites arm-source bindings
                                                          (checked-scope arm-source (program-scopes (compilation-program context))) environment #f context))
                          ((ids context) (if (and (pair? bindings) (pair? (site-instances (lookup-site (car bindings) inner context))))
                                             (values (map (lambda (binding) (car (site-instances (lookup-site binding inner context)))) bindings) context)
                                             (parameter-values bindings types inner context)))
                          ((body context) (generate-expression pass (lambda-body arm-source) inner result-type context tail?))
                          ((rest context) (generate-match-arms pass (cdr arms) subject-type result-type environment context tail?)))
              (values (cons (list index ids body) rest) context)))))
    (define (generate-match pass source result environment context tail?)
      (let ((type (require-concrete (judgment-detail result) (node-loc source))))
        (let*-values (((subject context) (generate-expression pass (match-subject source) environment type context #f))
                      ((arms context) (generate-match-arms pass (match-arms source) type (require-concrete (judgment-type result) (node-loc source)) environment context tail?)))
          (finish-arm pass source result type (cons subject arms) environment tail? context))))

    ;; ---- Summaries from the same source visitor ----

    (define (add-function-use context owner value closure?)
      (if (not owner) context
          (let* ((function (context-entity context owner))
                 (reads (function-reads function)) (closures (function-closures function)))
            (context-put context owner
                         (make-function owner (function-source function) (function-type* function) (function-environment function)
                                        (function-parameters function) (function-rest-binding function)
                                        (if closure? reads (identity-union (list value) reads))
                                        (if closure? (identity-union (list value) closures) closures) (function-captures function))))))
    (define (summarize-arm source generation context)
      (values #f context))
    (define (summarize-name source generation context)
      (let ((detail (generation-detail generation)))
        (values #f (if (eq? (car detail) 'get)
                       (add-function-use context (environment-owner (generation-environment generation)) (cadr detail) #f) context))))
    (define (summarize-lambda source generation context)
      (values (generation-detail generation)
              (add-function-use context (environment-owner (generation-environment generation)) (generation-detail generation) #t)))
    (define (summarize-binding source generation context)
      (let* ((site (context-entity context (generation-detail generation))) (token (site-check site)))
        (values #f (if token (add-function-use context (environment-owner (generation-environment generation)) token #f) context))))
    (define (summarize-conversion source from to value context) (values value context))
    (define summary-pass
      (make-pass summarize-arm summarize-name summarize-lambda summarize-arm summarize-arm summarize-arm
                 summarize-arm summarize-name summarize-arm summarize-binding summarize-conversion))
    (define (generate-body pass function context)
      (generate-expression pass (function-body function) (function-environment function)
                           (function-result (function-type* function)) context #t))
    (define (generate-initializer pass value context)
      (let ((source (value-initializer value)))
        (if (and (literal? source) (binding-declaration (value-source value)))
            (generate-judgment pass source (infer-literal source (value-type value))
                               (value-environment value) (value-type value) context #f)
            (generate-expression pass source (value-environment value) (value-type value) context #f))))
    (define (drain-requests context)
      (if (null? (compilation-pending context)) context
          (let* ((id (car (compilation-pending context))) (request (context-entity context id)) (context (pop-request context)))
            (if (function? request)
                (let-values (((unused context) (generate-body summary-pass request context)))
                  (drain-requests (complete-function context id)))
                (let-values (((function context) (generate-initializer summary-pass request context)))
                  (drain-requests (context-put context id
                                               (make-value id (value-source request) (value-type request) (value-site request)
                                                           (value-environment request) #f function))))))))
    (define (free-captures function context)
      (let ((used (append (function-reads function)
                          (apply append (map (lambda (id) (function-captures (context-entity context id))) (function-closures function))))))
        (let collect ((used used) (result '()))
          (if (null? used) (list-sort < result)
              (let* ((value (context-entity context (car used))) (site (context-entity context (value-site value))))
                (collect (cdr used)
                         (if (or (site-global? site) (eqv? (environment-owner (value-environment value)) (function-index function))
                                 (memv (car used) result)) result (cons (car used) result))))))))
    (define (list-sort less? values)
      (define (insert value sorted)
        (if (or (null? sorted) (less? value (car sorted))) (cons value sorted)
            (cons (car sorted) (insert value (cdr sorted)))))
      (if (null? values) '() (insert (car values) (list-sort less? (cdr values)))))
    (define (settle-captures context)
      (let loop ((ids (compilation-definitions context)) (changed? #f) (context context))
        (if (null? ids) (if changed? (settle-captures context) context)
            (let* ((function (context-entity context (car ids))) (captures (free-captures function context)))
              (loop (cdr ids) (or changed? (not (equal? captures (function-captures function))))
                    (context-put context (car ids)
                                 (make-function (function-index function) (function-source function) (function-type* function)
                                                (function-environment function) (function-parameters function) (function-rest-binding function)
                                                (function-reads function) (function-closures function) captures)))))))

    ;; ---- Public scalar exports and program demand ----

    (define (check-export-names names loc)
      (unless (null? names)
        (unless (symbol? (car names)) (strict-error loc "export name must be an identifier" (car names)))
        (when (memq (car names) (cdr names)) (strict-error loc "export names must be distinct" (car names)))
        (check-export-names (cdr names) loc)))
    (define (check-export-signature type loc)
      (when (function-rest type) (strict-error loc "native export requires fixed scalar parameters"))
      (guard (failure (else (strict-error loc "native export requires scalar parameters and a scalar or Unit result")))
        (native-scalar-signature (function-domains type) (function-result type))))
    (define (selected-export entry environment context)
      (let* ((binding (cdr entry)) (scheme (binding-scheme binding)) (type (scheme-type scheme))
             (site (lookup-site binding environment context)) (loc (value-definition-loc binding)))
        (unless (and (null? (scheme-variables scheme)) (function-type? type))
          (strict-error loc "entry requires a concrete function" (car entry)))
        (check-export-signature (require-concrete type loc) loc)
        (cons (car entry) (context-entity context (car (site-instances site))))))
    ;; CLI names retain their declaration requirement. The library Entry API
    ;; supplies a checked binding directly and accepts an inferred signature.
    (define (named-global-bindings name bindings)
      (cond ((null? bindings) '())
            ((eq? name (value-definition-name (car bindings)))
             (cons (car bindings) (named-global-bindings name (cdr bindings))))
            (else (named-global-bindings name (cdr bindings)))))
    (define (legacy-export-binding name program)
      (let ((loc (node-loc (program-body program)))
            (matches (named-global-bindings name (program-globals program))))
        (when (eq? name 'main) (strict-error loc "main is reserved for one-shot initialization"))
        (unless (= (length matches) 1) (strict-error loc "export requires one unambiguous top-level binding" name))
        (let* ((binding (car matches)) (scheme (binding-scheme binding)))
          (unless (and (eq? (binding-kind binding) 'value) (binding-declaration binding)
                       (null? (scheme-variables scheme)) (function-type? (scheme-type scheme)))
            (strict-error (value-definition-loc binding) "export requires an explicit concrete function declaration" name))
          (cons name binding))))
    (define (prepare-generation program . names)
      (check-export-names names (node-loc (program-body program)))
      (prepare-selected-generation program (map (lambda (name) (legacy-export-binding name program)) names)))
    (define (prepare-entry-generation program binding) (prepare-selected-generation program (list (cons 'entry binding))))
    (define (prepare-selected-generation program entries)
      (let* ((context (make-compilation (hashmap (make-default-comparator)) (hashmap (make-default-comparator)) '() '() 0 program))
             (source (program-body program))
             (environment (make-environment (checked-scope source (program-scopes program)) '() (hashmap (make-eq-comparator)) #f #f)))
        (let-values (((unused context) (generate-expression summary-pass source environment (program-type program) context #f)))
          (let* ((context (settle-captures (drain-requests context)))
                 (inner (sites-for-source source environment context))
                 (functions (map (lambda (id) (context-entity context id)) (list-sort < (compilation-definitions context))))
                 (globals (map (lambda (binding) (lookup-site binding inner context)) (scope-bindings-at source))))
            (make-prepared-program source functions globals (map (lambda (entry) (selected-export entry inner context)) entries) context environment))))))

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-strict-specialize)
    (import (snail-scheme test-utils)
            (only (snail-sfir frontend) syntax-list->ir-library)
            (only (snail-scheme reader) string->reader)
            (only (snail-scheme syntax-parser) reader->syntax-list)
            (prefix (snail-scheme library) library:))
    (begin
      (define (test-program text)
        (let ((library (syntax-list->ir-library (reader->syntax-list (string->reader "demand.sfir" text))
                                                (lambda (name) (error "unexpected import" name)) '())))
          (infer-program (library:library-body library) '() (library:library-loc library))))
      (define (test-recursive-reservation)
        (let* ((source (test-program "(def identity (lambda (x) (if #t x (identity x))))
                                     (identity #t) (identity #t) (identity (ann 42 I64))"))
               (first (prepare-generation source)) (second (prepare-generation source)))
          (expect (length (prepared-functions first)) 2)
          (expect (length (site-instances (car (prepared-globals first)))) 2)
          (expect (compilation-pending (prepared-context first)) '())
          (expect (map function-index (prepared-functions first))
                  (map function-index (prepared-functions second)))
          (expect (eq? (program-body source) (prepared-body first)) #t)))
      (define (test-concrete-lexical-captures)
        (let* ((source (test-program "(def make (lambda (x) (lambda () x)))
                                     (def integer (make 42)) (def boolean (make #t)) (integer) (boolean)"))
               (program (prepare-generation source)) (context (prepared-context program))
               (captures (apply append (map function-captures (prepared-functions program)))))
          (expect (length (prepared-functions program)) 4)
          (expect (length captures) 2)
          (expect (if (member 'I32 (map (lambda (id) (value-type (context-entity context id))) captures)) #t #f) #t)
          (expect (if (member 'Bool (map (lambda (id) (value-type (context-entity context id))) captures)) #t #f) #t)))
      (define (test-persistent-reservation)
        (let* ((context (make-compilation (hashmap (make-default-comparator)) (hashmap (make-default-comparator)) '() '() 0 #f)))
          (let-values (((id next) (reserve context '(function sample I64) 'implementation #t)))
            (expect id 0) (expect (cached next '(function sample I64)) 0)
            (expect (compilation-pending next) '(0))
            (expect (compilation-pending context) '())
            (expect (context-entity next 0) 'implementation))))
      (define (test-strict-specialize)
        (run-test test-persistent-reservation)
        (run-test test-recursive-reservation)
        (run-test test-concrete-lexical-captures))))
   (else)))
