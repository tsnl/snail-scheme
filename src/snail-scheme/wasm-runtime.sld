              (if (result eqref) (ref.test (ref $complex) (local.get $value))
                  (then (struct.get $complex 1 (ref.cast (ref $complex) (local.get $value))))
                  (else (drop (call $float_value (local.get $value))) (ref.i31 (i32.const 0)))))

