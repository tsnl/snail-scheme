                                 (if (i32.ne (array.get $text (local.get $a) (local.get $index))
                                             (array.get $text (local.get $b) (local.get $index))) (then (return (i32.const 0))))
                                 (local.set $index (i32.add (local.get $index) (i32.const 1)))
                                 (br $next)))
              (i32.const 1))
        (func $builtin:string (param $arguments (ref $vector)) (result eqref)
              (local $text (ref $text)) (local $index i32)
              (local.set $text (array.new_default $text (array.len (local.get $arguments))))
              (block $done (loop $next
                                 (br_if $done (i32.eq (local.get $index) (array.len (local.get $arguments))))
                                 (array.set $text (local.get $text) (local.get $index)
                                            (call $character_value (array.get $vector (local.get $arguments) (local.get $index))))
                                 (local.set $index (i32.add (local.get $index) (i32.const 1)))
                                 (br $next)))
              (struct.new $text_object (i32.const 0) (local.get $text)))
        (func $builtin:make-string (param $arguments (ref $vector)) (result eqref)
              (local $fill i32)
              (call $arity (local.get $arguments) (i32.const 1) (i32.const 1))
              (if (i32.gt_u (array.len (local.get $arguments)) (i32.const 2)) (then (call $fail (i32.const 4))))
              (if (i32.eq (array.len (local.get $arguments)) (i32.const 2))
                  (then (local.set $fill (call $character_value (array.get $vector (local.get $arguments) (i32.const 1))))))
              (struct.new $text_object (i32.const 0) (array.new $text (local.get $fill)
                                                                (call $index (array.get $vector (local.get $arguments) (i32.const 0))))))

        (func $builtin:string-set! (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 3) (i32.const 0))
              (array.set $text (call $string_text (array.get $vector (local.get $arguments) (i32.const 0)))
                         (call $index (array.get $vector (local.get $arguments) (i32.const 1)))
                         (call $character_value (array.get $vector (local.get $arguments) (i32.const 2))))
              (global.get $unspecified))

        (func $builtin:string-append (param $arguments (ref $vector)) (result eqref)
              (local $index i32) (local $length i32) (local $offset i32)
              (local $text (ref $text)) (local $part (ref $text))
              (block $counted (loop $count
                                    (br_if $counted (i32.eq (local.get $index) (array.len (local.get $arguments))))
                                    (local.set $length (i32.add (local.get $length)
                                                                (array.len (call $string_text (array.get $vector (local.get $arguments) (local.get $index))))))
                                    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $count)))
              (local.set $text (array.new_default $text (local.get $length)))
              (local.set $index (i32.const 0))
              (block $done (loop $copy
                                 (br_if $done (i32.eq (local.get $index) (array.len (local.get $arguments))))
                                 (local.set $part (call $string_text (array.get $vector (local.get $arguments) (local.get $index))))
                                 (array.copy $text $text (local.get $text) (local.get $offset)
                                             (local.get $part) (i32.const 0) (array.len (local.get $part)))
                                 (local.set $offset (i32.add (local.get $offset) (array.len (local.get $part))))
                                 (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $copy)))
              (struct.new $text_object (i32.const 0) (local.get $text)))
        (func $builtin:substring (param $arguments (ref $vector)) (result eqref)
              (local $text (ref $text)) (local $start i32) (local $end i32) (local $result (ref $text))
              (call $arity (local.get $arguments) (i32.const 3) (i32.const 0))
              (local.set $text (call $string_text (array.get $vector (local.get $arguments) (i32.const 0))))
              (local.set $start (call $index (array.get $vector (local.get $arguments) (i32.const 1))))
              (local.set $end (call $index (array.get $vector (local.get $arguments) (i32.const 2))))
              (if (i32.or (i32.gt_u (local.get $start) (local.get $end))
                          (i32.gt_u (local.get $end) (array.len (local.get $text))))
                  (then (call $fail (i32.const 3))))
              (local.set $result (array.new_default $text (i32.sub (local.get $end) (local.get $start))))
              (array.copy $text $text (local.get $result) (i32.const 0) (local.get $text)
                          (local.get $start) (array.len (local.get $result)))
              (struct.new $text_object (i32.const 0) (local.get $result)))

        ;; ---- Bytevectors ----

        (func $builtin:make-bytevector (param $arguments (ref $vector)) (result eqref)
              (local $fill i32)
              (call $arity (local.get $arguments) (i32.const 1) (i32.const 1))
              (if (i32.gt_u (array.len (local.get $arguments)) (i32.const 2)) (then (call $fail (i32.const 4))))
              (if (i32.eq (array.len (local.get $arguments)) (i32.const 2))
                  (then (local.set $fill (call $index (array.get $vector (local.get $arguments) (i32.const 1))))))
              (if (i32.gt_u (local.get $fill) (i32.const 255)) (then (call $fail (i32.const 3))))
              (struct.new $bytevector (array.new $bytes (local.get $fill)
                                                 (call $index (array.get $vector (local.get $arguments) (i32.const 0))))))

        (func $builtin:bytevector (param $arguments (ref $vector)) (result eqref)
              (local $bytes (ref $bytes)) (local $index i32) (local $value i32)
              (local.set $bytes (array.new_default $bytes (array.len (local.get $arguments))))
              (block $done (loop $next
                                 (br_if $done (i32.eq (local.get $index) (array.len (local.get $arguments))))
                                 (local.set $value (call $index (array.get $vector (local.get $arguments) (local.get $index))))
                                 (if (i32.gt_u (local.get $value) (i32.const 255)) (then (call $fail (i32.const 3))))
                                 (array.set $bytes (local.get $bytes) (local.get $index) (local.get $value))
                                 (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next)))
              (struct.new $bytevector (local.get $bytes)))
        (func $builtin:bytevector-u8-set! (param $arguments (ref $vector)) (result eqref)
              (local $value i32)
              (call $arity (local.get $arguments) (i32.const 3) (i32.const 0))
              (local.set $value (call $index (array.get $vector (local.get $arguments) (i32.const 2))))
              (if (i32.gt_u (local.get $value) (i32.const 255)) (then (call $fail (i32.const 3))))
              (array.set $bytes
                         (struct.get $bytevector 0 (ref.cast (ref $bytevector)
                                                             (array.get $vector (local.get $arguments) (i32.const 0))))
                         (call $index (array.get $vector (local.get $arguments) (i32.const 1))) (local.get $value))
              (global.get $unspecified))

        ;; ---- Record types and instances ----

        (func $field_index (param $type (ref $record_type)) (param $name eqref) (result i32)
              (local $index i32) (local $fields (ref $vector))
              (local.set $fields (struct.get $record_type 1 (local.get $type)))
              (loop $next
                    (if (i32.eq (local.get $index) (array.len (local.get $fields)))
                        (then (call $fail (i32.const 3))))
                    (if (call $same (array.get $vector (local.get $fields) (local.get $index)) (local.get $name))
                        (then (return (local.get $index))))
                    (local.set $index (i32.add (local.get $index) (i32.const 1)))
                    (br $next)) unreachable)
        (func $record_fields (param $type eqref) (param $value eqref) (result (ref $vector))
              (local $record (ref $record))
              (local.set $record (ref.cast (ref $record) (local.get $value)))
              (if (i32.eqz (ref.eq (struct.get $record 0 (local.get $record)) (local.get $type)))
                  (then (call $fail (i32.const 8))))
              (struct.get $record 1 (local.get $record)))
        (func $builtin:%make-record (param $arguments (ref $vector)) (result eqref)
              (local $type (ref $record_type)) (local $names eqref) (local $values eqref)
              (local $fields (ref $vector))
              (call $arity (local.get $arguments) (i32.const 3) (i32.const 0))
              (local.set $type (ref.cast (ref $record_type) (array.get $vector (local.get $arguments) (i32.const 0))))
              (local.set $names (array.get $vector (local.get $arguments) (i32.const 1)))
              (local.set $values (array.get $vector (local.get $arguments) (i32.const 2)))
              (local.set $fields (array.new $vector (global.get $unspecified)
                                            (array.len (struct.get $record_type 1 (local.get $type)))))
              (block $done (loop $next
                                 (br_if $done (ref.eq (local.get $names) (global.get $nil)))
                                 (array.set $vector (local.get $fields) (call $field_index (local.get $type) (call $car (local.get $names)))
                                            (call $car (local.get $values)))
                                 (local.set $names (call $cdr (local.get $names)))
                                 (local.set $values (call $cdr (local.get $values))) (br $next)))
              (if (i32.eqz (ref.eq (local.get $values) (global.get $nil))) (then (call $fail (i32.const 4))))
              (struct.new $record (local.get $type) (local.get $fields)))


        (func $builtin:string-length (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 1) (i32.const 0))
              (call $pack_integer (i64.extend_i32_u (array.len (call $string_text (array.get $vector (local.get $arguments) (i32.const 0)))))))

        (func $builtin:string-ref (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 2) (i32.const 0))
              (call $pack_character (array.get $text (call $string_text (array.get $vector (local.get $arguments) (i32.const 0))) (call $index (array.get $vector (local.get $arguments) (i32.const 1))))))

        (func $builtin:string=? (param $arguments (ref $vector)) (result eqref)
              (local $index i32) (local $previous (ref $text)) (local $current (ref $text)) (local $matches i32)
              (call $arity (local.get $arguments) (i32.const 2) (i32.const 1))
              (local.set $previous (call $string_text (array.get $vector (local.get $arguments) (i32.const 0))))
              (local.set $index (i32.const 1))
              (local.set $matches (i32.const 1))
              (block $done (loop $next
                                 (br_if $done (i32.eq (local.get $index) (array.len (local.get $arguments))))
                                 (local.set $current (call $string_text (array.get $vector (local.get $arguments) (local.get $index))))
                                 (local.set $matches (i32.and (local.get $matches) (call $text_equal (local.get $previous) (local.get $current))))
                                 (local.set $previous (local.get $current))
                                 (local.set $index (i32.add (local.get $index) (i32.const 1)))
                                 (br $next)))
              (call $pack_boolean (local.get $matches)))

        (func $builtin:bytevector-length (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 1) (i32.const 0))
              (call $pack_integer (i64.extend_i32_u (array.len (struct.get $bytevector 0 (ref.cast (ref $bytevector) (array.get $vector (local.get $arguments) (i32.const 0))))))))

        (func $builtin:bytevector-u8-ref (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 2) (i32.const 0))
              (call $pack_integer (i64.extend_i32_u (array.get_u $bytes (struct.get $bytevector 0 (ref.cast (ref $bytevector) (array.get $vector (local.get $arguments) (i32.const 0)))) (call $index (array.get $vector (local.get $arguments) (i32.const 1)))))))

        (func $builtin:%make-record-type (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 2) (i32.const 0))
              (struct.new $record_type (array.get $vector (local.get $arguments) (i32.const 0)) (call $list_vector (array.get $vector (local.get $arguments) (i32.const 1))) (i32.const 0)))

        (func $builtin:%record? (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 2) (i32.const 0))
              (if (result eqref) (ref.test (ref $record) (array.get $vector (local.get $arguments) (i32.const 1)))
                  (then (call $pack_boolean (ref.eq (array.get $vector (local.get $arguments) (i32.const 0)) (struct.get $record 0 (ref.cast (ref $record) (array.get $vector (local.get $arguments) (i32.const 1)))))))
                  (else (global.get $false))))

        (func $builtin:%record-ref (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 3) (i32.const 0))
              (array.get $vector (call $record_fields (array.get $vector (local.get $arguments) (i32.const 0)) (array.get $vector (local.get $arguments) (i32.const 2))) (call $field_index (ref.cast (ref $record_type) (array.get $vector (local.get $arguments) (i32.const 0))) (array.get $vector (local.get $arguments) (i32.const 1)))))

        (func $builtin:%record-set! (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 4) (i32.const 0))
              (array.set $vector (call $record_fields (array.get $vector (local.get $arguments) (i32.const 0)) (array.get $vector (local.get $arguments) (i32.const 2))) (call $field_index (ref.cast (ref $record_type) (array.get $vector (local.get $arguments) (i32.const 0))) (array.get $vector (local.get $arguments) (i32.const 1))) (array.get $vector (local.get $arguments) (i32.const 3)))
              (global.get $unspecified))

        (func $builtin:eof-object? (param $arguments (ref $vector)) (result eqref)
              (call $arity (local.get $arguments) (i32.const 1) (i32.const 0))
              (call $pack_boolean (ref.eq (array.get $vector (local.get $arguments) (i32.const 0)) (global.get $eof))))
        ))))
