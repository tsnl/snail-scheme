;; The strict compiler reuses located reading, hygienic expansion and resolved
;; binding identities. Its checked core is independent of gradual inference.
(define-library (snail-scheme strict-compiler)
  (export strict-source-file->core strict-source-file->wasm strict-source-file->wat-file)
  (import (scheme base) (scheme file) (scheme write)
          (snail-scheme reader) (snail-scheme syntax-parser) (snail-scheme expand)
          (snail-scheme strict-infer) (snail-scheme strict-primitives)
          (snail-scheme strict-specialize) (snail-scheme strict-wasm)
          (only (snail-scheme wasm) write-wasm)
          (prefix (snail-scheme library) library:) (prefix (snail-scheme ir) ir:))
  (begin

    ;; ---- Source expansion into the checked core ----

    (define (read-forms path) (reader->syntax-list (file->reader path)))
    (define (library-path root name)
      (let join ((parts name) (path (string-append root "/src")))
        (if (null? parts) (string-append path ".sld")
            (join (cdr parts) (string-append path "/" (symbol->string (car parts)))))))
    (define (library-loader root)
      (lambda (name)
        (let ((forms (read-forms (library-path root name))))
          (unless (= (length forms) 1) (error "expected one library declaration" name)) (car forms))))
    (define (primitive-bindings core)
      (let collect ((exports (library:library-exports core)))
        (cond ((null? exports) '())
              ((ir:value-definition? (library:named-binding-definition (car exports)))
               (cons (cons (library:named-binding-definition (car exports)) (library:named-binding-name (car exports)))
                     (collect (cdr exports))))
              (else (collect (cdr exports))))))
    (define (strict-source-file->core root path)
      (let* ((core (make-core-library '(snail-scheme core) primitive-names))
             (program (syntax-list->ir-library (read-forms path) (library-loader root) (list core)))
             (items (apply append (map library:library-body (library:library-dependency-order program)))))
        (infer-program items (primitive-bindings core))))
    (define (strict-source-file->wasm root path)
      (strict-core->wasm (monomorphize (strict-source-file->core root path))))
    (define (strict-source-file->wat-file root path output)
      (let ((module (strict-source-file->wasm root path)))
        (call-with-output-file output (lambda (port) (write-wasm module port)))))))
