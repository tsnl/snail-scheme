;; Checked native artifacts are linked explicitly; every instance owns a process.
;; Executable code and providers are trusted. Metadata proves ABI consistency,
;; not machine-code safety. Rust owns process groups and enforces call deadlines.
(define-library (native execute)
  (export load-native link-native instantiate invoke-entry close-instance
          runtime-provider make-rust-provider native-code? linked-code? native-instance?
          native-code-library native-code-export native-code-parameters native-code-result
          linked-code-directory instance-directory)
  (import
   (scheme base)
   (scheme cxr)
   (scheme file)
   (scheme inexact)
   (scheme write)
   (scheme process-context)
   (chibi filesystem)
   (chibi bytevector)
   (native json)
   (chibi weak)
   (chibi string)
   (srfi 1)
   (srfi 18)
   (srfi 151)
   (only (srfi 132) list-sort)
   (only (chibi process) fork execute waitpid current-process-id set-signal-action! signal/pipe)
   (native process)
   (native native-build))
  (begin

    ;; ---- Bounded ELF sections and scalar protocol symbols ----

    (define (region data offset size)
      (unless (and (exact-integer? offset) (exact-integer? size) (<= 0 offset) (<= 0 size)
                   (<= (+ offset size) (bytevector-length data)))
        (error "truncated native artifact"))
      (bytevector-copy data offset (+ offset size)))
    (define (unsigned-le data offset width)
      (region data offset width)
      (let loop ((index (- width 1)) (value 0))
        (if (< index 0) value
            (loop (- index 1) (+ (* value 256) (bytevector-u8-ref data (+ offset index)))))))
    (define (string-at data offset)
      (unless (< -1 offset (bytevector-length data)) (error "invalid native artifact string table"))
      (let loop ((end offset))
        (when (= end (bytevector-length data)) (error "invalid native artifact string table"))
        (if (zero? (bytevector-u8-ref data end)) (utf8->string data offset end) (loop (+ end 1)))))
    (define (section-header data offset index)
      (list (unsigned-le data offset 4) (unsigned-le data (+ offset 4) 4)
            (unsigned-le data (+ offset 24) 8) (unsigned-le data (+ offset 32) 8)
            (unsigned-le data (+ offset 40) 4) (unsigned-le data (+ offset 56) 8) index))
    (define (elf-sections data)
      (let ((offset (unsigned-le data 40 8)) (count (unsigned-le data 60 2)) (names (unsigned-le data 62 2)))
        (unless (and (equal? (region data 0 7) #u8(127 69 76 70 2 1 1))
                     (memv (bytevector-u8-ref data 7) '(0 3))
                     (= 1 (unsigned-le data 16 2)) (= 62 (unsigned-le data 18 2))
                     (= 1 (unsigned-le data 20 4)) (= 64 (unsigned-le data 52 2))
                     (= 64 (unsigned-le data 58 2)) (< 0 names count))
          (error "expected an x86-64 Linux relocatable ELF artifact"))
        (region data offset (* count 64))
        (let* ((headers (map (lambda (index) (section-header data (+ offset (* index 64)) index)) (iota count)))
               (strings (list-ref headers names)) (table (region data (caddr strings) (cadddr strings))))
          (map (lambda (header) (cons (string-at table (car header)) (cdr header))) headers))))
    (define (unique-section sections name)
      (let ((found (filter (lambda (header) (string=? (car header) name)) sections)))
        (unless (= 1 (length found)) (error "expected one native artifact section" name))
        (car found)))
    (define (symbol-entry data offset strings)
      (let ((info (unsigned-le data (+ offset 4) 1)) (section (unsigned-le data (+ offset 6) 2)))
        (and (= (quotient info 16) 1) (positive? section)
             (cons (string-at strings (unsigned-le data offset 4))
                   (list (modulo info 16) (unsigned-le data (+ offset 5) 1) section
                         (unsigned-le data (+ offset 8) 8) (unsigned-le data (+ offset 16) 8))))))
    (define (elf-symbols data sections)
      (let ((header (unique-section sections ".symtab")))
        (unless (and (= 24 (list-ref header 5)) (zero? (modulo (cadddr header) 24))
                     (< (list-ref header 4) (length sections)))
          (error "invalid native artifact symbol table"))
        (let* ((strings (list-ref sections (list-ref header 4)))
               (names (region data (caddr strings) (cadddr strings))))
          (filter-map (lambda (index) (symbol-entry data (+ (caddr header) (* index 24)) names))
                      (iota (quotient (cadddr header) 24))))))
    (define (check-bridge data sections section metadata signature)
      (let* ((symbols (elf-symbols data sections))
             (entry (assoc "lofi_native_entry" symbols)) (count (assoc "lofi_native_arity" symbols))
             (description (assoc "lofi_native_metadata" symbols))
             (witness (string-append "lofi_native_entry."
                                     (apply string-append (map (lambda (name) (string-append name "_"))
                                                               (vector->list (option-ref signature 'parameters #f))))
                                     "." (option-ref signature 'result #f))))
        (unless (and entry count (equal? (take (cdr entry) 2) '(2 0))
                     (equal? (take (cdr count) 2) '(1 0)) (= 8 (last count)))
          (error "native artifact lacks the fixed scalar bridge"))
        (unless (equal? (assoc witness symbols) (cons witness (cdr entry)))
          (error "native artifact bridge signature disagrees with metadata"))
        (unless (and (equal? description (list "lofi_native_metadata" 1 0 (list-ref section 6) 0 (bytevector-length metadata)))
                     (< (list-ref count 3) (length sections)))
          (error "native artifact metadata symbol disagrees with its section"))
        (let ((header (list-ref sections (list-ref count 3))))
          (unless (= (unsigned-le data (+ (caddr header) (list-ref count 4)) 8)
                     (vector-length (option-ref signature 'parameters #f)))
            (error "native artifact bridge arity disagrees with metadata")))))

    ;; ---- Parsed scalar signatures and opaque code identities ----

    (define (nonempty-string? value) (and (string? value) (positive? (string-length value))))
    (define (physical? name) (and (string? name) (member name '("i32" "i64" "f32" "f64"))))
    (define (scalar? name) (and (string? name) (member name '("I32" "I64" "F32" "F64" "Bool" "Char"))))
    (define (vector-of? predicate value)
      (and (vector? value) (every predicate (vector->list value))))
    (define (native-import value)
      (unless (and (vector? value) (= 5 (vector-length value))
                   (every nonempty-string? (take (vector->list value) 3))
                   (vector-of? physical? (vector-ref value 3))
                   (or (equal? (vector-ref value 4) "void") (physical? (vector-ref value 4))))
        (error "unsupported native provider metadata"))
      (list (list (vector-ref value 0) (vector-ref value 1)) (vector-ref value 2)
            (map string->symbol (vector->list (vector-ref value 3)))
            (if (string=? "void" (vector-ref value 4)) '() (list (string->symbol (vector-ref value 4))))))
    (define (entry-metadata bytes)
      (let ((value (string->json (utf8->string bytes))))
        (unless (and (list? value) (= 7 (length value))
                     (equal? (list-sort symbol<? (map car value)) '(abi export imports library parameters result version))
                     (equal? (option-ref value 'abi #f) "lofi-native-1")
                     (eqv? (option-ref value 'version #f) 1)
                     (vector-of? nonempty-string? (option-ref value 'library #f))
                     (positive? (vector-length (option-ref value 'library #f)))
                     (nonempty-string? (option-ref value 'export #f))
                     (vector-of? scalar? (option-ref value 'parameters #f))
                     (<= (vector-length (option-ref value 'parameters #f)) 1024)
                     (or (scalar? (option-ref value 'result #f)) (equal? "Unit" (option-ref value 'result #f)))
                     (vector? (option-ref value 'imports #f)))
          (error "unsupported native scalar entry metadata"))
        value))
    (define (symbol<? left right) (string<? (symbol->string left) (symbol->string right)))
    (define-record-type <native-code>
      (new-native-code bytes library export parameters result imports) native-code?
      (bytes code-bytes)
      (library code-library)
      (export native-code-export)
      (parameters code-parameters)
      (result native-code-result)
      (imports code-imports))
    (define (native-code-library code) (append (code-library code) '()))
    (define (native-code-parameters code) (append (code-parameters code) '()))
    (define (load-native artifact)
      (unless (bytevector? artifact) (error "load-native requires artifact bytes"))
      (let* ((data (bytevector-copy artifact)) (sections (elf-sections data))
             (section (unique-section sections ".lofi.entry"))
             (metadata (region data (caddr section) (cadddr section))) (entry (entry-metadata metadata))
             (imports (map native-import (vector->list (option-ref entry 'imports #f)))))
        (when (any (lambda (header) (and (memv (cadr header) '(14 16)) (positive? (cadddr header)))) sections)
          (error "native artifact must not have automatic initializers"))
        (check-bridge data sections section metadata entry)
        (check-provider-bindings '() imports)
        (new-native-code data (map string->symbol (vector->list (option-ref entry 'library #f)))
                         (string->symbol (option-ref entry 'export #f))
                         (map string->symbol (vector->list (option-ref entry 'parameters #f)))
                         (string->symbol (option-ref entry 'result #f)) imports)))

    ;; ---- Explicit provider compilation and link evidence ----

    (define-record-type <rust-provider>
      (new-rust-provider module source) rust-provider?
      (module provider-module)
      (source provider-source))
    (define (make-rust-provider module source)
      (unless (and (nonempty-string? module) (string? source)) (error "provider requires a module and Rust source path"))
      (new-rust-provider (string-copy module) (absolute-path source)))
    (define-record-type <runtime-provider> (runtime-provider) runtime-provider?)
    (define-record-type <linked-code>
      (new-linked-code code directory executable supervisor) linked-code?
      (code linked-code)
      (directory linked-directory)
      (executable linked-executable)
      (supervisor linked-supervisor))
    (define (linked-code-directory code) (string-copy (linked-directory code)))
    (define (provider-declarations root providers)
      (append-map
       (lambda (provider)
         (cond ((runtime-provider? provider) (runtime-bindings root))
               ((rust-provider? provider) (rust-bindings (provider-module provider) (provider-source provider)))
               (else (error "providers must be runtime-provider or Rust provider values")))) providers))
    (define worker-entry
      "unsafe extern \"C\" { fn native_module_init(); #[link_name = \"wasm.main\"] fn initialize(); static lofi_native_arity: u64; fn lofi_native_entry(arguments: *const u64) -> u64; }\nunsafe extern \"C\" fn start() { unsafe { native_module_init(); initialize(); } }\nfn main() { std::process::exit(native_runtime::native::worker::run_guest(unsafe { lofi_native_arity } as usize, start, lofi_native_entry)); }\n")
    (define (link-native code providers directory runtime-root)
      (unless (native-code? code) (error "link-native requires loaded native code"))
      (unless (list? providers) (error "providers must be a list"))
      (let* ((root (absolute-path runtime-root))
             (output (make-build-directory (absolute-path directory) "native-link-"))
             (object (path-join output "artifact.o")) (entry (path-join output "entry.rs")))
        (parameterize ((current-command-records '()) (current-command-log (path-join output "commands.json")))
          (check-provider-bindings (code-imports code) (provider-declarations root providers))
          (write-bytes object (code-bytes code)) (write-text entry worker-entry)
          (let* ((sources (map (lambda (provider) (list (provider-module provider) (provider-source provider)))
                               (filter rust-provider? providers)))
                 (program (link-native-object root object entry sources output))
                 (supervisor (ensure-native-supervisor root)))
            (new-linked-code code output program supervisor)))))

    ;; ---- Semantic scalar values and exact little-endian transport ----

    (define (unicode-scalar? value) (and (<= 0 value #x10ffff) (not (<= #xd800 value #xdfff))))
    (define (unsigned-bytes value width)
      (let ((bytes (make-bytevector width)))
        (do ((index 0 (+ index 1)) (value value (quotient value 256))) ((= index width) bytes)
          (bytevector-u8-set! bytes index (modulo value 256)))))
    (define (float-word type value)
      (unless (and (real? value) (inexact? value)) (error "value does not satisfy scalar type" type value))
      (let ((bytes (make-bytevector 8 0)))
        (if (eq? type 'F32)
            (begin (bytevector-ieee-single-set! bytes 0 value 'little)
                   (when (and (finite? value) (infinite? (bytevector-ieee-single-ref bytes 0 'little)))
                     (error "finite F32 value overflows its representation")))
            (bytevector-ieee-double-set! bytes 0 value 'little))
        (unsigned-le bytes 0 8)))
    (define (scalar-word type value)
      (case type
        ((I32 I64)
         (let ((width (if (eq? type 'I32) 32 64)))
           (unless (and (exact-integer? value) (<= (- (expt 2 (- width 1))) value) (< value (expt 2 (- width 1))))
             (error "value does not satisfy scalar type" type value))
           (modulo value (expt 2 width))))
        ((Bool) (if (boolean? value) (if value 1 0) (error "value does not satisfy scalar type" type value)))
        ((Char) (if (and (char? value) (unicode-scalar? (char->integer value))) (char->integer value)
                    (error "value does not satisfy scalar type" type value)))
        ((F32 F64) (float-word type value))
        (else (error "unsupported native scalar type" type))))
    (define (scalar-result type word)
      (when (and (memq type '(I32 F32 Bool Char)) (>= word (expt 2 32)))
        (error "native scalar result has nonzero padding"))
      (case type
        ((I32 I64) (let ((width (if (eq? type 'I32) 32 64)))
                     (if (>= word (expt 2 (- width 1))) (- word (expt 2 width)) word)))
        ((F32) (bytevector-ieee-single-ref (unsigned-bytes word 8) 0 'little))
        ((F64) (bytevector-ieee-double-ref (unsigned-bytes word 8) 0 'little))
        ((Bool) (if (memv word '(0 1)) (= word 1) (error "invalid Bool entry result")))
        ((Char) (if (unicode-scalar? word) (integer->char word) (error "invalid Char entry result")))
        ((Unit) (if (zero? word) 'unit (error "invalid Unit entry result")))
        (else (error "unsupported native scalar result" type))))

    ;; ---- Owned instances and bounded supervised calls ----

    (define-record-type <instance-state>
      (new-instance-state code directory pid request response mutex alive) instance-state?
      (code state-code)
      (directory state-directory)
      (pid state-pid)
      (request state-request)
      (response state-response)
      (mutex state-mutex)
      (alive state-alive? set-state-alive!))
    (define-record-type <native-instance>
      (new-native-instance state) native-instance?
      (state instance-state))
    ;; Chibi parameters live in each thread's traced dynamic environment. Calls
    ;; root their wrapper until after releasing its lock; cleanup never owns it.
    (define active-native-instance (make-parameter #f))
    (define pipe-write-mutex (make-mutex))
    (define (with-pipe-write action)
      ;; A dead worker must become an ordinary I/O failure. SIGPIPE disposition
      ;; is process-wide, so serialize these brief changes and restore the host's
      ;; previous handler before waiting for any worker response.
      (let ((previous #t))
        (mutex-lock! pipe-write-mutex)
        (dynamic-wind (lambda () (set! previous (set-signal-action! signal/pipe #f)))
            action
            (lambda () (set-signal-action! signal/pipe previous) (mutex-unlock! pipe-write-mutex)))))
    (define (instance-directory instance) (string-copy (state-directory (checked-state instance))))
    (define (checked-state instance)
      (unless (native-instance? instance) (error "operation requires a native instance"))
      (instance-state instance))
    (define (nonblocking! descriptor)
      (set-file-descriptor-status! descriptor (bitwise-ior open/non-block (get-file-descriptor-status descriptor))))
    (define (instance-pipe)
      (let ((descriptors (open-pipe)))
        ;; Linux FD_CLOEXEC is one. dup2 clears it on the child's protocol FDs;
        ;; other instances must never inherit these parent's retained endpoints.
        (for-each (lambda (descriptor) (set-file-descriptor-flags! descriptor (bitwise-ior 1 (get-file-descriptor-flags descriptor)))) descriptors)
        descriptors))
    (define (spawn-child command input output errors)
      (guard (failure (else (write failure (current-error-port)) (emergency-exit 127)))
        (duplicate-file-descriptor-to (car input) 0)
        (duplicate-file-descriptor-to (cadr output) 1)
        (for-each close-owned-descriptor (append input output))
        (let ((log (open errors (bitwise-ior open/write open/create open/truncate) #o600)))
          (unless log (error "cannot open native stderr" errors))
          (duplicate-file-descriptor-to log 2) (close-owned-descriptor log))
        (execute (car command) command) (emergency-exit 127)))
    (define (spawn-instance linked directory timeout environment)
      (let* ((input (instance-pipe)) (output (instance-pipe))
             (command (append (list "env") (map (lambda (entry) (string-append (car entry) "=" (cdr entry))) environment)
                              (list (linked-supervisor linked) "--stdio" (linked-executable linked)
                                    (number->string (length (code-parameters (linked-code linked))))
                                    (number->string (exact (ceiling (* 1000 timeout))))
                                    (number->string (current-process-id)) (path-join directory "stdout"))))
             (pid (fork)))
        (unless pid (for-each close-owned-descriptor (append input output)) (error "cannot fork native instance"))
        (when (zero? pid) (spawn-child command input output (path-join directory "stderr")))
        (close-owned-descriptor (car input)) (close-owned-descriptor (cadr output))
        (nonblocking! (cadr input)) (nonblocking! (car output))
        (let ((state (new-instance-state (linked-code linked) directory pid
                                         (open-output-file-descriptor (cadr input))
                                         (open-input-file-descriptor (car output)) (make-mutex) #t)))
          (publish-instance state command environment)
          state)))
    (define (publish-instance state command environment)
      (guard (failure (else (stop-state state) (raise failure)))
        (write-json (path-join (state-directory state) "process.json")
                    `((command . ,(list->vector command)) (pid . ,(state-pid state))
                      (environment . ,(map (lambda (entry) (cons (string->symbol (car entry)) (cdr entry))) environment))))))
    (define (receive-word state)
      (let ((bytes (read-bytevector 8 (state-response state))))
        (unless (and (bytevector? bytes) (= 8 (bytevector-length bytes)))
          (error "native instance exited; see retained instance stderr" (state-directory state)))
        (unsigned-le bytes 0 8)))
    (define (stop-state state)
      (if (not (state-alive? state)) 0
          (let ((shutdown-error #f))
            (set-state-alive! state #f)
            (with-pipe-write
             (lambda ()
               (guard (failure (else (set! shutdown-error (call-with-output-string (lambda (port) (write failure port))))))
                 (write-u8 0 (state-request state)) (flush-output-port (state-request state)))
               (guard (failure (else #f)) (close-output-port (state-request state)))))
            (guard (failure (else #f)) (close-input-port (state-response state)))
            (let* ((raw (cadr (waitpid (state-pid state) 0))) (signal (modulo raw 128)))
              (record-stopped-instance state raw signal shutdown-error)
              (if (zero? signal) (quotient raw 256) (+ 128 signal))))))
    (define (record-stopped-instance state raw signal shutdown-error)
      (let ((path (path-join (state-directory state) "process.json")))
        (when (file-exists? path)
          (guard (failure (else #f))
            (write-json path (append `((closed . #t) (wait_status . ,raw) (exit_code . ,(if (zero? signal) (quotient raw 256) 'null))
                                       (signal . ,(if (zero? signal) 'null signal)) (shutdown_write_error . ,shutdown-error))
                                     (read-json path)))))))
    (define (watch-instance weak state)
      ;; The watcher owns cleanup state, never the wrapper it watches. Dropping
      ;; the last wrapper therefore closes the same resources as explicit close.
      (thread-start!
       (make-thread
        (lambda ()
          (let loop ()
            (cond ((not (state-alive? state)) #t)
                  ((ephemeron-broken? weak)
                   (mutex-lock! (state-mutex state))
                   (dynamic-wind (lambda () #f) (lambda () (guard (failure (else #f)) (stop-state state)))
                                 (lambda () (mutex-unlock! (state-mutex state)))))
                  (else (thread-sleep! 0.05) (loop))))) 'native-instance-reaper)))
    (define (initialize-instance state)
      (guard (failure (else (stop-state state) (error "Lofi instance initialization failed; logs" (state-directory state) failure)))
        (unless (= #x3152494653 (receive-word state)) (error "invalid native initialization response"))))
    (define (instantiate linked . options)
      (unless (linked-code? linked) (error "instantiate requires explicitly linked native code"))
      (let* ((options (if (null? options) '() (car options))) (timeout (option-ref options 'timeout 30))
             (environment (option-ref options 'environment '())))
        (unless (and (real? timeout) (finite? timeout) (positive? timeout))
          (error "native instance timeout must be finite and positive"))
        (let* ((directory (make-build-directory (linked-directory linked) "instance-"))
               (state (spawn-instance linked directory timeout environment)))
          (initialize-instance state)
          (let ((instance (new-native-instance state)))
            (watch-instance (make-ephemeron instance #f) state) instance))))
    (define (with-instance-lock state action)
      (unless (mutex-lock! (state-mutex state) 0) (error "native instance is already executing"))
      (dynamic-wind (lambda () #f) action (lambda () (mutex-unlock! (state-mutex state)))))
    (define (call-instance state words)
      (guard (failure (else (stop-state state) (error "native instance failed and is closed; logs" (state-directory state) failure)))
        (with-pipe-write
         (lambda ()
           (write-u8 1 (state-request state))
           (for-each (lambda (word) (write-bytevector (unsigned-bytes word 8) (state-request state))) words)
           (flush-output-port (state-request state))))
        (scalar-result (native-code-result (state-code state)) (receive-word state))))
    (define (invoke-entry instance arguments)
      (parameterize ((active-native-instance instance))
        (let ((state (checked-state instance)))
          (with-instance-lock state
                              (lambda ()
                                (unless (state-alive? state) (error "native instance is closed"))
                                (unless (and (list? arguments) (= (length arguments) (length (code-parameters (state-code state)))))
                                  (error "entry arguments do not match the saved parameter count"))
                                (call-instance state (map scalar-word (code-parameters (state-code state)) arguments)))))))
    (define (close-instance instance)
      (parameterize ((active-native-instance instance))
        (let ((state (checked-state instance)))
          (with-instance-lock state
                              (lambda ()
                                (unless (zero? (stop-state state))
                                  (error "native instance cleanup failed; logs" (state-directory state)))))))))

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-native-execution)
    (import
     (native test-utils)
     (only (chibi ast) gc))
    (begin
      (define (test-error thunk)
        (guard (failure (else (and (error-object? failure) (error-object-message failure)))) (thunk) #f))
      (define (test-scalar-transport)
        (for-each (lambda (value) (expect (scalar-result 'I64 (scalar-word 'I64 value)) value))
                  (list (- (expt 2 63)) (- (+ (expt 2 53) 1)) 0 (+ (expt 2 53) 1) (- (expt 2 63) 1)))
        (expect (scalar-word 'F32 -0.0) #x80000000)
        (expect (scalar-word 'F64 -0.0) #x8000000000000000)
        (expect (scalar-result 'Bool 1) #t)
        (expect (scalar-result 'Char #x10ffff) (integer->char #x10ffff))
        (expect (scalar-result 'Unit 0) 'unit)
        (expect (test-error (lambda () (scalar-word 'I32 #t))) "value does not satisfy scalar type")
        (expect (test-error (lambda () (scalar-word 'F64 1))) "value does not satisfy scalar type")
        (expect (test-error (lambda () (scalar-word 'F32 1e300))) "finite F32 value overflows its representation")
        (expect (test-error (lambda () (scalar-result 'I32 #x100000000))) "native scalar result has nonzero padding")
        (expect (test-error (lambda () (scalar-result 'Bool 2))) "invalid Bool entry result")
        (expect (test-error (lambda () (scalar-result 'Char #xd800))) "invalid Char entry result"))
      (define (test-code-boundaries)
        (expect (test-error (lambda () (load-native "bytes"))) "load-native requires artifact bytes")
        (expect (test-error (lambda () (load-native #u8(127 69 76 70)))) "truncated native artifact")
        (expect (test-error (lambda () (entry-metadata (string->utf8 "{}")))) "unsupported native scalar entry metadata")
        (expect (test-error (lambda () (instantiate #f))) "instantiate requires explicitly linked native code")
        (expect (test-error (lambda () (invoke-entry #f '()))) "operation requires a native instance"))
      (define (test-instance-locking)
        (let* ((code (new-native-code #u8() '(test) 'entry '(I32) 'I32 '()))
               (mutex (make-mutex))
               (state (new-instance-state code "unused" #f #f #f mutex #f))
               (instance (new-native-instance state)) (parameters (native-code-parameters code)))
          (set-car! parameters 'F64)
          (expect (native-code-parameters code) '(I32))
          (mutex-lock! mutex)
          (expect (test-error (lambda () (invoke-entry instance '(1)))) "native instance is already executing")
          (expect (test-error (lambda () (close-instance instance))) "native instance is already executing")
          (mutex-unlock! mutex)
          (close-instance instance) (close-instance instance)
          (expect (test-error (lambda () (invoke-entry instance '(1)))) "native instance is closed")))
      (define (test-worker-state directory . command)
        (flush-output-port (current-output-port)) (flush-output-port (current-error-port))
        (let* ((input (instance-pipe)) (output (instance-pipe)) (pid (fork)))
          (unless pid (error "cannot fork test worker"))
          (when (zero? pid) (spawn-child (if (pair? command) (car command) '("cat")) input output "/dev/null"))
          (for-each close-owned-descriptor (list (car input) (cadr output)))
          (new-instance-state (new-native-code #u8() '(test) 'entry '(I64) 'I64 '()) directory pid
                              (open-output-file-descriptor (cadr input)) (open-input-file-descriptor (car output)) (make-mutex) #t)))
      (define (expect-state-reaped state)
        (expect (state-alive? state) #f)
        (expect (input-port-open? (state-response state)) #f)
        (expect (output-port-open? (state-request state)) #f)
        (expect (file-exists? (string-append "/proc/" (number->string (state-pid state)))) #f))
      (define (test-descriptor-ownership)
        (let ((directory (make-build-directory "/tmp" "native-descriptors-test-")))
          (dynamic-wind
              (lambda () #f)
              (lambda ()
                (do ((index 0 (+ index 1))) ((= index 12))
                  (let* ((first (test-worker-state directory)) (second (test-worker-state directory)))
                    (gc)
                    (for-each
                     (lambda (state)
                       (with-pipe-write (lambda () (write-u8 42 (state-request state)) (flush-output-port (state-request state))))
                       (expect (read-u8 (state-response state)) 42)) (list first second))
                    (stop-state first) (stop-state second)
                    (expect-state-reaped first) (expect-state-reaped second)))
                (let ((state (test-worker-state directory '("false"))))
                  (expect (test-error (lambda () (initialize-instance state))) "Lofi instance initialization failed; logs")
                  (expect-state-reaped state)))
              (lambda () (delete-file-hierarchy directory)))))
      (define (test-interrupted-ownership)
        (let* ((directory (make-build-directory "/tmp" "native-execution-test-"))
               (state (test-worker-state (path-join directory "missing"))) (receive receive-word))
          (dynamic-wind
              (lambda () #f)
              (lambda ()
                (expect (string? (test-error (lambda () (publish-instance state '("test") '())))) #t)
                (expect-state-reaped state)
                (set! state (test-worker-state directory))
                (set! receive-word (lambda (state) (error "interrupted test read")))
                (expect (test-error (lambda () (initialize-instance state))) "Lofi instance initialization failed; logs")
                (expect-state-reaped state)
                (set! state (test-worker-state directory))
                (set! receive-word (lambda (state) (expect (native-instance? (active-native-instance)) #t) (error "interrupted test read")))
                (expect (test-error (lambda () (invoke-entry (new-native-instance state) '(1)))) "native instance failed and is closed; logs")
                (expect-state-reaped state)
                (expect (active-native-instance) #f))
              (lambda () (set! receive-word receive) (stop-state state)
                      (delete-file-hierarchy directory)))))
      (define (test-native-execution)
        (run-test test-scalar-transport)
        (run-test test-code-boundaries)
        (run-test test-instance-locking)
        (run-test test-descriptor-ownership)
        (run-test test-interrupted-ownership))))
   (else)))
