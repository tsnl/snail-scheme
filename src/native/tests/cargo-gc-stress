#!/bin/sh
# Native fixture builds select stress collection at compile time.
set -eu
if [ "${1-}" = build ]; then
    manifest=Cargo.toml
    previous=
    for argument do
        if [ "$previous" = --manifest-path ]; then manifest=$argument; fi
        previous=$argument
    done
    case "$(cat "$manifest")" in
        *native-runtime*) exec "${LOFI_TEST_CARGO:-cargo}" "$@" --features native-runtime/gc-stress ;;
    esac
fi
exec "${LOFI_TEST_CARGO:-cargo}" "$@"
