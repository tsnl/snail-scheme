digraph spawn_browser {
  graph [rankdir=TB, bgcolor="#fafaf7", pad=0.3, nodesep=0.4, ranksep=0.4,
         fontname="sans-serif", fontsize=17, label="Server runtime spawns a browser node", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#455565",
        fontname="sans-serif", fontsize=15, margin="0.16,0.12"];
  edge [color="#455565", fontname="sans-serif", fontsize=13];
  request [label="Server node\nspawn(browser-spawner, game-browser, options)", fillcolor="#e8eff5"];
  choose [label="Server runtime\nselect configured artifacts + reserve spawn\nprepare expiring browser startup session"];
  serve [label="Serve a navigation request\nor report a start URL"];
  browser [label="Browser navigation\nload JavaScript + Wasm artifacts"];
  init [label="Browser runtime\ninitialize browser node"];
  ready [label="Startup exchange\nvalidate identity + runtime contract\nconfirm initialization"];
  resolved [label="spawn completes with browser node\napplication connect can now proceed", fillcolor="#e8eff5"];
  failed [label="Startup deadline or initialization failure\nexpire session + attempt cleanup\nreport failure or unknown outcome"];
  request -> choose;
  choose -> serve;
  serve -> browser [label="navigation occurs"];
  browser -> init;
  init -> ready;
  ready -> resolved;
  serve -> failed [label="no attachment"];
  init -> failed [label="failure"];
}
