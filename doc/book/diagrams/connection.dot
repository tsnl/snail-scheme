digraph connection {
  graph [rankdir=TB, bgcolor="#fafaf7", pad=0.3, nodesep=0.35, ranksep=0.4,
         fontname="sans-serif", fontsize=17, label="Runtimes cooperate through a client on each end", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#455565",
        fontname="sans-serif", fontsize=15, margin="0.16,0.12"];
  edge [color="#455565", fontname="sans-serif", fontsize=13];
  subgraph cluster_a {
    label="Runtime A"; color="#bcc8d0"; style=rounded;
    a [label="Node A"];
    ca [label="Client A\nencode / decode\ncalls / streams\ntimeouts / errors\nhang-up / cleanup", fillcolor="#e8eff5"];
    a -> ca [dir=both, label="local\nvalues"];
  }
  subgraph cluster_b {
    label="Runtime B"; color="#bcc8d0"; style=rounded;
    cb [label="Client B\nencode / decode\ncalls / streams\ntimeouts / errors\nhang-up / cleanup", fillcolor="#e8eff5"];
    b [label="Node B"];
    b -> cb [dir=both, label="local\nvalues"];
  }
  ca -> cb [dir=both, constraint=false, label="agreed message contract\nencoded messages\nqueue / IPC / network", color="#245f86"];
}
