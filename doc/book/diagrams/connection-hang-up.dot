digraph connection_hang_up {
  graph [rankdir=TB, bgcolor="#fafaf7", pad=0.3, nodesep=0.4, ranksep=0.4,
         fontname="sans-serif", fontsize=17, label="Hang-up closes clients; nodes can keep running", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#455565",
        fontname="sans-serif", fontsize=15, margin="0.16,0.12"];
  edge [color="#455565", fontname="sans-serif", fontsize=13];
  trigger [label="Node A: hang-up(connection, reason)", fillcolor="#e8eff5"];
  local [label="Client A\nreject new work\nsettle pending calls / streams\nrelease local resources"];
  transfer [label="Attempt hang-up message\nno acknowledgement required"];
  notified [label="Client B receives hang-up"];
  lost [label="Message cannot arrive\nClient B detects failure / timeout"];
  remote [label="Client B\nreject new work\nsettle pending calls / streams\nrelease local resources"];
  result [label="Both clients closed\nnodes and other connections may continue\neffects already performed remain", fillcolor="#e8eff5"];
  trigger -> local;
  local -> transfer [label="complete locally"];
  transfer -> notified [label="delivered"];
  transfer -> lost [label="lost"];
  notified -> remote;
  lost -> remote;
  remote -> result;
}
