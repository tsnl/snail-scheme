digraph nodes_build {
  graph [rankdir=TB, bgcolor="#fafaf7", pad=0.3, nodesep=0.35, ranksep=0.5,
         fontname="sans-serif", fontsize=17, label="Build artifacts; spawn nodes; connect nodes", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#455565",
        fontname="sans-serif", fontsize=15, margin="0.16,0.12"];
  edge [color="#455565", fontname="sans-serif", fontsize=13];
  build [label="build.scm\nScheme compiler libraries + other tools", fillcolor="#e8eff5"];
  server_files [label="Server artifact\nWasm + Node.js loader"];
  browser_files [label="Browser artifacts\nWasm + JavaScript"];
  assets [label="Other artifacts\nWGSL + cooked GLB"];
  server_runtime [label="Server runtime\nconfigured artifacts + spawners", fillcolor="#e8eff5"];
  browser_runtime [label="Browser runtime\nconfigured artifacts + spawners", fillcolor="#e8eff5"];
  server_node [label="Server node"];
  browser_node [label="Browser node"];
  build -> server_files;
  build -> browser_files;
  build -> assets;
  server_files -> server_runtime [label="load"];
  browser_files -> browser_runtime [label="load"];
  server_runtime -> server_node [label="spawn"];
  browser_runtime -> browser_node [label="spawn"];
  assets -> browser_node [label="consume", constraint=false];
  {rank=same; server_node; browser_node;}
  server_node -> browser_node [dir=both, label="connection\nmessages", color="#245f86"];
}
