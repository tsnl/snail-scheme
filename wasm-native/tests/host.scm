;; Run with -D snail-tests -I scheme -I tests from this package directory.
(import
 (scheme base)
 (scheme write)
 (chibi temp-file)
 (only (wasm-native) test-wasm-native)
 (only (wasm-native chromium-trace) test-chromium-trace with-chromium-trace-to)
 (only (wasm-native llvm) test-llvm)
 (only (wasm-native llvmlite) test-llvmlite)
 (only (wasm-native wasm-read) test-wasm-read)
 (only (wasm-native wasm-resolve) test-wasm-resolve)
 (only (wasm-native wasm) test-wasm)
 (only (wasm-native native-build) test-native-build)
 (only (wasm-native execute) test-native-execution)
 (only (wasm-native json) test-json)
 (only (wasm-native process) test-process))

(test-wasm-native)
(test-chromium-trace)
(test-native-build)
(test-native-execution)
(test-json)
(test-process)
(call-with-temp-dir
 "wasm-native-unit-traces"
 (lambda (directory preserve)
   (with-chromium-trace-to
    (string-append directory "/tests.json")
    (lambda ()
      (test-llvm)
      (test-llvmlite)
      (test-wasm-read)
      (test-wasm-resolve)
      (test-wasm)))))
(display "All wasm-native host tests passed\n")
