;; The SFIR book's small formatting dependency. The caller supplies one byte.
(define-library (example hex)
  (export byte->hex)
  (import (sfir base))
  (begin
    (def byte->hex (-> I32 String)
         (lambda (value)
           (if (< value 0) (unreachable)
               (if (> value 255) (unreachable)
                   (string
                    (string-ref "0123456789abcdef" (i32->i64 (quotient value 16)))
                    (string-ref "0123456789abcdef" (i32->i64 (remainder value 16))))))))))
