;; Dirty WasmGC experiment. Expand with the production frontend, then serialize
;; closed numeric procedures without modifying the existing compiler pipeline.
(import (scheme base) (scheme cxr) (scheme file) (scheme write) (scheme process-context)
        (snail-scheme reader) (snail-scheme syntax-parser) (snail-scheme bootstrap)
        (snail-scheme expand)
        (prefix (snail-scheme hir) h:) (prefix (snail-scheme library) l:))

(define args (cdr (command-line)))
(define root (car args))
(define input (cadr args))
(define descriptor-output (caddr args))
(define (read-source path) (reader->syntax-list (file->reader path)))
(define (name-path names)
  (let ((part (if (symbol? (car names)) (symbol->string (car names)) (number->string (car names)))))
    (if (null? (cdr names)) part (string-append part "/" (name-path (cdr names))))))
(define (load-library name)
  (car (read-source (string-append root "/" (if (eq? (car name) 'scheme) "bootstrap/" "src/")
                                   (name-path name) ".sld"))))
(define core (make-core-library '(snail-scheme core) bootstrap-primitive-names))
(define hir (syntax-list->hir-library (read-source input) load-library (list core)))
(define primitive-operations '((+ . 0) (- . 1) (= . 2) (< . 3) (<= . 4) (> . 5) (>= . 6)))
(define primitives
  (map (lambda (entry) (cons (l:named-binding-definition entry) (l:named-binding-name entry)))
       (l:library-exports core)))
(define (primitive node)
  (and (h:name? node)
       (let ((entry (assq (h:name-definition node) primitives)))
         (and entry (assq (cdr entry) primitive-operations)))))
(define (index-of value values)
  (let loop ((values values) (index 0))
    (cond ((null? values) #f) ((eq? value (car values)) index)
          (else (loop (cdr values) (+ index 1))))))
(define (all predicate values)
  (or (null? values) (and (predicate (car values)) (all predicate (cdr values)))))
(define (supported? node self params)
  (cond ((h:literal? node) (and (exact-integer? (h:literal-value node))
                                (<= -1073741824 (h:literal-value node) 1073741823)))
        ((h:name? node) (if (index-of (h:name-definition node) params) #t #f))
        ((h:block? node) (and (pair? (h:block-items node))
                              (all (lambda (item) (supported? item self params)) (h:block-items node))))
        ((h:conditional? node)
         (and (h:conditional-opt-alternate node)
              (all (lambda (item) (supported? item self params))
                   (list (h:conditional-test node) (h:conditional-consequent node)
                         (h:conditional-opt-alternate node)))))
        ((h:application? node)
         (let ((operator (h:application-operator node)) (operands (h:application-operands node)))
           (and (h:name? operator)
                (or (and (eq? (h:name-definition operator) self) (= (length operands) (length params)))
                    (and (primitive operator) (= (length operands) 2)))
                (all (lambda (item) (supported? item self params)) operands))))
        (else #f)))
(define (serialize node self params)
  (cond ((h:literal? node) (list 'literal (h:literal-value node)))
        ((h:name? node) (list 'argument (index-of (h:name-definition node) params)))
        ((h:block? node) (cons 'sequence (map (lambda (item) (serialize item self params)) (h:block-items node))))
        ((h:conditional? node)
         (cons 'if (map (lambda (item) (serialize item self params))
                        (list (h:conditional-test node) (h:conditional-consequent node)
                              (h:conditional-opt-alternate node)))))
        ((h:application? node)
         (cons (if (primitive (h:application-operator node))
                   (cdr (primitive (h:application-operator node))) 'recur)
               (map (lambda (item) (serialize item self params)) (h:application-operands node))))))
(define selected
  (let loop ((items (l:library-body hir)) (index 0) (result '()))
    (if (null? items) (reverse result)
        (let* ((item (car items))
               (procedure (and (h:value-binding? item) (h:value-binding-initializer item)))
               (self (and (h:value-binding? item) (h:value-binding-definition item))))
          (if (and procedure (h:lambda? procedure) (not (h:lambda-opt-rest-parameter procedure))
                   (supported? (h:lambda-body procedure) self (h:lambda-parameters procedure)))
              (loop (cdr items) (+ index 1) (cons (list procedure self index) result))
              (loop (cdr items) index result))))))
;; Reject mutations of selected functions and their core numeric operators.
(define (reject-mutation node)
  (cond ((h:assignment? node)
         (if (or (assq (h:name-definition (h:assignment-target node)) primitives)
                 (memq (h:name-definition (h:assignment-target node)) (map cadr selected)))
             (error "WasmGC prototype does not support rebinding its callees"))
         (reject-mutation (h:assignment-value node)))
        ((h:lambda? node) (reject-mutation (h:lambda-body node)))
        ((h:value-binding? node) (reject-mutation (h:value-binding-initializer node)))
        ((h:block? node) (for-each reject-mutation (h:block-items node)))
        ((h:application? node) (for-each reject-mutation (cons (h:application-operator node) (h:application-operands node))))
        ((h:conditional? node) (for-each reject-mutation
                                         (list (h:conditional-test node) (h:conditional-consequent node)
                                               (h:conditional-opt-alternate node))))))
(for-each (lambda (library) (for-each reject-mutation (l:library-body library))) (l:library-dependency-order hir))
(call-with-output-file descriptor-output
  (lambda (port)
    (write (map (lambda (entry)
                  (let ((procedure (car entry)) (self (cadr entry)))
                    (list (symbol->string (h:value-definition-name self)) (caddr entry)
                          (length (h:lambda-parameters procedure))
                          (serialize (h:lambda-body procedure) self (h:lambda-parameters procedure))))) selected) port)))
