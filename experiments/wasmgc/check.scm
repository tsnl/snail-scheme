(import (scheme base))
(define (sum a b) (+ a b))
(define (difference a b) (- a b))
(define (double-sum a b) (+ (+ a b) (+ a b)))
(define (truthy n) (if n 1 0))
(define (less a b) (< a b))
(define (equal-number a b) (= a b))
(define (less-equal a b) (<= a b))
(define (greater a b) (> a b))
(define (greater-equal a b) (>= a b))
(define (down n answer)
  (if (= n 0) answer (down (- n 1) (+ answer 1))))
