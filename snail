#!/bin/sh
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case ${1:-} in
  -h|--help) cat "$root/scripts/snail-help.txt"; exit 0 ;;
  dev) shift; exec "${NODE:-node}" --no-warnings "$root/host/native/dev.mjs" "$root" "$@" ;;
  # The command line is a Snail program (bootstrap/cli.sld). Stage 0 rebuilds
  # it and the runtime when their sources change, and names them a line each.
  build|run)
    tools=$("$root/scripts/snail-tool" cli-tools) || exit 1
    { read -r cli && read -r runtime; } <<TOOLS
$tools
TOOLS
    exec "${NODE:-node}" --no-warnings "$root/host/native/run-snail.mjs" "$cli" "$root" "$runtime" "$@" ;;
  *) printf 'snail: expected build, run or dev; use --help\n' >&2; exit 2 ;;
esac
