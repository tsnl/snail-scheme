  (import
   (rename (scheme base)
           (case scheme-case)
           (define scheme-define))
   (only (chibi) _ ...)
   (scheme char)
   (rename (srfi 1) (drop list-drop))
   (rename (only (srfi 132) list-stable-sort) (list-stable-sort list-sort))
   (srfi 151)
   (snail stage0 forms))
