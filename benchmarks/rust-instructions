#!/usr/bin/env python3
"""Compare numeric VM handlers in LLVM and Rust under matched link pipelines."""

import argparse
import hashlib
import json
import os
import re
from pathlib import Path
import runpy
from statistics import median
import subprocess

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build/rust-instructions"
LTO = runpy.run_path(str(ROOT / "benchmarks/lto"), run_name="lto_helpers")
BENCH = LTO["BENCH"]
VARIANTS = ("baseline", "cross-lto")
NUMERIC_CALL = r"\bcall\b[^\n]*@snail_vm_(?:add|subtract|numeric-equal|less|less-equal|greater|greater-equal)\("

# ---- Freeze all four builds before timing ----


def build(report):
    for language in ("llvm", "rust"):
        directory = BUILD / language
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / "cpu.ll"
        command = [os.environ.get("CHIBI", "chibi-scheme")]
        if language == "rust":
            command += ["-D", "snail-rust-numeric"]
        command += ["-I", str(ROOT / "src"), str(ROOT / "src/snail-scheme/compile.scm"),
                    str(ROOT), str(ROOT / "benchmarks/cpu.scm"), str(path)]
        subprocess.run(command, cwd=ROOT, check=True)
        module = BENCH["CompiledModule"](path, BENCH["input_metadata"]("cpu"))
        LTO["build_variant"].__globals__["BUILD"] = directory
        for variant in VARIANTS:
            LTO["build_variant"]("cpu", module, variant, "native", report["builds"])
            report["builds"][-1].update(language=language, compiler_command=command)
        report.setdefault("inlining", {})[language] = audit_inlining(directory)


def program_body(path):
    text = path.read_text()
    return re.search(r"^define [^\n]*@snail_program\([^\n]*\n.*?^}", text, re.M | re.S).group()


def audit_inlining(directory):
    audit = {}
    for stage in ("0.0.preopt", "0.4.opt"):
        bitcode = next((directory / "linked/native/cpu").glob("*." + stage + ".bc"))
        llvm = bitcode.with_suffix(".ll")
        subprocess.run(["llvm-dis", str(bitcode), "-o", str(llvm)], check=True)
        body = program_body(llvm)
        audit[stage] = {"numeric_calls": len(re.findall(NUMERIC_CALL, body)),
                        "program_ir_sha256": hashlib.sha256(body.encode()).hexdigest(),
                        "module_sha256": BENCH["fingerprint"](llvm)}
    assembly = bitcode.with_suffix(".s")
    subprocess.run(["llc", str(bitcode), "-o", str(assembly)], check=True)
    audit["assembly_sha256"] = BENCH["fingerprint"](assembly)
    return audit


# ---- Rotate process order with fixed work and checked answers ----


def executables():
    for language in ("llvm", "rust"):
        for variant in VARIANTS:
            path = BUILD / language / "bin/native" / variant / "cpu"
            yield BENCH["Executable"](language + "-" + variant, "native", path, (str(path),))


def measure(report, rounds):
    group = list(executables())
    for executable, build in zip(group, report["builds"], strict=True):
        if BENCH["fingerprint"](executable.path) != build["executable_sha256"]:
            raise RuntimeError(f"saved executable changed: {executable.path}")
        BENCH["run_sample"]("cpu", executable, 64, False)
    for index in range(rounds):
        offset = index % len(group)
        for position, executable in enumerate(group[offset:] + group[:offset]):
            result = BENCH["run_sample"]("cpu", executable, 64, False)
            result.update(round=index + 1, position=position + 1, command=[*executable.command, "64"])
            report["samples"].append(result)
    report["median_ms"] = {e.implementation: median(s["elapsed_ms"] for s in report["samples"]
                              if s["implementation"] == e.implementation) for e in group}
    report["host"] = BENCH["execution_host"](report["samples"], None)
    print(json.dumps({"median_seconds": {name: value / 1000
                      for name, value in report["median_ms"].items()}}, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--build-only", action="store_true")
    modes.add_argument("--measure-only", action="store_true")
    parser.add_argument("--samples", type=BENCH["positive_integer"], default=8)
    args = parser.parse_args()
    path = BUILD / "results.json"
    LTO["validate_environment"]()
    if args.measure_only:
        report = json.loads(path.read_text())
    else:
        BUILD.mkdir(parents=True, exist_ok=True)
        report = {**LTO["provenance"](), "builds": [], "samples": [],
                  "harness_sha256": BENCH["fingerprint"](Path(__file__)),
                  "method": "native i686; 64 repetitions; one warmup per variant; rotated order"}
        build(report)
        path.write_text(json.dumps(report, indent=2) + "\n")
    if not args.build_only:
        if report["source_sha256"] != LTO["ABLATE"]["source_state"]():
            raise RuntimeError("sources changed after building; rebuild before timing")
        report["samples"] = []
        report["measurement_harness_sha256"] = BENCH["fingerprint"](Path(__file__))
        measure(report, args.samples)
        path.write_text(json.dumps(report, indent=2) + "\n")


if __name__ == "__main__":
    main()
