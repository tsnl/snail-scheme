(def Specification (datatype ()
  (specification
    (count I64 specification-count)
    (size I64 specification-size)
    (expected Datum specification-expected))))

(def read-specification (-> InputPort Specification)
  (lambda (port)
    ((lambda (count.2) ((lambda (size) ((lambda (expected.1) ((lambda () (specification count.2 size expected.1)))) (read-value! (read port)))) (boyer-exact (read-value! (read port)))))
      (boyer-exact (read-value! (read port))))))

(def configured (call-with-input-file "input.txt" read-specification))

(def configured-count (-> I64) (lambda () (specification-count configured)))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(def hide (-> I64 I64 I64) (lambda (count.1 value) (if (barrier) value (unreachable))))

(def boyer-accepted? (-> Datum Datum Bool)
  (lambda (result.1 expected)
    (if (datum-number? result.1) (= (boyer-exact result.1) (boyer-exact expected)) #f)))

