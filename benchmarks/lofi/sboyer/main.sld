;; Canonical bare Lofi. See migration.json for source provenance.

(import
  (lofi base)
  (rename (lofi datum) (string->symbol typed-string->symbol))
  (lofi io)
  (lofi read))

(def boyer-zero? (-> I64 Bool) (lambda (value.16) (= value.16 (ann 0 I64))))

(def boyer-exact (-> Datum I64)
  (lambda (value.15)
    (match (datum-number-value value.15)
      ((exact-number value.12) value.12)
      ((rational-number value.13) (datum-fail "boyer: expected an exact integer"))
      ((inexact-number value.14) (datum-fail "boyer: expected an exact integer"))
      ((complex-number real imaginary) (datum-fail "boyer: expected an exact integer")))))

(def boyer-symbol (-> String Datum) (lambda (text) (datum-symbol (typed-string->symbol text))))

(def boyer-integer (-> I64 Datum) (lambda (value.11) (datum-number (exact-number value.11))))

(def boyer-caar (lambda (value.10) (datum-car (datum-car value.10))))

(def boyer-cdar (lambda (value.9) (datum-cdr (datum-car value.9))))

(def boyer-cadr (lambda (value.8) (datum-car (datum-cdr value.8))))

(def boyer-caddr (lambda (value.7) (datum-car (datum-cdr (datum-cdr value.7)))))

(def boyer-cadddr (lambda (value.6) (datum-car (datum-cdr (datum-cdr (datum-cdr value.6))))))

(def boyer-vector (-> Datum Datum Datum)
  (lambda (first.1 second) (datum-vector (vector first.1 second))))

(def boyer-vector-ref
  (lambda (value.5 index.2) (vector-ref (datum-vector-values value.5) index.2)))

(def boyer-vector-set!
  (lambda (value.4 index.1 item) (vector-set! (datum-vector-values value.4) index.1 item)))

