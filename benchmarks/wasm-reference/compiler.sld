;; Compare complete compiler stages with the unchanged original Chez algorithm.
(define-library (wasm-reference compiler)
  (export reference-compiler-main)
  (import (scheme base) (scheme char) (scheme cxr) (scheme file) (scheme write)
          (chibi filesystem) (chibi pathname) (only (chibi string) string-prefix? string-suffix? string-trim)
          (srfi 1) (srfi 95) (native process) (native native-build)
          (wasm-reference suite) (wasm-reference audit))
  (begin

    ;; ---- Original stage oracles ----

    (define (oracle-source root group)
      (let* ((source (string-trim (chez-source root "compiler") char-whitespace?)) (run "(run-benchmark)"))
        (unless (string-suffix? run source) (error "compiler control must end with run-benchmark"))
        (replace-text (substring source 0 (- (string-length source) (string-length run)))
                      "    current-time\n" (if (eq? group 'assembly) "    current-time\n    parameterize\n"
                                               "    current-time\n    parameterize\n    print-extended-identifiers\n"))))
    (define (stage-specifications group)
      (case group
        ((frontend) '(("raw" "raw" ()) ("partial" "partial" ("--partial")) ("normalized" "normalized" ("--normalize"))))
        ((gvm) '(("raw" "raw-gvm" ("--gvm-raw")) ("purified" "purified-gvm" ("--gvm"))))
        ((asm) '(("assembler" "assembler" ("--asm-probe"))))
        ((assembly) '(("assembly" "assembly" ("--assembly-audit"))))
        (else (error "unknown compiler probe group" group))))
    (define (oracle-tail root group stage)
      (let* ((name (case group ((frontend) "front") ((gvm) "gvm") ((asm) "asm") ((assembly) "assembly")))
             (tail (read-text (path-join (reference-directory root) "tests" (string-append "compiler-" name "-oracle-tail.scm")))))
        (case group
          ((frontend) (replace-text tail "@STAGE@" stage))
          ((gvm) (replace-text (replace-text tail "@PHASE_STOP@" (if (string=? stage "raw") "(set! bbs-purify! (lambda (bbs) #f))" ""))
                               "@SLOT_AUDIT@" (if (string=? stage "raw") "" "(map code-slots-needed (bbs->code-list (proc-obj-code proc)))")))
          (else tail))))
    (define (prepare-oracles root source output group)
      (pinned-sources source)
      (let ((original (oracle-source root group)))
        (for-each (lambda (spec)
                    (let ((program (path-join output (string-append (cadr spec) ".scm")))
                          (artifact (path-join output (string-append (cadr spec) ".so"))))
                      (write-text program (string-append original (oracle-tail root group (car spec))))
                      (compile-chez-source program artifact))) (stage-specifications group)))
      (read-text (path-join source "inputs/compiler.input")))
    (define (copy-compiler-sources root output group)
      (let ((source (path-join (reference-directory root) "src")))
        (for-each (lambda (name) (copy-file! (path-join source name) (path-join output name)))
                  (if (eq? group 'frontend) '("compiler.rs")
                      (filter (lambda (name) (and (string-prefix? "compiler" name) (or (string-suffix? ".rs" name) (string-suffix? ".scm" name))))
                              (directory-files source))))))

    ;; ---- Complete stage outputs and fixtures ----

    (define (probe-execution root output name stage command input)
      (let ((run (reference-execute command output input 60 (path-join output "logs"))))
        (copy-file! (option-ref run 'stdout_path #f) (path-join output (string-append name "-" stage ".txt"))) run))
    (define (check-program root output group name input spec)
      (write-text (path-join output (string-append name ".input")) input)
      (let* ((stage (car spec)) (stem (cadr spec)) (flags (caddr spec))
             (commands (list (cons 'rust-wasm (append (list (tool-name "NODE" "node") "--no-warnings"
                                                            (path-join (reference-directory root) "run-wasi.mjs")
                                                            (path-join output "compiler_frontend.wasm")) flags))
                             (cons 'chez (list (tool-name "CHEZ" "scheme") "--program" (path-join output (string-append stem ".so"))))))
             (runs (map (lambda (entry) (cons (car entry) (probe-execution root output name (string-append stage "-" (symbol->string (car entry))) (cdr entry) input))) commands))
             (complete (and (every (lambda (run) (and (zero? (option-ref (cdr run) 'returncode 1)) (option-ref (cdr run) 'descendants_gone #f)
                                                      (null? (json-items (cdr run) 'unexpected_descendants)))) runs)
                            ((if (eq? group 'frontend) alpha-equivalent? same-audit?)
                             (option-ref (option-ref runs 'rust-wasm '()) 'stdout "") (option-ref (option-ref runs 'chez '()) 'stdout "")))))
        (display (string-append name " / " stage ": " (if complete "passed\n" "FAILED; retained diagnostics\n"))) (flush-output-port)
        `((name . ,name) (stage . ,stage) (input_sha256 . ,(file-sha256 (path-join output (string-append name ".input")))) (complete . ,complete) (runs . ,runs))))
    (define (assembler-cases)
      (list (cons 'zero-distance-widening "((branch 24576 1) (label 1 #t))")
            (cons 'empty-code "()")
            (cons 'forward-backward-relocations
                  (string-append "((label 1 #t) (branch 26368 2) " (apply string-append (make-list 70 "(word 20081) "))
                                 "(label 2 #t) (branch 26112 1) (word-relative 1 -6) (long-relative 2 3 127) (align 8 4) (text \"relocated\"))"))
            (cons 'symbol-and-procedure-records "((label 1 #t) (word 8192) (global-reference \"alpha\") (text \"read\") (global-assignment \"alpha\") (word 3) (global-jump \"beta\") (procedure-reference 7 -2) (primitive-reference \"+\" 10) (global-reference \"beta\") (m68020) (m68881) (text \"records\"))")
            (cons 'signed-words-and-alignment "((label 1 #t) (long -65537) (long -131072) (word -1) (word 65537) (align 8 4) (label 2 #t) (word-relative 1 32766) (text \"signed\"))")))
    (define (compiler-fixtures root group)
      (if (eq? group 'asm) (assembler-cases)
          (fold (lambda (name fixtures)
                  (let ((path (path-join (reference-directory root) "tests" (string-append "compiler-" name "-fixtures.json"))))
                    (if (not (file-exists? path)) fixtures
                        (fold (lambda (entry entries)
                                (if (assq (car entry) entries)
                                    (map (lambda (old) (if (eq? (car old) (car entry)) entry old)) entries)
                                    (append entries (list entry)))) fixtures (read-json path)))))
                '() (case group ((frontend) '("front")) ((gvm) '("front" "gvm" "blocks")) (else '("front" "gvm" "blocks" "assembly"))))))
    (define (compiler-input group expression)
      (if (eq? group 'asm) (string-append expression "\n")
          (string-append "1\n(begin (declare (standard-bindings) (fixnum) (not safe) (block)) " expression ")\nm68000\nasm\nignored\n")))
    (define (oracle-hashes output group extension)
      (let ((hashes (map (lambda (spec) (cons (string->symbol (car spec)) (file-sha256 (path-join output (string-append (cadr spec) extension)))))
                         (stage-specifications group))))
        (if (memq group '(asm assembly)) (cdar hashes) hashes)))
    (define (source-hashes output group)
      (if (eq? group 'frontend) (file-sha256 (path-join output "compiler.rs"))
          (map (lambda (name) (cons (string->symbol name) (file-sha256 (path-join output name))))
               (sort (filter (lambda (name) (string-prefix? "compiler" name)) (directory-files output)) string<?))))
    (define (compiler-report output group records)
      (append `((kind . ,(case group ((frontend) "intermediate frontend correctness") ((gvm) "complete GVM correctness")
                               ((asm) "complete assembler diagnostics") (else "complete assembly and normalized object-word correctness")))
                (performance_samples . #f) (source_sha256 . ,(source-hashes output group))
                (wasm_sha256 . ,(file-sha256 (path-join output "compiler_frontend.wasm")))
                (oracle_source_sha256 . ,(oracle-hashes output group ".scm")) (oracle_binary_sha256 . ,(oracle-hashes output group ".so"))
                (records . ,(list->vector records)) (tools . ,(reference-tools))
                (complete . ,(every (lambda (record) (option-ref record 'complete #f)) records)))
              (if (eq? group 'assembly) '((canonical_full_count_pending . #t)) '((canonical_full_compiler_pending . #t)))
              (if (eq? group 'frontend) '((original_stage_oracle_printing . "extended identifiers printed literally; compiler algorithms unchanged")) '())))

    ;; ---- Command line and retained reports ----

    (define (compiler-options root arguments)
      (let loop ((arguments arguments) (options `((source . ,(path-join root "benchmarks/r7rs-benchmarks")))))
        (cond ((null? arguments) options)
              ((and (member (car arguments) '("--output" "--source")) (pair? (cdr arguments)))
               (loop (cddr arguments) (cons (cons (string->symbol (substring (car arguments) 2)) (absolute-path (cadr arguments))) options)))
              (else (error "compiler probe requires --output DIR [--source DIR]")))))
    (define (reference-compiler-main root group arguments)
      (let* ((options (compiler-options root arguments)) (output (option-ref options 'output #f)))
        (unless output (error "--output is required"))
        (create-directory* output)
        (parameterize ((current-process-supervisor (ensure-native-supervisor root)) (current-command-records '())
                       (current-command-log (path-join output "commands.json")))
          (let* ((canonical (prepare-oracles root (option-ref options 'source #f) output group))
                 (specifications (stage-specifications group)) (records '()))
            (copy-file! (path-join (reference-directory root) "target/wasm32-wasip1/release/examples/compiler_frontend.wasm")
                        (path-join output "compiler_frontend.wasm"))
            (copy-compiler-sources root output group)
            (unless (eq? group 'asm)
              (set! records (map (lambda (spec) (check-program root output group (if (eq? group 'assembly) "canonical-program-once" "canonical-program") canonical spec)) specifications)))
            (for-each (lambda (fixture)
                        (set! records (append records (map (lambda (spec) (check-program root output group (symbol->string (car fixture)) (compiler-input group (cdr fixture)) spec)) specifications))))
                      (compiler-fixtures root group))
            (let ((report (compiler-report output group records)))
              (write-json (path-join output "validation.json") report) (if (option-ref report 'complete #f) 0 1))))))))
