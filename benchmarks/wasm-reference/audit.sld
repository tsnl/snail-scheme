;; Complete residual programs, instruction graphs and nucleic transformations.
(define-library (wasm-reference audit)
  (export read-audit alpha-equivalent? same-audit? same-solutions?)
  (import (scheme base) (scheme char) (scheme cxr) (scheme inexact) (srfi 1) (chibi regexp))
  (begin

    ;; ---- Serialized audit grammar ----

    (define (skip-space port)
      (let ((next (peek-char port)))
        (when (and (char? next) (char-whitespace? next)) (read-char port) (skip-space port))))
    (define (quoted-token port)
      (let ((output (open-output-string)))
        (write-char (read-char port) output)
        (let loop ()
          (let ((character (read-char port)))
            (when (eof-object? character) (error "unterminated audit string"))
            (write-char character output)
            (cond ((char=? character #\") (get-output-string output))
                  ((char=? character #\\)
                   (let ((escaped (read-char port)))
                     (when (eof-object? escaped) (error "unterminated audit escape"))
                     (write-char escaped output) (loop)))
                  (else (loop)))))))
    (define (atom-token port)
      (let ((output (open-output-string)))
        (let loop ()
          (let ((next (peek-char port)))
            (if (or (eof-object? next) (char-whitespace? next) (memv next '(#\( #\))))
                (get-output-string output)
                (begin (write-char (read-char port) output) (loop)))))))
    (define (read-audit-list port)
      (read-char port)
      (let loop ((items '()))
        (skip-space port)
        (cond ((eof-object? (peek-char port)) (error "unterminated audit list"))
              ((char=? (peek-char port) #\)) (read-char port) (reverse items))
              (else (loop (cons (read-audit-term port) items))))))
    (define (read-audit-term port)
      (skip-space port)
      (let ((next (peek-char port)))
        (cond ((eof-object? next) (error "missing audit datum"))
              ((char=? next #\)) (error "unexpected audit delimiter"))
              ((char=? next #\() (read-audit-list port))
              ((char=? next #\") (quoted-token port))
              (else (atom-token port)))))
    (define (read-audit text)
      (let* ((port (open-input-string text)) (term (read-audit-term port)))
        (skip-space port)
        (unless (eof-object? (read-char port)) (error "extra audit datum")) term))

    ;; ---- Lexical alpha equivalence ----

    (define (identifier? token)
      (and (string? token) (not (member token '("" ".")))
           (not (memv (string-ref token 0) '(#\# #\")))
           (not (regexp-search (rx bos (? (or "+" "-")) (or numeric (seq "." numeric))) token))))
    (define (bind-names names environment serial)
      (unless (and (list? names) (every identifier? names) (= (length names) (length (delete-duplicates names))))
        (error "audit binders must be distinct identifiers"))
      (let loop ((names names) (renamed '()) (nested environment))
        (if (null? names) (values (reverse renamed) nested)
            (let ((identity (vector 'bound-variable (vector-ref serial 0))))
              (vector-set! serial 0 (+ 1 (vector-ref serial 0)))
              (loop (cdr names) (cons identity renamed) (cons (cons (car names) identity) nested))))))
    (define (canonical-binding expression environment serial)
      (let ((bindings (cadr expression)))
        (unless (and (list? bindings) (every (lambda (entry) (and (list? entry) (= 2 (length entry)))) bindings))
          (error "audit binding needs a name and initializer"))
        (let-values (((names nested) (bind-names (map car bindings) environment serial)))
          (let ((values-environment (if (equal? "letrec" (car expression)) nested environment)))
            (cons (car expression)
                  (cons (map (lambda (name entry) (list name (canonical-program (cadr entry) values-environment serial))) names bindings)
                        (map (lambda (body) (canonical-program body nested serial)) (cddr expression))))))))
    (define (canonical-program expression environment serial)
      (cond ((not (list? expression)) (let ((binding (assoc expression environment))) (if binding (cdr binding) expression)))
            ((or (null? expression) (equal? "quote" (car expression))) expression)
            (else
             (when (and (member (car expression) '("lambda" "let" "letrec")) (< (length expression) 3))
               (error "audit binding form requires a body"))
             (cond ((equal? "lambda" (car expression))
                    (let-values (((names nested) (bind-names (cadr expression) environment serial)))
                      (cons "lambda" (cons names (map (lambda (body) (canonical-program body nested serial)) (cddr expression))))))
                   ((member (car expression) '("let" "letrec")) (canonical-binding expression environment serial))
                   (else (map (lambda (item) (canonical-program item environment serial)) expression))))))
    (define (alpha-equivalent? first second)
      (guard (failure (else #f))
        (equal? (canonical-program (read-audit first) '() (vector 0))
                (canonical-program (read-audit second) '() (vector 0)))))
    (define (same-audit? first second)
      (guard (failure (else #f)) (equal? (read-audit first) (read-audit second))))

    ;; ---- Ordered nucleic solution identities and transformations ----

    (define (same-coordinate? actual expected)
      (let ((a (decimal-coordinate actual)) (b (decimal-coordinate expected)))
        (and (real? a) (real? b) (finite? a) (finite? b)
             (<= (abs (- a b)) (max 1e-11 (* 1e-11 (max (abs a) (abs b))))))))
    (define (decimal-coordinate text)
      (and (string? text)
           (regexp-matches? (rx (? (or "+" "-")) (or (seq (+ numeric) (? "." (* numeric))) (seq "." (+ numeric)))
                                (? (or "e" "E") (? (or "+" "-")) (+ numeric))) text)
           (inexact (string->number text))))
    (define (same-variable? actual expected)
      (and (list? actual) (list? expected) (= 3 (length actual) (length expected))
           (equal? (take actual 2) (take expected 2))
           (list? (caddr actual)) (list? (caddr expected)) (= 12 (length (caddr actual)) (length (caddr expected)))
           (every same-coordinate? (caddr actual) (caddr expected))))
    (define (same-solution? actual expected)
      (and (list? actual) (list? expected) (= (length actual) (length expected)) (every same-variable? actual expected)))
    (define (same-solutions? actual expected)
      (guard (failure (else #f))
        (let ((actual (read-audit actual)) (expected (read-audit expected)))
          (and (list? actual) (list? expected) (= (length actual) (length expected)) (every same-solution? actual expected))))))

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-reference-audits)
    (import (lofi host test-utils) (srfi 130))
    (begin
      (define (replace-audit text before after)
        (let ((offset (string-cursor->index text (string-contains text before))))
          (string-append (substring text 0 offset) after (substring text (+ offset (string-length before))))))
      (define (test-alpha-bindings)
        (for-each (lambda (pair) (expect (apply alpha-equivalent? pair) #t))
                  '(("(lambda (x) (let ((x x)) x))" "(lambda (a) (let ((b a)) b))")
                    ("(letrec ((f (lambda (x) (f x)))) (f y))" "(letrec ((g (lambda (a) (g a)))) (g y))")
                    ("(lambda (x) (let ((x x)) x x))" "(lambda (a) (let ((b a)) b b))")
                    ("(letrec ((f (lambda () f))) f f)" "(letrec ((g (lambda () g))) g g)")))
        (for-each (lambda (pair) (expect (apply alpha-equivalent? pair) #f))
                  '(("(lambda (x) (quote x))" "(lambda (a) (quote a))")
                    ("(lambda (x) y)" "(lambda (a) z)")
                    ("(lambda (x) (let ((x x)) x))" "(lambda (a) (let ((b a)) a))")
                    ("(lambda (x) (lambda (y) x))" "(lambda (a) (lambda (a) a))")
                    ("(lambda (x y) (pair x y))" "(lambda (a b) (pair b a))")
                    ("(lambda (x) (let ((x x)) x x))" "(lambda (a) (let ((b b)) b b))")
                    ("(letrec ((f (lambda () f))) f f)" "(letrec ((g (lambda () f))) g g)"))))
      (define (test-alpha-bodies)
        (for-each
         (lambda (heads)
           (let ((original (string-append "(" (car heads) " x (quote end))")))
             (expect (alpha-equivalent? original (string-append "(" (cadr heads) " a (quote end))")) #t)
             (for-each (lambda (body) (expect (alpha-equivalent? original (string-append "(" (cadr heads) " " body ")")) #f))
                       '("a" "a (quote end) a" "a (quote changed)" "(quote end) a"))))
         '(("lambda (x)" "lambda (a)") ("let ((x 1))" "let ((a 1))") ("letrec ((x 1))" "letrec ((a 1))"))))
      (define (test-invalid-audits)
        (for-each (lambda (text) (expect (alpha-equivalent? text text) #f))
                  '("(lambda (x x) x)" "(lambda (1) 1)" "(lambda x x)" "(lambda (x . y) x)"
                    "(let ((x 1) (x 2)) x)" "(let ((x 1 2)) x)" "(letrec ((x 1 2)) x)"
                    "(lambda (x))" "(let ())" "(letrec ())" "(lambda (x) x" "() ()")))
      (define (test-complete-graphs)
        (for-each
         (lambda (case)
           (let ((original (car case)))
             (expect (same-audit? original (string-append original "\n")) #t)
             (for-each (lambda (change) (expect (same-audit? original (replace-audit original (car change) (cadr change))) #f)) (cdr case))))
         '(("((copy (register 1) (stack 2) (2 (0 1) (2) () (0 1))))"
            ("register 1" "register 2") ("stack 2" "stack 1") ("(0 1)" "(0 0)") ("(2 (" "(3 (")
            ("()" "(jump (label 1) #f #t)"))
           ("((\"L0:\" \"step\") (32776 20081 65535) ((1 0)))"
            ("step" "other") ("20081" "20085") ("(1 0)" "(1 1)") ("65535" "65535 0"))
           ("((\"L1:\" \" movl d1,d2\" \"L0:\" \"\") (5 0 32768 8))"
            ("d2" "d3") ("32768" "32769") (" \"L0:\"" "") (" 8)" " 8 0)")))))
      (define (test-nucleic-solutions)
        (let ((original "(((23 rA (1 0 0 0 1 0 0 0 1 0 0 0))))"))
          (expect (same-solutions? original (replace-audit original "1 0" "1.000000000001 0")) #t)
          (for-each (lambda (change) (expect (same-solutions? original (replace-audit original (car change) (cadr change))) #f))
                    '(("23" "22") ("rA" "rG") ("1 0" "1.001 0") ("1 0" "1") ("1 0" "NaN 0")))
          (expect (same-solutions? original "()") #f)))
      (define (test-reference-audits)
        (run-test test-alpha-bindings) (run-test test-alpha-bodies) (run-test test-invalid-audits)
        (run-test test-complete-graphs) (run-test test-nucleic-solutions))))
   (else)))
