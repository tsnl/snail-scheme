(define (write-complete-datum value)
  (cond ((pair? value)
         (display "(")
         (let loop ((rest value) (first #t))
           (cond ((pair? rest)
                  (unless first (display " "))
                  (write-complete-datum (car rest))
                  (loop (cdr rest) #f))
                 ((null? rest) (display ")"))
                 (else (display " . ") (write-complete-datum rest) (display ")")))))
        ((vector? value)
         (display "#(")
         (let loop ((i 0))
           (when (< i (vector-length value))
             (unless (= i 0) (display " "))
             (write-complete-datum (vector-ref value i))
             (loop (+ i 1))))
         (display ")"))
        (else (write value))))
(define oracle-count (read))
(define oracle-file (read))
(define oracle-result '())
(do ((i 0 (+ i 1))) ((= i oracle-count)) (set! oracle-result (doit oracle-file)))
(write-complete-datum oracle-result) (newline)
(i!)
(define oracle-program (dynamic-parse-file oracle-file))
(normalize-global-constraints!)
(reset-counters!)
(define oracle-output (tag-ast*-show oracle-program))
(write-complete-datum oracle-output) (newline)
