;; Complete raw GVM diagnostics: no repetition loop or assembly predicate.
;; Stop at this explicit phase boundary; full purification is tested separately.
@PHASE_STOP@
(define diagnostic-vars '())
(define diagnostic-procs '())
(define diagnostic-pending '())
(define (diagnostic-map proc lst)
  (if (null? lst)
      '()
      (let* ((first (proc (car lst)))
             (rest (diagnostic-map proc (cdr lst))))
        (cons first rest))))
(define (diagnostic-var var)
  (cond ((eq? var ret-var) 'return)
        ((eq? var closure-env-var) 'closure)
        ((eq? var empty-var) 'empty)
        ((null? var) 'absent)
        ((global? var) (list 'global (var-name var)))
        (else
         (let ((found (assq var diagnostic-vars)))
           (if found
               (cdr found)
               (let ((id (length diagnostic-vars)))
                 (set! diagnostic-vars (cons (cons var id) diagnostic-vars))
                 id))))))
(define (diagnostic-frame frame)
  (let* ((slots (diagnostic-map diagnostic-var (frame-slots frame)))
         (regs (diagnostic-map diagnostic-var (frame-regs frame)))
         (closed (diagnostic-map diagnostic-var (frame-closed frame)))
         (live (diagnostic-map diagnostic-var (frame-live frame))))
    (list (frame-size frame) slots regs closed live)))
(define (diagnostic-opnd operand)
  (let ((semantic
  (cond ((reg? operand) (list 'register (reg-num operand)))
        ((stk? operand) (list 'stack (stk-num operand)))
        ((lbl? operand) (list 'label (lbl-num operand)))
        ((glo? operand) (list 'global (glo-name operand)))
        ((clo? operand)
         (list 'closure (diagnostic-opnd (clo-base operand)) (clo-index operand)))
        ((obj? operand)
         (let ((object (obj-val operand)))
           (if (proc-obj? object)
               (if (proc-obj-code object)
                   (let ((found (assq object diagnostic-procs)))
                     (list 'procedure
                           (if found
                               (cdr found)
                               (let ((id (length diagnostic-procs)))
                                 (set! diagnostic-procs (cons (cons object id) diagnostic-procs))
                                 (set! diagnostic-pending (append diagnostic-pending (list object)))
                                 id))))
                   (list 'primitive (string->symbol (string-downcase (proc-obj-name object)))))
               (list 'object object)))))))
    (list operand semantic)))
(define (diagnostic-parms parms)
  (let* ((loc (diagnostic-opnd (closure-parms-loc parms)))
         (operands (diagnostic-map diagnostic-opnd (closure-parms-opnds parms))))
    (list loc (closure-parms-lbl parms) operands)))
(define (diagnostic-instr instr)
  (let* ((fields
          (case (gvm-instr-type instr)
            ((label)
             (list 'label (label-lbl-num instr)
                   (case (label-type instr)
                     ((entry)
                      (list 'entry (label-entry-nb-parms instr) (label-entry-min instr)
                            (label-entry-rest? instr) (label-entry-closed? instr)))
                     (else (list (label-type instr))))))
            ((apply)
             (let* ((operands (diagnostic-map diagnostic-opnd (apply-opnds instr)))
                    (loc (and (apply-loc instr) (diagnostic-opnd (apply-loc instr)))))
               (list 'apply (string->symbol (string-downcase (proc-obj-name (apply-prim instr)))) operands loc)))
            ((copy)
             (let* ((operand (diagnostic-opnd (copy-opnd instr)))
                    (loc (diagnostic-opnd (copy-loc instr))))
               (list 'copy operand loc)))
            ((close) (list 'close (diagnostic-map diagnostic-parms (close-parms instr))))
            ((ifjump)
             (let ((operands (diagnostic-map diagnostic-opnd (ifjump-opnds instr))))
               (list 'ifjump (string->symbol (string-downcase (proc-obj-name (ifjump-test instr))))
                     operands (ifjump-true instr) (ifjump-false instr) (ifjump-poll? instr))))
            ((jump)
             (let ((operand (diagnostic-opnd (jump-opnd instr))))
               (list 'jump operand (jump-nb-args instr) (jump-poll? instr))))))
         (frame (diagnostic-frame (gvm-instr-frame instr))))
    (append fields (list frame))))
(define (diagnostic-bb bb)
  (let* ((first (diagnostic-instr (bb-label-instr bb)))
         (non-branch (diagnostic-map diagnostic-instr (bb-non-branch-instrs bb)))
         (branch (diagnostic-instr (bb-branch-instr bb))))
    (append (list first) non-branch (list branch))))
(define (diagnostic-graph proc)
  (diagnostic-opnd (make-obj proc))
  (let loop ((result '()))
    (if (null? diagnostic-pending)
        (reverse result)
        (let* ((proc (car diagnostic-pending))
               (ignored (set! diagnostic-pending (cdr diagnostic-pending)))
               (code (diagnostic-map diagnostic-bb (queue->list (bbs-bb-queue (proc-obj-code proc))))))
          (loop (cons (list (proc-obj-name proc) (proc-obj-primitive? proc)
                            (proc-obj-call-pat proc) code @SLOT_AUDIT@) result))))))
(let* ((count (read)) (expression (read)) (target-name (read)) (option (read)) (expected (read)))
  (ptree.begin! #f)
  (virtual.begin!)
  (select-target! target-name #f)
  (parse-program
   (list (expression->source expression #f)) (make-global-environment) "program"
   (lambda (lst env c-intf)
     (let* ((nodes (map (lambda (entry) (normalize-parse-tree (car entry) (cdr entry))) lst))
            (proc (compile-parsed-program "program" nodes env c-intf #f)))
       (parameterize ((print-extended-identifiers #t))
         (write (diagnostic-graph proc))
         (newline))))))
