;; Untimed assembler diagnostics; no benchmark loop or preset assembly result.
(define diagnostic-words '())
(define diagnostic-descriptions '())
(set! ofile-word
      (lambda (word)
        (set! diagnostic-words (cons (mod word 65536) diagnostic-words))))
(set! ofile-asm? #t)
(set! ofile-asm-bits? #f)
(set! ofile-asm-gvm? #f)
(set! ofile-stats? #f)
(set! *ofile-port2* (asm-open-output-file "diagnostic"))
(set! *ofile-pos* 0)
(set! ofile-syms (queue-empty))
(set! ofile-add-obj (lambda (object) #f))
(asm.begin!)
(for-each
 (lambda (fields)
   (case (car fields)
     ((word) (asm-word (cadr fields)))
     ((long) (asm-long (cadr fields)))
     ((label)
      (let* ((number (cadr fields))
             (description (and (pair? (cddr fields)) (caddr fields) (vector 0))))
        (if description
            (set! diagnostic-descriptions
                  (cons (cons number description) diagnostic-descriptions)))
        (asm-label number description)))
     ((align) (asm-align (cadr fields) (caddr fields)))
     ((branch) (asm-brel (cadr fields) (caddr fields)))
     ((word-relative) (asm-wrel (cadr fields) (caddr fields)))
     ((long-relative) (asm-lrel (cadr fields) (caddr fields) (cadddr fields)))
     ((text) (asm-comment (list (cadr fields))))
     ((global-reference) (asm-ref-glob (make-glob (string->symbol (cadr fields)))))
     ((global-assignment) (asm-set-glob (make-glob (string->symbol (cadr fields)))))
     ((global-jump) (asm-ref-glob-jump (make-glob (string->symbol (cadr fields)))))
     ((procedure-reference) (asm-proc-ref (cadr fields) (caddr fields)))
     ((primitive-reference) (asm-prim-ref (get-prim-info (cadr fields)) (caddr fields)))
     ((m68020) (asm-m68020-proc))
     ((m68881) (asm-m68881-proc))))
 (read))
(asm.end! #f)
(parameterize ((print-extended-identifiers #t))
  (write
   (list (asm-output-get)
         (reverse diagnostic-words)
         (map (lambda (entry) (list (car entry) (vector-ref (cdr entry) 0)))
              (reverse diagnostic-descriptions))))
  (newline))
