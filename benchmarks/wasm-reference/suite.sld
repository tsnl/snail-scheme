;; Correctness evidence for pinned Rust/WASI ports and independent Chez controls.
(define-library (wasm-reference suite)
  (export reference-suite-main pinned-sources reference-tools chez-source compile-chez-source
          reference-directory copy-file! copy-tree! reference-execute generated-files
          json-items text-position replace-text first-count-one)
  (import (scheme base) (scheme char) (scheme cxr) (scheme file) (scheme write)
          (scheme process-context) (chibi filesystem) (chibi pathname)
          (chibi crypto sha2) (chibi regexp) (only (chibi string) string-prefix? string-suffix? string-split string-trim) (srfi 1) (srfi 95)
          (only (srfi 130) string-contains string-cursor->index)
          (snail-tools process) (snail-tools native-build) (wasm-reference audit))
  (begin

    ;; ---- Pinned sources and retained process evidence ----

    (define revision "85f6acdc4cc4e2b857f307ba56bd0ba931dcccd1")
    (define (reference-directory root) (path-join root "benchmarks/wasm-reference"))
    (define (json-items object key) (vector->list (option-ref object key '#())))
    (define (text-position text fragment)
      (let ((cursor (string-contains text fragment))) (and cursor (string-cursor->index text cursor))))
    (define (replace-text text before after)
      (let ((offset (text-position text before)))
        (if offset (string-append (substring text 0 offset) after (substring text (+ offset (string-length before)))) text)))
    (define (copy-file! source output)
      (create-directory* (path-directory output))
      (run-command! (list (tool-name "CP" "cp") "--" source output)))
    (define (copy-tree! source output)
      (create-directory* output)
      (run-command! (list (tool-name "CP" "cp") "-a" "--" (string-append source "/.") output)))
    (define (lines text) (filter (lambda (line) (not (string=? "" line))) (string-split text #\newline)))
    (define (pinned-sources source)
      (let ((head (string-trim (run-command! (list "git" "-C" source "rev-parse" "HEAD")) char-whitespace?))
            (changes (run-command! (list "git" "-C" source "status" "--porcelain" "--untracked-files=no"))))
        (unless (and (string=? head revision) (string=? changes "")) (error "upstream must be clean and pinned" revision))
        (lines (run-command! (list "git" "-C" source "ls-files")))))
    (define (canonical-names source)
      (delete-duplicates
       (append-map (lambda (line)
                     (let ((match (regexp-search (rx bos (+ (or alpha numeric "_")) "_BENCHMARKS=\"" ($ (+ (~ (or #\$ #\" #\newline)))) "\"") line)))
                       (if match (string-split (regexp-match-submatch match 1) char-whitespace?) '())))
                   (lines (read-text (path-join source "bench"))))))
    (define (tool-path name)
      (string-trim (run-command! (list "sh" "-c" "command -v -- \"$1\"" "reference-tool" name)) char-whitespace?))
    (define (reference-tools)
      (map (lambda (spec)
             (let* ((path (tool-path (tool-name (cadr spec) (caddr spec))))
                    (record (run-command/capture (cons path (cdddr spec)) '((include-output-hex? . #f)))))
               (unless (zero? (option-ref record 'status 1)) (error "tool version failed" path record))
               (cons (car spec) `((path . ,path) (sha256 . ,(file-sha256 path))
                                  (version . ,(string-trim (string-append (option-ref record 'stdout "") (option-ref record 'stderr "")) char-whitespace?))))))
           '((rustc "RUSTC" "rustc" "--version" "--verbose") (cargo "CARGO" "cargo" "--version")
             (node "NODE" "node" "-p" "JSON.stringify(process.versions)") (chez "CHEZ" "scheme" "--version"))))
    (define (file-digests root paths)
      (map (lambda (path) (cons (string->symbol path) (file-sha256 (path-join root path)))) paths))
    (define (freeze-sources root source output files)
      (let* ((reference (reference-directory root)) (frozen (path-join output "reference-source")))
        (copy-tree! (path-join source "inputs") (path-join output "inputs"))
        (copy-tree! (path-join reference "src") (path-join frozen "src"))
        (copy-tree! (path-join reference "tests") (path-join frozen "tests"))
        (for-each (lambda (name) (copy-file! (path-join reference name) (path-join frozen name)))
                  '("Cargo.toml" "Cargo.lock" "run-wasi.mjs" "suite.scm" "suite.sld" "audit.sld" "compiler.sld" "small-inputs.json"))
        `((upstream . ,(file-digests source (filter (lambda (name) (or (string=? name "bench") (string-prefix? "src/" name) (string-prefix? "inputs/" name))) files)))
          (rust . ,(map (lambda (path) (cons (string->symbol (substring path (+ 1 (string-length frozen)))) (file-sha256 path)))
                        (sort (directory-files-recursive frozen) string<?))))))
    (define (generated-files directory)
      (let ((paths (append (if (file-directory? (path-join directory "outputs")) (directory-files-recursive (path-join directory "outputs")) '())
                           (filter file-regular? (map (lambda (name) (path-join directory name)) '("pltexchk.jnk" "xZfilhid.tex"))))))
        (map (lambda (path) (cons (string->symbol (substring path (+ 1 (string-length directory))))
                                  `((sha256 . ,(file-sha256 path)) (bytes . ,(file-size path))))) (sort paths string<?))))
    (define (reference-execute command directory input timeout logs)
      (let ((record (run-command/capture command `((directory . ,directory) (input . ,input) (timeout . ,timeout)
                                                   (log-directory . ,logs) (include-output-hex? . #f) (require-supervisor? . #t)))))
        (cons (cons 'returncode (option-ref record 'status #f)) (cons (cons 'files (generated-files directory)) record))))
    (define (execution-succeeded? run)
      (and (zero? (option-ref run 'returncode 1)) (option-ref run 'descendants_gone #f)
           (null? (json-items run 'unexpected_descendants))))
    (define (passed? run)
      (and (execution-succeeded? run) (text-position (option-ref run 'stdout "") "+!CSVLINE!+")
           (not (text-position (option-ref run 'stdout "") "INCORRECT"))))
    (define (wrong-answer-rejected? system run)
      ;; These frozen controls reject through their result predicate: Chez
      ;; prints INCORRECT; Rust assertions deliberately panic in the WASI guest.
      ;; A missing tool, deadline or abandoned descendant proves no rejection.
      (and (option-ref run 'descendants_gone #f) (not (option-ref run 'timeout #f))
           (eq? 'null (option-ref run 'signal 'null)) (null? (json-items run 'unexpected_descendants))
           (if (eq? system 'chez)
               (and (zero? (option-ref run 'returncode 1)) (text-position (option-ref run 'stdout "") ",INCORRECT"))
               (and (= 1 (option-ref run 'returncode 0))
                    (text-position (option-ref run 'stderr "") "panicked at")
                    (or (text-position (option-ref run 'stderr "") "assertion")
                        (text-position (option-ref run 'stderr "") "incorrect "))))))

    ;; ---- Independent original Chez controls ----

    (define (chez-source root name)
      (let* ((directory (path-join root "benchmarks/sfir" name)) (path (path-join directory "chez-original.scm"))
             (controls (option-ref (read-json (path-join directory "migration.json")) 'controls '())))
        (unless (string=? (file-sha256 path) (option-ref controls 'chez-original.scm ""))
          (error "authored Chez control differs from its provenance" name))
        (read-text path)))
    (define (compile-chez-source source artifact)
      (let ((script (string-append artifact ".compile.scm")))
        (call-with-output-file script
          (lambda (port)
            (write '(import (chezscheme)) port) (newline port)
            (write `(parameterize ((optimize-level 2)) (compile-program ,source ,artifact)) port)
            (newline port)))
        (let ((command (list (tool-name "CHEZ" "scheme") "--script" script))) (run-command! command) command)))
    (define (prepare-case root name output)
      (let* ((directory (path-join output "cases" name)) (artifact (path-join directory "program.wasm"))
             (source (path-join directory "program.scm")) (chez (path-join directory "program.so")))
        (create-directory* (path-join directory "outputs"))
        (unless (file-exists? (path-join directory "inputs")) (symbolic-link-file (path-join output "inputs") (path-join directory "inputs")))
        (copy-file! (path-join (reference-directory root) "target/wasm32-wasip1/release" (string-append name ".wasm")) artifact)
        (copy-file! (path-join output "inputs" (string-append name ".input")) (path-join directory "input.txt"))
        (write-text source (chez-source root name))
        (values directory (list (tool-name "NODE" "node") "--no-warnings" (path-join output "reference-source/run-wasi.mjs") artifact)
                (list (tool-name "CHEZ" "scheme") "--program" chez) (compile-chez-source source chez))))
    (define (write-fixture-files directory fixture)
      (for-each (lambda (entry) (write-text (path-join directory (symbol->string (car entry))) (cdr entry))) (option-ref fixture 'files '())))
    (define (fixture-directory directory fixture system)
      (if (not (option-ref fixture 'isolate_systems #f)) directory
          (let ((isolated (path-join directory (option-ref fixture 'name "fixture") (symbol->string system))))
            (create-directory* (path-join isolated "outputs"))
            (unless (file-exists? (path-join isolated "inputs")) (symbolic-link-file (path-join directory "inputs") (path-join isolated "inputs")))
            (write-fixture-files isolated fixture) isolated)))
    (define (audit-lines run)
      (map (lambda (line) (substring line 7)) (filter (lambda (line) (string-prefix? "Audit: " line)) (lines (option-ref run 'stdout "")))))
    (define (audit-errors fixture rust reference)
      (let ((audits (audit-lines rust)))
        (append
         (filter-map (lambda (text) (and (not (text-position (option-ref rust 'stdout "") text)) (string-append "incorrect complete Rust audit output: " text)))
                     (json-items fixture 'rust_stdout_contains))
         (append-map
          (lambda (spec)
            (let ((expected (option-ref fixture (car spec) #f)))
              (if (or (not expected)
                      (and (= 1 (length audits))
                           ((caddr spec) (car audits) (if (cadr spec) (read-text (path-join reference expected)) expected))))
                  '() (list (cadddr spec)))))
          (list (list 'rust_audit_alpha_equivalent #f alpha-equivalent? "complete residual programs differ beyond bound-variable alpha renaming")
                (list 'rust_nucleic_audit #t same-solutions? "complete nucleic solution identities/transforms differ")
                (list 'rust_exact_audit #t (lambda (a b) (equal? a (string-trim b char-whitespace?))) "complete untimed serialized result differs from original Chez oracle"))))))
    (define (file-errors fixture runs)
      (let ((rust (option-ref (cdar runs) 'files '())) (chez (option-ref (cdadr runs) 'files '())))
        (append (if (and (option-ref fixture 'compare_output_sets #f) (not (equal? rust chez))) '("complete generated file set or file contents differ") '())
                (filter-map (lambda (name) (and (not (and (assq (string->symbol name) rust) (assq (string->symbol name) chez)
                                                          (equal? (option-ref rust (string->symbol name) #f) (option-ref chez (string->symbol name) #f))))
                                                (string-append "file output differs: " name))) (json-items fixture 'compare_files))
                (filter-map (lambda (entry)
                              (and (any (lambda (files) (not (equal? (sha-256 (cdr entry)) (option-ref (option-ref files (car entry) '()) 'sha256 #f)))) (list rust chez))
                                   (string-append "incorrect complete file contents: " (symbol->string (car entry))))) (option-ref fixture 'expected_files '())))))
    (define (check-fixture fixture directory rust chez)
      (write-fixture-files directory fixture)
      (let* ((commands (list (cons 'rust-wasm (append rust (json-items fixture 'rust_arguments))) (cons 'chez chez)))
             (directories (map (lambda (entry) (cons (car entry) (fixture-directory directory fixture (car entry)))) commands))
             (execute (lambda (entry input) (reference-execute (cdr entry) (option-ref directories (car entry) #f) input 900 (path-join directory "logs"))))
             (runs (map (lambda (entry) (cons (car entry) (execute entry (option-ref fixture 'input "")))) commands))
             (wrong (option-ref fixture 'wrong #f))
             (rejected (if wrong (map (lambda (entry) (cons (car entry) (execute entry wrong))) commands) '()))
             (errors (append (filter-map (lambda (run) (and (not (passed? (cdr run))) (string-append (symbol->string (car run)) " failed its original predicate or target execution"))) runs)
                             (audit-errors fixture (option-ref runs 'rust-wasm '()) (path-join (path-directory (path-directory directory)) "reference-source"))
                             (file-errors fixture runs)
                             (if (every (lambda (run) (wrong-answer-rejected? (car run) (cdr run))) rejected) '()
                                 '("wrong-result probe did not reach its expected rejection")))))
        `((name . ,(option-ref fixture 'name "fixture")) (input_sha256 . ,(sha-256 (option-ref fixture 'input "")))
          (complete . ,(null? errors)) (errors . ,(list->vector errors)) (passed . ,runs) (wrong_result_rejected . ,rejected)
          (wrong_result_meaning . ,(option-ref fixture 'wrong_meaning (if wrong "deliberately wrong expected answer" 'null))))))

    ;; ---- Workload checks and command line ----

    (define (first-count-one input)
      (let ((match (regexp-search (rx bos ($ (* (or space (seq ";" (* (~ #\newline)) (? #\newline))))) (+ numeric)) input)))
        (if match (string-append (regexp-match-submatch match 1) "1" (substring input (regexp-match-submatch-end match 0))) input)))
    (define (canonical-fixture name checks input fixtures)
      (let ((fixture `((name . ,(string-append checks "-canonical")) (input . ,(if (and (string=? checks "quick") (not (string=? name "equal"))) (first-count-one input) input)))))
        (when (string=? checks "full")
          (for-each (lambda (audit)
                      (when (option-ref audit 'canonical_audit #f)
                        (when (assq 'input audit) (error "canonical audit cannot replace upstream input" name))
                        (set! fixture (append (filter (lambda (entry) (not (memq (car entry) '(name canonical_audit)))) audit) fixture)))) fixtures))
        (append (cond ((string=? name "slatex") '((isolate_systems . #t) (compare_output_sets . #t)))
                      ((member name '("cat" "tail" "ray")) `((compare_files . ,(vector (string-append "outputs/" name ".output"))))) (else '())) fixture)))
    (define (check-case root name output checks fixtures)
      (let-values (((directory rust chez compilation) (prepare-case root name output)))
        (let* ((selected (filter (lambda (fixture) (not (option-ref fixture 'canonical_audit #f))) fixtures))
               (selected (if (string=? checks "small") selected
                             (append selected (list (canonical-fixture name checks (read-text (path-join directory "input.txt")) fixtures)))))
               (records (map (lambda (fixture) (check-fixture fixture directory rust chez)) selected)))
          `((benchmark . ,name) (input_sha256 . ,(file-sha256 (path-join directory "input.txt")))
            (wasm_sha256 . ,(file-sha256 (path-join directory "program.wasm"))) (wasm_bytes . ,(file-size (path-join directory "program.wasm")))
            (chez_sha256 . ,(file-sha256 (path-join directory "program.so"))) (chez_source_sha256 . ,(file-sha256 (path-join directory "program.scm")))
            (chez_compilation . ,(list->vector compilation)) (checks . ,(list->vector records))
            (complete . ,(and (pair? records) (every (lambda (record) (option-ref record 'complete #f)) records)))))))
    (define (suite-options root arguments)
      (let loop ((arguments arguments) (options `((source . ,(path-join root "benchmarks/r7rs-benchmarks")) (checks . "small") (benchmarks . ("all")))))
        (cond ((null? arguments) options)
              ((string=? (car arguments) "--build") (loop (cdr arguments) (cons '(build . #t) options)))
              ((string=? (car arguments) "--benchmarks")
               (let-values (((names remaining) (span (lambda (word) (not (string-prefix? "--" word))) (cdr arguments))))
                 (unless (pair? names) (error "--benchmarks requires workloads"))
                 (loop remaining (cons (cons 'benchmarks names) options))))
              ((and (member (car arguments) '("--source" "--output" "--checks")) (pair? (cdr arguments)))
               (loop (cddr arguments) (cons (cons (string->symbol (substring (car arguments) 2)) (cadr arguments)) options)))
              (else (error "usage: suite.scm --output DIR [--source DIR] [--benchmarks NAME ...] [--checks small|quick|full] [--build]")))))
    (define (reference-workloads root source requested)
      (let* ((available (canonical-names source))
             (implemented (filter (lambda (name) (file-exists? (path-join (reference-directory root) "src/bin" (string-append name ".rs")))) available))
             (names (if (equal? requested '("all")) implemented requested)))
        (unless (and (= (length names) (length (delete-duplicates names))) (every (lambda (name) (member name implemented)) names))
          (error "choose distinct implemented workloads" implemented))
        (values available implemented names)))
    (define (reference-report root source output files checks available implemented)
      `((kind . "functional-validation") (performance_samples . #f) (checks . ,checks) (upstream_revision . ,revision)
        (revision . ,(string-trim (run-command! (list "git" "-C" root "rev-parse" "HEAD")) char-whitespace?))
        (inventory . ((canonical . ,(list->vector available)) (implemented . ,(list->vector implemented))
                      (remaining . ,(list->vector (filter (lambda (name) (not (member name implemented))) available)))))
        (tools . ,(reference-tools)) (sources . ,(freeze-sources root source output files))))
    (define (check-selected-cases root output checks names report)
      (let ((fixtures (read-json (path-join (reference-directory root) "small-inputs.json")))
            (filename (path-join output "validation.json")) (records '()))
        (for-each (lambda (name)
                    (let ((record (check-case root name output checks (json-items fixtures (string->symbol name)))))
                      (set! records (append records (list record)))
                      (write-json filename (cons (cons 'cases (list->vector records)) report))
                      (display (string-append "checked " name " (" checks "): " (if (option-ref record 'complete #f) "passed\n" "FAILED; retained diagnostics\n")))
                      (flush-output-port))) names)
        (let ((complete (every (lambda (record) (option-ref record 'complete #f)) records)))
          (write-json filename (append `((complete . ,complete) (cases . ,(list->vector records))) report))
          (if complete 0 1))))
    (define (reference-suite-main root arguments)
      (let* ((options (suite-options root arguments)) (source (absolute-path (option-ref options 'source #f)))
             (output-option (option-ref options 'output #f)) (checks (option-ref options 'checks "small")))
        (unless output-option (error "--output is required"))
        (unless (member checks '("small" "quick" "full")) (error "checks must be small, quick or full"))
        (let ((output (absolute-path output-option)) (files (pinned-sources source)))
          (create-directory* output)
          (let-values (((available implemented names) (reference-workloads root source (option-ref options 'benchmarks '("all")))))
            (parameterize ((current-process-supervisor (ensure-native-supervisor root)) (current-command-records '())
                           (current-command-log (path-join output "commands.json")))
              (when (option-ref options 'build #f)
                (run-command! (list (tool-name "CARGO" "cargo") "build" "--offline" "--release" "--target" "wasm32-wasip1"
                                    "--manifest-path" (path-join (reference-directory root) "Cargo.toml"))))
              (check-selected-cases root output checks names (reference-report root source output files checks available implemented))))))))

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-reference-suite)
    (import (snail-scheme test-utils))
    (begin
      (define (test-generated-file-snapshots)
        (let* ((directory (make-build-directory "/tmp" "reference-files-test-"))
               (first (path-join directory "outputs/z0.tex")) (second (path-join directory "outputs/z1.tex")))
          (dynamic-wind
              (lambda () (create-directory* (path-join directory "outputs")))
              (lambda ()
                (write-text first "complete first fragment\n") (write-text second "complete second fragment\n")
                (let ((original (generated-files directory)))
                  (expect (map car original) '(outputs/z0.tex outputs/z1.tex))
                  (expect (generated-files directory) original)
                  (write-text second "complete second fragmenX\n") (expect (equal? (generated-files directory) original) #f)
                  (delete-file second) (expect (equal? (generated-files directory) original) #f)
                  (write-text second "complete second fragment\n") (write-text (path-join directory "outputs/z2.tex") "unexpected third fragment\n")
                  (expect (equal? (generated-files directory) original) #f))
                (write-text (path-join directory "pltexchk.jnk") "junk\n")
                (expect (option-ref (generated-files directory) 'pltexchk.jnk #f) `((sha256 . ,(sha-256 "junk\n")) (bytes . 5)))
                (expect (first-count-one "; count\n  2000\ninput\n") "; count\n  1\ninput\n"))
              (lambda () (delete-file-hierarchy directory)))))
      (define (test-negative-evidence)
        (let ((base '((descendants_gone . #t) (unexpected_descendants . #()) (signal . null) (timeout . #f))))
          (expect (and (wrong-answer-rejected? 'chez (append '((returncode . 0) (stdout . "+!CSVLINE!+chez,fib,INCORRECT")) base)) #t) #t)
          (expect (and (wrong-answer-rejected? 'rust-wasm (append '((returncode . 1) (stderr . "panicked at source: assertion `left == right` failed")) base)) #t) #t)
          (expect (wrong-answer-rejected? 'rust-wasm (append '((returncode . 127) (stderr . "not found")) base)) #f)
          (expect (wrong-answer-rejected? 'rust-wasm (append '((returncode . 1) (stderr . "RuntimeError: unreachable")) base)) #f)
          (expect (wrong-answer-rejected? 'rust-wasm (append '((returncode . 1) (timeout . #t) (stderr . "panicked at source: assertion failed")) base)) #f))
        (expect (file-errors '((compare_files . #("outputs/missing"))) '((rust-wasm (files)) (chez (files))))
                '("file output differs: outputs/missing")))
      (define (test-reference-suite)
        (run-test test-generated-file-snapshots) (run-test test-negative-evidence))))
   (else)))
