;; Independent full-payload predicates and separate Wasm allocation diagnostics.
(define-library (string-reference-controls checks)
  (export controls-main allocation-main)
  (import (scheme base) (scheme char) (scheme cxr) (scheme file) (scheme inexact)
          (scheme read) (scheme write) (scheme process-context) (srfi 1)
          (only (srfi 130) string-contains string-cursor->index)
          (only (chibi string) string-split string-join string-prefix? string-suffix? string-trim string-trim-right)
          (except (chibi filesystem) file-exists?) (wasm-native json)
          (wasm-native process) (wasm-native native-build) (sfir runner) (sfir support))
  (begin

    ;; ---- Fixed contracts and retained commands ----

    (define modes '(("byte" "string-byte-four-buffer" 1 #f) ("u32" "string-u32-four-buffer" 4 #f)
                    ("byte-zeroed" "string-byte-zeroed" 1 #t) ("u32-zeroed" "string-u32-zeroed" 4 #t)))
    (define edges '((0 6) (5 6) (6 22) (21 22) (22 54) (30 54)))
    (define sequence-number (make-parameter 0))
    (define (trim text) (string-trim text char-whitespace?))
    (define (control-path . parts) (apply path-join (benchmark-root) "benchmarks/string-reference-controls" parts))
    (define (tool-path name default) (trim (run-command! (list "which" (tool-name name default)))))
    (define (execute label command directory source)
      (sequence-number (+ 1 (sequence-number)))
      (record-command directory (string-append label "-" (number->string (sequence-number))) command '() directory 60 source))
    (define (require-check condition message . details)
      (unless condition (apply error message details)))

    (define (predicate-passed? run case)
      (guard (failure (else #f))
        (let ((rows (filter (lambda (line) (string-prefix? "+!CSVLINE!+" line)) (string-split (field run 'stdout "") #\newline))))
          (and (succeeded? run) (= 1 (length rows))
               (not (text-contains? (string-append (field run 'stdout "") (field run 'stderr "")) "INCORRECT"))
               (let* ((parts (string-split (substring (car rows) 11) #\,)) (seconds (and (= 3 (length parts)) (string->number (caddr parts)))))
                 (and seconds (member (car parts) '("rust-wasm" "chez")) (string=? case (cadr parts))
                      (real? seconds) (finite? seconds) (>= seconds 0)))))))

    ;; ---- Independent complete payload oracle ----

    (define (scalar-vector text) (list->vector (map char->integer (string->list text))))
    (define (payload-oracle threshold)
      (let loop ((current "abcdef"))
        (if (<= (string-length current) threshold) (loop (string-append "56" current "789123" current "45"))
            `((first . ,(scalar-vector "123abcdef456abcdef789")) (back . ,(scalar-vector "56abcdef789"))
              (front . ,(scalar-vector "123abcdef45")) (final . ,(scalar-vector "56abcdef789123abcdef45"))
              (trial . ,(scalar-vector current))))))

    (define (complete-audit? run threshold)
      (guard (failure (else #f))
        (let ((rows (filter (lambda (line) (string-prefix? "Audit: " line)) (string-split (field run 'stdout "") #\newline))))
          (and (= 1 (length rows))
               (let ((actual (string->json (substring (car rows) 7))) (expected (payload-oracle threshold)))
                 (and (= (length actual) (length expected))
                      (every (lambda (entry) (equal? (field actual (car entry)) (cdr entry))) expected)))))))

    (define (case-input threshold expected)
      (string-append "2\n" (number->string threshold) "\n" (number->string expected) "\n"))

    (define (check-small command directory name edge)
      (let ((run (execute "small" (append command '("--audit")) directory (case-input (car edge) (cadr edge)))))
        (require-check (and (predicate-passed? run (string-append name ":2")) (complete-audit? run (car edge))) "complete small String predicate failed" run)
        `((threshold . ,(car edge)) (expected_length . ,(cadr edge)) (complete . #t) (run . ,run))))

    (define (check-wrong command directory name)
      (let ((run (execute "wrong" command directory "2\n30\n999\n")))
        (require-check (not (predicate-passed? run (string-append name ":2"))) "wrong String answer was accepted" run)
        run))

    (define (check-control row output node)
      (let* ((command (list node "--no-warnings" (path-join output "run-wasi.mjs") (path-join output "program.wasm") (car row)))
             (full (execute "full" (append command '("--audit")) output (read-text (path-join output "input.txt")))))
        (require-check (and (predicate-passed? full (string-append (cadr row) ":100")) (complete-audit? full 500000)) "full String predicate failed" full)
        `((name . ,(cadr row)) (mode . ,(car row)) (complete . #t) (full_original_count . ,full)
          (full_payload_audit . "One additional trial after the timer; not the last timed output")
          (small_complete_payloads . ,(list->vector (map (lambda (edge) (check-small command output (cadr row) edge)) edges)))
          (wrong_result_rejected . ,(check-wrong command output (cadr row))))))

    ;; ---- Compile the retained original Chez source with the selected tool ----

    (define (compile-chez-file source artifact output scheme)
      (let ((script (string-append source ".compile.scm")) (port (open-output-string)))
        (display "(import (chezscheme))\n(parameterize ((optimize-level 2)) (compile-program " port)
        (write source port) (display " " port) (write artifact port) (display "))\n" port)
        (write-text script (get-output-string port))
        (require-check (succeeded? (execute "chez-compile" (list scheme "--script" script) output "")) "Chez control failed to compile")))

    (define (prepare-chez output scheme)
      (let ((source (path-join (benchmark-root) "benchmarks/sfir/string/chez-original.scm")))
        (copy-file source (path-join output "program.scm"))
        (copy-file (path-join (benchmark-root) "benchmarks/sfir/string/input.txt") (path-join output "input.txt"))
        (compile-chez-file (path-join output "program.scm") (path-join output "program.so") output scheme)
        `((source . ,source) (source_sha256 . ,(file-sha256 source)) (artifact_sha256 . ,(file-sha256 (path-join output "program.so"))))))

    (define (check-chez output scheme)
      (let* ((command (list scheme "--program" (path-join output "program.so")))
             (full (execute "chez-full" command output (read-text (path-join output "input.txt"))))
             (small (map (lambda (edge)
                           (let ((run (execute "chez-small" command output (case-input (car edge) (cadr edge)))))
                             (require-check (predicate-passed? run (string-append "string:" (number->string (car edge)) ":2")) "Chez small String predicate failed" run)
                             run)) edges)))
        (require-check (predicate-passed? full "string:500000:100") "Chez full String predicate failed" full)
        `((full_original_count . ,full) (small . ,(list->vector small)) (wrong_result_rejected . ,(check-wrong command output "string:30")))))

    (define (complete-chez-oracle output scheme)
      (let* ((original (read-text (path-join output "program.scm"))) (invocation "(run-benchmark)\n")
             (source (path-join output "complete-oracle.scm")) (artifact (path-join output "complete-oracle.so")))
        (require-check (string-suffix? invocation original) "original control must end with run-benchmark")
        (write-text source (string-append (substring original 0 (- (string-length original) (string-length invocation)))
                                          "(set! s \"abcdef\")\n(grow)\n(write s)\n(newline)\n(for-each (lambda (n) (set! s \"abcdef\") (trial n) (write s) (newline)) '(0 5 6 21 22 30 500000))\n"))
        (compile-chez-file source artifact output scheme)
        (let* ((run (execute "chez-oracle" (list scheme "--program" artifact) output ""))
               (values (read-values (field run 'stdout)))
               (expected (cons (field (payload-oracle 0) 'final) (map (lambda (n) (field (payload-oracle n) 'trial)) '(0 5 6 21 22 30 500000)))))
          (require-check (and (succeeded? run) (equal? (map scalar-vector values) expected)) "Chez complete payload oracle differs" run)
          `((run . ,run) (source_sha256 . ,(file-sha256 source)) (artifact_sha256 . ,(file-sha256 artifact))
            (scope . "Original grow/trial bodies; only final run-benchmark invocation replaced by untimed observations")))))

    (define (read-values text)
      (let ((port (open-input-string text)))
        (let loop ((values '())) (let ((value (read port))) (if (eof-object? value) (reverse values) (loop (cons value values)))))))

    ;; ---- Reversible instrumentation of selected optimized Wasm functions ----

    (define (substring-index text part . offset)
      (let ((cursor (apply string-contains text part offset)))
        (and cursor (string-cursor->index text cursor))))

    (define (replace-all text from to)
      (let loop ((offset 0) (parts '()))
        (let ((index (substring-index text from offset)))
          (if index (loop (+ index (string-length from)) (cons to (cons (substring text offset index) parts)))
              (apply string-append (reverse (cons (substring text offset) parts)))))))

    (define (occurrences text part)
      (let loop ((offset 0) (count 0))
        (let ((index (substring-index text part offset)))
          (if index (loop (+ index (string-length part)) (+ count 1)) count))))

    (define (function-spans text)
      (let* ((lines (list->vector (string-split text #\newline)))
             (starts (filter (lambda (i) (string-prefix? " (func " (vector-ref lines i))) (iota (vector-length lines))))
             (ends (append (cdr starts) (list (- (vector-length lines) 2)))))
        (values lines (map cons starts ends))))

    (define (instrument-trials text)
      (let-values (((lines spans) (function-spans text)))
        (let ((selected '()))
          (for-each
           (lambda (span)
             (when (text-contains? (vector-ref lines (car span)) "string_reference_controls11trial_")
               (let ((body (string-join (map (lambda (i) (vector-ref lines i)) (iota (- (cdr span) (car span)) (car span))) "\n")))
                 (require-check (= 5 (+ (occurrences body "(call $malloc") (occurrences body "(call $calloc"))) "trial allocation shape changed" (vector-ref lines (car span))))
               (set! selected (cons (trim (vector-ref lines (car span))) selected))
               (for-each (lambda (i) (vector-set! lines i (replace-all (replace-all (vector-ref lines i) "(call $malloc" "(call $control_malloc") "(call $calloc" "(call $control_calloc")))
                         (iota (- (cdr span) (car span)) (car span))))) spans)
          (require-check (= 4 (length selected)) "expected exactly four specialized trial functions" selected)
          (values (string-join (vector->list lines) "\n") (reverse selected)))))

    (define (instrument-calloc text fill)
      (let-values (((lines spans) (function-spans text)))
        (let* ((span (find (lambda (span) (string-prefix? " (func $calloc " (vector-ref lines (car span)))) spans))
               (body (and span (string-append (string-join (map (lambda (i) (vector-ref lines i)) (iota (- (cdr span) (car span)) (car span))) "\n") "\n"))))
          (require-check (and body (= 1 (occurrences body "   (memory.fill\n")) (text-contains? body "(local.get $2)")) "calloc fill shape changed")
          (replace-all text body (replace-all body "   (memory.fill\n" (string-append fill "   (memory.fill\n"))))))

    (define (instrument text)
      (let-values (((trials selected) (instrument-trials text)))
        (let* ((globals (read-text (control-path "tests/allocation-globals.wat")))
               (wrappers (read-text (control-path "tests/allocation-wrappers.wat")))
               (fill (read-text (control-path "tests/allocation-fill.wat"))) (changed (instrument-calloc trials fill))
               (first (substring-index changed "\n (func ")))
          (require-check (and first (or (string-prefix? "(module " changed) (string-prefix? "(module\n" changed))
                              (string-suffix? ")" (string-trim-right changed char-whitespace?))) "unexpected Wasm module shape")
          (set! changed (string-append (substring changed 0 (+ first 1)) globals (substring changed (+ first 1))))
          (let ((end (- (string-length (string-trim-right changed char-whitespace?)) 1)))
            (set! changed (string-append (substring changed 0 end) wrappers (substring changed end))))
          (let ((restored (replace-all (replace-all (replace-all changed globals "") wrappers "") fill "")))
            (set! restored (replace-all (replace-all restored "(call $control_malloc" "(call $malloc") "(call $control_calloc" "(call $calloc"))
            (require-check (string=? restored text) "counter removal must recover exact original optimized Wasm"))
          (values changed selected))))

    (define (assemble executable source artifact output)
      (require-check (succeeded? (execute "assemble" (append (list executable source)
                                                             '("--enable-mutable-globals" "--enable-sign-ext" "--enable-bulk-memory" "--enable-nontrapping-float-to-int"
                                                               "--enable-reference-types" "--enable-multivalue" "--enable-extended-const") (list "-o" artifact)) output ""))
                     "Wasm diagnostic assembly failed" source))

    (define (run-probe node host artifact mode output source)
      (let* ((run (execute "probe" (list node "--no-warnings" host artifact mode) output source))
             (rows (filter (lambda (line) (string-prefix? "Resource: " line)) (string-split (field run 'stderr "") #\newline))))
        (require-check (and (succeeded? run) (text-contains? (field run 'stdout) "Result: 524278\n")
                            (not (text-contains? (string-append (field run 'stdout) (field run 'stderr)) "INCORRECT")) (= 1 (length rows))) "resource probe failed" run)
        (fields-with run (cons 'resource (string->json (substring (car rows) 10))))))

    (define (check-counters run width zeroed?)
      (let ((actual (field (field run 'resource) 'counterValues))
            (expected `((control_allocation_calls . 61000) (control_requested_bytes . ,(* 3145173000 width))
                        (control_zero_fill_calls . ,(if zeroed? 61000 0)) (control_zero_fill_bytes . ,(if zeroed? (* 3145173000 width) 0)))))
        (require-check (and (= (length actual) (length expected))
                            (every (lambda (entry) (let ((value (field actual (car entry))))
                                                     (= (if (string? value) (string->number value) value) (cdr entry)))) expected))
                       "reached allocation counters differ" actual expected)))

    ;; ---- CLI entry points preserve artifacts and every subprocess record ----

    (define (arguments values allowed)
      (let loop ((values values) (result '()))
        (cond ((null? values) result)
              ((and (pair? (cdr values)) (member (car values) allowed))
               (loop (cddr values) (cons (cons (string->symbol (substring (car values) 2)) (absolute-path (cadr values))) result)))
              (else (error "unknown or incomplete control option" values)))))

    (define (fresh-output path)
      (when (file-exists? path) (error "control output must be fresh" path))
      (create-directory* path)
      (current-process-supervisor (ensure-native-supervisor (runtime-project-directory (benchmark-root)))))

    (define (controls-main values)
      (let* ((options (arguments values '("--artifact" "--output"))) (output (field options 'output))
             (node (tool-path "NODE" "node")) (scheme (tool-path "CHEZ" "scheme")))
        (fresh-output output)
        (copy-file (field options 'artifact) (path-join output "program.wasm"))
        (copy-file (path-join (benchmark-root) "benchmarks/wasm-reference/run-wasi.mjs") (path-join output "run-wasi.mjs"))
        (for-each (lambda (name) (copy-file (control-path name) (path-join output "control-source" name)))
                  '("Cargo.toml" "Cargo.lock" "src/main.rs" "checks.sld" "tests/check-controls.scm"))
        (check-oracle-rejection)
        (let ((chez (prepare-chez output scheme)))
          (write-json (path-join output "validation.json")
                      `((kind . "String control correctness; no performance samples") (performance_samples . #f) (canonical57_modified . #f)
                        (tools . ((node . ((path . ,node) (sha256 . ,(file-sha256 node)))) (chez . ((path . ,scheme) (sha256 . ,(file-sha256 scheme))))))
                        (chez_build . ,chez) (wasm_sha256 . ,(file-sha256 (path-join output "program.wasm"))) (input_sha256 . ,(file-sha256 (path-join output "input.txt")))
                        (host_sha256 . ,(file-sha256 (path-join output "run-wasi.mjs"))) (controls . ,(list->vector (map (lambda (row) (check-control row output node)) modes)))
                        (original_chez . ,(check-chez output scheme)) (original_complete_payload_oracle . ,(complete-chez-oracle output scheme)) (complete . #t))))
        (display "All four String controls passed complete payload and wrong-result checks.\n") 0))

    (define (allocation-main values)
      (let* ((options (arguments values '("--wat" "--input" "--output"))) (output (field options 'output))
             (original (read-text (field options 'wat))) (source (read-text (field options 'input)))
             (wasm-as (tool-path "WASM_AS" "wasm-as")) (node (tool-path "NODE" "node"))
             (host (control-path "tests/resource-wasi.mjs")))
        (fresh-output output)
        (require-check (string=? source "100\n500000\n524278\n") "allocation probe needs full canonical input")
        (let-values (((changed selected) (instrument original)))
          (write-text (path-join output "original.wat") original) (write-text (path-join output "instrumented.wat") changed)
          (assemble wasm-as (path-join output "original.wat") (path-join output "reassembled.wasm") output)
          (assemble wasm-as (path-join output "instrumented.wat") (path-join output "instrumented.wasm") output)
          (let* ((reassembled (map (lambda (row) (run-probe node host (path-join output "reassembled.wasm") (car row) output source)) modes))
                 (instrumented (map (lambda (row) (let ((run (run-probe node host (path-join output "instrumented.wasm") (car row) output source)))
                                                    (check-counters run (caddr row) (cadddr row)) run)) modes)))
            (write-json (path-join output "probe.json")
                        `((kind . "Separate selected-allocation and logical zero-fill diagnostic") (performance_samples . #f)
                          (input_sha256 . ,(file-sha256 (field options 'input))) (original_wat_sha256 . ,(file-sha256 (path-join output "original.wat")))
                          (host_sha256 . ,(file-sha256 host)) (wasm_as_sha256 . ,(file-sha256 wasm-as))
                          (reassembled_wasm_sha256 . ,(file-sha256 (path-join output "reassembled.wasm"))) (instrumented_wasm_sha256 . ,(file-sha256 (path-join output "instrumented.wasm")))
                          (exact_wat_restored_after_removing_instrumentation . #t) (selected_functions . ,(list->vector selected))
                          (reassembled_gate . ,(list->vector reassembled)) (instrumented . ,(list->vector instrumented))
                          (counter_scope . "Selected trial allocator calls including seeds; startup excluded. Zero counters run only on reached selected calloc memory.fill.")
                          (limits . "Logical requested bytes and reached memory.fill lengths; not physical traffic, residency or clean elapsed performance.") (complete . #t)))))
        (display "Four reassembled and instrumented controls passed exact allocation counters.\n") 0))

    ;; ---- Independent rejection checks ----

    (define (audit-output value) `((stdout . ,(string-append "Audit: " (json->string value)))))
    (define (check-oracle-rejection)
      (let ((good (payload-oracle 30)))
        (require-check (complete-audit? (audit-output good) 30) "complete oracle must accept its reference")
        (for-each (lambda (entry)
                    (let* ((value (vector-copy (cdr entry))) (index (quotient (vector-length value) 2)))
                      (vector-set! value index (+ 1 (vector-ref value index)))
                      (require-check (not (complete-audit? (audit-output (fields-with good (cons (car entry) value))) 30)) "interior corruption accepted"))) good)
        (for-each (lambda (name)
                    (let ((value (field good name)))
                      (require-check (not (complete-audit? (audit-output (fields-with good (cons name (vector-copy value 0 (- (vector-length value) 1))))) 30)) "truncation accepted")))
                  '(back front trial))))
    )

  ;; ---- Tests ----

  (cond-expand
   (snail-tests
    (export test-string-controls)
    (begin (define (test-string-controls) (check-oracle-rejection))))))
