;;; Compute digits of PI using a straightforward implementation of
;;; the Chudnovsky brothers algorithm; see
;;; http://www.craig-wood.com/nick/articles/pi-chudnovsky/



(define ch-A (integer-from-i64 13591409))
(define ch-B (integer-from-i64 545140134))
(define ch-C (integer-from-i64 640320))
(define ch-C^3 (expt (integer-from-i64 640320) (integer-from-i64 3)))
(define ch-D (integer-from-i64 12))

(define (ch-split a b)
  (if (integer=? (integer-from-i64 1) (integer-subtract b a))
      (let ((g (integer-multiply (integer-multiply (integer-subtract (integer-multiply (integer-from-i64 6) b) (integer-from-i64 5)) (integer-subtract (integer-multiply (integer-from-i64 2) b) (integer-from-i64 1))) (integer-subtract (integer-multiply (integer-from-i64 6) b) (integer-from-i64 1)))))
        (list g
              (integer-quotient (integer-multiply ch-C^3 (expt b (integer-from-i64 3))) (integer-from-i64 24))
              (integer-multiply (integer-multiply (expt (integer-from-i64 -1) b) g) (integer-add (integer-multiply b ch-B) ch-A))))
      (let* ((mid (integer-quotient (integer-add a b) (integer-from-i64 2)))
             (gpq1 (ch-split a mid))
             (gpq2 (ch-split mid b))
             (g1 (car gpq1)) (p1 (cadr gpq1)) (q1 (caddr gpq1))
             (g2 (car gpq2)) (p2 (cadr gpq2)) (q2 (caddr gpq2)))
        (list (integer-multiply g1 g2)
              (integer-multiply p1 p2)
              (integer-add (integer-multiply q1 p2) (integer-multiply q2 g1))))))



(define (pi digits)
  (let* ((num-terms (term-count digits))
         (sqrt-C (integer-sqrt (integer-multiply ch-C (expt (integer-from-i64 100) digits)))))
    (let* ((gpq (ch-split (integer-from-i64 0) num-terms))
           (g (car gpq)) (p (cadr gpq)) (q (caddr gpq)))
      (integer-quotient (integer-multiply (integer-multiply p ch-C) sqrt-C) (integer-multiply ch-D (integer-add q (integer-multiply p ch-A)))))))

(define (pies n m s)
  (if (< m n)
      '()
      (cons (pi n)
            (pies (+ n s) m s))))

(define (hide r x)
