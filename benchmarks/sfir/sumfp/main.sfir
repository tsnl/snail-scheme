;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir base))

(def cddr (lambda (xs.2) (cdr (cdr xs.2))))

(def length
  (lambda (xs)
    (((lambda () (begin (def loop.2 (lambda (xs.1 n.1) (if (null? xs.1) n.1 (loop.2 (cdr xs.1) (+ n.1 (ann 1 I64)))))) loop.2)))
      xs
      (ann 0 I64))))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(def hide (lambda (count.1 x) (hide-f64 x)))

(def run
  (lambda (n)
    (((lambda () (begin (def loop.1 (lambda (i.1 sum) (if (f64-lt i.1 0.0) sum (loop.1 (f64-sub i.1 1.0) (f64-add i.1 sum))))) loop.1)))
      n
      0.0)))

(def input0 (native-input-f64 (ann 0 I32)))

(def bench (-> I64 F64)
  (lambda (count)
    (((lambda () (begin (def loop (lambda (i result) (if (< i count) (loop (+ i (ann 1 I64)) (run (hide count input0))) result))) loop)))
      (ann 0 I64)
      0.0)))

(unit)
