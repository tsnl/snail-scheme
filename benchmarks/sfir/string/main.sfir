;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir base))

(def cddr (lambda (xs.2) (cdr (cdr xs.2))))

(def length
  (lambda (xs)
    (((lambda () (begin (def loop.3 (lambda (xs.1 n.2) (if (null? xs.1) n.2 (loop.3 (cdr xs.1) (+ n.2 (ann 1 I64)))))) loop.3)))
      xs
      (ann 0 I64))))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(def hide (lambda (count.1 x) (hide-i64 x)))

(def s (ref "abcdef"))

(def grow
  (lambda ()
    (begin
      (ref-set! s (string-append "123" (ref-get s) "456" (ref-get s) "789"))
      (ref-set!
        s
        (string-append
          (substring
            (ref-get s)
            (quotient (string-length (ref-get s)) (ann 2 I64))
            (string-length (ref-get s)))
          (substring (ref-get s) (ann 0 I64) (+ (ann 1 I64) (quotient (string-length (ref-get s)) (ann 2 I64))))))
      (ref-get s))))

(def trial
  (lambda (n.1)
    (((lambda () (begin (def loop.2 (lambda (i.2) (if (> (string-length (ref-get s)) n.1) (string-length (ref-get s)) (begin (grow) (loop.2 (+ i.2 (ann 1 I64))))))) loop.2)))
      (ann 0 I64))))

(def my-try
  (lambda (n)
    (((lambda () (begin (def loop.1 (lambda (i.1) (if (>= i.1 (ann 10 I64)) (string-length (ref-get s)) (begin (ref-set! s "abcdef") (trial n) (loop.1 (+ i.1 (ann 1 I64))))))) loop.1)))
      (ann 0 I64))))

(def input0 (native-input-i64 (ann 0 I32)))

(def input1 (native-input-i64 (ann 1 I32)))

(def input2 (native-input-i64 (ann 2 I32)))

(def bench (-> I64 I64)
  (lambda (count)
    (((lambda () (begin (def loop (lambda (i result) (if (< i count) (loop (+ i (ann 1 I64)) (my-try (hide count input0))) (if (if (= i (ann 0 I64)) (= input1 (ann 0 I64)) (if (= input1 (ann 2 I64)) (= result input2) #f)) (ann 1 I64) (ann 0 I64))))) loop)))
      (ann 0 I64)
      (ann 0 I64))))

(unit)
