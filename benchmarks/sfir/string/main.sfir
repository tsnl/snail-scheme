;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir core))

(define cddr (lambda (xs.2) (cdr (cdr xs.2))))

(define length
  (lambda (xs)
    (((lambda () (begin (define loop.3 (lambda (xs.1 n.2) (if (null? xs.1) n.2 (loop.3 (cdr xs.1) (+ n.2 1))))) loop.3)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(define hide (lambda (count.1 x) (hide-i64 x)))

(define s (ref "abcdef"))

(define grow
  (lambda ()
    (begin
      (ref-set! s (string-append "123" (ref-get s) "456" (ref-get s) "789"))
      (ref-set!
        s
        (string-append
          (substring
            (ref-get s)
            (quotient (string-length (ref-get s)) 2)
            (string-length (ref-get s)))
          (substring (ref-get s) 0 (+ 1 (quotient (string-length (ref-get s)) 2)))))
      (ref-get s))))

(define trial
  (lambda (n.1)
    (((lambda () (begin (define loop.2 (lambda (i.2) (if (> (string-length (ref-get s)) n.1) (string-length (ref-get s)) (begin (grow) (loop.2 (+ i.2 1)))))) loop.2)))
      0)))

(define my-try
  (lambda (n)
    (((lambda () (begin (define loop.1 (lambda (i.1) (if (>= i.1 10) (string-length (ref-get s)) (begin (ref-set! s "abcdef") (trial n) (loop.1 (+ i.1 1)))))) loop.1)))
      0)))

(define input0 (native-input-i64 (ann 0 I32)))

(define input1 (native-input-i64 (ann 1 I32)))

(define input2 (native-input-i64 (ann 2 I32)))

(define bench (-> I64 I64)
  (lambda (count)
    (((lambda () (begin (define loop (lambda (i result) (if (< i count) (loop (+ i 1) (my-try (hide count input0))) (if (if (= i 0) (= input1 0) (if (= input1 2) (= result input2) #f)) 1 0)))) loop)))
      0
      0)))

(unit)
