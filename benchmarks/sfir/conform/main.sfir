          (if ((lambda (value.4) (if value.4 value.4 (none-node? node2))) (none-node? node1))
            none-node
            ((lambda (result.2) (if (present? result.2) (optional-value result.2) (if (conforms? node1 node2) node1 (if (conforms? node2 node1) node2 ((lambda (result.1) (begin (add-graph-nodes! graph.1 result.1) (insert! (already-joined graph.1) node1 node2 result.1) (set-blue-edges! result.1 (conform-map (lambda (op) (blue-edge-operate meet join graph.1 op (sig op node1) (sig op node2))) (union (conform-map operation (blue-edges node1)) (conform-map operation (blue-edges node2))))) result.1)) (make-node (text-name (string-append "(" (internal-node-name node1) " v " (internal-node-name node2) ")"))))))))
              (lookup (already-joined graph.1) node1 node2))))))))

(def make-lattice
  (lambda (g print?)
    (begin
      (def step
        (lambda (g.2)
          ((lambda (copy) ((lambda (nodes) ((lambda () (begin (conform-for-each (lambda (first) (conform-for-each (lambda (second) (begin (meet copy first second) (join copy first second))) nodes)) nodes) copy)))) (graph-nodes copy)))
            (copy-graph g.2))))
      (def loop.1
        (lambda (g.1 count.3)
          (begin
            (if print? (begin (display-number count.3) (unit)) (unit))
            ((lambda (lattice) (begin (if print? (begin (display-text " -> ") (display-number (conform-length (graph-nodes lattice))) (unit)) (unit)) ((lambda (new-g) ((lambda (new-count) ((lambda () (if (= new-count count.3) (begin (if print? (begin (conform-newline) (unit)) (unit)) new-g) (begin (if print? (begin (display-text " -> ") (display-number new-count) (conform-newline) (unit)) (unit)) (loop.1 new-g new-count)))))) (conform-length (graph-nodes new-g)))) (xreduce lattice))))
              (step g.1)))))
      ((lambda (graph) (loop.1 graph (conform-length (graph-nodes graph))))
        (make-graph-list (adjoin any-node (adjoin none-node (graph-nodes (clean-graph g)))))))))

(def node-a (ref (ann (absent) (Optional Node))))

(def node-b (ref (ann (absent) (Optional Node))))

(def node-c (ref (ann (absent) (Optional Node))))

(def node-d (ref (ann (absent) (Optional Node))))

(def setup (-> Name Name Name Name Unit)
  (lambda (a0.1 b0.1 c0.1 d0.1)
    (begin
      (ref-set! node-a (present (make-node a0.1)))
      (ref-set! node-b (present (make-node b0.1)))
      (set-blue-edges!
        (optional-value (ref-get node-a))
        (conform-list (make-blue-edge phi-operation any-node (optional-value (ref-get node-b)))))
      (set-blue-edges!
        (optional-value (ref-get node-b))
        (conform-list
          (make-blue-edge phi-operation any-node (optional-value (ref-get node-a)))
          (make-blue-edge theta-operation any-node (optional-value (ref-get node-b)))))
      (ref-set! node-c (present (make-node c0.1)))
      (ref-set! node-d (present (make-node d0.1)))
      (set-blue-edges!
        (optional-value (ref-get node-c))
        (conform-list (make-blue-edge theta-operation any-node (optional-value (ref-get node-b)))))
      (set-blue-edges!
        (optional-value (ref-get node-d))
        (conform-list
          (make-blue-edge phi-operation any-node (optional-value (ref-get node-c)))
          (make-blue-edge theta-operation any-node (optional-value (ref-get node-d)))))
      (unit))))

(def test (-> Name Name Name Name (List String))
  (lambda (a0 b0 c0 d0)
    (begin
      (setup a0 b0 c0 d0)
      (conform-map
        internal-node-name
        (graph-nodes
          (make-lattice
            (make-graph
              (optional-value (ref-get node-a))
              (optional-value (ref-get node-b))
              (optional-value (ref-get node-c))
              (optional-value (ref-get node-d))
              any-node
              none-node)
            #f))))))

(def Specification (datatype ()
  (specification
    (count I64 specification-count)
    (names (List Name) specification-names)
    (expected (List String) specification-expected))))

(def input-name
  (lambda (value.3)
    (if (= (datum-kind value.3) 3)
      (text-name (datum-string-value value.3))
      (symbol-name (datum-symbol-value value.3)))))

(def input-names
  (lambda (value.2)
    (if (datum-null? value.2)
      (empty-list )
      (cons (input-name (datum-car value.2)) (input-names (datum-cdr value.2))))))

(def input-strings
  (lambda (value.1)
    (if (datum-null? value.1)
      (empty-list )
      (cons (datum-string-value (datum-car value.1)) (input-strings (datum-cdr value.1))))))

(def input-count
  (lambda (value)
    (match (datum-number-value value)
      ((exact-number count.2) count.2)
      ((rational-number number) (datum-fail "Conform count must be exact"))
      ((inexact-number number.1) (datum-fail "Conform count must be exact"))
      ((complex-number real imaginary) (datum-fail "Conform count must be exact")))))

(def read-specification
  (lambda (port)
    ((lambda (count.1) ((lambda (names.1) ((lambda (expected.1) ((lambda () (if (= (conform-length names.1) 4) (specification count.1 names.1 expected.1) (datum-fail "Conform requires exactly four names"))))) (input-strings (read-value! (read port))))) (input-names (read-value! (read port)))))
      (input-count (read-value! (read port))))))

(def configured (call-with-input-file "input.txt" read-specification))

(def configured-count (-> I64) (lambda () (specification-count configured)))

(def run-test
  (lambda (names)
    (test (car names) (car (cdr names)) (car (cdr (cdr names))) (car (cdr (cdr (cdr names)))))))

(def same-strings?
  (lambda (actual expected)
    (if (null? actual)
      (null? expected)
      (if (not (null? expected))
        (if (string=? (car actual) (car expected)) (same-strings? (cdr actual) (cdr expected)) #f)
        #f))))

(def bench (-> I64 I64)
  (lambda (count)
    (if (<= count 0)
      0
      (((lambda () (begin (def loop (lambda (index result) (if (< index count) (loop (+ index 1) (run-test (specification-names configured))) (if (same-strings? result (specification-expected configured)) 1 0)))) loop)))
        1
        (run-test (specification-names configured))))))

(unit)
