                           (let loop ((count a))
                             (if (= count 0) 0
                                 (let ((a (limb left (- count 1))) (b (limb right (- count 1))))
                                   (if (< a b) -1 (if (> a b) 1 (loop (- count 1)))))))))))
    (: integer-compare (-> Integer Integer I64))
