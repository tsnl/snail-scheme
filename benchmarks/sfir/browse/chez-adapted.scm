(define-syntax define-record-type
  ;; Simplistic R7RS to R6RS define-record-type transformation.
  (syntax-rules ()
    ((define-record-type name
      (make-name param ...)
      name?
      (field-name field-ref field-set!)
      ...)
     (r6rs:define-record-type (name make-name name?)
       (protocol
         (lambda (new)
           (lambda (param ...)
             (new param ...))))
       (fields
         (mutable field-name field-ref field-set!)
         ...)))))

(define (exact-integer? z)
  (and (exact? z) (integer? z)))

 (define read-line
   get-line)

(define (square x)
  (* x x))

(define write-string
  (case-lambda
    ((string)
      (put-string (current-output-port) string))
    ((string port)
      (put-string port string))
    ((string port start)
      (put-string port string start))
    ((string port start end)
      (put-string port string start (fx+ (fx- end start) 1)))))
;; R7RS benchmark timing for compiled Chez programs. The upstream Petite-Chez
;; prelude supplies language compatibility; the benchmark body is unchanged.
;; Use Chez's monotonic clock and integer nanoseconds, not two wall-clock reads.

(define (current-jiffy)
  (let ((now (current-time 'time-monotonic)))
    (+ (* (time-second now) 1000000000) (time-nanosecond now))))

(define (jiffies-per-second) 1000000000)

(define (current-second)
  (/ (current-jiffy) 1000000000.0))

(define-syntax : (syntax-rules () ((_ . signature) (begin))))
(define-syntax ann (syntax-rules () ((_ value type) value)))
(define-syntax define-overload (syntax-rules () ((_ . declaration) (begin))))
(define-syntax define-data
  (lambda (form)
    (syntax-case form ()
      ((context name variant ...)
       (datum->syntax #'context
         (cons 'begin
           (apply append
             (map (lambda (variant)
                    (let ((tag (car variant)) (fields (cdr variant)))
                      (cons `(define (,tag ,@(map car fields)) (vector ',tag ,@(map car fields)))
                        (let loop ((fields fields) (index 1))
                          (if (null? fields) '()
                              (append
                                (if (= (length (car fields)) 3)
                                    `((define (,(caddar fields) value)
                                        (unless (eq? (vector-ref value 0) ',tag)
                                          (error ',tag "wrong typed variant" value))
                                        (vector-ref value ,index))) '())
                                (loop (cdr fields) (+ index 1))))))))
                  (syntax->datum #'(variant ...))))))))))
(define-syntax match
  (lambda (form)
    (syntax-case form ()
      ((context value arm ...)
       (let ((temporary (syntax->datum (car (generate-temporaries #'(value))))))
         (datum->syntax #'context
           `(let ((,temporary ,(syntax->datum #'value)))
              (cond
                ,@(map (lambda (arm)
                         (let ((pattern (car arm)))
                           `((eq? (vector-ref ,temporary 0) ',(car pattern))
                             (let ,(let loop ((names (cdr pattern)) (index 1))
                                     (if (null? names) '()
                                         (cons `(,(car names) (vector-ref ,temporary ,index))
                                           (loop (cdr names) (+ index 1)))))
                               ,@(cdr arm)))))
                       (syntax->datum #'(arm ...)))
                (else (error 'match "invalid typed variant" ,temporary))))))))))
(define (unit) (if #f #f))
(define (unreachable) (error 'reader "unreachable typed branch"))
(define (ref value) (vector value))
(define (ref-get value) (vector-ref value 0))
(define (ref-set! cell value) (vector-set! cell 0 value))
(define ref-eq? eq?)
(define vector-eq? eq?)
(define string-eq? eq?)
(define bytevector-eq? eq?)
(define i32-eq eqv?)
(define i32->i64 values)
(define i64->i32 values)
(define i64->f64 inexact)
(define (f64->i64 value)
  (unless (and (finite? value) (<= -9223372036854775808.0 value) (< value 9223372036854775808.0))
    (error 'f64->i64 "out of range" value))
  (exact (truncate value)))
(define (empty-vector) (vector))
;; The identical Datum body hashes complete wrapping I64 words. Chez's generic
;; integers do not wrap, so these scalar adapters make that boundary explicit.
(define (i64-word value)
  (let ((bits (bitwise-bit-field value 0 64)))
    (if (< bits 9223372036854775808) bits (- bits 18446744073709551616))))
(define (i64-add a b) (i64-word (+ a b)))
(define (i64-mul a b) (i64-word (* a b)))
(define (i64-bitwise-and a b) (bitwise-if a b 0))
(define i64-bitwise-xor bitwise-xor)
(define (i64-shift-right/logical value count)
  (i64-word (bitwise-arithmetic-shift-right (bitwise-bit-field value 0 64)
                                          (bitwise-bit-field count 0 6))))
(define (string-copy! target at source start end)
  (do ((index start (+ index 1))) ((= index end))
    (string-set! target (+ at (- index start)) (string-ref source index))))
(define (vector-copy! target at source start end)
  (let ((count (- end start)))
    (if (and (eq? target source) (> at start))
        (do ((index (- count 1) (- index 1))) ((< index 0))
          (vector-set! target (+ at index) (vector-ref source (+ start index))))
        (do ((index 0 (+ index 1))) ((= index count))
          (vector-set! target (+ at index) (vector-ref source (+ start index)))))))
(define reader-interface
(let ((host-read-char read-char) (host-peek-char peek-char) (host-string->number string->number) (host-number->string number->string) (host-string->symbol string->symbol) (host-symbol->string symbol->string))
(define scalar-interface (let ()
;; Chez implements only the scalar token ABI here. Integer, Rational, Number,
;; Datum and reader operations use their unchanged strict-library bodies.

;; ---- Validated lexical fields retain exactness until Scheme conversion ----

(define-data TokenScalar
  (token-integer (value I64)) (token-real (value F64))
  (token-fraction (numerator String) (denominator String)
                  (radix I64) (scale I64) (inexact Bool)))
(define-data TokenNumber
  (token-scalar (value TokenScalar))
  (token-rectangular (real TokenScalar) (imaginary TokenScalar))
  (token-polar (radius TokenScalar) (angle TokenScalar) (exact Bool)))
(define-data TokenFailure (token-failure (message String token-failure-message)))
(define (token-failure? value)
  (and (vector? value) (eq? (vector-ref value 0) 'token-failure)))
(define (text-index text predicate)
  (let loop ((at 0))
    (and (< at (string-length text))
         (if (predicate (string-ref text at)) at (loop (+ at 1))))))
(define (text-starts? text character)
  (and (> (string-length text) 0) (char=? (string-ref text 0) character)))
(define (without-sign text)
  (if (or (text-starts? text #\+) (text-starts? text #\-))
      (substring text 1 (string-length text)) text))
(define (digit-value character)
  (cond ((char<=? #\0 character #\9) (- (char->integer character) 48))
        ((char<=? #\a character #\f) (- (char->integer character) 87))
        ((char<=? #\A character #\F) (- (char->integer character) 55))
        (else 16)))
(define (unsigned-digits? text radix)
  (and (> (string-length text) 0)
       (let loop ((at 0))
         (or (= at (string-length text))
             (and (< (digit-value (string-ref text at)) radix) (loop (+ at 1)))))))
(define (signed-digits? text radix) (unsigned-digits? (without-sign text) radix))
(define (zero-digits? text)
  (let loop ((at 0))
    (or (= at (string-length text))
        (and (char=? (string-ref text at) #\0) (loop (+ at 1))))))

;; A bounded scan distinguishes the I64 case without first constructing a host
;; bignum. Larger tokens retain their digits for the identical Integer body.
(define (bounded-magnitude digits radix limit)
  (let loop ((at 0) (value 0))
    (if (= at (string-length digits)) value
        (let ((digit (digit-value (string-ref digits at))))
          (and (<= digit limit) (<= value (quotient (- limit digit) radix))
               (loop (+ at 1) (+ (* value radix) digit)))))))
(define (bounded-integer text radix)
  (let* ((negative (text-starts? text #\-))
         (value (bounded-magnitude (without-sign text) radix
                                   (if negative 9223372036854775808 9223372036854775807))))
    (and value (if negative (- value) value))))
(define (integer-token text radix inexact?)
  (let ((value (bounded-integer text radix)))
    (if value
        (if inexact? (token-real (if (and (= value 0) (text-starts? text #\-))
                                     -0.0 (inexact value))) (token-integer value))
        (token-fraction text "1" radix 0 inexact?))))
(define (ratio-token text slash radix inexact?)
  (let ((numerator (substring text 0 slash))
        (denominator (substring text (+ slash 1) (string-length text))))
    (and (signed-digits? numerator radix) (unsigned-digits? denominator radix)
         (if (zero-digits? denominator) (token-failure "zero denominator in numeric token")
             (token-fraction numerator denominator radix 0 inexact?)))))

;; ---- Binary64 parsing accepts the Rust scalar grammar, not Chez extensions ----

(define (exponent-character? character) (or (char=? character #\e) (char=? character #\E)))
(define (decimal-mantissa? text)
  (let ((dot (text-index text (lambda (character) (char=? character #\.)))))
    (if dot
        (let ((digits (string-append (substring text 0 dot)
                                     (substring text (+ dot 1) (string-length text)))))
          (unsigned-digits? digits 10))
        (unsigned-digits? text 10))))
(define (decimal-text? text)
  (let* ((text (without-sign text)) (exponent (text-index text exponent-character?)))
    (if exponent
        (and (decimal-mantissa? (substring text 0 exponent))
             (signed-digits? (substring text (+ exponent 1) (string-length text)) 10))
        (and (text-index text (lambda (character) (char=? character #\.)))
             (decimal-mantissa? text)))))
(define (nonfinite-token text)
  (cond ((string-ci=? text "+inf.0") +inf.0) ((string-ci=? text "-inf.0") -inf.0)
        ((or (string-ci=? text "+nan.0") (string-ci=? text "-nan.0")) +nan.0)
        (else #f)))
(define (parse-binary64 text)
  (or (nonfinite-token text) (and (decimal-text? text) (host-string->number text))))
(define (decimal-scale exponent places)
  ;; Bound the exponent by the final scale before scanning. An exponent just
  ;; above I64_MAX can still fit after fractional places are subtracted. These
  ;; bounded host index intermediates never become Scheme numeric values.
  (let* ((negative (text-starts? exponent #\-))
         (limit (if negative (- 9223372036854775807 places) (+ 9223372036854775807 places)))
         (value (and (>= limit 0) (bounded-magnitude (without-sign exponent) 10 limit))))
    (if value (- (if negative (- value) value) places)
        (token-failure "exact decimal exponent exceeds supported allocation index range"))))
(define (exact-decimal-parts text mantissa exponent)
  (let* ((dot (text-index mantissa (lambda (character) (char=? character #\.))))
         (digits (if dot (string-append (substring mantissa 0 dot)
                                        (substring mantissa (+ dot 1) (string-length mantissa))) mantissa))
         (places (if dot (- (string-length mantissa) dot 1) 0)))
    (cond ((not (unsigned-digits? digits 10)) (token-failure "nonfinite number has no exact value"))
          ((zero-digits? digits) (token-integer 0))
          (else (let ((scale (decimal-scale exponent places)))
                  (if (token-failure? scale) scale
                      (token-fraction (if (text-starts? text #\-) (string-append "-" digits) digits)
                                      "1" 10 scale #f)))))))
(define (exact-decimal-token text)
  (let* ((unsigned (without-sign text)) (at (text-index unsigned exponent-character?)))
    (exact-decimal-parts text (if at (substring unsigned 0 at) unsigned)
                         (if at (substring unsigned (+ at 1) (string-length unsigned)) "0"))))
(define (decimal-token text exactness)
  (if (eq? exactness 'exact)
      (cond ((nonfinite-token text) (token-failure "nonfinite number has no exact value"))
            ((decimal-text? text) (exact-decimal-token text)) (else #f))
      (let ((value (parse-binary64 text))) (and value (token-real value)))))
(define (real-token text radix exactness)
  (let ((slash (text-index text (lambda (character) (char=? character #\/)))))
    (cond (slash (ratio-token text slash radix (eq? exactness 'inexact)))
          ((signed-digits? text radix) (integer-token text radix (eq? exactness 'inexact)))
          ((= radix 10) (decimal-token text exactness))
          (else #f))))

;; ---- Prefixes and complete components are interpreted before shortcuts ----

(define (numeric-prefixes text radix)
  (let loop ((at 0) (radix radix) (seen-radix #f) (exactness 'automatic))
    (if (and (< (+ at 1) (string-length text)) (char=? (string-ref text at) #\#))
        (let ((prefix (char-downcase (string-ref text (+ at 1)))))
          (cond ((and (memv prefix '(#\e #\i)) (eq? exactness 'automatic))
                 (loop (+ at 2) radix seen-radix (if (char=? prefix #\e) 'exact 'inexact)))
                ((and (memv prefix '(#\b #\o #\d #\x)) (not seen-radix))
                 (loop (+ at 2) (case prefix ((#\b) 2) ((#\o) 8) ((#\x) 16) (else 10)) #t exactness))
                (else #f)))
        (vector (substring text at (string-length text)) radix exactness))))
(define (token-components first second radix exactness kind)
  (let ((left (real-token first radix exactness)))
    (if (token-failure? left) left
        (let ((right (real-token second radix exactness)))
          (cond ((token-failure? right) right) ((not (and left right)) #f)
                ((eq? kind 'rectangular) (token-rectangular left right))
                (else (token-polar left right (eq? exactness 'exact))))))))
(define (rectangular-split body radix)
  (let loop ((at (- (string-length body) 1)))
    (and (> at 0)
         (if (and (memv (string-ref body at) '(#\+ #\-))
                  (not (and (= radix 10) (exponent-character? (string-ref body (- at 1))))))
             at (loop (- at 1))))))
(define (rectangular-token body radix exactness)
  (let* ((split (rectangular-split body radix))
         (real (if split (substring body 0 split) "0"))
         (imaginary (if split (substring body split (string-length body)) body)))
    (and (or (text-starts? imaginary #\+) (text-starts? imaginary #\-))
         (token-components real (if (= (string-length imaginary) 1)
                                    (string-append imaginary "1") imaginary)
                           radix exactness 'rectangular))))
(define (prefixed-number-token fields)
  (let* ((text (vector-ref fields 0)) (radix (vector-ref fields 1)) (exactness (vector-ref fields 2))
         (size (string-length text)) (polar (text-index text (lambda (character) (char=? character #\@)))))
    (cond (polar (token-components (substring text 0 polar) (substring text (+ polar 1) size)
                                   radix exactness 'polar))
          ((and (> size 0) (char-ci=? (string-ref text (- size 1)) #\i))
           (rectangular-token (substring text 0 (- size 1)) radix exactness))
          (else (let ((value (real-token text radix exactness)))
                  (if (or (not value) (token-failure? value)) value (token-scalar value)))))))
(define (number-token text radix)
  (and (memv radix '(2 8 10 16))
       (let ((prefixes (numeric-prefixes text radix)))
         (and prefixes (prefixed-number-token prefixes)))))

;; ---- Typed ABI projections expose only the requested scalar field ----

(define (token-scalar-kind scalar)
  (match scalar ((token-integer value) 1) ((token-real value) 2)
         ((token-fraction numerator denominator radix scale inexact) (if inexact 6 5))))
(define (token-number-kind number)
  (match number ((token-scalar value) (token-scalar-kind value))
         ((token-rectangular real imaginary) 3) ((token-polar radius angle exact) (if exact 8 7))))
(define (token-component number part)
  (match number
    ((token-scalar value) (if (= part 0) value (error 'token "numeric component index out of range")))
    ((token-rectangular real imaginary)
     (case part ((0) real) ((1) imaginary) (else (error 'token "numeric component index out of range"))))
    ((token-polar radius angle exact)
     (case part ((0) radius) ((1) angle) (else (error 'token "numeric component index out of range"))))))
(define (token-scalar-integer scalar)
  (unless (eq? (vector-ref scalar 0) 'token-integer)
    (error 'token "numeric component is not a machine integer"))
  (vector-ref scalar 1))
(define (token-scalar-real scalar)
  (unless (eq? (vector-ref scalar 0) 'token-real)
    (error 'token "numeric component is not inexact"))
  (vector-ref scalar 1))
(define (token-scalar-fraction scalar)
  (unless (eq? (vector-ref scalar 0) 'token-fraction)
    (error 'token "numeric component has no exact digit fields"))
  scalar)
(define (token-scalar-text scalar term)
  (match (token-scalar-fraction scalar)
    ((token-fraction numerator denominator radix scale inexact)
     (case term ((0) numerator) ((1) denominator) (else (error 'token "exact numeric term index out of range"))))))
(define (token-scalar-radix scalar)
  (match (token-scalar-fraction scalar) ((token-fraction numerator denominator radix scale inexact) radix)))
(define (token-scalar-scale scalar)
  (match (token-scalar-fraction scalar) ((token-fraction numerator denominator radix scale inexact) scale)))

;; ---- Binary64 text uses a shortest decimal with Rust's display layout ----

;; The layout follows Rust Debug: exponent notation below 10^-4 and from 10^16,
;; with a decimal point for finite values rendered without an exponent. Chez's
;; choice of shortest digits must be compared byte for byte with the target,
;; including tie-sensitive values; round-trip equality alone is insufficient.
(define (without-precision text)
  ;; Chez appends an R6RS precision suffix to subnormals, for example 5e-324|1.
  ;; It describes the binary64 value, not part of the decimal exponent.
  (let ((at (text-index text (lambda (character) (char=? character #\|)))))
    (if at (substring text 0 at) text)))
(define (decimal-layout text)
  (let* ((negative (text-starts? text #\-)) (unsigned (without-sign text))
         (at (text-index unsigned exponent-character?))
         (mantissa (if at (substring unsigned 0 at) unsigned))
         (exponent (if at (host-string->number (substring unsigned (+ at 1) (string-length unsigned))) 0))
         (dot (text-index mantissa (lambda (character) (char=? character #\.))))
         (digits (if dot (string-append (substring mantissa 0 dot)
                                        (substring mantissa (+ dot 1) (string-length mantissa))) mantissa)))
    (vector negative digits (+ exponent (if dot dot (string-length mantissa))))))
(define (trim-decimal-layout layout)
  (let* ((digits (vector-ref layout 1)) (count (string-length digits)))
    (let start ((first 0))
      (if (and (< first (- count 1)) (char=? (string-ref digits first) #\0)) (start (+ first 1))
          (let end ((last count))
            (if (and (> last (+ first 1)) (char=? (string-ref digits (- last 1)) #\0)) (end (- last 1))
                (vector (vector-ref layout 0) (substring digits first last) (- (vector-ref layout 2) first))))))))
(define (scientific-decimal digits point)
  (let ((exponent (- point 1)))
    (string-append (substring digits 0 1)
                   (if (= (string-length digits) 1) "" (string-append "." (substring digits 1 (string-length digits))))
                   "e" (if (>= exponent 0) "+" "") (host-number->string exponent))))
(define (fixed-decimal digits point)
  (let ((count (string-length digits)))
    (cond ((<= point 0) (string-append "0." (make-string (- point) #\0) digits))
          ((>= point count) (string-append digits (make-string (- point count) #\0) ".0"))
          (else (string-append (substring digits 0 point) "." (substring digits point count))))))
(define (binary64-text value)
  (cond ((nan? value) "+nan.0") ((= value +inf.0) "+inf.0") ((= value -inf.0) "-inf.0")
        ((= value 0.0) (if (eqv? value -0.0) "-0.0" "0.0"))
        (else (let* ((layout (trim-decimal-layout (decimal-layout (without-precision (host-number->string value)))))
                     (digits (vector-ref layout 1)) (point (vector-ref layout 2)))
                (string-append (if (vector-ref layout 0) "-" "")
                               (if (or (<= point -4) (> point 16)) (scientific-decimal digits point)
                                   (fixed-decimal digits point)))))))

(define-data CharacterResult (character-end) (character-value (value Char)))
(define (read-char port)
  (let ((value (host-read-char port)))
    (if (eof-object? value) (character-end) (character-value value))))
(define (peek-char port)
  (let ((value (host-peek-char port)))
    (if (eof-object? value) (character-end) (character-value value))))
(define (has-character? text character)
  (let loop ((index 0))
    (and (< index (string-length text))
         (or (char=? (string-ref text index) character) (loop (+ index 1))))))
(define (initial? character)
  (or (char-alphabetic? character) (has-character? "!$%&*/:<=>?^_~@" character)))
(define (sign-next? character) (or (initial? character) (has-character? "+-" character)))
(define (dot-next? character) (or (sign-next? character) (char=? character #\.)))
(define (identifier-text? text)
  (let ((size (string-length text)))
    (define (at index predicate) (and (< index size) (predicate (string-ref text index))))
    (define (tail index)
      (or (= index size)
          (and (let ((c (string-ref text index)))
                 (or (initial? c) (char<=? #\0 c #\9) (has-character? "+-." c)))
               (tail (+ index 1)))))
    (and (> size 0)
         (let ((first (string-ref text 0)))
           (cond ((has-character? "+-" first)
                  (or (= size 1) (if (char=? (string-ref text 1) #\.)
                                    (and (at 2 dot-next?) (tail 3))
                                    (and (at 1 sign-next?) (tail 2)))))
                 ((char=? first #\.) (and (at 1 dot-next?) (tail 2)))
                 (else (and (initial? first) (tail 1))))))))
(define (temporary-open) (vector 'text '() #f))
(define (temporary-state handle)
  (let ((state (vector-ref handle 0)))
    (when (eq? state 'closed) (error 'token "invalid or closed token handle"))
    state))
(define (temporary-text handle)
  (case (temporary-state handle)
    ((text) (list->string (reverse (vector-ref handle 1))))
    ((parsed error) (vector-ref handle 2))
    (else (error 'token "invalid or closed token handle"))))
(define (temporary-character handle character)
  (unless (eq? (temporary-state handle) 'text) (error 'token "token has already been parsed"))
  (vector-set! handle 1 (cons character (vector-ref handle 1))))
(define (temporary-close handle)
  (temporary-state handle)
  (vector-set! handle 0 'closed) (vector-set! handle 1 #f) (vector-set! handle 2 #f))
(define (temporary-parse-radix handle radix)
  (unless (eq? (temporary-state handle) 'text)
    (temporary-close handle) (error 'token "token has already been parsed"))
  (let* ((text (temporary-text handle)) (value (number-token text radix)))
    (vector-set! handle 2 text)
    (vector-set! handle 0 (if (token-failure? value) 'error 'parsed))
    (vector-set! handle 1 value)
    (cond ((token-failure? value) 4) (value (token-number-kind value)) (else 0))))
(define (temporary-parse handle) (temporary-parse-radix handle 10))
(define (numeric-component handle index)
  (unless (and (eq? (temporary-state handle) 'parsed) (vector-ref handle 1))
    (error 'token "token has no successful numeric result"))
  (token-component (vector-ref handle 1) index))
(define (temporary-error handle)
  (unless (eq? (temporary-state handle) 'error) (error 'token "token has no numeric error"))
  (token-failure-message (vector-ref handle 1)))
(define (temporary-intern handle)
  (let ((allowed (or (eq? (temporary-state handle) 'text)
                     (and (eq? (temporary-state handle) 'parsed) (not (vector-ref handle 1)))))
        (text (temporary-text handle)))
    (temporary-close handle)
    (unless allowed (error 'token "symbol interning requires an unparsed text handle"))
    (host-string->symbol text)))
(define (temporary-fail handle)
  (let ((text (temporary-text handle))) (temporary-close handle) (error 'reader text)))
(define (scalar-service name)
  (cond
    ((string=? name "snail:datum/token-open") temporary-open)
    ((string=? name "snail:datum/token-character") temporary-character)
    ((string=? name "snail:datum/token-close") temporary-close)
    ((string=? name "snail:datum/token-parse") temporary-parse)
    ((string=? name "snail:datum/token-parse-radix") temporary-parse-radix)
    ((string=? name "snail:datum/token-text-length") (lambda (handle) (string-length (temporary-text handle))))
    ((string=? name "snail:datum/token-text-character") (lambda (handle index) (string-ref (temporary-text handle) index)))
    ((string=? name "snail:datum/token-identifier")
     (lambda (handle) (if (identifier-text? (temporary-text handle)) 1 0)))
    ((string=? name "snail:datum/token-intern") temporary-intern)
    ((string=? name "snail:datum/number-kind")
     (lambda (handle index) (token-scalar-kind (numeric-component handle index))))
    ((string=? name "snail:datum/number-integer")
