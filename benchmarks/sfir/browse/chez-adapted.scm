    (: integer<? (-> Integer Integer Bool))
    (define (integer<? left right) (< (integer-compare left right) 0))
    (: integer<=? (-> Integer Integer Bool))
    (define (integer<=? left right) (<= (integer-compare left right) 0))
    (: integer>? (-> Integer Integer Bool))
