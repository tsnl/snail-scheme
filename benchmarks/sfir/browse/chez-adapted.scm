;;; BROWSE -- Benchmark to create and browse through
;;; an AI-like data base of units.


(define (lookup key table)
  (let loop ((x table))
    (if (datum-null? x)
        (datum-boolean #f)
        (let ((pair (datum-car x)))
          (if (datum-eq? (datum-car pair) key)
              pair
              (loop (datum-cdr x)))))))

(define *properties* (ref (datum-null)))

(define (get key1 key2)
  (let ((x (lookup key1 (ref-get *properties*))))
    (if (datum-truth? x)
        (let ((y (lookup key2 (datum-cdr x))))
          (if (datum-truth? y)
              (datum-cdr y)
              (datum-boolean #f)))
        (datum-boolean #f))))

(define (put key1 key2 val)
  (let ((x (lookup key1 (ref-get *properties*))))
    (if (datum-truth? x)
        (let ((y (lookup key2 (datum-cdr x))))
          (if (datum-truth? y)
              (datum-set-cdr! y val)
              (datum-set-cdr! x (datum-cons (datum-cons key2 val) (datum-cdr x)))))
        (ref-set! *properties*
              (datum-cons (datum-list key1 (datum-cons key2 val)) (ref-get *properties*))))))

(define *current-gensym* (ref 0))

(define (generate-symbol)
  (ref-set! *current-gensym* (+ (ref-get *current-gensym*) 1))
  (generate-symbol-value (i64->string (ref-get *current-gensym*))))

(define (append-to-tail! x y)
  (if (datum-null? x)
      y
      (browse-do ((a x b)
           (b (datum-cdr x) (datum-cdr b)))
          ((datum-null? b)
           (datum-set-cdr! a y)
           x))))

(define (tree-copy x)
  (if (not (datum-pair? x))
      x
      (datum-cons (tree-copy (datum-car x))
            (tree-copy (datum-cdr x)))))

;;; n is # of symbols
;;; m is maximum amount of stuff on the plist
;;; npats is the number of basic patterns on the unit
;;; ipats is the instantiated copies of the patterns

(define *rand* (ref 21))

(define (init n m npats ipats)
  (let ((ipats (tree-copy ipats)))
    (browse-do ((p ipats (datum-cdr p)))
        ((datum-null? (datum-cdr p)) (datum-set-cdr! p ipats)))
    (browse-do ((n n (- n 1))
         (i m (browse-cond ((browse-zero? i) m)
                    (else (- i 1))))
         (name (generate-symbol) (generate-symbol))
         (a (ref (datum-null))))
        ((= n 0) (ref-get a))
      (ref-set! a (datum-cons name (ref-get a)))
      (browse-do ((i i (- i 1)))
          ((browse-zero? i))
        (put name (generate-symbol) (datum-boolean #f)))
      (put name
           symbol-pattern
           (browse-do ((i npats (- i 1))
                (ipats ipats (datum-cdr ipats))
                (a (ref (datum-null))))
               ((browse-zero? i) (ref-get a))
             (ref-set! a (datum-cons (datum-car ipats) (ref-get a)))))
      (browse-do ((j (- m i) (- j 1)))
          ((browse-zero? j))
        (put name (generate-symbol) (datum-boolean #f))))))

(define (browse-random)
  (ref-set! *rand* (remainder (* (ref-get *rand*) 17) 251))
  (ref-get *rand*))

(define (randomize original-list)
  (let ((l (ref original-list)))
  (browse-do ((a (ref (datum-null))))
      ((datum-null? (ref-get l)) (ref-get a))
    (let ((n (remainder (browse-random) (datum-length (ref-get l)))))
      (browse-cond ((browse-zero? n)
             (ref-set! a (datum-cons (datum-car (ref-get l)) (ref-get a)))
             (ref-set! l (datum-cdr (ref-get l)))
             (ref-get l))
            (else
             (browse-do ((n n (- n 1))
                  (x (ref-get l) (datum-cdr x)))
                 ((= n 1)
                  (ref-set! a (datum-cons (datum-cadr x) (ref-get a)))
                  (datum-set-cdr! x (datum-cddr x))
                  x))))))))

(define (my-match pat dat alist)
  (browse-cond ((datum-null? pat)
         (match-boolean (datum-null? dat)))
        ((datum-null? dat) empty-match)
        ((or (datum-eq? (datum-car pat) symbol-question)
             (datum-eq? (datum-car pat)
                  (datum-car dat)))
         (my-match (datum-cdr pat) (datum-cdr dat) alist))
        ((datum-eq? (datum-car pat) symbol-star)
         (match-or (my-match (datum-cdr pat) dat alist)
             (my-match (datum-cdr pat) (datum-cdr dat) alist)
             (my-match pat (datum-cdr dat) alist)))
        (else (browse-cond ((not (datum-pair? (datum-car pat)))
                     (browse-cond ((char=? (string-ref (symbol-datum->string (datum-car pat)) 0)
                                 #\?)
                            (let ((val (datum-assq (datum-car pat) alist)))
                              (browse-cond ((datum-truth? val) (my-match (datum-cons (datum-cdr val)
                                                         (datum-cdr pat))
                                                   dat alist))
                                    (else (my-match (datum-cdr pat)
                                                    (datum-cdr dat)
                                                    (datum-cons (datum-cons (datum-car pat)
                                                                (datum-car dat))
                                                          alist))))))
                           ((char=? (string-ref (symbol-datum->string (datum-car pat)) 0)
                                 #\*)
                            (let ((val (datum-assq (datum-car pat) alist)))
                              (browse-cond ((datum-truth? val) (my-match (datum-append (datum-cdr val)
                                                           (datum-cdr pat))
                                                   dat alist))
                                    (else
                                     (browse-do ((l (datum-null)
                                             (append-to-tail!
                                              l
                                              (datum-cons (if (datum-null? d)
                                                        (datum-null)
                                                        (datum-car d))
                                                    (datum-null))))
                                          (e (datum-cons (datum-null) dat) (datum-cdr e))
                                          (d dat (if (datum-null? d) (datum-null) (datum-cdr d))))
                                         ((or (datum-null? e)
                                              (match-truth? (my-match (datum-cdr pat)
                                                        d
                                                        (datum-cons
                                                         (datum-cons (datum-car pat) l)
                                                         alist))))
                                          (match-boolean (not (datum-null? e)))))))))

                           ;; fix suggested by Manuel Serrano
                           ;; (cond did not have an else clause);
                           ;; this changes the run time quite a bit

                           (else failed-match)))
                    (else (match-and
                           (match-boolean (datum-pair? (datum-car dat)))
                           (my-match (datum-car pat)
                                     (datum-car dat) alist)
                           (my-match (datum-cdr pat)
                                     (datum-cdr dat) alist)))))))

(define database
  (randomize
   (init 100 10 4 (datum-cons (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-b (datum-cons symbol-b (datum-cons symbol-b (datum-cons symbol-b (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-b (datum-cons symbol-b (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-a (datum-null)))))))))))))))))) (datum-cons (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-b (datum-cons symbol-b (datum-cons symbol-b (datum-cons symbol-b (datum-cons symbol-a (datum-cons symbol-a (datum-cons (datum-cons symbol-a (datum-cons symbol-a (datum-null))) (datum-cons (datum-cons symbol-b (datum-cons symbol-b (datum-null))) (datum-null))))))))))) (datum-cons (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-a (datum-cons symbol-b (datum-cons (datum-cons symbol-b (datum-cons symbol-a (datum-null))) (datum-cons symbol-b (datum-cons symbol-a (datum-cons symbol-b (datum-cons symbol-a (datum-null)))))))))) (datum-null)))))))

(define (browse pats)
  (investigate
   database
   pats)
  (datum-map string-datum->number-datum (datum-map symbol-datum->string-datum database)))

(define (investigate units pats)
  (browse-do ((units units (datum-cdr units)))
      ((datum-null? units))
    (browse-do ((pats pats (datum-cdr pats)))
        ((datum-null? pats))
      (browse-do ((p (get (datum-car units) symbol-pattern)
              (datum-cdr p)))
          ((datum-null? p))
        (my-match (datum-car pats) (datum-car p) (datum-null))))))

(define (run-benchmark)
  (let* ((count (read))
         (input1 (read-value! (strict-read (current-input-port))))
         (output (read-value! (strict-read (current-input-port))))
         (s2 (number->string count))
         (s1 "")
         (name "browse"))
    (run-r7rs-benchmark
     (string-append name ":" s2)
     count
     (lambda () (browse (hide count input1)))
     (lambda (result) (datum=? result output)))))

(define (this-scheme-implementation-name) "chez")

;;; The following code is appended to all benchmarks.

;;; Given an integer and an object, returns the object
;;; without making it too easy for compilers to tell
;;; the object will be returned.

(define (hide r x)
  (call-with-values
   (lambda ()
     (values (vector values (lambda (x) x))
             (if (< r 100) 0 1)))
   (lambda (v i)
     ((vector-ref v i) x))))

;;; Given the name of a benchmark,
;;; the number of times it should be executed,
;;; a thunk that runs the benchmark once,
;;; and a unary predicate that is true of the
;;; correct results the thunk may return,
;;; runs the benchmark for the number of specified iterations.

(define (run-r7rs-benchmark name count thunk ok?)

  ;; Rounds to thousandths.
  (define (rounded x)
    (/ (round (* 1000 x)) 1000))

  (display "Running ")
  (display name)
  (newline)
  (flush-output-port (current-output-port))
  (let* ((j/s (jiffies-per-second))
         (t0 (current-second))
         (j0 (current-jiffy)))
    (let loop ((i 0)
               (result (datum-boolean #f)))
      (cond ((< i count)
             (loop (+ i 1) (thunk)))
            ((ok? result)
             (let* ((t1 (current-second))
                    (j1 (current-jiffy))
                    (jifs (- j1 j0))
                    (secs (inexact (/ jifs j/s)))
                    (secs2 (rounded (- t1 t0))))
               (display "Elapsed time: ")
               (write secs)
               (display " seconds (")
               (write secs2)
               (display ") for ")
               (display name)
               (newline)
               (display "+!CSVLINE!+")
               (display (this-scheme-implementation-name))
               (display ",")
               (display name)
               (display ",")
               (display secs)
               (newline)
               (flush-output-port (current-output-port)))
             0)
            (else
             (display "ERROR: returned incorrect result: ")
             (write result)
             (newline)
             (display "+!CSVLINE!+")
             (display (this-scheme-implementation-name))
             (display ",")
             (display name)
             (display ",")
             (display "INCORRECT")
             (newline)
             (flush-output-port (current-output-port))
             0)))))

(run-benchmark)
