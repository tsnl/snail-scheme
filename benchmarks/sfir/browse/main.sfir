(def browse (-> Datum Datum)
  (lambda (pats.2)
    (begin
      (investigate database pats.2)
      (datum-map string-datum->number-datum (datum-map symbol-datum->string-datum database)))))

(def investigate (-> Datum Datum Unit)
  (lambda (units pats)
    (((lambda () (begin (def loop.1 (lambda (units.1) (if (datum-null? units.1) (unit) (begin (((lambda () (begin (def loop.2 (lambda (pats.1) (if (datum-null? pats.1) (unit) (begin (((lambda () (begin (def loop.3 (lambda (p) (if (datum-null? p) (unit) (begin (my-match (datum-car pats.1) (datum-car p) (datum-null)) (loop.3 (datum-cdr p)))))) loop.3))) (get (datum-car units.1) symbol-pattern)) (loop.2 (datum-cdr pats.1)))))) loop.2))) pats) (loop.1 (datum-cdr units.1)))))) loop.1)))
      units)))

(def Specification (datatype ()
  (specification
    (count I64 specification-count)
    (patterns Datum specification-patterns)
    (expected Datum specification-expected))))

(def exact-count (-> Datum I64)
  (lambda (datum)
    (match (datum-number-value datum)
      ((exact-number value.1) value.1)
      ((rational-number value.2) (datum-fail "browse: count must be exact"))
      ((inexact-number value.3) (datum-fail "browse: count must be exact"))
      ((complex-number real imaginary) (datum-fail "browse: count must be exact")))))

(def read-specification (-> InputPort Specification)
  (lambda (port)
    ((lambda (count.2) ((lambda (patterns) ((lambda (expected.1) ((lambda () (specification count.2 patterns expected.1)))) (read-value! (read port)))) (read-value! (read port))))
      (exact-count (read-value! (read port))))))

(def configured (call-with-input-file "input.txt" read-specification))

(def input0 (specification-patterns configured))

(def expected (specification-expected configured))

(def configured-count (-> I64) (lambda () (specification-count configured)))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(def hide (-> I64 Datum Datum) (lambda (count.1 value) (if (barrier) value (unreachable))))

(def bench (-> I64 I64)
  (lambda (count)
    (((lambda () (begin (def loop (lambda (index result) (if (< index count) (loop (+ index 1) (browse (hide count input0))) (if (datum=? result expected) 1 0)))) loop)))
      0
      (datum-boolean #f))))

(unit)
