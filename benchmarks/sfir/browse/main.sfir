(def string-datum->number-datum (-> Datum Datum)
  (lambda (value.9)
    (match (typed-string->number (datum-string-value value.9))
      ((not-a-number) (datum-boolean #f))
      ((parsed-number value.8) (datum-number value.8))
      ((number-error message) (datum-fail message)))))

(def lookup (-> Datum Datum Datum)
  (lambda (key table)
    (((lambda () (begin (def loop.13 (lambda (x.5) (if (datum-null? x.5) (datum-boolean #f) ((lambda (pair) (if (datum-eq? (datum-car pair) key) pair (loop.13 (datum-cdr x.5)))) (datum-car x.5))))) loop.13)))
      table)))

(def *properties* (ref (datum-null)))

(def get (-> Datum Datum Datum)
  (lambda (key1.1 key2.1)
    ((lambda (x.4) (if (datum-truth? x.4) ((lambda (y.2) (if (datum-truth? y.2) (datum-cdr y.2) (datum-boolean #f))) (lookup key2.1 (datum-cdr x.4))) (datum-boolean #f)))
      (lookup key1.1 (ref-get *properties*)))))

(def put (-> Datum Datum Datum Unit)
  (lambda (key1 key2 val.2)
    ((lambda (x.3) (if (datum-truth? x.3) ((lambda (y.1) (if (datum-truth? y.1) (datum-set-cdr! y.1 val.2) (datum-set-cdr! x.3 (datum-cons (datum-cons key2 val.2) (datum-cdr x.3))))) (lookup key2 (datum-cdr x.3))) (ref-set! *properties* (datum-cons (datum-list key1 (datum-cons key2 val.2)) (ref-get *properties*)))))
      (lookup key1 (ref-get *properties*)))))

(def *current-gensym* (ref 0))

(def generate-symbol (-> Datum)
  (lambda ()
    (begin
      (ref-set! *current-gensym* (+ (ref-get *current-gensym*) 1))
      (generate-symbol-value (i64->string (ref-get *current-gensym*))))))

(def append-to-tail! (-> Datum Datum Datum)
  (lambda (x.2 y)
    (if (datum-null? x.2)
      y
      (((lambda () (begin (def loop.12 (lambda (a.3 b) (if (datum-null? b) (begin (unit) (datum-set-cdr! a.3 y) x.2) (loop.12 b (datum-cdr b))))) loop.12)))
        x.2
        (datum-cdr x.2)))))

(def tree-copy (-> Datum Datum)
  (lambda (x.1)
    (if (not (datum-pair? x.1))
      x.1
      (datum-cons (tree-copy (datum-car x.1)) (tree-copy (datum-cdr x.1))))))

(def *rand* (ref 21))

(def init (-> I64 I64 I64 Datum Datum)
  (lambda (n.2 m npats ipats)
    ((lambda (ipats.1) (begin (((lambda () (begin (def loop.11 (lambda (p.1) (if (datum-null? (datum-cdr p.1)) (begin (unit) (datum-set-cdr! p.1 ipats.1)) (loop.11 (datum-cdr p.1))))) loop.11))) ipats.1) (((lambda () (begin (def loop.7 (lambda (n.3 i name a.1) (if (= n.3 0) (begin (unit) (ref-get a.1)) (begin (ref-set! a.1 (datum-cons name (ref-get a.1))) (((lambda () (begin (def loop.10 (lambda (i.2) (if (browse-zero? i.2) (unit) (begin (put name (generate-symbol) (datum-boolean #f)) (loop.10 (- i.2 1)))))) loop.10))) i) (put name symbol-pattern (((lambda () (begin (def loop.9 (lambda (i.1 ipats.2 a.2) (if (browse-zero? i.1) (begin (unit) (ref-get a.2)) (begin (ref-set! a.2 (datum-cons (datum-car ipats.2) (ref-get a.2))) (loop.9 (- i.1 1) (datum-cdr ipats.2) a.2))))) loop.9))) npats ipats.1 (ref (datum-null)))) (((lambda () (begin (def loop.8 (lambda (j) (if (browse-zero? j) (unit) (begin (put name (generate-symbol) (datum-boolean #f)) (loop.8 (- j 1)))))) loop.8))) (- m i)) (loop.7 (- n.3 1) (if (browse-zero? i) m (- i 1)) (generate-symbol) a.1))))) loop.7))) n.2 m (generate-symbol) (ref (datum-null)))))
      (tree-copy ipats))))

(def browse-random (-> I64)
  (lambda () (begin (ref-set! *rand* (remainder (* (ref-get *rand*) 17) 251)) (ref-get *rand*))))

(def randomize (-> Datum Datum)
  (lambda (original-list)
    ((lambda (l.1) (((lambda () (begin (def loop.5 (lambda (a) (if (datum-null? (ref-get l.1)) (begin (unit) (ref-get a)) (begin ((lambda (n) (if (browse-zero? n) (begin (ref-set! a (datum-cons (datum-car (ref-get l.1)) (ref-get a))) (ref-set! l.1 (datum-cdr (ref-get l.1))) (ref-get l.1)) (((lambda () (begin (def loop.6 (lambda (n.1 x) (if (= n.1 1) (begin (unit) (ref-set! a (datum-cons (datum-cadr x) (ref-get a))) (datum-set-cdr! x (datum-cddr x)) x) (loop.6 (- n.1 1) (datum-cdr x))))) loop.6))) n (ref-get l.1)))) (remainder (browse-random) (datum-length (ref-get l.1)))) (loop.5 a))))) loop.5))) (ref (datum-null))))
      (ref original-list))))

(def my-match (-> Datum Datum Datum MatchResult)
  (lambda (pat dat alist)
    (if (datum-null? pat)
      (match-boolean (datum-null? dat))
      (if (datum-null? dat)
        empty-match
        (if ((lambda (value.7) (if value.7 value.7 (datum-eq? (datum-car pat) (datum-car dat)))) (datum-eq? (datum-car pat) symbol-question))
          (my-match (datum-cdr pat) (datum-cdr dat) alist)
          (if (datum-eq? (datum-car pat) symbol-star)
            ((lambda (value.6) (if (match-truth? value.6) value.6 ((lambda (value.5) (if (match-truth? value.5) value.5 (my-match pat (datum-cdr dat) alist))) (my-match (datum-cdr pat) (datum-cdr dat) alist))))
              (my-match (datum-cdr pat) dat alist))
            (if (not (datum-pair? (datum-car pat)))
              (if (char=? (string-ref (symbol-datum->string (datum-car pat)) 0) #\?)
                ((lambda (val.1) (if (datum-truth? val.1) (my-match (datum-cons (datum-cdr val.1) (datum-cdr pat)) dat alist) (my-match (datum-cdr pat) (datum-cdr dat) (datum-cons (datum-cons (datum-car pat) (datum-car dat)) alist))))
                  (datum-assq (datum-car pat) alist))
                (if (char=? (string-ref (symbol-datum->string (datum-car pat)) 0) #\*)
                  ((lambda (val) (if (datum-truth? val) (my-match (datum-append (datum-cdr val) (datum-cdr pat)) dat alist) (((lambda () (begin (def loop.4 (lambda (l e d) (if ((lambda (value.4) (if value.4 value.4 (match-truth? (my-match (datum-cdr pat) d (datum-cons (datum-cons (datum-car pat) l) alist))))) (datum-null? e)) (begin (unit) (match-boolean (not (datum-null? e)))) (loop.4 (append-to-tail! l (datum-cons (if (datum-null? d) (datum-null) (datum-car d)) (datum-null))) (datum-cdr e) (if (datum-null? d) (datum-null) (datum-cdr d)))))) loop.4))) (datum-null) (datum-cons (datum-null) dat) dat)))
                    (datum-assq (datum-car pat) alist))
                  failed-match))
              (if (match-truth? (match-boolean (datum-pair? (datum-car dat))))
                (if (match-truth? (my-match (datum-car pat) (datum-car dat) alist))
                  (my-match (datum-cdr pat) (datum-cdr dat) alist)
                  failed-match)
                failed-match))))))))

(def database
  (randomize
    (init
      100
