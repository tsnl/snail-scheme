(def MatchResult (datatype () (match-false) (match-true) (match-empty)))

(def failed-match (match-false))

(def successful-match (match-true))

(def empty-match (match-empty))

(def match-boolean (-> Bool MatchResult)
  (lambda (value.16) (if value.16 successful-match failed-match)))

(def match-truth? (-> MatchResult Bool)
  (lambda (value.15) (match value.15 ((match-false) #f) ((match-true) #t) ((match-empty) #t))))

(def browse-zero? (lambda (value.14) (= value.14 0)))

(def datum-cadr (lambda (value.13) (datum-car (datum-cdr value.13))))

(def datum-cddr (lambda (value.12) (datum-cdr (datum-cdr value.12))))

(def symbol-pattern (datum-symbol (typed-string->symbol "pattern")))

