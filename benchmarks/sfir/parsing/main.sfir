(def Specification (datatype ()
  (specification
    (count I64 specification-count)
    (path String specification-path)
    (expected Datum specification-expected))))

(def read-specification
  (lambda (port)
    ((lambda (count.2) ((lambda (path) ((lambda (expected) ((lambda () (specification count.2 path expected)))) (read-value! (read port)))) (datum-string-value (read-value! (read port)))))
      (parsing-exact (read-value! (read port))))))

(def configured (call-with-input-file "input.txt" read-specification))

(def configured-count (-> I64) (lambda () (specification-count configured)))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(def hide (All (T) (-> I64 T T)) (lambda (count.1 value) (if (barrier) value (unreachable))))

(def bench (-> I64 I64)
  (lambda (count)
    ((lambda (result) (if (datum=? result (specification-expected configured)) (ann 1 I64) (ann 0 I64)))
      (parsing-benchmark
        (parsing-integer (hide count count))
        (datum-string (hide count (specification-path configured)))))))

(unit)
