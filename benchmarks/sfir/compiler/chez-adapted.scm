    (let ((result (if (= kind 6) (value-cons (value-unspecified) (value-unspecified)) (value-vector (make-vector (vector-length (datum-vector-values source)) (value-unspecified))))))
      (begin
        (ref-set! seen (cons (inward source result) (ref-get seen)))
        (if (= kind 6)
          (begin
            (ref-set! (value-pair-first result) (inward-graph (datum-car source) seen))
            (ref-set! (value-pair-rest result) (inward-graph (datum-cdr source) seen)))
          (inward-vector (datum-vector-values source) (value-vector-vector result) 0 seen))
        result))))

(define inward-vector
  (lambda (source result index seen)
    (if (= index (vector-length source))
      (unit)
      (begin
        (vector-set! result index (inward-graph (vector-ref source index) seen))
        (inward-vector source result (+ index 1) seen)))))

(define value->datum (lambda (source) (outward-graph source (ref (quote ())))))

(define outward-graph
  (lambda (source seen)
    (let ((matched-value.44 source))
      (cond
        ((is-value-null matched-value.44) (let () (datum-null)))
        ((is-value-boolean matched-value.44)
          (let ((x (value-boolean-boolean matched-value.44))) (datum-boolean x)))
        ((is-value-character matched-value.44)
          (let ((x (value-character-character matched-value.44))) (datum-character x)))
        ((is-value-string matched-value.44)
          (let ((x (value-string-string matched-value.44))) (datum-string x)))
        ((is-value-symbol matched-value.44)
          (let ((x (value-symbol-symbol matched-value.44))) (datum-symbol x)))
        ((is-value-number matched-value.44)
          (let ((x (value-number-number matched-value.44))) (datum-number x)))
        ((is-value-bytevector matched-value.44)
          (let ((x (value-bytevector-bytes matched-value.44))) (datum-bytevector x)))
        ((is-value-pair matched-value.44)
          (let ((first (value-pair-first matched-value.44)) (rest (value-pair-rest matched-value.44)))
            (outward-mutable source seen)))
        ((is-value-vector matched-value.44)
          (let ((vector (value-vector-vector matched-value.44))) (outward-mutable source seen)))
        ((is-value-input matched-value.44)
          (let ((identity (value-input-identity matched-value.44)) (port (value-input-port matched-value.44)))
            (datum-symbol (string->symbol "#<input-port>"))))
        ((is-value-output matched-value.44)
          (let ((port (value-output-port matched-value.44)))
            (datum-symbol (string->symbol "#<output-port>"))))
        ((is-value-procedure matched-value.44)
          (let ((identity (value-procedure-identity matched-value.44)) (procedure (value-procedure-procedure matched-value.44)))
            (datum-symbol (string->symbol "#<procedure>"))))
        ((is-value-eof matched-value.44) (let () (datum-symbol (string->symbol "#<eof>"))))
        ((is-value-unspecified matched-value.44)
          (let () (datum-symbol (string->symbol "#<unspecified>"))))
        ((is-value-uninitialized matched-value.44)
          (let () (datum-fail "uninitialized value is not external data")))
        (else
          (host:error
            "SFIR"
            "nonexhaustive control match"
            44
            (debug-source-stack)
            (if (host:record? matched-value.44)
              (host:record-type-name (host:record-rtd matched-value.44))
              "nonrecord")))))))

(define outward-mutable
  (lambda (source seen)
    (let ((matched-value.46 (outward-find source (ref-get seen))))
      (cond
        ((is-outward-found matched-value.46)
          (let ((result (outward-found/value matched-value.46))) result))
        ((is-outward-absent matched-value.46) (let () (outward-node source seen)))
        (else
          (host:error
            "SFIR"
            "nonexhaustive control match"
            46
            (debug-source-stack)
            (if (host:record? matched-value.46)
              (host:record-type-name (host:record-rtd matched-value.46))
              "nonrecord")))))))

(define outward-node
  (lambda (source seen)
    (let ((result (if (value-pair? source) (datum-cons (datum-null) (datum-null)) (datum-vector (make-vector (vector-length (value-vector-vector source)) (datum-null))))))
      (begin
        (ref-set! seen (cons (outward source result) (ref-get seen)))
        (if (value-pair? source)
          (begin
            (datum-set-car! result (outward-graph (value-car source) seen))
            (datum-set-cdr! result (outward-graph (value-cdr source) seen)))
          (outward-vector (value-vector-vector source) (datum-vector-values result) 0 seen))
        result))))

(define outward-vector
  (lambda (source result index seen)
    (if (= index (vector-length source))
      (unit)
      (begin
        (vector-set! result index (outward-graph (vector-ref source index) seen))
        (outward-vector source result (+ index 1) seen)))))

