;; ---- Complete canonical workload and original result predicate ----

(def Specification (datatype ()
  (specification
    (count I64 specification-count)
    (program Value specification-program)
    (target Value specification-target)
    (option Value specification-option)
    (expected Value specification-expected))))

(def read-specification (-> InputPort Specification)
  (lambda (port)
    (begin (let count (integer->i64 (number->integer (datum-number-value (read-value! (read port))))))
      (begin (let program (read-source-value port))
        (begin (let target (read-source-value port))
          (begin (let option (read-source-value port))
            (specification count program target option (read-source-value port))))))))

(def configured (call-with-input-file "input.txt" read-specification))

(def configured-count (-> I64) (lambda () (specification-count configured)))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(def bench (-> I64 I64)
  (lambda (count)
    (begin
      (def repeat (-> I64 Value I64)
        (lambda (index result)
          (if (< index count)
            (match (body/source/ce (if (barrier) (specification-program configured) (unreachable)) (if (barrier) (specification-target configured) (unreachable)) (value-cons (if (barrier) (specification-option configured) (unreachable)) (value-null)))
              ((compiler-ok ignored)
                (begin (let assembly (body/source/asm-output-get)) (repeat (+ index (ann 1 I64)) assembly)))
              ((compiler-aborted marker value) (datum-fail "uncaught compiler abort")))
            (if (value-equal? result (specification-expected configured)) (ann 1 I64) (ann 0 I64)))))
      (repeat (ann 0 I64) (value-boolean #f)))))

(unit)

(def observed-result (-> CompilerResult Value)
  (lambda (result)
    (match result
      ((compiler-ok value) value)
      ((compiler-aborted marker value) (datum-fail "diagnostic escaped all compiler handlers")))))

(def observed-false (-> CompilerResult Unit)
  (lambda (result)
    (begin (let value (observed-result result))
      (if (value-truth? value)
        (datum-fail "expected caught compiler abort")
        (begin (write (value->datum value)) (newline))))))

(def observe-recovery (-> Unit)
  (lambda ()
    (if (value-truth? (observed-result (body/source/ce (specification-program configured) (specification-target configured) (value-cons (specification-option configured) (value-null)))))
      (if (value-equal? (body/source/asm-output-get) (specification-expected configured))
        (begin (write (datum-boolean #t)) (newline))
        (datum-fail "compiler recovery changed the complete assembly"))
      (datum-fail "compiler failed after caught error"))))

(def observe-error-inputs (-> InputPort I64 I64)
  (lambda (port count)
    (begin (let row (read-source-value port))
      (if (value-eof? row)
        count
        (begin
          (observed-false
            (body/source/ce
              (value-car row)
              (value-car (value-cdr row))
              (value-cons (specification-option configured) (value-null))))
          (observe-recovery)
          (observe-error-inputs port (+ count (ann 1 I64))))))))

;; ---- Diagnostics exercise behavior beyond the canonical input ----

(def observe (-> I64)
  (lambda ()
    (begin
      (write (value->datum (observed-result (body/source/probe-compiler-control))))
      (newline)
      (observed-false
        (body/source/with-exception-handling
          (value-procedure
            (ref (unit))
            (function-0 (lambda () (body/source/queue-get! (body/source/queue-empty)))))))
      (observe-recovery)
      (observed-false
        (body/source/with-exception-handling
          (value-procedure (ref (unit)) (function-0 (lambda () (body/source/bbs-limit-err))))))
      (observe-recovery)
      (+ (ann 17 I64) (call-with-input-file "error-inputs.scm" (lambda (port) (observe-error-inputs port (ann 0 I64))))))))

(def observe-fatal (-> I64)
  (lambda ()
    (begin
      (observed-result (body/source/compiler-abort))
      (datum-fail "fatal compiler handler returned"))))
