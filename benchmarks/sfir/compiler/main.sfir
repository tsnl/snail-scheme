(def numeric-i Number (complex-number (exact-scalar (ann 0 I64)) (exact-scalar (ann 1 I64))))

(def numeric-complex? (-> Number Bool)
  (lambda (x)
    (match x
      ((exact-number n) #f)
      ((rational-number n) #f)
      ((inexact-number n) #f)
