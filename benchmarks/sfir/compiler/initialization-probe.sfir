;; Untimed boundary regression. This is not a reduced Compiler benchmark.
(import (sfir base))

(def Value (datatype ()
  (value-number (number I64))
  (value-unspecified)))

(def CompilerResult (datatype ()
  (compiler-ok (value Value))
  (compiler-aborted (target (Ref Unit)) (value Value))))

(def marker (ref (unit)))
(def other-marker (ref (unit)))
(def cell (ref (value-number (ann 0 I64))))
(def alias cell)
(def events (ref (ann 0 I64)))

(def note (-> I64 Unit)
  (lambda (digit)
    (ref-set! events (+ (* (ref-get events) (ann 10 I64)) digit))))

(def completed CompilerResult
  (begin
    (ref-set! cell
      (begin (note (ann 1 I64)) (value-number (ann 7 I64))))
    (note (ann 2 I64))
    (compiler-ok (value-unspecified))))

;; A nested RHS's earlier effect survives; neither abandoned write occurs.
(def nested-rhs (-> CompilerResult)
  (lambda ()
    (begin
      (note (ann 3 I64))
      (match
        (begin
          (note (ann 4 I64))
          (compiler-aborted marker (value-number (ann 99 I64))))
        ((compiler-ok assigned)
          (begin (ref-set! alias assigned) (compiler-ok (value-unspecified))))
        ((compiler-aborted target payload) (compiler-aborted target payload))))))

(def aborted CompilerResult
  (match (nested-rhs)
    ((compiler-ok assigned)
      (begin
        (ref-set! cell assigned)
        (note (ann 5 I64))
        (compiler-ok (value-unspecified))))
    ((compiler-aborted target payload) (compiler-aborted target payload))))

(def success-is-unspecified (-> Bool)
  (lambda ()
    (match completed
      ((compiler-ok value)
        (match value ((value-unspecified) #t) ((value-number ignored) #f)))
      ((compiler-aborted target payload) #f))))

(def abort-keeps-identity (-> Bool)
  (lambda ()
    (match aborted
      ((compiler-ok ignored) #f)
      ((compiler-aborted target payload)
        (if (ref-eq? target other-marker) #f
          (if (ref-eq? target marker)
            (match payload
              ((value-number number) (= number (ann 99 I64)))
              ((value-unspecified) #f))
            #f))))))

(def check (-> I64)
  (lambda ()
    (if (success-is-unspecified)
      (if (abort-keeps-identity)
        (if (= (ref-get events) (ann 1234 I64))
          (match (ref-get alias)
            ((value-number number)
              (if (= number (ann 7 I64)) (ann 42 I64) (ann 0 I64)))
            ((value-unspecified) (ann 0 I64)))
          (ann 0 I64))
        (ann 0 I64))
      (ann 0 I64))))

(if (= (check) (ann 42 I64)) (unit) (unreachable))
