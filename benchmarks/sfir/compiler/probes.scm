;; These observations are outside the canonical worker.  Every variable is
;; prefixed so one-off expansion leaves the upstream bindings undisturbed.
(define (probe-compiler-control)
  (let ((probe-events '())
        (probe-cell 'unchanged)
        (probe-original-handler throw-to-exception-handler))
    (define (probe-note probe-event)
      (set! probe-events (cons probe-event probe-events))
      probe-event)
    (define (probe-call . probe-arguments)
      (probe-note 'invoked)
      probe-arguments)
    (define (probe-run probe-thunk)
      (set! probe-events '())
      (set! probe-cell 'unchanged)
      (let ((probe-result (with-exception-handling probe-thunk)))
        (list probe-result (reverse probe-events) probe-cell
              (eq? probe-original-handler throw-to-exception-handler))))
    (list
      (probe-run (lambda () (probe-note 'before) #f))
      (probe-run (lambda () (probe-note 'before) (compiler-abort) (probe-note 'after)))
      (probe-run (lambda () (set! probe-cell 'changed) (compiler-abort)))
      (probe-run (lambda ()
        (with-exception-handling
          (lambda () (probe-note 'inner) (compiler-abort) (probe-note 'lost-inner)))
        (probe-note 'outer) (compiler-abort) (probe-note 'lost-outer)))
      (probe-run (lambda ()
        (with-exception-handling (lambda () (probe-note 'inner) #f))
        (probe-note 'outer) (compiler-abort)))
      (probe-run (lambda ()
        (let* ((probe-operator (begin (probe-note 'operator) (compiler-abort)))
               (probe-argument (probe-note 'argument)))
          (probe-operator probe-argument))))
      (probe-run (lambda ()
        (probe-call (begin (probe-note 'first) (compiler-abort)) (probe-note 'second))))
      (probe-run (lambda ()
        (probe-call (probe-note 'first) (begin (probe-note 'second) (compiler-abort)))))
      (probe-run (lambda ()
        (set! probe-cell (begin (probe-note 'value) (compiler-abort)))
        (probe-note 'after)))
      (probe-run (lambda ()
        (define probe-first (begin (probe-note 'first) (compiler-abort)))
        (define probe-second (probe-note 'second))
        (probe-note 'body)))
      (probe-run (lambda () (map (lambda (probe-item) (probe-note probe-item) #f) '(a b c))))
      (probe-run (lambda ()
        (map (lambda (probe-item) (probe-note probe-item)
               (if (eq? probe-item 'b) (compiler-abort) probe-item)) '(a b c))
        (probe-note 'after)))
      (probe-run (lambda ()
        (for-each (lambda (probe-item) (probe-note probe-item)
                    (if (eq? probe-item 'b) (compiler-abort) probe-item)) '(a b c))
        (probe-note 'after)))
      (probe-run (lambda ()
        (apply (lambda (probe-item) (probe-note probe-item) (compiler-abort)) '(applied))
        (probe-note 'after)))
      (probe-run (lambda () (compiler-error "diagnostic escape" 'detail) (probe-note 'after))))))
