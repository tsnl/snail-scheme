;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir base) (sfir bytes))

(def cddr (lambda (xs.2) (cdr (cdr xs.2))))

(def length
  (lambda (xs)
    (((lambda () (begin (def loop.7 (lambda (xs.1 n.11) (if (null? xs.1) n.11 (loop.7 (cdr xs.1) (+ n.11 1))))) loop.7)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(def bv-same-bool? (-> Bool Bool Bool)
  (lambda (actual.1 expected.1) (if actual.1 expected.1 (not expected.1))))

(def bv-zero? (lambda (value.3) (= value.3 0)))

(def bv-odd? (lambda (value.2) (not (= (remainder value.2 2) 0))))

(def bv-round-quarter
  (lambda (value)
    ((lambda (whole part) (if ((lambda (value.1) (if value.1 value.1 (if (= part 2) (bv-odd? whole) #f))) (> part 2)) (+ whole 1) whole))
      (quotient value 4)
      (remainder value 4))))

(define-extern bv-write-character "benchmark" "write_character" (-> Char Unit))

(def bv-display (-> String Unit)
  (lambda (text)
    (((lambda () (begin (def loop.6 (lambda (index) (if (= index (string-length text)) (unit) (begin (bv-write-character (string-ref text index)) (loop.6 (+ index 1)) (unit))))) loop.6)))
      0)))

(def bv-newline (lambda () (bv-write-character #\newline)))

(def hide (lambda (count.1 x.1) (hide-i64 x.1)))

(def failed-tests (ref (ann (empty-list ) (List String))))

(def test (-> String Bool Bool Unit)
  (lambda (name actual expected)
    (if (bv-same-bool? actual expected)
      (unit)
      (begin
        (bv-display "******** FAILED TEST ******** ")
        (bv-display name)
        (bv-newline)
        (ref-set! failed-tests (cons name (ref-get failed-tests)))
        (unit)))))

(def string-bytevector-tests (-> I64 I64 Unit)
  (lambda (*random-stress-tests* *random-stress-test-max-size*)
    (begin
      (def test-roundtrip
        (lambda (bvec tostring tobvec)
          ((lambda (s1) ((lambda (b2) ((lambda (s2) ((lambda () (test "round trip of string conversion" (string=? s1 s2) #t)))) (tostring b2))) (tobvec s1)))
            (tostring bvec))))
      (def random
        ((lambda () (begin (def random14 (lambda (n.10) (begin (ref-set! x (remainder (+ (* a (ref-get x)) c) (+ m 1))) (remainder (quotient (ref-get x) 8) n.10)))) (def a 701) (def x (ref 1)) (def c 743483) (def m 524287) (def loop.5 (lambda (q r n.9) (if (bv-zero? q) (remainder r n.9) (loop.5 (quotient q 16384) (+ (* 16384 r) (random14 16384)) n.9)))) (lambda (n.8) (if (< n.8 16384) (random14 n.8) (loop.5 (quotient n.8 16384) (random14 16384) n.8)))))
))
      (def random-bytevector
        (lambda (n.6)
          ((lambda (n.7) ((lambda (bv.2) ((lambda () (((lambda () (begin (def loop.4 (lambda (i.4) (if (= i.4 n.7) bv.2 (begin (bytevector-u8-set! bv.2 i.4 (random 128)) (loop.4 (+ i.4 1)))))) loop.4))) 0)))) (make-bytevector n.7)))
            (random n.6))))
      (def random-bytevector2
        (lambda (n.3)
          ((lambda (n.4) ((lambda (n.5) ((lambda (bv.1) ((lambda () (((lambda () (begin (def loop.3 (lambda (i.3) (if (= i.3 n.5) bv.1 (begin (bytevector-u8-set! bv.1 i.3 (random 128)) (loop.3 (+ i.3 1)))))) loop.3))) 0)))) (make-bytevector n.5))) (if (bv-odd? n.4) (+ n.4 1) n.4)))
            (random n.3))))
      (def random-bytevector4
        (lambda (n)
          ((lambda (n.1) ((lambda (n.2) ((lambda (bv) ((lambda () (((lambda () (begin (def loop.2 (lambda (i.2) (if (= i.2 n.2) bv (begin (bytevector-u8-set! bv i.2 (random 128)) (loop.2 (+ i.2 1)))))) loop.2))) 0)))) (make-bytevector n.2))) (* 4 (bv-round-quarter n.1))))
            (random n))))
      (test-roundtrip (random-bytevector 10) utf8->string string->utf8)
      (((lambda () (begin (def loop.1 (lambda (i.1) (if (= i.1 *random-stress-tests*) (unit) (begin (test-roundtrip (random-bytevector *random-stress-test-max-size*) utf8->string string->utf8) (loop.1 (+ i.1 1)))))) loop.1)))
        0))))

(def input0 (native-input-i64 (ann 0 I32)))

(def input1 (native-input-i64 (ann 1 I32)))

(def input2 (native-input-i64 (ann 2 I32)))

(def bench (-> I64 I64)
  (lambda (count)
    (((lambda () (begin (def loop (lambda (i result) (if (< i count) (begin (string-bytevector-tests (hide count input0) (hide count input1)) (loop (+ i 1) (length (ref-get failed-tests)))) (if (if (> i 0) (= result input2) #f) 1 0)))) loop)))
      0
      0)))

(unit)
