(def attempt
  (lambda (i.2 depth.1)
    (if (= depth.1 (ann 14 I64))
      (begin (ref-set! *answer* (cons (cdr (vector->list *sequence*)) (ref-get *answer*))) #t)
      (if (if (= (ann 1 I64) (vector-ref *board* (vector-ref *a* i.2))) (if (= (ann 1 I64) (vector-ref *board* (vector-ref *b* i.2))) (= (ann 0 I64) (vector-ref *board* (vector-ref *c* i.2))) #f) #f)
