          (((lambda () (begin (def loop.1 (lambda (j depth.2) (if ((lambda (value) (if value value (attempt j depth.2))) (= j (ann 36 I64))) #f (loop.1 (+ j (ann 1 I64)) depth.2)))) loop.1)))
