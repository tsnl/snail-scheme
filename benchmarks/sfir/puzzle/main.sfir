    ((lambda (end.2) (((lambda () (begin (def loop.13 (lambda (k.6) (if ((lambda (value.3) (if value.3 value.3 (if (vector-ref (vector-ref *p* i.8) k.6) (vector-ref *puzzle* (+ j.5 k.6)) #f))) (> k.6 end.2)) (if (> k.6 end.2) #t #f) (loop.13 (+ k.6 1))))) loop.13))) 0))
      (vector-ref *piecemax* i.8))))

(def place
  (lambda (i.7 j.4)
    ((lambda (end.1) (begin (((lambda () (begin (def loop.12 (lambda (k.5) (if (> k.5 end.1) (unit) (begin (if (vector-ref (vector-ref *p* i.7) k.5) (begin (vector-set! *puzzle* (+ j.4 k.5) #t) (unit)) (unit)) (loop.12 (+ k.5 1)))))) loop.12))) 0) (vector-set! *piececount* (vector-ref *class* i.7) (- (vector-ref *piececount* (vector-ref *class* i.7)) 1)) (((lambda () (begin (def loop.11 (lambda (k.4) (if ((lambda (value.2) (if value.2 value.2 (not (vector-ref *puzzle* k.4)))) (> k.4 *size*)) (if (> k.4 *size*) 0 k.4) (loop.11 (+ k.4 1))))) loop.11))) j.4)))
      (vector-ref *piecemax* i.7))))

(def puzzle-remove
  (lambda (i.6 j.3)
    ((lambda (end) (begin (((lambda () (begin (def loop.10 (lambda (k.3) (if (> k.3 end) (unit) (begin (if (vector-ref (vector-ref *p* i.6) k.3) (begin (vector-set! *puzzle* (+ j.3 k.3) #f) (unit)) (unit)) (loop.10 (+ k.3 1)))))) loop.10))) 0) (vector-set! *piececount* (vector-ref *class* i.6) (+ (vector-ref *piececount* (vector-ref *class* i.6)) 1))))
      (vector-ref *piecemax* i.6))))

(def trial
  (lambda (j.2)
    (((lambda () (begin (def candidates (lambda (i.5) (if (> i.5 typemax) (begin (ref-set! *kount* (+ (ref-get *kount*) 1)) #f) (if (if (not (zero? (vector-ref *piececount* (vector-ref *class* i.5)))) (fit i.5 j.2) #f) ((lambda (k.2) (if ((lambda (value.1) (if value.1 value.1 (zero? k.2))) (trial k.2)) (begin (ref-set! *kount* (+ (ref-get *kount*) 1)) #t) (begin (puzzle-remove i.5 j.2) (candidates (+ i.5 1))))) (place i.5 j.2)) (candidates (+ i.5 1)))))) candidates)))
      0)))

(def definePiece
  (lambda (iclass ii jj kk)
    ((lambda (index) (begin (((lambda () (begin (def loop.7 (lambda (i.4) (if (> i.4 ii) (unit) (begin (((lambda () (begin (def loop.8 (lambda (j.1) (if (> j.1 jj) (unit) (begin (((lambda () (begin (def loop.9 (lambda (k.1) (if (> k.1 kk) (unit) (begin (ref-set! index (+ i.4 (* *d* (+ j.1 (* *d* k.1))))) (vector-set! (vector-ref *p* (ref-get *iii*)) (ref-get index) #t) (loop.9 (+ k.1 1)))))) loop.9))) 0) (loop.8 (+ j.1 1)))))) loop.8))) 0) (loop.7 (+ i.4 1)))))) loop.7))) 0) (vector-set! *class* (ref-get *iii*) iclass) (vector-set! *piecemax* (ref-get *iii*) (ref-get index)) (if (not (= (ref-get *iii*) typemax)) (begin (ref-set! *iii* (+ (ref-get *iii*) 1)) (unit)) (unit))))
      (ref 0))))

(def start
  (lambda (size)
    (begin
      (ref-set! *kount* 0)
      (((lambda () (begin (def loop.6 (lambda (m.2) (if (> m.2 size) (unit) (begin (vector-set! *puzzle* m.2 #t) (loop.6 (+ m.2 1)))))) loop.6)))
        0)
      (((lambda () (begin (def loop.3 (lambda (i.3) (if (> i.3 5) (unit) (begin (((lambda () (begin (def loop.4 (lambda (j) (if (> j 5) (unit) (begin (((lambda () (begin (def loop.5 (lambda (k) (if (> k 5) (unit) (begin (vector-set! *puzzle* (+ i.3 (* *d* (+ j (* *d* k)))) #f) (loop.5 (+ k 1)))))) loop.5))) 1) (loop.4 (+ j 1)))))) loop.4))) 1) (loop.3 (+ i.3 1)))))) loop.3)))
        1)
      (((lambda () (begin (def loop.1 (lambda (i.2) (if (> i.2 typemax) (unit) (begin (((lambda () (begin (def loop.2 (lambda (m.1) (if (> m.1 size) (unit) (begin (vector-set! (vector-ref *p* i.2) m.1 #f) (loop.2 (+ m.1 1)))))) loop.2))) 0) (loop.1 (+ i.2 1)))))) loop.1)))
        0)
      (ref-set! *iii* 0)
      (definePiece 0 3 1 0)
      (definePiece 0 1 0 3)
      (definePiece 0 0 3 1)
      (definePiece 0 1 3 0)
      (definePiece 0 3 0 1)
      (definePiece 0 0 1 3)
