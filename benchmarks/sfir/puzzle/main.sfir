      (vector-set! *piececount* 3 1)
      ((lambda (m n) (begin (if (fit 0 m) (ref-set! n (place 0 m)) (puzzle-error)) (if (trial (ref-get n)) (puzzle-count (ref-get *kount*)) puzzle-failure)))
        (+ (* *d* (+ *d* 1)) 1)
