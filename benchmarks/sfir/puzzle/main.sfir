    (((lambda () (begin (def loop (lambda (i result) (if (< i count) (loop (+ i 1) (start (hide count input0))) (if (match result ((puzzle-failed) (= input1 0)) ((puzzle-count value) (if (= input1 2) (= value input2) #f))) 1 0)))) loop)))
      0
      puzzle-failure)))

(unit)
