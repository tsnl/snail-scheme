    (((lambda () (begin (def loop.14 (lambda (n.2 list) (if (zero? n.2) list (loop.14 (- n.2 1) (cons (- n.2 1) list))))) loop.14)))
      n.1
      (empty-list ))))

(def *size* 511)

(def classmax 3)

(def typemax 12)

(def *iii* (ref 0))

(def *kount* (ref 0))

(def *d* 8)

(def *piececount* (make-vector (+ classmax 1) 0))

(def *class* (make-vector (+ typemax 1) 0))

(def *piecemax* (make-vector (+ typemax 1) 0))

(def *puzzle* (make-vector (+ *size* 1) #t))

(def *p* (make-vector (+ typemax 1) (make-vector 0 #t)))

