;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir core))

(define cddr (lambda (xs.2) (cdr (cdr xs.2))))

(define length
  (lambda (xs)
    (((lambda () (begin (define loop.1 (lambda (xs.1 n.1) (if (null? xs.1) n.1 (loop.1 (cdr xs.1) (+ n.1 1))))) loop.1)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(define hide (lambda (count.1 x.2) (if (barrier) x.2 (unreachable))))

(define listn (lambda (n) (if (= n 0) (quote ()) (cons n (listn (- n 1))))))

(define l18 (listn 18))

(define l12 (listn 12))

(define l6 (listn 6))

(define mas
  (lambda (x.1 y.1 z)
    (if (not (shorterp y.1 x.1))
      z
      (mas (mas (cdr x.1) y.1 z) (mas (cdr y.1) z x.1) (mas (cdr z) x.1 y.1)))))

(define shorterp
  (lambda (x y)
    (if (not (null? y)) ((lambda (value) (if value value (shorterp (cdr x) (cdr y)))) (null? x)) #f)))

(define input0 (listn (native-input-i64 (ann 0 I32))))

(define input1 (listn (native-input-i64 (ann 1 I32))))

(define input2 (listn (native-input-i64 (ann 2 I32))))

(define bench (-> I64 I64)
  (lambda (count)
    (length
      (((lambda () (begin (define loop (lambda (i result) (if (< i count) (loop (+ i 1) (mas (hide count input0) (hide count input1) (hide count input2))) result))) loop)))
        0
        (quote ())))))

(unit)
