;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir base))

(def cddr (lambda (xs.2) (cdr (cdr xs.2))))

(def length
  (lambda (xs)
    (((lambda () (begin (def loop.1 (lambda (xs.1 n.1) (if (null? xs.1) n.1 (loop.1 (cdr xs.1) (+ n.1 (ann 1 I64)))))) loop.1)))
      xs
      (ann 0 I64))))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(def hide (lambda (count.1 x.2) (if (barrier) x.2 (unreachable))))

(def listn (lambda (n) (if (= n (ann 0 I64)) (empty-list ) (cons n (listn (- n (ann 1 I64)))))))

(def l18 (listn (ann 18 I64)))

(def l12 (listn (ann 12 I64)))

(def l6 (listn (ann 6 I64)))

(def mas
  (lambda (x.1 y.1 z)
    (if (not (shorterp y.1 x.1))
      z
      (mas (mas (cdr x.1) y.1 z) (mas (cdr y.1) z x.1) (mas (cdr z) x.1 y.1)))))

(def shorterp
  (lambda (x y)
    (if (not (null? y)) ((lambda (value) (if value value (shorterp (cdr x) (cdr y)))) (null? x)) #f)))

(def input0 (listn (native-input-i64 (ann 0 I32))))

(def input1 (listn (native-input-i64 (ann 1 I32))))

(def input2 (listn (native-input-i64 (ann 2 I32))))

(def bench (-> I64 I64)
  (lambda (count)
    (length
      (((lambda () (begin (def loop (lambda (i result) (if (< i count) (loop (+ i (ann 1 I64)) (mas (hide count input0) (hide count input1) (hide count input2))) result))) loop)))
        (ann 0 I64)
        (empty-list )))))

(unit)
