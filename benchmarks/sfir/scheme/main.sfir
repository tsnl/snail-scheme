(define primitive/cddar/1 (-> Value Value) (lambda (a0) (value-cdr (value-cdr (value-car a0)))))

(define primitive/cdddar/1 (-> Value Value)
  (lambda (a0) (value-cdr (value-cdr (value-cdr (value-car a0))))))

(define primitive/cddddr/1 (-> Value Value)
  (lambda (a0) (value-cdr (value-cdr (value-cdr (value-cdr a0))))))

(define primitive/cdddr/1 (-> Value Value) (lambda (a0) (value-cdr (value-cdr (value-cdr a0)))))

(define primitive/cddr/1 (-> Value Value) (lambda (a0) (value-cdr (value-cdr a0))))

(define primitive/cdr/1 (-> Value Value) (lambda (a0) (value-cdr a0)))

(define primitive/ceiling/1 (-> Value Value)
  (lambda (a0) (value-number (numeric-ceiling (value-number-number a0)))))

(define primitive/char->integer/1 (-> Value Value)
