;; Knowledge about primitive procedures.

(define *primitives*
  (primitive-list
   (primitive peval-literal-55 (lambda (args)
                (primitive-and (= (datum-length args) 1)
                     (datum-pair? (datum-car args))
                     (quot (datum-car (datum-car args))))))
   (primitive peval-literal-56 (lambda (args)
                (primitive-and (= (datum-length args) 1)
                     (datum-pair? (datum-car args))
                     (quot (datum-cdr (datum-car args))))))
   (primitive peval-literal-57 (lambda (args)
              (primitive-and (xevery? datum-number? args)
                   (quot (sum args (peval-integer 0))))))
   (primitive peval-literal-58 (lambda (args)
              (primitive-and (xevery? datum-number? args)
                   (quot (product args (peval-integer 1))))))
   (primitive peval-literal-59 (lambda (args)
              (primitive-and (> (datum-length args) 0)
                   (xevery? datum-number? args)
                   (quot (if (datum-null? (datum-cdr args))
                             (peval-negate (datum-car args))
                             (peval-subtract (datum-car args) (sum (datum-cdr args) (peval-integer 0))))))))
   (primitive peval-literal-60 (lambda (args)
              (primitive-and (> (datum-length args) 1)
                   (xevery? datum-number? args)
                   (quot (if (datum-null? (datum-cdr args))
                             (peval-divide (peval-integer 1) (datum-car args))
                             (peval-divide (datum-car args) (product (datum-cdr args) (peval-integer 1))))))))
   (primitive peval-literal-61 (lambda (args)
              (primitive-and (= (datum-length args) 2)
                   (xevery? datum-number? args)
                   (quot (datum-boolean (peval-less? (datum-car args) (datum-cadr args)))))))
   (primitive peval-literal-62 (lambda (args)
              (primitive-and (= (datum-length args) 2)
                   (xevery? datum-number? args)
                   (quot (datum-boolean (peval-number=? (datum-car args) (datum-cadr args)))))))
   (primitive peval-literal-63 (lambda (args)
              (primitive-and (= (datum-length args) 2)
                   (xevery? datum-number? args)
                   (quot (datum-boolean (peval-greater? (datum-car args) (datum-cadr args)))))))
   (primitive peval-literal-64 (lambda (args)
                (primitive-and (= (datum-length args) 2)
                     (quot (datum-boolean (datum-eq? (datum-car args) (datum-cadr args)))))))
   (primitive peval-literal-65 (lambda (args)
                (primitive-and (= (datum-length args) 1)
                     (quot (datum-boolean (not (datum-truth? (datum-car args))))))))
   (primitive peval-literal-66 (lambda (args)
                  (primitive-and (= (datum-length args) 1)
                       (quot (datum-boolean (datum-null? (datum-car args)))))))
   (primitive peval-literal-67 (lambda (args)
                  (primitive-and (= (datum-length args) 1)
                       (quot (datum-boolean (datum-pair? (datum-car args)))))))
   (primitive peval-literal-68 (lambda (args)
                    (primitive-and (= (datum-length args) 1)
                         (quot (datum-boolean (peval-symbol? (datum-car args)))))))
   )
  )

(define (sum-observed lst n)
  (if (datum-null? lst)
      n
      (sum (datum-cdr lst) (peval-add n (datum-car lst)))))

(define (product-observed lst n)
  (if (datum-null? lst)
      n
      (product (datum-cdr lst) (peval-multiply n (datum-car lst)))))

(define (reduce-global-observed name args)
  (primitive-lookup name *primitives* args))

(define (constant-fold-global-observed name exprs)

  (define (flatten args op)
    (peval-cond ((datum-null? args)
           peval-literal-69)
          ((and (datum-pair? (datum-car args)) (datum-eq? (datum-caar args) op))
           (datum-append (flatten (datum-cdar args) op) (flatten (datum-cdr args) op)))
          (else
           (peval-cons (datum-car args) (flatten (datum-cdr args) op)))))

  (let ((args (if (or (datum-eq? name peval-literal-70) (datum-eq? name peval-literal-71));; associative ops
                  (flatten exprs name)
                  exprs)))
    (datum-or (primitive-and (xevery? const-expr? args)
             (reduce-global name (datum-map const-value args)))
        (let ((pattern (arg-pattern args)))
          (let ((non-const (remove-constant args pattern))
                (const (datum-map const-value (extract-constant args pattern))))
            (peval-cond ((datum-eq? name peval-literal-72);; + is commutative
                   (let ((x (reduce-global peval-literal-73 const)))
                     (if (datum-truth? x)
                         (let ((y (const-value x)))
                           (peval-cons peval-literal-74
                                 (if (peval-number=? y (peval-integer 0)) non-const (peval-cons x non-const))))
                         (peval-cons name args))))
                  ((datum-eq? name peval-literal-75);; * is commutative
                   (let ((x (reduce-global peval-literal-76 const)))
                     (if (datum-truth? x)
                         (let ((y (const-value x)))
                           (peval-cons peval-literal-77
                                 (if (peval-number=? y (peval-integer 1)) non-const (peval-cons x non-const))))
                         (peval-cons name args))))
                  ((datum-eq? name peval-literal-78)
                   (peval-cond ((and (const-expr? (datum-cadr args))
                               (datum-null? (const-value (datum-cadr args))))
                          (peval-list peval-literal-79 (datum-car args)))
                         ((and (datum-pair? (datum-cadr args))
                               (datum-eq? (datum-car (datum-cadr args)) peval-literal-80))
                          (peval-cons peval-literal-81 (peval-cons (datum-car args) (datum-cdr (datum-cadr args)))))
                         (else
                          (peval-cons name args))))
                  (else
                   (peval-cons name args))))))))

