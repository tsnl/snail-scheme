;;; PEVAL -- A simple partial evaluator for Scheme, written by Marc Feeley.



;;------------------------------------------------------------------------------

;; Utilities

(define (xevery?-observed pred? l)
  (let loop ((l l))
    (or (datum-null? l) (and (pred? (datum-car l)) (loop (datum-cdr l))))))

(define (some?-observed pred? l)
  (let loop ((l l))
    (if (datum-null? l) #f (or (pred? (datum-car l)) (loop (datum-cdr l))))))

(define (map2-observed f l1 l2)
  (let loop ((l1 l1) (l2 l2))
    (if (datum-pair? l1)
        (peval-cons (f (datum-car l1) (datum-car l2)) (loop (datum-cdr l1) (datum-cdr l2)))
        peval-literal-0)))

(define (get-last-pair-observed l)
  (let loop ((l l))
    (let ((x (datum-cdr l))) (if (datum-pair? x) (loop x) l))))

;;------------------------------------------------------------------------------
;;
;; The partial evaluator.

(define (partial-evaluate-observed proc args)
  (peval (alphatize proc peval-literal-1) args))

(define (alphatize-observed exp env);; return a copy of 'exp' where each bound var has
  (define (alpha exp);; been renamed (to prevent aliasing problems)
    (peval-cond ((const-expr? exp)
           (quot (const-value exp)))
          ((peval-symbol? exp)
           (let ((x (datum-assq exp env))) (if (datum-truth? x) (datum-cdr x) exp)))
          ((or (datum-eq? (datum-car exp) peval-literal-2) (datum-eq? (datum-car exp) peval-literal-3))
           (peval-cons (datum-car exp) (datum-map alpha (datum-cdr exp))))
          ((or (datum-eq? (datum-car exp) peval-literal-4) (datum-eq? (datum-car exp) peval-literal-5))
           (let ((new-env (new-variables (datum-map datum-car (datum-cadr exp)) env)))
             (peval-list (datum-car exp)
                   (datum-map (lambda (x)
                          (peval-list (datum-cdr (datum-assq (datum-car x) new-env))
                                (if (datum-eq? (datum-car exp) peval-literal-6)
                                    (alpha (datum-cadr x))
                                    (alphatize (datum-cadr x) new-env))))
                        (datum-cadr exp))
                   (alphatize (datum-caddr exp) new-env))))
          ((datum-eq? (datum-car exp) peval-literal-7)
           (let ((new-env (new-variables (datum-cadr exp) env)))
             (peval-list peval-literal-8
                   (datum-map (lambda (x) (datum-cdr (datum-assq x new-env))) (datum-cadr exp))
                   (alphatize (datum-caddr exp) new-env))))
          (else
           (datum-map alpha exp))))
  (alpha exp))

(define (const-expr?-observed expr);; is 'expr' a constant expression?
  (and (not (peval-symbol? expr))
       (or (not (datum-pair? expr))
           (datum-eq? (datum-car expr) peval-literal-9))))

(define (const-value-observed expr);; return the value of a constant expression
  (if (datum-pair? expr);; then it must be a quoted constant
      (datum-cadr expr)
      expr))

(define (quot-observed val);; make a quoted constant whose value is 'val'
  (peval-list peval-literal-10 val))

(define (new-variables-observed parms env)
  (datum-append (datum-map (lambda (x) (peval-cons x (new-variable x))) parms) env))

(define *current-num* (ref 0))

(define (new-variable-observed name)
  (begin (observer-tick! 29) (ref-set! *current-num* (+ (ref-get *current-num*) 1)))
  (peval-symbol
   (string-append (peval-symbol-text name)
                  "_"
                  (i64->string (ref-get *current-num*)))))

;;------------------------------------------------------------------------------
;;
;; (peval proc args) will transform a procedure that is known to be called
;; with constants as some of its arguments into a specialized procedure that
;; is 'equivalent' but accepts only the non-constant parameters.  'proc' is the
;; list representation of a lambda-expression and 'args' is a list of values,
;; one for each parameter of the lambda-expression.  A special value (i.e.
;; 'not-constant') is used to indicate an argument that is not a constant.
;; The returned procedure is one that has as parameters the parameters of the
;; original procedure which are NOT passed constants.  Constants will have been
;; substituted for the constant parameters that are referenced in the body
;; of the procedure.
;;
;; For example:
;;
;;   (peval
;;     '(lambda (x y z) (f z x y));; the procedure
;;     (list 1 not-constant #t));; the knowledge about x, y and z
;;
;; will return: (lambda (y) (f '#t '1 y))

(define (peval-observed proc args)
  (simplify!
   (let ((parms (datum-cadr proc));; get the parameter list
         (body (datum-caddr proc)));; get the body of the procedure
     (peval-list peval-literal-11
           (remove-constant parms args);; remove the constant parameters
           (beta-subst;; in the body, replace variable refs to the constant
            body;; parameters by the corresponding constant
            (map2 (lambda (x y) (if (not-constant? y) peval-literal-12 (peval-cons x (quot y))))
                  parms
                  args))))))

(define not-constant (peval-list peval-literal-13));; special value indicating non-constant parms.

(define (not-constant?-observed x) (datum-eq? x not-constant))

(define (remove-constant-observed l a);; remove from list 'l' all elements whose
  (peval-cond ((datum-null? l);; corresponding element in 'a' is a constant
         peval-literal-14)
        ((not-constant? (datum-car a))
         (peval-cons (datum-car l) (remove-constant (datum-cdr l) (datum-cdr a))))
        (else
         (remove-constant (datum-cdr l) (datum-cdr a)))))

(define (extract-constant-observed l a);; extract from list 'l' all elements whose
  (peval-cond ((datum-null? l);; corresponding element in 'a' is a constant
         peval-literal-15)
        ((not-constant? (datum-car a))
         (extract-constant (datum-cdr l) (datum-cdr a)))
        (else
         (peval-cons (datum-car l) (extract-constant (datum-cdr l) (datum-cdr a))))))

(define (beta-subst-observed exp env);; return a modified 'exp' where each var named in
  (define (bs exp);; 'env' is replaced by the corresponding expr (it
    (peval-cond ((const-expr? exp);; is assumed that the code has been alphatized)
           (quot (const-value exp)))
          ((peval-symbol? exp)
           (let ((x (datum-assq exp env)))
             (if (datum-truth? x) (datum-cdr x) exp)))
          ((or (datum-eq? (datum-car exp) peval-literal-16) (datum-eq? (datum-car exp) peval-literal-17))
           (peval-cons (datum-car exp) (datum-map bs (datum-cdr exp))))
          ((or (datum-eq? (datum-car exp) peval-literal-18) (datum-eq? (datum-car exp) peval-literal-19))
           (peval-list (datum-car exp)
                 (datum-map (lambda (x) (peval-list (datum-car x) (bs (datum-cadr x)))) (datum-cadr exp))
                 (bs (datum-caddr exp))))
          ((datum-eq? (datum-car exp) peval-literal-20)
           (peval-list peval-literal-21
                 (datum-cadr exp)
                 (bs (datum-caddr exp))))
          (else
           (datum-map bs exp))))
  (bs exp))

;;------------------------------------------------------------------------------
;;
;; The expression simplifier.

(define (simplify!-observed exp);; simplify the expression 'exp' destructively (it
  ;; is assumed that the code has been alphatized)
  (define (simp! where env)

    (define (s! where)
      (let ((exp (datum-car where)))

        (peval-cond ((const-expr? exp));; leave constants the way they are

              ((peval-symbol? exp));; leave variable references the way they are

              ((datum-eq? (datum-car exp) peval-literal-22);; dead code removal for conditionals
               (s! (datum-cdr exp));; simplify the predicate
               (if (const-expr? (datum-cadr exp));; is the predicate a constant?
                   (begin
                     (begin (observer-tick! 30) (datum-set-car! where
                               (if (peval-member? (const-value (datum-cadr exp)) peval-literal-23);; false?
                                   (if (= (datum-length exp) 3) peval-literal-24 (datum-cadddr exp))
                                   (datum-caddr exp))))
                     (s! where))
                   (for-each! s! (datum-cddr exp))));; simplify consequent and alt.

              ((datum-eq? (datum-car exp) peval-literal-25)
               (for-each! s! (datum-cdr exp))
               (let loop ((exps exp));; remove all useless expressions
                 (if (not (datum-null? (datum-cddr exps)));; not last expression?
                     (let ((x (datum-cadr exps)))
                       (loop (if (or (const-expr? x)
                                     (peval-symbol? x)
                                     (and (datum-pair? x) (datum-eq? (datum-car x) peval-literal-26)))
                                 (begin (begin (observer-tick! 31) (datum-set-cdr! exps (datum-cddr exps))) exps)
                                 (datum-cdr exps))))))
               (if (datum-null? (datum-cddr exp));; only one expression in the begin?
                   (begin (observer-tick! 32) (datum-set-car! where (datum-cadr exp)))))

              ((or (datum-eq? (datum-car exp) peval-literal-27) (datum-eq? (datum-car exp) peval-literal-28))
               (let ((new-env (peval-cons exp env)))
                 (define (keep i)
                   (if (>= i (datum-length (datum-cadar where)))
                       peval-literal-29
                       (let* ((var (datum-car (peval-list-ref (datum-cadar where) i)))
                              (val (datum-cadr (datum-assq var (datum-cadar where))))
                              (refs (ref-count (datum-car where) var))
                              (self-refs (ref-count val var))
                              (total-refs (- (reference-total refs) (reference-total self-refs)))
                              (oper-refs (- (reference-operator refs) (reference-operator self-refs))))
                         (peval-cond ((= total-refs 0)
                                (keep (+ i 1)))
                               ((or (const-expr? val)
                                    (peval-symbol? val)
                                    (and (datum-pair? val)
                                         (datum-eq? (datum-car val) peval-literal-30)
                                         (= total-refs 1)
                                         (= oper-refs 1)
                                         (= (reference-total self-refs) 0))
                                    (and (reference-always refs)
                                         (= total-refs 1)))
                                (begin (observer-tick! 33) (datum-set-car! where
                                          (beta-subst (datum-car where)
                                                      (peval-list (peval-cons var val)))))
                                (keep (+ i 1)))
                               (else
                                (peval-cons var (keep (+ i 1))))))))
                 (simp! (datum-cddr exp) new-env)
                 (for-each! (lambda (x) (simp! (datum-cdar x) new-env)) (datum-cadr exp))
                 (let ((to-keep (keep 0)))
                   (if (< (datum-length to-keep) (datum-length (datum-cadar where)))
                       (begin
                         (if (datum-null? to-keep)
                             (begin (observer-tick! 34) (datum-set-car! where (datum-caddar where)))
                             (begin (observer-tick! 35) (datum-set-car! (datum-cdar where)
                                       (datum-map (lambda (v) (datum-assq v (datum-cadar where))) to-keep))))
                         (s! where))
                       (if (datum-null? to-keep)
                           (begin (observer-tick! 36) (datum-set-car! where (datum-caddar where))))))))

              ((datum-eq? (datum-car exp) peval-literal-31)
               (simp! (datum-cddr exp) (peval-cons exp env)))

              (else
               (for-each! s! exp)
               (peval-cond ((peval-symbol? (datum-car exp));; is the operator position a var ref?
                      (let ((frame (binding-frame (datum-car exp) env)))
                        (if (datum-truth? frame);; is it a bound variable?
                            (let ((proc (bound-expr (datum-car exp) frame)))
                              (if (and (datum-pair? proc)
                                       (datum-eq? (datum-car proc) peval-literal-32)
                                       (some? const-expr? (datum-cdr exp)))
                                  (let* ((args (arg-pattern (datum-cdr exp)))
                                         (new-proc (peval proc args))
                                         (new-args (remove-constant (datum-cdr exp) args)))
                                    (begin (observer-tick! 37) (datum-set-car! where
                                              (peval-cons (add-binding new-proc frame (datum-car exp))
                                                    new-args))))))
                            (begin (observer-tick! 38) (datum-set-car! where
                                      (constant-fold-global (datum-car exp) (datum-cdr exp)))))))
                     ((not (datum-pair? (datum-car exp))))
                     ((datum-eq? (datum-caar exp) peval-literal-33)
                      (begin (observer-tick! 39) (datum-set-car! where
                                (peval-list peval-literal-34
                                      (map2 (lambda (x y) (peval-list x y)) (datum-cadar exp) (datum-cdr exp))
                                      (datum-caddar exp))))
                      (s! where)))))))

    (s! where))

  (define (remove-empty-calls! where env)

    (define (rec! where)
      (let ((exp (datum-car where)))

        (peval-cond ((const-expr? exp))
              ((peval-symbol? exp))
              ((datum-eq? (datum-car exp) peval-literal-35)
               (rec! (datum-cdr exp))
               (rec! (datum-cddr exp))
               (rec! (datum-cdddr exp)))
              ((datum-eq? (datum-car exp) peval-literal-36)
               (for-each! rec! (datum-cdr exp)))
              ((or (datum-eq? (datum-car exp) peval-literal-37) (datum-eq? (datum-car exp) peval-literal-38))
               (let ((new-env (peval-cons exp env)))
                 (remove-empty-calls! (datum-cddr exp) new-env)
                 (for-each! (lambda (x) (remove-empty-calls! (datum-cdar x) new-env))
                            (datum-cadr exp))))
              ((datum-eq? (datum-car exp) peval-literal-39)
               (rec! (datum-cddr exp)))
              (else
               (for-each! rec! (datum-cdr exp))
               (if (and (datum-null? (datum-cdr exp)) (peval-symbol? (datum-car exp)))
                   (let ((frame (binding-frame (datum-car exp) env)))
                     (if (datum-truth? frame);; is it a bound variable?
                         (let ((proc (bound-expr (datum-car exp) frame)))
                           (if (and (datum-pair? proc)
                                    (datum-eq? (datum-car proc) peval-literal-40))
                               (begin
                                 (begin (observer-tick! 40) (ref-set! changed? #t))
                                 (begin (observer-tick! 41) (datum-set-car! where (datum-caddr proc)))))))))))))

    (rec! where))

  (define changed? (ref #f))

  (let ((x (peval-list exp)))
    (let loop ()
      (begin (observer-tick! 42) (ref-set! changed? #f))
      (simp! x peval-literal-41)
      (remove-empty-calls! x peval-literal-42)
      (if (ref-get changed?) (loop) (datum-car x)))))

(define (ref-count-observed exp var);; compute how many references to variable 'var'
  (let ((total (ref 0));; are contained in 'exp'
        (oper (ref 0))
        (always-evaled (ref #t)))
    (define (rc exp ae)
      (peval-cond ((const-expr? exp))
            ((peval-symbol? exp)
             (if (datum-eq? exp var)
                 (begin
                   (begin (observer-tick! 43) (ref-set! total (+ (ref-get total) 1)))
                   (begin (observer-tick! 44) (ref-set! always-evaled (and ae (ref-get always-evaled)))))))
            ((datum-eq? (datum-car exp) peval-literal-43)
             (rc (datum-cadr exp) ae)
             (peval-for-each (lambda (x) (rc x #f)) (datum-cddr exp)))
            ((datum-eq? (datum-car exp) peval-literal-44)
             (peval-for-each (lambda (x) (rc x ae)) (datum-cdr exp)))
            ((or (datum-eq? (datum-car exp) peval-literal-45) (datum-eq? (datum-car exp) peval-literal-46))
             (peval-for-each (lambda (x) (rc (datum-cadr x) ae)) (datum-cadr exp))
             (rc (datum-caddr exp) ae))
            ((datum-eq? (datum-car exp) peval-literal-47)
             (rc (datum-caddr exp) #f))
            (else
             (peval-for-each (lambda (x) (rc x ae)) exp)
             (if (peval-symbol? (datum-car exp))
                 (if (datum-eq? (datum-car exp) var) (begin (observer-tick! 45) (ref-set! oper (+ (ref-get oper) 1))))))))
    (rc exp #t)
    (reference-counts (ref-get total) (ref-get oper) (ref-get always-evaled))))

(define (binding-frame-observed var env)
  (peval-cond ((datum-null? env) (datum-boolean #f))
        ((or (datum-eq? (datum-caar env) peval-literal-48) (datum-eq? (datum-caar env) peval-literal-49))
         (if (datum-truth? (datum-assq var (datum-cadar env))) (datum-car env) (binding-frame var (datum-cdr env))))
        ((datum-eq? (datum-caar env) peval-literal-50)
         (if (peval-member? var (datum-cadar env)) (datum-car env) (binding-frame var (datum-cdr env))))
        (else
         (datum-fail "ill-formed environment"))))

(define (bound-expr-observed var frame)
  (peval-cond ((or (datum-eq? (datum-car frame) peval-literal-51) (datum-eq? (datum-car frame) peval-literal-52))
         (datum-cadr (datum-assq var (datum-cadr frame))))
        ((datum-eq? (datum-car frame) peval-literal-53)
         not-constant)
        (else
         (datum-fail "ill-formed frame"))))

(define (add-binding-observed val frame name)
  (define (find-val val bindings)
    (peval-cond ((datum-null? bindings) (datum-boolean #f))
          ((datum=? val (datum-cadar bindings));; *kludge* equal? is not exactly what
           (datum-caar bindings));; we want...
          (else
           (find-val val (datum-cdr bindings)))))
  (datum-or (find-val val (datum-cadr frame))
      (let ((var (new-variable name)))
        (begin (observer-tick! 46) (datum-set-cdr! (get-last-pair (datum-cadr frame)) (peval-list (peval-list var val))))
        var)))

(define (for-each!-observed proc! l);; call proc! on each CONS CELL in the list 'l'
  (if (not (datum-null? l))
      (begin (proc! l) (for-each! proc! (datum-cdr l)))))

(define (arg-pattern-observed exps);; return the argument pattern (i.e. the list of
  (if (datum-null? exps);; constants in 'exps' but with the not-constant
      peval-literal-54;; value wherever the corresponding expression in
      (peval-cons (if (const-expr? (datum-car exps));; 'exps' is not a constant)
                (const-value (datum-car exps))
                not-constant)
            (arg-pattern (datum-cdr exps)))))

