(define const-expr? (-> Datum Bool)
  (lambda (expr.1) (begin (observer-tick! 6) (const-expr?-observed expr.1))))

(define const-value (-> Datum Datum)
  (lambda (expr) (begin (observer-tick! 7) (const-value-observed expr))))

(define quot (-> Datum Datum) (lambda (val.1) (begin (observer-tick! 8) (quot-observed val.1))))

(define new-variables (-> Datum Datum Datum)
  (lambda (parms env.2) (begin (observer-tick! 9) (new-variables-observed parms env.2))))

(define new-variable (-> Datum Datum)
  (lambda (name.3)
    (begin (observer-tick! 10) (observer-name name.3 (new-variable-observed name.3)))))

(define peval (-> Datum Datum Datum)
  (lambda (proc.1 args.2) (begin (observer-tick! 11) (peval-observed proc.1 args.2))))

(define not-constant? (-> Datum Bool)
  (lambda (x) (begin (observer-tick! 12) (not-constant?-observed x))))

(define remove-constant (-> Datum Datum Datum)
  (lambda (l.2 a.1) (begin (observer-tick! 13) (remove-constant-observed l.2 a.1))))

(define extract-constant (-> Datum Datum Datum)
  (lambda (l.1 a) (begin (observer-tick! 14) (extract-constant-observed l.1 a))))

(define beta-subst (-> Datum Datum Datum)
  (lambda (exp.2 env.1) (begin (observer-tick! 15) (beta-subst-observed exp.2 env.1))))

(define simplify! (-> Datum Datum)
  (lambda (exp.1) (begin (observer-tick! 16) (simplify!-observed exp.1))))

(define ref-count (-> Datum Datum ReferenceCounts)
  (lambda (exp var.2) (begin (observer-tick! 17) (ref-count-observed exp var.2))))

(define binding-frame (-> Datum Datum Datum)
  (lambda (var.1 env) (begin (observer-tick! 18) (binding-frame-observed var.1 env))))

(define bound-expr (-> Datum Datum Datum)
  (lambda (var frame.1) (begin (observer-tick! 19) (bound-expr-observed var frame.1))))

(define add-binding (-> Datum Datum Datum Datum)
  (lambda (val frame name.2) (begin (observer-tick! 20) (add-binding-observed val frame name.2))))

(define for-each! (-> (-> Datum Unit) Datum Unit)
  (lambda (proc! l) (begin (observer-tick! 21) (for-each!-observed proc! l))))

(define arg-pattern (-> Datum Datum)
  (lambda (exps) (begin (observer-tick! 22) (arg-pattern-observed exps))))

(define sum (-> Datum Datum Datum)
  (lambda (lst.1 n.1) (begin (observer-tick! 23) (sum-observed lst.1 n.1))))

(define product (-> Datum Datum Datum)
  (lambda (lst n) (begin (observer-tick! 24) (product-observed lst n))))

(define reduce-global (-> Datum Datum Datum)
  (lambda (name.1 args.1) (begin (observer-tick! 25) (reduce-global-observed name.1 args.1))))

(define constant-fold-global (-> Datum Datum Datum)
  (lambda (name exprs) (begin (observer-tick! 26) (constant-fold-global-observed name exprs))))

(define try-peval (-> Datum Datum Datum)
  (lambda (proc args)
    (begin
      (observer-tick! 27)
      (observer-case-start!)
      (observer-case-result (try-peval-observed proc args)))))

(define test (-> Datum Datum Datum)
  (lambda (input1.1 input2) (begin (observer-tick! 28) (test-observed input1.1 input2))))

(define-data Specification
  (specification
    (count I64 specification-count)
    (procedure Datum specification-procedure)
    (arguments Datum specification-arguments)
    (expected Datum specification-expected)))

(define read-specification
  (lambda (port)
    ((lambda (count.3) ((lambda (procedure) ((lambda (arguments) ((lambda (expected.1) ((lambda () (specification count.3 procedure arguments expected.1)))) (read-value! (read port)))) (read-value! (read port)))) (read-value! (read port))))
      (exact-count (read-value! (read port))))))

(define exact-count
  (lambda (value.3)
    (match (datum-number-value value.3)
      ((exact-number count.2) count.2)
      ((rational-number value.1) (datum-fail "peval: count must be an exact I64"))
      ((inexact-number value.2) (datum-fail "peval: count must be exact"))
      ((complex-number real imaginary) (datum-fail "peval: count must be exact")))))

(define configured (call-with-input-file "input.txt" read-specification))

(define input0 (specification-procedure configured))

(define input1 (specification-arguments configured))

(define expected (specification-expected configured))

(define configured-count (-> I64) (lambda () (specification-count configured)))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define hide (lambda (count.1 value) (if (barrier) value (unreachable))))

(define correct-result?
  (lambda (result.1 output)
    (if (peval-list? result.1)
      (if (= (datum-length result.1) 10) (datum=? (peval-list-ref result.1 9) output) #f)
      #f)))

(define bench (-> I64 I64)
  (lambda (count)
    (((lambda () (begin (define loop (lambda (index result) (if (< index count) (loop (+ index 1) (test (hide count input0) (hide count input1))) (if (correct-result? result expected) 1 0)))) loop)))
      0
      (datum-boolean #f))))

(define fresh-name-count (lambda () (ref-get *current-num*)))

(unit)
