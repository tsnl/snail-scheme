;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir base))

(def cddr (lambda (xs.3) (cdr (cdr xs.3))))

(def length
  (lambda (xs.1)
    (((lambda () (begin (def loop.3 (lambda (xs.2 n.2) (if (null? xs.2) n.2 (loop.3 (cdr xs.2) (+ n.2 (ann 1 I64)))))) loop.3)))
      xs.1
      (ann 0 I64))))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(def list (lambda elements elements))

(def append (lambda (xs ys) (if (null? xs) ys (cons (car xs) (append (cdr xs) ys)))))

(def hide (lambda (count.2 x.2) (hide-i64 x.2)))

(def count
  (lambda (r.1 i.3 step.1 x.1 y.1)
    ((lambda (max-count radius^2) ((lambda (cr ci) (((lambda () (begin (def loop.2 (lambda (zr zi c) (if (= c max-count) c ((lambda (zr^2 zi^2) (if (> (+ zr^2 zi^2) radius^2) c ((lambda (new-zr new-zi) (loop.2 new-zr new-zi (+ c (ann 1 I64)))) (+ (- zr^2 zi^2) cr) (+ (* 2.0 (* zr zi)) ci)))) (* zr zr) (* zi zi))))) loop.2))) cr ci (ann 0 I64))) (+ r.1 (* (i64->f64 x.1) step.1)) (+ i.3 (* (i64->f64 y.1) step.1))))
      (ann 64 I64)
      16.0)))

(def mbrot
  (lambda (matrix.1 r i.2 step n.1)
    (((lambda () (begin (def loop1 (lambda (y) (if (>= y (ann 0 I64)) (begin (((lambda () (begin (def loop2 (lambda (x) (if (>= x (ann 0 I64)) (begin (vector-set! (vector-ref matrix.1 x) y (count r i.2 step x y)) (loop2 (- x (ann 1 I64)))) (loop1 (- y (ann 1 I64)))))) loop2))) (- n.1 (ann 1 I64))) (unit)) (unit)))) loop1)))
      (- n.1 (ann 1 I64)))))

(def test
  (lambda (n)
    ((lambda (matrix) (begin (((lambda () (begin (def loop.1 (lambda (i.1) (if (>= i.1 (ann 0 I64)) (begin (vector-set! matrix i.1 (make-vector n (ann 0 I64))) (loop.1 (- i.1 (ann 1 I64))) (unit)) (unit)))) loop.1))) (- n (ann 1 I64))) (mbrot matrix -1.0 -0.5 0.005 n) (vector-ref (vector-ref matrix (ann 0 I64)) (ann 0 I64))))
      (make-vector n (empty-vector)))))

(def input0 (native-input-i64 (ann 0 I32)))

(def bench (-> I64 I64)
  (lambda (count.1)
    (((lambda () (begin (def loop (lambda (i result) (if (< i count.1) (loop (+ i (ann 1 I64)) (test (hide count.1 input0))) result))) loop)))
      (ann 0 I64)
      (ann 0 I64))))

(unit)
