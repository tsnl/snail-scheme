  (lambda (number-of-cols folder.2 state.5)
    (if (zero? number-of-cols)
      (folder.2 (empty-list ) state.5)
      (fold-over-rows
        (- number-of-cols 1)
        (lambda (tail.1 state.3) (folder.2 (cons -1 tail.1) state.3))
        (fold-over-rows
          (- number-of-cols 1)
          (lambda (tail.2 state.4) (folder.2 (cons 1 tail.2) state.4))
          state.5)))))

(def fold-over-subs-of-size (All (T S) (-> (List T) I64 (-> (List T) S S) S S))
  (lambda (universe size folder state)
    ((lambda (usize) (if (< usize size) state (((lambda () (begin (def _-*- (lambda (size.1 universe.1 folder.1 csize state.2) (if (zero? csize) (folder.1 universe.1 state.2) (if (zero? size.1) (folder.1 (empty-list ) state.2) ((lambda (first-u rest-u) (_-*- size.1 rest-u folder.1 (- csize 1) (_-*- (- size.1 1) rest-u (lambda (tail state.1) (folder.1 (cons first-u tail) state.1)) csize state.2))) (car universe.1) (cdr universe.1)))))) _-*-))) size universe folder (- usize size) state)))
      (length universe))))

(define-extern native-expected-i64 "benchmark" "expected_i64" (-> I64 I64))

(def expected-cursor (ref 0))

(def read-expected-integer
  (lambda ()
    ((lambda (value.1) (begin (ref-set! expected-cursor (+ 1 (ref-get expected-cursor))) value.1))
      (native-expected-i64 (ref-get expected-cursor)))))

(def read-expected-row
  (lambda (count.4)
    (if (= count.4 0)
      (empty-list )
      ((lambda (head.2) (cons head.2 (read-expected-row (- count.4 1)))) (read-expected-integer)))))

(def read-expected-matrix
  (lambda (count.3)
    (if (= count.3 0)
      (empty-list )
      ((lambda (head.1) (cons head.1 (read-expected-matrix (- count.3 1))))
        (read-expected-row (read-expected-integer))))))

(def read-expected-answers
  (lambda (count.2)
    (if (= count.2 0)
      (empty-list )
      ((lambda (head) (cons head (read-expected-answers (- count.2 1))))
        (if (= (read-expected-integer) 0)
          (matrix-answer (read-expected-matrix (read-expected-integer)))
          (marker-answer (read-expected-string (read-expected-integer))))))))

(def read-expected-string
  (lambda (count.1)
    ((lambda (value) (((lambda () (begin (def loop.1 (lambda (index) (if (= index count.1) value (begin (string-set! value index (integer->char (read-expected-integer))) (loop.1 (+ index 1)))))) loop.1))) 0))
      (make-string count.1))))

(def input0 (native-input-i64 (ann 0 I32)))

(def input1 (native-input-i64 (ann 1 I32)))

(def expected-false? (= (native-input-i64 (ann 2 I32)) 1))

(def expected (read-expected-answers (read-expected-integer)))

(def bench (-> I64 I64)
  (lambda (count)
    (if (<= count 0)
      (if expected-false? 1 0)
      (((lambda () (begin (def loop (lambda (i result) (if (< i count) (loop (+ i 1) (really-go (hide count input0) (hide count input1))) (if (if (not expected-false?) (same-answers? result expected) #f) 1 0)))) loop)))
        1
        (really-go (hide count input0) (hide count input1))))))

(unit)
