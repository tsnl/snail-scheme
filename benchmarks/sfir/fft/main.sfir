(import (sfir base))

(def cddr (lambda (xs.2) (cdr (cdr xs.2))))

(def length
  (lambda (xs)
    (((lambda () (begin (def loop.3 (lambda (xs.1 n.2) (if (null? xs.1) n.2 (loop.3 (cdr xs.1) (+ n.2 1))))) loop.3)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(define-extern native-vector-length "benchmark" "vector_length" (-> I32 I64))

(define-extern native-vector-f64 "benchmark" "vector_f64" (-> I32 I64 F64))

(def input-vector
  (lambda (index)
    ((lambda (n.1) ((lambda (result.1) (begin (((lambda () (begin (def loop.2 (lambda (i.4) (if (< i.4 n.1) (begin (vector-set! result.1 i.4 (native-vector-f64 index i.4)) (loop.2 (+ i.4 1)) (unit)) (unit)))) loop.2))) 0) result.1)) (make-vector n.1 0.0)))
      (native-vector-length index))))

(def inexact (lambda (value.1) (i64->f64 value.1)))

(define-extern sin "math" "snail_sin" (-> F64 F64))

(define-extern native-expected-length "benchmark" "expected_length" (-> I64))

(define-extern native-expected-f64 "benchmark" "expected_f64" (-> I64 F64))

(define-extern native-tolerance "benchmark" "tolerance" (-> F64))

(def close-f64? (-> F64 F64 Bool)
  (lambda (actual expected)
    ((lambda (difference scale) ((lambda (error) (<= error (* (native-tolerance) (if (< scale 1.0) 1.0 scale)))) (if (< difference 0.0) (- 0.0 difference) difference)))
      (- actual expected)
      (if (< expected 0.0) (- 0.0 expected) expected))))

(def fft-probe (-> I64 I64)
  (lambda (count.2)
    ((lambda (data.3) (begin (four1 data.3) (if (if (= (vector-length data.3) (native-expected-length)) (((lambda () (begin (def loop.1 (lambda (i.3) ((lambda (value) (if value value (if (close-f64? (vector-ref data.3 i.3) (native-expected-f64 i.3)) (loop.1 (+ i.3 1)) #f))) (= i.3 (vector-length data.3))))) loop.1))) 0) #f) 1 0)))
      (input-vector (ann 2 I32)))))

(def hide (lambda (count.1 x.1) (if (barrier) x.1 (unreachable))))

(def four1
  (lambda (data.2)
    ((lambda (n pi*2) (begin (((lambda () (begin (def loop1 (lambda (i.2 j.1) (if (< i.2 n) (begin (if (< i.2 j.1) (begin ((lambda (temp.1) (begin (vector-set! data.2 i.2 (vector-ref data.2 j.1)) (vector-set! data.2 j.1 temp.1))) (vector-ref data.2 i.2)) ((lambda (temp) (begin (vector-set! data.2 (+ i.2 1) (vector-ref data.2 (+ j.1 1))) (vector-set! data.2 (+ j.1 1) temp))) (vector-ref data.2 (+ i.2 1))) (unit)) (unit)) (((lambda () (begin (def loop2 (lambda (m.1 j.2) (if (if (>= m.1 2) (>= j.2 m.1) #f) (loop2 (quotient m.1 2) (- j.2 m.1)) (loop1 (+ i.2 2) (+ j.2 m.1))))) loop2))) (quotient n 2) j.1) (unit)) (unit)))) loop1))) 0 0) (((lambda () (begin (def loop3 (lambda (mmax) (if (< mmax n) (begin ((lambda (theta) ((lambda (wpr) ((lambda (wpi) ((lambda () (begin (((lambda () (begin (def loop4 (lambda (wr wi m) (if (< m mmax) (begin (((lambda () (begin (def loop5 (lambda (i.1) (if (< i.1 n) ((lambda (j) ((lambda (tempr) ((lambda (tempi) ((lambda () (begin (vector-set! data.2 j (- (vector-ref data.2 i.1) tempr)) (vector-set! data.2 (+ j 1) (- (vector-ref data.2 (+ i.1 1)) tempi)) (vector-set! data.2 i.1 (+ (vector-ref data.2 i.1) tempr)) (vector-set! data.2 (+ i.1 1) (+ (vector-ref data.2 (+ i.1 1)) tempi)) (loop5 (+ j mmax)))))) (+ (* wr (vector-ref data.2 (+ j 1))) (* wi (vector-ref data.2 j))))) (- (* wr (vector-ref data.2 j)) (* wi (vector-ref data.2 (+ j 1)))))) (+ i.1 mmax)) (loop4 (+ (- (* wr wpr) (* wi wpi)) wr) (+ (+ (* wi wpr) (* wr wpi)) wi) (+ m 2))))) loop5))) m) (unit)) (unit)))) loop4))) 1.0 0.0 0) (loop3 (* mmax 2)))))) (sin theta))) ((lambda (x) (* -2.0 (* x x))) (sin (* 0.5 theta))))) (/ pi*2 (inexact mmax))) (unit)) (unit)))) loop3))) 2)))
      (vector-length data.2)
      6.28318530717959)))

(def data (make-vector 1024 0.0))

(def run (lambda (data.1) (begin (four1 data.1) (vector-ref data.1 0))))

(def input0 (native-input-i64 (ann 0 I32)))

(def input1 (native-input-f64 (ann 1 I32)))

(def bench (-> I64 F64)
  (lambda (count)
    (((lambda () (begin (def loop (lambda (i result) (if (< i count) (loop (+ i 1) (run (hide count (make-vector input0 input1)))) result))) loop)))
      0
      0.0)))

(unit)
