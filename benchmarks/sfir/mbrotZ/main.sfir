;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir base))

(def cddr (lambda (xs.2) (cdr (cdr xs.2))))

(def length
  (lambda (xs)
    (((lambda () (begin (def loop.3 (lambda (xs.1 n.2) (if (null? xs.1) n.2 (loop.3 (cdr xs.1) (+ n.2 1))))) loop.3)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(def Complex64 (datatype () (complex64 (real F64 complex64-real) (imag F64 complex64-imag))))

(def complex64-add
  (lambda (left.1 right.1)
    (complex64
      (+ (complex64-real left.1) (complex64-real right.1))
      (+ (complex64-imag left.1) (complex64-imag right.1)))))

(def complex64-scale
  (lambda (value scale)
    (complex64 (* (complex64-real value) scale) (* (complex64-imag value) scale))))

(def complex64-multiply
  (lambda (left right)
    ((lambda (a b c.1 d) (complex64 (- (* a c.1) (* b d)) (+ (* a d) (* b c.1))))
      (complex64-real left)
      (complex64-imag left)
      (complex64-real right)
      (complex64-imag right))))

(def mbrot-z-origin (complex64 -1.0 -0.5))

(def mbrot-empty-row (make-vector 0 0))

(def hide (lambda (count.2 x.1) (hide-i64 x.1)))

(def count
  (lambda (z0.1 step.1 z)
    ((lambda (max-count) ((lambda (radius) ((lambda (radius^2) ((lambda () ((lambda (z0.2) (((lambda () (begin (def loop.2 (lambda (z.1 c) (if (= c max-count) c ((lambda (zr) ((lambda (zi) ((lambda (zr^2) ((lambda (zi^2) ((lambda () (if (> (+ zr^2 zi^2) radius^2) c (loop.2 (complex64-add (complex64-multiply z.1 z.1) z0.2) (+ c 1)))))) (* zi zi))) (* zr zr))) (complex64-imag z.1))) (complex64-real z.1))))) loop.2))) z0.2 0)) (complex64-add z0.1 (complex64-scale z step.1)))))) (* radius radius))) 4.0))
      64)))

(def mbrot
  (lambda (matrix.1 z0 step n.1)
    (((lambda () (begin (def loop1 (lambda (y) (if (>= y 0) (begin (((lambda () (begin (def loop2 (lambda (x) (if (>= x 0) (begin (vector-set! (vector-ref matrix.1 x) y (count z0 step (complex64 (i64->f64 x) (i64->f64 y)))) (loop2 (- x 1))) (loop1 (- y 1))))) loop2))) (- n.1 1)) (unit)) (unit)))) loop1)))
      (- n.1 1))))

(def test
  (lambda (n)
    ((lambda (matrix) (begin (((lambda () (begin (def loop.1 (lambda (i.1) (if (>= i.1 0) (begin (vector-set! matrix i.1 (make-vector n 0)) (loop.1 (- i.1 1)) (unit)) (unit)))) loop.1))) (- n 1)) (mbrot matrix mbrot-z-origin 0.005 n) (vector-ref (vector-ref matrix 0) 0)))
      (make-vector n mbrot-empty-row))))

(def input0 (native-input-i64 (ann 0 I32)))

(def bench (-> I64 I64)
  (lambda (count.1)
    (if (<= count.1 0)
      (unreachable)
      (((lambda () (begin (def loop (lambda (i result) (if (< i count.1) (loop (+ i 1) (test (hide count.1 input0))) result))) loop)))
        0
        0))))

(unit)
