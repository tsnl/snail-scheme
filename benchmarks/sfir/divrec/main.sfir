;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir core))

(define cddr (lambda (xs.2) (cdr (cdr xs.2))))

(define length
  (lambda (xs)
    (((lambda () (begin (define loop.2 (lambda (xs.1 n.2) (if (null? xs.1) n.2 (loop.2 (cdr xs.1) (+ n.2 1))))) loop.2)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(define hide (lambda (count.1 x) (if (barrier) x (unreachable))))

(define create-n (-> I64 (List (List Never)))
  (lambda (n)
    (((lambda () (begin (define loop.1 (lambda (n.1 a) (if (= n.1 0) a (loop.1 (- n.1 1) (cons (quote ()) a))))) loop.1)))
      n
      (quote ()))))

(define recursive-div2
  (lambda (l) (if (null? l) (quote ()) (cons (car l) (recursive-div2 (cddr l))))))

(define input0 (create-n (native-input-i64 (ann 0 I32))))

(define bench (-> I64 I64)
  (lambda (count)
    (length
      (((lambda () (begin (define loop (lambda (i result) (if (< i count) (loop (+ i 1) (recursive-div2 input0)) result))) loop)))
        0
        (quote ())))))

(unit)
