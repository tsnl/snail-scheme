(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(def SimplexResult (datatype ()
  (simplex-infeasible)
  (simplex-unbounded)
  (simplex-solved (values (List (Vector I64)) simplex-values))))

(def list (lambda (first second) (cons first (cons second (empty-list )))))

(define-overload - (-> F64 F64) (lambda (x.8) (f64-sub -0.0 x.8)))

(define-overload / (-> F64 F64) (lambda (x.7) (f64-div 1.0 x.7)))

(define-overload + (-> I64 I64 I64 I64) (lambda (a.6 b.1 c.1) (+ (+ a.6 b.1) c.1)))

(define-overload + (-> I64 I64 I64 I64 I64) (lambda (a.5 b c d) (+ (+ (+ a.5 b) c) d)))

(define-overload positive? (-> I64 Bool) (lambda (x.6) (> x.6 0)))

(define-overload positive? (-> F64 Bool) (lambda (x.5) (> x.5 0.0)))

(def negative? (lambda (x.4) (< x.4 0.0)))

(def zero? (lambda (x.3) (= x.3 0)))

(def abs (lambda (x.2) (if (= x.2 0.0) 0.0 (if (< x.2 0.0) (- x.2) x.2))))

(define-extern native-expected-length "benchmark" "expected_length" (-> I64))

(define-extern native-expected-i64 "benchmark" "expected_i64" (-> I64 I64))

(def expected-integer
  (lambda (cursor.2)
    ((lambda (value.1) (begin (ref-set! cursor.2 (+ (ref-get cursor.2) 1)) value.1))
      (native-expected-i64 (ref-get cursor.2)))))

(def expected-index-vector
  (lambda (cursor.1)
    ((lambda (size.1) ((lambda (result.2) ((lambda () (((lambda () (begin (def loop.23 (lambda (index.1) (if (= index.1 size.1) result.2 (begin (vector-set! result.2 index.1 (expected-integer cursor.1)) (loop.23 (+ index.1 1)))))) loop.23))) 0)))) (make-vector size.1 0)))
      (expected-integer cursor.1))))

(def expected-index-vectors
  (lambda ()
    ((lambda (cursor) ((lambda (size) ((lambda () (((lambda () (begin (def loop.22 (lambda (left.2) (if (= left.2 0) (if (= (ref-get cursor) (native-expected-length)) (empty-list ) (unreachable)) ((lambda (row) (cons row (loop.22 (- left.2 1)))) (expected-index-vector cursor))))) loop.22))) size)))) (expected-integer cursor)))
      (ref 0))))

(def same-index-vector?
  (lambda (left.1 right.1)
    (if (= (vector-length left.1) (vector-length right.1))
      (((lambda () (begin (def loop.21 (lambda (index) ((lambda (value) (if value value (if (= (vector-ref left.1 index) (vector-ref right.1 index)) (loop.21 (+ index 1)) #f))) (= index (vector-length left.1))))) loop.21)))
        0)
      #f)))

(def same-index-vectors?
  (lambda (left right)
    (if (null? left)
      (null? right)
      (if (not (null? right))
        (if (same-index-vector? (car left) (car right))
          (same-index-vectors? (cdr left) (cdr right))
          #f)
        #f))))

(def simplex-accepted?
  (lambda (result.1 expected.1)
    (match result.1
      ((simplex-infeasible) #f)
      ((simplex-unbounded) #f)
      ((simplex-solved values) (same-index-vectors? values expected.1)))))

(def hide (lambda (count.1 x.1) (hide-f64 x.1)))

(def matrix-rows (lambda (a.4) (vector-length a.4)))

(def matrix-columns (lambda (a.3) (vector-length (vector-ref a.3 0))))

