;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir core))

(define cddr (lambda (xs.2) (cdr (cdr xs.2))))

(define length
  (lambda (xs)
    (((lambda () (begin (define loop.1 (lambda (xs.1 n) (if (null? xs.1) n (loop.1 (cdr xs.1) (+ n 1))))) loop.1)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(define-data DerivDatum
  (make-datum-false)
  (make-datum-true)
  (make-datum-empty)
  (make-datum-x)
  (make-datum-a)
  (make-datum-b)
  (make-datum-plus)
  (make-datum-minus)
  (make-datum-times)
  (make-datum-divide)
  (make-datum-number (value I64 datum-number-value))
  (datum-cons (first DerivDatum datum-car) (rest DerivDatum datum-cdr)))

(define datum-tag
  (lambda (value.12)
    (match value.12
      ((make-datum-false) 0)
      ((make-datum-true) 1)
      ((make-datum-empty) 2)
      ((make-datum-x) 5)
      ((make-datum-a) 6)
      ((make-datum-b) 7)
      ((make-datum-plus) 8)
      ((make-datum-minus) 9)
      ((make-datum-times) 10)
      ((make-datum-divide) 11)
      ((make-datum-number number.9) 3)
      ((datum-cons first.10 rest.10) 4))))

(define datum-false (make-datum-false))

(define datum-true (make-datum-true))

(define datum-empty (make-datum-empty))

(define datum-x (make-datum-x))

(define datum-a (make-datum-a))

(define datum-b (make-datum-b))

(define datum-plus (make-datum-plus))

(define datum-minus (make-datum-minus))

(define datum-times (make-datum-times))

(define datum-divide (make-datum-divide))

(define datum-zero (make-datum-number 0))

(define datum-one (make-datum-number 1))

(define datum-pair?
  (lambda (value.11)
    (match value.11
      ((make-datum-false) #f)
      ((make-datum-true) #f)
      ((make-datum-empty) #f)
      ((make-datum-x) #f)
      ((make-datum-a) #f)
      ((make-datum-b) #f)
      ((make-datum-plus) #f)
      ((make-datum-minus) #f)
      ((make-datum-times) #f)
      ((make-datum-divide) #f)
      ((make-datum-number number.8) #f)
      ((datum-cons first.9 rest.9) #t))))

(define datum-null?
  (lambda (value.10)
    (match value.10
      ((make-datum-false) #f)
      ((make-datum-true) #f)
      ((make-datum-empty) #t)
      ((make-datum-x) #f)
      ((make-datum-a) #f)
      ((make-datum-b) #f)
      ((make-datum-plus) #f)
      ((make-datum-minus) #f)
      ((make-datum-times) #f)
      ((make-datum-divide) #f)
      ((make-datum-number number.7) #f)
      ((datum-cons first.8 rest.8) #f))))

(define datum-x?
  (lambda (value.9)
    (match value.9
      ((make-datum-false) #f)
      ((make-datum-true) #f)
      ((make-datum-empty) #f)
      ((make-datum-x) #t)
      ((make-datum-a) #f)
      ((make-datum-b) #f)
      ((make-datum-plus) #f)
      ((make-datum-minus) #f)
      ((make-datum-times) #f)
      ((make-datum-divide) #f)
      ((make-datum-number number.6) #f)
      ((datum-cons first.7 rest.7) #f))))

(define datum-a?
  (lambda (value.8)
    (match value.8
      ((make-datum-false) #f)
      ((make-datum-true) #f)
      ((make-datum-empty) #f)
      ((make-datum-x) #f)
      ((make-datum-a) #t)
      ((make-datum-b) #f)
      ((make-datum-plus) #f)
      ((make-datum-minus) #f)
      ((make-datum-times) #f)
      ((make-datum-divide) #f)
      ((make-datum-number number.5) #f)
      ((datum-cons first.6 rest.6) #f))))

(define datum-b?
  (lambda (value.7)
    (match value.7
      ((make-datum-false) #f)
      ((make-datum-true) #f)
      ((make-datum-empty) #f)
      ((make-datum-x) #f)
      ((make-datum-a) #f)
      ((make-datum-b) #t)
      ((make-datum-plus) #f)
      ((make-datum-minus) #f)
      ((make-datum-times) #f)
      ((make-datum-divide) #f)
      ((make-datum-number number.4) #f)
      ((datum-cons first.5 rest.5) #f))))

(define datum-plus?
  (lambda (value.6)
    (match value.6
      ((make-datum-false) #f)
      ((make-datum-true) #f)
      ((make-datum-empty) #f)
      ((make-datum-x) #f)
      ((make-datum-a) #f)
      ((make-datum-b) #f)
      ((make-datum-plus) #t)
      ((make-datum-minus) #f)
      ((make-datum-times) #f)
      ((make-datum-divide) #f)
      ((make-datum-number number.3) #f)
      ((datum-cons first.4 rest.4) #f))))

(define datum-minus?
  (lambda (value.5)
    (match value.5
      ((make-datum-false) #f)
      ((make-datum-true) #f)
      ((make-datum-empty) #f)
      ((make-datum-x) #f)
      ((make-datum-a) #f)
      ((make-datum-b) #f)
      ((make-datum-plus) #f)
      ((make-datum-minus) #t)
      ((make-datum-times) #f)
      ((make-datum-divide) #f)
      ((make-datum-number number.2) #f)
      ((datum-cons first.3 rest.3) #f))))

(define datum-times?
  (lambda (value.4)
    (match value.4
      ((make-datum-false) #f)
      ((make-datum-true) #f)
      ((make-datum-empty) #f)
      ((make-datum-x) #f)
      ((make-datum-a) #f)
      ((make-datum-b) #f)
      ((make-datum-plus) #f)
      ((make-datum-minus) #f)
      ((make-datum-times) #t)
      ((make-datum-divide) #f)
      ((make-datum-number number.1) #f)
      ((datum-cons first.2 rest.2) #f))))

(define datum-divide?
  (lambda (value.3)
    (match value.3
      ((make-datum-false) #f)
      ((make-datum-true) #f)
      ((make-datum-empty) #f)
      ((make-datum-x) #f)
      ((make-datum-a) #f)
      ((make-datum-b) #f)
      ((make-datum-plus) #f)
      ((make-datum-minus) #f)
      ((make-datum-times) #f)
      ((make-datum-divide) #t)
      ((make-datum-number number) #f)
      ((datum-cons first.1 rest.1) #f))))

(define datum-cadr (lambda (value.2) (datum-car (datum-cdr value.2))))

(define datum-caddr (lambda (value.1) (datum-car (datum-cdr (datum-cdr value.1)))))

(define datum-list3
  (lambda (a.3 b.1 c.1) (datum-cons a.3 (datum-cons b.1 (datum-cons c.1 datum-empty)))))

(define datum-list4
  (lambda (a.2 b c d) (datum-cons a.2 (datum-cons b (datum-cons c (datum-cons d datum-empty))))))

(define datum-map
  (lambda (f values)
    (if (datum-null? values)
      datum-empty
      (datum-cons (f (datum-car values)) (datum-map f (datum-cdr values))))))

(define datum-equal?
  (lambda (left right)
    ((lambda (tag.1) (if (= tag.1 (datum-tag right)) (if (= tag.1 3) (= (datum-number-value left) (datum-number-value right)) (if (= tag.1 4) (if (datum-equal? (datum-car left) (datum-car right)) (datum-equal? (datum-cdr left) (datum-cdr right)) #f) #t)) #f))
      (datum-tag left))))

(define-extern datum-input-length "benchmark" "vector_length" (-> I32 I64))

(define-extern datum-input-token "benchmark" "vector_i64" (-> I32 I64 I64))

(define next-datum-token
  (lambda (source.2 position.2)
    ((lambda (i.1) (if (< i.1 (datum-input-length source.2)) (begin (ref-set! position.2 (+ i.1 1)) (datum-input-token source.2 i.1)) (unreachable)))
      (ref-get position.2))))

(define read-input-datum
  (lambda (source.1)
    ((lambda (position.1) ((lambda (value) ((lambda () (if (= (ref-get position.1) (datum-input-length source.1)) value (unreachable))))) (read-datum source.1 position.1)))
      (ref 0))))

(define read-datum
  (lambda (source position)
    ((lambda (tag) (if (= tag 3) (make-datum-number (next-datum-token source position)) (if (= tag 4) ((lambda (first) ((lambda (rest) ((lambda () (datum-cons first rest)))) (read-datum source position))) (read-datum source position)) (if (= tag 0) datum-false (if (= tag 1) datum-true (if (= tag 2) datum-empty (if (= tag 5) datum-x (if (= tag 6) datum-a (if (= tag 7) datum-b (if (= tag 8) datum-plus (if (= tag 9) datum-minus (if (= tag 10) datum-times (if (= tag 11) datum-divide (unreachable))))))))))))))
      (next-datum-token source position))))

(define hide (lambda (count.1 x) (if (barrier) x (unreachable))))

(define deriv
  (lambda (a)
    (if (not (datum-pair? a))
      (if (datum-x? a) datum-one datum-zero)
      (if (datum-plus? (datum-car a))
        (datum-cons datum-plus (datum-map deriv (datum-cdr a)))
        (if (datum-minus? (datum-car a))
          (datum-cons datum-minus (datum-map deriv (datum-cdr a)))
          (if (datum-times? (datum-car a))
            (datum-list3
              datum-times
              a
              (datum-cons
                datum-plus
                (datum-map (lambda (a.1) (datum-list3 datum-divide (deriv a.1) a.1)) (datum-cdr a))))
            (if (datum-divide? (datum-car a))
              (datum-list3
                datum-minus
                (datum-list3 datum-divide (deriv (datum-cadr a)) (datum-caddr a))
                (datum-list3
                  datum-divide
                  (datum-cadr a)
                  (datum-list4 datum-times (datum-caddr a) (datum-caddr a) (deriv (datum-caddr a)))))
              (unreachable))))))))

(define input0 (read-input-datum (ann 0 I32)))

(define expected (read-input-datum (ann 1 I32)))

(define bench (-> I64 I64)
  (lambda (count)
    (if (datum-equal? (((lambda () (begin (define loop (lambda (i result) (if (< i count) (loop (+ i 1) (deriv (hide count input0))) result))) loop))) 0 datum-false) expected)
      1
      0)))

(unit)
