(import (sfir base) (sfir math))

(def cddr (lambda (xs.2) (cdr (cdr xs.2))))

(def length
  (lambda (xs)
    (((lambda () (begin (def loop.3 (lambda (xs.1 n.4) (if (null? xs.1) n.4 (loop.3 (cdr xs.1) (+ n.4 1))))) loop.3)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(def Base (datatype () (adenine) (cytosine) (guanine) (uracil)))

(def Nucleotide (datatype ()
  (nucleotide (base Base nucleotide-base) (fields (Vector (Vector F64)) nucleotide-fields))))

(def Assignment (datatype ()
  (assignment
    (id I64 assignment-id)
    (tfo (Vector F64) assignment-tfo)
    (nuc Nucleotide assignment-nuc))))

(def base-code
  (lambda (base) (match base ((adenine) 0) ((cytosine) 1) ((guanine) 2) ((uracil) 3))))

(def nucleic-list (lambda elements elements))

(def nucleic-append (All (T) (-> (List T) (List T) (List T)))
  (lambda (first last) (if (null? first) last (cons (car first) (nucleic-append (cdr first) last)))))

(def nucleic-map (All (A B) (-> (-> A B) (List A) (List B)))
  (lambda (procedure values)
    (if (null? values)
      (empty-list )
      ((lambda (head) (cons head (nucleic-map procedure (cdr values)))) (procedure (car values))))))

(def hide (lambda (count.2 x.8) (hide-i64 x.8)))

(def constant-pi 3.141592653589793)

(def constant-minus-pi -3.141592653589793)

(def constant-pi/2 1.5707963267948966)

(def constant-minus-pi/2 -1.5707963267948966)

(def math-atan2 (-> F64 F64 F64)
  (lambda (y.5 x.7)
    (if (> x.7 0.0)
      (atan (/ y.5 x.7))
      (if (< y.5 0.0)
        (if (= x.7 0.0) constant-minus-pi/2 (+ (atan (/ y.5 x.7)) constant-minus-pi))
        (if (= x.7 0.0) constant-pi/2 (+ (atan (/ y.5 x.7)) constant-pi))))))

(def make-pt (-> F64 F64 F64 (Vector F64)) (lambda (x.6 y.4 z.4) (vector x.6 y.4 z.4)))

(def pt-x (lambda (pt.5) (vector-ref pt.5 0)))

(def pt-x-set! (lambda (pt.4 val.74) (vector-set! pt.4 0 val.74)))

(def pt-y (lambda (pt.3) (vector-ref pt.3 1)))

(def pt-y-set! (lambda (pt.2 val.73) (vector-set! pt.2 1 val.73)))

(def pt-z (lambda (pt.1) (vector-ref pt.1 2)))

(def pt-z-set! (lambda (pt val.72) (vector-set! pt 2 val.72)))

(def pt-sub
  (lambda (p1.2 p2.2)
    (make-pt (- (pt-x p1.2) (pt-x p2.2)) (- (pt-y p1.2) (pt-y p2.2)) (- (pt-z p1.2) (pt-z p2.2)))))

(def pt-dist
  (lambda (p1.1 p2.1)
    ((lambda (dx dy dz) (sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz))))
      (- (pt-x p1.1) (pt-x p2.1))
      (- (pt-y p1.1) (pt-y p2.1))
      (- (pt-z p1.1) (pt-z p2.1)))))

(def pt-phi
  (lambda (p.5)
    ((lambda (x.5) ((lambda (y.3) ((lambda (z.3) ((lambda (b.1) ((lambda () (math-atan2 (+ (* (cos b.1) z.3) (* (sin b.1) x.5)) y.3)))) (math-atan2 x.5 z.3))) (pt-z p.5))) (pt-y p.5)))
      (pt-x p.5))))

(def pt-theta (lambda (p.4) (math-atan2 (pt-x p.4) (pt-z p.4))))

