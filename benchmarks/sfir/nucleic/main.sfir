(def var-most-distant-atom
  (lambda (v)
    (begin
      (def distance
        (lambda (pos)
          ((lambda (abs-pos) ((lambda (x.2 y z) (sqrt (+ (+ (* x.2 x.2) (* y y)) (* z z)))) (pt-x abs-pos) (pt-y abs-pos) (pt-z abs-pos)))
            (tfo-apply (var-tfo v) pos))))
      (maximum (nucleic-map distance (list-of-atoms (var-nuc v)))))))

(def sol-most-distant-atom (lambda (s) (maximum (nucleic-map var-most-distant-atom s))))

(def most-distant-atom (lambda (sols) (maximum (nucleic-map sol-most-distant-atom sols))))

(def maximum
  (lambda (lst)
    (((lambda () (begin (def loop.1 (lambda (m l) (if (null? l) m ((lambda (x.1) (loop.1 (if (> x.1 m) x.1 m) (cdr l))) (car l))))) loop.1)))
      (car lst)
      (cdr lst))))

(def run (-> (List (Ref Assignment)) F64)
  (lambda (input) (most-distant-atom (pseudoknot input))))

(def input0
  (ann (if (= (native-input-i64 (ann 0 I32)) 0) (empty-list ) (unreachable)) (List (Ref Assignment))))

(def expected-result (native-input-f64 (ann 1 I32)))

(def hide-input (-> I64 (List (Ref Assignment)) (List (Ref Assignment)))
  (lambda (count.1 value) (if (barrier) value (unreachable))))

(def bench (-> I64 I64)
  (lambda (count)
    (((lambda () (begin (def loop (lambda (i result) (if (< i count) (loop (+ i 1) (run (hide-input count input0))) (if (if (> count 0) ((lambda (x) (if (> x 0.999999) (< x 1.000001) #f)) (/ result expected-result)) #f) 1 0)))) loop)))
      0
      0.0)))

