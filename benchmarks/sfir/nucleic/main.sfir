(def make-var (lambda (id.2 tfo.8 nuc.11) (ref (assignment id.2 tfo.8 nuc.11))))

(def var-id (lambda (var.7) (assignment-id (ref-get var.7))))

(def var-id-set!
  (lambda (var.6 val.2)
    ((lambda (old.2) (ref-set! var.6 (assignment val.2 (assignment-tfo old.2) (assignment-nuc old.2))))
      (ref-get var.6))))

(def var-tfo (lambda (var.5) (assignment-tfo (ref-get var.5))))

(def var-tfo-set!
  (lambda (var.4 val.1)
    ((lambda (old.1) (ref-set! var.4 (assignment (assignment-id old.1) val.1 (assignment-nuc old.1))))
      (ref-get var.4))))

(def var-nuc (lambda (var.3) (assignment-nuc (ref-get var.3))))

(def var-nuc-set!
  (lambda (var.2 val)
    ((lambda (old) (ref-set! var.2 (assignment (assignment-id old) (assignment-tfo old) val)))
      (ref-get var.2))))

(def atom-pos (-> (-> Nucleotide (Vector F64)) (Ref Assignment) (Vector F64))
  (lambda (atom var.1) (tfo-apply (var-tfo var.1) (atom (var-nuc var.1)))))

(def get-var (-> I64 (List (Ref Assignment)) (Ref Assignment))
  (lambda (id.1 lst.3)
    ((lambda (v.3) (if (= id.1 (var-id v.3)) v.3 (get-var id.1 (cdr lst.3)))) (car lst.3))))

