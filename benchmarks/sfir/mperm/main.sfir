;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir core))

(define cddr (lambda (xs.2) (cdr (cdr xs.2))))

(define length
  (lambda (xs)
    (((lambda () (begin (define loop.6 (lambda (xs.1 n.12) (if (null? xs.1) n.12 (loop.6 (cdr xs.1) (+ n.12 1))))) loop.6)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(define integer-zero? (lambda (n.11) (= n.11 0)))

(define integer-positive? (lambda (n.10) (> n.10 0)))

(define integer-max (lambda (a b) (if (> a b) a b)))

(define nonempty-list? (lambda (value.1) (not (null? value.1))))

(define equal-permutation?
  (lambda (left right)
    (if (null? left)
      (null? right)
      (if (not (null? right))
        (if (= (car left) (car right)) (equal-permutation? (cdr left) (cdr right)) #f)
        #f))))

(define-data PermutationPlan
  (make-permutation-plan
    (work (-> (Vector (List (List I64)))) permutation-work)
    (accept (-> (Vector (List (List I64))) Bool) permutation-accept)))

(define run-benchmark-x
  (lambda (m.1 n.9 k.1 ell.1 thunk accept.1) (make-permutation-plan thunk accept.1)))

(define hide (lambda (count.1 x.6) (hide-i64 x.6)))

(define permutations
  (lambda (x.2)
    ((lambda (x.3 perms) (begin (define P (lambda (n.8) (if (> n.8 1) (begin (((lambda () (begin (define loop.5 (lambda (j.2) (if (integer-zero? j.2) (P (- n.8 1)) (begin (P (- n.8 1)) (F n.8) (loop.5 (- j.2 1)))))) loop.5))) (- n.8 1)) (unit)) (unit)))) (define F (lambda (n.7) (begin (ref-set! x.3 (revloop (ref-get x.3) n.7 (list-tail (ref-get x.3) n.7))) (ref-set! perms (cons (ref-get x.3) (ref-get perms)))))) (define revloop (lambda (x.5 n.6 y.1) (if (integer-zero? n.6) y.1 (revloop (cdr x.5) (- n.6 1) (cons (car x.5) y.1))))) (define list-tail (lambda (x.4 n.5) (if (integer-zero? n.5) x.4 (list-tail (cdr x.4) (- n.5 1))))) (P (length (ref-get x.3))) (ref-get perms)))
      (ref x.2)
      (ref (cons x.2 (quote ()))))))

(define sumlists
  (lambda (x)
    (((lambda () (begin (define loop.3 (lambda (x.1 sum) (if (null? x.1) sum (loop.3 (cdr x.1) (((lambda () (begin (define loop.4 (lambda (y sum.1) (if (null? y) sum.1 (loop.4 (cdr y) (+ sum.1 (car y)))))) loop.4))) (car x.1) sum))))) loop.3)))
      x
      0)))

(define one..n
  (lambda (n.3)
    (((lambda () (begin (define loop.2 (lambda (n.4 p) (if (integer-zero? n.4) p (loop.2 (- n.4 1) (cons n.4 p))))) loop.2)))
      n.3
      (quote ()))))

(define tenperm
  (lambda rest ((lambda (n.2) (MpermNKL-benchmark 10 n.2 2 1)) (if (null? rest) 9 (car rest)))))

(define MpermNKL-benchmark
  (lambda (m n k ell)
    (if (if (<= 0 m) (if (integer-positive? n) (if (integer-positive? k) (if (<= 0 ell) (<= ell k) #f) #f) #f) #f)
      ((lambda (queue) (begin (define fill-queue (lambda (i.2 j.1) (if (< i.2 j.1) (begin (vector-set! queue i.2 (permutations (one..n n))) (fill-queue (+ i.2 1) j.1) (unit)) (unit)))) (define flush-queue (lambda () (((lambda () (begin (define loop.1 (lambda (i.1) (if (< i.1 k) (begin (vector-set! queue i.1 ((lambda (j) (if (< j k) (vector-ref queue j) (quote ()))) (+ i.1 ell))) (loop.1 (+ i.1 1)) (unit)) (unit)))) loop.1))) 0))) (fill-queue 0 (- k ell)) (run-benchmark-x m n k ell (lambda () (begin (fill-queue (- k ell) k) (flush-queue) queue)) (lambda (q) (begin (define factorial (lambda (n.1) (if (= n.1 0) 1 (* n.1 (factorial (- n.1 1)))))) ((lambda (q0 qi) (if ((lambda (value) (if value value (if (nonempty-list? q0) (if (nonempty-list? qi) (equal-permutation? (car q0) (car qi)) #f) #f))) (if (null? q0) (null? qi) #f)) (= (sumlists q0) (quotient (* (* n (+ n 1)) (factorial n)) 2)) #f)) (vector-ref q 0) (vector-ref q (integer-max 0 (- (- k ell) 1)))))))))
        (make-vector k (quote ())))
      (unreachable))))

(define-extern native-count "benchmark" "count" (-> I64))

(define setup-count (native-count))

(define setup-m (hide setup-count setup-count))

(define input0 (hide setup-count (native-input-i64 (ann 0 I32))))

(define input1 (hide setup-count (native-input-i64 (ann 1 I32))))

(define input2 (hide setup-count (native-input-i64 (ann 2 I32))))

(define plan (MpermNKL-benchmark setup-m input0 input1 input2))

(define bench (-> I64 I64)
  (lambda (count)
    ((lambda (work accept) (if (accept (((lambda () (begin (define loop (lambda (i result) (if (< i count) (loop (+ i 1) (work)) result))) loop))) 0 (ann (empty-vector) (Vector (List (List I64)))))) 1 0))
      (permutation-work plan)
      (permutation-accept plan))))

(unit)
