(define run (-> I64 I64 (List Char))
  (lambda (nrows ncols)
    (begin (ref-set! output (quote ())) (pmaze nrows ncols) (maze-reverse (ref-get output)))))

(define-data Specification
  (specification
    (count I64 specification-count)
    (rows I64 specification-rows)
    (columns I64 specification-columns)
    (expected Output specification-expected)))

(define maze-input-integer
  (lambda (value.2)
    (match (datum-number-value value.2)
      ((exact-number number) number)
      ((rational-number number.1) (datum-fail "Maze requires exact integers"))
      ((inexact-number number.2) (datum-fail "Maze requires exact integers"))
      ((complex-number real imaginary) (datum-fail "Maze requires exact integers")))))

(define maze-input-output
  (lambda (value.1)
    (if (if (= (datum-kind value.1) 1) (not (datum-boolean-value value.1)) #f)
      (initial-output)
      (((lambda () (begin (define loop.1 (lambda (tail result.1) (if (datum-null? tail) (character-output (maze-reverse result.1)) (if (if (datum-pair? tail) (= (datum-kind (datum-car tail)) 2) #f) (loop.1 (datum-cdr tail) (cons (datum-character-value (datum-car tail)) result.1)) (other-output))))) loop.1)))
        value.1
        (ann (quote ()) (List Char))))))

(define read-specification
  (lambda (port)
    ((lambda (count.2) ((lambda (rows) ((lambda (columns) ((lambda (expected) ((lambda () (specification count.2 rows columns expected)))) (maze-input-output (read-value! (read port))))) (maze-input-integer (read-value! (read port))))) (maze-input-integer (read-value! (read port)))))
      (maze-input-integer (read-value! (read port))))))

(define configured (call-with-input-file "input.txt" read-specification))

(define configured-count (-> I64) (lambda () (specification-count configured)))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define hide (All (T) (-> I64 T T)) (lambda (count.1 value) (if (barrier) value (unreachable))))

(define bench (-> I64 I64)
  (lambda (count)
    (((lambda () (begin (define loop (lambda (index result) (if (< index count) (loop (+ index 1) (character-output (run (hide count (specification-rows configured)) (hide count (specification-columns configured))))) (if (same-output? result (specification-expected configured)) 1 0)))) loop)))
      0
      (initial-output))))

(unit)
