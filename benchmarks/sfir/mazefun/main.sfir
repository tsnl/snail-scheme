;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir core))

(define cddr (lambda (xs.2) (cdr (cdr xs.2))))

(define length
  (lambda (xs)
    (((lambda () (begin (define loop.1 (lambda (xs.1 n.3) (if (null? xs.1) n.3 (loop.1 (cdr xs.1) (+ n.3 1))))) loop.1)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(define-data Cavity (wall) (coordinate (row I64 coordinate-row) (column I64 coordinate-column)))

(define wall-value (wall))

(define open-cell? (lambda (value.8) (match value.8 ((wall) #f) ((coordinate row column) #t))))

(define-data Dimensions (dimensions (rows I64 dimension-rows) (columns I64 dimension-columns)))

(define-data MazeResult
  (maze-initial)
  (maze-error)
  (maze-grid (rows (List (List Bool)) maze-rows))
  (maze-other))

(define maze-initial-value (maze-initial))

(define maze-error-value (maze-error))

(define maze-other-value (maze-other))

(define maze-kind
  (lambda (value.7)
    (match value.7 ((maze-initial) 0) ((maze-error) 1) ((maze-grid rows) 2) ((maze-other) 3))))

(define same-bool? (lambda (left.3 right.3) (if left.3 right.3 (not right.3))))

(define maze-even? (lambda (value.6) (= (remainder value.6 2) 0)))

(define maze-odd? (lambda (value.5) (not (maze-even? value.5))))

(define same-cavity?
  (lambda (left.2 right.2)
    (if (open-cell? left.2)
      (if (open-cell? right.2)
        (if (= (coordinate-row left.2) (coordinate-row right.2))
          (= (coordinate-column left.2) (coordinate-column right.2))
          #f)
        #f)
      (not (open-cell? right.2)))))

(define cavity-member?
  (lambda (value.3 values.1)
    (if (not (null? values.1))
      ((lambda (value.4) (if value.4 value.4 (cavity-member? value.3 (cdr values.1))))
        (same-cavity? value.3 (car values.1)))
      #f)))

(define singleton (All (T) (-> T (List T))) (lambda (value.2) (cons value.2 (quote ()))))

(define append-two (All (T) (-> (List T) (List T) (List T)))
  (lambda (first.1 last.1)
    (if (null? first.1) last.1 (cons (car first.1) (append-two (cdr first.1) last.1)))))

(define append-four (All (T) (-> (List T) (List T) (List T) (List T) (List T)))
  (lambda (first second third last) (append-two first (append-two second (append-two third last)))))

(define maze-map (All (A B) (-> (-> A B) (List A) (List B)))
  (lambda (procedure values)
    (if (null? values)
      (quote ())
      ((lambda (head.2) (cons head.2 (maze-map procedure (cdr values)))) (procedure (car values))))))

(define same-row?
  (lambda (left.1 right.1)
    (if (null? left.1)
      (null? right.1)
      (if (not (null? right.1))
        (if (same-bool? (car left.1) (car right.1)) (same-row? (cdr left.1) (cdr right.1)) #f)
        #f))))

(define same-grid?
  (lambda (left right)
    (if (null? left)
      (null? right)
      (if (not (null? right))
        (if (same-row? (car left) (car right)) (same-grid? (cdr left) (cdr right)) #f)
        #f))))

(define same-maze?
  (lambda (actual expected)
    (if (= (maze-kind actual) (maze-kind expected))
      (if (= (maze-kind actual) 2)
        (same-grid? (maze-rows actual) (maze-rows expected))
        (not (= (maze-kind actual) 3)))
      #f)))

(define hide (lambda (count.1 x) (hide-i64 x)))

(define foldr (All (A B) (-> (-> A B B) B (List A) B))
  (lambda (f.3 base.2 lst.9)
    (begin
      (define foldr-aux
        (lambda (lst.10) (if (null? lst.10) base.2 (f.3 (car lst.10) (foldr-aux (cdr lst.10))))))
      (foldr-aux lst.9))))

(define foldl (All (A B) (-> (-> B A B) B (List A) B))
  (lambda (f.2 base lst.7)
    (begin
      (define foldl-aux
        (lambda (base.1 lst.8)
          (if (null? lst.8) base.1 (foldl-aux (f.2 base.1 (car lst.8)) (cdr lst.8)))))
      (foldl-aux base lst.7))))

(define for (All (T) (-> I64 I64 (-> I64 T) (List T)))
  (lambda (lo hi f.1)
    (begin
      (define for-aux
        (lambda (lo.1) (if (< lo.1 hi) (cons (f.1 lo.1) (for-aux (+ lo.1 1))) (quote ()))))
      (for-aux lo))))

(define concat (All (T) (-> (List (List T)) (List T)))
  (lambda (lists) (foldr append-two (quote ()) lists)))

(define list-read (All (T) (-> (List T) I64 T))
  (lambda (lst.6 i.14) (if (= i.14 0) (car lst.6) (list-read (cdr lst.6) (- i.14 1)))))

(define list-write (All (T) (-> (List T) I64 T (List T)))
  (lambda (lst.5 i.13 val.1)
    (if (= i.13 0)
      (cons val.1 (cdr lst.5))
      (cons (car lst.5) (list-write (cdr lst.5) (- i.13 1) val.1)))))

(define list-remove-pos (All (T) (-> (List T) I64 (List T)))
  (lambda (lst.4 i.12)
    (if (= i.12 0) (cdr lst.4) (cons (car lst.4) (list-remove-pos (cdr lst.4) (- i.12 1))))))

(define duplicates?
  (lambda (lst.3)
    (if (null? lst.3)
      #f
      ((lambda (value.1) (if value.1 value.1 (duplicates? (cdr lst.3))))
        (cavity-member? (car lst.3) (cdr lst.3))))))

(define make-matrix (All (T) (-> I64 I64 (-> I64 I64 T) (List (List T))))
  (lambda (n.2 m.2 init) (for 0 n.2 (lambda (i.11) (for 0 m.2 (lambda (j.9) (init i.11 j.9)))))))

(define matrix-read (All (T) (-> (List (List T)) I64 I64 T))
  (lambda (mat.3 i.10 j.8) (list-read (list-read mat.3 i.10) j.8)))

(define matrix-write (All (T) (-> (List (List T)) I64 I64 T (List (List T))))
  (lambda (mat.2 i.9 j.7 val) (list-write mat.2 i.9 (list-write (list-read mat.2 i.9) j.7 val))))

(define matrix-size (All (T) (-> (List (List T)) Dimensions))
  (lambda (mat.1) (dimensions (length mat.1) (length (car mat.1)))))

(define matrix-map (All (A B) (-> (-> A B) (List (List A)) (List (List B))))
  (lambda (f mat) (maze-map (lambda (lst.2) (maze-map f lst.2)) mat)))

(define initial-random 0)

(define next-random-number
  (lambda (current-random.1) (remainder (+ (* current-random.1 3581) 12751) 131072)))

(define shuffle (All (T) (-> (List T) (List T)))
  (lambda (lst.1) (shuffle-aux lst.1 initial-random)))

(define shuffle-aux (All (T) (-> (List T) I64 (List T)))
  (lambda (lst current-random)
    (if (null? lst)
      (quote ())
      ((lambda (new-random) ((lambda (i.8) (cons (list-read lst i.8) (shuffle-aux (list-remove-pos lst i.8) new-random))) (remainder new-random (length lst))))
        (next-random-number current-random)))))

(define make-maze (-> I64 I64 MazeResult)
  (lambda (n.1 m.1)
    (if (not (if (maze-odd? n.1) (maze-odd? m.1) #f))
      maze-error-value
      ((lambda (cave.7 possible-holes.1) (cave-to-maze (pierce-randomly (shuffle possible-holes.1) cave.7)))
        (make-matrix
          n.1
          m.1
          (lambda (i.6 j.5)
            (if (if (maze-even? i.6) (maze-even? j.5) #f) (coordinate i.6 j.5) wall-value)))
        (concat
          (for
            0
            n.1
            (lambda (i.7)
              (concat
                (for
                  0
                  m.1
                  (lambda (j.6)
                    (if (same-bool? (maze-even? i.7) (maze-even? j.6))
                      (quote ())
                      (singleton (coordinate i.7 j.6)))))))))))))

(define cave-to-maze (lambda (cave.6) (maze-grid (matrix-map open-cell? cave.6))))

(define pierce
  (lambda (pos.4 cave.5)
    ((lambda (i.5 j.4) (matrix-write cave.5 i.5 j.4 pos.4))
      (coordinate-row pos.4)
      (coordinate-column pos.4))))

(define pierce-randomly
  (lambda (possible-holes cave.4)
    (if (null? possible-holes)
      cave.4
      ((lambda (hole) (pierce-randomly (cdr possible-holes) (try-to-pierce hole cave.4)))
        (car possible-holes)))))

(define try-to-pierce
  (lambda (pos.3 cave.3)
    ((lambda (i.4 j.3) ((lambda (ncs) (if (duplicates? (maze-map (lambda (nc.2) (matrix-read cave.3 (coordinate-row nc.2) (coordinate-column nc.2))) ncs)) cave.3 (pierce pos.3 (foldl (lambda (c.1 nc.1) (change-cavity c.1 nc.1 pos.3)) cave.3 ncs)))) (neighboring-cavities pos.3 cave.3)))
      (coordinate-row pos.3)
      (coordinate-column pos.3))))

(define change-cavity
  (lambda (cave.2 pos.2 new-cavity-id.1)
    ((lambda (i.3 j.2) (change-cavity-aux cave.2 pos.2 new-cavity-id.1 (matrix-read cave.2 i.3 j.2)))
      (coordinate-row pos.2)
      (coordinate-column pos.2))))

(define change-cavity-aux
  (lambda (cave.1 pos.1 new-cavity-id old-cavity-id)
    ((lambda (i.2 j.1) ((lambda (cavity-id) (if (same-cavity? cavity-id old-cavity-id) (foldl (lambda (c nc) (change-cavity-aux c nc new-cavity-id old-cavity-id)) (matrix-write cave.1 i.2 j.1 new-cavity-id) (neighboring-cavities pos.1 cave.1)) cave.1)) (matrix-read cave.1 i.2 j.1)))
      (coordinate-row pos.1)
      (coordinate-column pos.1))))

(define neighboring-cavities
  (lambda (pos cave)
    ((lambda (size.2) ((lambda (n m) ((lambda (i.1 j) (append-four (if (if (> i.1 0) (open-cell? (matrix-read cave (- i.1 1) j)) #f) (singleton (coordinate (- i.1 1) j)) (quote ())) (if (if (< i.1 (- n 1)) (open-cell? (matrix-read cave (+ i.1 1) j)) #f) (singleton (coordinate (+ i.1 1) j)) (quote ())) (if (if (> j 0) (open-cell? (matrix-read cave i.1 (- j 1))) #f) (singleton (coordinate i.1 (- j 1))) (quote ())) (if (if (< j (- m 1)) (open-cell? (matrix-read cave i.1 (+ j 1))) #f) (singleton (coordinate i.1 (+ j 1))) (quote ())))) (coordinate-row pos) (coordinate-column pos))) (dimension-rows size.2) (dimension-columns size.2)))
      (matrix-size cave))))

(define-extern native-expected-i64 "benchmark" "expected_i64" (-> I64 I64))

(define expected-cursor (ref 0))

(define read-expected-i64
  (lambda ()
    ((lambda (value) (begin (ref-set! expected-cursor (+ (ref-get expected-cursor) 1)) value))
      (native-expected-i64 (ref-get expected-cursor)))))

(define read-expected-row
  (lambda (size.1)
    (if (= size.1 0)
      (quote ())
      ((lambda (head.1) (cons head.1 (read-expected-row (- size.1 1)))) (= (read-expected-i64) 1)))))

(define read-expected-rows
  (lambda (size)
    (if (= size 0)
      (quote ())
      ((lambda (head) (cons head (read-expected-rows (- size 1))))
        (read-expected-row (read-expected-i64))))))

(define read-expected-maze
  (lambda ()
    ((lambda (kind) (if (= kind 0) maze-initial-value (if (= kind 1) maze-error-value (if (= kind 2) (maze-grid (read-expected-rows (read-expected-i64))) maze-other-value))))
      (read-expected-i64))))

(define input0 (native-input-i64 (ann 0 I32)))

(define input1 (native-input-i64 (ann 1 I32)))

(define expected-maze (read-expected-maze))

(define bench (-> I64 I64)
  (lambda (count)
    (((lambda () (begin (define loop (lambda (i result) (if (< i count) (loop (+ i 1) (make-maze (hide count input0) (hide count input1))) (if (same-maze? result expected-maze) 1 0)))) loop)))
      0
      maze-initial-value)))

(unit)
