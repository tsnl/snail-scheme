          (number-from-integer
            (if (number<? fraction (rational-number (make-rational (integer-from-i64 (ann 1 I64)) (integer-from-i64 (ann 2 I64)))))
              lo
              (if (number>? fraction (rational-number (make-rational (integer-from-i64 (ann 1 I64)) (integer-from-i64 (ann 2 I64)))))
                (integer-add lo (integer-from-i64 (ann 1 I64)))
