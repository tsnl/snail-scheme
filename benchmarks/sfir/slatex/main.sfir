  (lambda (a0) (value-string (list->string (value-characters a0)))))

(def primitive/list-tail/2 (-> Value Value Value)
  (lambda (a0 a1) (value-tail a0 (integer->i64 (number->integer (value-number-number a1))))))

(def primitive/make-string/2 (-> Value Value Value)
  (lambda (a0 a1)
    (value-string
      (make-string
        (integer->i64 (number->integer (value-number-number a0)))
        (value-character-character a1)))))

(def primitive/make-vector/1 (-> Value Value)
  (lambda (a0)
