(def numeric-sinh (-> F64 F64) (lambda (x) (* 0.5 (- (exp x) (exp (- 0.0 x))))))

(def numeric-cosh (-> F64 F64) (lambda (x) (* 0.5 (+ (exp x) (exp (- 0.0 x))))))

