        a1
        (value-cons
          a2
          (value-cons
            a3
            (value-cons
              a4
              (value-cons
                a5
                (value-cons a6 (value-cons a7 (value-cons a8 (value-cons a9 (value-null)))))))))))))

(def primitive/list/14 (-> Value Value Value Value Value Value Value Value Value Value Value Value Value Value Value)
  (lambda (a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13)
    (value-cons
      a0
      (value-cons
        a1
        (value-cons
          a2
          (value-cons
            a3
            (value-cons
              a4
              (value-cons
                a5
                (value-cons
                  a6
                  (value-cons
                    a7
                    (value-cons
                      a8
                      (value-cons
                        a9
                        (value-cons
                          a10
                          (value-cons a11 (value-cons a12 (value-cons a13 (value-null)))))))))))))))))

