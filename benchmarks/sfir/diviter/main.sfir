;; Canonical bare SFIR. See migration.json for source provenance.

(import (sfir base))

(def cddr (lambda (xs.2) (cdr (cdr xs.2))))

(def length
  (lambda (xs)
    (((lambda () (begin (def loop.3 (lambda (xs.1 n.2) (if (null? xs.1) n.2 (loop.3 (cdr xs.1) (+ n.2 1))))) loop.3)))
      xs
      0)))

(define-extern native-input-i64 "benchmark" "input_i64" (-> I32 I64))

(define-extern native-input-f64 "benchmark" "input_f64" (-> I32 F64))

(define-extern barrier "benchmark" "barrier" (-> Bool))

(define-extern hide-i64 "benchmark" "hide_i64" (-> I64 I64))

(define-extern hide-f64 "benchmark" "hide_f64" (-> F64 F64))

(def hide (lambda (count.1 x) (if (barrier) x (unreachable))))

(def create-n (-> I64 (List (List Never)))
  (lambda (n)
    (((lambda () (begin (def loop.2 (lambda (n.1 a.1) (if (= n.1 0) a.1 (loop.2 (- n.1 1) (cons (empty-list ) a.1))))) loop.2)))
      n
      (empty-list ))))

(def iterative-div2
  (lambda (l)
    (((lambda () (begin (def loop.1 (lambda (l.1 a) (if (null? l.1) a (loop.1 (cddr l.1) (cons (car l.1) a))))) loop.1)))
      l
      (empty-list ))))

(def input0 (create-n (native-input-i64 (ann 0 I32))))

(def bench (-> I64 I64)
  (lambda (count)
    (length
      (((lambda () (begin (def loop (lambda (i result) (if (< i count) (loop (+ i 1) (iterative-div2 input0)) result))) loop)))
        0
        (empty-list )))))

(unit)
