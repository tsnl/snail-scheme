#!/usr/bin/env python3
"""Build full linked programs, then rotate execution samples without build timers."""

import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import statistics
import subprocess

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "build/native-benchmark"
CPU, ROUNDS, REPETITIONS = int(os.environ.get("BENCH_CPU", "2")), 8, "64"


# ---- Ahead-of-time builds ----


def tool(variable, default):
    selected = os.environ.get(variable, default)
    return shutil.which(selected) or selected


def build_commands():
    return [
        [tool("CHIBI", "chibi-scheme"), "-I", "src", "benchmarks/native-build.scm"],
        [tool("CHEZ", "scheme"), "--script", "benchmarks/chez.scm",
         "benchmarks/cpu.scm", str(OUT / "chez.so")],
        [tool("GUILD", "guild"), "compile", "--r7rs", "-O2", "-o",
         str(OUT / "guile.go"), "benchmarks/cpu.scm"],
    ]


def commands():
    return {
        "native": [str(OUT / "cpu"), REPETITIONS],
        "v8": [tool("NODE", "node"), "--no-warnings", "scripts/run-wasi.mjs",
               str(OUT / "cpu.wasm"), REPETITIONS],
        "chez": [tool("CHEZ", "scheme"), "--program", str(OUT / "chez.so"), REPETITIONS],
        "guile": [tool("GUILE", "guile"), "--no-auto-compile", "--r7rs", "-c",
                  f'(load-compiled "{OUT / "guile.go"}")', REPETITIONS],
        "chibi": [tool("CHIBI", "chibi-scheme"), "benchmarks/cpu.scm", REPETITIONS],
    }


# ---- Fixed checksummed execution ----


def sample(name, command):
    result = subprocess.run(command, cwd=ROOT, text=True, capture_output=True, check=True)
    checksums = re.findall(r"checksum: (\d+)", result.stdout)
    times = re.findall(r"elapsed: ([\d.]+) s", result.stdout)
    assert checksums == ["269118144"] and len(times) == 1, result.stdout
    return {"variant": name, "seconds": float(times[0]), "checksum": 269118144,
            "diagnostic": result.stderr}


def measure(variants):
    os.sched_setaffinity(0, {CPU})
    for name, command in variants.items():
        sample(name, command)
    samples, items = [], list(variants.items())
    for round_index in range(ROUNDS):
        offset = round_index % len(items)
        for name, command in items[offset:] + items[:offset]:
            samples.append({**sample(name, command), "round": round_index + 1})
    return samples


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def provenance(builds, variants):
    sources = [ROOT / name for name in ("benchmarks/cpu.scm", "benchmarks/native",
                                       "benchmarks/native-build.scm", "src/native.c")]
    sources += list((ROOT / "src/snail-scheme").glob("*.sld"))
    artifacts = [OUT / name for name in ("cpu", "cpu.wasm", "chez.so", "guile.go")]
    return {"base_revision": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
            "host": platform.platform(), "build_commands": builds, "commands": variants,
            "versions": versions(),
            "environment": {name: os.environ.get(name) for name in
                            ("BDWGC_INCLUDE", "BDWGC_LIB", "GUILE_JIT_THRESHOLD", "GUILE_AUTO_COMPILE")},
            "source_sha256": {str(p.relative_to(ROOT)): digest(p) for p in sources},
            "artifact_sha256": {str(p.relative_to(ROOT)): digest(p) for p in artifacts}}


def versions():
    commands = {"clang": [tool("CLANG", "clang"), "--version"],
                "binaryen": [tool("WASM_DIS", "wasm-dis"), "--version"],
                "rust": [tool("RUSTC", "rustc"), "--version"],
                "node": [tool("NODE", "node"), "--version"],
                "chez": [tool("CHEZ", "scheme"), "--version"],
                "guile": [tool("GUILE", "guile"), "--version"],
                "chibi": [tool("CHIBI", "chibi-scheme"), "-V"]}
    return {name: subprocess.check_output(command, stderr=subprocess.STDOUT, text=True).splitlines()[0]
            for name, command in commands.items()}


def write_report(builds, variants, samples):
    medians = {name: statistics.median(row["seconds"] for row in samples if row["variant"] == name)
               for name in variants}
    report = {**provenance(builds, variants), "cpu": CPU, "rounds": ROUNDS,
              "repetitions": int(REPETITIONS), "warmups": 1, "samples": samples,
              "median_seconds": medians,
              "time_over_chez": {name: seconds / medians["chez"] for name, seconds in medians.items()},
              "scope": "Every implementation executes the complete canonical Scheme workload. "
              "Native translates the exact Rust-linked binary run by V8. Internal timers exclude "
              "compilation, startup, checks, and output; V8/Guile runtime tiering remains included."}
    (OUT / "results.json").write_text(json.dumps(report, indent=2) + "\n")
    for name, seconds in medians.items():
        print(f"{name:8s} {seconds:.6f} s; {seconds / medians['chez']:.2f}x Chez")


def main():
    OUT.mkdir(parents=True, exist_ok=True)
    builds, variants = build_commands(), commands()
    for command in builds:
        subprocess.run(command, cwd=ROOT, check=True)
    write_report(builds, variants, measure(variants))


if __name__ == "__main__":
    main()
