#!/usr/bin/env python3
"""Compare MIR with the frozen stack backend, Chibi, and Chez on identical CPU work.

Prepare frozen controls with --prepare-controls OLD_CHECKOUT; see README.md.
Build first with --build-only, then run --measure-only during an idle interval.
"""

import argparse
import json
import os
from pathlib import Path
import re
import runpy
import shutil
from statistics import median
import subprocess
import time

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build/mir-benchmark"
REPORT = BUILD / "results.json"
LTO = runpy.run_path(str(ROOT / "benchmarks/lto"), run_name="lto_helpers")
BENCH = LTO["BENCH"]
HASH = BENCH["fingerprint"]
SOURCE_PATHS = ("Cargo.toml", "Cargo.lock", ".cargo", "abi", "runtime", "runner", "trace", "src", "snail-compile")
BASELINE_REVISION = "f25162724bb8886f77140da7c2c54230f6655a8d"


# ---- Prepare controls from the preceding backend and current reference tools ----

def baseline_report(checkout):
    revision = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=checkout, text=True).strip()
    status = subprocess.check_output(["git", "status", "--porcelain"], cwd=checkout, text=True)
    if revision != BASELINE_REVISION or status:
        raise RuntimeError("baseline checkout must be clean at " + BASELINE_REVISION)
    report = json.loads((checkout / "build/rust-instructions/results.json").read_text())
    for name, expected in report["source_sha256"].items():
        if HASH(checkout / name) != expected:
            raise RuntimeError("baseline report does not describe its sources: " + name)
    return report


def copy_baseline(checkout, item):
    variant = "ordinary" if item["variant"] == "baseline" else "shared"
    source = checkout / "build/rust-instructions/llvm/bin/native" / item["variant"] / "cpu"
    metadata = json.loads(source.with_name("cpu.json").read_text())
    if HASH(source) != item["executable_sha256"] or metadata["source_sha256"] != HASH(ROOT / "benchmarks/cpu.scm"):
        raise RuntimeError("baseline executable or workload changed: " + str(source))
    destination = BUILD / "baseline" / variant
    shutil.copy2(source, destination)
    shutil.copy2(source.with_name("cpu.json"), destination.with_name(variant + ".json"))
    return {**item, "variant": "baseline-" + variant}


def prepare_baseline(checkout):
    previous = baseline_report(checkout)
    directory = BUILD / "baseline"
    directory.mkdir(parents=True, exist_ok=True)
    report = {"baseline_revision": BASELINE_REVISION, "baseline_source_sha256": previous["source_sha256"],
              "toolchain": previous["toolchain"], "source_sha256": HASH(ROOT / "benchmarks/cpu.scm"),
              "previous_report_sha256": HASH(checkout / "build/rust-instructions/results.json"),
              "repetitions": 64, "expected_checksum": 269118144,
              "builds": [copy_baseline(checkout, item) for item in previous["builds"] if item["language"] == "llvm"]}
    (directory / "provenance.json").write_text(json.dumps(report, indent=2) + "\n")


def prepare_chez(directory):
    runtime = BENCH["chez_runtime"](argparse.Namespace(snail_only=False, chez=os.environ.get("CHEZ", "scheme")))
    executable = BENCH["chez_executable"]("cpu", runtime, False)
    destination = directory / "chez.so"
    shutil.copy2(executable.path, destination)
    shutil.copy2(executable.path.with_name("cpu.so.json"), directory / "chez.so.json")
    return {**runtime, "command": [runtime["command"], "--program", str(destination), "64"],
            "executable_sha256": HASH(destination), "runtime_sha256": HASH(Path(runtime["command"])),
            "adapter_sha256": HASH(ROOT / "benchmarks/chez.scm")}


def prepare_chibi(directory):
    executable = shutil.which(os.environ.get("CHIBI", "chibi-scheme"))
    if not executable:
        raise RuntimeError("Chibi is required; set CHIBI to its executable")
    runtime = Path(executable).resolve()
    source = directory / "chibi.scm"
    shutil.copy2(ROOT / "benchmarks/cpu.scm", source)
    version = subprocess.check_output([str(runtime), "-V"], stderr=subprocess.STDOUT, text=True).strip()
    return {"command": [str(runtime), str(source), "64"], "version": version,
            "runtime_sha256": HASH(runtime), "source_sha256": HASH(source),
            "adapter_equivalence": "byte-identical copy of canonical benchmarks/cpu.scm"}


def prepare_controls(checkout):
    prepare_baseline(checkout.resolve())
    directory = BUILD / "references"
    directory.mkdir(parents=True, exist_ok=True)
    report = {"source_sha256": HASH(ROOT / "benchmarks/cpu.scm"), "repetitions": 64,
              "expected_checksum": 269118144, "chez": prepare_chez(directory), "chibi": prepare_chibi(directory)}
    (directory / "provenance.json").write_text(json.dumps(report, indent=2) + "\n")
    print("Old backend, Chez, and Chibi controls frozen; ready for --build-only.", flush=True)


# ---- Frozen sources and executable identities ----

def sources():
    names = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard",
                                     "--", *SOURCE_PATHS], cwd=ROOT, text=True).splitlines()
    return {name: HASH(ROOT / name) for name in sorted(set(names)) if (ROOT / name).is_file()}


def harnesses():
    return {name: HASH(ROOT / name) for name in ("benchmarks/mir", "benchmarks/lto", "benchmarks/run")}


def toolchain():
    commands = {"rustc": ["rustc", "-vV"], "opt": ["opt", "--version"],
                "llc": ["llc", "--version"], "wasm-ld": ["wasm-ld", "--version"]}
    return {name: subprocess.check_output(command, text=True).strip() for name, command in commands.items()}


def artifact(name, path, command):
    return {"name": name, "path": str(path), "command": command, "sha256": HASH(path)}


def frozen_controls(report):
    baseline = json.loads((BUILD / "baseline/provenance.json").read_text())
    references = json.loads((BUILD / "references/provenance.json").read_text())
    if baseline["source_sha256"] != HASH(ROOT / "benchmarks/cpu.scm") or references["source_sha256"] != baseline["source_sha256"]:
        raise RuntimeError("frozen controls use a different benchmark source")
    report.update(baseline=baseline, references=references)
    for build in baseline["builds"]:
        path = BUILD / "baseline" / build["variant"].removeprefix("baseline-")
        assert HASH(path) == build["executable_sha256"], f"changed baseline: {path}"
        report["artifacts"].append(artifact(build["variant"], path, [str(path)]))
    for name in ("chibi", "chez"):
        reference = references[name]
        if HASH(Path(reference["command"][0])) != reference["runtime_sha256"]:
            raise RuntimeError("reference runtime changed: " + name)
        path = BUILD / "references" / ("chibi.scm" if name == "chibi" else "chez.so")
        expected = reference["source_sha256"] if name == "chibi" else reference["executable_sha256"]
        assert HASH(path) == expected, f"changed reference: {path}"
        if name == "chibi":
            BENCH["record_artifact"]("cpu", path, BENCH["input_metadata"]("cpu"))
        report["artifacts"].append(artifact(name, path, [*reference["command"][:-2], str(path)]))


# ---- Build both new variants before any timing ----

def build_variant(module, variant):
    target = BUILD / "cargo" / variant
    flags = LTO["rustflags"]("cross-lto" if variant == "shared" else "baseline", "native")
    environment = {**os.environ, "SNAIL_LLVM_IR": str(module), "CARGO_TARGET_DIR": str(target),
                   "SNAIL_SHARED_LTO": "1" if variant == "shared" else "0", "RUSTFLAGS": flags}
    command = BENCH["cargo_command"]("native")
    warm = target.exists()
    start = time.monotonic()
    BENCH["checked"](command, env=environment)
    seconds = time.monotonic() - start
    destination = BUILD / "mir" / variant
    shutil.copy2(target / "i686-unknown-linux-musl/release/snail-runner", destination)
    BENCH["record_artifact"]("cpu", destination, BENCH["input_metadata"]("cpu"))
    return {**artifact("mir-" + variant, destination, [str(destination)]),
            "build_command": command, "rustflags": flags, "build_seconds": seconds, "reused_target_dir": warm}


def audit_shared():
    directory = BUILD / "cargo/shared/i686-unknown-linux-musl/release"
    binary = directory / "snail-runner"
    # Cargo retains artifacts for old flag sets; audit the just-linked executable.
    modules = [path for path in directory.rglob("*.0.4.opt.bc")
               if path.with_name(path.name.removesuffix(".0.4.opt.bc")).samefile(binary)]
    if len(modules) != 1:
        raise RuntimeError("expected exactly one final shared-LTO module")
    output = BUILD / "mir/shared.ll"
    subprocess.run(["opt", "-S", str(modules[0]), "-o", str(output)], check=True)
    calls = len(re.findall(r"\bcall\b[^\n]*@snail_(?:value|i32|pointer)_", output.read_text()))
    if calls:
        raise RuntimeError(f"shared LTO left {calls} representation helper calls")
    return {"remaining_leaf_calls": calls, "linked_ir_sha256": HASH(output), "bitcode_sha256": HASH(modules[0])}


def build():
    LTO["validate_environment"]()
    report = {"source_sha256": sources(), "harness_sha256": harnesses(),
              "toolchain": toolchain(), "artifacts": [], "samples": []}
    frozen_controls(report)
    (BUILD / "mir").mkdir(parents=True, exist_ok=True)
    module = BUILD / "mir/cpu.ll"
    start = time.monotonic()
    BENCH["checked"]([str(ROOT / "snail-compile"), str(ROOT / "benchmarks/cpu.scm"), str(module)])
    report.update(emission_seconds=time.monotonic() - start, emitted_ir_sha256=HASH(module))
    report["artifacts"].extend(build_variant(module, variant) for variant in ("ordinary", "shared"))
    report["inlining"] = audit_shared()
    if report["source_sha256"] != sources():
        raise RuntimeError("sources changed while building; repeat --build-only")
    REPORT.write_text(json.dumps(report, indent=2) + "\n")
    print("All six artifacts frozen; ready for --measure-only.", flush=True)


# ---- Pinned, rotating execution with checked answers ----

def measure(rounds):
    LTO["validate_environment"]()
    report = json.loads(REPORT.read_text())
    if report["source_sha256"] != sources() or report["harness_sha256"] != harnesses():
        raise RuntimeError("sources or harness changed; repeat --build-only")
    for name in ("chibi", "chez"):
        reference = report["references"][name]
        if HASH(Path(reference["command"][0])) != reference["runtime_sha256"]:
            raise RuntimeError("reference runtime changed: " + name)
    os.sched_setaffinity(0, {2})
    group = []
    for item in report["artifacts"]:
        path = Path(item["path"])
        assert HASH(path) == item["sha256"], f"changed executable: {path}"
        group.append(BENCH["Executable"](item["name"], "native", path, tuple(item["command"])))
    for executable in group:
        BENCH["run_sample"]("cpu", executable, 64, False)
    report["samples"] = []
    for index in range(rounds):
        offset = index % len(group)
        for position, executable in enumerate(group[offset:] + group[:offset]):
            sample = BENCH["run_sample"]("cpu", executable, 64, False)
            sample.update(round=index + 1, position=position + 1)
            report["samples"].append(sample)
    report["median_seconds"] = {item.implementation: median(sample["elapsed_ms"] / 1000
        for sample in report["samples"] if sample["implementation"] == item.implementation) for item in group}
    times = report["median_seconds"]
    report["ratios"] = {"mir_shared_over_" + name: times["mir-shared"] / times[name]
                        for name in ("baseline-shared", "baseline-ordinary", "chibi", "chez")}
    report["host"] = {**BENCH["execution_host"](report["samples"], None), "affinity": [2], "warmups": 1}
    REPORT.write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps({"median_seconds": times, "ratios": report["ratios"]}, indent=2), flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--prepare-controls", type=Path, metavar="OLD_CHECKOUT")
    modes.add_argument("--build-only", action="store_true")
    modes.add_argument("--measure-only", action="store_true")
    parser.add_argument("--samples", type=BENCH["positive_integer"], default=8)
    options = parser.parse_args()
    if options.prepare_controls:
        prepare_controls(options.prepare_controls)
    else:
        build() if options.build_only else measure(options.samples)


if __name__ == "__main__":
    main()
