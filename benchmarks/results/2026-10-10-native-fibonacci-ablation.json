  "scope": "Same complete Rust-linked Wasm and unchanged Scheme outer workload in every native arm. Baseline uses the old emitter; cold adds only the current authored cold attributes; i31 uses current lowering without cold attributes; both is unmodified current lowering. Tail calling convention, host, optimization flags, and all dynamic checks stay fixed. Timers exclude compilation, startup, checks, and output.",
  "reproduce": "Run benchmarks/native first, then execute the stored Python recipe from the checkout root.",
  "recipe_python": "#!/usr/bin/env python3\n\"\"\"Reproduce the two changes independently on the same full linked Wasm.\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport shutil\nimport statistics\nimport subprocess\n\nBASE = \"23a7b20f3d704b6a7a4e2fb19b73c5138cdca714\"\nROOT = Path.cwd()\nOUT = ROOT / \"build/native-ablation\"\nOUT.mkdir(parents=True, exist_ok=True)\nMODULE = ROOT / \"build/native-benchmark/cpu.wasm\"\nCOMMANDS = []\n\n\ndef run(command):\n    command = list(map(str, command))\n    COMMANDS.append(command)\n    subprocess.run(command, check=True)\n\n\ndef digest(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\n# The old emitter ignores optional name declarations. The current binary reader\n# and printer supply identical inputs and output formatting to both emitters.\nold = OUT / \"old/snail-scheme\"\nold.mkdir(parents=True, exist_ok=True)\nfor name in (\"wasm-binary.sld\", \"llvmlite.sld\"):\n    shutil.copyfile(ROOT / \"src/snail-scheme\" / name, old / name)\n(old / \"llvm.sld\").write_bytes(subprocess.check_output(\n    [\"git\", \"show\", BASE + \":src/snail-scheme/llvm.sld\"]))\nrun([\"chibi-scheme\", \"-I\", old.parent, \"tests/translate-native.scm\", MODULE, OUT / \"baseline.ll\"])\nrun([\"chibi-scheme\", \"-I\", \"src\", \"tests/translate-native.scm\", MODULE, OUT / \"both.ll\"])\nbaseline, both = (OUT / \"baseline.ll\").read_text(), (OUT / \"both.ll\").read_text()\ncold_headers = re.findall(r\"^(define .*\\)) cold \\{$\", both, re.MULTILINE)\nassert cold_headers, \"The full linked Wasm must retain the authored cold hints.\"\ncold = baseline\nfor header in cold_headers:\n    assert cold.count(header + \" {\") == 1\n    cold = cold.replace(header + \" {\", header + \" cold {\")\n(OUT / \"cold.ll\").write_text(cold)\n(OUT / \"i31.ll\").write_text(both.replace(\") cold {\", \") {\"))\n\nflags = [\"-lgc\", \"-lm\"]\nif os.environ.get(\"BDWGC_INCLUDE\"):\n    flags += [\"-I\", os.environ[\"BDWGC_INCLUDE\"]]\nif os.environ.get(\"BDWGC_LIB\"):\n    library = os.environ[\"BDWGC_LIB\"]\n    flags += [\"-L\", library, \"-Wl,-rpath,\" + library]\nvariants = {}\nfor name in (\"baseline\", \"cold\", \"i31\", \"both\"):\n    run([\"clang\", \"-O3\", \"-flto\", \"-fuse-ld=lld\", OUT / (name + \".ll\"),\n         \"src/native.c\", *flags, \"-o\", OUT / name])\n    variants[name] = [str(OUT / name), \"64\"]\nvariants[\"chez\"] = [\"scheme\", \"--program\", str(ROOT / \"build/native-benchmark/chez.so\"), \"64\"]\n\n\ndef sample(command):\n    output = subprocess.check_output(command, text=True)\n    assert re.findall(r\"checksum: (\\d+)\", output) == [\"269118144\"], output\n    elapsed = re.findall(r\"elapsed: ([\\d.]+) s\", output)\n    assert len(elapsed) == 1, output\n    return float(elapsed[0])\n\n\ncpu = int(os.environ.get(\"BENCH_CPU\", \"2\"))\nos.sched_setaffinity(0, {cpu})\nfor command in variants.values():\n    sample(command)\nsamples, items = [], list(variants.items())\nfor index in range(8):\n    offset = index % len(items)\n    for name, command in items[offset:] + items[:offset]:\n        samples.append({\"round\": index + 1, \"variant\": name, \"seconds\": sample(command)})\nmedians = {name: statistics.median(s[\"seconds\"] for s in samples if s[\"variant\"] == name)\n           for name in variants}\nproduction = json.loads((ROOT / \"build/native-benchmark/results.json\").read_text())\nreport = {\"baseline_revision\": BASE, \"cpu\": cpu, \"rounds\": 8, \"warmups\": 1,\n          \"repetitions\": 64, \"checksum\": 269118144, \"median_seconds\": medians,\n          \"time_over_chez\": {name: value / medians[\"chez\"] for name, value in medians.items()},\n          \"samples\": samples, \"commands\": variants, \"build_commands\": COMMANDS,\n          \"cold_headers\": cold_headers, \"wasm_sha256\": digest(MODULE),\n          \"artifact_sha256\": {str(p.relative_to(ROOT)): digest(p) for p in OUT.iterdir() if p.is_file()},\n          \"versions\": production[\"versions\"], \"host\": production[\"host\"],\n          \"environment\": production[\"environment\"], \"source_sha256\": production[\"source_sha256\"],\n          \"scope\": \"Same complete Rust-linked Wasm and unchanged Scheme outer workload in every native arm. \"\n          \"Baseline uses the old emitter; cold adds only the current authored cold attributes; \"\n          \"i31 uses current lowering without cold attributes; both is unmodified current lowering. \"\n          \"Tail calling convention, host, optimization flags, and all dynamic checks stay fixed. \"\n          \"Timers exclude compilation, startup, checks, and output.\",\n          \"reproduce\": \"Run benchmarks/native first, then execute the stored Python recipe from the checkout root.\",\n          \"recipe_python\": Path(__file__).read_text()}\n(OUT / \"results.json\").write_text(json.dumps(report, indent=2) + \"\\n\")\nprint(medians)\n"
}
