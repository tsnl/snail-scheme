--- a/wasm-native/scheme/wasm-native/native-build.sld
+++ b/wasm-native/scheme/wasm-native/native-build.sld
@@ -1 +1 @@
-;; Native builds keep one path: optimized Wasm, LLVM object, Cargo-linked Rust.
+;; Native builds keep LLVM bitcode visible until Cargo's shared Rust link.
@@ -4 +4 @@
