diff --git a/wasm-native/scheme/wasm-native/llvm.sld b/wasm-native/scheme/wasm-native/llvm.sld
index adb02b45..770e39f1 100644
--- a/wasm-native/scheme/wasm-native/llvm.sld
+++ b/wasm-native/scheme/wasm-native/llvm.sld
@@ -176 +176 @@
-      (make-emitter locals targets serial live? port slots stack result roots local-roots)
+      (make-emitter locals targets serial live? body slots stack result roots local-roots)
@@ -181 +181,2 @@
-      (live? emitter-live? set-emitter-live!) (port emitter-port)
+      (live? emitter-live? set-emitter-live!)
+      (body emitter-body set-emitter-body!)
@@ -195,0 +197,4 @@
+    (define (append-body! fragment)
+      (let ((emitter (current-emitter)))
+        (set-emitter-body! emitter (cons fragment (emitter-body emitter)))))
+
@@ -198,4 +203 @@
-      (let ((port (emitter-port (current-emitter))))
-        (display "  " port)
-        (write-llvm pieces port)
-        (newline port)))
+      (append-body! (list "  " pieces "\n")))
@@ -213 +215 @@
-      (write-llvm (list name ":\n") (emitter-port (current-emitter)))
+      (append-body! (list name ":\n"))
@@ -298 +300,5 @@
-    (define (leave-roots) (line "call void @native_roots_leave(ptr %roots)"))
+    ;; Final publication capacity is known after the body. Keep exits explicit
+    ;; until then: a frame with no published values never joins the root chain.
+    (define (leave-roots)
+      (unless (alive?) (error "root unlink after terminator"))
+      (append-body! 'leave-roots))
@@ -802,0 +809,17 @@
+    (define (emit-root-frame emitter)
+      ;; Reference locals need storage even when no safepoint publishes them.
+      (output "  %roots = alloca { ptr, i64, i64, ["
+              (max (emitter-roots emitter) (emitter-local-roots emitter)) " x i64] }, align 8")
+      (when (> (emitter-roots emitter) 0)
+        (output "  call void @native_roots_enter(ptr %roots, i64 " (emitter-roots emitter) ")")))
+
+    (define (write-function-body emitter)
+      (let ((port (module-output (current-module))))
+        (for-each
+         (lambda (fragment)
+           (if (eq? fragment 'leave-roots)
+               (when (> (emitter-roots emitter) 0)
+                 (display "  call void @native_roots_leave(ptr %roots)\n" port))
+               (write-llvm fragment port)))
+         (reverse (emitter-body emitter)))))
+
@@ -804,2 +827 @@
-      (let ((emitter (make-emitter '#() '() 0 #t
-                                   (open-output-string) '() '() "void" 0 0)))
+      (let ((emitter (make-emitter '#() '() 0 #t '() '() '() "void" 0 0)))
@@ -810,4 +832,2 @@
-        (output "  %roots = alloca { ptr, i64, i64, [" (max (emitter-roots emitter) (emitter-local-roots emitter)) " x i64] }, align 8")
-        (output "  call void @native_roots_enter(ptr %roots, i64 " (emitter-roots emitter) ")")
-        (display (get-output-string (emitter-port emitter)) (module-output (current-module)))
-        (close-output-port (emitter-port emitter))
+        (emit-root-frame emitter)
+        (write-function-body emitter)
@@ -1159 +1179 @@
-    (import (wasm-native test-utils))
+    (import (wasm-native test-utils) (only (chibi string) string-contains string-cursor->index))
@@ -1160,0 +1181,44 @@
+      (define (llvm-string datum)
+        (let ((port (open-output-string)))
+          (wasm->llvm datum port)
+          (get-output-string port)))
+
+      (define (llvm-contains? text fragment)
+        (and (string-contains text fragment) #t))
+
+      (define (llvm-count text fragment)
+        (let loop ((text text) (count 0))
+          (let ((offset (string-contains text fragment)))
+            (if offset
+                (loop (substring text (+ (string-cursor->index text offset) (string-length fragment))
+                                 (string-length text)) (+ count 1))
+                count))))
+
+      (define (test-llvm-empty-roots)
+        (let ((text (llvm-string '(module (func $callee) (func (call $callee))))))
+          (expect (llvm-contains? text "call void @native_roots_enter") #f)
+          (expect (llvm-contains? text "call void @native_roots_leave") #f))
+        (let ((text (llvm-string '(module (type $box (struct))
+                                   (func (param (ref null $box)) (result (ref null $box))
+                                         (local.get 0))))))
+          (expect (llvm-contains? text "[1 x i64]") #t)
+          (expect (llvm-contains? text "call void @native_roots_enter") #f)
+          (expect (llvm-contains? text "call void @native_roots_leave") #f)))
+
+      (define (test-llvm-published-roots)
+        (let* ((datum '(module (type $box (struct))
+                        (func (param (ref null $box)) (result (ref null $box)) (local.get 0))))
+               (text (parameterize ((current-native-gc-stress #t)) (llvm-string datum))))
+          (expect (llvm-contains? text "call void @native_roots_enter(ptr %roots, i64 1)") #t)
+          (expect (llvm-contains? text "call void @native_gc_collect()") #t)
+          (expect (llvm-contains? text "call void @native_roots_leave(ptr %roots)") #t)))
+
+      (define (test-llvm-early-root-exit)
+        (let ((text (llvm-string '(module (type $box (struct))
+                                   (func (param (ref null $box)) (param i32) (result i64)
+                                         (if (local.get 1) (then (return (i64.const 1))))
+                                         (drop (struct.new $box))
+                                         (i64.const 2))))))
+          (expect (llvm-count text "call void @native_roots_enter(ptr %roots, i64 1)") 1)
+          (expect (llvm-count text "call void @native_roots_leave(ptr %roots)") 2)))
+
@@ -1179,0 +1244,3 @@
+        (run-test test-llvm-empty-roots)
+        (run-test test-llvm-published-roots)
+        (run-test test-llvm-early-root-exit)
