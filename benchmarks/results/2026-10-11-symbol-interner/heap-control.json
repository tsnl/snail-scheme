  "harness_source": "import hashlib, json, os, sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path('/tmp/snail-symbol-fingerprints-20261011/benchmarks/typing')))\nimport measure\n\nroot = Path('/tmp/snail-chez-chibi-comparison-20261011/build')\nbefore = json.loads((root / 'scheme-comparison-before/results.json').read_text())\nheap = json.loads((root / 'scheme-comparison/results.json').read_text())\nout = Path('/tmp/snail-symbol-fingerprints-20261011/build/heap-control/results.json')\nreport = {'scope': 'Same original native executable with default and 4 GiB environment, plus the startup-minimum executable; internal workload timers.',\n          'rounds': 8, 'cpu': 2, 'complete': False, 'harness_source': Path(__file__).read_text(),\n          'sampler_sha256': hashlib.sha256(Path(measure.__file__).read_bytes()).hexdigest(), 'workloads': []}\nassert not os.environ.get('GC_INITIAL_HEAP_SIZE')\nassert not os.environ.get('SNAIL_NATIVE_GC_INTERVAL')\nfor old, new in zip(before['workloads'], heap['workloads']):\n    variant = old['variants']['snail-native-i32']\n    binary = root / 'scheme-comparison-before' / Path(variant['command'][-1]).name\n    assert hashlib.sha256(binary.read_bytes()).hexdigest() == variant['sha256']\n    newer = new['variants']['snail-native-i32']\n    assert hashlib.sha256(Path(newer['command'][-1]).read_bytes()).hexdigest() == newer['sha256']\n    commands = {'default': [str(binary)], 'environment-4gib': ['env', 'GC_INITIAL_HEAP_SIZE=4294967296', str(binary)],\n                'startup-4gib': newer['command']}\n    seconds = {name: [] for name in commands}\n    preliminary = {name: measure.sample(command, old['repetitions'], 2, old['checksum']) for name, command in commands.items()}\n    order = []\n    for round_ in range(8):\n        names = list(commands)\n        for name in names[round_ % 3:] + names[:round_ % 3]:\n            seconds[name].append(measure.sample(commands[name], old['repetitions'], 2, old['checksum']))\n            order.append([round_ + 1, name])\n    report['workloads'].append({'workload': old['workload'], 'repetitions': old['repetitions'], 'checksum': old['checksum'],\n        'order': order, 'discarded_seconds': preliminary,\n        'variants': {name: measure.describe(command, seconds[name]) for name, command in commands.items()}})\n    out.write_text(json.dumps(report, indent=2) + '\\n')\n    print(old['workload'], {name: measure.describe(commands[name], values)['median_seconds'] for name, values in seconds.items()}, flush=True)\nreport['complete'] = True\nout.write_text(json.dumps(report, indent=2) + '\\n')\n",
