(import (scheme base) (scheme cxr) (scheme write) (scheme process-context) (scheme time)
        (snail-scheme strict-compiler) (snail-scheme strict-core)
        (snail-scheme chromium-trace))
(define (record key value) (write (list key value)) (newline) (flush-output-port))
(define started (current-jiffy))
(define program
  (with-chromium-trace-to (string-append (caddr (command-line)) ".trace.json")
    (lambda () (strict-source-file->core (cadr (command-line)) (caddr (command-line))))))
(record 'inference-seconds (/ (- (current-jiffy) started) (jiffies-per-second)))
(define entry (car (reverse (cadr (node-data (program-body program))))))
(define nodes 0)
(define total 0)
(define largest 0)
(define (inspect data)
  (cond ((node? data)
         (set! nodes (+ nodes 1))
         (set! total (+ total (length (node-constraints data))))
         (set! largest (max largest (length (node-constraints data))))
         (inspect (node-data data)))
        ((pair? data) (inspect (car data)) (inspect (cdr data)))))
(inspect entry)
(record 'entry-obligations (length (node-constraints entry)))
(record 'expression-nodes nodes)
(record 'all-obligation-entries total)
(record 'largest-list largest)
