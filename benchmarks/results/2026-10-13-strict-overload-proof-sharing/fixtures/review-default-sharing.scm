(import (snail strict))
(define count (ref 0))
(define shared (ref 0))
(define-instance (Default (Ref I64))
  (default (lambda ()
             (ref-set! count (+ (ref-get count) 1))
             shared)))
(define empty (ann (make-vector 0) (Vector (Ref I64))))
(define values (ann (make-vector 3) (Vector (Ref I64))))
(ref-set! (vector-ref values 1) 42)
(if (and (= (ref-get count) 3)
         (= (vector-length empty) 0)
         (ref-eq? (vector-ref values 0) (vector-ref values 2))
         (= (ref-get (vector-ref values 0)) 42)
         (= (ref-get shared) 42))
    42 (unreachable))
