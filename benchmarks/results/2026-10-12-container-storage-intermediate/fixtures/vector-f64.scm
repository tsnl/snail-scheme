(import (scheme base) (scheme read) (scheme write) (scheme time))

;; ---- Runtime-sized homogeneous input ----

(define (check expected actual)
  (unless (equal? expected actual) (error "numeric vector mismatch" expected actual)))
(define (make-input size offset)
  (let ((values (make-vector size 0.25)))
    (let loop ((index 0))
      (when (< index size)
        (vector-set! values index (+ 0.25 offset (inexact index)))
        (loop (+ index 1))))
    values))
(define (checksum values)
  (let loop ((index 0) (sum 0.0))
    (if (= index (vector-length values)) sum
        (loop (+ index 1) (+ sum (vector-ref values index))))))

;; ---- Distinct append interfaces, sharing invariant element types ----

(define (other-append first second) (vector-append first second))
(define operation (read))
(define size (read))
(define rounds (read))
(define opaque-append (if (read) vector-append other-append))
(define left (make-input size 0))
(define right (make-input size 1024))
(define arguments (list left right))
(define latest (make-vector 0 0.25))

;; Each copied result escapes to the same live anchor. The complete last result
;; is checked after timing; the timed operation has no per-element checksum.
(define (copy-direct)
  (let loop ((index 0))
    (when (< index rounds)
      (vector-set! left 0 (+ 0.25 (inexact index)))
      (set! latest (vector-append left right))
      (loop (+ index 1)))))
(define (copy-opaque)
  (let loop ((index 0))
    (when (< index rounds)
      (vector-set! left 0 (+ 0.25 (inexact index)))
      (set! latest (opaque-append left right))
      (loop (+ index 1)))))
(define (copy-apply)
  (let loop ((index 0))
    (when (< index rounds)
      (vector-set! left 0 (+ 0.25 (inexact index)))
      (set! latest (apply opaque-append arguments))
      (loop (+ index 1)))))
(define (update-pass values)
  (let loop ((index 0))
    (when (< index (vector-length values))
      (vector-set! values index (+ (vector-ref values index) 0.5))
      (loop (+ index 1)))))
(define (update)
  (let loop ((round 0))
    (when (< round rounds)
      (update-pass left)
      (loop (+ round 1)))))

;; ---- One selected kernel; all checking outside its timer ----

(define initial-left (checksum left))
(define initial-right (checksum right))
(define start (current-jiffy))
(cond ((eq? operation 'update) (update))
      ((eq? operation 'append-direct) (copy-direct))
      ((eq? operation 'append-opaque) (copy-opaque))
      ((eq? operation 'append-apply) (copy-apply))
      (else (error "unknown numeric vector operation" operation)))
(define elapsed (/ (exact (- (current-jiffy) start)) (inexact (jiffies-per-second))))
(define actual (if (eq? operation 'update) (checksum left) (checksum latest)))
(define expected
  (if (eq? operation 'update)
      (+ initial-left (* size rounds 0.5))
      (+ initial-left initial-right (- rounds 1))))
(check expected actual)
(when (not (eq? operation 'update))
  (check #f (eq? latest left))
  (check #f (eq? latest right))
  (check (+ 0.25 (- rounds 1)) (vector-ref latest 0))
  (check (+ 0.25 1024) (vector-ref latest size)))
(display "+!STORAGE!+")
(for-each (lambda (value) (write value) (display ","))
          (list 'f64 operation size rounds actual elapsed))
(newline)
