(import (scheme base) (scheme cxr) (scheme file) (scheme write) (scheme process-context)
        (chibi modules) (snail-scheme compiler) (snail-scheme expand)
        (snail-scheme bootstrap) (snail-scheme library) (snail-scheme ir)
        (snail-scheme source) (snail-scheme wasm) (snail-scheme chromium-trace))

;; ---- Read-only compiler function provenance ----

(define root (cadr (command-line)))
(define input (caddr (command-line)))
(define program
  (with-chromium-trace-to (string-append input ".mapping.trace.json")
   (lambda ()
    (syntax-list->ir-library ((module-ref '(snail-scheme compiler) 'source-file->syntax-list) input)
                          ((module-ref '(snail-scheme compiler) 'library-loader) root '())
                          (list (make-core-library '(snail-scheme core) bootstrap-primitive-names)
                                ((module-ref '(snail-scheme compiler) 'make-extension-library) '()))))))
(define items (apply append (map library-body (library-dependency-order program))))
(define functions ((module-ref '(snail-scheme wasm) 'all-lambdas) items))
(define children (module-ref '(snail-scheme wasm) 'children))
(define bindings '())
(define contexts '())

(define (descendants node)
  (if (lambda? node) (list (lambda-body node)) (children node)))

(define (collect-binding node)
  (when (and (value-binding? node) (lambda? (value-binding-initializer node)))
    (set! bindings (cons (cons (value-binding-initializer node)
                              (value-definition-name (value-binding-definition node))) bindings)))
  (for-each collect-binding (descendants node)))

(for-each collect-binding items)
(define (collect-context node parents)
  (let* ((binding (assq node bindings))
         (current (if binding (append parents (list (cdr binding))) parents)))
    (when (lambda? node) (set! contexts (cons (cons node current) contexts)))
    (for-each (lambda (child) (collect-context child current)) (descendants node))))
(for-each (lambda (node) (collect-context node '())) items)
(let loop ((remaining functions) (index 0))
  (unless (null? remaining)
    (let* ((function (car remaining)) (loc (lambda-loc function)) (binding (assq function bindings)))
      (write (list index (and binding (cdr binding))
                   (and loc (list (loc-filename loc) (loc-line loc) (loc-column loc)))
                   (map value-definition-name (lambda-parameters function))
                   (cdr (assq function contexts))))
      (newline))
    (loop (cdr remaining) (+ index 1))))
