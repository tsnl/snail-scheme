diff --git a/src/precise-gc.c b/src/precise-gc.c
new file mode 100644
index 0000000..6d12ed6
--- /dev/null
+++ b/src/precise-gc.c
@@ -0,0 +1,287 @@
+// Experimental native collector: stable addresses, explicit roots, typed edges.
+// The virtual arena is a prototype address-membership index, not a minimum heap.
+// Physical storage is committed lazily in 64 KiB slabs. No stack scanning occurs.
+#define _GNU_SOURCE
+#include "precise-gc.h"
+#include <assert.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <time.h>
+
+// ---- Heap representation ----
+
+#define PAGE_SIZE 65536u
+#define ARENA_SIZE ((size_t)1 << 30)
+#define PAGE_COUNT (ARENA_SIZE / PAGE_SIZE)
+#define CLASS_COUNT 24
+#define ALLOCATED 1u
+#define MARKED 2u
+#define LARGE_CLASS UINT32_MAX
+
+typedef struct { uint32_t stride, span; } Page;
+typedef struct { uint32_t kind, count; const uint32_t *offsets; } Layout;
+typedef struct Watch {
+    void *object, *data;
+    GC_finalization_proc callback;
+    struct Watch *next;
+} Watch;
+extern const Layout native_gc_layouts[];
+extern const uint64_t native_gc_layouts_count;
+extern uint64_t *const native_gc_globals[];
+extern const uint64_t native_gc_globals_count;
+extern NativeTable *const native_gc_tables[];
+extern const uint64_t native_gc_tables_count;
+extern _Noreturn void native_trap(void);
+
+static uint8_t *arena;
+static Page pages[PAGE_COUNT];
+static size_t used_pages, since_collection, budget = 8 * 1024 * 1024;
+static size_t minimum_budget = 8 * 1024 * 1024;
+static void *free_lists[CLASS_COUNT];
+static uint64_t **work;
+static size_t work_count, work_capacity, collections, live_bytes, live_objects;
+static size_t allocated_bytes, allocated_objects, peak_live, root_visits, field_visits;
+static double mark_seconds, sweep_seconds;
+static bool scan_all, statistics;
+static Watch *watches;
+
+static double seconds(void) {
+    struct timespec time;
+    clock_gettime(CLOCK_MONOTONIC, &time);
+    return time.tv_sec + time.tv_nsec * 1e-9;
+}
+
+static uint32_t class_stride(unsigned index) {
+    return index < 16 ? (index + 1) * 16 : 512u << (index - 16);
+}
+
+static unsigned size_class(size_t bytes) {
+    if (bytes <= 256) return (unsigned)((bytes + 15) / 16 - 1);
+    unsigned index = 16;
+    while (index < CLASS_COUNT && class_stride(index) < bytes) index++;
+    return index;
+}
+
+static void *commit_pages(size_t count, uint32_t stride) {
+    if (count > PAGE_COUNT - used_pages) return NULL;
+    void *base = arena + used_pages * PAGE_SIZE;
+    pages[used_pages] = (Page){stride, (uint32_t)count};
+    used_pages += count;
+    return base;
+}
+
+static bool add_slab(unsigned index) {
+    uint32_t stride = class_stride(index);
+    uint8_t *base = commit_pages(1, stride);
+    if (!base) return false;
+    for (size_t offset = 0; offset + stride <= PAGE_SIZE; offset += stride) {
+        void **payload = (void **)(base + offset + 8);
+        *payload = free_lists[index];
+        free_lists[index] = payload;
+    }
+    return true;
+}
+
+static uint64_t *large_allocation(size_t bytes) {
+    size_t span = (bytes + PAGE_SIZE - 1) / PAGE_SIZE;
+    for (size_t page = 0; page < used_pages; page += pages[page].span) {
+        if (pages[page].stride == LARGE_CLASS && pages[page].span >= span) {
+            uint64_t *header = (uint64_t *)(arena + page * PAGE_SIZE);
+            if (!(*header & ALLOCATED)) return header;
+        }
+    }
+    return commit_pages(span, LARGE_CLASS);
+}
+
+void *GC_malloc(size_t bytes) {
+    if (bytes > ARENA_SIZE - 8) return NULL;
+    if (since_collection >= budget) GC_gcollect();
+    unsigned index = size_class(bytes + 8);
+    uint64_t *header;
+    if (index == CLASS_COUNT) {
+        header = large_allocation(bytes + 8);
+        if (!header) { GC_gcollect(); header = large_allocation(bytes + 8); }
+    }
+    else {
+        if (!free_lists[index] && !add_slab(index)) { GC_gcollect(); if (!free_lists[index]) return NULL; }
+        void **payload = free_lists[index];
+        free_lists[index] = *payload;
+        header = (uint64_t *)payload - 1;
+    }
+    if (!header) return NULL;
+    *header = ((uint64_t)bytes << 2) | ALLOCATED;
+    memset(header + 1, 0, bytes);
+    since_collection += bytes + 8;
+    allocated_bytes += bytes;
+    allocated_objects++;
+    return header + 1;
+}
+
+// ---- Explicit roots and tracing ----
+
+// Check membership and exact allocation start before touching a candidate header.
+// This validation is also what makes the scan-all-fields ablation safe for integers.
+static uint64_t *candidate(uint64_t value) {
+    if (!value || (value & 7)) return NULL;
+    uintptr_t offset = (uintptr_t)value - (uintptr_t)arena;
+    if (offset >= used_pages * PAGE_SIZE) return NULL;
+    Page page = pages[offset / PAGE_SIZE];
+    size_t within = offset % PAGE_SIZE;
+    if (!page.span || within < 8) return NULL;
+    if (page.stride == LARGE_CLASS ? within != 8 : (within - 8) % page.stride) return NULL;
+    if (page.stride != LARGE_CLASS && within - 8 + page.stride > PAGE_SIZE) return NULL;
+    uint64_t *header = (uint64_t *)(uintptr_t)value - 1;
+    return (*header & ALLOCATED) ? header : NULL;
+}
+
+static void mark(uint64_t value) {
+    uint64_t *header = candidate(value);
+    if (!header || (*header & MARKED)) return;
+    *header |= MARKED;
+    if (work_count == work_capacity) {
+        work_capacity = work_capacity ? work_capacity * 2 : 1024;
+        void *grown = realloc(work, work_capacity * sizeof(*work));
+        if (!grown) native_trap();
+        work = grown;
+    }
+    work[work_count++] = header + 1;
+}
+
+static void mark_roots(void) {
+    for (NativeRoots *frame = native_roots; frame; frame = frame->previous) {
+        assert(frame->count <= frame->capacity);
+        root_visits += frame->count;
+        for (size_t i = 0; i < frame->count; i++) mark(frame->values[i]);
+    }
+    root_visits += native_gc_globals_count;
+    for (size_t i = 0; i < native_gc_globals_count; i++) mark(*native_gc_globals[i]);
+    for (size_t i = 0; i < native_gc_tables_count; i++) {
+        NativeTable *table = native_gc_tables[i];
+        root_visits += table->length;
+        for (size_t j = 0; j < table->length; j++) mark(table->values[j]);
+    }
+}
+
+static void trace_object(uint64_t *words) {
+    size_t count = words[-1] >> 5; // Header stores byte length shifted by two.
+    if (scan_all) {
+        field_visits += count;
+        for (size_t i = 0; i < count; i++) mark(words[i]);
+        return;
+    }
+    uint64_t type = words[0] >> 2;
+    if (!type || type > native_gc_layouts_count) native_trap();
+    Layout layout = native_gc_layouts[type - 1];
+    if (layout.kind == 2) {
+        assert(words[1] <= count - 2);
+        field_visits += words[1];
+        for (size_t i = 0; i < words[1]; i++) mark(words[i + 2]);
+    } else {
+        field_visits += layout.count;
+        for (size_t i = 0; i < layout.count; i++) {
+            assert(layout.offsets[i] < count);
+            mark(words[layout.offsets[i]]);
+        }
+    }
+}
+
+// ---- Weak cleanup and sweep ----
+
+void GC_register_finalizer_no_order(void *object, GC_finalization_proc callback,
+                                    void *data, GC_finalization_proc *old_fn, void **old_data) {
+    Watch **link = &watches;
+    while (*link && (*link)->object != object) link = &(*link)->next;
+    Watch *old = *link;
+    if (old_fn) *old_fn = old ? old->callback : NULL;
+    if (old_data) *old_data = old ? old->data : NULL;
+    if (old) { *link = old->next; free(old); }
+    if (!callback) return;
+    Watch *watch = malloc(sizeof(*watch));
+    if (!watch) native_trap();
+    *watch = (Watch){object, data, callback, watches};
+    watches = watch;
+}
+
+static void queue_finalizers(void) {
+    Watch **link = &watches;
+    while (*link) {
+        Watch *watch = *link;
+        uint64_t *header = candidate((uintptr_t)watch->object);
+        // Static objects are immortal. Their registered cleanup must not run.
+        if (header && !(*header & MARKED)) {
+            *link = watch->next;
+            // Only queues scalar resource IDs; it must not allocate or reenter.
+            watch->callback(watch->object, watch->data);
+            free(watch);
+        } else link = &watch->next;
+    }
+}
+
+static bool sweep_header(uint64_t *header) {
+    if (*header & MARKED) {
+        *header &= ~MARKED;
+        live_bytes += *header >> 2;
+        live_objects++;
+        return true;
+    }
+    *header = 0;
+    return false;
+}
+
+static void sweep(void) {
+    memset(free_lists, 0, sizeof(free_lists));
+    live_bytes = live_objects = 0;
+    for (size_t page = 0; page < used_pages; page += pages[page].span) {
+        uint8_t *base = arena + page * PAGE_SIZE;
+        uint32_t stride = pages[page].stride;
+        if (stride == LARGE_CLASS) { sweep_header((uint64_t *)base); continue; }
+        unsigned index = size_class(stride);
+        for (size_t offset = 0; offset + stride <= PAGE_SIZE; offset += stride) {
+            uint64_t *header = (uint64_t *)(base + offset);
+            if (sweep_header(header)) continue;
+            void **payload = (void **)(header + 1);
+            *payload = free_lists[index];
+            free_lists[index] = payload;
+        }
+    }
+}
+
+void GC_gcollect(void) {
+    double start = statistics ? seconds() : 0;
+    mark_roots();
+    while (work_count) trace_object(work[--work_count]);
+    double marked = statistics ? seconds() : 0;
+    queue_finalizers();
+    sweep();
+    if (statistics) { mark_seconds += marked - start; sweep_seconds += seconds() - marked; }
+    collections++;
+    if (live_bytes > peak_live) peak_live = live_bytes;
+    budget = live_bytes * 2 > minimum_budget ? live_bytes * 2 : minimum_budget;
+    since_collection = 0;
+}
+
+size_t GC_get_gc_no(void) { return collections; }
+
+// ---- Initialization and opt-in measurements ----
+
+static void report_statistics(void) {
+    fprintf(stderr, "precise-gc scan_all=%d collections=%zu allocations=%zu bytes=%zu "
+            "arena_used=%zu last_live=%zu peak_live=%zu live_objects=%zu roots=%zu fields=%zu "
+            "mark_s=%.6f sweep_s=%.6f\n", scan_all, collections, allocated_objects,
+            allocated_bytes, used_pages * PAGE_SIZE, live_bytes, peak_live, live_objects,
+            root_visits, field_visits, mark_seconds, sweep_seconds);
+}
+
+void precise_init(void) {
+    arena = mmap(NULL, ARENA_SIZE, PROT_READ | PROT_WRITE,
+                 MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (arena == MAP_FAILED) native_trap();
+    scan_all = getenv("SNAIL_GC_SCAN_ALL") != NULL;
+    statistics = getenv("SNAIL_GC_STATS") != NULL;
+    const char *minimum = getenv("SNAIL_GC_MIN_BYTES");
+    if (minimum) minimum_budget = budget = strtoull(minimum, NULL, 10);
+    if (statistics) atexit(report_statistics);
+}
