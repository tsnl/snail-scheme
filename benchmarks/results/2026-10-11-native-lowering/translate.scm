(import (scheme base) (scheme file) (scheme read) (scheme process-context)
        (snail-scheme llvm))
(define (singleton-rec node)
  (if (and (pair? node) (eq? (car node) 'rec))
      (if (= (length node) 2) (cadr node)
          (error "unsupported recursive group size" (- (length node) 1)))
      node))
(for-each
 (lambda (name)
   (let ((datum (call-with-input-file (string-append name ".wat") read)))
     (wasm->llvm-file (cons 'module (map singleton-rec (cdr datum)))
                     (string-append name ".ll"))))
 (cdr (command-line)))
