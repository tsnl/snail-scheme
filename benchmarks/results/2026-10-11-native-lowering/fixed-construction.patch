     (define (emit-array-fixed name length)
+      ;; Operands are already evaluated and remain live across allocation.
+      ;; The fresh object's constant indices need no dynamic bounds checks;
+      ;; zero-filled allocation supplies padding after packed element stores.
       (let* ((type (storage-type (array-type name))) (values (pop-values! length))
-             (reference (new-array name (constant "i32" length) (constant "i64" 0))))
+             (reference (call-native "native_alloc" "i64"
+                                     (list (constant "i64" (+ 16 (* 8 length)))))))
+        (store (constant "i64" (type-id name)) (field-pointer reference 0 "i64"))
+        (store (constant "i64" length) (field-pointer reference 1 "i64"))
         (for-each (lambda (value index)
                     (store (cast "trunc" value type)
-                           (array-slot reference (constant "i32" index) type)))
+                           (field-pointer reference (+ index 2) type)))
                   values (iota length 0))
         reference))
 
