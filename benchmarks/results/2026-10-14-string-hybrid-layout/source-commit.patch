     ;; ---- Unicode strings ----
 
-    ;; The immutable owner holds permission, unsigned scalar length, a direct
-    ;; first i32 block and an optional directory of remaining blocks. Short and
-    ;; empty strings omit the directory. Every scalar block is at most 32 KiB;
-    ;; separate mutable owners never share a block, including fresh empty ones.
-    ;; Directory slots are nullable only while a locally rooted constructor
-    ;; fills them. Publishing the owner establishes that every slot is present.
-    ;; Top still checks its String witness; no operation exposes the backing.
+    ;; A private String slot holds exactly one of two GC identities: a short
+    ;; i32 array [permission, scalars], or a long immutable owner with bounded
+    ;; scalar blocks. The nonnullable eq reference is this closed backend choice;
+    ;; source typing and Top's String witness establish the semantic type. Bare
+    ;; headerless blocks never enter String slots, even if layouts canonicalize.
+    ;; Fresh mutable identities own every payload array, including empty ones.
     (define string-block-shift 13)
     (define string-block-capacity (expt 2 string-block-shift))
     (define string-block-mask (- string-block-capacity 1))
@@ -296,88 +298,120 @@
       `(block (result i32)
               (if (i64.gt_u ,expression (i64.const 4294967294)) (then (unreachable)))
               (i32.wrap_i64 ,expression)))
