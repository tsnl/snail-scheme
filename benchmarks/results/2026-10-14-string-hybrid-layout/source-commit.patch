+(import (snail strict))
+
+;; ---- Independent mixed-storage copy oracle ----
+
+(define (scalar-at index)
+  (let ((choice (remainder index 5)))
+    (if (= choice 0) #\null
+        (if (= choice 1) #\é
+            (if (= choice 2) #\x1f600
+                (if (= choice 3) #\x10ffff #\x301))))))
+(define (pattern length)
+  (let ((value (make-string length)))
+    (let loop ((index 0))
+      (unless (= index length)
+        (string-set! value index (scalar-at index))
+        (loop (+ index 1))))
+    value))
+(define (range-copied? target-length at source-length start end)
+  (let ((target (pattern target-length)) (source (pattern source-length)))
+    (string-copy! target at source start end)
+    (and (let loop ((index 0))
+           (or (= index target-length)
+               (and (char=? (string-ref target index)
+                            (scalar-at (if (and (>= index at) (< index (+ at (- end start))))
+                                           (+ start (- index at)) index)))
+                    (loop (+ index 1)))))
+         (let loop ((index 0))
+           (or (= index source-length)
+               (and (char=? (string-ref source index) (scalar-at index))
+                    (loop (+ index 1))))))))
+
+;; ---- Identity through concrete and explicit Top slots ----
+
+(define-data Text (text (content String text-content)))
+(define flat (make-string 8192 #\x10ffff))
+(define long (make-string 8193 #\x1f600))
+(define flat-top (ref (ann flat Top)))
+(define long-top (ref (ann long Top)))
+(define flat-vector (vector (text flat)))
+(define long-vector (vector (text long)))
+(define (reader value) (lambda () (string-ref value 8191)))
+(define flat-read (reader (ann (ref-get flat-top) String)))
+(define long-read (reader (ann (ref-get long-top) String)))
+(string-set! (text-content (vector-ref flat-vector 0)) 8191 #\é)
+(string-set! (text-content (vector-ref long-vector 0)) 8191 #\λ)
+(if (and (string-eq? flat (ann (ref-get flat-top) String))
+         (string-eq? long (ann (ref-get long-top) String))
+         (char=? (flat-read) #\é)
+         (char=? (long-read) #\λ)
+         (char=? (string-ref long 8192) #\x1f600)
+         (not (string-eq? (make-string 0) (make-string 0)))
+         (not (string-eq? (string-copy "") ""))
+         (range-copied? 8192 2 8192 0 8190)
+         (range-copied? 8193 1 8192 0 8192)
+         (range-copied? 16385 8190 8192 0 8192)
+         (range-copied? 8192 1 16385 8190 16381)
+         (range-copied? 8192 0 16385 8191 16383)
+         (range-copied? 8192 8192 16385 16385 16385)
+         (range-copied? 16385 8192 0 0 0))
+    42 (unreachable))
