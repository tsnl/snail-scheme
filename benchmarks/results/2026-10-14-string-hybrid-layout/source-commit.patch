+                                                      (i32.const ,string-block-shift))))
+             (loop $allocate
+                   (local.set $size (call $string-min (local.get $remaining) (i32.const ,string-block-capacity)))
+                   (array.set ,blocks (local.get $directory) (local.get $index)
+                              (array.new ,characters (local.get $fill) (local.get $size)))
+                   (local.set $index (i32.add (local.get $index) (i32.const 1)))
+                   (local.set $remaining (i32.sub (local.get $remaining) (local.get $size)))
+                   (br_if $allocate (local.get $remaining)))
+             (struct.new ,owner (i32.const 1) (local.get $length)
+                         (ref.as_non_null (local.get $first)) (ref.as_non_null (local.get $directory)))))
+    (define (string-owner-block-definition owner characters blocks)
