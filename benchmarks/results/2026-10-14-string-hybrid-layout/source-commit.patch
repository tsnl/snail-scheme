+    (define (string-new-definition characters)
+      `(func $string-new (param $length i32) (param $fill i32) (result (ref eq))
+             (local $flat (ref null ,characters))
+             (if (result (ref eq)) (i32.le_u (local.get $length) (i32.const ,string-block-capacity))
+                 (then (local.set $flat (array.new ,characters (local.get $fill)
+                                                   (i32.add (local.get $length) (i32.const 1))))
+                       (array.set ,characters (local.get $flat) (i32.const 0) (i32.const 1))
+                       (ref.as_non_null (local.get $flat)))
+                 (else (call $string-new-blocks (local.get $length) (local.get $fill))))))
+    (define (string-new-blocks-definition owner characters blocks)
+      `(func $string-new-blocks (param $length i32) (param $fill i32) (result (ref ,owner))
