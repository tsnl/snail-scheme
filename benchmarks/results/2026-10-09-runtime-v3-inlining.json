  "audit_script": "import hashlib,json,re\nfrom pathlib import Path\nROOT=Path(__file__).resolve().parents[2]\nservices=['snail_rt_enter','snail_rt_result','snail_rt_push','snail_rt_slot','snail_rt_single','snail_rt_capture_slot','snail_rt_call']\n\ndef functions(text):\n    return {m[1] or m[2]: {'line':text.count('\\n',0,m.start())+1,'body':m[3]}\n            for m in re.finditer(r'^define [^\\n]*?@(?:\"([^\"]+)\"|([^\\s(]+))[^\\n]*\\n(.*?)^}',text,re.M|re.S)}\n\ndef calls(body):\n    return re.findall(r'\\b(?:call|invoke)\\b[^\\n]*?@(?:\"([^\"]+)\"|([^\\s(]+))\\(',body)\n\ndef facts(f):\n    names=[a or b for a,b in calls(f['body'])]\n    return {'line':f['line'],'body_lines':len(f['body'].splitlines()),\n            'selected_calls':{s:names.count(s) for s in services},\n            'calls_to_dispatch':sum('Vm8dispatch' in s for s in names),\n            'calls_to_primitives_invoke':sum('primitives6invoke' in s for s in names),\n            'calls_to_primitives_invoke_allocating':sum('primitives17invoke_allocating' in s for s in names),\n            'heap_find_calls':sum('object4Heap4find' in s for s in names)}\n\nreport={'scope':'Actual saved CPU linked artifacts on native32 and WASI. Static call sites are not runtime frequencies; bundled benchmark changes do not isolate individual features.', 'targets':{}}\nfor target in ['native','wasm']:\n    d=ROOT/'build/lto/linked'/target/'cpu'\n    item={}\n    for phase,ir,suffix in [('pre','preoptimized.ll','*.0.0.preopt.bc'),('post','optimized.ll','*.0.4.opt.bc')]:\n        text=(d/ir).read_text();defs=functions(text);bc=next(d.glob(suffix))\n        selected={name:facts(f) for name,f in defs.items() if name=='snail_program' or name=='snail_rt_call' or any(s in name for s in ['Vm8dispatch','primitives6invoke','primitives17invoke_allocating','object4Heap6number'])}\n        item[phase]={'artifact':str(bc),'sha256':hashlib.sha256(bc.read_bytes()).hexdigest(),'ir':str(d/ir),'functions':selected,\n                     'pair_definitions':[n for n in defs if 'primitives4pair' in n],\n                     'predicate_definitions':[n for n in defs if 'primitives9predicate' in n],\n                     'heap_find_definitions':[n for n in defs if 'object4Heap4find' in n]}\n    report['targets'][target]=item\nreport['pair_access_evidence']={'native_ir':str(ROOT/'build/lto/linked/native/cpu/optimized.ll'),\n    'tag_check_line_range': [96619,96625],\n    'kind_and_payload_line_range': [96674,96682],\n    'car_cdr_line_range': [96753,96760],\n    'explanation':'primitives::pair is inlined into primitives::invoke; tag check masks low3bits and rejects null; header byte equals Pair kind10; payload starts8bytes after header; car/cdr are i32 loads at payload offsets0/4, mutation corresponding stores. Error paths retain diagnostic work.'}\nreport['number_access_evidence']='Remaining Heap::number performs immediate tag tests, arithmetic shift, direct header kind switch18(Integer)/6(Float), and payload load at byteoffset8. It does not consult an ownership HashMap or Any vtable.'\nreport['audit_script']=Path(__file__).read_text()\nreport['limits']='Not every object-related helper inlines: Heap::number and some checked Heap::get/get_mut functions remain. Generic VM and builtin dispatchers remain. Rust std and the intentional extension mechanism can contain other type-erasure/virtual machinery; no whole-program Any absence is asserted.'\nout=ROOT/'benchmarks/results/2026-10-09-runtime-v3-inlining.json'\nout.write_text(json.dumps(report,indent=2)+'\\n')\nfor target,data in report['targets'].items():\n print(target)\n for phase in ['pre','post']:\n  print(phase,data[phase]['functions']['snail_program']['selected_calls'])\n",
