@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""Execute all established native backend fixtures with combined call selection."""
+
+import json
+import os
+import runpy
+import subprocess
+from pathlib import Path
+
+from measure import ROOT, run
+
+OUT = ROOT / "build/call-prototype/verification-native-combined"
+
+
+def execute(binary, stdout, diagnostic="", arguments=(), stress=False):
+    command = [str(binary), *arguments]
+    environment = {**os.environ, **({"SNAIL_NATIVE_GC_INTERVAL": "97"} if stress else {})}
+    result = subprocess.run(command, cwd=ROOT, env=environment, text=True, capture_output=True, timeout=120)
+    assert (result.returncode != 0) == bool(diagnostic), (command, result)
+    assert result.stdout == stdout, (command, result.stdout, result.stderr)
+    assert diagnostic in result.stderr if diagnostic else not result.stderr, result.stderr
+    return {"command": command, "status": result.returncode, "stdout": result.stdout, "stderr": result.stderr}
+
+
+def main():
+    OUT.mkdir(exist_ok=True)
+    (ROOT / "build/backend-tests").mkdir(exist_ok=True)
+    fixtures = runpy.run_path(str(ROOT / "scripts/test-backend"), run_name="native_expectations")
+    report = {"builds": [], "checks": []}
+    for name in [*fixtures["SUCCESSES"], "backend-errors"]:
+        binary = OUT / name
+        report["builds"].append(run(["chibi-scheme", "-h512M", "-I", ROOT / "src", ROOT / "benchmarks/calls/native.scm",
+                                    ROOT, ROOT / "tests/programs" / f"{name}.scm", binary, "combined"]))
+        if name == "backend-errors":
+            for argument, diagnostic in fixtures["ERRORS"].items():
+                report["checks"].append(execute(binary, "", diagnostic, [argument]))
+        else:
+            report["checks"].append(execute(binary, fixtures["SUCCESSES"][name], stress=name == "backend-hash-tables"))
+        print(f"passed combined native {name}", flush=True)
+        (OUT / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(f"passed {len(report['checks'])} native executions", flush=True)
+
+
+if __name__ == "__main__":
+    main()
