#!/usr/bin/env python3
"""Save runtime variants, then compare identical work in alternating process pairs."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import runpy
import shutil
from statistics import median
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
BENCH = runpy.run_path(str(ROOT / "benchmarks" / "run"), run_name="benchmark_helpers")
SAVED = ROOT / "build" / "benchmarks" / "ablations"
SOURCE_PATHS = ("Cargo.toml", "Cargo.lock", ".cargo", "runtime", "runner", "src", "snail-compile")
REPETITIONS = {"cpu": 16, "memory": 16, "io": 4, "gc": 16}


def options():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    snapshot = commands.add_parser("snapshot")
    snapshot.add_argument("name")
    snapshot.add_argument("--reuse-ir", help="reuse a saved variant's unchanged compiler output")
    compare = commands.add_parser("compare")
    compare.add_argument("before")
    compare.add_argument("after")
    compare.add_argument("--samples", type=BENCH["positive_integer"], default=3)
    compare.add_argument("--json", type=Path, required=True)
    return parser.parse_args()


def checked_text(command):
    return subprocess.check_output(command, cwd=ROOT, text=True).strip()


def source_state(revision=None):
    command = (["git", "ls-tree", "-r", "--name-only", revision] if revision else
               ["git", "ls-files", "--cached", "--others", "--exclude-standard"])
    files = sorted(checked_text([*command, "--", *SOURCE_PATHS]).splitlines())
    def contents(name):
        return (subprocess.check_output(["git", "show", f"{revision}:{name}"], cwd=ROOT)
                if revision else (ROOT / name).read_bytes())
    return {name: hashlib.sha256(contents(name)).hexdigest() for name in files}


def save_executable(directory, name, target, executable):
    destination = directory / target / executable.name
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(executable, destination)
    sidecar = executable.with_name(executable.name + ".json")
    shutil.copy2(sidecar, destination.with_name(destination.name + ".json"))
    BENCH["verify_artifact"](name, destination)


def save_module(directory, program, module):
    path = directory / f"{program}.ll"
    shutil.copy2(module.path, path)
    BENCH["record_artifact"](program, path, module.inputs)


def compiler_sources(sources):
    return {name: value for name, value in sources.items()
            if name.startswith("src/") or name == "snail-compile"}


def compiled_module(program, reuse):
    if not reuse:
        return BENCH["compile_program"](program)
    saved = SAVED / reuse
    previous = json.loads((saved / "sources.json").read_text())["source_sha256"]
    current = source_state()
    if compiler_sources(previous) != compiler_sources(current):
        raise RuntimeError("compiler sources changed; cannot reuse saved LLVM")
    path = saved / f"{program}.ll"
    BENCH["verify_artifact"](program, path)
    return BENCH["CompiledModule"](path, BENCH["input_metadata"](program))


def snapshot(name, reuse):
    directory = SAVED / name
    directory.mkdir(parents=True, exist_ok=False)
    sources = source_state()
    revision = checked_text(["git", "rev-parse", "HEAD"])
    for program in REPETITIONS:
        module = compiled_module(program, reuse)
        save_module(directory, program, module)
        for target in ("native", "wasm"):
            print(f"snapshot: {name}/{target}/{program}", file=sys.stderr, flush=True)
            artifact = BENCH["build_executable"](program, module, target)
            save_executable(directory, program, target, artifact)
    finish_snapshot(directory, sources, revision)


def finish_snapshot(directory, sources, revision):
    patch = source_patch(revision)
    (directory / "sources.patch").write_bytes(patch)
    if sources != source_state():
        raise RuntimeError("compiler/runtime sources changed while building; discard this snapshot")
    metadata = {"revision": revision,
                "source_sha256": sources, "source_patch_sha256": hashlib.sha256(patch).hexdigest(),
                "cargo_profile": "release", "llvm_pipeline": "always-inline,default<O2>,verify",
                "toolchain": toolchain()}
    (directory / "sources.json").write_text(json.dumps(metadata, indent=2) + "\n")


def source_patch(revision):
    patch = subprocess.check_output(["git", "diff", revision, "--", *SOURCE_PATHS], cwd=ROOT)
    files = checked_text(["git", "ls-files", "--others", "--exclude-standard", "--", *SOURCE_PATHS])
    for name in files.splitlines():
        diff = subprocess.run(["git", "diff", "--no-index", "--", "/dev/null", name],
                              cwd=ROOT, stdout=subprocess.PIPE)
        if diff.returncode not in (0, 1):
            raise RuntimeError(f"cannot save untracked source: {name}")
        patch += diff.stdout
    return patch


def toolchain():
    return {"rustc": checked_text([os.environ.get("RUSTC", "rustc"), "-Vv"]),
            "opt": checked_text([os.environ.get("LLVM_OPT", "opt"), "--version"]),
            "rustflags": os.environ.get("RUSTFLAGS"),
            "cargo_encoded_rustflags": os.environ.get("CARGO_ENCODED_RUSTFLAGS")}


def saved_executable(variant, program, target):
    suffix = ".wasm" if target == "wasm" else ""
    path = SAVED / variant / target / (program + suffix)
    BENCH["verify_artifact"](program, path)
    command = tuple(BENCH["execution_command"](path, target))
    return BENCH["Executable"](variant, target, path, command)


def sample_pair(program, before, after, count, index):
    order = (before, after) if index % 2 == 0 else (after, before)
    results = []
    for position, executable in enumerate(order, 1):
        result = BENCH["run_sample"](program, executable, count, report=False)
        result.update(sample=index + 1, position_in_pair=position)
        results.append(result)
    if len({sample["source_sha256"] for sample in results}) != 1:
        raise RuntimeError("ablation variants use different workload sources")
    return results


def compare_program(program, target, arguments):
    before = saved_executable(arguments.before, program, target)
    after = saved_executable(arguments.after, program, target)
    count = REPETITIONS[program]
    for executable in (before, after):
        BENCH["run_sample"](program, executable, count, report=False)
    samples = [sample for index in range(arguments.samples)
               for sample in sample_pair(program, before, after, count, index)]
    for executable in (before, after):
        BENCH["verify_artifact"](program, executable.path)
    return samples, summarize(program, target, samples, arguments)


def summarize(program, target, samples, arguments):
    before = median(s["elapsed_ms"] for s in samples if s["implementation"] == arguments.before)
    after = median(s["elapsed_ms"] for s in samples if s["implementation"] == arguments.after)
    if any(sample["elapsed_ms"] <= 0 for sample in samples):
        raise RuntimeError("timing rounded to zero")
    result = {"program": program, "target": target, "repetitions": REPETITIONS[program],
              "before_median_ms": before, "after_median_ms": after, "speedup": before / after}
    print(f"{target}/{program}: {before:.3f} -> {after:.3f} ms, {before / after:.3f}x",
          file=sys.stderr, flush=True)
    return result


def compare(arguments):
    if arguments.before == arguments.after:
        raise RuntimeError("choose two different saved variants")
    variants = {name: read_variant(name) for name in (arguments.before, arguments.after)}
    check_runtime_only(variants.values())
    BENCH["verify_corpus"]()
    groups = [compare_program(program, target, arguments)
              for program in REPETITIONS for target in ("native", "wasm")]
    samples = [sample for group, _ in groups for sample in group]
    summaries = [summary for _, summary in groups]
    write_report(arguments, variants, samples, summaries)


def check_runtime_only(variants):
    before, after = variants
    unchanged = [{name: digest for name, digest in variant["source_sha256"].items()
                  if not name.startswith("runtime/")} for variant in (before, after)]
    if unchanged[0] != unchanged[1] or before["toolchain"] != after["toolchain"]:
        raise RuntimeError("runtime ablation requires unchanged compiler, runner, and toolchain")


def read_variant(name):
    directory = SAVED / name
    metadata = json.loads((directory / "sources.json").read_text())
    digest = hashlib.sha256((directory / "sources.patch").read_bytes()).hexdigest()
    if digest != metadata["source_patch_sha256"]:
        raise RuntimeError(f"saved source patch changed: {name}")
    return metadata


def write_report(arguments, variants, samples, summaries):
    if any(read_variant(name) != metadata for name, metadata in variants.items()):
        raise RuntimeError("saved variant metadata changed during comparison")
    report = {"ablation_schema": 1, "before": arguments.before, "after": arguments.after,
              "variants": variants, "host": BENCH["execution_host"](samples, None),
              "samples_per_variant": arguments.samples, "warmup_runs": 1,
              "measurements": samples, "comparisons": summaries}
    arguments.json.parent.mkdir(parents=True, exist_ok=True)
    arguments.json.write_text(json.dumps(report, indent=2) + "\n")


if __name__ == "__main__":
    try:
        arguments = options()
        if arguments.command == "snapshot":
            snapshot(arguments.name, arguments.reuse_ir)
        else:
            compare(arguments)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print(f"ablation failed: {error}", file=sys.stderr)
        sys.exit(1)
